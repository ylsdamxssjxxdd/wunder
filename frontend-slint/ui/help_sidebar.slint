import { ListView } from "std-widgets.slint";
import { HelpDocs } from "help_models.slint";
import { I18n } from "i18n.slint";
import { HelpButton, HelpInput } from "help_controls.slint";

// Contents / index / search sidebar of the help browser, bound to the
// HelpDocs global so the reading state survives tab switches.
//
// The contents tab is a four-block accordion, mirroring the Beehive manual:
// 开始 / 工具 / 界面 / 能力. Each block expands to its groups and topics;
// index and search remain flat result lists.
export component HelpSidebar inherits Rectangle {
    background: #ffffff;
    // Local mirrors so the list reset handlers can watch changes.
    property <int> active-tab <=> HelpDocs.active-tab;
    property <string> query <=> HelpDocs.search-text;
    property <int> selected-topic <=> HelpDocs.selected-topic;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 29px;
        background: #eeeeee;
        Rectangle { y: 28px; width: parent.width; height: 1px; background: #a9a9a9; }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 2px;
            spacing: 0px;
            for label[i] in [I18n.hp_tab_contents, I18n.hp_tab_index, I18n.hp_tab_search] : HelpButton {
                label: label;
                tab: true;
                active: root.active-tab == i;
                clicked => { root.active-tab = i; }
            }
        }
    }
    if root.active-tab == 0 : Rectangle {
        x: 4px;
        y: 37px;
        width: parent.width - 8px;
        height: 30px;
        Text {
            x: 7px;
            width: parent.width - 14px;
            height: parent.height;
            text: I18n.hp_manual_title;
            color: #444444;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #dddddd; }
    }
    if root.active-tab == 2 : HelpInput {
        x: 7px;
        y: 36px;
        width: parent.width - 14px;
        height: 24px;
        text <=> root.query;
        placeholder-text: I18n.hp_search_placeholder;
        accessible-label: I18n.hp_search_placeholder;
        edited(text) => { HelpDocs.search-changed(text); }
    }
    // 目录：四个分区标题 + 展开后的分组标题与主题。
    if root.active-tab == 0 : nav-list := ListView {
        x: 4px;
        y: 67px;
        width: parent.width - 8px;
        height: parent.height - self.y - 4px;
        content-width: self.visible-width;
        // 切回目录时回到列表顶部，和经典帮助窗口一致。
        property <int> tab: root.active-tab;
        changed tab => { self.content-y = 0px; }
        for row in HelpDocs.nav-rows : Rectangle {
            width: nav-list.visible-width;
            height: row.kind == 0 ? 34px : row.kind == 1 ? 24px : 30px;
            background: row.kind == 0 ? #f4f6f8
                : row.kind == 2 && row.topic == root.selected-topic ? #2c76b8
                : row.kind == 2 && (touch.has-hover || focus.has-focus) ? #eaf4ff
                : transparent;
            accessible-role: AccessibleRole.button;
            accessible-label: row.title;
            accessible-action-default => {
                if row.kind == 0 {
                    HelpDocs.block-toggled(row.block);
                } else if row.kind == 2 {
                    HelpDocs.topic-opened(row.topic);
                }
            }
            if row.kind == 0 : Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #e2e2e2;
            }
            if row.kind == 0 : Path {
                x: 9px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                viewbox-width: 12;
                viewbox-height: 12;
                commands: row.expanded ? "M 2 4 L 10 4 L 6 10 Z" : "M 4 2 L 10 6 L 4 10 Z";
                fill: #666666;
            }
            if row.kind == 0 : Text {
                x: 27px;
                width: parent.width - 62px;
                height: parent.height;
                text: row.title;
                color: #303030;
                font-weight: 700;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            if row.kind == 0 : Text {
                x: parent.width - 36px;
                width: 30px;
                height: parent.height;
                text: "\{row.count}";
                color: #8a8a8a;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if row.kind == 1 : Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text: row.title;
                color: #6b6b6b;
                font-weight: 700;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
            if row.kind == 2 : Text {
                x: 22px;
                width: parent.width - 30px;
                height: parent.height;
                text: row.title;
                color: row.topic == root.selected-topic ? #ffffff : #202020;
                vertical-alignment: center;
                overflow: elide;
            }
            focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" {
                        if row.kind == 0 {
                            HelpDocs.block-toggled(row.block);
                        } else if row.kind == 2 {
                            HelpDocs.topic-opened(row.topic);
                        }
                        return accept;
                    }
                    reject
                }
            }
            touch := TouchArea {
                mouse-cursor: row.kind == 1 ? default : pointer;
                clicked => {
                    if row.kind == 0 {
                        HelpDocs.block-toggled(row.block);
                    } else if row.kind == 2 {
                        focus.focus();
                        HelpDocs.topic-opened(row.topic);
                    }
                }
            }
        }
    }
    // 索引与搜索：保持原来的平铺结果列表。
    if root.active-tab != 0 : flat-list := ListView {
        x: 4px;
        y: root.active-tab == 1 ? 33px : 67px;
        width: parent.width - 8px;
        height: parent.height - self.y - 4px;
        content-width: self.visible-width;
        property <int> tab: root.active-tab;
        property <string> typed: HelpDocs.search-text;
        changed tab => { self.content-y = 0px; }
        changed typed => { self.content-y = 0px; }
        for entry in (root.active-tab == 1 ? HelpDocs.keyword-index : HelpDocs.search-results) : Rectangle {
            width: flat-list.visible-width;
            height: 54px;
            background: entry.topic == root.selected-topic ? #2c76b8 : flat-touch.has-hover || flat-focus.has-focus ? #eaf4ff : transparent;
            border-width: 1px;
            border-color: flat-touch.has-hover || flat-focus.has-focus ? #b8d6ef : transparent;
            border-radius: 2px;
            accessible-role: AccessibleRole.button;
            accessible-label: entry.title;
            accessible-action-default => { HelpDocs.topic-opened(entry.topic); }
            Text {
                x: 7px;
                y: 5px;
                width: parent.width - 14px;
                height: 21px;
                text: entry.title;
                color: entry.topic == root.selected-topic ? #ffffff : #202020;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 7px;
                y: 28px;
                width: parent.width - 14px;
                height: 18px;
                text: entry.detail;
                color: entry.topic == root.selected-topic ? #e7f3ff : #666666;
                overflow: elide;
                vertical-alignment: center;
            }
            flat-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" { HelpDocs.topic-opened(entry.topic); return accept; }
                    reject
                }
            }
            flat-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { flat-focus.focus(); HelpDocs.topic-opened(entry.topic); }
            }
        }
    }
    if root.active-tab == 2 && HelpDocs.search-results.length == 0 : Text {
        x: 14px;
        y: 77px;
        width: parent.width - 28px;
        height: 30px;
        text: I18n.hp_no_topics;
        color: #777777;
    }
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #9f9f9f; }
}