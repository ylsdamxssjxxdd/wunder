import { Theme, Conversation, FileCard } from "theme.slint";
import { Action, SearchField } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component WorkDock inherits Rectangle {
    callback activate-task(int);
    callback preview-file(string);
    callback refresh-files();
    in property <int> active-task;
    in property <bool> files-loading;
    in property <string> files-error;
    in property <string> directory-path;
    in property <string> directory-root;
    in property <int> directory-container-id: 1;
    in property <bool> tasks-enabled: true;
    in property <[Conversation]> conversations;
    in property <[Conversation]> subagents;
    in property <string> subagents-status;
    callback refresh-subagents();
    callback inspect-subagent(int);
    in property <[FileCard]> files;
    background: Theme.dock;
    private property <string> keyword;
    VerticalLayout {
        padding: 10px; spacing: 10px;
        Rectangle {
            border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    height: 26px; spacing: 6px;
                    Image { width: 14px; height: 14px; source: @image-url("../assets/icons/box-archive.svg"); colorize: Theme.accent-deep; }
                    Text { text: "工作目录"; font-size: 13px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.files-loading; clicked => { root.keyword = ""; root.refresh-files(); } }
                }
                SearchField { icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索文件"; text <=> root.keyword; }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 4px;
                        for file[index] in root.files : Rectangle {
                            height: root.keyword == "" || file.name.starts-with(root.keyword) ? 36px : 0px;
                            visible: self.height > 0px;
                            Action { width: parent.width; height: parent.height; label: file.name; clicked => { root.preview-file(file.path); } }
                            Image { x: 4px; y: 10px; width: 16px; height: 16px; source: file.entry-type == "dir" ? @image-url("../assets/icons/folder-open.svg") : @image-url("../assets/icons/file-lines.svg"); colorize: file.entry-type == "dir" ? Theme.accent : Theme.muted; }
                            Text { x: 29px; width: parent.width - 72px; height: parent.height; text: file.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 42px; width: 38px; height: parent.height; text: file.entry-type == "dir" ? "目录" : file.size; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                        }
                    }
                }
                Text { height: 18px; text: root.files-loading ? "正在读取…" : root.files-error != "" ? root.files-error : "容器 #" + root.directory-container-id + " · " + (root.directory-root == "" ? "本地工作目录" : root.directory-root); overflow: elide; color: Theme.muted; font-size: 10px; }
            }
        }
        Rectangle {
            min-height: 110px; max-height: 200px; vertical-stretch: 1;
            border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 12px; spacing: 6px;
                HorizontalLayout {
                    height: 26px;
                    Text { text: "子智能体 · " + root.subagents.length; color: Theme.text; font-size: 13px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新子智能体"; clicked => { root.refresh-subagents(); } }
                }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 4px;
                        for child[index] in root.subagents : Rectangle {
                            height: 44px;
                            Action { width: parent.width; height: parent.height; label: child.title; clicked => { root.inspect-subagent(index); } }
                            Text { x: 8px; y: 3px; width: parent.width - 16px; text: child.title; color: Theme.text; font-size: 12px; overflow: elide; }
                            Text { x: 8px; y: 23px; width: parent.width - 16px; text: child.preview; color: Theme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                }
                Text { text: root.subagents-status; height: 16px; color: Theme.muted; font-size: 10px; overflow: elide; }
            }
        }
        Rectangle {
            border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    height: 24px; spacing: 8px;
                    Image { width: 14px; height: 14px; source: @image-url("../assets/icons/list-check.svg"); colorize: Theme.accent-deep; }
                    Text { text: "任务列表"; font-size: 13px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.conversations.length; color: Theme.accent-deep; font-size: 11px; }
                }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 6px;
                        for conversation[index] in root.conversations : Rectangle {
                            height: 56px; border-radius: 10px;
                            background: index == root.active-task ? Theme.accent-soft : transparent;
                            Action { width: parent.width; height: parent.height; label: conversation.title; enabled: root.tasks-enabled; clicked => { root.activate-task(index); } }
                            Image { x: 9px; y: 16px; width: 16px; height: 16px; source: @image-url("../assets/icons/comments.svg"); colorize: Theme.accent; }
                            Text { x: 36px; y: 8px; width: parent.width - 44px; height: 18px; text: conversation.title; color: Theme.text; font-size: 12px; overflow: elide; }
                            Text { x: 36px; y: 30px; width: parent.width - 44px; height: 16px; text: conversation.time == "" ? conversation.preview : conversation.time; color: Theme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}

