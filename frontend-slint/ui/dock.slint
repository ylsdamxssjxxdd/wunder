import { I18n } from "i18n.slint";
import { Theme, Conversation, FileCard } from "theme.slint";
import { Action } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component WorkDock inherits Rectangle {
    callback activate-task(int);
    callback preview-file(string);
    callback open-file-native(string);
    callback refresh-files();
    callback open-workspace-binding();
    in property <int> active-task;
    in property <bool> files-loading;
    in property <string> files-error;
    in property <string> directory-path;
    in property <string> directory-root;
    in property <int> directory-container-id: 1;
    in property <bool> tasks-enabled: true;
    in property <[Conversation]> conversations;
    in property <[FileCard]> files;
    in-out property <bool> workspace-binding-open: false;
    in-out property <int> workspace-binding-container: 1;
    in-out property <string> workspace-binding-path;
    callback save-workspace-binding(int, string);
    callback thread-menu(int, int);
    callback thread-drop(int, int);
    callback rename-thread(int, string);
    callback archive-thread(int);
    callback file-menu(string, int);
    callback create-file(string, string);
    background: Theme.dock;
    private property <int> file-menu-index: -1;
    private property <int> menu-index: -1;
    private property <int> rename-index: -1;
    private property <string> rename-value;
    private property <int> dragging-index: -1;
    private property <bool> new-file-open: false;
    VerticalLayout {
        padding: 10px; spacing: 10px;
        Rectangle {
            border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 3;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                HorizontalLayout {
                    height: 28px; spacing: 8px;
                    Rectangle {
                        width: 22px; height: 22px; y: 3px; border-radius: Theme.radius-sm;
                        background: Theme.accent-soft;
                        Image { x: 5px; y: 5px; width: 12px; height: 12px; source: @image-url("../assets/icons/box-archive.svg"); colorize: Theme.accent-deep; }
                    }
                    Text { text: I18n.dk_workdir; font-size: Theme.font-md; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                    Text { text: root.directory-container-id; color: Theme.accent-deep; font-size: Theme.font-xs; font-weight: 600; vertical-alignment: center; y: -1px; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/folder-open.svg"); label: I18n.dk_switch_dir; clicked => { root.open-workspace-binding(); } }
                    Action { icon: @image-url("../assets/icons/plus.svg"); label: I18n.dk_new_file; clicked => { root.new-file-open = !root.new-file-open; } }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.files-loading; clicked => { root.refresh-files(); } }
                }
                if root.new-file-open : Rectangle { z: 10; x: parent.width - 210px; width: 200px; height: 176px; border-radius: Theme.radius-md; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 6px; spacing: 2px; Text { text: I18n.dk_new_file; height: 18px; color: Theme.muted; font-size: Theme.font-2xs; } for option in [{kind: "text", label: I18n.dk_new_text}, {kind: "markdown", label: "Markdown .md"}, {kind: "word", label: "Word .docx"}, {kind: "sheet", label: I18n.dk_new_sheet}, {kind: "slides", label: I18n.dk_new_deck}, {kind: "flowchart", label: I18n.dk_new_diagram}] : Action { height: 22px; label: option.label; show-label: true; clicked => { root.new-file-open = false; root.create-file(option.kind, root.directory-path); } } } }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 2px;
                        for file[index] in root.files : Rectangle {
                            height: 28px; border-radius: Theme.radius-sm;
                            Action { width: parent.width; height: parent.height; label: file.name; clicked => { if file.entry-type == "dir" { root.file-menu(file.path, 2); } else { root.preview-file(file.path); } } }
                            Image { x: 4px; y: 6px; width: 16px; height: 16px; source: file.entry-type == "dir" ? @image-url("../assets/icons/folder-open.svg") : file.name.ends-with(".md") ? @image-url("../assets/icons/file-type-markdown.svg") : file.name.ends-with(".docx") ? @image-url("../assets/icons/file-type-word.svg") : file.name.ends-with(".xlsx") ? @image-url("../assets/icons/file-type-excel.svg") : file.name.ends-with(".pptx") ? @image-url("../assets/icons/file-type-powerpoint.svg") : file.name.ends-with(".pdf") ? @image-url("../assets/icons/file-type-pdf.svg") : @image-url("../assets/icons/file-type-text.svg"); }
                            Text { x: 29px; width: parent.width - 72px; height: parent.height; text: file.name; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 42px; width: 38px; height: parent.height; text: file.entry-type == "dir" ? I18n.common_directory : file.size; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.file-menu-index = index; }
                                    else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && file.entry-type != "dir" { root.open-file-native(file.path); }
                                }
                            }
                            if root.file-menu-index == index : Rectangle {
                                x: parent.width - 128px; y: 30px; z: 10; width: 120px; height: 86px; border-radius: Theme.radius-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 5px; spacing: 2px;
                                    Action { height: 24px; label: I18n.dk_open; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 0); } }
                                    Action { height: 24px; label: I18n.dk_copy_path; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 1); } }
                                    Action { height: 24px; label: I18n.dk_open_native; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 3); } }
                                }
                            }
                        }
                    }
                }
                TextInput { height: 18px; text: root.files-loading ? I18n.dk_reading : root.files-error != "" ? root.files-error : (root.directory-root == "" ? I18n.dk_title : root.directory-root); read-only: true; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: right; }
            }
        }
        Rectangle {
            border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 2;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                HorizontalLayout {
                    height: 28px; spacing: 6px;
                    Image { width: 14px; height: 14px; source: @image-url("../assets/icons/list-check.svg"); colorize: Theme.accent-deep; }
                    Text { text: I18n.dk_threads_title; font-size: Theme.font-md; font-weight: 700; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.conversations.length; color: Theme.accent-deep; font-size: Theme.font-xs; }
                }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 6px;
                        for conversation[index] in root.conversations : Rectangle {
                            height: 46px; border-radius: Theme.radius-sm;
                            background: index == root.active-task ? Theme.accent-soft : (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") ? Theme.accent-soft.transparentize(0.35) : transparent;
                            Action { width: parent.width - 30px; height: parent.height; label: conversation.title; enabled: root.tasks-enabled; clicked => { root.activate-task(index); } }
                            Image { x: 8px; y: 15px; width: 16px; height: 16px; source: @image-url("../assets/icons/comments.svg"); colorize: (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") ? Theme.accent-deep : Theme.accent; }
                            Text { x: 36px; y: 6px; width: parent.width - 94px; height: 18px; text: conversation.title; color: (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") ? Theme.accent-deep : Theme.text; font-size: Theme.font-sm; overflow: elide; }
                            if (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") : Text { x: parent.width - 78px; y: 7px; width: 48px; height: 16px; text: "运行中"; color: Theme.accent-deep; font-size: Theme.font-2xs; horizontal-alignment: right; overflow: elide; }
                            Image { x: 36px; y: 27px; width: 10px; height: 10px; source: @image-url("../assets/icons/bolt.svg"); colorize: Theme.muted; }
                            Text { x: 49px; y: 24px; width: 31px; height: 14px; text: conversation.consumed-tokens; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
                            Image { x: 82px; y: 27px; width: 10px; height: 10px; source: @image-url("../assets/icons/screwdriver-wrench.svg"); colorize: Theme.muted; }
                            Text { x: 95px; y: 24px; width: 20px; height: 14px; text: conversation.tool-calls; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
                            Image { x: 117px; y: 27px; width: 10px; height: 10px; source: @image-url("../assets/icons/coins.svg"); colorize: Theme.muted; }
                            Text { x: 130px; y: 24px; width: parent.width - 166px; height: 14px; text: conversation.quota-used; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
                            Action { x: parent.width - 30px; y: 10px; width: 26px; height: 26px; icon: @image-url("../assets/icons/ellipsis.svg"); label: I18n.dk_thread_ops; clicked => { root.menu-index = index; } }
                            TouchArea {
                                x: 0px; y: 0px; width: 26px; height: parent.height;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.dragging-index = index; }
                                    else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { if root.dragging-index >= 0 { root.thread-drop(root.dragging-index, index); root.dragging-index = -1; } }
                                }
                                moved => { if root.dragging-index >= 0 && self.mouse-y < -18px && index > 0 { root.thread-drop(root.dragging-index, index - 1); root.dragging-index = index - 1; } else if root.dragging-index >= 0 && self.mouse-y > parent.height + 18px && index + 1 < root.conversations.length { root.thread-drop(root.dragging-index, index + 1); root.dragging-index = index + 1; } }
                            }
                            if root.menu-index == index : Rectangle {
                                x: parent.width - 132px; y: 34px; z: 10; width: 124px; height: 94px; border-radius: Theme.radius-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 5px; spacing: 2px;
                                    Action { height: 26px; label: I18n.dk_details; show-label: true; clicked => { root.menu-index = -1; root.thread-menu(index, 0); } }
                                    Action { height: 26px; label: I18n.common_rename; show-label: true; clicked => { root.menu-index = -1; root.rename-index = index; root.rename-value = conversation.title; } }
                                    Action { height: 26px; label: I18n.dk_archive; show-label: true; clicked => { root.menu-index = -1; root.archive-thread(index); } }
                                }
                            }
                            if root.rename-index == index : Rectangle {
                                x: 8px; y: 8px; z: 11; width: parent.width - 16px; height: 88px; border-radius: Theme.radius-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 7px; spacing: 4px;
                                    TextInput { height: 28px; text <=> root.rename-value; color: Theme.text; font-size: Theme.font-xs; }
                                    HorizontalLayout { height: 25px; Rectangle { horizontal-stretch: 1; } Action { width: 52px; height: 24px; label: I18n.common_cancel; show-label: true; clicked => { root.rename-index = -1; } } Action { width: 52px; height: 24px; label: I18n.common_save; show-label: true; primary: true; enabled: root.rename-value != ""; clicked => { root.rename-thread(index, root.rename-value); root.rename-index = -1; } } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
