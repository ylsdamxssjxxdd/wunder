import { Theme, Conversation, FileCard } from "theme.slint";
import { Action } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export component WorkDock inherits Rectangle {
    callback activate-task(int);
    callback preview-file(string);
    callback open-file-native(string);
    callback refresh-files();
    callback open-workspace-binding();
    in property <int> active-task;
    in property <bool> files-loading;
    in property <string> files-error;
    in property <string> directory-path;
    in property <string> directory-root;
    in property <int> directory-container-id: 1;
    in property <bool> tasks-enabled: true;
    in property <[Conversation]> conversations;
    in property <[FileCard]> files;
    in-out property <bool> workspace-binding-open: false;
    in-out property <int> workspace-binding-container: 1;
    in-out property <string> workspace-binding-path;
    callback save-workspace-binding(int, string);
    callback thread-menu(int, int);
    callback thread-drop(int, int);
    callback rename-thread(int, string);
    callback archive-thread(int);
    callback file-menu(string, int);
    callback create-file(string, string);
    background: Theme.dock;
    private property <int> file-menu-index: -1;
    private property <int> menu-index: -1;
    private property <int> rename-index: -1;
    private property <string> rename-value;
    private property <int> dragging-index: -1;
    private property <bool> new-file-open: false;
    VerticalLayout {
        padding: 10px; spacing: 10px;
        Rectangle {
            border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 3;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    height: 26px; spacing: 6px;
                    Image { width: 14px; height: 14px; source: @image-url("../assets/icons/box-archive.svg"); colorize: Theme.accent-deep; }
                    Text { text: "工作目录"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    Text { text: root.directory-container-id; color: Theme.accent-deep; font-size: 11px; font-weight: 600; vertical-alignment: center; y: -1px; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/folder-open.svg"); label: "切换目录"; clicked => { root.open-workspace-binding(); } }
                    Action { icon: @image-url("../assets/icons/plus.svg"); label: "新建文件"; clicked => { root.new-file-open = !root.new-file-open; } }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.files-loading; clicked => { root.refresh-files(); } }
                }
                if root.new-file-open : Rectangle { z: 10; x: parent.width - 210px; width: 200px; height: 176px; border-radius: 9px; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 6px; spacing: 2px; Text { text: "新建文件"; height: 18px; color: Theme.muted; font-size: 10px; } for option in [{kind: "text", label: "文本 .txt"}, {kind: "markdown", label: "Markdown .md"}, {kind: "word", label: "Word .docx"}, {kind: "sheet", label: "表格 .xlsx"}, {kind: "slides", label: "演示文稿 .pptx"}, {kind: "flowchart", label: "流程图 .drawio"}] : Action { height: 22px; label: option.label; show-label: true; clicked => { root.new-file-open = false; root.create-file(option.kind, root.directory-path); } } } }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 4px;
                        for file[index] in root.files : Rectangle {
                            height: 36px;
                            Action { width: parent.width; height: parent.height; label: file.name; clicked => { if file.entry-type == "dir" { root.file-menu(file.path, 2); } else { root.preview-file(file.path); } } }
                            Image { x: 4px; y: 10px; width: 16px; height: 16px; source: file.entry-type == "dir" ? @image-url("../assets/icons/folder-open.svg") : file.name.ends-with(".md") ? @image-url("../assets/icons/file-type-markdown.svg") : file.name.ends-with(".docx") ? @image-url("../assets/icons/file-type-word.svg") : file.name.ends-with(".xlsx") ? @image-url("../assets/icons/file-type-excel.svg") : file.name.ends-with(".pptx") ? @image-url("../assets/icons/file-type-powerpoint.svg") : file.name.ends-with(".pdf") ? @image-url("../assets/icons/file-type-pdf.svg") : @image-url("../assets/icons/file-type-text.svg"); }
                            Text { x: 29px; width: parent.width - 72px; height: parent.height; text: file.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                            Text { x: parent.width - 42px; width: 38px; height: parent.height; text: file.entry-type == "dir" ? "目录" : file.size; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right { root.file-menu-index = index; }
                                    else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && file.entry-type != "dir" { root.open-file-native(file.path); }
                                }
                            }
                            if root.file-menu-index == index : Rectangle {
                                x: parent.width - 128px; y: 30px; z: 10; width: 120px; height: 86px; border-radius: 8px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 5px; spacing: 2px;
                                    Action { height: 24px; label: "打开"; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 0); } }
                                    Action { height: 24px; label: "复制路径"; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 1); } }
                                    Action { height: 24px; label: "系统打开"; show-label: true; clicked => { root.file-menu-index = -1; root.file-menu(file.path, 3); } }
                                }
                            }
                        }
                    }
                }
                TextInput { height: 18px; text: root.files-loading ? "正在读取…" : root.files-error != "" ? root.files-error : (root.directory-root == "" ? "本地工作目录" : root.directory-root); read-only: true; color: Theme.muted; font-size: 10px; horizontal-alignment: right; }
            }
        }
        Rectangle {
            border-radius: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
            vertical-stretch: 2;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                HorizontalLayout {
                    height: 24px; spacing: 8px;
                    Image { width: 14px; height: 14px; source: @image-url("../assets/icons/list-check.svg"); colorize: Theme.accent-deep; }
                    Text { text: "工作线程"; font-size: 13px; font-weight: 600; color: Theme.text; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.conversations.length; color: Theme.accent-deep; font-size: 11px; }
                }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        alignment: start; spacing: 6px;
                        for conversation[index] in root.conversations : Rectangle {
                            height: 56px; border-radius: 10px;
                            background: index == root.active-task ? Theme.accent-soft : transparent;
                            Action { width: parent.width - 30px; height: parent.height; label: conversation.title; enabled: root.tasks-enabled; clicked => { root.activate-task(index); } }
                            Image { x: 9px; y: 16px; width: 16px; height: 16px; source: @image-url("../assets/icons/comments.svg"); colorize: Theme.accent; }
                            Text { x: 36px; y: 8px; width: parent.width - 44px; height: 18px; text: conversation.title; color: Theme.text; font-size: 12px; overflow: elide; }
                            Image { x: 36px; y: 31px; width: 10px; height: 10px; source: @image-url("../assets/icons/bolt.svg"); colorize: Theme.muted; }
                            Text { x: 49px; y: 28px; width: 31px; height: 14px; text: conversation.consumed-tokens; color: Theme.muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
                            Image { x: 82px; y: 31px; width: 10px; height: 10px; source: @image-url("../assets/icons/screwdriver-wrench.svg"); colorize: Theme.muted; }
                            Text { x: 95px; y: 28px; width: 20px; height: 14px; text: conversation.tool-calls; color: Theme.muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
                            Image { x: 117px; y: 31px; width: 10px; height: 10px; source: @image-url("../assets/icons/coins.svg"); colorize: Theme.muted; }
                            Text { x: 130px; y: 28px; width: parent.width - 166px; height: 14px; text: conversation.quota-used; color: Theme.muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
                            Action { x: parent.width - 30px; y: 13px; width: 26px; height: 26px; icon: @image-url("../assets/icons/ellipsis.svg"); label: "线程操作"; clicked => { root.menu-index = index; } }
                            TouchArea {
                                x: 0px; y: 0px; width: 26px; height: parent.height;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.dragging-index = index; }
                                    else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { if root.dragging-index >= 0 { root.thread-drop(root.dragging-index, index); root.dragging-index = -1; } }
                                }
                                moved => { if root.dragging-index >= 0 && self.mouse-y < -18px && index > 0 { root.thread-drop(root.dragging-index, index - 1); root.dragging-index = index - 1; } else if root.dragging-index >= 0 && self.mouse-y > parent.height + 18px && index + 1 < root.conversations.length { root.thread-drop(root.dragging-index, index + 1); root.dragging-index = index + 1; } }
                            }
                            if root.menu-index == index : Rectangle {
                                x: parent.width - 132px; y: 34px; z: 10; width: 124px; height: 94px; border-radius: 8px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 5px; spacing: 2px;
                                    Action { height: 26px; label: "详情"; show-label: true; clicked => { root.menu-index = -1; root.thread-menu(index, 0); } }
                                    Action { height: 26px; label: "重命名"; show-label: true; clicked => { root.menu-index = -1; root.rename-index = index; root.rename-value = conversation.title; } }
                                    Action { height: 26px; label: "归档"; show-label: true; clicked => { root.menu-index = -1; root.archive-thread(index); } }
                                }
                            }
                            if root.rename-index == index : Rectangle {
                                x: 8px; y: 8px; z: 11; width: parent.width - 16px; height: 88px; border-radius: 8px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 7px; spacing: 4px;
                                    TextInput { height: 28px; text <=> root.rename-value; color: Theme.text; font-size: 11px; }
                                    HorizontalLayout { height: 25px; Rectangle { horizontal-stretch: 1; } Action { width: 52px; height: 24px; label: "取消"; show-label: true; clicked => { root.rename-index = -1; } } Action { width: 52px; height: 24px; label: "保存"; show-label: true; primary: true; enabled: root.rename-value != ""; clicked => { root.rename-thread(index, root.rename-value); root.rename-index = -1; } } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
