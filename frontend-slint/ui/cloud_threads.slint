import { Button, LineEdit, ListView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { I18n } from "i18n.slint";

export struct CloudTurn { id: string, user: string, assistant: string, status: string }
export component CloudThreadsPanel inherits Rectangle {
    in property <[string]> threads;
    in property <[string]> agents;
    in property <[CloudTurn]> turns;
    in property <bool> busy;
    in property <string> status;
    in property <bool> has-older;
    in property <bool> history-mode;
    in property <string> copy-text;
    in property <int> copy-request;
    in-out property <int> thread-index: 0;
    in-out property <int> agent-index: 0;
    in-out property <string> message;
    in-out property <string> approval;
    callback refresh();
    callback select-thread(int);
    callback send();
    callback stop();
    callback answer(bool);
    callback close();
    callback older();
    callback latest();
    callback copy-message(string, bool);
    clipboard := TextInput {
        visible: false; width: 0px; height: 0px; read-only: true;
        property <int> request: root.copy-request;
        changed request => { self.text = root.copy-text; self.select-all(); self.copy(); }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        background: Theme.chat;
        VerticalLayout {
            padding: 18px; spacing: 10px;
            Text { text: I18n.zh ? "云端工作区" : "Cloud workspace"; font-size: 18px; color: Theme.text; }
            HorizontalLayout {
                Text {
                    text: I18n.zh ? "从左侧工作区树选择线程；新建线程也在工作区行完成" : "Select or create a thread from the workspace tree";
                    color: Theme.muted; font-size: 12px; horizontal-stretch: 1;
                }
                Button { text: I18n.zh ? "刷新" : "Refresh"; enabled: !root.busy; clicked => { root.refresh(); } }
            }
            HorizontalLayout {
                Text { text: root.status; color: Theme.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                Button { text: I18n.zh ? "更早消息" : "Earlier"; enabled: !root.busy && root.has-older; clicked => { root.older(); } }
                Button { text: I18n.zh ? "回到最新" : "Latest"; enabled: !root.busy && root.history-mode; clicked => { root.latest(); } }
            }
            ListView {
                vertical-stretch: 1;
                for turn in root.turns : Rectangle {
                    height: content.preferred-height + 16px; background: Theme.input-bg;
                    content := VerticalLayout {
                        padding: 8px; spacing: 8px;
                        Text { text: turn.user; wrap: word-wrap; color: Theme.text; }
                        Text { text: turn.assistant; wrap: word-wrap; color: Theme.text; }
                        Text { text: turn.status; color: Theme.muted; font-size: 11px; }
                        HorizontalLayout {
                            Button { text: I18n.zh ? "复制提问原文" : "Copy user text"; enabled: !root.busy; clicked => { root.copy-message(turn.id, false); } }
                            Button { text: I18n.zh ? "复制回复原文" : "Copy reply text"; enabled: !root.busy; clicked => { root.copy-message(turn.id, true); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            TextEdit { height: 86px; text <=> root.message; enabled: !root.busy; }
            HorizontalLayout {
                Button { text: I18n.zh ? "发送" : "Send"; enabled: !root.busy && root.message != ""; primary: true; clicked => { root.send(); } }
                Button { text: I18n.zh ? "停止线程" : "Stop thread"; enabled: !root.busy && root.thread-index > 0; clicked => { root.stop(); } }
                LineEdit { horizontal-stretch: 1; placeholder-text: I18n.zh ? "工具审批 ID" : "Tool approval ID"; text <=> root.approval; }
                Button { text: I18n.zh ? "允许一次" : "Allow once"; enabled: !root.busy && root.approval != ""; clicked => { root.answer(true); } }
                Button { text: I18n.zh ? "拒绝" : "Deny"; enabled: !root.busy && root.approval != ""; clicked => { root.answer(false); } }
            }
        }
    }
}
