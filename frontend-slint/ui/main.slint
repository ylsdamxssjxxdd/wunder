        if root.page == DesktopPage.messages : EdgeToggle {
            x: (root.navigation-open ? Theme.rail-width + Theme.middle-width : Theme.rail-width) - 4px;
            y: (root.height - 48px) / 2;
            open: root.navigation-open;
            opens-left: true;
            toggled => { root.navigation-open = !root.navigation-open; }
        }
        if root.page == DesktopPage.messages && root.width >= Theme.dock-breakpoint : EdgeToggle {
            x: root.right-open ? root.width - 288px : root.width - 8px;
            y: (root.height - 48px) / 2;
            open: root.right-open;
            opens-left: false;
            toggled => { root.right-open = !root.right-open; }
        }
    }

    if root.page == DesktopPage.messages && root.dock-overlay-open && root.width < Theme.dock-breakpoint : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { root.dock-overlay-open = false; } }
        WorkDock {
            files-loading: root.files-loading; files-error: root.files-error; directory-path: root.directory-path; directory-root: root.directory-root; directory-container-id: root.directory-container-id;
            tasks-enabled: (!root.busy || root.observing-thread) && !root.session-loading && !root.chat-loading && !root.creating-session;
            conversations: root.conversations;
            files: root.files;
            x: parent.width - Theme.dock-width; y: 0px; width: Theme.dock-width; height: parent.height;
            active-task: root.connected ? root.selected-conversation : root.active-task;
            activate-task(index) => { root.select-task(index); root.dock-overlay-open = false; }
            preview-file(path) => { root.open-file(path); }
            refresh-files => { root.refresh-files(); }
            save-workspace-binding(container, path) => { root.save-workspace-binding(container, path); }
            thread-menu(index, action) => { root.thread-menu(index, action); }
            thread-drop(from, to) => { root.thread-drop(from, to); }
            rename-thread(index, title) => { root.rename-thread(index, title); }
            archive-thread(index) => { root.archive-thread(index); }
            file-menu(path, action) => { if action == 0 { root.open-file(path); } else if action == 1 { root.copy-raw(path); } else if action == 3 { root.open-file-native(path); } else { root.refresh-files(); } }
            create-file(kind, path) => { root.create-workspace-file(kind, path); }
            open-workspace-binding => { root.workspace-binding-container = root.directory-container-id; root.workspace-binding-path = root.directory-root; root.workspace-binding-open = true; }
        }
