            tasks-enabled: (!root.busy || root.observing-thread) && !root.session-loading && !root.chat-loading && !root.creating-session;
            conversations: root.conversations;
            files: root.files;
            x: root.width - Theme.dock-width; y: 0px; width: Theme.dock-width; height: parent.height; active-task: root.connected ? root.selected-conversation : root.active-task;
            activate-task(index) => { root.select-task(index); }
            preview-file(path) => { root.open-file(path); }
            refresh-files => { root.refresh-files(); }
            save-workspace-binding(container, path) => { root.save-workspace-binding(container, path); }
            thread-menu(index, action) => { root.thread-menu(index, action); }
            thread-drop(from, to) => { root.thread-drop(from, to); }
            rename-thread(index, title) => { root.rename-thread(index, title); }
            archive-thread(index) => { root.archive-thread(index); }
            file-menu(path, action) => { if action == 0 { root.open-file(path); } else if action == 1 { root.copy-raw(path); } else if action == 3 { root.open-file-native(path); } else { root.refresh-files(); } }
            create-file(kind, path) => { root.create-workspace-file(kind, path); }
            open-workspace-binding => { root.workspace-binding-container = root.directory-container-id; root.workspace-binding-path = root.directory-root; root.workspace-binding-open = true; }
        }

        // These transparent hitboxes match the web client's divider controls:
