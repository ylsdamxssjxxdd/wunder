export component MainWindow inherits Window {
    in-out property <[SidebarRow]> sidebar-rows: [
        { kind: 0, workspace-id: "ws-preview-a", name: I18n.ws_preview_default, icon: "folder", color: "blue", thread-count: 2, expanded: true, selected: true, thread-id: "", title: "", status: "", active: false, payload: 0 },
        { kind: 1, workspace-id: "ws-preview-a", name: "", icon: "", color: "", thread-count: 0, expanded: false, selected: false, thread-id: "t1", title: I18n.main_preview_prompt, status: "done", active: true, payload: 0 },
        { kind: 1, workspace-id: "ws-preview-a", name: "", icon: "", color: "", thread-count: 0, expanded: false, selected: false, thread-id: "t2", title: I18n.main_preview_step_title2, status: "idle", active: false, payload: 1 },
        { kind: 0, workspace-id: "ws-preview-b", name: I18n.ws_preview_docs, icon: "coffee", color: "orange", thread-count: 1, expanded: true, selected: false, thread-id: "", title: "", status: "", active: false, payload: 1 },
        { kind: 1, workspace-id: "ws-preview-b", name: "", icon: "", color: "", thread-count: 0, expanded: false, selected: false, thread-id: "t3", title: I18n.main_preview_step_title1, status: "running", active: false, payload: 2 }
    ];
    in-out property <[WorkspaceCard]> workspaces: [
        { workspace-id: "ws-preview-a", name: I18n.ws_preview_default, icon: "folder", color: "blue", root-path: I18n.ws_preview_root_a, thread-count: 2, expanded: true, selected: true },
        { workspace-id: "ws-preview-b", name: I18n.ws_preview_docs, icon: "coffee", color: "orange", root-path: I18n.ws_preview_root_b, thread-count: 1, expanded: true, selected: false }
    ];
    in-out property <int> selected-workspace: 0;
    callback select-row(int);
    callback workspace-menu(int, int);
    callback new-workspace();
    callback move-row(int, int);
    callback open-workspace-folder(string);
    callback rename-thread(int, string);
    callback archive-thread(int);
    in-out property <DesktopPage> page: DesktopPage.messages;
    // Settings render in an internal overlay window instead of taking over
    // the chat area; the sidebar width is user-draggable.
    in-out property <bool> settings-open: false;
    in-out property <length> sidebar-width: Theme.sidebar-width;

    in-out property <bool> expert-loading;
    in-out property <bool> expert-saving;
    in-out property <string> expert-error;
    in-out property <[MemoryCard]> expert-memories;
    in-out property <[ArchiveCard]> expert-archives;
