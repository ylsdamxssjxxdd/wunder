    in-out property <string> selected-agent-icon-config;
    in-out property <[string]> selected-agent-tool-names: [];
    in-out property <[string]> selected-agent-preset-questions: [];
    in-out property <string> selected-agent-approval-mode: "suggest";
    in-out property <bool> selected-agent-preview-skill: false;
    in-out property <bool> selected-agent-silent: false;
    in-out property <bool> selected-agent-prefer-mother: false;
    in-out property <string> agent-question-draft;
    // §9.3 agent form projections. The model list is built natively: only
    // configured conversational models are selectable. The tool cards reuse the
    // grouped catalog (`expert-tool-groups`), the only place filtering happens.
    callback toggle-agent-tool-option(string);
    callback save-agent-form();
    callback queue-agent-save();
    // Unsaved-change tracking for the agent editor: the clean baseline is
    // captured in Rust, every bound field change recomputes the dirty flag.
    in-out property <bool> agent-dirty: false;
    in-out property <bool> agent-save-pending: false;
    in-out property <string> agent-form-snapshot;
    in-out property <bool> agent-leave-confirm-open: false;
    // The avatar glyph stays empty until the profile loads: the shell fills it
    // with the signed-in name's first character, and an empty mark falls back to
    // the shared "me" label. The profile-colour default matches the backend.
    in-out property <ProfileCard> profile: { user-id: "", username: "", email: "", unit: "", unit-id: "", sessions: "0", sessions-last-7d: "0", tool-calls: "0", tokens: "0", agents: "0", last-active: "", avatar-icon: "initial", avatar-glyph: "", avatar-color: "#3b82f6", avatar-brush: #3b82f6 };
    in-out property <bool> profile-loading: false;
    callback refresh-profile();
    callback save-profile-avatar(string, string);
    callback save-profile(string, string, string);
    in-out property <bool> profile-edit-open: false;
    in-out property <string> profile-username-draft;
    in-out property <string> profile-email-draft;
    in-out property <string> profile-unit-draft;
    callback refresh-tools();
    callback open-file-native(string);
    callback save-runtime();
    callback refresh-settings();
    callback select-model(int);
    callback create-model();
    callback discard-model-draft();
    callback move-model(int, int);
    callback save-model();
    callback set-default-model(string);
    callback delete-model(string);
    // The native projection bumps scroll-revision; TimelineView owns the
    // follow-output scroll itself, so no handler is needed here.

    // The workspace the active thread belongs to; feeds the composer's
    // workspace label. The native layer always seeds one workspace, so
    // indexing stays in range.
    out property <bool> has-active-workspace: root.selected-workspace >= 0
        && root.selected-workspace < root.workspaces.length;
    out property <string> active-workspace-name: root.has-active-workspace ? root.workspaces[root.selected-workspace].name : "";
    // One timeline fold toggle: the Rust projection patches only the rows the
    // fold owns (itself, its tool batch, or its whole earlier turn).
    callback timeline-toggle(int);
    callback timeline-process-page(int, int);
    callback subagent-process-page(int, int);
    in-out property <string> process-child-session;
    callback timeline-open(string);
    // Save one answer block as a text file through the native layer.
    // Bounded introspection for the native smoke checks and the companion
    // bubble: the row count and the answer text of the active thread.
    callback timeline-counts() -> TimelineCounts;
    callback timeline-last-answer() -> string;

    // §8.3 model switcher inside the composer. `models` is the full catalogue
    // projection; its size is mirrored here so the picker can tell "empty
    // list" from "nothing configured".
    in-out property <int> model-catalogue-count: 0;
    // §8.5 branch of the workspace folder, when the backend can detect one.
    in-out property <string> active-workspace-branch: "";
    // Root folder of the active workspace, used by the composer's "open
    // workspace folder" action.
    out property <string> active-workspace-root: root.has-active-workspace ? root.workspaces[root.selected-workspace].root-path : "";
    // Logical-pixel centre of the sidebar's settings button and of the settings
    // window's close button. The native smoke check drives real pointer events,
    // and a real click needs the layout's own numbers rather than a repeated
    // guess about where the overlay lands.
    out property <length> settings-button-x: root.sidebar-width / 2;
    out property <length> settings-button-y: sidebar_view.height - 20px;
    out property <length> settings-back-x: (root.width - min(1080px, root.width - 72px)) / 2
        + min(1080px, root.width - 72px) - 22px;
    out property <length> settings-back-y: 22px;
    // §8.4 permission mode preference; the backend remains the authority.
    in-out property <string> permission-mode: "full_auto";
    callback save-permission-mode(string);
    // §9.1 settings search. Slint 1.18 strings have no substring test, so the
    // query is filtered natively and the matching categories come back as one
    // flag per category, in §9.2 order.
    in-out property <string> settings-query: "";
    in-out property <[bool]> settings-category-flags: [true, true, true, true, true, true, true, true, true, true, true];
    callback filter-settings-categories(string);
    // Help is not a category anymore: the general page raises this to open the
    // standalone help window.
    callback open-help();
    // Actions the embedded category pages raise that had no shell entry point
    // while those pages were unmounted.
    // Sidebar thread-row hover action: open the trajectory page for that
    // conversation (payload is the conversation index).
    callback open-trajectory(int);
    callback request-channel-delete();
    callback confirm-channel-delete();
    callback cancel-channel-delete();
    callback probe-channel-logs();
    callback clear-channel-logs();
    // §8.2 more-menu and attachment actions. "Open workspace folder" reuses the
    // sidebar's handler; file attachment is picked on a worker thread because
    // the native dialog blocks.
    callback open-active-workspace();
    callback pick-attachments();

    function open-info(title: string, text: string) {
        root.dialog-title = title; root.dialog-text = text; root.dialog-open = true;
    }
    function apply-new-model-param-defaults() {
        root.model-temperature-draft = "0.7";
        root.model-timeout-draft = "120";
        root.model-max-output-draft = "8192";
        root.model-thinking-budget-draft = "2048";
        root.model-max-rounds-draft = "1000";
        root.model-max-context-draft = "128000";
        root.model-history-compaction-ratio-draft = "0.9";
        root.model-reasoning-effort-draft = "";
        root.model-simulation-speed-draft = "fast";
        root.model-support-vision-draft = false;
        root.model-support-hearing-draft = false;
        root.model-stream-include-usage-draft = true;
        root.model-tts-voice-draft = ""; root.model-tts-format-draft = ""; root.model-tts-speed-draft = "1"; root.model-tts-instructions-draft = "";
        root.model-asr-language-draft = ""; root.model-asr-format-draft = ""; root.model-asr-temperature-draft = "0"; root.model-asr-prompt-draft = "";
        root.model-image-size-draft = ""; root.model-image-format-draft = ""; root.model-image-steps-draft = "30"; root.model-image-guidance-draft = "7.5"; root.model-image-negative-draft = "";
        root.model-video-size-draft = ""; root.model-video-seconds-draft = "4"; root.model-video-fps-draft = "24"; root.model-video-negative-draft = "";
    }
    function open-new-model() {
        root.model-creating = true;
        // The native side inserts the draft into the shared catalogue in the
        // same callback turn.  Keeping the defaults here makes the right-hand
        // form useful immediately, even before the catalogue projection lands.
        root.model-key-draft = "新模型";
        root.model-provider-draft = "openai_compatible";
        root.model-name-draft = "";
        root.model-base-url-draft = ""; root.model-token-draft = ""; root.model-type-draft = "llm";
        root.model-tool-call-mode-draft = "function_call";
        root.apply-new-model-param-defaults();
    }

    Rectangle {
        y: Theme.titlebar-height;
        width: parent.width; height: max(0px, parent.height - Theme.titlebar-height);
        HorizontalLayout {
            spacing: 0px;
            sidebar_view := Sidebar {
                width: root.sidebar-width;
                rows: root.sidebar-rows;
                active-thread-id: root.active-session-id;
                // Signed-in identity travels from the profile projection so the
                // sidebar never owns a second copy of the avatar state.
                user-initial: root.profile.avatar-glyph;
                user-color: root.profile.avatar-brush;
                // Cloud quota badge (§6.1): blank hides the pill, warn marks
                // a balance at or below 10% of the daily grant.
                cloud-quota-text: root.cloud-logged-in ? root.cloud-balance : "";
                cloud-quota-warn: root.cloud-quota-warn;
                cloud-quota-expired: root.cloud-connection == "expired";
                cloud-quota-reconnecting: root.cloud-connection == "reconnecting";
                // The sidebar hosts the device selector: local (this 蛹) is
                // always present, cloud appears once an account is signed in.
                cloud-available: root.cloud-logged-in;
                local-workspace-count: root.workspaces.length;
                busy: root.creating-session || root.session-loading || root.chat-loading;
                select-row(index) => { root.select-row(index); }
                select-device(device) => { root.select-device(device); }
                new-cloud-thread => { root.cloud-new-thread(); }
                workspace-menu(workspace, action) => { root.workspace-menu(workspace, action); }
                new-workspace => { root.new-workspace(); }
                move-row(index, travel) => { root.move-row(index, travel); }
                archive-thread(id) => {
                    root.thread-archive-cloud-id = "";
                    root.thread-archive-pending = id;
                    root.thread-archive-open = true;
                }
                rename-request(payload, title) => {
                    root.thread-rename-cloud-id = "";
                    root.thread-rename-payload = payload;
                    root.thread-rename-title = title;
                    root.thread-rename-draft = title;
                    root.thread-rename-open = true;
                }
                open-trajectory(index) => { root.open-trajectory(index); }
                cloud-rename-request(id, title) => {
                    root.thread-rename-cloud-id = id;
                    root.thread-rename-title = title;
                    root.thread-rename-draft = title;
                    root.thread-rename-open = true;
                }
                cloud-archive-request(id) => {
                    root.thread-archive-cloud-id = id;
                    root.thread-archive-open = true;
                }
                cloud-open-trajectory(id) => { root.cloud-open-trajectory(id); }
                selection-mode: root.sidebar-selection-mode;
                selected-count: root.sidebar-selected-count;
                archivable-count: root.sidebar-archivable-count;
                begin-selection => { root.sidebar-begin-selection(); }
                exit-selection => { root.sidebar-exit-selection(); }
                toggle-selection(index) => { root.sidebar-toggle-selection(index); }
                select-all-threads => { root.sidebar-select-all(); }
                archive-selected => { root.sidebar-archive-selected(); }
                open-settings => { root.more-open = false; root.settings-open = true; root.settings-active-panel = 0; root.refresh-settings(); }
                // Working-directory region: model and actions live on the
                // window shell, the sidebar only forwards.
                file-rows: root.ws-file-rows;
                file-stats: root.ws-file-stats;
                file-loading: root.ws-file-loading;
                file-error: root.ws-file-error;
                file-offline: root.ws-file-offline;
                file-busy: root.ws-file-busy;
                file-active-path: root.ws-file-active-path;
                file-active-index: root.ws-file-active-index;
                file-key(action) => { root.ws-file-key(action); }
                split-ratio <=> root.sidebar-split-ratio;
                layout-changed => { root.sidebar-layout-changed(); }
                file-local: root.ws-file-local;
                file-toggle(index) => { root.ws-file-toggle(index); }
                file-refresh => { root.ws-file-refresh(); }
                file-connect => { root.more-open = false; root.settings-open = true; root.settings-active-panel = 13; root.refresh-settings(); }
                file-menu(index, action) => { root.ws-file-menu(index, action); }
                file-drag(index) => { root.ws-file-drag(index); }
                file-drop(event) => { root.ws-file-drop(event); }
            }
            // Sidebar width drag handle: press and drag to resize, clamped so
            // the tree never collapses or eats the chat area.
            Rectangle {
                width: 6px;
                background: resize-touch.pressed ? Theme.accent
                    : resize-touch.has-hover ? Theme.border-strong : transparent;
                resize-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    // `mouse-x` is local to this handle. Resizing moves the
                    // handle itself, so using it as the drag origin feeds the
                    // new sidebar width back into the next delta and makes the
                    // divider shake. Track the window-relative pointer instead.
                    property <length> start-absolute-x;
                    property <length> start-width;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.sidebar-width = clamp(root.sidebar-width, 170px, 420px);
                            start-width = root.sidebar-width;
                            start-absolute-x = self.absolute-position.x + self.mouse-x;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.sidebar-width = clamp(start-width + (self.absolute-position.x + self.mouse-x - start-absolute-x), 170px, 420px);
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.chat;
                VerticalLayout {
                    spacing: 0px;
                    // The transcript owns the full column height: the web form
                    // dropped the top bar, so the workspace/thread identity it
                    // carried lives only in the sidebar now.
                    // The transcript holder is a small wrapper so the timeline
                    // stays reachable from outside: a `public function` cannot
                    // name an element that an `if` may remove, so the two views
                    // toggle on `visible` instead of being conditionally built.
                    follow_view := Rectangle {
                        vertical-stretch: 1;
                        out property <length> scroll-y: timeline_view.scroll-y;
                        public function scroll-to-end() { timeline_view.scroll-to-end(); }
                        timeline_view := TimelineView {
                            visible: true;
                            rows: root.timeline;
                            loading: root.chat-loading || root.session-loading
                                || (root.cloud-chat-active && root.cloud-thread-busy);
                            loading-text: root.session-loading ? (I18n.zh ? "正在打开线程，读取历史记录…" : "Opening thread and reading history…")
                                : root.chat-loading ? I18n.st_runtime_loading
                                : root.cloud-chat-active && root.cloud-thread-busy ? (I18n.zh ? "正在打开线程，读取历史记录…" : "Opening thread and reading history…")
                                : I18n.st_runtime_loading;
                            greeting: root.cloud-chat-active ? root.cloud-greeting
                                : root.agents.length > 0 ? root.agents[0].description : "";
                            greeting-loading: root.prompt-preview-loading;
                            preview-prompt => { root.open-prompt-preview(); }
                            show-activity: root.timeline.length == 0 && !root.chat-loading
                                && !root.session-loading && !root.cloud-thread-busy;
                            activity-sessions: root.activity-sessions;
                            activity-credits: root.activity-credits;
                            activity-months: root.activity-months;
                            activity-tab <=> root.activity-tab;
                            turn-marks: root.turn-marks;
                            follow-output <=> root.follow-output;
                            spinning: root.busy;
                            stream-revision: root.stream-updates;
                            toggle(index) => { root.timeline-toggle(index); }
                            process-page(index, direction) => { root.timeline-process-page(index, direction); }
                            copy-text(text) => { root.copy-raw(text); }
                            copy-original(id) => { root.cloud-copy-original(id); }
                            open-resource(id) => { root.timeline-open(id); }
                            open-subagent(id) => { root.timeline-open-subagent(id); }
                            stop-subagent(id) => { root.timeline-stop-subagent(id); }
                        }
                    }
                    // Status dock: the plan capsule sits between the timeline
                    // and the goal banner; its checklist card overlaps the
                    // timeline via negative y. It shows up only while the plan
                    // tool has steps — the turn's phase text already reads on
                    // the timeline rows, and queue position is folded into the
                    // timeline too, so the old banners are gone.
                    // The whole input band shares the transcript's reading column:
                    // a layout child may not re-declare width (that is a binding
                    // loop), so the row stays full width and centres its band.
                    Rectangle {
                        height: input-band.preferred-height;
                        input-band := VerticalLayout {
                            width: min(parent.width, Theme.timeline-column-width);
                            x: (parent.width - self.width) / 2;
                            spacing: 0px;
                            if root.activity-steps-total > 0 : StatusDock {
                                running: root.activity-running;
                                steps-done: root.activity-steps-done;
                                steps-total: root.activity-steps-total;
                                plan-explanation: root.activity-plan-explanation;
                                plan-steps: root.activity-plan-steps;
                                current-step: root.activity-plan-current;
                                current-position: root.activity-plan-position;
                                expanded <=> root.activity-plan-expanded;
                                dismiss => { root.activity-plan-dismiss(); }
                            }
                            if root.goal-visible && root.goal-objective != "" : GoalBanner {
                                objective: root.goal-objective;
                                elapsed: root.goal-elapsed;
                                phase: root.goal-phase;
                                activation: root.goal-activation;
                                rounds: root.goal-rounds;
                                paused: root.goal-paused;
                                editing <=> root.goal-editing;
                                edit-draft <=> root.goal-edit-draft;
                                save(text) => { root.goal-save(text); }
                                pause-toggle => { root.goal-pause-toggle(); }
                                clear => { root.goal-clear(); }
                            }
                            if root.inquiry-visible && root.inquiry-session == root.active-session-id : InquiryPanel {
                                questions: root.inquiry-questions;
                                page: root.inquiry-page;
                                total: root.inquiry-total;
                                expanded: root.inquiry-expanded;
                                option-clicked(row, option) => { root.inquiry-option-clicked(row, option); }
                                other-edited(row, text) => { root.inquiry-other-edited(row, text); }
                                no-preference(row) => { root.inquiry-no-preference(row); }
                                use-recommended(row) => { root.inquiry-use-recommended(row); }
                                page-move(delta) => { root.inquiry-page-move(delta); }
                                expanded-toggle => { root.inquiry-expanded-toggle(); }
                            }
                            composer := Composer {
                                draft <=> root.draft; busy: root.command-pending || root.session-loading || root.creating-session || (root.chat-loading && !root.busy) || (root.cloud-chat-active && root.cloud-thread-busy);
                            terminal-mode: false;
                            command => { root.terminal-mode = !root.terminal-mode; root.terminal-toggled(root.terminal-mode); }
                            send-key: root.runtime-send-key;
                            interrupt => { }
                            context-usage: root.context-usage; context-known: root.context-known; context-counts: root.context-counts; reasoning-effort <=> root.reasoning-effort;
                            models: root.cloud-chat-active ? root.cloud-thread-models : root.models;
                            // The local built-in agent owns the saved quick prompts; a
                            // cloud thread keeps its service-side composer scope.
                            preset-questions: root.cloud-chat-active ? [] : root.selected-agent-preset-questions;
                            model-catalogue-count: root.cloud-chat-active ? root.cloud-thread-models.length : root.model-catalogue-count;
                            cloud-ready: root.cloud-logged-in && !root.cloud-expired;
                            model-name: root.selected-model-key != "" ? root.selected-model-key : root.selected-agent-model;
                            model-key: root.selected-model-key;
                            model-saving: root.saving;
                            select-model(index, key) => { root.select-thread-model(key); }
                            open-model-settings => { root.settings-open = true; root.settings-active-panel = 1; root.refresh-settings(); }
                            workspace-name: root.cloud-chat-active ? I18n.il_browse_title : root.active-workspace-name;
                            branch-name: root.active-workspace-branch;
                            permission-mode <=> root.permission-mode;
                            permission-changed(value) => { root.save-permission-mode(value); }
                            attachments: root.pending-attachments;
                            inquiry-ready: root.inquiry-ready;
                            queue-turns: root.queue-turns;
                            queue-overflow: root.queue-overflow;
                            queue-interject(queue-id) => { root.queue-interject(queue-id); }
                            queue-edit(queue-id) => { root.queue-edit(queue-id); }
                            queue-remove(queue-id) => { root.queue-remove(queue-id); }
                            queue-move-by(queue-id, delta) => { root.queue-move-by(queue-id, delta); }
                            recall-history(direction, cursor-offset, anchor-offset, draft) => {
                                return root.recall-history(direction, cursor-offset, anchor-offset, draft);
                            }
                            generating: root.busy || root.goal-active; stopping: root.stopping; stop => { root.stop-generation(); }
                            recording: root.recording; transcribing: root.transcribing; recording-elapsed: root.recording-elapsed; recording-pulse: root.recording-pulse;
                            send => { root.send-message(); }
                            screenshot(hide-window, region) => { root.capture-screenshot(hide-window, region); }
                            record-voice => { root.record-voice(); }
                            reasoning-effort-changed(value) => { root.save-session-reasoning-effort(value); }
                            remove-attachment(index) => { root.remove-attachment(index); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Frameless chrome. Its z sits above the in-window overlays so the window
    // can always be dragged, minimized or closed, even with a dialog open.
    WindowChrome {
        width: root.width;
        title: root.title;
        icon: @image-url("../assets/app-icon.png");
        maximized: root.maximized;
        drag-requested => { root.window-drag-requested(); }
        minimize-requested => { root.window-minimize-requested(); }
        maximize-requested => { root.window-maximize-requested(); }
        close-requested => { root.window-close-requested(); }
    }
    WindowFrame { }

    // Settings live in an internal overlay window instead of replacing the
    // chat area: the shield closes it on click-away, the card swallows stray
    // clicks and the header row carries the window title plus close action.
    if root.settings-open : Rectangle {
        z: 220;
        background: Theme.overlay;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: min(1080px, root.width - 72px);
            height: min(720px, root.height - 56px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xl;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000033;
            TouchArea { }
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 44px;
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Image { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/gear.svg"); colorize: Theme.muted; }
                    Text {
                        height: parent.height;
                        text: I18n.sidebar_settings;
                        color: Theme.text; font-size: Theme.font-lg; font-weight: 600;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                    Action {
                        width: 28px; height: 28px;
                        icon: @image-url("../assets/icons/xmark.svg");
                        clicked => { root.settings-open = false; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
        SettingsPage {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        loading: root.settings-loading; saving: root.saving;
        status: root.status;
        settings-category-flags: root.settings-category-flags;
        models: root.models; selected-model: root.selected-model;
        workspace-root <=> root.workspace-root; language <=> root.runtime-language;
        // The profile card and its edit dialog stay on the shell (the rail's
        // profile route owns them); the settings page no longer shows a
        // separate identity panel, so nothing is bound through it.
        python-path <=> root.runtime-python; git-path <=> root.runtime-git; rg-path <=> root.runtime-rg;
        python-status: root.runtime-python-status; git-status: root.runtime-git-status; rg-status: root.runtime-rg-status;
        importing-supplement <=> root.importing-supplement; supplement-status <=> root.supplement-status;
        import-supplement => { root.import-supplement(); }
        pick-python-path => { root.pick-python-path(); }
        pick-git-path => { root.pick-git-path(); }
        pick-rg-path => { root.pick-rg-path(); }
        stress-running <=> root.stress-running;
        stress-user-rounds <=> root.stress-user-rounds;
        stress-model-rounds <=> root.stress-model-rounds;
        stress-status <=> root.stress-status;
        generate-stress-thread => { root.generate-stress-thread(); }
        save-runtime => { root.save-runtime(); }
        selected-key: root.settings-model-key; selected-provider: root.settings-model-provider;
        selected-model-name: root.settings-model-name; selected-base-url: root.settings-model-base-url;
        selected-type: root.settings-model-type; selected-is-default: root.settings-model-is-default;
        selected-card: root.selected-model-card;
        model-editor-provider: root.model-provider-draft;
        model-editor-name: root.model-name-draft;
        model-editor-base-url: root.model-base-url-draft;
        model-editor-type: root.model-type-draft;
        model-editor-is-default: root.selected-model-is-default;
        delete-model(key) => { root.delete-model(key); }
        select-model(index) => { root.select-model(index); }
        create-model => { root.open-new-model(); root.create-model(); }
        discard-model-draft => { root.discard-model-draft(); }
        move-model(from, delta) => { root.move-model(from, delta); }
        save-model => { root.save-model(); }
        set-default-model(key) => { root.set-default-model(key); }
        refresh => { root.refresh-settings(); }
        // ---- cloud account (§6.1) ----
        cloud-logged-in <=> root.cloud-logged-in;
        cloud-inbound-enabled <=> root.cloud-inbound-enabled;
        cloud-full-shadow <=> root.cloud-full-shadow;
        cloud-toggle-sharing(enabled, full) => { root.cloud-toggle-sharing(enabled, full); }
        cloud-expired <=> root.cloud-expired;
        cloud-username <=> root.cloud-username;
        cloud-balance <=> root.cloud-balance;
        cloud-concurrency <=> root.cloud-concurrency;
