                        for color in ["#3b82f6", "#10b981", "#f97316", "#8b5cf6", "#ec4899", "#64748b"] : Rectangle { width: 20px; height: 20px; border-radius: Theme.radius-md; background: color == "#3b82f6" ? Theme.info : color == "#10b981" ? #10b981 : color == "#f97316" ? #f97316 : color == "#8b5cf6" ? #8b5cf6 : color == "#ec4899" ? #ec4899 : #64748b; border-width: root.profile.avatar-color == color ? 2px : 0px; border-color: Theme.text; TouchArea { clicked => { root.save-profile-avatar(root.profile.avatar-icon, color); } } }
                    }
