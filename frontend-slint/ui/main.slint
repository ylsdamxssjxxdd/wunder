import { Theme, DesktopPage, Conversation, TextBlock, ChatMessage, ChatAttachment, FileCard, AgentCard, ToolCard, ModelCard, ProfileCard, LanPeerCard, ThreadLogEvent, WorldContactCard, WorldGroupCard, WorldMessageCard, CronCard } from "theme.slint";
import { Action, EdgeToggle, RailButton, Avatar, SearchField, FormField } from "components.slint";
import { Composer } from "composer.slint";
import { MessageRow } from "message.slint";
import { WorkDock } from "dock.slint";
import { FilesPage } from "files_page.slint";
import { WorldPage } from "world_page.slint";
import { CronPage } from "cron_page.slint";
import { AgentsPage, ToolsPage, SettingsPage } from "entity_pages.slint";
import { TextEditBase } from "textedit-base.slint";
import { ListView, ScrollView, ComboBox } from "std-widgets.slint";
export { Theme, DesktopPage, Conversation, TextBlock, ChatMessage, ChatAttachment, FileCard, AgentCard, ToolCard, ModelCard, ProfileCard, LanPeerCard, ThreadLogEvent, WorldContactCard, WorldGroupCard, WorldMessageCard, CronCard }
export { AppTray } from "tray.slint";
export { ScreenshotOverlay } from "screenshot_overlay.slint";

export component MainWindow inherits Window {
    title: "心舰 · 蜂巢（Slint 原型）";
    preferred-width: 1360px; preferred-height: 820px;
    min-width: 760px; min-height: 580px;
    default-font-family: "SimSun"; default-font-size: 13px;
    icon: @image-url("../assets/app-icon.png");
    background: Theme.panel;
    in-out property <bool> right-open: true;
    in-out property <bool> navigation-open: true;
    in-out property <int> selected-conversation: 0;
    in-out property <int> active-task: 0;
    in-out property <DesktopPage> page: DesktopPage.messages;
    in-out property <int> selected-agent: -1;
    in-out property <int> selected-model: -1;
    in-out property <string> active-session-id;
    in-out property <string> active-agent-id;
    in-out property <string> heading: "默认智能体";
    in-out property <bool> busy: false;
    in-out property <bool> connected: false;
    in-out property <bool> chat-loading: false;
    in-out property <bool> session-loading: false;
    in-out property <bool> creating-session: false;
    in-out property <bool> agents-loading: false;
    in-out property <bool> tools-loading: false;
    in-out property <bool> files-loading;
    in-out property <string> files-error;
    in-out property <string> directory-path;
    in-out property <string> directory-parent;
    in-out property <int> directory-container-id: 1;
    in-out property <string> directory-root;
    in-out property <int> files-offset;
    in-out property <int> files-total;
    in-out property <bool> preview-open;
    in-out property <bool> preview-loading;
    in-out property <bool> preview-editing: false;
    in-out property <bool> preview-editable: false;
    in-out property <string> preview-path;
    in-out property <string> preview-text;
    in-out property <bool> settings-loading: false;
    in-out property <bool> saving: false;
    in-out property <string> draft;
    in-out property <[ChatAttachment]> pending-attachments: [];
    in-out property <string> status: "本地演示 · 未连接后端";
    in-out property <string> dialog-title;
    in-out property <string> dialog-text;
    in-out property <bool> dialog-open: false;
    in-out property <bool> thread-log-open: false;
    in-out property <string> thread-log-status;
    in-out property <string> thread-log-elapsed;
    in-out property <string> thread-log-rounds;
    in-out property <string> thread-log-tools;
    in-out property <string> thread-log-tokens;
    in-out property <string> thread-log-speed;
    in-out property <[ThreadLogEvent]> thread-log-events: [];
    in-out property <string> thread-log-title;
    in-out property <string> thread-log-query: "";
    in-out property <string> thread-log-filter: "全部";
    private property <bool> thread-log-filter-open: false;
    callback filter-thread-log(string, string);
    private property <bool> dock-overlay-open: false;
    private property <bool> more-open: false;
    in-out property <int> scroll-revision: 0;
    in-out property <[Conversation]> conversations: [
        { id: "demo-0", title: "默认智能体", preview: "随时开始新的对话", time: "刚刚" },
        { id: "demo-1", title: "智能体 01", preview: "上次任务已完成", time: "昨天" },
        { id: "demo-2", title: "智能体 02", preview: "暂无新消息", time: "昨天" }
    ];
    in-out property <[FileCard]> files: [];
    in-out property <[ChatMessage]> messages: [
        { text: "你好，我是你的默认智能体。有什么可以帮助你的吗？", mine: false, time: "09:41", workflow: false, state: "", stats-status: "任务完成", stats-duration: "1.2s", stats-speed: "42.0/s", stats-context: "2.4k", stats-quota: "320", stats-tools: "2", stats-credits: "1", avatar-glyph: "✦", avatar-tone: 1 },
        { text: "请帮我整理一下当前内容。", mine: true, time: "09:42", workflow: false, state: "", stats-status: "", stats-duration: "", stats-speed: "", stats-context: "", stats-quota: "", stats-tools: "", stats-credits: "", avatar-glyph: "", avatar-tone: 0 },
        { text: "已经整理好了。\n\n• 内容已按顺序归纳，便于继续查看。\n• 相关文件可在右侧工作目录中预览。\n• 你可以继续提问，或新建一个任务。\n\n如果需要进一步调整，可以直接告诉我。", mine: false, time: "09:42", workflow: true, state: "", stats-status: "任务完成", stats-duration: "3.4s", stats-speed: "38.0/s", stats-context: "4.1k", stats-quota: "680", stats-tools: "3", stats-credits: "1", avatar-glyph: "✦", avatar-tone: 1 }
    ];
    in-out property <[AgentCard]> agents: [
        { id: "demo-agent", name: "默认智能体", description: "帮助你处理日常任务。", model: "默认模型", system-prompt: "", status: "active", icon-name: "spark", icon-color: "#f97316", icon-glyph: "✦", icon-tone: 1, tool-count: 2, tool-names: ["文件操作"], preset-questions: [], sandbox-container-id: 1, approval-mode: "suggest", preview-skill: false, silent: false, prefer-mother: false, preset-question-count: 0, is-shared: false, group-name: "默认蜂房" }
    ];
    in-out property <[ToolCard]> tools: [
        { name: "文件操作", description: "读取和整理本地工作目录中的内容", category: "内置工具", enabled: false },
        { name: "技能调用", description: "按权限使用已安装的技能", category: "技能", enabled: false }
    ];
    in-out property <[WorldContactCard]> world-contacts: [];
    in-out property <[WorldGroupCard]> world-groups: [];
    in-out property <int> world-total: 0;
    in-out property <int> world-offset: 0;
    in-out property <bool> world-loading: false;
    in-out property <bool> cron-loading: false;
    in-out property <[CronCard]> cron-jobs: [];
    in-out property <[WorldMessageCard]> world-messages: [];
    in-out property <string> world-active-title;
    in-out property <string> world-active-conversation;
    in-out property <[ModelCard]> models: [
        { key: "默认模型", provider: "", model: "未连接", base-url: "", model-type: "llm", is-default: true }
    ];
    in-out property <string> selected-agent-name;
    in-out property <string> selected-agent-description;
    in-out property <string> selected-agent-model: "默认模型";
    in-out property <string> selected-agent-system-prompt;
    in-out property <string> selected-agent-status;
    in-out property <string> workspace-root;
    in-out property <string> runtime-language;
    in-out property <bool> lan-enabled: false;
    in-out property <string> lan-name;
    in-out property <string> lan-peer-id;
    in-out property <string> lan-endpoint;
    in-out property <int> lan-peer-count: 0;
    in-out property <[LanPeerCard]> lan-peers: [];
    in-out property <string> selected-model-key;
    in-out property <string> selected-model-provider;
    in-out property <string> selected-model-name;
    in-out property <string> selected-model-base-url;
    in-out property <string> selected-model-type;
    in-out property <bool> selected-model-is-default: false;
    in-out property <bool> agent-creator-open: false;
    in-out property <string> agent-name-draft;
    in-out property <bool> model-editor-open: false;
    in-out property <bool> editing-model: false;
    in-out property <string> model-key-draft;
    in-out property <string> model-provider-draft;
    in-out property <string> model-name-draft;
    in-out property <string> model-base-url-draft;
    in-out property <string> model-token-draft;
    in-out property <string> model-type-draft: "llm";
    private property <string> keyword;
    in-out property <bool> stopping: false;
    in-out property <bool> recording: false;
    in-out property <bool> transcribing: false;
    in-out property <string> recording-elapsed: "";
    in-out property <bool> follow-output: true;
    in-out property <int> stream-updates;
    in-out property <int> stream-bytes;
    in-out property <float> stream-max-ui-ms;
    in-out property <int> stream-max-backlog;
    in-out property <float> context-usage: 0.0;
    callback stop-generation();
    callback copy-message(int);
    callback copy-raw(string);
    copy-buffer := TextInput { width: 0px; height: 0px; }
    copy-raw(raw) => { copy-buffer.text = raw; copy-buffer.select-all(); copy-buffer.copy(); copy-buffer.text = ""; }
    callback send-message();
    callback capture-screenshot(bool, bool);
    callback record-voice();
    callback remove-attachment(int);
    callback select-conversation(int);
    callback new-thread();
    callback select-task(int);
    callback refresh-chat();
    callback refresh-agents();
    callback select-agent(int);
    callback create-agent(string);
    callback save-agent(string, string, string, string, string, string, [string], [string], int, string, bool, bool, bool);
    callback toggle-agent-tool(string);
    callback add-agent-question();
    callback remove-agent-question(int);
    callback delete-agent();
    callback refresh-world(bool);
    callback open-world-contact(int);
    callback send-world-message(string);
    callback create-world-group(string);
    callback refresh-cron();
    callback toggle-cron(string, bool);
    callback delete-cron(string);
    in-out property <string> selected-agent-icon-name;
    in-out property <string> selected-agent-icon-color;
    in-out property <string> selected-agent-icon-glyph;
    in-out property <[string]> selected-agent-tool-names: [];
    in-out property <[string]> selected-agent-preset-questions: [];
    in-out property <int> selected-agent-sandbox-container-id: 1;
    in-out property <string> selected-agent-approval-mode: "suggest";
    in-out property <bool> selected-agent-preview-skill: false;
    in-out property <bool> selected-agent-silent: false;
    in-out property <bool> selected-agent-prefer-mother: false;
    in-out property <string> agent-question-draft;
    in-out property <ProfileCard> profile: { user-id: "", username: "", email: "", unit: "", unit-id: "", sessions: "0", sessions-last-7d: "0", tool-calls: "0", tokens: "0", agents: "0", last-active: "", avatar-icon: "initial", avatar-glyph: "✦", avatar-color: "#3b82f6" };
    in-out property <bool> profile-loading: false;
    callback refresh-profile();
    callback save-profile-avatar(string, string);
    callback save-profile(string, string, string);
    in-out property <bool> profile-edit-open: false;
    in-out property <string> profile-username-draft;
    in-out property <string> profile-email-draft;
    in-out property <string> profile-unit-draft;
    callback refresh-tools();
    callback refresh-files();
    callback save-workspace-binding(int, string);
    callback choose-workspace-directory();
    in-out property <bool> workspace-binding-open: false;
    in-out property <int> workspace-binding-container: 1;
    in-out property <string> workspace-binding-path;
    callback thread-menu(int, int);
    callback thread-drop(int, int);
    callback rename-thread(int, string);
    callback archive-thread(int);
    callback navigate-directory(string);
    callback open-file(string);
    callback open-file-native(string);
    callback create-workspace-file(string, string);
    callback workspace-action(string, string, string);
    callback save-workspace-text(string, string);
    callback save-runtime(string, string);
    callback save-lan(bool, string);
    callback refresh-settings();
    callback select-model(int);
    callback save-model(string, string, string, string, string, string);
    callback set-default-model(string);
    changed thread-log-query => { root.filter-thread-log(root.thread-log-query, root.thread-log-filter); }
    changed scroll-revision => { if root.follow-output { messages-view.content-y = min(0px, messages-view.visible-height - messages-view.content-height); } }

    function open-info(title: string, text: string) {
        root.dialog-title = title; root.dialog-text = text; root.dialog-open = true;
    }
    function open-agent-creator() {
        root.agent-name-draft = "";
        root.agent-creator-open = true;
    }
    function open-new-model() {
        root.editing-model = false;
        root.model-key-draft = ""; root.model-provider-draft = ""; root.model-name-draft = "";
        root.model-base-url-draft = ""; root.model-token-draft = ""; root.model-type-draft = "llm";
        root.model-editor-open = true;
    }
    function open-selected-model() {
        root.editing-model = true;
        root.model-key-draft = root.selected-model-key; root.model-provider-draft = root.selected-model-provider;
        root.model-name-draft = root.selected-model-name; root.model-base-url-draft = root.selected-model-base-url;
        root.model-token-draft = ""; root.model-type-draft = root.selected-model-type;
        root.model-editor-open = true;
    }

    Rectangle {
    width: parent.width; height: parent.height;
        Rectangle {
            x: 0px; y: 0px; width: 56px; height: parent.height; background: Theme.rail;
            VerticalLayout {
                padding-top: 10px; padding-bottom: 10px; padding-left: 5px; padding-right: 5px; spacing: 8px;
                Rectangle {
                    height: 44px;
                    TouchArea { clicked => { root.page = DesktopPage.profile; root.refresh-profile(); } }
                    Avatar { width: 38px; height: 38px; mine: false; glyph: root.profile.avatar-glyph; tone: 1; source: @image-url("../assets/avatar.png"); }
                }
                Rectangle { height: 1px; background: #ffffff44; }
                RailButton { icon: @image-url("../assets/icons/comments.svg"); label: "消息"; active: root.page == DesktopPage.messages; clicked => { root.page = DesktopPage.messages; } }
                RailButton { icon: @image-url("../assets/icons/robot.svg"); label: "专家"; active: root.page == DesktopPage.agents; clicked => { root.page = DesktopPage.agents; root.refresh-agents(); } }
                RailButton { icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: "工具"; active: root.page == DesktopPage.tools; clicked => { root.page = DesktopPage.tools; root.refresh-tools(); } }
                RailButton { icon: @image-url("../assets/icons/folder-open.svg"); label: "文件"; active: root.page == DesktopPage.files; clicked => { root.page = DesktopPage.files; root.refresh-files(); } }
                RailButton { icon: @image-url("../assets/icons/comments.svg"); label: "用户"; active: root.page == DesktopPage.users; clicked => { root.page = DesktopPage.users; root.refresh-world(false); } }
                Rectangle { vertical-stretch: 1; }
                RailButton { icon: @image-url("../assets/icons/ellipsis.svg"); label: "更多"; active: root.more-open; clicked => { root.more-open = !root.more-open; } }
            }
        }

        if root.more-open : Rectangle {
            x: 62px; y: parent.height - 166px; width: 208px; height: 150px;
            border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border; z: 20;
            VerticalLayout {
                padding: 8px; spacing: 4px;
                Text { height: 24px; text: "更多"; color: Theme.text; font-size: 13px; font-weight: 600; }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: "系统设置"; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.settings; root.refresh-settings(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: "群组"; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.groups; root.refresh-world(true); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/rotate-right.svg"); label: "定时任务"; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.cron; root.refresh-cron(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/robot.svg"); label: "我的概况"; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.profile; root.refresh-profile(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: "关于心舰"; show-label: true; clicked => { root.more-open = false; root.open-info("关于", "心舰 · 蜂巢\n\n本地原生运行时"); } }
            }
        }

        if root.navigation-open && root.page == DesktopPage.messages : Rectangle {
            x: 56px; y: 0px; width: 220px; height: parent.height; background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 80px;
                    Text { x: 16px; y: 20px; width: parent.width - 32px; text: "消息"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    Text { x: 16px; y: 49px; width: parent.width - 32px; text: "与智能体一起，继续工作"; color: Theme.muted; font-size: 12px; }
                }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索"; text <=> root.keyword; }
                    new-chat := Action { width: 34px; height: 34px; icon: @image-url("../assets/icons/plus.svg"); label: "新建线程"; enabled: !root.busy && !root.creating-session && !root.session-loading && !root.chat-loading && !root.agents-loading; selected: true; clicked => { root.new-thread(); } }
                }
                Rectangle { height: 14px; }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start;
                    for conversation[index] in root.conversations : Rectangle {
                        height: root.keyword == "" || conversation.title.starts-with(root.keyword) ? 68px : 0px;
                        visible: self.height > 0px;
                        Rectangle {
                            x: 8px; y: 2px; width: parent.width - 16px; height: 64px; border-radius: 12px;
                            background: root.selected-conversation == index ? Theme.accent : transparent;
                            Action { width: parent.width; height: parent.height; label: conversation.title; enabled: !root.busy && !root.creating-session && !root.session-loading && !root.chat-loading; clicked => { root.select-conversation(index); } }
                            Avatar { x: 10px; y: 13px; source: @image-url("../assets/avatar.png"); }
                            Text { x: 54px; y: 10px; width: parent.width - 60px; height: 19px; text: conversation.title; color: root.selected-conversation == index ? white : Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { x: 54px; y: 35px; width: parent.width - 62px; height: 16px; text: conversation.preview; color: root.selected-conversation == index ? #ffffffe0 : Theme.muted; font-size: 11px; overflow: elide; }
                        }
                    }
                    }
                }
                Text { height: 36px; text: root.connected ? "本地运行时" : "本地界面预览"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; }
            }
        }

        Rectangle {
            visible: root.page == DesktopPage.messages;
            x: root.navigation-open ? 276px : 56px;
            y: 0px; width: root.width - self.x - (root.right-open && root.width >= 1100px ? 284px : 0px);
            height: parent.height; background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    Text { text: root.heading; color: Theme.text; font-size: 18px; font-weight: 700; overflow: elide; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 104px; icon: @image-url("../assets/icons/plus.svg"); label: "新建线程"; show-label: true; enabled: !root.busy && !root.creating-session && !root.session-loading && !root.chat-loading && !root.agents-loading; clicked => { root.new-thread(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                messages-view := ListView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    scrolled => { root.follow-output = self.content-height + self.content-y <= self.visible-height + 32px; }
                    for message[index] in root.messages : Rectangle {
                        height: message-row.height + 14px;
                        message-row := MessageRow {
                            x: 22px; y: 14px; width: parent.width - 44px;
                            message: message; copy => { root.copy-message(index); } author: root.selected-agent-name == "" ? root.heading : root.selected-agent-name;
                            avatar: @image-url("../assets/avatar.png");
                        }
                    }
                }
                if !root.follow-output : Action { height: 26px; label: "回到最新消息"; show-label: true; clicked => { root.follow-output = true; root.scroll-revision += 1; } }
                Composer {
                    draft <=> root.draft; status: root.status; busy: root.busy || root.session-loading || root.creating-session || root.chat-loading;
                    context-usage: root.context-usage;
                    model-name: root.selected-model-name != "" ? root.selected-model-name : root.selected-agent-model;
                    attachments: root.pending-attachments;
                    generating: root.busy; stopping: root.stopping; stop => { root.stop-generation(); }
                    recording: root.recording; transcribing: root.transcribing; recording-elapsed: root.recording-elapsed;
                    send => { root.send-message(); }
                    attach => { root.capture-screenshot(false, false); }
                    screenshot(hide-window, region) => { root.capture-screenshot(hide-window, region); }
                    record-voice => { root.record-voice(); }
                    remove-attachment(index) => { root.remove-attachment(index); }
                }
            }
        }
        // Preserve the chat's minimum width; the right dock becomes optional.
        if root.page == DesktopPage.messages && root.right-open && root.width >= 1100px : WorkDock {
            files-loading: root.files-loading; files-error: root.files-error; directory-path: root.directory-path; directory-root: root.directory-root; directory-container-id: root.directory-container-id;
            tasks-enabled: !root.busy && !root.session-loading && !root.chat-loading && !root.creating-session;
            conversations: root.conversations;
            files: root.files;
            x: root.width - 284px; y: 0px; width: 284px; height: parent.height; active-task: root.connected ? root.selected-conversation : root.active-task;
            activate-task(index) => { root.select-task(index); }
            preview-file(path) => { root.open-file(path); }
            refresh-files => { root.refresh-files(); }
            save-workspace-binding(container, path) => { root.save-workspace-binding(container, path); }
            thread-menu(index, action) => { root.thread-menu(index, action); }
            thread-drop(from, to) => { root.thread-drop(from, to); }
            rename-thread(index, title) => { root.rename-thread(index, title); }
            archive-thread(index) => { root.archive-thread(index); }
            file-menu(path, action) => { if action == 0 { root.open-file(path); } else if action == 1 { root.copy-raw(path); } else if action == 3 { root.open-file-native(path); } else { root.refresh-files(); } }
            create-file(kind, path) => { root.create-workspace-file(kind, path); }
            open-workspace-binding => { root.workspace-binding-container = root.directory-container-id; root.workspace-binding-path = root.directory-root; root.workspace-binding-open = true; }
        }

        // These transparent hitboxes match the web client's divider controls:
        // the circular affordance appears only while the pointer is near a
        // sidebar edge, centred vertically on the divider.
        if root.page == DesktopPage.messages : EdgeToggle {
            x: (root.navigation-open ? 276px : 56px) - 4px;
            y: (root.height - 48px) / 2;
