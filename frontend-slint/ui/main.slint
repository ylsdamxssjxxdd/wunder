    callback pick-git-path();
    callback pick-rg-path();
    // The settings page's active category, shared with the smoke harness.
    in-out property <int> settings-active-panel: 0;
    changed settings-open => {
        if !root.settings-open && root.model-creating { root.discard-model-draft(); }
    }
    // Memory, usage and archive data are pulled on demand: the old expert page's
    // own tab strip is gone, so the active category is what selects the view.
    changed settings-active-panel => {
        if root.settings-active-panel == 6 || root.settings-active-panel == 10
            || root.settings-active-panel == 13 {
            root.refresh-expert();
        }
    }
    // ---- cloud account state (§6.1) ----
    // Login state and the quota snapshot are projected natively; the drafts
    // and the error line live on the shell so the settings card stays plain
    // two-way data. The password draft never leaves the process.
    in-out property <bool> cloud-logged-in: false;
    in-out property <bool> cloud-inbound-enabled: false;
    in-out property <bool> cloud-full-shadow: false;
    callback cloud-toggle-sharing(bool, bool);
    in-out property <bool> cloud-expired: false;
    in-out property <string> cloud-username;
    in-out property <string> cloud-balance;
    in-out property <string> cloud-concurrency;
    in-out property <bool> cloud-quota-warn: false;
    in-out property <bool> cloud-sync-enabled: true;
    // Active cloud queue position from the `cloud_queue` incremental event,
    // or -1 when no turn is waiting.
    in-out property <int> cloud-queue-position: -1;
    in-out property <bool> cloud-busy: false;
    in-out property <string> cloud-error;
    // Engine connection machine (`online|reconnecting|expired|logged_out`)
    // plus the pre-formatted relative strings for the settings status row.
    in-out property <string> cloud-connection;
    in-out property <string> cloud-last-error;
    in-out property <string> cloud-last-success;
    in-out property <string> cloud-next-retry;
    in-out property <string> cloud-server-draft;
    in-out property <string> cloud-user-draft;
    in-out property <string> cloud-pass-draft;
    // Cloud conversations use the same timeline and composer as local
    // workspaces. The flag only chooses the data source.
    in-out property <bool> cloud-chat-active: false;
    in-out property <[ModelCard]> cloud-thread-models: [];
    in-out property <[CloudThreadCard]> cloud-thread-rows;
    in-out property <int> cloud-thread-index: 0;
    in-out property <string> cloud-active-thread-id;
    in-out property <string> cloud-thread-status;
    in-out property <bool> cloud-thread-busy;
    callback cloud-open-threads();
    callback cloud-new-thread();
    callback cloud-reload-threads();
    callback cloud-select-thread(int);
    callback cloud-login();
    callback cloud-password-edited(string);
    callback cloud-logout();
    callback cloud-refresh-account();
    callback open-wunder-model();
    callback cloud-toggle-sync(bool);
    // ---- interlink approval (§I9) ----
    // The 2s poll drains the approval queue; the settings page no longer
    // browses devices or the cloud workspace, so only the one-at-a-time
    // remote-command card is left on the shell.
    in-out property <InterlinkApproval> interlink-approval;
    in-out property <bool> interlink-approval-open: false;
    callback interlink-approve();
    callback interlink-reject();
    // ---- working directory (左栏工作目录区, 蜂巢 B2) ----
    // The cloud workspace file tree: one flat row model projected by the
    // native controller (lazy directories, paged), a usage line and the
    // tunnel-derived offline state. `toggle` opens files (pull + open) and
    // expands directories; `refresh` reloads the root and every expanded
    // directory in one bounded pass.
    in-out property <[WorkspaceFileRow]> ws-file-rows: [];
    in-out property <string> ws-file-stats;
    in-out property <bool> ws-file-loading: false;
    in-out property <string> ws-file-error;
    in-out property <bool> ws-file-offline: true;
    in-out property <bool> ws-file-busy: false;
    in-out property <string> ws-file-active-path;
    in-out property <int> ws-file-active-index: -1;
    callback ws-file-key(int);
    in-out property <float> sidebar-split-ratio: 0.6;
    callback sidebar-layout-changed();
    // Which folder the working-directory region browses: false = the cloud
    // workspace, true = a local workspace folder (cloud-only actions hide,
    // file operations run straight off the disk).
    in-out property <bool> ws-file-local: false;
    callback ws-file-toggle(int);
    callback ws-file-refresh();
    // Context menu (row index or -1 for the blank area, action code),
    // drag-out download on a row, and the Explorer drop upload.
    callback ws-file-menu(int, int);
    callback ws-file-drag(int);
    callback ws-file-drop(DropEvent);
    // The working-directory prompt dialog (rename / new dir / new file /
    // delete / cloud-approval confirm), driven by the native controller.
    in-out property <bool> ws-prompt-open: false;
    in-out property <string> ws-prompt-title;
    in-out property <string> ws-prompt-body;
    in-out property <bool> ws-prompt-input: false;
    in-out property <string> ws-prompt-value;
    in-out property <string> ws-prompt-confirm: I18n.common_confirm;
    in-out property <bool> ws-prompt-danger: false;
    in-out property <bool> ws-prompt-busy: false;
    callback ws-prompt-accepted(string);
    callback ws-prompt-canceled();
    // The thread rename prompt. The sidebar's pen only asks for it (payload and
    // current title); the draft stays here until the dialog confirms, so an
    // accidental click can no longer rewrite a thread title.
    in-out property <bool> thread-rename-open: false;
    in-out property <int> thread-rename-payload: -1;
    in-out property <string> thread-rename-title;
    in-out property <string> thread-rename-draft;
    in-out property <string> thread-rename-cloud-id;
    // Archive confirmation keeps a stable thread id instead of a mutable list
    // index, so a catalogue refresh cannot redirect a confirmed archive.
    in-out property <bool> thread-archive-open: false;
    in-out property <string> thread-archive-pending;
    in-out property <string> thread-archive-cloud-id;
    in-out property <string> selected-model-key;
