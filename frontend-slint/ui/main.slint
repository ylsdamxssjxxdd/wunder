    title: I18n.app_window_title;
    // Open the desktop workbench maximized. The native bootstrap repeats this
    // after mapping on window managers that defer the initial request.
    maximized: true;
    preferred-width: 1280px; preferred-height: 860px;
    min-width: Theme.min-window-width; min-height: Theme.min-window-height;
    default-font-family: "Microsoft YaHei"; default-font-size: Theme.font-md;
    icon: @image-url("../assets/app-icon.png");
    background: Theme.panel;
    in-out property <int> selected-agent: -1;
    in-out property <int> selected-model: -1;
    in-out property <string> active-session-id;
    in-out property <string> active-agent-id;
    in-out property <string> heading;
    in-out property <bool> busy: false;
    in-out property <bool> command-pending: false;
    // Terminal mode routes the composer input to the local shell instead of
    // the model; toggled from the TerminalAction button in the composer.
    in-out property <bool> terminal-mode: false;
    callback terminal-toggled(bool);
    callback terminal-interrupt();
    callback terminal-clear();
    callback terminal-scrolled(int);
    callback terminal-scroll-to(int);
    // The panel measures its own cell box, so a window resize changes the grid
    // even while the shell prints nothing. The screen model has to follow and
    // tell the shell, or the two disagree about where a line ends.
    callback terminal-geometry-changed();
    in-out property <int> terminal-measured-cols: 0;
    in-out property <int> terminal-measured-rows: 0;
    changed terminal-measured-cols => { root.terminal-geometry-changed(); }
    changed terminal-measured-rows => { root.terminal-geometry-changed(); }
    in-out property <[TermSpan]> terminal-spans;
    in-out property <string> terminal-status;
    in-out property <bool> terminal-error: false;
    in-out property <int> terminal-rows: 24;
    in-out property <int> terminal-cols: 80;
    in-out property <int> terminal-view-offset: 0;
    in-out property <int> terminal-history-depth: 0;
    in-out property <bool> terminal-caret-visible: false;
    in-out property <int> terminal-caret-row: 0;
    in-out property <int> terminal-caret-col: 0;
    in-out property <string> command-feedback;
    changed command-feedback => {
        ToastState.message = root.command-feedback;
        ToastState.kind = root.command-feedback.starts-with("命令执行失败") ? 2 : 0;
        ToastState.revision += 1;
    }
    // Backend errors only ever land on `status`, which no chat view renders;
    // surface error-shaped statuses as toasts so a failed runtime or storage
    // read can never look like a dead UI again.
    changed status => {
        if root.status.starts-with(I18n.cp_error_prefix) || root.status.starts-with(I18n.cp_fail_prefix) {
            ToastState.message = root.status;
            ToastState.kind = 2;
            ToastState.revision += 1;
        }
    }
    in-out property <bool> goal-active: false;
    // Goal banner state; the projection and the observer goal tick write the
    // objective, the accumulated seconds and the paused flag. The preview
    // values only exist so slint-viewer renders the banner without a backend.
    in-out property <string> goal-objective: I18n.tlp_organize;
    in-out property <int> goal-seconds: 0;
    in-out property <string> goal-elapsed: I18n.cpv_goal_elapsed_demo;
    in-out property <bool> goal-paused: false;
    in-out property <bool> goal-editing: false;
    in-out property <string> goal-edit-draft;
    callback goal-save(string);
    callback goal-pause-toggle();
    callback goal-clear();
    // ---- status dock (activity capsule above the goal banner) ----
    // The preview defaults exist so slint-viewer renders the dock without a
    // backend; the native projection resets them on connect and overwrites
    // them from the live turn on every flush frame.
    in-out property <bool> activity-active: true;
    in-out property <string> activity-text: I18n.dock_queue_prefix + 2 + I18n.dock_queue_suffix;
    in-out property <int> activity-steps-done: 0;
    in-out property <int> activity-steps-total: 3;
    in-out property <int> activity-files-changed: 2;
    in-out property <int> activity-added-lines: 118;
    in-out property <int> activity-deleted-lines: 12;
    in-out property <string> activity-plan-explanation: I18n.dock_demo_explain;
    in-out property <[PlanStep]> activity-plan-steps: [
        { step: I18n.dock_demo_step_1, status: "completed" },
        { step: I18n.dock_demo_step_2, status: "in_progress" },
        { step: I18n.dock_demo_step_3, status: "pending" },
    ];
    // Dismissal clears through the Rust side (plan cache + turn state) so the
    // next flush frame cannot silently restore the checklist.
    callback activity-plan-dismiss();
    // Fractional offset of every user turn for the right-edge ruler. The
    // preview marks match the fixture timeline (user rows at 0 and 3 of 6).
    in-out property <[float]> turn-marks: [0.0, 0.5];
    in-out property <bool> connected: false;
    in-out property <bool> chat-loading: false;
    in-out property <bool> session-loading: false;
