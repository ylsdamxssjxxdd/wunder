                        Rectangle { width: 44px; height: 44px; border-radius: 22px; background: Theme.accent-soft; Text { width: parent.width; height: parent.height; text: root.profile.avatar-glyph; color: Theme.accent-deep; font-size: 19px; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout { spacing: 2px; Text { height: 19px; text: root.profile.username; color: Theme.text; font-size: Theme.font-md; font-weight: 600; overflow: elide; } Text { height: 15px; text: "ID " + root.profile.user-id; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; } }
                    }
