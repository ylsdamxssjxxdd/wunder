        cron-editor-open <=> root.cron-editor-open; cron-editor-saving <=> root.cron-editor-saving;
        cron-edit-kind <=> root.cron-editor-kind; cron-edit-name <=> root.cron-edit-name;
        cron-edit-at <=> root.cron-edit-at; cron-edit-every <=> root.cron-edit-every;
        cron-edit-cron <=> root.cron-edit-cron; cron-edit-tz <=> root.cron-edit-tz;
        cron-edit-message <=> root.cron-edit-message; cron-edit-agent <=> root.cron-edit-agent;
        cron-edit-delete-after <=> root.cron-edit-delete-after; cron-edit-enabled <=> root.cron-edit-enabled;
        cron-runs-open <=> root.cron-runs-open; cron-runs-loading: root.cron-runs-loading;
        cron-runs-title: root.cron-runs-title; cron-runs: root.cron-runs;
        refresh-cron => { root.refresh-cron(); }
        toggle-cron(id, enabled) => { root.toggle-cron(id, enabled); }
        delete-cron(id) => { root.delete-cron(id); }
        run-cron-now(id) => { root.run-cron-now(id); }
        open-cron-runs(id) => { root.open-cron-runs(id); }
        close-cron-runs => { root.close-cron-runs(); }
        open-cron-creator => { root.open-cron-creator(); }
        edit-cron-job(id) => { root.edit-cron-job(id); }
        save-cron-editor => { root.save-cron-editor(); }
        cancel-cron-editor => { root.cancel-cron-editor(); }

        channel-loading: root.channel-loading; channel-catalog: root.channel-catalog;
        channel-accounts: root.channel-accounts; selected-channel-account: root.selected-channel-account;
        channel-bindings: root.channel-bindings; channel-bindings-loading: root.channel-bindings-loading;
        channel-logs-loading: root.channel-logs-loading; channel-logs: root.channel-logs;
        channel-editor-open: root.channel-editor-open; channel-editor-saving: root.channel-editor-saving;
        channel-edit-id: root.channel-edit-id; channel-edit-kind <=> root.channel-edit-kind;
        channel-edit-agent <=> root.channel-edit-agent;
        channel-agent-names: root.channel-agent-names; channel-catalog-names: root.channel-catalog-names;
        channel-delete-open: root.channel-delete-open; channel-qr-open: root.channel-qr-open;
        channel-qr-state: root.channel-qr-state; channel-qr-image: root.channel-qr-image;
        channel-qr-message: root.channel-qr-message;
        channel-edit-name <=> root.channel-edit-name; channel-edit-enabled <=> root.channel-edit-enabled;
        channel-edit-group-chat <=> root.channel-edit-group-chat;
        channel-edit-app-id <=> root.channel-edit-app-id;
        channel-edit-app-secret <=> root.channel-edit-app-secret;
        channel-edit-corp-id <=> root.channel-edit-corp-id;
        channel-edit-wechat-agent <=> root.channel-edit-wechat-agent;
        channel-edit-secret <=> root.channel-edit-secret; channel-edit-token <=> root.channel-edit-token;
        channel-edit-aes-key <=> root.channel-edit-aes-key;
        channel-edit-original-id <=> root.channel-edit-original-id;
        channel-edit-api-base <=> root.channel-edit-api-base;
        channel-edit-bot-token <=> root.channel-edit-bot-token;
        channel-edit-bot-id <=> root.channel-edit-bot-id;
        channel-edit-user-id <=> root.channel-edit-user-id;
        channel-edit-domain <=> root.channel-edit-domain;
        channel-edit-config-json <=> root.channel-edit-config-json;
        refresh-channels => { root.refresh-channels(); }
        select-channel-account(index) => { root.select-channel-account(index); }
        open-channel-creator => { root.open-channel-creator(); }
        edit-channel-account => { root.edit-channel-account(); }
        save-channel-editor => { root.save-channel-editor(); }
        cancel-channel-editor => { root.cancel-channel-editor(); }
        request-delete-channel => { root.request-delete-channel(); }
        confirm-delete-channel => { root.confirm-delete-channel(); }
        cancel-delete-channel => { root.cancel-delete-channel(); }
        toggle-channel-account(enabled) => { root.toggle-channel-account(enabled); }
        open-channel-logs => { root.open-channel-logs(); }
        probe-channel-logs => { root.probe-channel-logs(); }
        clear-channel-logs => { root.clear-channel-logs(); }
        delete-channel-binding(account, target) => { root.delete-channel-binding(account, target); }
        start-channel-qr => { root.start-channel-qr(); }
        cancel-channel-qr => { root.cancel-channel-qr(); }
        reconnect-channel => { root.reconnect-channel(); }

        expert-loading: root.expert-loading; expert-saving: root.expert-saving;
        expert-error: root.expert-error; expert-memories: root.expert-memories;
        expert-archives: root.expert-archives; expert-points: root.expert-points;
        expert-duration: root.expert-duration;
        expert-tokens: root.expert-tokens; expert-calls: root.expert-calls;
        expert-chart-path: root.expert-chart-path; expert-chart-max: root.expert-chart-max;
        expert-date: root.expert-date; expert-archive-page: root.expert-archive-page;
        expert-archive-total: root.expert-archive-total;
        expert-query <=> root.expert-query; expert-category <=> root.expert-category;
        expert-categories: root.expert-categories;
        memory-editor-open <=> root.memory-editor-open; memory-edit-id <=> root.memory-edit-id;
        memory-edit-title <=> root.memory-edit-title; memory-edit-content <=> root.memory-edit-content;
        memory-edit-category <=> root.memory-edit-category;
        expert-agent-names: root.expert-agent-names;
        refresh-expert => { root.refresh-expert(); }
        replicate-expert-memory(index) => { root.replicate-expert-memory(index); }
        open-expert-memory(index) => { root.open-expert-memory(index); }
        save-expert-memory => { root.save-expert-memory(); }
        delete-expert-memory(id) => { root.delete-expert-memory(id); }
        open-expert-archive(id) => { root.open-expert-archive(id); }

        settings-query <=> root.settings-query;
        settings-search(query) => { root.filter-settings-categories(query); }
        open-help => { root.open-help(); }
        // §9.3 agent form. Every editable field is two-way bound so the settings
        // panel writes the drafts the native save handler reads back, and the
        // panel's own `changed` hooks keep the dirty flag honest.
        selected-agent-name <=> root.selected-agent-name;
        selected-agent-description <=> root.selected-agent-description;
        selected-agent-system-prompt <=> root.selected-agent-system-prompt;
        expert-tool-groups: root.expert-tool-groups;
        expert-tool-keyword <=> root.expert-tool-keyword;
        agents-loading: root.agents-loading;
        agent-question-draft <=> root.agent-question-draft;
        toggle-agent-tool-option(name) => { root.toggle-agent-tool-option(name); }
        toggle-expert-tool-group(category) => { root.toggle-expert-tool-group(category); }
        search-expert-tools => { root.search-expert-tools(); }
        refresh-agents => { root.refresh-agents(); }
        add-agent-question => { root.add-agent-question(); }
        remove-agent-question(index) => { root.remove-agent-question(index); }
        save-agent-form => { root.save-agent-form(); }
        agent-save-pending <=> root.agent-save-pending;
        queue-agent-save => { root.queue-agent-save(); }
        refresh-agent-dirty => { root.refresh-agent-dirty(); }
        open-info(title, text) => { root.open-info(title, text); }
        }
            }
        }
    }

    if root.dialog-open : InfoDialog {
        title: root.dialog-title;
        message: root.dialog-text;
        close-label: I18n.info_ack;
        closed => { root.dialog-open = false; }
    }
    if root.traj-open : ThreadTrajectoryDialog {
        rows: root.traj-rows; spans: root.traj-spans; ticks: root.traj-ticks; boundaries: root.traj-boundaries;
        view-start: root.traj-view-start; view-width: root.traj-view-width;
        selection-active: root.traj-selection-active; selection-start: root.traj-selection-start; selection-end: root.traj-selection-end;
        detail-header: root.traj-detail-header; detail-badge: root.traj-detail-badge; detail-kind: root.traj-detail-kind;
        detail-tabs: root.traj-detail-tabs; detail-tab: root.traj-detail-tab;
        overview-rows: root.traj-overview; sections: root.traj-sections; timing-rows: root.traj-timing;
        raw-text: root.traj-raw; selected-index: root.traj-selected; hover-index: root.traj-hover;
        ledger-scroll: root.traj-ledger-scroll; ledger-scroll-seq: root.traj-ledger-scroll-seq;
        tooltip-text: root.traj-tooltip;
        show-duration: root.traj-show-duration; show-turns <=> root.traj-show-turns; show-calls <=> root.traj-show-calls;
        query <=> root.traj-query;
        search-hint: root.traj-search-hint;
        search-hits: root.traj-search-hits;
        search-body: root.traj-search-body;
        loading: root.traj-loading; failed: root.traj-failed;
        history-hint: root.traj-history-hint;
        close => { root.traj-open = false; }
        toggle-duration => { root.traj-toggle-duration(); }
        toggle-turns => { root.traj-toggle-turns(); }
         toggle-calls => { root.traj-toggle-calls(); }
         export => { root.traj-export(); }
        select-row(index) => { root.traj-select-row(index); }
        fold-row(index, action) => { root.traj-fold-row(index, action); }
        select-tab(tab) => { root.traj-select-tab(tab); }
        select-span(index) => { root.traj-select-span(index); }
        hover-span(index) => { root.traj-hover-span(index); }
        leave-span => { root.traj-leave(); }
        search-edited => { root.traj-search-changed(); }
        select-search-hit(index) => { root.traj-search-hit(index); }
        zoom(factor, anchor) => { root.traj-zoom(factor, anchor); }
        pan(start) => { root.traj-pan(start); }
        select-range(start, end) => { root.traj-select-range(start, end); }
        clear-range => { root.traj-clear-range(); }
        select-position(value) => { root.traj-select-position(value); }
        hover-position(value) => { root.traj-hover-position(value); }
        edge-reached(older) => { root.traj-edge(older); }
    }
    if root.subagent-open : SubagentDetailDialog {
        title: root.subagent-title;
        status-kind: root.subagent-status-kind;
        running: root.subagent-running;
        stoppable: root.subagent-stoppable;
        task: root.subagent-task;
        metrics: root.subagent-metrics;
        rows: root.subagent-rows;
        loading: root.subagent-loading;
        failed: root.subagent-failed;
        close => { root.subagent-close(); }
        interrupt => { root.subagent-interrupt(); }
        toggle(index) => { root.subagent-toggle(index); }
        process-page(index, direction) => { root.subagent-process-page(index, direction); }
        open-resource(id) => { root.subagent-open-resource(id); }
    }
    if root.ws-prompt-open : WorkspacePromptDialog {
        prompt-title: root.ws-prompt-title;
        prompt-body: root.ws-prompt-body;
        input-visible: root.ws-prompt-input;
        prompt-value <=> root.ws-prompt-value;
        confirm-label: root.ws-prompt-confirm;
        danger: root.ws-prompt-danger;
        busy: root.ws-prompt-busy;
        accepted(value) => { root.ws-prompt-accepted(value); }
        canceled => { root.ws-prompt-canceled(); }
    }
    if root.thread-rename-open : WorkspacePromptDialog {
        prompt-title: I18n.common_rename;
        prompt-body: I18n.sb_rename_body(root.thread-rename-title);
        input-visible: true;
        prompt-value <=> root.thread-rename-draft;
        confirm-label: I18n.common_confirm;
        accepted(value) => {
            let title = value;
            root.thread-rename-open = false;
            if title != root.thread-rename-title {
                if root.thread-rename-cloud-id != "" { root.cloud-rename-thread(root.thread-rename-cloud-id, title); }
                else { root.rename-thread(root.thread-rename-payload, title); }
            }
        }
        canceled => { root.thread-rename-open = false; }
    }
    if root.cron-delete-open : ConfirmDialog {
        title: I18n.cron_delete_title;
        message: I18n.cron_delete_message;
        confirm-label: I18n.common_confirm_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.cron-delete-open = false; root.delete-cron(root.cron-delete-pending); }
        canceled => { root.cron-delete-open = false; }
    }
    if root.agent-leave-confirm-open : ConfirmDialog {
        title: I18n.ag_unsaved_title;
        message: I18n.ag_unsaved_confirm;
        confirm-label: I18n.common_discard;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.agent-leave-confirm-open = false; root.agent-leave-confirmed(); }
        canceled => { root.agent-leave-confirm-open = false; root.agent-leave-canceled(); }
    }
    // Archiving a thread is a deliberate act: the hover band only opens this
    // confirmation, the actual archive happens after the user confirms.
    if root.thread-archive-open : ConfirmDialog {
        title: I18n.ap_archive_thread;
        message: I18n.ap_archive_confirm;
        confirm-label: I18n.ap_archive_thread;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => {
            root.thread-archive-open = false;
            if root.thread-archive-cloud-id != "" { root.cloud-archive-thread(root.thread-archive-cloud-id); }
            else { root.archive-thread(root.thread-archive-pending); }
        }
        canceled => { root.thread-archive-open = false; }
    }
    // ---- interlink approval (§I9): one remote command at a time ----
    // ConfirmDialog has no meta line, so this is a light self-drawn modal: the
    // command kind is the title, the prompt is the body and level / risk /
    // source ride on the subline. The poll only opens the card when it is
    // closed, so a visible card is never replaced mid-read.
    // A high-risk ask (L3 runs a command or an agent on this machine) wears the
    // danger treatment: red edge, a banner and an explicit note, so it can never
    // be read as an ordinary confirmation.
    if root.interlink-approval-open : Rectangle {
        z: 240;
        background: Theme.overlay;
        TouchArea { clicked => { /* remote asks must be answered, not dismissed */ } }
        Rectangle {
            width: min(460px, parent.width - 48px);
            height: root.interlink-approval.risk == "high" ? 296px : 240px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xl;
            background: Theme.surface;
            border-width: 1px;
            border-color: root.interlink-approval.risk == "high" ? Theme.danger : Theme.border;
            TouchArea { }
            VerticalLayout { padding: 20px; spacing: 10px;
                if root.interlink-approval.risk == "high" : Rectangle {
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: Theme.danger-bg;
                    HorizontalLayout { padding-left: 10px; padding-right: 10px;
                        Text { height: 26px; vertical-alignment: center; text: I18n.il_ap_high_badge; color: Theme.danger; font-size: Theme.font-xs; font-weight: 600; }
                    }
                }
                Text { height: 24px; text: root.interlink-approval.kind; color: root.interlink-approval.risk == "high" ? Theme.danger : Theme.text; font-size: 17px; font-weight: 600; overflow: elide; }
                Text { vertical-stretch: 1; text: root.interlink-approval.prompt; color: Theme.text-secondary; font-size: Theme.font-sm; wrap: word-wrap; }
                Text { height: 18px; text: I18n.il_ap_meta_level + root.interlink-approval.level + " · " + I18n.il_ap_meta_risk + root.interlink-approval.risk + " · " + I18n.il_ap_meta_from + root.interlink-approval.from-node; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                if root.interlink-approval.risk == "high" : Text {
                    text: I18n.il_ap_high_note;
                    color: Theme.muted;
                    font-size: Theme.font-xs;
                    wrap: word-wrap;
                }
                HorizontalLayout { height: 32px; spacing: 8px;
                    Action { width: 96px; label: I18n.il_ap_reject; show-label: true; danger: true; clicked => { root.interlink-approval-open = false; root.interlink-reject(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 96px; label: I18n.il_ap_approve; show-label: true; primary: true; clicked => { root.interlink-approval-open = false; root.interlink-approve(); } }
                }
            }
        }
    }
    if root.profile-edit-open : Rectangle {
        z: 100; background: Theme.overlay; TouchArea { clicked => { root.profile-edit-open = false; } }
        Rectangle { width: min(460px, parent.width - 48px); height: 300px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { }
            VerticalLayout { padding: 20px; spacing: 10px; Text { height: 24px; text: I18n.profile_edit_title; color: Theme.text; font-size: 17px; font-weight: 600; } FormField { label: I18n.profile_username; text <=> root.profile-username-draft; } FormField { label: I18n.profile_email; text <=> root.profile-email-draft; } FormField { label: I18n.profile_unit_optional; text <=> root.profile-unit-draft; } Rectangle { vertical-stretch: 1; } HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: I18n.common_cancel; show-label: true; clicked => { root.profile-edit-open = false; } } Action { label: I18n.common_save; show-label: true; primary: true; enabled: root.profile-username-draft != ""; clicked => { root.save-profile(root.profile-username-draft, root.profile-email-draft, root.profile-unit-draft); root.profile-edit-open = false; } } } }
        }
    }
    if root.prompt-preview-open : Rectangle {
        background: #0f172a80; z: 100;
        TouchArea { clicked => { root.prompt-preview-open = false; } }
        Rectangle {
            x: max(16px, (root.width - 560px) / 2); y: max(16px, (root.height - 420px) / 2);
            width: min(560px, root.width - 32px); height: min(420px, root.height - 32px);
            border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; z: 101;
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout { height: 28px;
                    Text { text: I18n.pm_preview_title; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 28px; height: 28px; icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_close; show-label: false; clicked => { root.prompt-preview-open = false; } }
                }
                Text { text: I18n.pm_preview_hint; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                if root.prompt-preview-loading : Text { height: 40px; text: I18n.common_loading; color: Theme.muted; font-size: Theme.font-sm; horizontal-alignment: center; vertical-alignment: center; }
                TextEditBase { vertical-stretch: 1; text: root.prompt-preview; read-only: true; wrap: word-wrap; foreground: Theme.text; font-size: Theme.font-xs; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm; scroll-view-padding: 8px; selection-background-color: Theme.accent; selection-foreground-color: white; }
            }
        }
    }

    // Agent avatar dialog: window-root overlay driven by the AvatarDialogState
    // global, so any page can open it without property plumbing.
    AvatarDialog { z: 260; }

    WorkspaceDialog { z: 270; }

    ToastHost { z: 300; width: root.width; height: 52px; x: 0px; }

    Timer { interval: 4200ms; running: ToastState.message != ""; triggered => { ToastState.message = ""; } }
}
