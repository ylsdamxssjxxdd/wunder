    in-out property <bool> thread-log-loading;
    in-out property <bool> thread-log-previous;
    in-out property <bool> thread-log-next;
    in-out property <bool> thread-log-more;
    callback filter-thread-log();
    callback select-log-round(int);
    callback log-page(int);
    callback more-log-items();
    callback export-thread-log();
    in-out property <bool> more-open: false;
    // Read-only mirror of the timeline viewport offset; the native smoke checks
    // use it to prove the view does not jump while the user reads back.
    out property <length> scroll-y: follow_view.scroll-y;
    // Threads of all workspaces, newest activity first; the sidebar tree and
    // the active-thread summary are projections of this bounded list.
    in-out property <[Conversation]> conversations: [];
    // Derived by the native projection from the same bounded conversation list
    // rendered in the sidebar tree.
    in-out property <int> active-thread-count: 0;
    in-out property <string> active-thread-status: "idle";
    // This preview timeline is replaced immediately by the native projection.
    // It intentionally exercises every entry type in slint-viewer: user bubble,
    // body block, folded turn divider, tool group bar and one unfolded diff.
    // `h` is the height the native layout measured for each row; the fixture
    // states it because the viewer has no projection to report one.
    in-out property <[TimelineRow]> timeline: [
        { kind: 0, visible: true, text: I18n.main_preview_step_title2, foldable: false, group-idx: -1, group-open: false, payload: 0 },
        { kind: 5, visible: true, open: false, foldable: false, group-idx: -1, group-open: false, payload: 1 },
        { kind: 1, visible: false, text: I18n.main_preview_answer, foldable: true, group-idx: -1, group-open: false, payload: 2 },
        { kind: 0, visible: true, text: I18n.main_preview_prompt, foldable: false, group-idx: -1, group-open: false, payload: 3 },
        { kind: 1, visible: true, text: I18n.main_preview_answer, foldable: true, group-idx: -1, group-open: false, payload: 4 },
        { kind: 4, visible: true, text: I18n.tl_tool_calls(2), open: true, foldable: false, group-idx: 0, group-open: true, payload: 5 },
        { kind: 2, visible: true, tool-name: I18n.msg_thought, summary: I18n.main_preview_reasoning, detail: I18n.main_preview_reasoning, status-kind: 0, open: false, foldable: true, group-idx: 0, group-open: true, payload: 6 },
        { kind: 3, visible: true, tool-name: I18n.main_preview_step_title1, tool-icon: "folder-open", target: I18n.ws_preview_root_a, detail: I18n.main_preview_detail1, status-kind: 0, open: false, foldable: true, group-idx: 0, group-open: true, payload: 7 },
        { kind: 3, visible: true, tool-name: I18n.main_preview_step_title2, tool-icon: "file-pen", target: I18n.pd_preview_path, status-kind: 0, open: true, foldable: true, group-idx: 0, group-open: true, payload: 8,
            patch: [{
                path: I18n.pd_preview_path, action: I18n.pd_action_update, added: "41", deleted: "41",
                lines: [
                    { number: "136", text: "fn run(...) {", kind: "context" },
                    { number: "137", text: "    let old = previous();", kind: "delete" },
                    { number: "137", text: "    let new = current();", kind: "add" },
                    { number: "138", text: "}", kind: "context" }
                ]
            }]
        }
    ];
