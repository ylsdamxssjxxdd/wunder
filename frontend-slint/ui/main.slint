    in-out property <int> lan-peer-count: 0;
    in-out property <[LanPeerCard]> lan-peers: [];
    // ---- cloud account state (§6.1) ----
    // Login state and the quota snapshot are projected natively; the drafts
    // and the error line live on the shell so the settings card stays plain
    // two-way data. The password draft never leaves the process.
    in-out property <bool> cloud-logged-in: false;
    in-out property <bool> cloud-expired: false;
    in-out property <string> cloud-username;
    in-out property <string> cloud-balance;
    in-out property <string> cloud-concurrency;
    in-out property <bool> cloud-quota-warn: false;
