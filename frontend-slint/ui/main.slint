    callback save-model(string, string, string, string, string, string);
    callback set-default-model(string);
    changed thread-log-query => { root.filter-thread-log(root.thread-log-query, root.thread-log-filter); }
    changed scroll-revision => { if root.follow-output { messages-view.content-y = min(0px, messages-view.visible-height - messages-view.content-height); } }

    function open-info(title: string, text: string) {
        root.dialog-title = title; root.dialog-text = text; root.dialog-open = true;
    }
    function open-agent-creator() {
        root.agent-name-draft = "";
        root.agent-creator-open = true;
    }
    function open-new-model() {
        root.editing-model = false;
        root.model-key-draft = ""; root.model-provider-draft = ""; root.model-name-draft = "";
        root.model-base-url-draft = ""; root.model-token-draft = ""; root.model-type-draft = "llm";
        root.model-editor-open = true;
    }
    function open-selected-model() {
        root.editing-model = true;
        root.model-key-draft = root.selected-model-key; root.model-provider-draft = root.selected-model-provider;
        root.model-name-draft = root.selected-model-name; root.model-base-url-draft = root.selected-model-base-url;
        root.model-token-draft = ""; root.model-type-draft = root.selected-model-type;
        root.model-editor-open = true;
    }

    Rectangle {
    width: parent.width; height: parent.height;
        Rectangle {
            x: 0px; y: 0px; width: Theme.rail-width; height: parent.height; background: Theme.rail;
            VerticalLayout {
                padding-top: 10px; padding-bottom: 10px; padding-left: 5px; padding-right: 5px; spacing: 8px;
                Rectangle {
                    height: 44px;
                    TouchArea { clicked => { root.page = DesktopPage.profile; root.refresh-profile(); } }
                    Avatar { width: 38px; height: 38px; mine: false; glyph: root.profile.avatar-glyph; tone: 1; source: @image-url("../assets/avatar.png"); }
                }
                Rectangle { height: 1px; background: #ffffff44; }
                RailButton { icon: @image-url("../assets/icons/comments.svg"); label: I18n.common_messages; active: root.page == DesktopPage.messages; clicked => { root.page = DesktopPage.messages; } }
                RailButton { icon: @image-url("../assets/icons/robot.svg"); label: I18n.ag_title; active: root.page == DesktopPage.agents; clicked => { root.page = DesktopPage.agents; root.refresh-agents(); } }
                RailButton { icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: I18n.tl_title; active: root.page == DesktopPage.tools; clicked => { root.page = DesktopPage.tools; root.refresh-tools(); } }
                RailButton { icon: @image-url("../assets/icons/folder-open.svg"); label: I18n.common_files; active: root.page == DesktopPage.files; clicked => { root.page = DesktopPage.files; root.refresh-files(); } }
                RailButton { icon: @image-url("../assets/icons/comments.svg"); label: I18n.common_users; active: root.page == DesktopPage.users; badge: root.world-unread; clicked => { root.page = DesktopPage.users; root.refresh-world(false); } }
                Rectangle { vertical-stretch: 1; }
                RailButton { horizontal-ellipsis: true; icon: @image-url("../assets/icons/ellipsis.svg"); label: I18n.common_more; active: root.more-open; clicked => { root.more-open = !root.more-open; } }
            }
        }

        if root.more-open : Rectangle {
            x: 62px; y: parent.height - 310px; width: 208px; height: 300px;
            border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; z: 20;
            VerticalLayout {
                padding: 8px; spacing: 4px;
                Text { height: 24px; text: I18n.common_more; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: I18n.menu_settings; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.settings; root.settings-active-panel = 4; root.refresh-settings(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: I18n.common_groups; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.groups; root.refresh-world(true); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_cron_tasks; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.cron; root.refresh-cron(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/paper-plane.svg"); label: I18n.menu_channels; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.channels; root.refresh-channels(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/layer-group.svg"); label: I18n.common_plaza; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.plaza; root.refresh-plaza(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/robot.svg"); label: I18n.menu_profile; show-label: true; clicked => { root.more-open = false; root.page = DesktopPage.profile; root.refresh-profile(); } }
                Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: I18n.menu_about; show-label: true; clicked => { root.more-open = false; root.open-info(I18n.about_title, I18n.about_text); } }
            }
        }

        if root.navigation-open && root.page == DesktopPage.messages : Rectangle {
            x: Theme.rail-width; y: 0px; width: Theme.middle-width; height: parent.height; background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                // The web conversation list begins directly with its compact search field.
                Rectangle { height: 12px; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: I18n.common_search; text <=> root.keyword; }
                }
                Rectangle { height: 6px; }
                ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start;
                    for conversation[index] in root.conversations : Rectangle {
                        height: root.keyword == "" || conversation.title.starts-with(root.keyword) ? 68px : 0px;
                        visible: self.height > 0px;
                        Rectangle {
                            x: 8px; y: 2px; width: parent.width - 16px; height: 64px; border-radius: Theme.radius-lg;
                            background: root.selected-conversation == index ? Theme.accent : (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") ? Theme.accent-soft : transparent;
                            Action { width: parent.width; height: parent.height; label: conversation.title; enabled: (!root.busy || root.observing-thread) && !root.creating-session && !root.session-loading && !root.chat-loading; clicked => { root.select-conversation(index); } }
                            Avatar { x: 10px; y: 13px; source: @image-url("../assets/avatar.png"); status: conversation.runtime-status; }
                            Text { x: 54px; y: 10px; width: parent.width - 60px; height: 19px; text: conversation.title; color: root.selected-conversation == index ? white : (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") ? Theme.accent-deep : Theme.text; font-size: Theme.font-md; font-weight: 600; overflow: elide; }
                            if (conversation.runtime-status.starts-with("正在") || conversation.runtime-status.starts-with("目标") || conversation.runtime-status == "running" || conversation.runtime-status == "pending") : Text { x: parent.width - 62px; y: 11px; width: 50px; height: 16px; text: "运行中"; color: root.selected-conversation == index ? white : Theme.accent-deep; font-size: Theme.font-2xs; horizontal-alignment: right; overflow: elide; }
                            Text { x: 54px; y: 35px; width: parent.width - 62px; height: 16px; text: conversation.runtime-status != "" ? conversation.runtime-status : conversation.preview; color: root.selected-conversation == index ? #ffffffe0 : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                        }
                    }
                    }
                }
                Text { height: 36px; text: root.connected ? I18n.common_local_runtime : I18n.chat_preview_source; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; }
            }
        }

        Rectangle {
            visible: root.page == DesktopPage.messages;
            x: root.navigation-open ? Theme.rail-width + Theme.middle-width : Theme.rail-width;
            y: 0px; width: root.width - self.x - (root.right-open && root.width >= Theme.dock-breakpoint ? Theme.dock-width : 0px);
            height: parent.height; background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    Text { text: root.heading; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 104px; icon: @image-url("../assets/icons/plus.svg"); label: I18n.chat_new_thread; show-label: true; enabled: (!root.busy || root.observing-thread) && !root.creating-session && !root.session-loading && !root.chat-loading && !root.agents-loading; clicked => { root.new-thread(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                messages-view := ListView {
