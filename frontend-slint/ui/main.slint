        leave-settings => { root.more-open = false; root.settings-open = false; }
        // §9.3 agent form. Every editable field is two-way bound so the settings
        // panel writes the drafts the native save handler reads back, and the
        // panel's own `changed` hooks keep the dirty flag honest.
        selected-agent-name <=> root.selected-agent-name;
        selected-agent-description <=> root.selected-agent-description;
