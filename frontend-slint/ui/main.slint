import { WindowChrome, WindowFrame } from "window_chrome.slint";
// `TimelineView` is deliberately absent: nothing in Rust names it, and an
// exported component that does not inherit Window only earns a build warning.
export { Theme, DesktopPage, Conversation, WorkspaceCard, SidebarRow, CloudThreadCard, TextBlock, WorkflowLine, WorkflowSection, ToolWorkflowEntry, ProcessEntry, TimelineRow, TimelineCounts, TurnStatMetric, PatchCard, PatchLine, ChatAttachment, FileCard, AgentCard, ToolCard, ModelCard, ProfileCard, TrajRow, TrajSpan, TrajTick, TrajBoundary, TrajTiming, TrajSection, TrajTab, CronCard, CronRunCard, PromptPackCard, ChannelCatalogCard, ChannelBindingCard, ChannelLogCard, AvatarOption, AvatarColorChip, CompanionCard, PlanStep, InterlinkApproval, WorkspaceFileRow }
export { AppTray } from "tray.slint";
export { TrayNotice } from "tray-notice.slint";
export { HelpWindow } from "help_window.slint";
export { TerminalWindow } from "terminal_window.slint";
export { ScreenshotOverlay } from "screenshot_overlay.slint";

export component MainWindow inherits Window {
    // Production starts from a real empty projection. Preview fixtures are
    // injected by demo::install() only for --demo and smoke-check runs, so the
    // first native frame can never present a fabricated running thread.
    in-out property <[SidebarRow]> sidebar-rows: [];
    in-out property <[WorkspaceCard]> workspaces: [];
    in-out property <int> selected-workspace: -1;
    callback select-row(int);
    callback select-device(int);
    callback workspace-menu(int, int);
    callback new-workspace();
    // Sidebar drag reorder: the row that was grabbed and how far the pointer
    // travelled from the press point, in pixels. The native side turns that
    // travel into the row the pointer really sits on, so one drag can move a
    // row several places.
    callback move-row(int, int);
    callback open-workspace-folder(string);
    callback rename-thread(int, string);
    callback archive-thread(string);
    callback cloud-rename-thread(string, string);
    callback cloud-archive-thread(string);
    callback cloud-open-trajectory(string);
    callback cloud-copy-original(string);
    // Sidebar multi-select (web alignment): the tree reports intent, Rust owns
    // the checked set, the mode flag and the counts.
    in-out property <bool> sidebar-selection-mode: false;
    in-out property <int> sidebar-selected-count: 0;
    in-out property <int> sidebar-archivable-count: 0;
    // Window-local composer popover geometry. Rust reads these only for a
    // pointer press while a popover is visible, then lets the actual Slint
    // click continue to its destination.
    out property <bool> composer-popover-open: composer.popover-open;
    out property <bool> composer-plus-open: composer.plus-open-state;
    out property <bool> composer-model-open: composer.model-open-state;
    out property <length> composer-plus-trigger-x: composer.plus-trigger-x;
    out property <length> composer-plus-trigger-y: composer.plus-trigger-y;
    out property <length> composer-plus-trigger-width: composer.plus-trigger-width;
    out property <length> composer-plus-trigger-height: composer.plus-trigger-height;
    out property <length> composer-plus-menu-x: composer.plus-menu-x;
    out property <length> composer-plus-menu-y: composer.plus-menu-y;
    out property <length> composer-plus-menu-width: composer.plus-menu-width;
    out property <length> composer-plus-menu-height: composer.plus-menu-height;
    out property <length> composer-model-trigger-x: composer.model-trigger-x;
    out property <length> composer-model-trigger-y: composer.model-trigger-y;
    out property <length> composer-model-trigger-width: composer.model-trigger-width;
    out property <length> composer-model-trigger-height: composer.model-trigger-height;
    out property <length> composer-model-menu-x: composer.model-menu-x;
    out property <length> composer-model-menu-y: composer.model-menu-y;
    out property <length> composer-model-menu-width: composer.model-menu-width;
    out property <length> composer-model-menu-height: composer.model-menu-height;
    out property <length> composer-command-menu-x: composer.command-menu-x;
    out property <length> composer-command-menu-y: composer.command-menu-y;
    out property <length> composer-command-menu-width: composer.command-menu-width;
    out property <length> composer-command-menu-height: composer.command-menu-height;
    out property <length> composer-preset-menu-x: composer.preset-menu-x;
    out property <length> composer-preset-menu-y: composer.preset-menu-y;
    out property <length> composer-preset-menu-width: composer.preset-menu-width;
    out property <length> composer-preset-menu-height: composer.preset-menu-height;
    out property <length> composer-permission-menu-x: composer.permission-menu-x;
    out property <length> composer-permission-menu-y: composer.permission-menu-y;
    out property <length> composer-permission-menu-width: composer.permission-menu-width;
    out property <length> composer-permission-menu-height: composer.permission-menu-height;
    out property <length> composer-screenshot-menu-x: composer.screenshot-menu-x;
    out property <length> composer-screenshot-menu-y: composer.screenshot-menu-y;
    out property <length> composer-screenshot-menu-width: composer.screenshot-menu-width;
    out property <length> composer-screenshot-menu-height: composer.screenshot-menu-height;
    public function dismiss-composer-popovers() { composer.dismiss-popovers(); }
    callback sidebar-begin-selection();
    callback sidebar-exit-selection();
    callback sidebar-toggle-selection(int);
    callback sidebar-select-all();
    callback sidebar-archive-selected();
    in-out property <DesktopPage> page: DesktopPage.messages;
    // Settings render in an internal overlay window instead of taking over
    // the chat area; the sidebar width is user-draggable.
    in-out property <bool> settings-open: false;
    in-out property <length> sidebar-width: Theme.sidebar-width;

    in-out property <bool> expert-loading;
    in-out property <bool> expert-saving;
    in-out property <string> expert-error;
    in-out property <[MemoryCard]> expert-memories;
    in-out property <[ArchiveCard]> expert-archives;
    in-out property <[RuntimePoint]> expert-points;
    in-out property <[HeatCard]> expert-heat;
    in-out property <string> expert-duration;
    in-out property <string> expert-tokens;
    in-out property <string> expert-calls;
    in-out property <string> expert-chart-path;
    in-out property <string> expert-chart-max;
    in-out property <string> expert-date;
    in-out property <int> expert-archive-page;
    in-out property <int> expert-archive-total;
    in-out property <string> expert-query;
    in-out property <string> expert-category: "全部标签";
    in-out property <[string]> expert-categories: ["全部标签"];
    in-out property <bool> memory-editor-open;
    in-out property <string> memory-edit-id;
    in-out property <string> memory-edit-title;
    in-out property <string> memory-edit-content;
    in-out property <string> memory-edit-category;
    in-out property <[string]> expert-agent-names;
    callback replicate-expert-memory(int);
    callback open-expert-memory(int);
    callback save-expert-memory();
    callback delete-expert-memory(string);
    callback open-expert-archive(string);
    in-out property <[ExpertToolGroup]> expert-tool-groups;
    in-out property <string> expert-tool-keyword;
    callback refresh-expert();
    callback search-expert-tools();
    callback toggle-expert-tool-group(string);
    callback edit-agent-question(int, string);
    // Aggregate thread status projected by native_chat: a pending inquiry
    // outranks running threads, which outrank the idle shell.
    in property <int> title-running-count: 0;
    in property <int> title-inquiry-count: 0;
    // Frameless custom chrome: the strip below replaces the system caption.
    callback window-drag-requested();
    callback window-minimize-requested();
    callback window-maximize-requested();
    callback window-close-requested();
    title: root.title-inquiry-count > 0
        ? I18n.app_window_title + " · " + I18n.wm_status_inquiry("" + root.title-inquiry-count)
        : root.title-running-count > 0
        ? I18n.app_window_title + " · " + I18n.wm_status_running("" + root.title-running-count)
        : I18n.app_window_title + " · " + I18n.wm_status_idle;
    // Open the desktop workbench maximized. The native bootstrap repeats this
    // after mapping on window managers that defer the initial request.
    maximized: true;
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1280px; preferred-height: 860px;
    min-width: Theme.min-window-width; min-height: Theme.min-window-height;
    default-font-family: "Microsoft YaHei"; default-font-size: Theme.font-md;
    icon: @image-url("../assets/app-icon.png");
    background: Theme.panel;
    in-out property <int> selected-agent: -1;
    in-out property <int> selected-model: -1;
    in-out property <string> active-session-id;
    in-out property <string> active-agent-id;
    in-out property <string> cloud-greeting;
    in-out property <bool> busy: false;
    in-out property <bool> command-pending: false;
    // The terminal button opens a separate terminal window; chat remains in
    // the main transcript and composer.
    in-out property <bool> terminal-mode: false;
    callback terminal-toggled(bool);
    callback terminal-interrupt();
    callback terminal-clear();
    callback terminal-scrolled(int);
    callback terminal-scroll-to(int);
    callback terminal-geometry-changed();
    in-out property <int> terminal-measured-cols: 0;
    in-out property <int> terminal-measured-rows: 0;
    changed terminal-measured-cols => { root.terminal-geometry-changed(); }
    changed terminal-measured-rows => { root.terminal-geometry-changed(); }
    in-out property <[TermSpan]> terminal-spans;
    in-out property <string> terminal-status;
    in-out property <bool> terminal-error: false;
    in-out property <int> terminal-rows: 24;
    in-out property <int> terminal-cols: 80;
    in-out property <int> terminal-view-offset: 0;
    in-out property <int> terminal-history-depth: 0;
    in-out property <bool> terminal-caret-visible: false;
    in-out property <int> terminal-caret-row: 0;
    in-out property <int> terminal-caret-col: 0;
    in-out property <string> command-feedback;
    changed command-feedback => {
        if root.command-feedback.starts-with("命令执行失败") {
            ToastState.message = root.command-feedback;
            ToastState.kind = 2;
            ToastState.revision += 1;
        }
    }
    // Backend errors only ever land on `status`, which no chat view renders;
    // surface error-shaped statuses as toasts so a failed runtime or storage
    // read can never look like a dead UI again.
    changed status => {
        if root.status.starts-with(I18n.cp_error_prefix)
            || root.status.starts-with(I18n.cp_fail_prefix)
            || root.status.starts-with("错误")
            || root.status.replace-all("失败", "") != root.status
            || root.status.replace-all("未保存", "") != root.status
            || root.status.starts-with("⚠") {
            ToastState.message = root.status;
            ToastState.kind = 2;
            ToastState.revision += 1;
        }
    }
    in-out property <bool> goal-active: false;
    // A goal remains visible while paused or blocked; this is separate from
    // `goal-active`, which controls the running composer state.
    in-out property <bool> goal-visible: false;
    in-out property <string> goal-phase;
    in-out property <string> goal-activation;
    in-out property <string> goal-rounds;
    // Goal banner state; the projection and the observer goal tick write the
    // objective, the accumulated seconds and the paused flag.
    in-out property <string> goal-objective;
    in-out property <int> goal-seconds: 0;
    in-out property <string> goal-elapsed;
    in-out property <bool> goal-paused: false;
    in-out property <bool> goal-editing: false;
    in-out property <string> goal-edit-draft;
    callback goal-save(string);
    callback goal-pause-toggle();
    callback goal-clear();
    // ---- status dock (plan capsule above the goal banner) ----
    // The dock only exists while the active thread has a published plan.
    in-out property <bool> activity-running: false;
    in-out property <int> activity-steps-done: 0;
    in-out property <int> activity-steps-total: 0;
    in-out property <string> activity-plan-explanation;
    in-out property <[PlanStep]> activity-plan-steps: [];
    // Which step the capsule names: the running one, else the first unfinished
    // one, with its 1-based position (0 once every step is done).
    in-out property <string> activity-plan-current;
    in-out property <int> activity-plan-position: 0;
    // The checklist card is a popover: expanded is view state only, so closing
    // it collapses the card and leaves the plan published.
    in-out property <bool> activity-plan-expanded: false;
    callback activity-plan-dismiss();
    // ---- inquiry panel (问询面板 card above the composer) ----
    // Rust owns the questions, the selection state and the page; the card is a
    // pure projection and every interaction is answered by a republish. No
    // preview defaults: an unpublished panel must never render.
    in-out property <bool> inquiry-visible: false;
    // Thread the projection belongs to: archiving or leaving the active thread
    // must drop the card even when nothing republishes it.
    in-out property <string> inquiry-session;
    // One row per visible question: the current page, or every question while
    // the panel is expanded.
    in-out property <[InquiryQuestion]> inquiry-questions: [];
    in-out property <int> inquiry-page: 0;
    in-out property <int> inquiry-total: 1;
    in-out property <bool> inquiry-expanded: false;
    // The composer's send button unlocks with an answer in hand, even with an
    // empty draft, because the choices themselves are the message.
    in-out property <bool> inquiry-ready: false;
    callback inquiry-option-clicked(int, int);
    callback inquiry-other-edited(int, string);
    callback inquiry-no-preference(int);
    callback inquiry-use-recommended(int);
    callback inquiry-page-move(int);
    callback inquiry-expanded-toggle();
    // Fractional offset of every user turn for the right-edge ruler.
    in-out property <[float]> turn-marks: [];
    in-out property <bool> connected: false;
    // The default is deliberately loading: MainWindow exists before the
    // asynchronous local runtime does, so a first frame must never resemble a
    // populated conversation. Demo and smoke modes explicitly clear it.
    in-out property <bool> chat-loading: true;
    in-out property <bool> session-loading: false;
    in-out property <bool> creating-session: false;
    // New-thread activity heatmap: sparse day buckets projected natively into
    // weekly columns, plus the month axis and the selected series tab.
    in-out property <[ActivityWeek]> activity-sessions: [];
    in-out property <[ActivityWeek]> activity-credits: [];
    in-out property <[ActivityMonth]> activity-months: [];
    in-out property <int> activity-tab: 0;
    in-out property <bool> agents-loading: false;
    in-out property <bool> tools-loading: false;
    in-out property <bool> tools-working: false;
    in-out property <int> tools-tab: 0;
    in-out property <int> tools-selected: -1;
    in-out property <[ToolCard]> tools-builtin;
    in-out property <[ToolCard]> tools-mcp;
    in-out property <[ToolCard]> tools-skills;
    in-out property <[ToolCard]> tools-knowledge;
    in-out property <[ToolResource]> tools-servers;
    in-out property <[ToolResource]> tools-skill-resources;
    in-out property <[ToolResource]> tools-bases;
    in-out property <[ToolCard]> tools-server-tools;
    in-out property <[FileCard]> tools-files;
    in-out property <[FileCard]> tools-all-files;
    in-out property <string> tools-search;
    in-out property <string> tools-file-path;
    in-out property <string> tools-content;
    in-out property <string> tools-directory;
    in-out property <bool> tools-has-more;
    callback select-tool-resource(int, int);
    callback open-tool-file(string, bool);
    callback more-tool-files();
    callback search-tool-files(string);
    callback tool-manager-action(string, string, string);
    in-out property <bool> settings-loading: false;
    in-out property <bool> saving: false;
    in-out property <string> draft;
    in-out property <[ChatAttachment]> pending-attachments: [];
    // Parked turns of the active thread, projected from the engine's queue in
    // dispatch order. `queue-overflow` counts the rows Rust left out, so the
    // strip's height stays bounded whatever the feeder parked.
    in-out property <[QueueTurn]> queue-turns: [];
    in-out property <int> queue-overflow: 0;
    in-out property <string> status: I18n.chat_demo_status;
    in-out property <string> dialog-title;
    in-out property <string> dialog-text;
    in-out property <bool> dialog-open: false;
    // Thread trajectory page. Rows, spans and detail text are pre-projected
    // in Rust (src/thread_trajectory.rs); Slint only lays them out.
    in-out property <bool> traj-open: false;
    in-out property <[TrajRow]> traj-rows;
    in-out property <[TrajSpan]> traj-spans;
    in-out property <[TrajTick]> traj-ticks;
    in-out property <[TrajBoundary]> traj-boundaries;
    in-out property <float> traj-view-start: 0.0;
    in-out property <float> traj-view-width: 1.0;
    in-out property <bool> traj-selection-active: false;
    in-out property <float> traj-selection-start: 0.0;
    in-out property <float> traj-selection-end: 0.0;
    in-out property <string> traj-detail-header;
    in-out property <string> traj-detail-badge;
    in-out property <int> traj-detail-kind: 1;
    in-out property <[TrajTab]> traj-detail-tabs;
    in-out property <int> traj-detail-tab: 0;
    in-out property <[TrajTiming]> traj-overview;
    in-out property <[TrajSection]> traj-sections;
    in-out property <[TrajTiming]> traj-timing;
    in-out property <string> traj-raw;
    in-out property <int> traj-selected: -1;
    in-out property <length> traj-ledger-scroll: -1px;
    in-out property <int> traj-ledger-scroll-seq: 0;
    in-out property <int> traj-hover: -1;
    in-out property <string> traj-tooltip;
    in-out property <bool> traj-show-duration: true;
    in-out property <bool> traj-show-turns: false;
    in-out property <bool> traj-show-calls: false;
    in-out property <string> traj-query;
    in-out property <string> traj-search-hint;
    in-out property <[TrajSearchHit]> traj-search-hits;
    in-out property <string> traj-search-body;
    in-out property <bool> traj-loading;
    in-out property <bool> traj-failed;
    in-out property <string> traj-history-hint;
    callback traj-select-row(int);
    callback traj-fold-row(int, int);
    callback traj-select-tab(int);
    callback traj-select-span(int);
    callback traj-hover-span(int);
    callback traj-leave();
    callback traj-toggle-duration();
    callback traj-toggle-turns();
    callback traj-toggle-calls();
    callback traj-export();
    callback traj-search-changed();
    callback traj-search-hit(int);
    callback traj-zoom(float, float);
    callback traj-pan(float);
    callback traj-select-range(float, float);
    callback traj-clear-range();
    callback traj-select-position(float);
    callback traj-hover-position(float);
    callback traj-edge(bool);
    // Subagent detail dialog: the child thread's rows come from the same
    // projection as the main timeline (src/subagent_detail.rs); Slint only
    // lays out the card and hands clicks back.
    in-out property <bool> subagent-open: false;
    in-out property <[TimelineRow]> subagent-rows;
    in-out property <string> subagent-title;
    in-out property <int> subagent-status-kind: 0;
    in-out property <bool> subagent-running: false;
    in-out property <bool> subagent-stoppable: false;
    in-out property <string> subagent-task;
    in-out property <string> subagent-metrics;
    in-out property <bool> subagent-loading: false;
    in-out property <bool> subagent-failed: false;
    callback subagent-close();
    callback subagent-interrupt();
    callback subagent-toggle(int);
    callback subagent-open-resource(string);
    // A timeline card click and its interrupt action; the controller resolves
    // the parent thread from the active session.
    callback timeline-open-subagent(string);
    callback timeline-stop-subagent(string);
    in-out property <bool> more-open: false;
    // Read-only mirror of the timeline viewport offset; the native smoke checks
    // use it to prove the view does not jump while the user reads back.
    out property <length> scroll-y: follow_view.scroll-y;
    // Threads of all workspaces, newest activity first; the sidebar tree and
    // the active-thread summary are projections of this bounded list.
    in-out property <[Conversation]> conversations: [];
    // Derived by the native projection from the same bounded conversation list
    // rendered in the sidebar tree.
    in-out property <int> active-thread-count: 0;
    in-out property <string> active-thread-status: "idle";
    in-out property <[TimelineRow]> timeline: [];
    in-out property <[AgentCard]> agents: [];
    in-out property <[ToolCard]> tools: [];
    in-out property <bool> cron-loading: false;
    in-out property <[CronCard]> cron-jobs: [];
    in-out property <[PromptPackCard]> prompt-packs: [];
    in-out property <[string]> prompt-pack-names: [];
    in-out property <string> prompt-active;
    in-out property <string> prompt-selected-pack;
    in-out property <int> prompt-selected-segment: 0;
    in-out property <string> prompt-draft;
    in-out property <bool> prompt-readonly: false;
    in-out property <bool> prompt-loading: false;
    in-out property <string> pack-name-draft;
    in-out property <string> prompt-preview;
    in-out property <bool> prompt-preview-loading: false;
    in-out property <bool> cron-delete-open: false;
    in-out property <string> cron-delete-pending;
    in-out property <[string]> cron-agent-names: [I18n.common_default_agent];
    in-out property <bool> cron-editor-open: false;
    in-out property <bool> cron-editor-saving: false;
    in-out property <string> cron-edit-id;
    in-out property <int> cron-editor-kind: 0;
    in-out property <string> cron-edit-name;
    in-out property <string> cron-edit-at;
    in-out property <string> cron-edit-every;
    in-out property <string> cron-edit-cron;
    in-out property <string> cron-edit-tz;
    in-out property <string> cron-edit-message;
    in-out property <int> cron-edit-agent: 0;
    in-out property <bool> cron-edit-delete-after: false;
    in-out property <bool> cron-edit-enabled: true;
    in-out property <bool> cron-runs-open: false;
    in-out property <bool> cron-runs-loading: false;
    in-out property <string> cron-runs-title;
    in-out property <[CronRunCard]> cron-runs: [];
    in-out property <bool> channel-loading: false;
    in-out property <[ChannelCatalogCard]> channel-catalog: [];
    in-out property <[ChannelAccountCard]> channel-accounts: [];
