    in-out property <string> selected-model-base-url;
    in-out property <string> selected-model-type;
    in-out property <bool> selected-model-is-default: false;
    in-out property <ModelCard> selected-model-card;
    // The models settings tab edits the selected model in place; `creating`
    // marks the unsaved new-model draft where the config key stays editable.
    in-out property <bool> model-creating: false;
    in-out property <string> model-key-draft;
    in-out property <string> model-provider-draft;
    in-out property <string> model-name-draft;
    in-out property <string> model-base-url-draft;
    in-out property <string> model-token-draft;
    in-out property <string> model-type-draft: "llm";
    in-out property <string> model-temperature-draft;
    in-out property <string> model-timeout-draft;
    in-out property <string> model-max-output-draft;
    in-out property <string> model-thinking-budget-draft;
    in-out property <string> model-max-rounds-draft;
    in-out property <string> model-max-context-draft;
    in-out property <string> model-tts-voice-draft;
    in-out property <string> model-tts-format-draft;
    in-out property <string> model-tts-speed-draft;
    in-out property <string> model-tts-instructions-draft;
    in-out property <string> model-asr-language-draft;
    in-out property <string> model-asr-format-draft;
    in-out property <string> model-asr-temperature-draft;
    in-out property <string> model-asr-prompt-draft;
    in-out property <string> model-image-size-draft;
    in-out property <string> model-image-format-draft;
    in-out property <string> model-image-steps-draft;
    in-out property <string> model-image-guidance-draft;
    in-out property <string> model-image-negative-draft;
    in-out property <string> model-video-size-draft;
    in-out property <string> model-video-seconds-draft;
    in-out property <string> model-video-fps-draft;
    in-out property <string> model-video-negative-draft;
    in property <[string]> model-provider-presets: ["自定义（手动填写服务地址）", "openai_compatible", "openai", "anthropic", "openrouter", "siliconflow", "deepseek", "moonshot", "qwen", "groq", "mistral", "together", "vllm_omni", "whisper_cpp", "ollama", "lmstudio"];
    in property <[string]> model-type-presets: ["llm", "embedding", "asr", "tts", "image", "video"];
    in-out property <bool> stopping: false;
    in-out property <bool> recording: false;
    in-out property <bool> transcribing: false;
    in-out property <string> recording-elapsed: "";
    in-out property <bool> recording-pulse: false;
    in-out property <bool> follow-output: true;
    in-out property <int> stream-updates;
    in-out property <int> stream-bytes;
    in-out property <float> stream-max-ui-ms;
    in-out property <int> stream-max-backlog;
    in-out property <float> context-usage: 0.0;
    in-out property <bool> context-known: false;
    in-out property <float> context-used: -1;
    in-out property <float> context-capacity: -1;
    in-out property <string> context-counts;
    in-out property <string> reasoning-effort: "default";
    callback stop-generation();
    callback save-session-reasoning-effort(string);
    callback copy-raw(string);
    copy-buffer := TextInput { width: 0px; height: 0px; }
    copy-raw(raw) => { copy-buffer.text = raw; copy-buffer.select-all(); copy-buffer.copy(); copy-buffer.text = ""; }
    callback send-message();
    callback capture-screenshot(bool, bool);
    callback record-voice();
    callback remove-attachment(int);
    callback select-conversation(int);
    callback new-thread();
    callback refresh-chat();
    callback refresh-agents();
    callback select-agent(int);
    callback refresh-agent-dirty();
    callback agent-return-chat();
    callback agent-leave-confirmed();
    callback agent-leave-canceled();
    callback save-agent(string, string, string, string, string, [string], [string], int, string, bool, bool, bool);
    callback toggle-agent-tool(string);
    callback add-agent-question();
    callback remove-agent-question(int);
    callback refresh-cron();
    callback toggle-cron(string, bool);
    callback delete-cron(string);
    callback probe-model-context();
    callback probe-model-voices();
    callback save-preferences();
    callback refresh-prompt-packs();
    callback select-prompt-pack(string);
    callback save-prompt-segment();
    callback create-prompt-pack();
    callback delete-prompt-pack();
    callback set-active-prompt-pack();
    callback refresh-prompt-preview();
    callback open-prompt-preview();
    in-out property <bool> prompt-preview-open: false;
    callback confirm-delete-prompt-pack();
    callback export-diagnostics();
    callback reset-work-state();
    callback run-cron-now(string);
    callback open-cron-runs(string);
    callback close-cron-runs();
    callback open-cron-creator();
    callback edit-cron-job(string);
    callback save-cron-editor();
    callback cancel-cron-editor();
    in-out property <string> selected-agent-icon-config;
    // The resolved avatar shown by the agent form's 形象 button; Rust owns it so
    // the thumbnail tracks the draft icon config, not the last saved record.
    in-out property <image> selected-agent-icon-image;
    // Slint has no string slicing, so the fallback letter ships as its own
    // projection for the 形象 button's avatar bubble.
    in-out property <string> selected-agent-initial;
    in-out property <[string]> selected-agent-tool-names: [];
    in-out property <[string]> selected-agent-preset-questions: [];
    in-out property <string> selected-agent-approval-mode: "suggest";
    in-out property <bool> selected-agent-preview-skill: false;
    in-out property <bool> selected-agent-silent: false;
    in-out property <bool> selected-agent-prefer-mother: false;
    in-out property <string> agent-question-draft;
    // §9.3 agent form projections. The model list is built natively: only
    // configured conversational models are selectable. The tool cards reuse the
    // grouped catalog (`expert-tool-groups`), the only place filtering happens.
    in-out property <[string]> agent-model-options: [];
    callback agent-model-picked(string);
    callback refresh-agent-model-options();
    callback toggle-agent-tool-option(string);
    callback save-agent-form();
    // Unsaved-change tracking for the agent editor: the clean baseline is
    // captured in Rust, every bound field change recomputes the dirty flag.
    in-out property <bool> agent-dirty: false;
    in-out property <string> agent-form-snapshot;
    in-out property <bool> agent-leave-confirm-open: false;
    // The avatar glyph stays empty until the profile loads: the shell fills it
    // with the signed-in name's first character, and an empty mark falls back to
    // the shared "me" label. The profile-colour default matches the backend.
    in-out property <ProfileCard> profile: { user-id: "", username: "", email: "", unit: "", unit-id: "", sessions: "0", sessions-last-7d: "0", tool-calls: "0", tokens: "0", agents: "0", last-active: "", avatar-icon: "initial", avatar-glyph: "", avatar-color: "#3b82f6", avatar-brush: #3b82f6 };
    in-out property <bool> profile-loading: false;
    callback refresh-profile();
    callback save-profile-avatar(string, string);
    callback save-profile(string, string, string);
    in-out property <bool> profile-edit-open: false;
    in-out property <string> profile-username-draft;
    in-out property <string> profile-email-draft;
    in-out property <string> profile-unit-draft;
    callback refresh-tools();
    callback open-file-native(string);
    callback save-runtime(string, string, string, string, string);
    callback save-lan(bool, string);
    callback refresh-settings();
    callback select-model(int);
    callback move-model(int, int);
    callback save-model();
    callback set-default-model(string);
    callback delete-model(string);
    // The native projection bumps scroll-revision; TimelineView owns the
    // follow-output scroll itself, so no handler is needed here.

    // The workspace the active thread belongs to; drives the top bar. The
    // native layer always seeds one workspace, so indexing stays in range.
    out property <bool> has-active-workspace: root.selected-workspace >= 0
        && root.selected-workspace < root.workspaces.length;
    out property <string> active-workspace-name: root.has-active-workspace ? root.workspaces[root.selected-workspace].name : "";
    out property <string> active-workspace-icon: root.has-active-workspace ? root.workspaces[root.selected-workspace].icon : "";
    out property <string> active-workspace-color: root.has-active-workspace ? root.workspaces[root.selected-workspace].color : "";
    // One timeline fold toggle: the Rust projection patches only the rows the
    // fold owns (itself, its tool batch, or its whole earlier turn).
    callback timeline-toggle(int);
    callback timeline-open(string);
    // Save one answer block as a text file through the native layer.
    callback timeline-download(string);
    // Bounded introspection for the native smoke checks and the companion
    // bubble: the row count and the answer text of the active thread.
    callback timeline-counts() -> TimelineCounts;
    callback timeline-last-answer() -> string;

    // §8.3 model switcher inside the composer. `models` is the *filtered* view
    // the popover renders; the unfiltered catalogue stays natively and its size
    // is mirrored here so the popover can tell "no match" from "none added".
    in-out property <int> model-catalogue-count: 0;
    // Search text of the model popover; the filter runs natively because Slint
    // 1.18 strings have no substring test.
    callback search-models(string);
    // §8.5 branch of the workspace folder, when the backend can detect one.
    in-out property <string> active-workspace-branch: "";
    // Root folder of the active workspace, used by the composer's "open
    // workspace folder" action.
    out property <string> active-workspace-root: root.has-active-workspace ? root.workspaces[root.selected-workspace].root-path : "";
    // Logical-pixel centre of the sidebar's settings button and of the settings
    // window's close button. The native smoke check drives real pointer events,
    // and a real click needs the layout's own numbers rather than a repeated
    // guess about where the overlay lands.
    out property <length> settings-button-x: root.sidebar-width / 2;
    out property <length> settings-button-y: sidebar_view.height - 20px;
    out property <length> settings-back-x: (root.width - min(1080px, root.width - 72px)) / 2
        + min(1080px, root.width - 72px) - 22px;
    out property <length> settings-back-y: 22px;
    // §8.4 permission mode preference; the backend remains the authority.
    in-out property <string> permission-mode: "full_auto";
    callback save-permission-mode(string);
    // §9.1 settings search. Slint 1.18 strings have no substring test, so the
    // query is filtered natively and the matching categories come back as one
    // flag per category, in §9.2 order.
    in-out property <string> settings-query: "";
    in-out property <[bool]> settings-category-flags: [true, true, true, true, true, true, true, true, true, true, true, true];
    callback filter-settings-categories(string);
    // Actions the embedded category pages raise that had no shell entry point
    // while those pages were unmounted.
    callback open-thread-log();
    callback request-channel-delete();
    callback confirm-channel-delete();
    callback cancel-channel-delete();
    callback probe-channel-logs();
    callback clear-channel-logs();
    // §8.2 more-menu and attachment actions. "Open workspace folder" reuses the
    // sidebar's handler; file attachment is picked on a worker thread because
    // the native dialog blocks.
    callback open-active-workspace();
    callback pick-attachments();

    function open-info(title: string, text: string) {
        root.dialog-title = title; root.dialog-text = text; root.dialog-open = true;
    }
    function clear-model-param-drafts() {
        root.model-temperature-draft = ""; root.model-timeout-draft = ""; root.model-max-output-draft = "";
        root.model-thinking-budget-draft = ""; root.model-max-rounds-draft = ""; root.model-max-context-draft = "";
        root.model-tts-voice-draft = ""; root.model-tts-format-draft = ""; root.model-tts-speed-draft = ""; root.model-tts-instructions-draft = "";
        root.model-asr-language-draft = ""; root.model-asr-format-draft = ""; root.model-asr-temperature-draft = ""; root.model-asr-prompt-draft = "";
        root.model-image-size-draft = ""; root.model-image-format-draft = ""; root.model-image-steps-draft = ""; root.model-image-guidance-draft = ""; root.model-image-negative-draft = "";
        root.model-video-size-draft = ""; root.model-video-seconds-draft = ""; root.model-video-fps-draft = ""; root.model-video-negative-draft = "";
    }
    function open-new-model() {
        root.model-creating = true;
        root.model-key-draft = ""; root.model-provider-draft = "openai_compatible"; root.model-name-draft = "";
        root.model-base-url-draft = ""; root.model-token-draft = ""; root.model-type-draft = "llm";
        root.clear-model-param-drafts();
    }

    Rectangle {
        width: parent.width; height: parent.height;
        HorizontalLayout {
            spacing: 0px;
            sidebar_view := Sidebar {
                width: root.sidebar-width;
                rows: root.sidebar-rows;
                active-thread-id: root.active-session-id;
                // Signed-in identity travels from the profile projection so the
                // sidebar never owns a second copy of the avatar state.
                user-initial: root.profile.avatar-glyph;
                user-color: root.profile.avatar-brush;
                // Cloud quota badge (§6.1): blank hides the pill, warn marks
                // a balance at or below 10% of the daily grant.
                cloud-quota-text: root.cloud-logged-in ? root.cloud-balance : "";
                cloud-quota-warn: root.cloud-quota-warn;
                cloud-quota-expired: root.cloud-connection == "expired";
                cloud-quota-reconnecting: root.cloud-connection == "reconnecting";
                busy: root.creating-session || root.session-loading || root.chat-loading;
                new-task => { root.new-thread(); }
                select-row(index) => { root.select-row(index); }
                workspace-menu(workspace, action) => { root.workspace-menu(workspace, action); }
                new-workspace => { root.new-workspace(); }
                move-row(index, delta) => { root.move-row(index, delta); }
                archive-thread(index) => { root.archive-thread(index); }
                rename-thread(index, title) => { root.rename-thread(index, title); }
                open-settings => { root.more-open = false; root.settings-open = true; root.settings-active-panel = 0; root.refresh-settings(); }
            }
            // Sidebar width drag handle: press and drag to resize, clamped so
            // the tree never collapses or eats the chat area.
            Rectangle {
                width: 6px;
                background: resize-touch.pressed ? Theme.accent
                    : resize-touch.has-hover ? Theme.border-strong : transparent;
                resize-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    property <length> start-x;
                    property <length> start-width;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.sidebar-width = clamp(root.sidebar-width, 170px, 420px);
                            start-width = root.sidebar-width;
                            start-x = self.mouse-x;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.sidebar-width = clamp(start-width + (self.mouse-x - start-x), 170px, 420px);
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.chat;
                VerticalLayout {
                    spacing: 0px;
                    // Chat top bar: workspace identity plus the thread title.
                    HorizontalLayout {
                        height: Theme.header-height; padding-left: 16px; padding-right: 16px; spacing: 8px;
                        Rectangle {
                            visible: root.has-active-workspace;
                            y: (parent.height - 22px) / 2;
                            width: 22px; height: 22px; border-radius: 6px;
                            background: WorkspaceVisual.color(root.active-workspace-color);
                            Image { x: 2px; y: 2px; width: 18px; height: 18px; source: WorkspaceVisual.icon(root.active-workspace-icon); colorize: white; }
                        }
                        Text {
                            visible: root.has-active-workspace;
                            text: root.active-workspace-name;
                            color: Theme.muted; font-size: Theme.font-lg;
                            vertical-alignment: center; overflow: elide;
                        }
                        Text {
                            visible: root.has-active-workspace && root.heading != "";
                            text: "·"; color: Theme.border-strong; font-size: Theme.font-lg; vertical-alignment: center;
                        }
                        Text {
                            height: parent.height; text: root.heading;
                            color: Theme.text; font-size: 15px; font-weight: 600;
                            overflow: elide; vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // The transcript holder is a small wrapper so the timeline
                    // stays reachable from outside: a `public function` cannot
                    // name an element that an `if` may remove, so the two views
                    // toggle on `visible` instead of being conditionally built.
                    follow_view := Rectangle {
                        vertical-stretch: 1;
                        out property <length> scroll-y: timeline_view.scroll-y;
                        public function scroll-to-end() { timeline_view.scroll-to-end(); }
                        timeline_view := TimelineView {
                            visible: !root.terminal-mode;
                            rows: root.timeline;
                            turn-marks: root.turn-marks;
                            follow-output <=> root.follow-output;
                            toggle(index) => { root.timeline-toggle(index); }
                            copy-text(text) => { root.copy-raw(text); }
                            download-text(text) => { root.timeline-download(text); }
                            open-resource(id) => { root.timeline-open(id); }
                        }
                        TerminalView {
                            visible: root.terminal-mode;
                            x: 0px; y: 0px; width: 100%; height: 100%;
                            spans: root.terminal-spans;
                            status: root.terminal-status;
                            error: root.terminal-error;
                            rows: root.terminal-rows;
                            cols: root.terminal-cols;
                            view-offset: root.terminal-view-offset;
                            history-depth: root.terminal-history-depth;
                            caret-visible: root.terminal-caret-visible;
                            caret-row: root.terminal-caret-row;
                            caret-col: root.terminal-caret-col;
                            clear => { root.terminal-clear(); }
                            interrupt => { root.terminal-interrupt(); }
                            scrolled(delta) => { root.terminal-scrolled(delta); }
                            scroll-to(row) => { root.terminal-scroll-to(row); }
                            measured-cols <=> root.terminal-measured-cols;
                            measured-rows <=> root.terminal-measured-rows;
                        }
                    }
                    // Status dock: the activity capsule sits between the
                    // timeline and the goal banner; its plan card overlaps the
                    // timeline via negative y. Queue position is folded into
                    // the activity text by the native projection, so the old
                    // cloud-queue banner is gone.
                    if root.activity-active : StatusDock {
                        active: root.activity-active;
                        status-text: root.activity-text;
                        steps-done: root.activity-steps-done;
                        steps-total: root.activity-steps-total;
                        files-changed: root.activity-files-changed;
                        added-lines: root.activity-added-lines;
                        deleted-lines: root.activity-deleted-lines;
                        plan-explanation: root.activity-plan-explanation;
                        plan-steps: root.activity-plan-steps;
                        plan-dismiss => { root.activity-plan-dismiss(); }
                    }
                    if root.goal-objective != "" : GoalBanner {
                        objective: root.goal-objective;
                        elapsed: root.goal-elapsed;
                        paused: root.goal-paused;
                        editing <=> root.goal-editing;
                        edit-draft <=> root.goal-edit-draft;
                        save(text) => { root.goal-save(text); }
                        pause-toggle => { root.goal-pause-toggle(); }
                        clear => { root.goal-clear(); }
                    }
                    Composer {
                        draft <=> root.draft; busy: root.command-pending || root.busy || root.session-loading || root.creating-session || root.chat-loading;
                        terminal-mode: root.terminal-mode;
                        command => { root.terminal-mode = !root.terminal-mode; root.terminal-toggled(root.terminal-mode); }
                        send-key: root.runtime-send-key;
                        interrupt => { root.terminal-interrupt(); }
                        context-usage: root.context-usage; context-known: root.context-known; context-counts: root.context-counts; reasoning-effort <=> root.reasoning-effort;
                        models: root.models;
                        model-catalogue-count: root.model-catalogue-count;
                        cloud-ready: root.cloud-logged-in && !root.cloud-expired;
                        model-name: root.selected-model-name != "" ? root.selected-model-name : root.selected-agent-model;
                        model-key: root.selected-model-key;
                        model-saving: root.saving;
                        select-model(index, key) => { root.set-default-model(key); }
                        set-default-model(key) => { root.set-default-model(key); }
                        open-model-settings => { root.settings-open = true; root.settings-active-panel = 1; root.refresh-settings(); }
                        search-models(query) => { root.search-models(query); }
                        workspace-name: root.active-workspace-name;
                        branch-name: root.active-workspace-branch;
                        permission-mode <=> root.permission-mode;
                        permission-changed(value) => { root.save-permission-mode(value); }
                        attachments: root.pending-attachments;
                        generating: root.busy || root.goal-active; stopping: root.stopping; stop => { root.stop-generation(); }
                        recording: root.recording; transcribing: root.transcribing; recording-elapsed: root.recording-elapsed; recording-pulse: root.recording-pulse;
                        send => { root.send-message(); }
                        screenshot(hide-window, region) => { root.capture-screenshot(hide-window, region); }
                        record-voice => { root.record-voice(); }
                        reasoning-effort-changed(value) => { root.save-session-reasoning-effort(value); }
                        remove-attachment(index) => { root.remove-attachment(index); }
                    }
                }
            }
        }
    }

    // Settings live in an internal overlay window instead of replacing the
    // chat area: the shield closes it on click-away, the card swallows stray
    // clicks and the header row carries the window title plus close action.
    if root.settings-open : Rectangle {
        z: 220;
        background: Theme.overlay;
        TouchArea { clicked => { root.settings-open = false; } }
        Rectangle {
            width: min(1080px, root.width - 72px);
            height: min(720px, root.height - 56px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xl;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000033;
            TouchArea { }
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 44px;
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Image { y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/icons/gear.svg"); colorize: Theme.muted; }
                    Text {
                        height: parent.height;
                        text: I18n.sidebar_settings;
                        color: Theme.text; font-size: Theme.font-lg; font-weight: 600;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                    Action {
                        width: 28px; height: 28px;
                        icon: @image-url("../assets/icons/xmark.svg");
                        clicked => { root.settings-open = false; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                SettingsPage {
        loading: root.settings-loading; saving: root.saving;
        status: root.status;
        models: root.models; selected-model: root.selected-model;
        workspace-root <=> root.workspace-root; language <=> root.runtime-language;
        // The profile card and its edit dialog stay on the shell (the rail's
        // profile route owns them); the settings page no longer shows a
        // separate identity panel, so nothing is bound through it.
        python-path <=> root.runtime-python; git-path <=> root.runtime-git; rg-path <=> root.runtime-rg;
        python-status: root.runtime-python-status; git-status: root.runtime-git-status; rg-status: root.runtime-rg-status;
        importing-supplement <=> root.importing-supplement; supplement-status <=> root.supplement-status;
        import-supplement => { root.import-supplement(); }
        pick-python-path => { root.pick-python-path(); }
        pick-git-path => { root.pick-git-path(); }
        pick-rg-path => { root.pick-rg-path(); }
        lan-enabled <=> root.lan-enabled; lan-name <=> root.lan-name; lan-peer-id: root.lan-peer-id; lan-endpoint: root.lan-endpoint; lan-peer-count: root.lan-peer-count; lan-peers: root.lan-peers;
        save-runtime(workspace, language, python, git, rg) => { root.save-runtime(workspace, language, python, git, rg); }
        save-lan(enabled, name) => { root.save-lan(enabled, name); }
        selected-key: root.selected-model-key; selected-provider: root.selected-model-provider;
        selected-model-name: root.selected-model-name; selected-base-url: root.selected-model-base-url;
        selected-type: root.selected-model-type; selected-is-default: root.selected-model-is-default;
        selected-card: root.selected-model-card;
        delete-model(key) => { root.delete-model(key); }
        select-model(index) => { root.select-model(index); }
        create-model => { root.open-new-model(); }
        move-model(from, delta) => { root.move-model(from, delta); }
        save-model => { root.save-model(); }
        set-default-model(key) => { root.set-default-model(key); }
        refresh => { root.refresh-settings(); }
        // ---- cloud account (§6.1) ----
