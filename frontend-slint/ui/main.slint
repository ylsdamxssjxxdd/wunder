    // The settings page's active category, shared with the smoke harness.
    in-out property <int> settings-active-panel: 0;
    // Memory, usage and archive data are pulled on demand: the old expert page's
    // own tab strip is gone, so the active category is what selects the view.
    changed settings-active-panel => {
        if root.settings-active-panel == 6 || root.settings-active-panel == 8
            || root.settings-active-panel == 10 {
            root.refresh-expert();
        }
    }
    in-out property <bool> lan-enabled: false;
    in-out property <string> lan-name;
    in-out property <string> lan-peer-id;
