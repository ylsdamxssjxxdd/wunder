                        ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                            VerticalLayout { spacing: 6px;
                                for event in root.thread-log-events : Rectangle {
                                    height: 82px; border-radius: 8px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                    VerticalLayout { padding: 9px; spacing: 3px;
                                        HorizontalLayout { height: 18px; Text { text: event.event-type; color: Theme.accent-deep; font-size: 11px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: event.time; color: Theme.muted; font-size: 10px; overflow: elide; } }
                                        Text { height: 17px; text: event.summary; color: Theme.text; font-size: 11px; overflow: elide; }
                                        Text { height: 25px; text: event.raw; color: Theme.muted; font-size: 10px; wrap: word-wrap; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.dialog-open : Rectangle {
        background: #00000040;
        TouchArea { clicked => { root.dialog-open = false; } }
        Rectangle {
            width: min(720px, parent.width - 48px); height: min(620px, parent.height - 48px);
            border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 14px;
                HorizontalLayout {
                    height: 30px;
                    Text { text: root.dialog-title; color: Theme.text; font-size: 17px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/xmark.svg"); label: "关闭"; clicked => { root.dialog-open = false; } }
                }
                Text { text: root.dialog-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Action { label: "知道了"; icon: @image-url("../assets/icons/check.svg"); show-label: true; primary: true; clicked => { root.dialog-open = false; } }
                }
            }
        }
    }

}
