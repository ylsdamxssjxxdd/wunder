                    HorizontalLayout {
                        height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                        VerticalLayout { spacing: 1px; Text { height: 25px; text: I18n.profile_stats_title; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; } Text { height: 17px; text: I18n.profile_stats_subtitle; color: Theme.muted; font-size: Theme.font-xs; } }
                        Rectangle { horizontal-stretch: 1; }
                        Action { width: 112px; label: I18n.profile_edit_button; show-label: true; enabled: !root.profile-loading; clicked => { root.profile-username-draft = root.profile.username; root.profile-email-draft = root.profile.email; root.profile-unit-draft = root.profile.unit-id; root.profile-edit-open = true; } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout { padding: 20px; spacing: 12px;
                        for item in [{label: I18n.profile_sessions_total, value: root.profile.sessions}, {label: I18n.profile_sessions_7d, value: root.profile.sessions-last-7d}, {label: I18n.thread_log_tool_calls, value: root.profile.tool-calls}, {label: I18n.common_ai, value: root.profile.agents}, {label: I18n.profile_token_usage, value: root.profile.tokens}] : Rectangle { width: 150px; height: 92px; border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 12px; Text { height: 18px; text: item.label; color: Theme.muted; font-size: Theme.font-xs; } Text { height: 34px; text: item.value; color: Theme.text; font-size: Theme.font-display; font-weight: 700; } } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
    if root.page == DesktopPage.files : FilesPage {
        x: Theme.rail-width; y: 0px; width: parent.width - Theme.rail-width; height: parent.height;
        loading: root.files-loading; error: root.files-error; directory-path: root.directory-path; directory-parent: root.directory-parent;
        directory-root: root.directory-root; directory-container-id: root.directory-container-id; offset: root.files-offset; total: root.files-total; files: root.files;
        status: root.status;
        refresh => { root.refresh-files(); }
        navigate(path) => { root.navigate-directory(path); }
        open-file(path) => { root.open-file(path); }
        open-native(path) => { root.open-file-native(path); }
        create-file(kind, path) => { root.create-workspace-file(kind, path); }
        workspace-action(kind, path, value) => { root.workspace-action(kind, path, value); }
        upload-file => { root.upload-workspace-file(); }
        download-file(path, name) => { root.download-workspace-file(path, name); }
        open-workspace-binding => { root.workspace-binding-container = root.directory-container-id; root.workspace-binding-path = root.directory-root; root.workspace-binding-open = true; }
        previous-page => { root.files-offset = max(0, root.files-offset - 100); root.refresh-files(); }
        next-page => { root.files-offset += 100; root.refresh-files(); }
    }
    if root.page == DesktopPage.users || root.page == DesktopPage.groups : WorldPage {
        x: Theme.rail-width; y: 0px; width: parent.width - Theme.rail-width; height: parent.height;
        groups: root.page == DesktopPage.groups; loading: root.world-loading; total: root.world-total; offset: root.world-offset; contacts: root.world-contacts; group-items: root.world-groups;
        status: root.status;
        messages: root.world-messages; active-title: root.world-active-title; conversation-open: root.world-active-conversation != "";
        announcement: root.world-announcement; announcement-editing: root.world-announcement-editing; has-earlier: root.world-has-earlier;
        group-creator-open: root.world-group-creator-open; picks: root.world-group-picks;
        group-members: root.world-group-members; members-open: root.world-members-open;
        refresh => { root.refresh-world(root.page == DesktopPage.groups); }
        previous-page => { root.world-offset = max(0, root.world-offset - 100); root.refresh-world(root.page == DesktopPage.groups); }
        next-page => { root.world-offset += 100; root.refresh-world(root.page == DesktopPage.groups); }
        create-group(name) => { root.create-world-group(name); }
        open-contact(index) => { root.open-world-contact(index); }
        send-message(content) => { root.send-world-message(content); }
        edit-announcement => { root.edit-world-announcement(); }
        open-group-creator => { root.open-world-group-creator(); }
        close-group-creator => { root.close-world-group-creator(); }
        toggle-group-member(id) => { root.toggle-world-group-member(id); }
        cancel-announcement => { root.cancel-world-announcement(); }
        save-announcement(text) => { root.save-world-announcement(text); }
        load-earlier => { root.load-earlier-world-messages(); }
        toggle-members => { root.world-members-open = !root.world-members-open; }
    }
    if root.page == DesktopPage.cron : CronPage {
        x: Theme.rail-width; y: 0px; width: parent.width - Theme.rail-width; height: parent.height; loading: root.cron-loading; jobs: root.cron-jobs;
        status: root.status;
        agent-names <=> root.cron-agent-names;
        editor-open <=> root.cron-editor-open;
        editor-saving <=> root.cron-editor-saving;
        editor-kind <=> root.cron-editor-kind;
        editor-name <=> root.cron-edit-name;
        editor-at <=> root.cron-edit-at;
        editor-every <=> root.cron-edit-every;
        editor-cron <=> root.cron-edit-cron;
        editor-tz <=> root.cron-edit-tz;
        editor-message <=> root.cron-edit-message;
        editor-agent <=> root.cron-edit-agent;
        editor-delete-after <=> root.cron-edit-delete-after;
        editor-enabled <=> root.cron-edit-enabled;
        runs-open <=> root.cron-runs-open;
        runs-loading: root.cron-runs-loading; runs-title: root.cron-runs-title; runs: root.cron-runs;
        refresh => { root.refresh-cron(); }
        toggle(id, enabled) => { root.toggle-cron(id, enabled); }
        delete(id) => { root.cron-delete-pending = id; root.cron-delete-open = true; }
        run-now(id) => { root.run-cron-now(id); }
        open-runs(id) => { root.open-cron-runs(id); }
        close-runs => { root.close-cron-runs(); }
        open-creator => { root.open-cron-creator(); }
        save-editor => { root.save-cron-editor(); }
        cancel-editor => { root.cancel-cron-editor(); }
    }
    if root.page == DesktopPage.channels : ChannelsPage {
        x: Theme.rail-width; y: 0px; width: parent.width - Theme.rail-width; height: parent.height;
        loading: root.channel-loading; status: root.status;
        catalog: root.channel-catalog; catalog-names: root.channel-catalog-names;
        accounts: root.channel-accounts; selected: root.selected-channel-account;
        bindings: root.channel-bindings; bindings-loading: root.channel-bindings-loading;
        logs-open: root.channel-logs-open; logs-loading: root.channel-logs-loading; logs: root.channel-logs;
        editor-open: root.channel-editor-open; editor-saving: root.channel-editor-saving; editor-id: root.channel-edit-id;
        editor-kind <=> root.channel-edit-kind; editor-agent <=> root.channel-edit-agent;
        agent-names: root.channel-agent-names;
        edit-name <=> root.channel-edit-name; edit-enabled <=> root.channel-edit-enabled; edit-group-chat <=> root.channel-edit-group-chat;
        edit-app-id <=> root.channel-edit-app-id; edit-app-secret <=> root.channel-edit-app-secret;
        edit-corp-id <=> root.channel-edit-corp-id; edit-wechat-agent <=> root.channel-edit-wechat-agent;
        edit-secret <=> root.channel-edit-secret; edit-token <=> root.channel-edit-token; edit-aes-key <=> root.channel-edit-aes-key;
        edit-original-id <=> root.channel-edit-original-id; edit-api-base <=> root.channel-edit-api-base;
        edit-bot-token <=> root.channel-edit-bot-token; edit-bot-id <=> root.channel-edit-bot-id;
        edit-user-id <=> root.channel-edit-user-id; edit-domain <=> root.channel-edit-domain;
        edit-config-json <=> root.channel-edit-config-json;
        delete-open <=> root.channel-delete-open;
        qr-open <=> root.channel-qr-open; qr-state <=> root.channel-qr-state;
        qr-image <=> root.channel-qr-image; qr-message <=> root.channel-qr-message;
        start-qr => { root.start-channel-qr(); }
        cancel-qr => { root.cancel-channel-qr(); }
        reconnect => { root.reconnect-channel(); }
        refresh => { root.refresh-channels(); }
        select-account(index) => { root.select-channel-account(index); }
        open-creator => { root.open-channel-creator(); }
        edit-account => { root.edit-channel-account(); }
        save-editor => { root.save-channel-editor(); }
        cancel-editor => { root.cancel-channel-editor(); }
        request-delete => { root.request-delete-channel(); }
        confirm-delete => { root.confirm-delete-channel(); }
        cancel-delete => { root.cancel-delete-channel(); }
        toggle(enabled) => { root.toggle-channel-account(enabled); }
        open-logs => { root.open-channel-logs(); }
        close-logs => { root.close-channel-logs(); }
        delete-binding(peer-kind, peer-id) => { root.delete-channel-binding(peer-kind, peer-id); }
    }
    if root.page == DesktopPage.plaza : PlazaPage {
        x: Theme.rail-width; y: 0px; width: parent.width - Theme.rail-width; height: parent.height;
        loading: root.plaza-loading; status: root.status;
        items: root.plaza-items; selected: root.selected-plaza-item;
        import-open <=> root.plaza-import-open;
        refresh => { root.refresh-plaza(); }
        select-item(index) => { root.select-plaza-item(index); }
        request-import => { root.request-plaza-import(); }
        confirm-import => { root.confirm-plaza-import(); }
        cancel-import => { root.cancel-plaza-import(); }
    }

    if root.agent-creator-open : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { if !root.saving { root.agent-creator-open = false; } } }
        Rectangle {
            width: min(420px, parent.width - 48px); height: 190px; border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { height: 24px; text: I18n.agent_creator_title; color: Theme.text; font-size: 17px; font-weight: 600; }
                FormField { label: I18n.common_name; placeholder: I18n.agent_creator_name_placeholder; text <=> root.agent-name-draft; }
                HorizontalLayout { height: 30px; Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_cancel; show-label: true; clicked => { if !root.saving { root.agent-creator-open = false; } } } Action { width: 66px; icon: @image-url("../assets/icons/check.svg"); label: root.saving ? I18n.common_creating : I18n.common_create; show-label: true; primary: true; enabled: !root.saving && !root.agents-loading && root.agent-name-draft != ""; clicked => { root.create-agent(root.agent-name-draft); } } }
            }
        }
    }
    if root.profile-edit-open : Rectangle {
        z: 100; background: Theme.overlay; TouchArea { clicked => { root.profile-edit-open = false; } }
        Rectangle { width: min(460px, parent.width - 48px); height: 300px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { }
            VerticalLayout { padding: 20px; spacing: 10px; Text { height: 24px; text: I18n.profile_edit_title; color: Theme.text; font-size: 17px; font-weight: 600; } FormField { label: I18n.profile_username; text <=> root.profile-username-draft; } FormField { label: I18n.profile_email; text <=> root.profile-email-draft; } FormField { label: I18n.profile_unit_optional; text <=> root.profile-unit-draft; } Rectangle { vertical-stretch: 1; } HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: I18n.common_cancel; show-label: true; clicked => { root.profile-edit-open = false; } } Action { label: I18n.common_save; show-label: true; primary: true; enabled: root.profile-username-draft != ""; clicked => { root.save-profile(root.profile-username-draft, root.profile-email-draft, root.profile-unit-draft); root.profile-edit-open = false; } } } }
        }
    }
    if root.model-editor-open : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { if !root.saving { root.model-editor-open = false; root.model-token-draft = ""; } } }
        Rectangle {
            width: min(510px, parent.width - 48px); height: min(560px, parent.height - 44px); border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 8px;
                Text { height: 24px; text: root.selected-model-key == root.model-key-draft && root.model-key-draft != "" ? I18n.model_editor_edit : I18n.model_editor_add; color: Theme.text; font-size: 17px; font-weight: 600; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { spacing: 7px;
                        FormField { horizontal-stretch: 1; label: I18n.model_key_label; read-only: root.editing-model; placeholder: I18n.model_key_placeholder; text <=> root.model-key-draft; }
                        FormField { horizontal-stretch: 1; label: I18n.model_provider_label; placeholder: I18n.model_provider_placeholder; text <=> root.model-provider-draft; }
                    FormField { horizontal-stretch: 1; label: I18n.model_name_label; placeholder: I18n.model_name_placeholder; text <=> root.model-name-draft; }
                        FormField { horizontal-stretch: 1; label: I18n.model_base_url_label; placeholder: I18n.model_base_url_placeholder; text <=> root.model-base-url-draft; }
                    FormField { horizontal-stretch: 1; label: I18n.model_token_label; placeholder: I18n.model_token_placeholder; secret: true; text <=> root.model-token-draft; }
                    FormField { horizontal-stretch: 1; label: I18n.common_type; placeholder: I18n.model_type_placeholder; text <=> root.model-type-draft; }
                    HorizontalLayout { height: 30px; spacing: 8px;
                        Action { width: 96px; label: I18n.model_probe_context; show-label: true; enabled: !root.saving && root.model-name-draft != "" && root.model-base-url-draft != ""; clicked => { root.probe-model-context(); } }
                        if root.model-type-draft == "tts" : Action { width: 96px; label: I18n.model_probe_voices; show-label: true; enabled: !root.saving && root.model-name-draft != "" && root.model-base-url-draft != ""; clicked => { root.probe-model-voices(); } }
                    }
                    }
                }
                HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_cancel; show-label: true; clicked => { if !root.saving { root.model-editor-open = false; root.model-token-draft = ""; } } } Action { width: 66px; icon: @image-url("../assets/icons/check.svg"); label: root.saving ? I18n.common_saving : I18n.common_save; show-label: true; primary: true; enabled: !root.saving && !root.settings-loading && root.model-provider-draft != "" && root.model-key-draft != "" && root.model-name-draft != ""; clicked => { root.save-model(root.model-key-draft, root.model-provider-draft, root.model-name-draft, root.model-base-url-draft, root.model-token-draft, root.model-type-draft); } } }
            }
        }
    }
    if root.preview-open : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { root.preview-open = false; } }
        Rectangle {
            width: min(780px, parent.width - 64px); height: parent.height - 100px;
            border-radius: Theme.radius-lg; background: Theme.surface;
            TouchArea { }
            VerticalLayout { padding: 20px; spacing: 12px;
                HorizontalLayout { height: 30px;
                    Text { text: root.preview-path; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                    Action { label: root.preview-editing ? I18n.preview_edit_toggle : I18n.common_edit; show-label: true; enabled: !root.preview-loading && root.preview-editable; clicked => { root.preview-editing = !root.preview-editing; } }
                    Action { label: I18n.common_copy; show-label: true; enabled: !root.preview-loading; clicked => { root.copy-raw(root.preview-text); } }
                    if root.preview-editing : Action { label: I18n.common_save; show-label: true; primary: true; enabled: !root.preview-loading; clicked => { root.save-workspace-text(root.preview-path, root.preview-text); root.preview-editing = false; } }
                    Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.preview_close; clicked => { root.preview-open = false; } }
                }
                TextEditBase { text <=> root.preview-text; read-only: !root.preview-editing; wrap: word-wrap;
                    foreground: Theme.text; font-size: Theme.font-md; scroll-view-padding: 10px;
                    selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.text;
                    vertical-stretch: 1;
                }
            }
        }
    }
    if root.thread-log-open : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { root.thread-log-open = false; } }
        Rectangle {
            width: min(1080px, parent.width - 56px); height: min(700px, parent.height - 56px);
            border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 20px; spacing: 12px;
                HorizontalLayout { height: 32px;
                    Text { text: root.thread-log-title; color: Theme.text; font-size: Theme.font-headline; font-weight: 600; horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_close; clicked => { root.thread-log-open = false; } }
                }
                HorizontalLayout { vertical-stretch: 1; spacing: 14px;
                    Rectangle { width: 270px; background: Theme.panel; border-radius: Theme.radius-md; border-width: 1px; border-color: Theme.border;
                        VerticalLayout { padding: 14px; spacing: 8px;
                            Text { text: I18n.thread_log_overview; height: 24px; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; }
                            for metric in [{label: I18n.common_status, value: root.thread-log-status}, {label: I18n.thread_log_elapsed, value: root.thread-log-elapsed}, {label: I18n.thread_log_user_rounds, value: root.thread-log-rounds}, {label: I18n.thread_log_tool_calls, value: root.thread-log-tools}, {label: I18n.thread_log_tokens, value: root.thread-log-tokens}, {label: I18n.thread_log_speed, value: root.thread-log-speed}] : HorizontalLayout { height: 28px; Text { text: metric.label; color: Theme.muted; font-size: Theme.font-xs; horizontal-stretch: 1; vertical-alignment: center; } Text { text: metric.value; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    VerticalLayout { horizontal-stretch: 1; spacing: 10px;
                        HorizontalLayout { height: 32px; spacing: 8px;
                            Text { text: I18n.thread_log_entries; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle { width: 190px; height: 30px; border-radius: Theme.radius-sm; background: Theme.panel; border-width: 1px; border-color: Theme.border; TextInput { x: 8px; width: parent.width - 16px; height: parent.height; text <=> root.thread-log-query; color: Theme.text; font-size: Theme.font-xs; } if root.thread-log-query == "" : Text { x: 8px; width: parent.width - 16px; height: parent.height; text: I18n.thread_log_search; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } }
                            Action { width: 88px; label: root.thread-log-filter == "all" ? I18n.thread_log_filter_all : root.thread-log-filter == "tools" ? I18n.thread_log_filter_tools : I18n.thread_log_filter_models; show-label: true; clicked => { root.thread-log-filter-open = !root.thread-log-filter-open; } }
                        }
                        if root.thread-log-filter-open : Rectangle { z: 5; x: parent.width - 96px; width: 90px; height: 82px; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 4px; Action { height: 22px; label: I18n.thread_log_filter_all; show-label: true; clicked => { root.thread-log-filter = "all"; root.thread-log-filter-open = false; root.filter-thread-log(root.thread-log-query, root.thread-log-filter); } } Action { height: 22px; label: I18n.thread_log_filter_tools; show-label: true; clicked => { root.thread-log-filter = "tools"; root.thread-log-filter-open = false; root.filter-thread-log(root.thread-log-query, root.thread-log-filter); } } Action { height: 22px; label: I18n.thread_log_filter_models; show-label: true; clicked => { root.thread-log-filter = "models"; root.thread-log-filter-open = false; root.filter-thread-log(root.thread-log-query, root.thread-log-filter); } } } }
                        ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                            VerticalLayout { spacing: 6px;
                                for event in root.thread-log-events : Rectangle {
                                    height: 82px; border-radius: Theme.radius-sm; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                    VerticalLayout { padding: 9px; spacing: 3px;
                                        HorizontalLayout { height: 18px; Text { text: event.event-type; color: Theme.accent-deep; font-size: Theme.font-xs; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: event.time; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; } }
                                        Text { height: 17px; text: event.summary; color: Theme.text; font-size: Theme.font-xs; overflow: elide; }
                                        Text { height: 25px; text: event.raw; color: Theme.muted; font-size: Theme.font-2xs; wrap: word-wrap; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.cron-delete-open : ConfirmDialog {
        title: I18n.cron_delete_title;
        message: I18n.cron_delete_message;
        confirm-label: I18n.common_confirm_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.cron-delete-open = false; root.delete-cron(root.cron-delete-pending); }
        canceled => { root.cron-delete-open = false; }
    }
    if root.dialog-open : InfoDialog {
        title: root.dialog-title;
        message: root.dialog-text;
        close-label: I18n.info_ack;
        closed => { root.dialog-open = false; }
    }

    ToastHost { z: 300; }

}
