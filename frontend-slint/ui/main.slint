                    draft <=> root.draft; status: root.status; busy: root.busy || root.session-loading || root.creating-session || root.chat-loading;
                    send-key: root.runtime-send-key;
                    context-usage: root.context-usage;
                    model-name: root.selected-model-name != "" ? root.selected-model-name : root.selected-agent-model;
                    attachments: root.pending-attachments;
                    generating: root.busy; stopping: root.stopping; stop => { root.stop-generation(); }
                    recording: root.recording; transcribing: root.transcribing; recording-elapsed: root.recording-elapsed;
                    send => { root.send-message(); }
                    attach => { root.capture-screenshot(false, false); }
                    screenshot(hide-window, region) => { root.capture-screenshot(hide-window, region); }
                    record-voice => { root.record-voice(); }
                    remove-attachment(index) => { root.remove-attachment(index); }
                }
            }
        }
