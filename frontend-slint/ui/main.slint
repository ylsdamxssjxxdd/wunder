    if root.dialog-open : InfoDialog {
        title: root.dialog-title;
        message: root.dialog-text;
        close-label: I18n.info_ack;
        closed => { root.dialog-open = false; }
    }
    if root.thread-log-open : ThreadLogDialog {
        title: root.thread-log-title; metrics: root.thread-log-metrics; events: root.thread-log-events;
        rounds: root.thread-log-round-options; types: root.thread-log-types;
        selected-round <=> root.thread-log-round; selected-type <=> root.thread-log-type;
        query <=> root.thread-log-query; question: root.thread-log-question;
        page-info: root.thread-log-page-info; loading: root.thread-log-loading; error: root.thread-log-error;
        previous: root.thread-log-previous; next: root.thread-log-next; more: root.thread-log-more;
        close => { root.thread-log-open = false; }
        filter => { root.filter-thread-log(); }
        select-round(index) => { root.select-log-round(index); }
        page(delta) => { root.log-page(delta); }
        load-more => { root.more-log-items(); }
        export-log => { root.export-thread-log(); }
    }
    if root.cron-delete-open : ConfirmDialog {
        title: I18n.cron_delete_title;
        message: I18n.cron_delete_message;
        confirm-label: I18n.common_confirm_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.cron-delete-open = false; root.delete-cron(root.cron-delete-pending); }
        canceled => { root.cron-delete-open = false; }
    }
    if root.reset-confirm-open : ConfirmDialog {
        title: I18n.reset_title;
        message: I18n.reset_message;
        confirm-label: I18n.reset_confirm;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.reset-confirm-open = false; root.reset-work-state(); }
        canceled => { root.reset-confirm-open = false; }
    }
    if root.agent-leave-confirm-open : ConfirmDialog {
        title: I18n.ag_unsaved_title;
        message: I18n.ag_unsaved_confirm;
        confirm-label: I18n.common_discard;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.agent-leave-confirm-open = false; root.agent-leave-confirmed(); }
        canceled => { root.agent-leave-confirm-open = false; root.agent-leave-canceled(); }
    }
    if root.profile-edit-open : Rectangle {
        z: 100; background: Theme.overlay; TouchArea { clicked => { root.profile-edit-open = false; } }
        Rectangle { width: min(460px, parent.width - 48px); height: 300px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: Theme.radius-xl; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { }
            VerticalLayout { padding: 20px; spacing: 10px; Text { height: 24px; text: I18n.profile_edit_title; color: Theme.text; font-size: 17px; font-weight: 600; } FormField { label: I18n.profile_username; text <=> root.profile-username-draft; } FormField { label: I18n.profile_email; text <=> root.profile-email-draft; } FormField { label: I18n.profile_unit_optional; text <=> root.profile-unit-draft; } Rectangle { vertical-stretch: 1; } HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: I18n.common_cancel; show-label: true; clicked => { root.profile-edit-open = false; } } Action { label: I18n.common_save; show-label: true; primary: true; enabled: root.profile-username-draft != ""; clicked => { root.save-profile(root.profile-username-draft, root.profile-email-draft, root.profile-unit-draft); root.profile-edit-open = false; } } } }
        }
    }
    if root.prompt-preview-open : Rectangle {
        background: #0f172a80; z: 100;
        TouchArea { clicked => { root.prompt-preview-open = false; } }
        Rectangle {
            x: max(16px, (root.width - 560px) / 2); y: max(16px, (root.height - 420px) / 2);
            width: min(560px, root.width - 32px); height: min(420px, root.height - 32px);
            border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; z: 101;
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout { height: 28px;
                    Text { text: I18n.pm_preview_title; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { width: 28px; height: 28px; icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_close; show-label: false; clicked => { root.prompt-preview-open = false; } }
                }
                Text { text: I18n.pm_preview_hint; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                if root.prompt-preview-loading : Text { height: 40px; text: I18n.common_loading; color: Theme.muted; font-size: Theme.font-sm; horizontal-alignment: center; vertical-alignment: center; }
                TextEditBase { vertical-stretch: 1; text: root.prompt-preview; read-only: true; wrap: word-wrap; foreground: Theme.text; font-size: Theme.font-xs; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm; scroll-view-padding: 8px; selection-background-color: Theme.accent; selection-foreground-color: white; }
            }
        }
    }

    // Agent avatar dialog: window-root overlay driven by the AvatarDialogState
    // global, so any page can open it without property plumbing.
    AvatarDialog { z: 260; }

    WorkspaceDialog { z: 270; }

    ToastHost { z: 300; }

    Timer { interval: 6000ms; running: root.command-feedback != ""; triggered => { root.command-feedback = ""; } }
}


