                    Rectangle { height: 4px; }
                    for row in [{label: I18n.profile_email, value: root.profile.email}, {label: I18n.profile_unit, value: root.profile.unit}, {label: I18n.profile_last_active, value: root.profile.last-active}] : HorizontalLayout { height: 28px; padding-left: 16px; padding-right: 16px; Text { width: 64px; height: parent.height; text: row.label; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: row.value == "" ? I18n.profile_unset : row.value; color: Theme.text; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; } }
                    Rectangle { height: 10px; }
                    HorizontalLayout { padding-left: 16px; Text { height: 20px; text: I18n.profile_avatar_color; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } }
