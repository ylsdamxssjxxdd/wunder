                        height: index == 0 ? greeting-row.height + 14px : user-row.height + assistant-row.height + 28px;
                        greeting-row := MessageRow {
                            visible: index == 0;
                            x: 22px; y: 14px; width: parent.width - 44px;
                            message: root.greeting; author: root.selected-agent-name;
                            avatar: @image-url("../assets/avatar.png");
                            copy => { root.copy-raw(root.greeting.text); }
                        }
                        user-row := MessageRow {
                            visible: index > 0;
                            x: 22px; y: 14px; width: parent.width - 44px;
                            message: turn.user; author: I18n.common_you;
                            copy => { root.copy-raw(turn.user.text); }
                        }
                        assistant-row := MessageRow {
                            visible: index > 0;
                            x: 22px; y: user-row.y + user-row.height + 14px; width: parent.width - 44px;
                            message: turn.assistant; author: root.selected-agent-name == "" ? root.heading : root.selected-agent-name;
                            avatar: @image-url("../assets/avatar.png");
                            copy => { root.copy-message(index - 1); }
                        }
                    }
                }
                if !root.follow-output : Action { height: 26px; label: I18n.chat_back_to_latest; show-label: true; clicked => { root.follow-output = true; root.scroll-revision += 1; } }
