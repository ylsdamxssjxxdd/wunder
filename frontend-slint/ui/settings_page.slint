import { ModelPresets } from "model_presets.slint";
import { ExpertToolGroup, ExpertToolPicker } from "expert_widgets.slint";
import { Button, ComboBox, ScrollView, Slider, Switch } from "std-widgets.slint";
import { CronPage } from "cron_page.slint";
import { ChannelsPage } from "channels_page.slint";
