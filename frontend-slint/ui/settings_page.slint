    in-out property <bool> expert-loading: false;
    in-out property <bool> expert-saving: false;
    in-out property <string> expert-error;
    in-out property <[MemoryCard]> expert-memories;
    in-out property <[ArchiveCard]> expert-archives;
    in-out property <[RuntimePoint]> expert-points;
    in-out property <string> expert-duration;
    in-out property <string> expert-tokens;
    in-out property <string> expert-calls;
    in-out property <string> expert-chart-path;
    in-out property <string> expert-chart-max;
    in-out property <string> expert-date;
    in-out property <int> expert-archive-page: 0;
    in-out property <int> expert-archive-total: 0;
    in-out property <string> expert-query;
    in-out property <string> expert-category: "全部标签";
    in-out property <[string]> expert-categories: ["全部标签"];
    in-out property <bool> memory-editor-open: false;
    in-out property <string> memory-edit-id;
    in-out property <string> memory-edit-title;
    in-out property <string> memory-edit-content;
    in-out property <string> memory-edit-category;
    in-out property <[string]> expert-agent-names: [I18n.common_default_agent];
    callback refresh-expert();
    callback replicate-expert-memory(int);
    callback open-expert-memory(int);
    callback save-expert-memory();
    callback delete-expert-memory(string);
    callback open-expert-archive(string);
    callback restore-expert-archive(string);
    callback delete-expert-archive(string);

    // ---- built-in agent editor (§9.3 分类 4) ----
    // The personal build owns exactly one agent, so this category is a single
    // form. Its field set matches 蜂巢's agent panel: name, greeting, extra
    // prompt, tool selection and preset questions. Model, permission mode and
    // the three behaviour switches have no web counterpart, so the record's
    // values round-trip untouched through the shell projection instead.
    in-out property <string> selected-agent-name;
    in-out property <string> selected-agent-description;
    in-out property <string> selected-agent-system-prompt;
    // Preset questions live on the agent record and stay two-way bound: the
    // Rust projection owns the list, the rows only add and remove entries.
    in-out property <[string]> selected-agent-preset-questions;
    // Tool catalog as the card picker's type groups. The projection is the only
    // place filtering happens, because Slint strings have no substring test.
    in property <[ExpertToolGroup]> expert-tool-groups;
    in-out property <string> expert-tool-keyword;
    in property <bool> agents-loading: false;
    in-out property <string> agent-question-draft;
    callback toggle-agent-tool-option(string);
    callback toggle-expert-tool-group(string);
    callback search-expert-tools();
    callback refresh-agents();
    callback add-agent-question();
    callback remove-agent-question(int);
    callback save-agent-form();
    callback refresh-agent-dirty();
    // Desktop agent settings follow the cloud panel's live-save behavior.
    // The native side only queues this callback when the projected form is
    // actually dirty, so loading an agent never writes it back accidentally.
    callback queue-agent-save();
    in-out property <bool> agent-save-pending: false;
    live-save-timer := Timer {
        interval: 500ms;
        running: root.agent-save-pending;
        triggered => {
            root.agent-save-pending = false;
            if !root.saving && !root.loading && !root.selected-agent-name.is-empty {
                root.save-agent-form();
            }
        }
    }
    // Editing the prompt, description and questions all discard pending work, so
    // every field reports changes back to the shared dirty tracker.
    changed selected-agent-name => { root.refresh-agent-dirty(); root.queue-agent-save(); }
    changed selected-agent-description => { root.refresh-agent-dirty(); root.queue-agent-save(); }
    changed selected-agent-system-prompt => { root.refresh-agent-dirty(); root.queue-agent-save(); }
    changed expert-tool-keyword => { root.search-expert-tools(); }
    callback open-info(string, string);


    private property <bool> model-delete-open: false;
    background: Theme.chat;

    // Per-type list icons, mirroring the web messenger model list.
    public pure function model-icon(kind: string) -> image {
        kind == "embedding" ? @image-url("../assets/icons/log-fingerprint.svg") :
        kind == "asr" ? @image-url("../assets/icons/fa-microphone-lines.svg") :
        kind == "tts" ? @image-url("../assets/icons/fa-wave-square.svg") :
        kind == "image" ? @image-url("../assets/icons/fa-image.svg") :
        kind == "video" ? @image-url("../assets/icons/fa-film.svg") :
        @image-url("../assets/icons/brain.svg");
    }
    function apply-font-size() {
        Theme.font-scale = clamp(root.font-size, 12.0, 20.0) / 14.0;
    }
    // Slider drag applies the scale live; persistence happens once on release.
    function set-font-from-x(x: length, persist: bool) {
        root.font-size = clamp(round(12.0 + x / 1px / 132.0 * 8.0), 12, 20);
        root.apply-font-size();
        if persist { root.save-preferences(); }
    }

    HorizontalLayout {
        spacing: 0px;
        vertical-stretch: 1;
        // §9.1 navigation column.
        SettingsNav := Rectangle {
            width: 260px;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 46px; background: transparent;
                    Rectangle {
                        x: 12px; y: 8px; width: parent.width - 24px; height: 30px;
                        border-radius: Theme.radius-sm; background: Theme.input-bg;
                        border-width: 1px; border-color: query.has-focus ? Theme.accent-ink : Theme.input-border;
                        Image { x: 8px; y: 8px; width: 13px; height: 13px; source: @image-url("../assets/icons/magnifying-glass.svg"); colorize: Theme.muted; image-fit: contain; }
                        query := TextInput {
                            x: 28px; y: 0px; width: parent.width - 36px; height: parent.height;
                            text <=> root.settings-query;
                            single-line: true;
                            font-size: Theme.font-sm; color: Theme.text;
                            vertical-alignment: center;
                        }
                        if root.settings-query == "" : Text {
                            x: 28px; y: 0px; width: parent.width - 36px; height: parent.height;
                            text: I18n.stc_search; color: Theme.muted; font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; padding-left: 10px; padding-right: 10px; padding-bottom: 10px; spacing: 4px;
                        SettingsNavItem {
                            visible: root.settings-category-flags[0];
                            icon: @image-url("../assets/icons/fa-sliders.svg");
                            title: I18n.stc_general;
                            selected: root.settings-tab == 0;
                            clicked => { root.settings-tab = 0;  }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[1];
                            icon: @image-url("../assets/icons/log-user.svg");
                            title: I18n.stc_account;
                            selected: root.settings-tab == 13;
                            clicked => { root.settings-tab = 13;  }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[2];
                            icon: @image-url("../assets/icons/brain.svg");
                            title: I18n.stc_models;
                            selected: root.settings-tab == 1;
                            clicked => { root.settings-tab = 1; root.refresh(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[3];
                            icon: @image-url("../assets/icons/fa-toolbox.svg");
                            title: I18n.stc_tools;
                            selected: root.settings-tab == 2;
                            clicked => { root.settings-tab = 2; root.refresh(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[4];
                            icon: @image-url("../assets/icons/robot.svg");
                            title: I18n.stc_agent;
                            selected: root.settings-tab == 3;
                            clicked => { root.settings-tab = 3;  }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[5];
                            icon: @image-url("../assets/icons/paw.svg");
                            title: I18n.stc_pet;
                            selected: root.settings-tab == 4;
                            clicked => { root.settings-tab = 4;  }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[6];
                            icon: @image-url("../assets/icons/fa-clock.svg");
                            title: I18n.stc_cron;
                            selected: root.settings-tab == 5;
                            clicked => { root.settings-tab = 5; root.refresh(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[7];
                            icon: @image-url("../assets/icons/fa-memory.svg");
                            title: I18n.stc_memory;
                            selected: root.settings-tab == 6;
                            clicked => { root.settings-tab = 6; root.refresh(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[8];
                            icon: @image-url("../assets/icons/plug.svg");
                            title: I18n.stc_channels;
                            selected: root.settings-tab == 7;
                            clicked => { root.settings-tab = 7; root.refresh(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[9];
                            icon: @image-url("../assets/icons/file-lines.svg");
                            title: I18n.stc_prompts;
                            selected: root.settings-tab == 9;
                            clicked => { root.settings-tab = 9; root.refresh-prompt-packs(); }
                        }
                        SettingsNavItem {
                            visible: root.settings-category-flags[10];
                            icon: @image-url("../assets/icons/box-archive.svg");
                            title: I18n.stc_archives;
                            selected: root.settings-tab == 10;
                            clicked => { root.settings-tab = 10;  }
                        }
                        // A live query that matches nothing says so instead of
                        // leaving an empty column with no explanation.
                        if !root.settings-has-matches : Rectangle {
                            height: 96px;
                            Text {
                                x: 10px; y: 12px; width: parent.width - 20px; height: 40px;
                                text: I18n.stc_none_title; color: Theme.text; font-size: Theme.font-md; font-weight: 600;
                                wrap: word-wrap; vertical-alignment: top;
                            }
                            Text {
                                x: 10px; y: 48px; width: parent.width - 20px; height: 40px;
                                text: I18n.stc_none_note; color: Theme.muted; font-size: Theme.font-xs;
                                wrap: word-wrap; vertical-alignment: top;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            width: root.width - SettingsNav.width;
            // The model tab is a direct canvas child rather than a ScrollView.
            // Keep this column stretched so the canvas receives the full
            // overlay height instead of a zero preferred height.
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                vertical-stretch: 1;
                spacing: 0px;
                    if root.settings-tab == 0 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 24px; spacing: 14px; alignment: start; vertical-stretch: 1;
                            SettingsCard {
                                SettingsCardHeader { title: I18n.st_tab_general; subtitle: I18n.st_nav_subtitle; }
                                SettingRow { label: I18n.st_send_key; note: root.send-key == "ctrl_enter" ? I18n.st_send_enter_newline : root.send-key == "none" ? I18n.st_send_button_note : I18n.st_send_enter_direct;
                                    ComboBox { width: 160px; height: 38px; model: [I18n.st_send_enter, I18n.st_send_ctrl_enter, I18n.st_send_button]; current-index: root.send-key == "ctrl_enter" ? 1 : root.send-key == "none" ? 2 : 0;
                                        selected(value) => { root.send-key = self.current-index == 1 ? "ctrl_enter" : self.current-index == 2 ? "none" : "enter"; root.save-preferences(); } }
                                }
                                SettingRow { label: I18n.st_ui_language; note: I18n.st_language_hint;
                                    ComboBox { width: 132px; height: 38px; model: ["zh-CN", "en-US"]; current-index: root.language == "en-US" ? 1 : 0; enabled: !root.saving && !root.loading;
                                        selected(value) => { root.language = value; root.save-runtime(); } }
                                }
                                ThemeModeRow { label: I18n.st_palette; note: I18n.st_palette_note; theme: root.theme;
                                    picked(name) => { root.theme = name; Theme.palette = name; root.save-preferences(); } }
                                SettingRow { label: I18n.st_font_size; note: I18n.st_font_size_note; last: true;
                                    HorizontalLayout { spacing: 10px;
                                        Rectangle { width: 106px; height: 34px; border-radius: 17px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                            Text { x: 0px; width: 32px; height: parent.height; text: "-"; color: root.font-size > 12 ? Theme.text : Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                            Text { x: 32px; width: 42px; height: parent.height; text: round(root.font-size); color: Theme.text; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            Text { x: parent.width - 32px; width: 32px; height: parent.height; text: "+"; color: root.font-size < 20 ? Theme.text : Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea { x: 0px; width: 32px; height: parent.height; mouse-cursor: pointer; enabled: root.font-size > 12; clicked => { root.font-size = round(root.font-size) - 1; root.apply-font-size(); root.save-preferences(); } }
                                            TouchArea { x: parent.width - 32px; width: 32px; height: parent.height; mouse-cursor: pointer; enabled: root.font-size < 20; clicked => { root.font-size = round(root.font-size) + 1; root.apply-font-size(); root.save-preferences(); } }
                                        }
                                        // Accent-colored slider (std Slider ignores the Theme palette).
                                        Rectangle { width: 132px; height: 34px;
                                            Rectangle { x: 0px; y: (parent.height - 4px) / 2; width: parent.width; height: 4px; border-radius: 2px; background: Theme.border;
                                                Rectangle { x: 0px; y: 0px; width: parent.width * (root.font-size - 12) / 8; height: 4px; border-radius: 2px; background: Theme.accent; }
                                            }
                                            Rectangle { x: parent.width * (root.font-size - 12) / 8 - 8px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; border-radius: 8px; background: white; border-width: 2px; border-color: Theme.accent-ink; }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(event) => {
                                                    if event.kind == PointerEventKind.down { root.set-font-from-x(self.mouse-x, false); }
                                                    if event.kind == PointerEventKind.up { root.set-font-from-x(self.mouse-x, true); }
                                                }
                                                moved => { if self.pressed { root.set-font-from-x(self.mouse-x, false); } }
                                            }
                                        }
                                    }
                                }
                            }
                            // 执行路径就地保存：选完或改完立即落盘，不再设「保存设置」按钮。
                            SettingsCard {
                                SettingsCardHeader { title: I18n.st_tab_runtime; subtitle: I18n.st_exec_paths_note; }
                                Rectangle { height: 10px; }
                                HorizontalLayout { height: 62px; spacing: 10px;
                                    FormField { horizontal-stretch: 1; label: I18n.st_python_path; placeholder: I18n.st_python_hint; text <=> root.python-path; read-only: root.saving || root.loading; edited => { root.save-runtime(); } }
                                    Action { width: 96px; height: 34px; label: I18n.st_browse; show-label: true; enabled: !root.saving && !root.loading; clicked => { root.pick-python-path(); } }
                                }
                                Text { height: 18px; text: root.python-status; color: root.python-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                HorizontalLayout { height: 62px; spacing: 10px;
                                    FormField { horizontal-stretch: 1; label: I18n.st_git_path; placeholder: I18n.st_git_hint; text <=> root.git-path; read-only: root.saving || root.loading; edited => { root.save-runtime(); } }
                                    Action { width: 96px; height: 34px; label: I18n.st_browse; show-label: true; enabled: !root.saving && !root.loading; clicked => { root.pick-git-path(); } }
                                }
                                Text { height: 18px; text: root.git-status; color: root.git-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                HorizontalLayout { height: 62px; spacing: 10px;
                                    FormField { horizontal-stretch: 1; label: I18n.st_rg_path; placeholder: I18n.st_rg_hint; text <=> root.rg-path; read-only: root.saving || root.loading; edited => { root.save-runtime(); } }
                                    Action { width: 96px; height: 34px; label: I18n.st_browse; show-label: true; enabled: !root.saving && !root.loading; clicked => { root.pick-rg-path(); } }
                                }
                                Text { height: 18px; text: root.rg-status; color: root.rg-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                Rectangle { height: 8px; }
                                HorizontalLayout { height: 34px;
                                    Action { width: 128px; label: root.importing-supplement ? I18n.st_supplement_importing : I18n.st_supplement_import; show-label: true; primary: true; enabled: !root.importing-supplement && !root.saving && !root.loading; clicked => { root.import-supplement(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { height: 18px; text: root.supplement-status; color: root.supplement-status.starts-with("导入失败") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; visible: root.supplement-status != ""; }
                            }
                            // ---- 线程渲染压测（用户手动触发） ----
                            SettingsCard {
                                SettingsCardHeader { title: I18n.st_stress_title; subtitle: I18n.st_stress_note; }
                                HorizontalLayout { spacing: 10px;
                                    FormField { horizontal-stretch: 1; label: I18n.st_stress_user_rounds; placeholder: "1000"; text <=> root.stress-user-rounds; read-only: root.stress-running || root.saving || root.loading; }
                                    FormField { horizontal-stretch: 1; label: I18n.st_stress_model_rounds; placeholder: "1000"; text <=> root.stress-model-rounds; read-only: root.stress-running || root.saving || root.loading; }
                                    FormField { width: 100px; label: I18n.st_stress_count; placeholder: "1"; text <=> root.stress-count; read-only: root.stress-running || root.saving || root.loading; }
                                }
                                Text { height: 18px; text: I18n.st_stress_hint; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                Rectangle { height: 8px; }
                                HorizontalLayout { height: 34px;
                                    Action { width: 150px; label: root.stress-running ? I18n.st_stress_running : I18n.st_stress_generate; show-label: true; primary: true; enabled: !root.stress-running && !root.saving && !root.loading; clicked => { root.generate-stress-thread(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Text { height: 18px; visible: root.stress-status != ""; text: root.stress-status; color: root.stress-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            }
                            // 帮助：手册在独立窗口打开（节省设置弹窗空间）。
                            SettingsCard {
                                SettingsCardHeader { title: I18n.stc_help; }
                                Rectangle { height: 10px; }
                                HorizontalLayout { height: 34px; spacing: 10px;
                                    Action { width: 140px; label: I18n.st_help_open; show-label: true; primary: true; enabled: !root.loading; clicked => { root.open-help(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    // ---- account: cloud account + activity (runs) ----
                    if root.settings-tab == 13 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 24px; spacing: 16px; alignment: start; vertical-stretch: 1;
                            // ---- cloud account (§6.1) ----
                            // Server address + account + secret login. The
                            // native side validates and calls the engine
                            // CloudService; the session file and the token
                            // never surface here.
                            SettingsCard {
                                SettingsCardHeader {
                                    title: I18n.st_cl_title;
                                    // While signed in the server draft is pinned to
                                    // the session's server by the native projection.
                                    subtitle: root.cloud-logged-in && !root.cloud-expired ? root.cloud-server-draft : I18n.st_cl_subtitle;
                                }
                                Rectangle { height: 10px; }
                                FormField {
                                    label: I18n.st_cl_server;
                                    placeholder: "http://192.168.1.10:8000";
                                    text <=> root.cloud-server-draft;
                                    read-only: root.cloud-busy || (root.cloud-logged-in && !root.cloud-expired);
                                }
                                HorizontalLayout { spacing: 10px;
                                    FormField {
                                        horizontal-stretch: 1;
                                        label: I18n.st_cl_username;
                                        placeholder: I18n.st_cl_username_hint;
                                        text <=> root.cloud-user-draft;
                                        read-only: root.cloud-busy || (root.cloud-logged-in && !root.cloud-expired);
                                    }
                                    FormField {
                                        horizontal-stretch: 1;
                                        label: I18n.st_cl_password;
                                        placeholder: I18n.st_cl_password_hint;
                                        text <=> root.cloud-pass-draft;
                                        secret: true;
                                        read-only: root.cloud-busy;
                                        edited => { root.cloud-password-edited(root.cloud-pass-draft); }
                                    }
                                }
                                Rectangle { height: 2px; }
                                // Connection state row: the engine connection
                                // machine rendered as a colored dot plus copy.
                                HorizontalLayout { height: 20px; spacing: 6px;
                                    VerticalLayout { alignment: center; width: 8px;
                                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.cloud-dot-color; }
                                    }
                                    Text { height: parent.height; text: root.cloud-state-text; color: root.cloud-dot-color; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                                }
                                if root.cloud-connection == "online" && root.cloud-last-success != "" : Text { height: 15px; text: root.cloud-last-success; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                if root.cloud-connection == "reconnecting" && root.cloud-last-error != "" : Text { height: 15px; text: root.cloud-last-error; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                if root.cloud-connection == "reconnecting" && root.cloud-next-retry != "" : Text { height: 15px; text: I18n.st_cl_retry_in(root.cloud-next-retry); color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                // Signed in: account · balance · concurrency; signed
                                // out keeps the quiet how-to hint under the state row.
                                if root.cloud-logged-in && !root.cloud-expired : Text {
                                    height: 18px;
                                    text: root.cloud-username + " · " + I18n.st_cl_quota_prefix + " " + root.cloud-balance + " · " + I18n.st_cl_concurrency_prefix + " " + root.cloud-concurrency;
                                    color: root.cloud-quota-warn ? Theme.danger : Theme.muted;
                                    font-size: Theme.font-xs; overflow: elide;
                                }
                                if !root.cloud-logged-in && root.cloud-error == "" : Text { height: 18px; text: I18n.st_cl_offline_hint; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                if root.cloud-error != "" : Text { height: 18px; text: root.cloud-error; color: Theme.danger; font-size: Theme.font-xs; overflow: elide; }
                                Rectangle { height: 8px; }
                                HorizontalLayout { height: 34px; spacing: 10px;
                                    if !root.cloud-logged-in || root.cloud-expired : Action {
                                        width: 108px; show-label: true; primary: true;
                                        label: root.cloud-busy ? I18n.st_cl_logging_in : (root.cloud-logged-in ? I18n.st_cl_relogin : I18n.st_cl_login);
                                        enabled: !root.cloud-busy && (root.cloud-server-draft.starts-with("http://") || root.cloud-server-draft.starts-with("https://"));
                                        clicked => { root.cloud-login(); }
                                    }
                                    if root.cloud-logged-in : Action {
                                        width: 108px; show-label: true;
                                        label: root.cloud-busy ? I18n.st_cl_logging_in : I18n.st_cl_logout;
                                        enabled: !root.cloud-busy;
                                        clicked => { root.cloud-logout(); }
                                    }
                                    if root.cloud-logged-in : Action {
                                        width: 108px; show-label: true;
                                        label: I18n.st_cl_refresh;
                                        enabled: root.cloud-logged-in && !root.cloud-expired && !root.cloud-busy;
                                        clicked => { root.cloud-refresh-account(); }
                                    }
                                    // Lightweight retry while the engine reports a
                                    // degraded connection: a failed refresh keeps the
                                    // state, a success flips back to online.
                                    if root.cloud-connection == "reconnecting" || root.cloud-connection == "expired" : Action {
                                        width: 108px; show-label: true;
                                        label: root.cloud-busy ? I18n.st_cl_logging_in : I18n.st_cl_retry;
                                        enabled: !root.cloud-busy;
                                        clicked => { root.cloud-refresh-account(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                SettingRow {
                                    label: I18n.st_cl_sync;
                                    note: I18n.st_cl_sync_note;
                                    last: true;
                                    Switch {
                                        checked <=> root.cloud-sync-enabled;
                                        enabled: root.cloud-logged-in && !root.cloud-busy;
                                        toggled => { root.cloud-toggle-sync(root.cloud-sync-enabled); }
                                    }
                                }
                                SettingRow {
                                    label: I18n.zh ? "允许远程访问本地" : "Allow remote local access";
                                    note: I18n.zh ? "启用设备互通；写入和线程操作仍需本地审批" : "Enable the tunnel; writes and thread actions still require local approval";
                                    Switch { checked <=> root.cloud-inbound-enabled; enabled: root.cloud-logged-in && !root.cloud-busy; toggled => { root.cloud-toggle-sharing(self.checked, root.cloud-full-shadow); } }
                                }
                                SettingRow {
                                    label: I18n.zh ? "共享工作区与线程目录" : "Share workspace and thread catalog";
                                    note: I18n.zh ? "需同时获得舰桥授权；关闭时只共享设备摘要" : "Also requires server grants; otherwise only device summary is shared";
                                    Switch { checked <=> root.cloud-full-shadow; enabled: root.cloud-inbound-enabled && !root.cloud-busy; toggled => { root.cloud-toggle-sharing(root.cloud-inbound-enabled, self.checked); } }
                                }
                            }
                            SettingsCard {
                                SettingsCardHeader { title: I18n.stc_runs_tab; }
                                HorizontalLayout { spacing: 12px;
                                    for item in [
                                        { label: I18n.stc_runs_duration, value: root.expert-duration },
                                        { label: I18n.stc_runs_tokens, value: root.expert-tokens },
                                        { label: I18n.stc_runs_calls, value: root.expert-calls }
                                    ] : Rectangle {
                                        horizontal-stretch: 1; height: 78px; border-radius: Theme.radius-lg;
                                        background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                        VerticalLayout { padding: 12px; spacing: 2px;
                                            Text { height: 17px; text: item.label; color: Theme.muted; font-size: Theme.font-xs; }
                                            Text { height: 32px; text: item.value; color: Theme.text; font-size: Theme.font-display; font-weight: 700; }
                                        }
                                    }
                                }
                            }
                            SettingsCard {
                                SettingsCardHeader { title: I18n.st_wunder_model_title; subtitle: I18n.st_wunder_model_hint; }
                                HorizontalLayout { spacing: 10px;
                                    Button {
                                        text: I18n.st_wunder_model_open;
                                        clicked => { root.open-wunder-model(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    // Models tab, mirroring the web messenger model settings:
                    // config list on the left (drag to reorder), the selected
                    // model's full form exposed on the right.
                    if root.settings-tab == 1 : HorizontalLayout { vertical-stretch: 1; padding: 8px; spacing: 14px;
                        Rectangle { width: 236px; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 12px; spacing: 10px;
                                HorizontalLayout { height: 30px; spacing: 6px;
                                    Text { height: 30px; text: I18n.st_models_list_title; color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; label: I18n.common_refresh; clicked => { root.refresh(); } }
                                    Action { icon: @image-url("../assets/icons/plus.svg"); label: I18n.model_editor_add; show-label: true; primary: true; enabled: !root.loading && !root.saving; clicked => { root.create-model(); } }
                                }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 6px;
                                        for model[index] in root.models : DragRow {
                                            height: 58px;
                                            label: model.key;
                                            selected: root.selected-model == index;
                                            activate => { root.select-model(index); }
                                            move-by(delta) => { root.move-model(index, delta); }
                                            clip: true;
                                            Image { x: 10px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.model-icon(model.model-type); colorize: Theme.accent-ink; }
                                            // Cloud entries keep room for their badge next to the key.
                                            Text { x: 36px; y: 11px; width: parent.width - (model.is-default ? 94px : 48px) - (model.is-cloud ? 34px : 0px); height: 18px; text: model.key; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                                            Text { x: 36px; y: 32px; width: parent.width - (model.is-default ? 94px : 48px) - (model.is-cloud ? 34px : 0px); height: 15px; text: (model.model == "" && model.base-url == "") ? I18n.st_models_no_info : (model.model + " · " + model.base-url); color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                            // Engine-managed cloud entries (`cloud/<id>`): the
                                            // badge marks them in the list; they are
                                            // refreshed on sign-in and removed on logout.
                                            if model.is-cloud : Rectangle {
                                                x: parent.width - (model.is-default ? 82px : 52px); y: (parent.height - 16px) / 2; width: 26px; height: 16px;
                                                border-radius: 8px; background: Theme.accent-soft;
                                                Text { width: parent.width; height: parent.height; text: I18n.st_cl_badge; color: Theme.accent-ink; font-size: Theme.font-2xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            // Default models carry the web's hanging bookmark ribbon.
                                            if model.is-default : Rectangle {
                                                x: parent.width - 44px; y: 0px; width: 32px; height: 19px;
                                                background: @linear-gradient(180deg, #fef3c7 0%, #fde68a 100%);
                                                Text { y: 2px; width: parent.width; height: 15px; text: I18n.st_models_default_badge; color: #9a670d; font-size: Theme.font-2xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                            }
                                            if model.is-default : Rectangle {
                                                x: parent.width - 32.5px; y: 14.5px; width: 9px; height: 9px;
                                                transform-rotation: 45deg;
                                                background: #fde68a;
                                            }
                                        }
                                        if root.models.length == 0 : PageState { height: 48px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.st_models_loading : I18n.st_models_empty; }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            if root.selected-key == "" && !root.model-creating : PageState { kind: PageStateKind.empty; message: I18n.st_pick_model; }
                            if root.selected-key != "" || root.model-creating : VerticalLayout { padding: 16px; spacing: 12px;
                                HorizontalLayout { height: 46px; spacing: 8px;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                        Text { height: 26px; text: root.model-creating ? I18n.model_editor_add : root.selected-key; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; }
                                        Text { height: 17px; text: root.model-creating ? I18n.st_model_new_hint : ((root.model-editor-is-default ? I18n.st_models_default_badge + " · " : "") + I18n.st_model_colon + root.model-editor-name + " · " + root.model-editor-base-url); color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                    }
                                    // The former page-header actions live with the
                                    // form now that the title bar is gone. A new model
                                    // is committed by this explicit save: auto-saving a
                                    // draft the moment it turns valid would end the
                                    // creation state and lock the config name mid-edit.
                                    if root.model-creating : Action {
                                        height: 32px; icon: @image-url("../assets/icons/save.svg");
                                        label: I18n.common_save; show-label: true; primary: true;
                                        enabled: !root.loading && !root.saving && !root.cloud-locked
                                            && root.model-key-draft != "" && root.model-name-draft != "";
                                        clicked => { root.save-model(); }
                                    }
                                    if !root.model-creating : Action {
                                        height: 32px; icon: @image-url("../assets/icons/fa-star.svg");
                                        label: root.selected-is-default ? I18n.st_is_default : I18n.st_set_default;
                                        show-label: true;
                                        enabled: !root.loading && !root.saving && !root.cloud-locked
                                            && root.selected-key != "" && !root.selected-is-default;
                                        clicked => { root.set-default-model(root.selected-key); }
                                    }
                                    // While a new model is being created the same slot discards
                                    // the unsaved draft; a saved row keeps the delete confirmation.
                                    // Cloud entries stay visible but inert (the engine clears them
                                    // together on logout).
                                    Action {
                                        height: 32px;
                                        icon: root.model-creating ? @image-url("../assets/icons/xmark.svg") : @image-url("../assets/icons/trash.svg");
                                        label: root.model-creating ? I18n.common_discard : (root.cloud-locked ? I18n.st_cl_remove : I18n.common_delete);
                                        show-label: true; danger: true;
                                        enabled: !root.loading && !root.saving && !root.cloud-locked && (root.selected-key != "" || root.model-creating);
                                        clicked => { if root.model-creating { root.discard-model-draft(); } else { root.model-delete-open = true; } }
                                    }
                                }
                                if root.model-save-error != "" : Text { text: root.model-save-error; color: Theme.danger; font-size: Theme.font-sm; wrap: word-wrap; }
                                if root.cloud-locked : Text { height: 17px; text: I18n.st_cl_locked_note; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 14px;
                                        SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/gear.svg"); title: I18n.st_model_section_basic; }
                                            Rectangle { height: 4px; }
                                            FormField {
                                                label: I18n.model_key_label;
                                                placeholder: I18n.model_key_placeholder;
                                                // The key is the stored identity. It stays
                                                // editable for local models — a rename is
                                                // committed on Enter/focus loss — and is
                                                // locked only for engine-managed cloud rows.
                                                read-only: root.cloud-locked || root.saving;
                                                text <=> root.model-key-draft;
                                                committed => { root.commit-model-key(); }
                                            }
                                            FormCombo {
                                                label: I18n.st_model_type_label;
                                                enabled: !root.cloud-locked;
                                                items: [I18n.st_type_llm, I18n.st_type_embedding, I18n.st_type_asr, I18n.st_type_tts, I18n.st_type_image, I18n.st_type_video];
                                                values: ["llm", "embedding", "asr", "tts", "image", "video"];
                                                value <=> root.model-type-draft;
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormCombo {
                                                    horizontal-stretch: 1;
                                                    label: I18n.model_provider_label;
                                                    enabled: !root.cloud-locked;
                                                    items: root.model-provider-presets;
                                                    value <=> root.model-provider-draft;
                                                    selected(provider) => {
                                                        root.model-base-url-draft = provider == "virtual_replay" ? "" : ModelPresets.base-url(provider);
                                                    }
                                                }
                                                FormField { horizontal-stretch: 1; label: I18n.model_name_label; placeholder: I18n.model_name_placeholder; read-only: root.cloud-locked; text <=> root.model-name-draft; }
                                            }
                                            FormField { label: I18n.model_base_url_label; placeholder: I18n.model_base_url_placeholder; read-only: root.cloud-locked; text <=> root.model-base-url-draft; }
                                            FormField { label: I18n.model_token_label; placeholder: I18n.model_token_placeholder; secret: true; read-only: root.cloud-locked; text <=> root.model-token-draft; }
                                            if root.model-provider-draft == "virtual_replay" && root.virtual-replay-logs.length > 0 : FormCombo { label: "回放日志"; items: root.virtual-replay-logs; value <=> root.model-name-draft; }
                                        }
                                        // Generation / multimodal parameters per type.
                                        if root.model-type-draft == "llm" || root.model-type-draft == "" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_llm; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "temperature"; placeholder: "0.7"; read-only: root.cloud-locked; text <=> root.model-temperature-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_timeout; placeholder: "120"; read-only: root.cloud-locked; text <=> root.model-timeout-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_max_output; placeholder: I18n.st_param_model_default; read-only: root.cloud-locked; text <=> root.model-max-output-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_thinking; placeholder: I18n.st_param_model_default; read-only: root.cloud-locked; text <=> root.model-thinking-budget-draft; }
                                            }
                                            FormField { label: I18n.st_param_max_rounds; placeholder: "1000"; read-only: root.cloud-locked; text <=> root.model-max-rounds-draft; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_history_ratio; placeholder: "0.9"; read-only: root.cloud-locked; text <=> root.model-history-compaction-ratio-draft; }
                                                FormCombo { horizontal-stretch: 1; label: I18n.st_param_reasoning_effort; items: [I18n.st_param_default_option, "none", "minimal", "low", "medium", "high", "xhigh"]; values: ["", "none", "minimal", "low", "medium", "high", "xhigh"]; value <=> root.model-reasoning-effort-draft; }
                                            }
                                            if root.model-provider-draft == "virtual_replay" : FormCombo { label: I18n.st_param_simulation_speed; items: ["fast", "medium", "slow"]; value <=> root.model-simulation-speed-draft; }
                                            HorizontalLayout { spacing: 10px;
                                                ThemeCheck { text: "支持视觉"; checked: root.model-support-vision-draft; toggled => { root.model-support-vision-draft = !root.model-support-vision-draft; } }
                                                ThemeCheck { text: "支持听觉"; checked: root.model-support-hearing-draft; toggled => { root.model-support-hearing-draft = !root.model-support-hearing-draft; } }
                                                ThemeCheck { text: "流式返回 usage"; checked: root.model-stream-include-usage-draft; toggled => { root.model-stream-include-usage-draft = !root.model-stream-include-usage-draft; } }
                                            }
                                            FormCombo { label: "工具调用方式"; items: ["tool_call", "function_call", "freeform_call"]; value <=> root.model-tool-call-mode-draft; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_max_context; placeholder: I18n.st_param_context_hint; read-only: root.cloud-locked; text <=> root.model-max-context-draft; }
                                                Rectangle { width: 116px; height: 62px;
                                                    Action { y: 26px; width: 116px; height: 36px; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: I18n.model_probe_context; show-label: true; primary: true; enabled: !root.saving && !root.cloud-locked && root.model-name-draft != "" && root.model-base-url-draft != ""; clicked => { root.probe-model-context(); } }
                                                }
                                            }
                                        }
                                        if root.model-type-draft == "embedding" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_llm; }
                                            Rectangle { height: 6px; }
                                            Text { height: 18px; text: I18n.st_params_empty_hint; color: Theme.muted; font-size: Theme.font-sm; }
                                        }
                                        if root.model-type-draft == "asr" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_asr; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_asr_language; placeholder: I18n.st_param_asr_language_hint; text <=> root.model-asr-language-draft; }
                                                FormCombo {
                                                    horizontal-stretch: 1;
                                                    label: I18n.st_param_asr_format;
                                                    items: [I18n.st_param_default_option, "json", "text", "verbose_json", "srt", "vtt"];
                                                    values: ["", "json", "text", "verbose_json", "srt", "vtt"];
                                                    value <=> root.model-asr-format-draft;
                                                }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "temperature"; placeholder: "0 - 2"; text <=> root.model-asr-temperature-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_asr_prompt; placeholder: I18n.st_param_model_default; text <=> root.model-asr-prompt-draft; }
                                            }
                                        }
                                        if root.model-type-draft == "tts" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_tts; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_tts_voice; placeholder: I18n.st_param_model_default; text <=> root.model-tts-voice-draft; }
                                                FormCombo {
                                                    horizontal-stretch: 1;
                                                    label: I18n.st_param_tts_format;
                                                    items: [I18n.st_param_default_option, "wav", "mp3", "flac", "aac", "opus", "pcm"];
                                                    values: ["", "wav", "mp3", "flac", "aac", "opus", "pcm"];
                                                    value <=> root.model-tts-format-draft;
                                                }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_tts_speed; placeholder: "0.25 - 4"; text <=> root.model-tts-speed-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_tts_instructions; placeholder: I18n.st_param_model_default; text <=> root.model-tts-instructions-draft; }
                                            }
                                            Rectangle { width: 104px; height: 30px;
                                                Action { width: 104px; label: I18n.model_probe_voices; show-label: true; enabled: !root.saving && root.model-name-draft != "" && root.model-base-url-draft != ""; clicked => { root.probe-model-voices(); } }
                                            }
                                        }
                                        if root.model-type-draft == "image" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_image; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_image_size; placeholder: I18n.st_param_image_size_hint; text <=> root.model-image-size-draft; }
                                                FormCombo {
                                                    horizontal-stretch: 1;
                                                    label: I18n.st_param_image_format;
                                                    items: [I18n.st_param_default_option, "png", "jpeg", "webp"];
                                                    values: ["", "png", "jpeg", "webp"];
                                                    value <=> root.model-image-format-draft;
                                                }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_image_steps; placeholder: "1 - 200"; text <=> root.model-image-steps-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_image_guidance; placeholder: "0 - 20"; text <=> root.model-image-guidance-draft; }
                                            }
                                            FormField { label: I18n.st_param_negative; placeholder: I18n.st_param_model_default; text <=> root.model-image-negative-draft; }
                                        }
                                        if root.model-type-draft == "video" : SettingsCard {
                                            FormSectionHead { icon: @image-url("../assets/icons/fa-sliders.svg"); title: I18n.st_params_video; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_video_size; placeholder: I18n.st_param_video_size_hint; text <=> root.model-video-size-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_video_seconds; placeholder: "≥ 0.5"; text <=> root.model-video-seconds-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "FPS"; placeholder: "≥ 1"; text <=> root.model-video-fps-draft; }
                                                FormField { horizontal-stretch: 1; label: I18n.st_param_negative; placeholder: I18n.st_param_model_default; text <=> root.model-video-negative-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "总帧数"; placeholder: "≥ 1"; text <=> root.model-video-num-frames-draft; }
                                                FormField { horizontal-stretch: 1; label: "采样步数"; placeholder: "1 - 200"; text <=> root.model-video-steps-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "guidance_scale"; placeholder: "0 - 20"; text <=> root.model-video-guidance-scale-draft; }
                                                FormField { horizontal-stretch: 1; label: "guidance_scale_2"; placeholder: "0 - 20"; text <=> root.model-video-guidance-scale-2-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                FormField { horizontal-stretch: 1; label: "boundary_ratio"; placeholder: "0 - 1"; text <=> root.model-video-boundary-ratio-draft; }
                                                FormField { horizontal-stretch: 1; label: "flow_shift"; placeholder: "≥ 0"; text <=> root.model-video-flow-shift-draft; }
                                            }
                                            HorizontalLayout { spacing: 10px;
                                                ThemeCheck { text: "启用补帧"; checked: root.model-video-frame-interpolation-draft; toggled => { root.model-video-frame-interpolation-draft = !root.model-video-frame-interpolation-draft; } }
                                                ThemeCheck { text: "同步模式"; checked: root.model-video-sync-mode-draft; toggled => { root.model-video-sync-mode-draft = !root.model-video-sync-mode-draft; } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.settings-tab == 2 : ToolsPage {
                        loading: root.tools-loading; working: root.tools-working; status: root.tool-manager-status;
                        builtin-tools: root.tools-builtin; mcp-tools: root.tools-mcp;
                        skill-tools: root.tools-skills; knowledge-tools: root.tools-knowledge;
                        servers: root.tools-servers; skills: root.tools-skill-resources; bases: root.tools-bases;
                        files: root.tools-files; file-rows: root.tools-file-rows; server-tools: root.tools-server-tools;
                        tab <=> root.tools-tab; selected <=> root.tools-selected;
                        file-path <=> root.tools-file-path; content <=> root.tools-content;
                        has-more: root.tools-has-more; directory: root.tools-directory;
                        search <=> root.tools-search;
                        refresh => { root.refresh-tools(); }
                        select-resource(kind, index) => { root.select-tool-resource(kind, index); }
                        open-file(path, preview) => { root.open-tool-file(path, preview); }
                        more-files => { root.more-tool-files(); }
                        search-files(query) => { root.search-tool-files(query); }
                        action(kind, id, value) => { root.tool-manager-action(kind, id, value); }
                        inspect(label, value) => { root.open-info(label, value); }
                        copy-path(value) => { root.tool-manager-status = value; }
                    }

                    if root.settings-tab == 3 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 24px; spacing: 14px; alignment: start; vertical-stretch: 1;
                            // Agent fields save automatically after a short idle
                            // period; keeping the form itself full-height avoids
                            // a toolbar consuming useful editor space.
                            // §9.3: the personal build ships one built-in agent, so
                            // this category is one stacked form. The name is
                            // preset-owned and stays read-only; the extra prompt
                            // edits the agent record, while every thread keeps the
                            // prompt it froze on first use.
                            FormField {
                                label: I18n.stc_agent_name;
                                placeholder: I18n.stc_agent_name;
                                strong-label: true;
                                text: root.selected-agent-name;
                                read-only: true;
                            }
                            FormField {
                                label: I18n.stc_agent_greeting;
                                placeholder: I18n.stc_agent_greeting_hint;
                                strong-label: true;
                                text <=> root.selected-agent-description;
                                read-only: root.saving;
                            }
                            VerticalLayout { spacing: 7px;
                                Text { height: 18px; text: I18n.stc_agent_extra_prompt; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; }
                                Rectangle {
                                    height: 176px; border-radius: Theme.radius-sm;
                                    background: root.saving ? Theme.input-readonly-bg : Theme.input-bg;
                                    border-width: 1px; border-color: prompt-edit.has-focus ? Theme.accent-ink : root.saving ? Theme.input-readonly-border : Theme.input-border;
                                    prompt-edit := TextEditBase {
                                        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                                        text <=> root.selected-agent-system-prompt;
                                        placeholder-text: I18n.stc_agent_extra_prompt_hint;
                                        placeholder-color: Theme.muted;
                                        enabled: !root.saving; wrap: word-wrap;
                                        foreground: Theme.text; font-size: Theme.font-sm;
                                        background: transparent; border-width: 0px;
                                        scroll-view-padding: 10px;
                                        selection-background-color: Theme.accent-ink; selection-foreground-color: white;
                                    }
                                }
                            }
                            // Tool selection as cards, grouped by type with a
                            // per-group select-all. Filtering happens natively
                            // because Slint strings have no substring test.
                            SettingsCard {
                                Rectangle { height: 34px;
                                    Text {
                                        x: 0px; y: 0px; width: parent.width - 280px; height: parent.height;
                                        text: I18n.stc_agent_admin_tools; color: Theme.text;
                                        font-size: Theme.font-md; font-weight: 700;
                                        vertical-alignment: center; overflow: elide;
                                    }
                                    Rectangle {
                                        x: parent.width - 270px; y: 0px; width: 270px; height: 34px;
                                        border-radius: Theme.radius-sm; background: Theme.input-bg;
                                        border-width: 1px; border-color: agent-tool-search.has-focus ? Theme.accent-ink : Theme.input-border;
                                        Image { x: 9px; y: 10px; width: 13px; height: 13px; source: @image-url("../assets/icons/magnifying-glass.svg"); colorize: Theme.muted; image-fit: contain; }
                                        agent-tool-search := TextInput {
                                            x: 30px; y: 0px; width: parent.width - 38px; height: parent.height;
                                            text <=> root.expert-tool-keyword;
                                            single-line: true;
                                            font-size: Theme.font-sm; color: Theme.text; vertical-alignment: center;
                                        }
                                        if root.expert-tool-keyword == "" : Text {
                                            x: 30px; y: 0px; width: parent.width - 38px; height: parent.height;
                                            text: I18n.ag_search_tools; color: Theme.muted; font-size: Theme.font-sm;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                    }
                                }
                                Rectangle { height: 4px; }
                                Text { height: 17px; text: I18n.stc_agent_tools_note; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                Rectangle { height: 12px; }
                                ExpertToolPicker {
                                    groups: root.expert-tool-groups;
                                    enabled: !root.saving;
                                    toggle(name) => { root.toggle-agent-tool-option(name); }
                                    toggle-group(title) => { root.toggle-expert-tool-group(title); }
                                }
                                if root.expert-tool-groups.length == 0 : Text {
                                    height: 44px; text: root.expert-tool-keyword.is-empty ? I18n.ag_empty : I18n.ag_no_matching_tool;
                                    color: Theme.muted; font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                            }
                            // Preset questions: a bounded list with per-row delete
                            // plus one draft row, matching the old agent editor.
                            SettingsCard {
                                SettingsCardHeader { title: I18n.ag_preset_questions; subtitle: I18n.stc_agent_questions_note; }
                                Rectangle { height: 10px; }
                                for question[index] in root.selected-agent-preset-questions : Rectangle {
                                    height: 38px;
                                    Text {
                                        x: 0px; y: 0px; width: parent.width - 40px; height: parent.height;
                                        text: question; color: Theme.text-secondary; font-size: Theme.font-sm;
                                        vertical-alignment: center; overflow: elide;
                                    }
                                    Action {
                                        x: parent.width - 30px; y: 4px; width: 30px; height: 30px;
                                        icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_delete;
                                        enabled: !root.saving;
                                        clicked => { root.remove-agent-question(index); }
                                    }
                                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                                }
                                Rectangle { height: 4px; }
                                HorizontalLayout { spacing: 8px;
                                    Rectangle {
                                        horizontal-stretch: 1; height: 36px; border-radius: Theme.radius-sm;
                                        background: root.saving ? Theme.input-readonly-bg : Theme.input-bg;
                                        border-width: 1px; border-color: agent-question-input.has-focus ? Theme.accent-ink : root.saving ? Theme.input-readonly-border : Theme.input-border;
                                        agent-question-input := TextInput {
                                            x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
                                            text <=> root.agent-question-draft;
                                            single-line: true; enabled: !root.saving;
                                            font-size: Theme.font-sm; color: Theme.text; vertical-alignment: center;
                                            accepted => { root.add-agent-question(); }
                                        }
                                        if root.agent-question-draft == "" : Text {
                                            x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
                                            text: I18n.stc_agent_question_placeholder; color: Theme.muted; font-size: Theme.font-sm;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                    }
                                    Action {
                                        width: 30px; height: 30px; icon: @image-url("../assets/icons/plus.svg");
                                        label: I18n.stc_agent_question_add; primary: true;
                                        enabled: !root.saving && !root.agent-question-draft.is-empty;
                                        clicked => { root.add-agent-question(); }
                                    }
                                }
                            }
                        }
                    }

                    if root.settings-tab == 4 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 24px; spacing: 16px; alignment: start; vertical-stretch: 1;
                            SettingsCard {
                                SettingsCardHeader { title: I18n.pet_behavior; subtitle: I18n.pet_behavior_note; }
                                SettingRow { row-icon: @image-url("../assets/icons/paw.svg"); label: I18n.pet_show; note: I18n.pet_show_note;
                                    Switch {
                                        checked: PetSettingsState.enabled;
                                        toggled => { PetSettingsState.toggle-enabled(self.checked); }
                                    }
                                }
                                SettingRow { row-icon: @image-url("../assets/icons/comment-dots.svg"); label: I18n.pet_hints; note: I18n.pet_hints_note;
                                    Switch {
                                        checked: PetSettingsState.hints;
                                        toggled => { PetSettingsState.toggle-hints(self.checked); }
                                    }
                                }
                                SettingRow { row-icon: @image-url("../assets/icons/fa-expand.svg"); label: I18n.pet_scale; note: I18n.pet_scale_note; last: true;
                                    HorizontalLayout { spacing: 10px; alignment: end;
                                        Text { text: PetSettingsState.scale-label; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                        Slider {
                                            min-width: 150px; max-width: 220px; minimum: 0.1; maximum: 1.6; step: 0.1;
                                            value: PetSettingsState.scale;
                                            changed => { PetSettingsState.set-scale(self.value); }
                                        }
                                    }
                                }
                            }
                            SettingsCard {
                                HorizontalLayout { spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 3px;
                                        Text { text: I18n.pet_library_title; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; }
                                        Text { text: I18n.pet_library_subtitle(PetSettingsState.library-count); color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
                                    }
                                    Action { width: 84px; height: 30px; label: I18n.pet_refresh; show-label: true; enabled: !PetSettingsState.loading; clicked => { PetSettingsState.refresh(); } }
                                    Action { width: 76px; height: 30px; label: I18n.pet_import; show-label: true; primary: true; clicked => { PetSettingsState.import-package(); } }
                                }
                                Rectangle { height: 9px; }
                                Rectangle { height: 1px; background: Theme.border; }
                                Rectangle { height: 12px; }
                                if PetSettingsState.companions.length == 0 : Text {
                                    height: 44px; text: I18n.pet_library_empty; color: Theme.muted; font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                                // 形象库网格：蜂巢同款 3 列卡片。绝对定位取 parent.width，
                                // 不走布局约束，避免子项宽度反向依赖容器形成回路。
                                if PetSettingsState.companions.length > 0 : Rectangle {
                                    height: ((PetSettingsState.companions.length + 2) / 3) * 186px;
                                    property <length> card-width: (self.width - 24px) / 3;
                                    for companion[index] in PetSettingsState.companions : Rectangle {
                                        x: Math.mod(index, 3) * (parent.card-width + 12px);
                                        y: Math.floor(index / 3) * 186px;
                                        width: parent.card-width;
                                        height: 174px;
                                        border-radius: Theme.radius-md;
                                        border-width: 1px;
                                        border-color: companion.id == PetSettingsState.selected-id ? Theme.accent-ink : Theme.border;
                                        background: companion.id == PetSettingsState.selected-id ? Theme.accent-soft : Theme.surface;
                                        Image {
                                            x: 12px; y: 12px; width: parent.width - 24px; height: 84px;
                                            source: companion.preview; image-fit: contain;
                                        }
                                        Text {
                                            x: 12px; y: 100px; width: parent.width - 24px; height: 20px;
                                            text: companion.name; color: Theme.text; font-size: Theme.font-sm; font-weight: 600;
                                            horizontal-alignment: center; overflow: elide; wrap: no-wrap;
                                        }
                                        Text {
                                            x: 12px; y: 121px; width: parent.width - 24px; height: 17px;
                                            text: companion.description; color: Theme.muted; font-size: Theme.font-2xs;
                                            horizontal-alignment: center; overflow: elide; wrap: no-wrap;
                                        }
                                        pet-card := TouchArea {
                                            mouse-cursor: pointer;
                                            enabled: companion.id != PetSettingsState.selected-id;
                                            clicked => { PetSettingsState.select(companion.id); }
                                        }
                                        Action {
                                            x: parent.width - 36px; y: 8px; width: 26px; height: 26px;
                                            icon: @image-url("../assets/icons/trash.svg"); label: I18n.common_delete;
                                            clicked => { PetSettingsState.delete(companion.id); }
                                        }
                                        Action {
                                            y: 142px; x: (parent.width - self.width) / 2; width: 76px; height: 26px;
                                            label: companion.id == PetSettingsState.selected-id ? I18n.pet_in_use : I18n.pet_use;
                                            enabled: companion.id != PetSettingsState.selected-id;
                                            clicked => { PetSettingsState.select(companion.id); }
                                        }
                                    }
                                }
                                if PetSettingsState.page-count > 1 : HorizontalLayout {
                                    height: 34px; spacing: 10px; alignment: center;
                                    Action { width: 72px; height: 30px; label: I18n.av_page_prev; show-label: true; enabled: PetSettingsState.page > 1; clicked => { PetSettingsState.prev-page(); } }
                                    Text { text: PetSettingsState.page-label; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                    Action { width: 72px; height: 30px; label: I18n.av_page_next; show-label: true; enabled: PetSettingsState.page < PetSettingsState.page-count; clicked => { PetSettingsState.next-page(); } }
                                }
                            }
                        }
                    }

                    if root.settings-tab == 5 : CronPage {
                        loading: root.cron-loading; jobs: root.cron-jobs; selected <=> root.cron-selected; workspace-names <=> root.cron-workspace-names;
                        editor-open <=> root.cron-editor-open; editor-saving <=> root.cron-editor-saving;
                        editor-kind <=> root.cron-edit-kind; editor-name <=> root.cron-edit-name;
                        editor-interval-unit <=> root.cron-edit-interval-unit;
                        editor-at <=> root.cron-edit-at; editor-every <=> root.cron-edit-every;
                        editor-cron <=> root.cron-edit-cron; editor-tz <=> root.cron-edit-tz;
                        editor-message <=> root.cron-edit-message; editor-workspace <=> root.cron-edit-workspace;
                        editor-delete-after <=> root.cron-edit-delete-after; editor-enabled <=> root.cron-edit-enabled;
                        runs-open <=> root.cron-runs-open; runs-loading: root.cron-runs-loading;
                        runs-title: root.cron-runs-title; runs: root.cron-runs;
                        refresh => { root.refresh-cron(); }
                        toggle(id, enabled) => { root.toggle-cron(id, enabled); }
                        delete(id) => { root.delete-cron(id); }
                        run-now(id) => { root.run-cron-now(id); }
                        open-runs(id) => { root.open-cron-runs(id); }
                        close-runs => { root.close-cron-runs(); }
                        open-creator => { root.open-cron-creator(); }
                        edit-job(id) => { root.edit-cron-job(id); }
                        save-editor => { root.save-cron-editor(); }
                        cancel-editor => { root.cancel-cron-editor(); }
                    }

                    if root.settings-tab == 6 : ExpertData {
                        vertical-stretch: 1;
                        loading: root.expert-loading; error: root.expert-error;
                        memories: root.expert-memories;
                        query <=> root.expert-query; category <=> root.expert-category;
                        categories: root.expert-categories;
                        editor-open <=> root.memory-editor-open; edit-id <=> root.memory-edit-id;
                        edit-title <=> root.memory-edit-title; edit-content <=> root.memory-edit-content;
                        edit-category <=> root.memory-edit-category;
                        saving: root.expert-saving; agent-names: root.expert-agent-names;
                        replicate-memory(index) => { root.replicate-expert-memory(index); }
                        refresh => { root.refresh-expert(); }
                        save-memory => { root.save-expert-memory(); }
                        delete-memory(id) => { root.delete-expert-memory(id); }
                        open-memory(index) => { root.open-expert-memory(index); }
                    }

                    if root.settings-tab == 7 : ChannelsPage {
                        loading: root.channel-loading; catalog: root.channel-catalog;
                        accounts: root.channel-accounts; selected: root.selected-channel-account;
                        bindings: root.channel-bindings; bindings-loading: root.channel-bindings-loading;
                        logs-loading: root.channel-logs-loading; logs: root.channel-logs;
                        editor-open: root.channel-editor-open; editor-saving: root.channel-editor-saving;
                        editor-id: root.channel-edit-id; editor-kind <=> root.channel-edit-kind;
                        editor-agent <=> root.channel-edit-agent;
                        agent-names: root.channel-agent-names; catalog-names: root.channel-catalog-names;
                        delete-open: root.channel-delete-open; qr-open: root.channel-qr-open;
                        qr-state: root.channel-qr-state; qr-image: root.channel-qr-image; qr-message: root.channel-qr-message;
                        edit-name <=> root.channel-edit-name; edit-enabled <=> root.channel-edit-enabled;
                        edit-group-chat <=> root.channel-edit-group-chat;
                        edit-app-id <=> root.channel-edit-app-id; edit-app-secret <=> root.channel-edit-app-secret;
                        edit-corp-id <=> root.channel-edit-corp-id; edit-wechat-agent <=> root.channel-edit-wechat-agent;
                        edit-secret <=> root.channel-edit-secret; edit-token <=> root.channel-edit-token;
                        edit-aes-key <=> root.channel-edit-aes-key; edit-original-id <=> root.channel-edit-original-id;
                        edit-api-base <=> root.channel-edit-api-base; edit-bot-token <=> root.channel-edit-bot-token;
                        edit-bot-id <=> root.channel-edit-bot-id; edit-user-id <=> root.channel-edit-user-id;
                        edit-domain <=> root.channel-edit-domain; edit-config-json <=> root.channel-edit-config-json;
                        refresh => { root.refresh-channels(); }
                        select-account(index) => { root.select-channel-account(index); }
                        open-creator => { root.open-channel-creator(); }
                        edit-account => { root.edit-channel-account(); }
                        save-editor => { root.save-channel-editor(); }
                        cancel-editor => { root.cancel-channel-editor(); }
                        request-delete => { root.request-delete-channel(); }
                        confirm-delete => { root.confirm-delete-channel(); }
                        cancel-delete => { root.cancel-delete-channel(); }
                        toggle(enabled) => { root.toggle-channel-account(enabled); }
                        open-logs => { root.open-channel-logs(); }
                        probe-logs => { root.probe-channel-logs(); }
                        clear-logs => { root.clear-channel-logs(); }
                        delete-binding(account, target) => { root.delete-channel-binding(account, target); }
                        start-qr => { root.start-channel-qr(); }
                        cancel-qr => { root.cancel-channel-qr(); }
                        reconnect => { root.reconnect-channel(); }
                    }

                    if root.settings-tab == 10 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 24px; spacing: 16px; alignment: start; vertical-stretch: 1;
                            SettingsCard {
                                SettingsCardHeader { title: I18n.stc_archives; }
                                if root.expert-archives.length == 0 : Text { height: 48px; text: I18n.stc_archives_empty; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                for archive in root.expert-archives : Rectangle {
                                    height: 54px;
                                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                                    Text { x: 0px; y: 8px; width: max(0px, parent.width - 228px); height: 20px; text: archive.title; color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                    Text { x: 0px; y: 29px; width: max(0px, parent.width - 228px); height: 17px; text: archive.time; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                                    Action { x: parent.width - 220px; y: 13px; width: 66px; label: I18n.stc_archives_open; show-label: true; enabled: !root.expert-saving; clicked => { root.open-expert-archive(archive.id); } }
                                    Action { x: parent.width - 146px; y: 13px; width: 66px; label: I18n.stc_archives_restore; show-label: true; enabled: !root.expert-saving; clicked => { root.restore-expert-archive(archive.id); } }
                                    Action { x: parent.width - 72px; y: 13px; width: 66px; label: I18n.common_delete; show-label: true; danger: true; enabled: !root.expert-saving; clicked => { root.delete-expert-archive(archive.id); } }
                                    // Keep the row hit target to the left of the
                                    // action buttons.  The previous width covered
                                    // the restore/delete controls, so a click on
                                    // those buttons could be routed to the row's
                                    // open-detail handler instead.
                                    archive-row := TouchArea {
                                        x: 0px; y: 0px; width: max(0px, parent.width - 228px); height: parent.height;
                                        mouse-cursor: pointer;
                                        clicked => { root.open-expert-archive(archive.id); }
                                    }
                                }
                            }
                        }
                    }
                    if root.settings-tab == 9 : ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { padding: 20px; spacing: 14px; vertical-stretch: 1;
                            Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 14px; spacing: 10px;
                                    HorizontalLayout { height: 30px; spacing: 8px;
                                        Text { text: I18n.pm_pack; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; }
                                        ComboBox { horizontal-stretch: 1; height: 30px; model: root.prompt-pack-names; selected(value) => { root.select-prompt-pack(value); } }
                                        Action { label: I18n.pm_set_active; show-label: true; primary: true; enabled: !root.prompt-loading && root.selected-pack != "" && root.selected-pack != root.prompt-active; clicked => { root.set-active-prompt-pack(); } }
                                        Action { label: I18n.pm_new; show-label: true; enabled: !root.prompt-loading; clicked => { root.create-prompt-pack(); } }
                                        Action { label: I18n.pm_delete_custom; show-label: true; enabled: !root.prompt-loading && root.selected-pack != "" && !root.prompt-readonly; clicked => { root.delete-prompt-pack(); } }
                                    }
                                    HorizontalLayout { spacing: 6px;                                         Rectangle { width: 90px; height: 22px; border-radius: 4px; background: Theme.accent-soft; Text { width: parent.width; height: parent.height; text: I18n.pm_active_tag + root.prompt-active; color: Theme.accent-ink; font-size: Theme.font-2xs; horizontal-alignment: center; vertical-alignment: center; } }
                                        Rectangle { width: 90px; height: 22px; border-radius: 4px; background: Theme.surface; Text { width: parent.width; height: parent.height; text: I18n.pm_lang_default_tag; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: center; vertical-alignment: center; visible: root.prompt-packs.length > 0 && root.prompt-packs[0].is-lang-default; } }
                                        Rectangle { width: 120px; height: 22px; border-radius: 4px; background: Theme.surface; Text { width: parent.width; height: parent.height; text: I18n.pm_sync_tag + root.prompt-active; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: center; vertical-alignment: center; visible: root.prompt-readonly; } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                HorizontalLayout { vertical-stretch: 1; spacing: 10px;
                                    Rectangle { width: 190px; border-radius: Theme.radius-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                        ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                            VerticalLayout { alignment: start; padding: 8px; spacing: 4px;
                                                for segment[index] in [{key: "role", label: I18n.pm_segment_role}, {key: "engineering", label: I18n.pm_segment_engineering}, {key: "tools_protocol", label: I18n.pm_segment_tool_protocol}, {key: "skills_protocol", label: I18n.pm_segment_skill_protocol}, {key: "memory", label: I18n.pm_segment_memory}, {key: "extra", label: I18n.pm_segment_attach}] : Rectangle { horizontal-stretch: 1; height: 42px; border-radius: Theme.radius-sm; background: root.selected-segment == index ? Theme.accent-soft : transparent; border-width: 1px; border-color: root.selected-segment == index ? Theme.accent-ink : transparent;
                                                    VerticalLayout { spacing: 1px; Text { text: segment.label; color: root.selected-segment == index ? Theme.accent-deep : Theme.text; font-size: Theme.font-xs; font-weight: 600; } Text { text: segment.key; color: Theme.muted; font-size: 9px; overflow: elide; } }
                                                    TouchArea { clicked => { root.selected-segment = index; root.select-prompt-pack(root.selected-pack); } }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                                        VerticalLayout { padding: 12px; spacing: 8px;
                                            HorizontalLayout { height: 22px; Text { text: root.selected-pack == "" ? I18n.pm_segment_edit : I18n.pm_segment_edit_prefix + root.selected-pack; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: root.prompt-readonly ? I18n.pm_readonly_hint : I18n.pm_editable_hint; color: root.prompt-readonly ? Theme.muted : Theme.success; font-size: Theme.font-2xs; vertical-alignment: center; } }
                                            TextEditBase { vertical-stretch: 1; text <=> root.prompt-draft; read-only: root.prompt-readonly || root.prompt-loading; wrap: word-wrap; foreground: root.prompt-readonly || root.prompt-loading ? Theme.input-readonly-text : Theme.text; font-size: Theme.font-sm; background: root.prompt-readonly || root.prompt-loading ? Theme.input-readonly-bg : Theme.input-bg; border-width: 1px; border-color: Theme.input-border; border-radius: Theme.radius-sm; selection-background-color: Theme.accent-ink; selection-foreground-color: white; }
                                            HorizontalLayout { height: 30px; Rectangle { horizontal-stretch: 1; } Action { width: 96px; label: I18n.pm_save_segment; show-label: true; primary: true; enabled: !root.prompt-readonly && !root.prompt-loading && root.selected-pack != ""; clicked => { root.save-prompt-segment(); } } }
                                        }
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                                VerticalLayout { padding: 14px; spacing: 8px;
                                    HorizontalLayout { height: 22px; Text { text: I18n.pm_preview_title; color: Theme.text; font-size: 13px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Action { label: I18n.pm_preview_refresh; show-label: true; enabled: !root.prompt-preview-loading; clicked => { root.refresh-prompt-preview(); } } }
                                    Text { text: I18n.pm_preview_hint; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                    TextEditBase { vertical-stretch: 1; text: root.prompt-preview; read-only: true; wrap: word-wrap; foreground: Theme.text; font-size: Theme.font-xs; background: Theme.input-readonly-bg; border-width: 1px; border-color: Theme.input-readonly-border; border-radius: Theme.radius-sm; scroll-view-padding: 8px; selection-background-color: Theme.accent-ink; selection-foreground-color: white; }
                                }
                            }
                        }
                    }
                }
            }
        }
    if root.model-delete-open : Rectangle { background: Theme.overlay; TouchArea { clicked => { root.model-delete-open = false; } }
        Rectangle { width: min(400px, parent.width - 44px); height: 180px; border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { }
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { height: 24px; text: I18n.ag_delete_confirm_title; color: Theme.text; font-size: Theme.font-xl; font-weight: 600; }
                Text { vertical-stretch: 1; text: I18n.ag_delete_prefix + root.selected-key + I18n.ag_delete_suffix; color: Theme.muted; font-size: Theme.font-sm; wrap: word-wrap; }
                HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: I18n.common_cancel; show-label: true; clicked => { root.model-delete-open = false; } } Action { width: 76px; label: I18n.common_delete; show-label: true; primary: true; clicked => { root.model-delete-open = false; root.delete-model(root.selected-key); } } }
            }
        }
    }
}
