// Web-style settings navigation entry: circular icon badge and one title row.
// The category note that used to sit under the label is gone, so the column
// reads as a tight single-line list instead of eleven two-line blocks.
component SettingsNavItem inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <bool> selected: false;
    callback clicked();
    height: 48px;
    border-radius: Theme.radius-lg;
    background: root.selected ? Theme.accent : (touch.has-hover ? Theme.accent-soft : transparent);
    Rectangle {
        x: 10px; y: (parent.height - 36px) / 2; width: 36px; height: 36px; border-radius: 18px;
        background: root.selected ? #ffffff3d : Theme.selected;
        Image { x: 9px; y: 9px; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? white : Theme.text-secondary; }
    }
    Text {
        x: 56px; y: 0px; width: parent.width - 66px; height: parent.height;
        text: root.title; color: root.selected ? white : Theme.text;
        font-size: Theme.font-md; font-weight: 600; overflow: elide;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// White rounded card grouping settings rows (web settings card).
component SettingsCard inherits Rectangle {
    border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border;
    VerticalLayout { padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 14px; spacing: 0px; @children }
}

// Card-internal title + subtitle header followed by a divider.
component SettingsCardHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle: "";
    in property <color> title-color: Theme.text;
    spacing: 3px;
    Text { text: root.title; color: root.title-color; font-size: Theme.font-headline; font-weight: 700; }
    if root.subtitle != "" : Text { text: root.subtitle; color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
    Rectangle { height: 9px; }
    Rectangle { height: 1px; background: Theme.border; }
}

// Web-style model form section head: small accent icon plus a bold title.
component FormSectionHead inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    height: 24px;
    Image { x: 0px; y: 4px; width: 16px; height: 16px; source: root.icon; colorize: Theme.accent-ink; }
    Text { x: 26px; width: parent.width - 26px; height: 24px; text: root.title; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; overflow: elide; }
}

// Theme-following compact dropdown face over the headless ComboBoxBase
// (same shape as rcho's CompactComboBox): crisp arrow, popup list below the
// field, hover/selected highlight driven by Theme tokens so it follows the
// active palette. The face text is a plain binding on the caller's value, so
// the widget's internal write-backs can never freeze the display.
component ThemeComboBox inherits Rectangle {
    in property <[string]> options;
    // Row index matching the caller's value; -1 hides the selection highlight.
    in property <int> current-index: -1;
    in property <string> text;
    in property <bool> enabled: true;
    in property <int> max-visible-items: 8;
    callback pick(int);
    out property <bool> has-focus: base.has-focus;

    private property <int> popup-hover-index: -1;
    private property <length> item-height: 26px;

    forward-focus: base;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: base.popup-has-focus;
    accessible-value: root.text;
    accessible-action-expand => { base.show-popup(); }

    Rectangle {
        background: root.enabled ? Theme.input-bg : Theme.input-readonly-bg;
        border-color: base.has-focus ? Theme.accent-ink : (base.has-hover && root.enabled ? Theme.border-strong : Theme.input-border);
        border-width: 1px;
        border-radius: Theme.radius-sm;
    }
    Text {
        x: 8px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        color: root.enabled ? Theme.text : Theme.input-readonly-text;
        font-size: Theme.font-md;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Path {
        x: parent.width - 20px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 6 9 L 12 15 L 18 9";
        fill: transparent;
        stroke: root.enabled ? Theme.muted : Theme.input-readonly-text;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        accessible-role: none;
    }

    // The base writes current-index on selection, which would replace any
    // declarative binding; external value changes are pushed back in here
    // instead of relying on a surviving binding.
    changed current-index => {
        if base.current-index != root.current-index {
            base.current-index = root.current-index;
        }
    }

    base := ComboBoxBase {
        width: 100%;
        height: 100%;
        model: root.options;
        enabled: root.enabled;
        // Initial value only; the changed handler above keeps the sync.
        current-index: root.current-index;
        selected(value) => {
            root.pick(base.current-index);
        }
        show-popup => {
            root.popup-hover-index = base.current-index;
            popup.show();
        }
        close-popup => {
            root.popup-hover-index = -1;
            popup.close();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 1px;
        width: root.width;
        height: min(root.options.length, root.max-visible-items) * root.item-height + 4px;
        close-policy: close-on-click-outside;
        forward-focus: popup-fs;

        Rectangle {
            background: Theme.surface;
            border-color: Theme.border-strong;
            border-width: 1px;
            border-radius: Theme.radius-sm;
            clip: true;

            popup-fs := FocusScope {
                changed has-focus => {
                    base.popup-has-focus = self.has-focus;
                }
                key-pressed(event) => {
                    return base.popup-key-handler(event);
                }
            }

            ScrollView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: max(self.visible-height, root.options.length * root.item-height + 2px);
                content-y: -max(0px, min(self.content-height - self.visible-height, (base.current-index - 3) * root.item-height));
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    alignment: start;
                    padding: 1px;

                    for option[index] in root.options : Rectangle {
                        height: root.item-height;
                        horizontal-stretch: 1;
                        background: root.popup-hover-index == index ? Theme.hover
                            : index == base.current-index ? Theme.accent-soft : transparent;
                        Text {
                            x: 10px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: option;
                            color: index == base.current-index ? Theme.accent-deep : Theme.text;
                            font-size: Theme.font-md;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        item-touch := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if self.has-hover {
                                    root.popup-hover-index = index;
                                }
                            }
                            moved => {
                                root.popup-hover-index = index;
                            }
                            clicked => {
                                base.select(index);
                                root.pick(index);
                                root.popup-hover-index = -1;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// Label above a dropdown, matching FormField's vertical rhythm so the two
// can share one grid row.
component FormCombo inherits VerticalLayout {
    in property <string> label;
    in property <[string]> items;
    // Optional internal values parallel to `items`, for localized labels over
    // enum-like drafts ("" maps to the "default" label). Empty means the
    // labels themselves are the stored values.
    in property <[string]> values: [];
    in-out property <string> value;
    // Locked forms (cloud model entries) disable the dropdown without
    // hiding the current selection.
    in property <bool> enabled: true;
    callback selected(string);
    spacing: 7px;
    property <[string]> raws: root.values.length == root.items.length ? root.values : root.items;
    function label-for(raw: string) -> string {
        let index = root.raws.index-of(raw);
        return index >= 0 && index < root.items.length ? root.items[index] : raw;
    }
    function raw-at(index: int) -> string {
        return index >= 0 && index < root.raws.length ? root.raws[index] : root.value;
    }
    // Row index of the stored value; -1 when the value is not in the list
    // (e.g. a provider outside the presets), which shows no highlight.
    property <int> value-index: root.raws.index-of(root.value);
    Text { height: 18px; text: root.label; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
    ThemeComboBox {
        height: 36px;
        options: root.items;
        current-index: root.value-index;
        enabled: root.enabled;
        text: root.label-for(root.value);
        pick(index) => {
            let raw = root.raw-at(index);
            if root.value != raw {
                root.value = raw;
            }
            // Read the (possibly updated) property rather than reusing `raw`:
            // the Slint codegen moves the local string into `value` and would
            // then borrow it again here ("borrow of moved value").
            root.selected(root.value);
        }
    }
}

// Web settings row: label (+ optional note) on the left, controls on the
// right, 1px bottom divider unless `last`.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> note: "";
    // Optional muted glyph ahead of the labels (web settings row icon).
    in property <image> row-icon;
    in property <bool> last: false;
    height: row.preferred-height + (root.last ? 0px : 1px);
    row := HorizontalLayout {
        padding-top: 12px; padding-bottom: 12px; spacing: 12px;
        if root.row-icon.width > 0 : VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.row-icon; colorize: Theme.muted; }
        }
        VerticalLayout {
            horizontal-stretch: 1; spacing: 3px;
            Text { text: root.label; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
            if root.note != "" : Text { text: root.note; color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
        }
        @children
    }
    if !root.last : Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

// One 主题模式 tile: a mini chat mock painted in that palette with its name
// below. The palette colours are passed in explicitly so an unselected tile
// still previews its own accent; they match `Theme` and the web `base.css`.
component ThemeTile inherits Rectangle {
    in property <string> palette;
    in property <string> name;
    in property <color> accent;
    in property <color> tint;
    in property <bool> active: false;
    callback picked(string);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: 110px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.active ? root.accent : Theme.border;
    background: Theme.surface;
    mock := Rectangle {
        x: 10px; y: 10px; width: parent.width - 20px; height: 68px;
        border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.border;
        background: root.tint;
        Rectangle { x: 12px; y: 12px; width: parent.width * 0.46; height: 7px; border-radius: 3.5px; background: root.accent; }
        Rectangle { x: 12px; y: 25px; width: parent.width * 0.3; height: 5px; border-radius: 2.5px; background: #DCD8D2; }
        // The avatar ring is the selection mark, as on the web card.
        Rectangle { x: parent.width - 27px; y: 9px; width: 15px; height: 15px;
            border-radius: 7.5px; background: Theme.surface;
            border-width: root.active ? 4px : 1px;
            border-color: root.active ? root.accent : Theme.border-strong; }
        Rectangle { x: 12px; y: 34px; width: parent.width - 24px; height: 24px;
            border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
            Rectangle { x: 8px; y: 7px; width: parent.width * 0.55; height: 4px; border-radius: 2px; background: #D8D4CE; }
            Rectangle { x: 8px; y: 15px; width: parent.width * 0.33; height: 4px; border-radius: 2px; background: #D8D4CE; }
        }
    }
    Text { y: 86px; width: parent.width; height: 16px; text: root.name;
        color: Theme.text; font-size: Theme.font-sm; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    TouchArea { mouse-cursor: pointer; clicked => { root.picked(root.palette); } }
}

// 主题模式 block: the SettingRow rhythm, but the four tiles take the full
// width under the label, as on the web card.
export component ThemeModeRow inherits Rectangle {
    in property <string> label;
    in property <string> note: "";
    in property <string> theme;
    in property <bool> last: false;
    callback picked(string);
    height: body.preferred-height + (root.last ? 0px : 1px);
    body := VerticalLayout {
        padding-top: 12px; padding-bottom: 12px; spacing: 12px;
        VerticalLayout { spacing: 3px;
            Text { text: root.label; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
            if root.note != "" : Text { text: root.note; color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
        }
        HorizontalLayout { spacing: 12px;
            // The tint is each palette's `Theme.accent-soft`, the tone the
            // shell actually paints on bubbles and badges; the page base stays
            // neutral in every palette by design.
            ThemeTile { palette: "forest"; name: I18n.st_theme_forest; accent: #2f7a5c; tint: #e9f2ee;
                active: root.theme == "forest"; picked(name) => { root.picked(name); } }
            ThemeTile { palette: "hula-green"; name: I18n.st_theme_mint; accent: #16ad8d; tint: #e7f7f2;
                active: root.theme == "hula-green"; picked(name) => { root.picked(name); } }
            ThemeTile { palette: "honey"; name: I18n.st_theme_honey; accent: #c08a2a; tint: #f8f0dd;
                active: root.theme == "honey"; picked(name) => { root.picked(name); } }
            ThemeTile { palette: "terracotta"; name: I18n.st_theme_parchment; accent: #f58a24; tint: #fdf0de;
                active: root.theme == "terracotta"; picked(name) => { root.picked(name); } }
        }
    }
    if !root.last : Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

// Settings shell (§9): an 11-category navigation on the left and the selected
// category's cards on the right. It replaces the old five-tab entity page; the
// per-category panels below reuse the existing native callbacks unchanged.
export component SettingsPage inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <[ModelCard]> models;
    in property <int> selected-model: -1;
    in property <ModelCard> selected-card;
    callback delete-model(string);
    in-out property <string> workspace-root;
    in-out property <string> language;
    in-out property <string> python-path;
    in-out property <string> git-path;
    in-out property <string> rg-path;
    in property <string> python-status;
    in property <string> git-status;
    in property <string> rg-status;
    in-out property <bool> importing-supplement: false;
    in-out property <string> supplement-status;
    callback import-supplement();
    callback pick-python-path();
    callback pick-git-path();
    callback pick-rg-path();
    // ---- 线程渲染压测：用户手动触发，写入本地库模拟线程 ----
    in-out property <bool> stress-running: false;
    in-out property <string> stress-user-rounds: "1000";
    in-out property <string> stress-model-rounds: "1000";
    in-out property <string> stress-count: "1";
    in-out property <string> stress-status;
    callback generate-stress-thread();
    // ---- cloud account (§6.1) ----
    // Login state, quota snapshot and the drafts are wired two-way to the
    // shell; the native side owns every cloud call and pushes results back.
    in-out property <bool> cloud-logged-in: false;
    in-out property <bool> cloud-inbound-enabled: false;
    in-out property <bool> cloud-full-shadow: false;
    callback cloud-toggle-sharing(bool, bool);
    in-out property <bool> cloud-expired: false;
    in-out property <string> cloud-username;
    in-out property <string> cloud-balance;
    in-out property <string> cloud-concurrency;
    in-out property <bool> cloud-quota-warn: false;
    in-out property <bool> cloud-sync-enabled: true;
    in-out property <bool> cloud-busy: false;
    in-out property <string> cloud-error;
    in-out property <string> cloud-server-draft;
    in-out property <string> cloud-user-draft;
    in-out property <string> cloud-pass-draft;
    callback cloud-password-edited(string);
    // Engine connection machine (`online|reconnecting|expired|logged_out`);
    // the relative-time strings are pre-formatted natively in Chinese.
    in-out property <string> cloud-connection;
    in-out property <string> cloud-last-error;
    in-out property <string> cloud-last-success;
    in-out property <string> cloud-next-retry;
    callback cloud-login();
    callback cloud-logout();
    callback cloud-refresh-account();
    callback open-wunder-model();
    callback cloud-toggle-sync(bool);
    // Engine-managed cloud entries (`cloud/<id>`): the editor locks them and
    // removes the delete shortcut; logout clears them in one go. Guards
    // against the new-model draft inheriting a previously selected cloud key.
    property <bool> cloud-locked: root.selected-key.starts-with("cloud/") && !root.model-creating;
    // Status row projection: dot color and copy per engine connection state.
    property <color> cloud-dot-color: root.cloud-connection == "online" ? Theme.success
        : root.cloud-connection == "reconnecting" ? Theme.warning
        : root.cloud-connection == "expired" ? Theme.danger
        : Theme.muted;
    property <string> cloud-state-text: root.cloud-connection == "online" ? I18n.st_cl_connected
        : root.cloud-connection == "reconnecting" ? I18n.st_cl_reconnecting
        : root.cloud-connection == "expired" ? I18n.st_cl_expired
        : I18n.st_cl_logged_out;
    in property <string> selected-key;
    in property <string> selected-provider;
    in property <string> selected-model-name;
    in property <string> selected-base-url;
    in property <string> selected-type;
    in property <bool> selected-is-default;
    in property <string> model-editor-provider;
    in property <string> model-editor-name;
    in property <string> model-editor-base-url;
    in property <string> model-editor-type;
    in property <bool> model-editor-is-default;
    callback select-model(int);
    callback create-model();
    callback discard-model-draft();
    // Commits the unsaved new-model draft. Creation never auto-saves: the
    // config name stays editable until this runs.
    callback save-model();
    // Renames the selected model. The config key is an identity, so it commits
    // on Enter/focus loss instead of every keystroke.
    callback commit-model-key();
    callback move-model(int, int);
    callback set-default-model(string);
    // The models tab edits the selected model in place: every editor draft
    // lives here and is wired two-way to the shell by main.slint.
    in-out property <bool> model-creating: false;
    in property <string> model-save-error;
    in-out property <string> model-key-draft;
    in-out property <string> model-provider-draft;
    in-out property <string> model-name-draft;
    in-out property <string> model-base-url-draft;
    in-out property <string> model-token-draft;
    in-out property <string> model-type-draft: "llm";
    in-out property <string> model-temperature-draft;
    in-out property <string> model-timeout-draft;
    in-out property <string> model-max-output-draft;
    in-out property <string> model-thinking-budget-draft;
    in-out property <string> model-max-rounds-draft;
    in-out property <string> model-max-context-draft;
    in-out property <string> model-history-compaction-ratio-draft;
    in-out property <string> model-reasoning-effort-draft;
    in-out property <string> model-simulation-speed-draft;
    in-out property <bool> model-support-vision-draft;
    in-out property <bool> model-support-hearing-draft;
    in-out property <bool> model-stream-include-usage-draft;
    in-out property <string> model-tool-call-mode-draft;
    in-out property <string> model-tts-voice-draft;
    in-out property <string> model-tts-format-draft;
    in-out property <string> model-tts-speed-draft;
    in-out property <string> model-tts-instructions-draft;
    in-out property <string> model-asr-language-draft;
    in-out property <string> model-asr-format-draft;
    in-out property <string> model-asr-temperature-draft;
    in-out property <string> model-asr-prompt-draft;
    in-out property <string> model-image-size-draft;
    in-out property <string> model-image-format-draft;
    in-out property <string> model-image-steps-draft;
    in-out property <string> model-image-guidance-draft;
    in-out property <string> model-image-negative-draft;
    in-out property <string> model-video-size-draft;
    in-out property <string> model-video-seconds-draft;
    in-out property <string> model-video-fps-draft;
    in-out property <string> model-video-num-frames-draft;
    in-out property <string> model-video-negative-draft;
    in-out property <string> model-video-steps-draft;
    in-out property <string> model-video-guidance-scale-draft;
    in-out property <string> model-video-guidance-scale-2-draft;
    in-out property <string> model-video-boundary-ratio-draft;
    in-out property <string> model-video-flow-shift-draft;
    in-out property <bool> model-video-frame-interpolation-draft;
    in-out property <bool> model-video-sync-mode-draft;
    in property <[string]> model-provider-presets;
    in property <[string]> model-type-presets;
    in property <[string]> virtual-replay-logs;
    callback probe-model-context();
    callback probe-model-voices();
    callback refresh();
    callback save-runtime();
    callback save-preferences();
    callback refresh-prompt-packs();
    callback select-prompt-pack(string);
    callback save-prompt-segment();
    callback create-prompt-pack();
    callback delete-prompt-pack();
    callback set-active-prompt-pack();
    callback refresh-prompt-preview();
    in-out property <string> theme;
    in-out property <string> send-key;
    in-out property <float> font-size: 14;
    in property <[PromptPackCard]> prompt-packs;
    in property <[string]> prompt-pack-names;
    in property <string> prompt-active;
    in-out property <string> selected-pack;
    in-out property <int> selected-segment: 0;
    in-out property <string> prompt-draft;
    in property <bool> prompt-readonly;
    in property <bool> prompt-loading: false;
    in-out property <string> pack-name-draft;
    in property <string> prompt-preview;
    in property <bool> prompt-preview-loading: false;
    in property <string> status;
    // Tab ids are stable labels, not list positions: 0 general, 13 account,
    // 1 models, 2 tools, 3 agent, 4 companion, 5 scheduled tasks, 6 memories,
    // 7 channels, 9 prompt packs, 10 archived threads. Help lives on a button
    // in the general category and opens its own window, so it is not a
    // category. The navigation lists them in the web messenger's category
    // order: general, account, models, tools, agent, companion, cron, memory,
    // channels, prompts and archived threads.
    in-out property <int> settings-tab: 0;
    // Category filter typed into the navigation search box. Slint 1.18 strings
    // have no substring test, so the filter runs natively and the matching
    // categories come back as a bit set (bit N = category N).
    in-out property <string> settings-query: "";
    // One flag per category, in navigation order (11 categories). Slint 1.18 has
    // no bitwise operators, so the native search projection ships booleans rather
    // than a mask; an all-true list means "no query". Index = nav position, not
    // tab id.
    in-out property <[bool]> settings-category-flags: [true, true, true, true, true, true, true, true, true, true, true];
    out property <bool> settings-has-matches: root.count-visible() > 0;
    out property <int> settings-visible-count: root.count-visible();    // How many categories the current query keeps; the empty state and the test
    // projections both read this instead of re-deriving the flags.
    pure function count-visible() -> int {
        return (root.settings-category-flags[0] ? 1 : 0)
            + (root.settings-category-flags[1] ? 1 : 0)
            + (root.settings-category-flags[2] ? 1 : 0)
            + (root.settings-category-flags[3] ? 1 : 0)
            + (root.settings-category-flags[4] ? 1 : 0)
            + (root.settings-category-flags[5] ? 1 : 0)
            + (root.settings-category-flags[6] ? 1 : 0)
            + (root.settings-category-flags[7] ? 1 : 0)
            + (root.settings-category-flags[8] ? 1 : 0)
            + (root.settings-category-flags[9] ? 1 : 0)
            + (root.settings-category-flags[10] ? 1 : 0);
    }
    // Slint cannot test a substring, so the query is projected out and the
    // matching categories come back as a bit set.
    changed settings-query => { root.settings-search(root.settings-query); }
    callback settings-search(string);
    // Help moved out of the category list: the general page's button opens a
    // standalone help window owned by the native side.
    callback open-help();
    // ---- embedded category state -------------------------------------------
    // The heavy surfaces own their own components; the shell only forwards
    // state and callbacks, so their logic stays in one place.
    in-out property <string> tool-manager-status;
    in-out property <bool> tools-loading: false;
    in-out property <bool> tools-working: false;
    in-out property <int> tools-tab: 0;
    in-out property <int> tools-selected: -1;
    in-out property <[ToolCard]> tools-builtin;
    in-out property <[ToolCard]> tools-mcp;
    in-out property <[ToolCard]> tools-skills;
    in-out property <[ToolCard]> tools-knowledge;
    in-out property <[ToolResource]> tools-servers;
    in-out property <[ToolResource]> tools-skill-resources;
    in-out property <[ToolResource]> tools-bases;
    in-out property <[ToolCard]> tools-server-tools;
    in-out property <[FileCard]> tools-files;
    in property <[WorkspaceFileRow]> tools-file-rows;
    in-out property <string> tools-search;
    in-out property <string> tools-file-path;
    in-out property <string> tools-content;
    in-out property <string> tools-directory;
    in-out property <bool> tools-has-more;
    callback refresh-tools();
    callback select-tool-resource(int, int);
    callback open-tool-file(string, bool);
    callback more-tool-files();
    callback search-tool-files(string);
    callback tool-manager-action(string, string, string);

    in-out property <bool> cron-loading: false;
    in-out property <[CronCard]> cron-jobs;
    in-out property <int> cron-selected: -1;
    in-out property <[string]> cron-workspace-names: [];
    in-out property <bool> cron-editor-open: false;
    in-out property <bool> cron-editor-saving: false;
    in-out property <int> cron-edit-kind: 0;
    in-out property <string> cron-edit-name;
    in-out property <string> cron-edit-at;
    in-out property <string> cron-edit-every;
    in-out property <int> cron-edit-interval-unit: 0;
    in-out property <string> cron-edit-cron;
    in-out property <string> cron-edit-tz;
    in-out property <string> cron-edit-message;
    in-out property <int> cron-edit-workspace: -1;
    in-out property <bool> cron-edit-delete-after: false;
    in-out property <bool> cron-edit-enabled: true;
    in-out property <bool> cron-runs-open: false;
    in-out property <bool> cron-runs-loading: false;
    in-out property <string> cron-runs-title;
    in-out property <[CronRunCard]> cron-runs;
    callback refresh-cron();
    callback toggle-cron(string, bool);
    callback delete-cron(string);
    callback run-cron-now(string);
    callback open-cron-runs(string);
    callback close-cron-runs();
    callback open-cron-creator();
    callback edit-cron-job(string);
    callback save-cron-editor();
    callback cancel-cron-editor();

    in-out property <bool> channel-loading: false;
    in-out property <[ChannelCatalogCard]> channel-catalog;
    in-out property <[ChannelAccountCard]> channel-accounts;
    in-out property <int> selected-channel-account: -1;
    in-out property <[ChannelBindingCard]> channel-bindings;
    in-out property <bool> channel-bindings-loading: false;
    in-out property <bool> channel-logs-loading: false;
    in-out property <[ChannelLogCard]> channel-logs;
    in-out property <bool> channel-editor-open: false;
    in-out property <bool> channel-editor-saving: false;
    in-out property <string> channel-edit-id;
    in-out property <int> channel-edit-kind: 0;
    in-out property <int> channel-edit-agent: 0;
    in-out property <[string]> channel-agent-names: [I18n.common_default_agent];
    in-out property <[string]> channel-catalog-names;
    in-out property <string> channel-edit-name;
    in-out property <bool> channel-edit-enabled: true;
    in-out property <bool> channel-edit-group-chat: true;
    in-out property <string> channel-edit-app-id;
    in-out property <string> channel-edit-app-secret;
    in-out property <string> channel-edit-corp-id;
    in-out property <string> channel-edit-wechat-agent;
    in-out property <string> channel-edit-secret;
    in-out property <string> channel-edit-token;
    in-out property <string> channel-edit-aes-key;
    in-out property <string> channel-edit-original-id;
    in-out property <string> channel-edit-api-base;
    in-out property <string> channel-edit-bot-token;
    in-out property <string> channel-edit-bot-id;
    in-out property <string> channel-edit-user-id;
    in-out property <string> channel-edit-domain;
    in-out property <string> channel-edit-config-json;
    in-out property <bool> channel-delete-open: false;
    in-out property <bool> channel-qr-open: false;
    in-out property <int> channel-qr-state: 0;
    in-out property <image> channel-qr-image;
    in-out property <string> channel-qr-message;
    callback refresh-channels();
    callback select-channel-account(int);
    callback open-channel-creator();
    callback edit-channel-account();
    callback save-channel-editor();
    callback cancel-channel-editor();
    callback request-delete-channel();
    callback confirm-delete-channel();
    callback cancel-delete-channel();
