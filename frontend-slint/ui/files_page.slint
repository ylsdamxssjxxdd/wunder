import { Theme, FileCard } from "theme.slint";
import { Action, SearchField } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// A full workspace page and the chat dock intentionally share the same
// NativeDesktop workspace projection. The page only navigates relative paths;
// path confinement remains in the native façade.
export component FilesPage inherits Rectangle {
    in property <bool> loading: false;
    in property <string> error;
    in property <string> directory-path;
    in property <string> directory-parent;
    in property <string> directory-root;
    in property <int> directory-container-id: 1;
    in property <int> offset: 0;
    in property <int> total: 0;
    in property <[FileCard]> files;
    callback refresh();
    callback navigate(string);
    callback open-file(string);
    callback open-native(string);
    callback create-file(string, string);
    callback workspace-action(string, string, string);
    callback open-workspace-binding();
    callback previous-page();
    callback next-page();
    private property <string> keyword;
    private property <bool> new-file-open: false;
    private property <string> selected-path;
    private property <string> selected-name;
    private property <string> action-kind;
    private property <string> action-value;
    private property <bool> action-open: false;
    background: Theme.chat;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 76px; background: Theme.surface; border-width: 0px; border-color: transparent;
            HorizontalLayout {
                padding: 18px; spacing: 12px;
                Image { width: 24px; height: 24px; source: @image-url("../assets/icons/folder-open.svg"); colorize: Theme.accent-deep; }
                VerticalLayout {
                    spacing: 1px;
                    Text { height: 25px; text: "文件工作区"; color: Theme.text; font-size: 18px; font-weight: 700; }
                    Text { height: 17px; text: "容器 #" + root.directory-container-id + " · " + (root.directory-root == "" ? "正在加载本地目录" : root.directory-root); color: Theme.muted; font-size: 11px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                Action { width: 34px; icon: @image-url("../assets/icons/folder-open.svg"); label: "切换目录"; enabled: !root.loading; clicked => { root.open-workspace-binding(); } }
                Action { width: 34px; icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.loading; clicked => { root.refresh(); } }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            padding: 16px; spacing: 14px; vertical-stretch: 1;
            Rectangle {
                width: min(260px, parent.width * 0.32); border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                VerticalLayout {
                    padding: 12px; spacing: 9px;
                    Text { height: 22px; text: "位置"; color: Theme.text; font-size: 13px; font-weight: 600; }
                    Action { height: 32px; width: parent.width; icon: @image-url("../assets/icons/arrow-up.svg"); label: "上一级"; show-label: true; enabled: !root.loading && root.directory-path != ""; clicked => { root.navigate(root.directory-parent); } }
                    Rectangle { height: 1px; background: Theme.border; }
                    Text { height: 18px; text: "当前目录"; color: Theme.muted; font-size: 10px; }
                    Text { height: 42px; text: root.directory-path == "" ? "工作区根目录" : root.directory-path; color: Theme.text; font-size: 12px; wrap: word-wrap; overflow: elide; }
                    Rectangle { vertical-stretch: 1; }
                    Text { height: 32px; text: "文件访问受当前容器根目录限制。"; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                }
            }
            Rectangle {
                horizontal-stretch: 1; border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    HorizontalLayout {
                        height: 34px; spacing: 8px;
                        SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索当前目录"; text <=> root.keyword; }
                        Action { width: 36px; icon: @image-url("../assets/icons/plus.svg"); label: "新建文件"; enabled: !root.loading; clicked => { root.new-file-open = !root.new-file-open; } }
                    }
                    if root.new-file-open : Rectangle {
                        height: 38px; border-radius: 8px; background: Theme.accent-soft;
                        HorizontalLayout { padding: 4px; spacing: 4px;
                            for option in [{kind: "directory", label: "目录"}, {kind: "text", label: "文本"}, {kind: "markdown", label: "Markdown"}, {kind: "word", label: "Word"}, {kind: "sheet", label: "表格"}, {kind: "slides", label: "演示"}, {kind: "flowchart", label: "流程图"}] : Action { horizontal-stretch: 1; height: 28px; label: option.label; show-label: true; clicked => { root.new-file-open = false; root.create-file(option.kind, root.directory-path); } }
                        }
                    }
                    if root.error != "" : Rectangle { height: 42px; border-radius: 8px; background: #fff0ed; Text { x: 10px; width: parent.width - 20px; height: parent.height; text: root.error; color: #b63a22; font-size: 11px; vertical-alignment: center; overflow: elide; } }
                    ScrollView {
                        vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                        VerticalLayout { alignment: start; spacing: 4px;
                            for file in root.files : Rectangle {
                                visible: root.keyword == "" || file.name.to-lowercase().starts-with(root.keyword.to-lowercase());
                                height: self.visible ? 46px : 0px; border-radius: 8px; background: Theme.panel;
                                Action { width: parent.width; height: parent.height; label: file.name; clicked => { root.open-file(file.path); } }
                                Image { x: 10px; y: 14px; width: 17px; height: 17px; source: file.entry-type == "dir" ? @image-url("../assets/icons/folder-open.svg") : @image-url("../assets/icons/file-lines.svg"); colorize: file.entry-type == "dir" ? Theme.accent-deep : Theme.muted; }
                                Text { x: 38px; width: parent.width - 152px; height: parent.height; text: file.name; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                Text { x: parent.width - 106px; width: 58px; height: parent.height; text: file.entry-type == "dir" ? "目录" : file.size; color: Theme.muted; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
                                Action { x: parent.width - 42px; y: 8px; width: 30px; height: 30px; icon: @image-url("../assets/icons/ellipsis.svg"); label: "文件操作"; clicked => { root.selected-path = file.path; root.selected-name = file.name; root.action-kind = "menu"; root.action-open = true; } }
                            }
                            if root.files.length == 0 : Text { height: 80px; text: root.loading ? "正在读取文件…" : "当前目录没有文件"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        height: 30px; spacing: 7px;
                        Text { width: 120px; text: root.loading ? "正在读取…" : "共 " + root.total + " 项"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Action { width: 54px; label: "上一页"; show-label: true; enabled: !root.loading && root.offset > 0; clicked => { root.previous-page(); } }
                        Action { width: 54px; label: "下一页"; show-label: true; enabled: !root.loading && root.offset + root.files.length < root.total; clicked => { root.next-page(); } }
                    }
                }
            }
        }
    }
    if root.action-open : Rectangle {
        background: #00000040;
        TouchArea { clicked => { root.action-open = false; } }
        Rectangle {
            width: root.action-kind == "menu" ? min(300px, parent.width - 44px) : min(430px, parent.width - 44px);
            height: root.action-kind == "menu" ? 286px : (root.action-kind == "delete" ? 178px : 224px);
            border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 18px; spacing: 9px;
                Text { height: 24px; text: root.action-kind == "menu" ? root.selected-name : (root.action-kind == "delete" ? "确认删除" : root.action-kind == "rename" ? "重命名" : root.action-kind == "copy" ? "复制到" : "移动到"); color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                if root.action-kind == "menu" : VerticalLayout { spacing: 4px;
                    Action { width: parent.width; height: 32px; label: "使用系统程序打开"; show-label: true; clicked => { root.action-open = false; root.open-native(root.selected-path); } }
                    Action { width: parent.width; height: 32px; label: "重命名"; show-label: true; clicked => { root.action-kind = "rename"; root.action-value = root.selected-name; } }
                    Action { width: parent.width; height: 32px; label: "复制"; show-label: true; clicked => { root.action-kind = "copy"; root.action-value = root.selected-path + ".copy"; } }
                    Action { width: parent.width; height: 32px; label: "移动"; show-label: true; clicked => { root.action-kind = "move"; root.action-value = root.selected-path; } }
                    Action { width: parent.width; height: 32px; label: "删除"; show-label: true; clicked => { root.action-kind = "delete"; } }
                }
                if root.action-kind == "delete" : Text { height: 50px; text: "将永久删除“" + root.selected-name + "”。此操作无法恢复。"; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.action-kind != "menu" && root.action-kind != "delete" : Rectangle { height: 72px; VerticalLayout { spacing: 4px; Text { height: 18px; text: root.action-kind == "rename" ? "新名称" : "目标相对路径"; color: Theme.muted; font-size: 11px; } TextInput { height: 34px; text <=> root.action-value; color: Theme.text; font-size: 13px; } } }
                Rectangle { vertical-stretch: 1; }
                if root.action-kind != "menu" : HorizontalLayout { height: 32px; spacing: 8px; Rectangle { horizontal-stretch: 1; } Action { label: "取消"; show-label: true; clicked => { root.action-open = false; } } Action { width: 76px; label: root.action-kind == "delete" ? "删除" : "确认"; show-label: true; primary: true; enabled: root.action-kind == "delete" || root.action-value != ""; clicked => { root.workspace-action(root.action-kind, root.selected-path, root.action-value); root.action-open = false; } } }
            }
        }
    }
}
