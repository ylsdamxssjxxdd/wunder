import { Theme, ChatMessage } from "theme.slint";
import { Action, Avatar } from "components.slint";

component MessageStat inherits HorizontalLayout {
    in property <image> icon;
    in property <string> value;
    visible: root.value != "";
    width: self.preferred-width;
    height: 16px;
    spacing: 3px;
    Image { width: 11px; height: 11px; source: root.icon; image-fit: contain; colorize: Theme.muted; }
    Text { text: root.value; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
}

export component MessageRow inherits Rectangle {
    in property <ChatMessage> message;
    in property <string> author;
    in property <image> avatar;
    in-out property <bool> expanded: false;
    private property <bool> stats-visible: !root.message.mine && (root.message.stats-status != "" || root.message.stats-duration != "" || root.message.stats-speed != "" || root.message.stats-context != "" || root.message.stats-quota != "" || root.message.stats-tools != "" || root.message.stats-credits != "");
    callback copy();
    private property <length> bubble-width: root.message.mine ? min(root.width - 58px, max(180px, root.width * 0.8)) : root.width - 58px;
    height: column.height + 22px;
    Avatar { x: root.message.mine ? parent.width - 34px : 0px; y: 0px; mine: root.message.mine; source: root.avatar; glyph: root.message.avatar-glyph; tone: root.message.avatar-tone; }
    column := VerticalLayout {
        x: root.message.mine ? root.width - 44px - root.bubble-width : 44px;
        width: root.bubble-width;
        height: self.preferred-height;
        spacing: 6px;
        Text {
            height: 16px; font-size: 11px; color: Theme.muted;
            text: (root.message.mine ? "你" : root.author) + "   " + root.message.time;
            horizontal-alignment: root.message.mine ? right : left;
        }
        if root.message.workflow : Rectangle {
            height: root.expanded ? 92px : 34px;
            border-radius: 8px; border-width: 1px; border-color: Theme.border;
            background: Theme.surface.transparentize(0.35);
            Action {
                x: 4px; y: 2px; width: parent.width - 8px; label: "智能体循环 · 2 个步骤"; show-label: true;
                icon: @image-url("../assets/icons/chevron-right.svg");
                clicked => { root.expanded = !root.expanded; }
            }
            if root.expanded : Text {
                x: 16px; y: 40px; width: parent.width - 32px; height: 40px;
                text: "1. 读取文件    已完成\n2. 整理内容    已完成";
                font-size: 12px; color: Theme.muted;
            }
        }
        Rectangle {
            height: body.preferred-height + 24px;
            background: root.message.mine ? Theme.mine : Theme.bubble;
            border-radius: 12px; border-color: root.message.mine ? Theme.accent.transparentize(0.7) : Theme.border; border-width: 1px;
            body := VerticalLayout {
                x: 13px; y: 12px; width: parent.width - 26px;
                height: self.preferred-height; spacing: 0px;
                if root.message.blocks.length == 0 : TextInput {
                    text: root.message.text; color: Theme.text; font-size: 13px;
                    read-only: true; wrap: word-wrap;
                }
                for block in root.message.blocks : Rectangle {
                    height: block-text.preferred-height;
                    background: block.kind == 1 ? Theme.accent-soft : transparent;
                    block-text := TextInput {
                        width: parent.width; text: block.text; color: Theme.text; font-size: 13px;
                        font-weight: block.kind == 2 ? 600 : 400;
                        read-only: true; wrap: word-wrap;
                    }
                }
            }
        }
        HorizontalLayout {
            height: root.message.mine ? 20px : (root.stats-visible ? 38px : 20px); spacing: 6px;
            if !root.message.mine : HorizontalLayout {
                y: 0px; height: 16px; spacing: 8px;
                stats-row := HorizontalLayout {
                    height: 16px; spacing: 8px;
                    MessageStat { icon: @image-url("../assets/icons/comment-dots.svg"); value: root.message.stats-status; }
                    MessageStat { icon: @image-url("../assets/icons/clock-rotate-left.svg"); value: root.message.stats-duration; }
                    MessageStat { icon: @image-url("../assets/icons/comments.svg"); value: root.message.stats-speed; }
                    MessageStat { icon: @image-url("../assets/icons/brain.svg"); value: root.message.stats-context; }
                    MessageStat { icon: @image-url("../assets/icons/arrow-up.svg"); value: root.message.stats-quota; }
                    MessageStat { icon: @image-url("../assets/icons/list-check.svg"); value: root.message.stats-tools; }
                    MessageStat { icon: @image-url("../assets/icons/cubes.svg"); value: root.message.stats-credits; }
                }
            }
            Text { y: root.message.mine ? 0px : 18px; text: root.message.state; font-size: 10px; color: Theme.muted; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            Action { y: root.message.mine ? 0px : 18px; width: 42px; height: 20px; label: "复制"; show-label: true; clicked => { root.copy(); } }
        }
    }
}
