// Values mirror frontend/src/styles/base.css and messenger.css (eva-orange).
export global Theme {
    out property <color> text: #32170a;
    out property <color> muted: #8d6248;
    out property <color> panel: #fffaf6;
    out property <color> surface: #ffffff;
    out property <color> border: #f0dfd2;
    out property <color> accent: #ff9448;
    out property <color> accent-deep: #e5792e;
    out property <color> accent-soft: #fff0e3;
    out property <color> bubble: #ffffff;
    out property <color> mine: #ffe9d7;
    out property <brush> rail: @linear-gradient(180deg, #ffb26f 0%, #e5792e 100%);
    out property <brush> middle: @linear-gradient(180deg, #fffaf6 0%, #fff6ef 100%);
    out property <brush> chat: @linear-gradient(180deg, #fffbf8 0%, #fff2e8 100%);
    out property <brush> dock: @linear-gradient(180deg, #fff8f3 0%, #fff0e5 100%);
    out property <brush> composer: @linear-gradient(180deg, #fff8f3 0%, #fff2e9 100%);
}
export struct Conversation { id: string, title: string, preview: string, time: string, consumed-tokens: string, tool-calls: string, quota-used: string, runtime-status: string, locked: bool }
export struct ThreadLogEvent { event-type: string, time: string, summary: string, raw: string }
export struct TextBlock { text: string, kind: int }
// Message statistics are kept as already formatted strings. Formatting stays
// in the native projection so the Slint thread only lays out a small, stable
// row while a stream is active.
export struct ChatMessage {
    text: string,
    mine: bool,
    time: string,
    workflow: bool,
    workflow-detail: string,
    state: string,
    stats-status: string,
    stats-duration: string,
    stats-speed: string,
    stats-context: string,
    stats-quota: string,
    stats-tools: string,
    stats-credits: string,
    blocks: [TextBlock],
    avatar-glyph: string,
    avatar-tone: int
}

export struct ChatTurn { root-id: string, user: ChatMessage, assistant: ChatMessage }

// Stable desktop navigation identifiers. Keep presentation pages independent
// from their position in the rail so deep links and native controllers never
// rely on an integer slot.
export enum DesktopPage { messages, agents, tools, settings, profile, files, users, groups, cron, channels, plaza }
// Screenshot attachment state remains in the UI projection until send. The
// data URL is forwarded through the native Rust façade without an HTTP hop.
export struct ChatAttachment { name: string, mime-type: string, data-url: string }
export struct FileCard { name: string, path: string, entry-type: string, size: string }
export struct WorldContactCard { user-id: string, username: string, online: bool, preview: string, unread: int }
export struct WorldGroupCard { group-id: string, conversation-id: string, name: string, members: int, preview: string, unread: int }
export struct WorldMessageCard { content: string, mine: bool, sender: string }
export struct WorldPickRow { user-id: string, username: string, selected: bool }
export struct CronCard { id: string, name: string, enabled: bool, schedule: string, next-run: string, last-status: string, last-error: string }
export struct CronRunCard { run-id: string, status: string, trigger: string, summary: string, error: string, duration: string, created-at: string }
export struct AgentCardFile { path: string, label: string }
export struct PromptPackCard { id: string, readonly: bool, locale: string, is-active: bool, is-lang-default: bool }
// Channel projections stay secret-free: the runtime only sends `_set` flags
// and non-secret guided prefill values, never token or secret content.
export struct ChannelCatalogCard { channel: string, name: string, description: string }
export struct ChannelAccountCard { channel: string, account-id: string, name: string, status: string, active: bool, configured: bool, peer-kind: string, agent-id: string, created-at: string, updated-at: string, summary: string, secret-set: bool, app-id: string, corp-id: string, wechat-agent-id: string, original-id: string, weixin-bot-id: string, weixin-user-id: string, bot-type: string, domain: string }
export struct ChannelBindingCard { binding-id: string, peer-kind: string, peer-id: string, agent-id: string, enabled: bool }
export struct ChannelLogCard { time: string, level: string, event: string, message: string }
export struct PlazaItemCard { item-id: string, kind: string, title: string, summary: string, owner: string, mine: bool, freshness: string, artifact: string, size: string, tags: string, updated-at: string }
export struct AgentCard {
    id: string,
    name: string,
    description: string,
    model: string,
    system-prompt: string,
    status: string,
    icon-name: string,
    icon-color: string,
    icon-glyph: string,
    icon-tone: int,
    tool-count: int,
    tool-names: [string],
    preset-questions: [string],
    sandbox-container-id: int,
    approval-mode: string,
    preview-skill: bool,
    silent: bool,
    prefer-mother: bool,
    preset-question-count: int,
    is-shared: bool,
    group-name: string
}
export struct ToolCard { name: string, description: string, category: string, enabled: bool }
export struct ModelCard { key: string, provider: string, model: string, base-url: string, model-type: string, is-default: bool }
export struct ProfileCard { user-id: string, username: string, email: string, unit: string, unit-id: string, sessions: string, sessions-last-7d: string, tool-calls: string, tokens: string, agents: string, last-active: string, avatar-icon: string, avatar-glyph: string, avatar-color: string }
export struct LanPeerCard { peer-id: string, display-name: string, address: string }
