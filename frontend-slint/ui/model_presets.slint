// Provider presets mirrored from wunder-runtime PROVIDER_PRESETS so the model
// settings form can autofill endpoints without a runtime round-trip.
export global ModelPresets {
    out property <[string]> names: ["openai_compatible", "openai", "anthropic", "openrouter", "siliconflow", "deepseek", "moonshot", "qwen", "groq", "mistral", "together", "vllm_omni", "whisper_cpp", "ollama", "lmstudio"];
    public pure function base-url(name: string) -> string {
        name == "openai" ? "https://api.openai.com/v1" :
        name == "anthropic" ? "https://api.anthropic.com/v1" :
        name == "openrouter" ? "https://openrouter.ai/api/v1" :
        name == "siliconflow" ? "https://api.siliconflow.cn/v1" :
        name == "deepseek" ? "https://api.deepseek.com/v1" :
        name == "moonshot" ? "https://api.moonshot.cn/v1" :
        name == "qwen" ? "https://dashscope.aliyuncs.com/compatible-mode/v1" :
        name == "groq" ? "https://api.groq.com/openai/v1" :
        name == "mistral" ? "https://api.mistral.ai/v1" :
        name == "together" ? "https://api.together.xyz/v1" :
        name == "vllm_omni" ? "http://127.0.0.1:8000/v1" :
        name == "whisper_cpp" ? "http://127.0.0.1:8080/v1" :
        name == "ollama" ? "http://127.0.0.1:11434/v1" :
        name == "lmstudio" ? "http://127.0.0.1:1234/v1" : "";
    }
}
