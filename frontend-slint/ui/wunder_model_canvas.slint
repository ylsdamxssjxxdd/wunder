import { I18n } from "i18n.slint";
import { Theme } from "theme.slint";

export component WunderModelCanvas inherits Rectangle {
    in property <image> frame;
    in property <string> status;
    in property <bool> loading: true;
    in property <bool> failed: false;
    in property <bool> rotating: true;
    in property <bool> native-active: false;
    callback gesture(string, float, float);
    callback reset();
    callback retry();
    callback toggle-rotate();
    callback size-changed(int, int);
    callback geometry-changed(int, int, int, int);

    background: #eef2f7;
    clip: true;

    // Keep the software renderer at the same logical-pixel size as the
    // canvas. The native side clamps these values before allocating a frame.
    init => {
        root.size-changed((root.width / 1px).round(), (root.viewport-height / 1px).round());
        root.geometry-changed((self.window-x / 1px).round(), (self.window-y / 1px).round(), (self.width / 1px).round(), (self.viewport-height / 1px).round());
    }
    changed width => {
        root.size-changed((root.width / 1px).round(), (root.viewport-height / 1px).round());
        root.geometry-changed((self.window-x / 1px).round(), (self.window-y / 1px).round(), (self.width / 1px).round(), (self.viewport-height / 1px).round());
    }
    changed height => {
        root.size-changed((root.width / 1px).round(), (root.viewport-height / 1px).round());
        root.geometry-changed((self.window-x / 1px).round(), (self.window-y / 1px).round(), (self.width / 1px).round(), (self.viewport-height / 1px).round());
    }

    property <length> window-x: self.absolute-position.x;
    property <length> window-y: self.absolute-position.y;
    property <length> viewport-height: max(1px, root.height - 56px);
    changed window-x => { root.geometry-changed((self.window-x / 1px).round(), (self.window-y / 1px).round(), (self.width / 1px).round(), (self.viewport-height / 1px).round()); }
    changed window-y => { root.geometry-changed((self.window-x / 1px).round(), (self.window-y / 1px).round(), (self.width / 1px).round(), (self.viewport-height / 1px).round()); }

    Image {
        x: 0px; y: 0px; width: parent.width; height: root.viewport-height;
        source: root.frame;
        visible: !root.native-active;
        image-fit: fill;
    }

    TouchArea {
        width: parent.width; height: root.viewport-height;
        mouse-cursor: grabbing;
        private property <bool> dragging: false;
        private property <bool> panning: false;
        private property <float> last-x: 0;
        private property <float> last-y: 0;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.dragging = true;
                self.panning = event.button == PointerEventButton.right;
                self.last-x = self.mouse-x / 1px;
                self.last-y = self.mouse-y / 1px;
            } else if event.kind == PointerEventKind.move && self.dragging {
                let x = self.mouse-x / 1px;
                let y = self.mouse-y / 1px;
                root.gesture(self.panning ? "pan" : "rotate", x - self.last-x, y - self.last-y);
                self.last-x = x;
                self.last-y = y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && self.dragging {
                self.dragging = false;
                self.panning = false;
                root.gesture("settle", 0, 0);
            }
        }
        scroll-event(event) => {
            root.gesture("zoom", 0, -(event.delta-y / 1px));
            accept
        }
        double-clicked => { root.reset(); }
    }

    if root.loading || root.failed : Rectangle {
        background: #f8fafccc;
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Text {
                text: root.failed ? I18n.wm_load_failed : (root.status == "" ? I18n.wm_loading : root.status);
                color: Theme.text; font-size: Theme.font-md; horizontal-alignment: center;
            }
            if root.failed : Rectangle {
                width: 76px; height: 32px; border-radius: 6px; background: Theme.accent;
                Text { width: parent.width; height: parent.height; text: I18n.wm_retry; color: white; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.retry(); } }
            }
        }
    }

    Rectangle {
        x: 16px; y: parent.height - 56px; width: parent.width - 32px; height: 40px;
        background: #ffffffdd; border-width: 1px; border-color: #cbd5e1; border-radius: 8px;
        HorizontalLayout { padding: 5px; spacing: 6px;
            Rectangle {
                width: 32px; height: 30px; border-radius: 5px; background: #ffffff;
                Text { width: parent.width; height: parent.height; text: "↺"; color: Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.reset(); } }
            }
            Rectangle {
                width: 72px; height: 30px; border-radius: 5px; background: #ffffff;
                Text { width: parent.width; height: parent.height; text: root.rotating ? I18n.wm_pause : I18n.wm_rotate; color: Theme.text; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.toggle-rotate(); } }
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.status; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
        }
    }
}
