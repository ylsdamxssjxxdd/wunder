// Thread trajectory dialog (dsh ui-trajectory alignment). All rows, spans and
// detail text are pre-projected and pre-bounded in Rust; Slint only lays out
// what it was handed. The --tt-* palette matches web `thread-trajectory.css`
// value for value so both shells render the same trajectory experience.
import { Theme, TrajRow, TrajSpan, TrajTick, TrajBoundary, TrajTiming, TrajSection, TrajTab, TrajSearchHit } from "theme.slint";
import { I18n } from "i18n.slint";
import { ListView, ScrollView, LineEdit } from "std-widgets.slint";
import { TextEditBase } from "textedit-base.slint";

export global TrajTokens {
    out property <color> brand: #4176E6;
    out property <color> brand-soft: #E3ECFB;
    out property <color> green: #22C55E;
    out property <color> green-mix: #36A762;
    out property <color> green-soft: #E6FAED;
    out property <color> amber: #DD8629;
    out property <color> amber-soft: #FEF5E7;
    out property <color> red: #EC1313;
    out property <color> red-soft: #FDE8E8;
    out property <color> violet: #886BAE;
    out property <color> violet-soft: #F1EBF7;
    out property <color> text: #0F1115;
    out property <color> text-2: #61666B;
    out property <color> text-3: #81858C;
    out property <color> caption: #ADB2B8;
    out property <color> module: #F5F6F7;
    out property <color> code-bg: #F9FAFB;
    out property <color> hover: #2631480F;
    out property <color> active: #2631481A;
    out property <color> border-1: #0000000A;
    out property <color> border-2: #0000001A;
    out property <color> border-3: #00000029;

    public pure function kind-color(kind: int) -> color {
        kind == 1 ? root.brand :
        kind == 2 ? root.green-mix :
        kind == 3 ? root.text-3 :
        kind == 4 ? root.violet :
        kind == 5 ? root.amber :
        kind == 6 ? root.amber :
        root.text-3;
    }
    public pure function kind-soft(kind: int) -> color {
        kind == 1 ? root.brand-soft :
        kind == 2 ? root.green-soft :
        kind == 3 ? root.module :
        kind == 4 ? root.violet-soft :
        kind == 5 || kind == 6 ? root.amber-soft :
        root.module;
    }
    public pure function kind-label(kind: int) -> string {
        kind == 0 ? I18n.traj_kind_system :
        kind == 1 ? I18n.traj_kind_user :
        kind == 2 ? I18n.traj_kind_context :
        kind == 3 ? I18n.traj_kind_compacted :
        kind == 4 ? I18n.traj_kind_assistant :
        kind == 5 ? I18n.traj_kind_tool :
        I18n.traj_kind_subtool;
    }
}

// One dsh-style toggle pill: label + a glyph square that fills when on.
component TrajToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggle();
    height: 22px;
    y: 5px;
    width: toggle-label.preferred-width + 34px;
    border-radius: 4px;
    background: root.on ? TrajTokens.active : transparent;
    border-width: 1px;
    border-color: root.on ? TrajTokens.border-3 : TrajTokens.border-2;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        alignment: center; spacing: 5px;
        Rectangle {
            width: 10px; height: 10px;
            y: (parent.height - 10px) / 2;
            border-radius: 2px;
            border-width: 1px; border-color: TrajTokens.text-3;
            background: root.on ? TrajTokens.brand : transparent;
        }
        toggle-label := Text {
            height: parent.height;
            text: root.label;
            color: root.on ? TrajTokens.text : TrajTokens.text-2;
            font-size: 11px; font-weight: 600;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

export component ThreadTrajectoryDialog inherits Rectangle {
    // Ledger rows and timeline spans, projected in Rust. TrajSpan.index is the
    // ledger row index of the record behind the span, so one int drives both
    // the row highlight and the span highlight.
    in property <[TrajRow]> rows;
    in property <[TrajSpan]> spans;
    in property <[TrajTick]> ticks;
    in property <[TrajBoundary]> boundaries;
    in property <float> view-start: 0.0;
    in property <float> view-width: 1.0;
    in property <bool> selection-active: false;
    in property <float> selection-start: 0.0;
    in property <float> selection-end: 0.0;
    // Details panel projection for the selected record.
    in property <string> detail-header;
    in property <string> detail-badge;
    in property <int> detail-kind: 1;
    in property <[TrajTab]> detail-tabs;
    in property <int> detail-tab: 0;
    in property <[TrajTiming]> overview-rows;
    in property <[TrajSection]> sections;
    in property <[TrajTiming]> timing-rows;
    in property <string> raw-text;
    in property <int> selected-index: -1;
    // Toolbar state.
    in property <bool> show-duration: true;
    in-out property <bool> show-turns: false;
    in-out property <bool> show-calls: false;
    in-out property <string> query;
    in property <string> search-hint;
    in property <[TrajSearchHit]> search-hits;
    in property <string> search-body;
    // Status.
    in property <bool> loading;
    in property <bool> failed;
    // Tooltip text (already formatted, lines separated by \n); position is
    // tracked Slint-side from the hovered span.
    in property <string> tooltip-text;
    in property <int> hover-index: -1;
    in-out property <length> hover-mx: 0px;
    in-out property <length> hover-my: 0px;

    callback close();
    callback toggle-duration();
    callback toggle-turns();
    callback toggle-calls();
    callback export();
    callback select-row(int);
    // action: 0 row double click, 1 turn, 2 assistant tools.
    callback fold-row(int, int);
    callback select-tab(int);
    callback select-span(int);
    callback hover-span(int);
    callback leave-span();
    callback search-edited();
    callback select-search-hit(int);
    callback zoom(float, float);
    callback pan(float);
    callback select-range(float, float);
    callback clear-range();
    callback select-position(float);
    callback hover-position(float);
    // Fired when the ledger reaches either edge. The host keeps a keyset
    // cursor and prepends/appends one bounded page without rebuilding the
    // whole history in the Slint thread.
    callback edge-reached(bool);

    in-out property <length> details-width: 400px;
    in-out property <bool> details-dragging: false;
    private property <length> press-x: 0px;
    private property <length> press-width: 0px;
    private property <bool> timeline-pressed: false;
    private property <length> press-px: 0px;
    private property <float> press-start: 0.0;
    private property <bool> drag-moved: false;
    private property <bool> press-pan: false;

    function handle-track-move(mouse-x: length) {
        if root.timeline-pressed {
            if mouse-x < root.press-px - 3px || mouse-x > root.press-px + 3px {
                root.drag-moved = true;
            }
            if root.drag-moved && root.press-pan && root.view-width < 1.0 {
                root.pan(root.press-start - (mouse-x - root.press-px) / track.width * root.view-width);
            } else if root.drag-moved && !root.press-pan {
                root.select-range(
                    root.press-start + root.press-px / track.width * root.view-width,
                    root.press-start + mouse-x / track.width * root.view-width
                );
            }
        }
        root.hover-position(root.view-start + mouse-x / track.width * root.view-width);
    }

    background: white;
    border-width: 1px;
    border-color: Theme.border-strong;

    VerticalLayout {
        // ---- toolbar (32px): back / toggles / search ----
        HorizontalLayout {
            height: 32px;
            padding-left: 10px; padding-right: 10px;
            spacing: 8px;
            Rectangle {
                width: 22px; height: 22px; y: 5px; border-radius: 4px;
                background: back-touch.has-hover ? TrajTokens.hover : transparent;
                Image {
                    x: 4px; y: 4px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-left.svg");
                    colorize: TrajTokens.text-2;
                }
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button; accessible-label: I18n.traj_back;
                    clicked => { root.close(); }
                }
            }
            TrajToggle {
                label: I18n.traj_duration;
                on: root.show-duration;
                toggle => { root.toggle-duration(); }
            }
            TrajToggle {
                label: I18n.traj_turns;
                on: root.show-turns;
                toggle => { root.toggle-turns(); }
            }
            TrajToggle {
                label: I18n.traj_calls;
                on: root.show-calls;
                toggle => { root.toggle-calls(); }
            }
            Rectangle {
                width: export-label.preferred-width + 24px;
                height: 22px;
                y: 5px;
                border-radius: 4px;
                background: export-touch.has-hover ? TrajTokens.hover : transparent;
                export-label := Text {
                    x: 8px;
                    height: parent.height;
                    text: I18n.traj_export;
                    color: TrajTokens.text-2;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                export-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.export(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            traj-search := LineEdit {
                width: 164px; height: 22px; y: 5px;
                text <=> root.query;
                font-size: 11px;
                placeholder-text: I18n.traj_search;
                edited => { root.search-edited(); }
            }
        }
        Rectangle { height: 1px; background: TrajTokens.border-1; }
        if root.search-hint != "" : Text {
            height: 20px;
            x: 12px;
            text: root.search-hint;
            color: TrajTokens.text-2;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.search-hits.length > 0 : Rectangle {
            height: 72px;
            background: TrajTokens.module;
            ScrollView {
                horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;


                width: parent.width; height: parent.height;

                VerticalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 1px;
                    for hit[i] in root.search-hits : Rectangle {
                        height: 17px;
                        background: hit-touch.has-hover ? TrajTokens.hover : transparent;
                        Text { x: 4px; width: parent.width - 8px; text: hit.snippet; color: TrajTokens.text-2; font-size: 10px; overflow: elide; vertical-alignment: center; }
                        hit-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-search-hit(i); } }
                    }
                }
            }
        }
        if root.search-body != "" : Text {
            height: 80px; x: 10px; width: parent.width - 20px;
            text: root.search-body; color: TrajTokens.text-2; font-size: 10px;
            overflow: clip; wrap: word-wrap;
        }

        // ---- timeline: 16px axis + 50px track ----
        Rectangle {
            height: 67px;
            clip: true;
            // Keep the 44px lane gutter separate from the track, matching the
            // web grid. Labels must never sit underneath a colored span.
            Rectangle {
                y: 0px;
                height: 16px;
                x: 44px;
                width: parent.width - 44px;
                for tick in root.ticks : Text {
                    x: min(max(tick.pos * parent.width - 16px, 0px), parent.width - 32px);
                    y: 0px;
                    width: 32px;
                    horizontal-alignment: center;
                    text: tick.label;
                    color: TrajTokens.caption;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                y: 17px;
                height: 50px;
                Rectangle {
                    width: 44px;
                    Rectangle { x: 43px; width: 1px; height: parent.height; background: TrajTokens.border-2; }
                    Text { x: 0px; y: 7px; width: 41px; horizontal-alignment: right; text: I18n.traj_lane_input; color: TrajTokens.caption; font-size: 9px; }
                    Text { x: 0px; y: 21px; width: 41px; horizontal-alignment: right; text: I18n.traj_lane_model; color: TrajTokens.caption; font-size: 9px; }
                    Text { x: 0px; y: 35px; width: 41px; horizontal-alignment: right; text: I18n.traj_lane_tool; color: TrajTokens.caption; font-size: 9px; }
                }
                track := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                // turn boundaries behind the spans
                for boundary in root.boundaries : Rectangle {
                    x: boundary.pos * track.width;
                    y: 4px;
                    width: 1px;
                    height: 42px;
                    background: TrajTokens.border-2;
                }
                // Spans own mouse input; the transparent lane captures gaps.
                track-touch := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.timeline-pressed = true;
                            root.press-pan = event.button == PointerEventButton.right;
                            root.drag-moved = false;
                            root.press-px = self.mouse-x;
                            root.press-start = root.view-start;
                        }
                        if event.kind == PointerEventKind.up { root.timeline-pressed = false; }
                    }
                    moved => { root.handle-track-move(self.mouse-x); }
                    changed has-hover => {
                        if self.has-hover { root.hover-position(root.view-start + self.mouse-x / track.width * root.view-width); }
                        else { root.leave-span(); }
                    }
                    scroll-event(event) => {
                        root.zoom(event.delta-y < 0px ? 0.8 : 1.25, self.mouse-x / track.width);
                        return accept;
                    }
                    clicked => { if !root.drag-moved && !root.press-pan { root.select-position(root.view-start + self.mouse-x / track.width * root.view-width); } }
                }
                if root.selection-active : Rectangle {
                    x: max(0px, (root.selection-start - root.view-start) / root.view-width * track.width);
                    width: max(1px, (min(root.selection-end, root.view-start + root.view-width) - max(root.selection-start, root.view-start)) / root.view-width * track.width);
                    y: 0px; height: parent.height;
                    background: #4176E61F;
                    border-width: 0px;
                }
                // spans; a span carries the ledger row index of its record so
                // hovering highlights the row and vice versa
                for span in root.spans : sp := Rectangle {
                    property <length> area: track.width;
                    x: span.start * area;
                    y: 7px + span.lane * 14px;
                    width: max(2px, span.width * area);
                    height: 8px;
                    border-radius: 1px;
                    background: TrajTokens.kind-color(span.kind);
                    border-width: span.selected ? 1px : 0px;
                    border-color: TrajTokens.kind-color(span.kind);
                    span-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.timeline-pressed = true;
                                root.press-pan = event.button == PointerEventButton.right;
                                root.drag-moved = false;
                                root.press-px = sp.x + self.mouse-x;
                                root.press-start = root.view-start;
                            }
                            if event.kind == PointerEventKind.up { root.timeline-pressed = false; }
                        }
                        moved => {
                            root.handle-track-move(sp.x + self.mouse-x);
                            root.hover-span(span.index);
                            root.hover-mx = sp.x + self.mouse-x;
                            root.hover-my = 17px + sp.y + self.mouse-y;
                        }
                        clicked => {
                            if !root.drag-moved && !root.press-pan {
                                if span.index < 0 { root.select-position(root.view-start + (sp.x + self.mouse-x) / track.width * root.view-width); }
                                else { root.select-span(span.index); }
                            }
                        }
                        changed has-hover => {
                            if !self.has-hover { root.leave-span(); }
                        }
                    scroll-event(event) => {
                            root.zoom(event.delta-y < 0px ? 0.8 : 1.25, (sp.x + self.mouse-x) / track.width);
                            return accept;
                        }
                        double-clicked => { root.clear-range(); }
                    }
                    opacity: span.outside ? 0.2 : span.index < 0 ? 0.86 : 1.0;
                }
                }
            }
            // tooltip card; lives above the track, no TouchArea so it never
            // steals hover from the span underneath
            if root.hover-index >= 0 && root.tooltip-text != "" : Rectangle {
                x: min(root.hover-mx + 12px, parent.width - 280px);
                y: min(root.hover-my - 8px, parent.height - tooltip-lines.preferred-height - 16px);
                width: min(272px, tooltip-lines.preferred-width + 20px);
                height: tooltip-lines.preferred-height + 14px;
                background: white;
                border-radius: 6px;
                border-width: 1px; border-color: TrajTokens.border-2;
                drop-shadow-blur: 10px; drop-shadow-color: #00000022;
                tooltip-lines := Text {
                    x: 10px; y: 7px;
                    width: parent.width - 20px;
                    text: root.tooltip-text;
                    color: TrajTokens.text-2;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
        // 时间轴与下方内容之间用一级分隔（--tt-border-2），避免详情面板的顶部
        // 直接贴着轨迹条、看起来像压在上面。
        Rectangle { height: 1px; background: TrajTokens.border-2; }

        // ---- body: ledger | resize handle | details ----
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            // ledger
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                if root.rows.length == 0 : Text {
                    width: parent.width;
                    y: 24px;
                    horizontal-alignment: center;
                    text: root.failed ? I18n.traj_load_failed : root.loading ? I18n.traj_loading : I18n.traj_empty;
                    color: root.failed ? TrajTokens.red : TrajTokens.text-3;
                    font-size: 12px;
                }
                if root.rows.length > 0 : ListView {
                    width: parent.width; height: parent.height;
                    scrolled => {
                        if self.content-y > -80px {
                            root.edge-reached(true);
                        }
                        if -self.content-y > self.content-height - self.visible-height - 80px {
                            root.edge-reached(false);
                        }
                    }
                    for row in root.rows : Rectangle {
                        height: row.row-height;
                        background: row.kind <= 6 && row.index == root.selected-index ? TrajTokens.active : row-touch.has-hover ? TrajTokens.hover : transparent;
                        HorizontalLayout {
                            // event column (84px): request marker or kind badge
                            Rectangle {
                    width: 84px;
                                if row.request > 0 : Rectangle {
                                    // dsh requestBoundaryControl：16px 热区内一个
                                    // 5px 灰点（9px 白圈垫底盖住行线），全部固定在
                                    // 同一纵线上；hover 变品牌色并在右侧弹出标签。
                                    x: 12px; y: (parent.height - 16px) / 2;
                                    width: 16px; height: 16px;
                                    request-touch := TouchArea { }
                                    Rectangle {
                                        width: 9px; height: 9px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: white;
                                    }
                                    Rectangle {
                                        width: 5px; height: 5px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: request-touch.has-hover ? TrajTokens.brand : TrajTokens.caption;
                                    }
                                    if request-touch.has-hover : Rectangle {
                                        x: 17px; y: 2px;
                                        width: request-label.preferred-width + 8px;
                                        height: 12px;
                                        border-radius: 2px;
                                        border-width: 0.5px;
                                        border-color: TrajTokens.border-3;
                                        background: white;
                                        request-label := Text {
                                            x: 4px; height: parent.height;
                                            text: row.badge;
                                            color: TrajTokens.text-2;
                                            font-family: Theme.font-mono;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if row.request == 0 && row.kind <= 6 && !(row.turn-start && row.foldable) : Rectangle {
                                    x: 12px;
                                    y: (parent.height - 16px) / 2;
                                    width: pill-text.preferred-width + 14px;
                                    height: 16px;
                                    border-radius: 3px;
                                    background: TrajTokens.kind-soft(row.kind);
                                    pill-text := Text {
                                        x: 7px; height: parent.height;
                                        text: TrajTokens.kind-label(row.kind);
                                        color: TrajTokens.kind-color(row.kind);
                                        font-size: 10px; font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle { width: 1px; background: TrajTokens.border-1; }
                            // content column
                            Rectangle {
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 12px;
                                    spacing: 6px;
                                    alignment: start;
                                    if row.kind == 7 || row.kind == 8 : Text {
                                        height: parent.height;
                                        text: row.text;
                                        color: TrajTokens.text-2;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if row.kind != 7 && row.kind != 8 : HorizontalLayout {
                                        height: parent.height;
                                        alignment: start;
                                        spacing: 6px;
                                        Text {
                                            text: row.text;
                                            color: TrajTokens.text;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if row.detail != "" : Text {
                                            width: 45%;
                                            text: row.detail;
                                            color: TrajTokens.text-3;
                                            font-size: 10px;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if row.error : Text {
                                            width: 28px;
                                            text: I18n.traj_state_failed;
                                            color: TrajTokens.red;
                                            font-size: 10px; font-weight: 700;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    if row.error && (row.kind == 7 || row.kind == 8) : Text {
                                        height: parent.height;
                                        text: I18n.traj_state_failed;
                                        color: TrajTokens.red;
                                        font-size: 10px; font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // turn start divider drawn over the row top
                        if row.turn-start : Rectangle {
                            y: 0px; width: parent.width; height: 1px;
                            background: TrajTokens.border-2;
                        }
                        row-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " {
                                    if row.kind == 7 { root.fold-row(row.index, 1); }
                                    else if row.kind == 8 { root.fold-row(row.index, 2); }
                                    else { root.select-row(row.index); }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: row.text;
                            clicked => {
                                row-focus.focus();
                                if row.kind == 7 { root.fold-row(row.index, 1); }
                                else if row.kind == 8 { root.fold-row(row.index, 2); }
                                else { root.select-row(row.index); }
                            }
                            double-clicked => { if row.kind <= 6 { root.fold-row(row.index, 0); } }
                        }
                        if row.turn-start && row.foldable && row.kind <= 6 : Rectangle {
                            x: row.request > 0 ? 36px : 4px; y: (parent.height - 16px) / 2; width: 44px; height: 16px;
                            background: turn-touch.has-hover ? TrajTokens.hover : transparent;
                            Image {
                                x: 2px; y: 3px; width: 10px; height: 10px;
                                source: row.collapsed ? @image-url("../assets/icons/chevron-right.svg") : @image-url("../assets/icons/chevron-down.svg");
                                colorize: TrajTokens.text-2;
                            }
                            Text {
                                x: 14px; height: parent.height;
                                text: "#" + row.turn;
                                color: TrajTokens.text-2;
                                font-size: 9px; vertical-alignment: center;
                            }
                            turn-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: I18n.traj_turns;
                                clicked => { root.fold-row(row.index, 1); }
                            }
                        }
                    }
                }
                }
            // resize handle
            Rectangle {
                width: 5px;
                background: handle-touch.has-hover || root.details-dragging ? TrajTokens.border-2 : TrajTokens.border-1;
                handle-touch := TouchArea {
                    mouse-cursor: ew-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.details-dragging = true;
                            root.press-x = self.mouse-x;
                            root.press-width = root.details-width;
                        }
                        if event.kind == PointerEventKind.up {
                            root.details-dragging = false;
                        }
                    }
                    moved => {
                        root.details-width = clamp(root.press-width - (self.mouse-x - root.press-x), 320px, 440px);
                    }
                }
            }
            // details aside
            details := Rectangle {
                // 与蜂巢 .tt-details 对齐：clamp(320px, 38%, 440px) +
                // max-width(100% - 280px) + 左侧 border-2。
                width: clamp(min(root.details-width, root.width - 280px), 320px, 440px);
                background: white;
                border-width: 1px; border-color: TrajTokens.border-2;
                VerticalLayout {
                    padding-top: 8px;
                    // header
                    HorizontalLayout {
                        height: 38px;
                        padding-left: 12px; padding-right: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: header-badge.preferred-width + 14px; height: 18px;
                            border-radius: 3px;
                            background: TrajTokens.kind-soft(root.detail-kind);
                            header-badge := Text {
                                x: 7px; height: parent.height;
                                text: root.detail-badge;
                                color: TrajTokens.kind-color(root.detail-kind);
                                font-size: 10px; font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            height: parent.height;
                            text: root.detail-header;
                            color: TrajTokens.text;
                            font-size: 12px; font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 4px;
                            background: close-touch.has-hover ? TrajTokens.hover : transparent;
                            Image { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("../assets/icons/xmark.svg"); colorize: TrajTokens.text-2; }
                            close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-row(-1); } }
                        }
                    }
                    Rectangle { height: 1px; background: TrajTokens.border-1; }
                    // tabs (underline style)
                    HorizontalLayout {
                        height: 30px;
                        padding-left: 12px;
                        spacing: 14px;
                        for tab in root.detail-tabs : Rectangle {
                            width: tab-title.preferred-width;
                            tab-title := Text {
                                height: parent.height;
                                text: tab.title;
                                color: root.detail-tab == tab.kind ? TrajTokens.brand : TrajTokens.text-2;
                                font-size: 12px; font-weight: root.detail-tab == tab.kind ? 600 : 400;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                y: parent.height - 2px;
                                width: parent.width;
                                height: 2px;
                                background: root.detail-tab == tab.kind ? TrajTokens.brand : transparent;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-tab(tab.kind); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: TrajTokens.border-1; }
                    // tab body
                    ScrollView {
                        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;


                        vertical-stretch: 1;
                        // fixed width: a layout deriving its width from
                        // no-wrap text content makes the flickable loop
                        width: details.width - 26px;
                        VerticalLayout {
                            min-width: 0px;
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;
                            // overview key/value rows
                            for entry in root.overview-rows : HorizontalLayout {
                                height: 20px;
                                spacing: 8px;
                                Text {
                                    width: 96px;
                                    text: entry.label;
                                    color: TrajTokens.caption;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    height: parent.height;
                                    text: entry.value;
                                    color: TrajTokens.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            // content sections (input / output / params / result / schema)
                            for section in root.sections : VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    height: 16px;
                                    text: section.title;
                                    color: TrajTokens.text;
                                    font-size: 12px; font-weight: 600;
                                }
                                TextEditBase {
                                    width: parent.width;
                                    height: 140px;
                                    border-radius: 4px;
                                    background: TrajTokens.code-bg;
                                    border-width: 1px; border-color: TrajTokens.border-1;
                                    clip: true;
                                    text: section.body;
                                    read-only: true;
                                    wrap: word-wrap;
                                    scroll-view-padding: 6px;
                                    font-family: Theme.font-mono;
                                    font-size: 11px;
                                    foreground: TrajTokens.text-2;
                                    selection-background-color: TrajTokens.brand-soft;
                                    selection-foreground-color: TrajTokens.text;
                                }
                            }
                            // timing rows
                            for timing in root.timing-rows : HorizontalLayout {
                                height: 20px;
                                spacing: 8px;
                                Text {
                                    width: 96px;
                                    text: timing.label;
                                    color: TrajTokens.caption;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    height: parent.height;
                                    text: timing.value;
                                    color: TrajTokens.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            // raw tab; the list contents are tab-scoped by the
                            // Rust projection, raw shows only when filled
                            if root.raw-text != "" : TextEditBase {
                                width: parent.width;
                                height: 260px;
                                border-radius: 4px;
                                background: TrajTokens.code-bg;
                                border-width: 1px; border-color: TrajTokens.border-1;
                                clip: true;
                                text: root.raw-text;
                                read-only: true;
                                wrap: no-wrap;
                                scroll-view-padding: 6px;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                foreground: TrajTokens.text-2;
                                selection-background-color: TrajTokens.brand-soft;
                                selection-foreground-color: TrajTokens.text;
                            }
                        }
                    }
                }
            }
        }
    }
}
