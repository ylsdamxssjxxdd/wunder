// Thread trajectory dialog (dsh ui-trajectory alignment). All rows, spans and
// detail text are pre-projected and pre-bounded in Rust; Slint only lays out
// what it was handed. The --tt-* palette matches web `thread-trajectory.css`
// value for value so both shells render the same trajectory experience.
import { Theme, TrajRow, TrajSpan, TrajTick, TrajBoundary, TrajTiming, TrajSection, TrajTab, TrajSearchHit } from "theme.slint";
import { I18n } from "i18n.slint";
import { ListView, ScrollView } from "std-widgets.slint";

// Keep the trajectory's typography independent of the surrounding workbench.
component TrajText inherits Text { font-family: "Segoe UI"; }
component TrajTextInput inherits TextInput { font-family: "Segoe UI"; }

export global TrajTokens {
    out property <color> brand: #4176E6;
    // Matches the browser's translucent badge fills composited over white.
    out property <color> brand-soft: #4176E61A;
    out property <color> green: #22C55E;
    out property <color> green-mix: #36A762;
    out property <color> green-soft: #E6FAED;
    out property <color> amber: #DD8629;
    out property <color> amber-soft: #FEF5E7;
    out property <color> red: #EC1313;
    out property <color> red-soft: #FDE8E8;
    out property <color> violet: #886BAE;
    out property <color> violet-soft: #886BAE26;
    out property <color> text: #0F1115;
    out property <color> text-2: #61666B;
    out property <color> text-3: #81858C;
    out property <color> caption: #ADB2B8;
    out property <color> module: #F5F6F7;
    out property <color> code-bg: #F9FAFB;
    out property <color> hover: #2631480F;
    out property <color> active: #2631481A;
    out property <color> border-1: #0000000A;
    out property <color> border-2: #0000001A;
    out property <color> border-3: #00000029;

    public pure function kind-color(kind: int) -> color {
        kind == 1 ? root.brand :
        kind == 2 ? root.green-mix :
        kind == 3 ? root.text-3 :
        kind == 4 ? root.violet :
        kind == 5 ? root.amber :
        kind == 6 ? root.amber :
        root.text-3;
    }
    public pure function kind-soft(kind: int) -> color {
        kind == 1 ? root.brand-soft :
        kind == 2 ? root.green-soft :
        kind == 3 ? root.module :
        kind == 4 ? root.violet-soft :
        kind == 5 || kind == 6 ? root.amber-soft :
        root.module;
    }
    public pure function badge-color(kind: int) -> color {
        kind == 0 || kind == 3 ? root.text-2 : root.kind-color(kind);
    }
    public pure function kind-label(kind: int) -> string {
        kind == 0 ? I18n.traj_kind_system :
        kind == 1 ? I18n.traj_kind_user :
        kind == 2 ? I18n.traj_kind_context :
        kind == 3 ? I18n.traj_kind_compacted :
        kind == 4 ? I18n.traj_kind_assistant :
        kind == 5 ? I18n.traj_kind_tool :
        I18n.traj_kind_subtool;
    }
}

// Compact toolbar toggle: mirrors the web glyph, 4px gap and 7px insets.
component TrajToggle inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> clock: false;
    callback toggle();
    height: 22px;
    y: 5px;
    width: toggle-label.preferred-width + (root.clock ? 30px : 29px);
    border-radius: 4px;
    background: root.on ? TrajTokens.brand-soft : toggle-touch.has-hover ? TrajTokens.hover : transparent;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        alignment: center; spacing: 4px;
        if root.clock : Rectangle {
            width: 12px; height: parent.height;
            Image {
                x: 0px; y: (parent.height - self.height) / 2 + 1px;
                width: 12px; height: 12px;
                source: @image-url("../assets/icons/trajectory-clock.svg");
                colorize: root.on ? TrajTokens.brand : TrajTokens.text-2;
            }
        }
        if !root.clock : TrajText {
            width: 11px; height: parent.height;
            text: root.on ? "⊞" : "⊟";
            color: root.on ? TrajTokens.brand : TrajTokens.text-2;
            font-family: "Segoe UI Symbol";
            font-size: 11px;
            vertical-alignment: center;
        }
        toggle-label := TrajText {
            height: parent.height;
            text: root.label;
            color: root.on ? TrajTokens.brand : TrajTokens.text-2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

export component ThreadTrajectoryDialog inherits Rectangle {
    min-width: 0px;
    preferred-width: 1280px;
    // Ledger rows and timeline spans, projected in Rust. TrajSpan.index is the
    // ledger row index of the record behind the span, so one int drives both
    // the row highlight and the span highlight.
    in property <[TrajRow]> rows;
    in property <[TrajSpan]> spans;
    in property <[TrajTick]> ticks;
    in property <[TrajBoundary]> boundaries;
    in property <float> view-start: 0.0;
    in property <float> view-width: 1.0;
    in property <bool> selection-active: false;
    in property <float> selection-start: 0.0;
    in property <float> selection-end: 0.0;
    // Details panel projection for the selected record.
    in property <string> detail-header;
    in property <string> detail-badge;
    in property <int> detail-kind: 1;
    in property <[TrajTab]> detail-tabs;
    in property <int> detail-tab: 0;
    in property <[TrajTiming]> overview-rows;
    in property <[TrajSection]> sections;
    in property <[TrajTiming]> timing-rows;
    in property <string> raw-text;
    in property <int> selected-index: -1;
    // Toolbar state.
    in property <bool> show-duration: true;
    in-out property <bool> show-turns: false;
    in-out property <bool> show-calls: false;
    in-out property <string> query;
    in property <string> search-hint;
    in property <[TrajSearchHit]> search-hits;
    in property <string> search-body;
    // Status.
    in property <bool> loading;
    in property <bool> failed;
    in property <string> history-hint: I18n.traj_history_start;
    // Tooltip text (already formatted, lines separated by \n); position is
    // tracked Slint-side from the hovered span.
    in property <string> tooltip-text;
    in property <int> hover-index: -1;
    in-out property <length> hover-mx: 0px;
    in-out property <length> hover-my: 0px;

    callback close();
    callback toggle-duration();
    callback toggle-turns();
    callback toggle-calls();
    callback export();
    callback select-row(int);
    // action: 0 row double click, 1 turn, 2 assistant tools.
    callback fold-row(int, int);
    callback select-tab(int);
    callback select-span(int);
    callback hover-span(int);
    callback leave-span();
    callback search-edited();
    callback select-search-hit(int);
    callback zoom(float, float);
    callback pan(float);
    callback select-range(float, float);
    callback clear-range();
    callback select-position(float);
    callback hover-position(float);
    // Fired when the ledger reaches either edge. The host keeps a keyset
    // cursor and prepends/appends one bounded page without rebuilding the
    // whole history in the Slint thread.
    callback edge-reached(bool);

    in-out property <length> details-width: clamp(0.38 * root.width, 320px, 440px);
    in-out property <bool> details-dragging: false;
    private property <length> press-x: 0px;
    private property <length> press-width: 0px;
    private property <bool> timeline-pressed: false;
    private property <length> press-px: 0px;
    private property <float> press-start: 0.0;
    private property <bool> drag-moved: false;
    private property <bool> press-pan: false;
    private property <bool> track-hovered: false;
    private property <length> track-hover-x: 0px;

    function handle-track-move(mouse-x: length) {
        root.track-hovered = true;
        root.track-hover-x = mouse-x;
        if root.timeline-pressed {
            if mouse-x < root.press-px - 3px || mouse-x > root.press-px + 3px {
                root.drag-moved = true;
            }
            if root.drag-moved && root.press-pan && root.view-width < 1.0 {
                root.pan(root.press-start - (mouse-x - root.press-px) / track.width * root.view-width);
            } else if root.drag-moved && !root.press-pan {
                root.select-range(
                    root.press-start + root.press-px / track.width * root.view-width,
                    root.press-start + mouse-x / track.width * root.view-width
                );
            }
        }
        root.hover-position(root.view-start + mouse-x / track.width * root.view-width);
    }

    background: white;
    border-width: 0px;

    VerticalLayout {
        // ---- toolbar (32px): back / toggles / search ----
        HorizontalLayout {
            height: 31.5px;
            padding-left: 8px; padding-right: 8px;
            spacing: 8px;
            Rectangle {
                width: 22px; height: 22px; y: 5px; border-radius: 4px;
                background: back-touch.has-hover ? TrajTokens.hover : transparent;
                Image {
                    x: 4px; y: 4px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/trajectory-back.svg");
                    colorize: TrajTokens.text-2;
                }
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: button; accessible-label: I18n.traj_back;
                    clicked => { root.close(); }
                }
            }
            TrajToggle {
                label: I18n.traj_duration;
                clock: true;
                on: root.show-duration;
                toggle => { root.toggle-duration(); }
            }
            TrajToggle {
                label: I18n.traj_turns;
                on: root.show-turns;
                toggle => { root.toggle-turns(); }
            }
            TrajToggle {
                label: I18n.traj_calls;
                on: root.show-calls;
                toggle => { root.toggle-calls(); }
            }
            Rectangle { horizontal-stretch: 1; }
            traj-search := Rectangle {
                // Exact counterpart of web .tt-search: 164×22, 7px horizontal
                // insets and a 12px icon. A native LineEdit cannot provide its
                // own border/padding consistently across desktop platforms.
                width: 164px; height: 22px; y: 5px;
                background: white;
                border-radius: 4px;
                border-width: 0.5px;
                border-color: traj-search-input.has-focus ? TrajTokens.brand : TrajTokens.border-3;
                clip: true;
                Image {
                    x: 7px; y: 5px; width: 12px; height: 12px;
                    source: @image-url("../assets/icons/trajectory-search.svg");
                    colorize: traj-search-input.has-focus ? TrajTokens.brand : TrajTokens.text-3;
                    image-fit: contain;
                }
                if root.query == "" && traj-search-input.preedit-text == "" : TrajText {
                    x: 23px; width: parent.width - 30px; height: parent.height;
                    text: I18n.traj_search;
                    color: TrajTokens.caption;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                traj-search-input := TrajTextInput {
                    x: 23px; width: parent.width - 30px; height: parent.height;
                    text <=> root.query;
                    single-line: true;
                    color: TrajTokens.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    selection-background-color: TrajTokens.brand-soft;
                    selection-foreground-color: TrajTokens.text;
                    edited => { root.search-edited(); }
                }
            }
            Rectangle {
                width: export-label.preferred-width + 30px;
                height: 22px;
                y: 5px;
                border-radius: 4px;
                background: export-touch.has-hover ? TrajTokens.hover : transparent;
                Image {
                    x: 7px; y: 5px; width: 12px; height: 12px;
                    source: @image-url("../assets/icons/trajectory-export.svg");
                    colorize: TrajTokens.text-2;
                    image-fit: contain;
                }
                export-label := TrajText {
                    x: 23px;
                    height: parent.height;
                    text: I18n.traj_export;
                    color: TrajTokens.text-2;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                export-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.export(); }
                }
            }
        }
        Rectangle { height: 0.5px; background: TrajTokens.border-2; }
        if root.search-hint != "" : TrajText {
            height: 20px;
            x: 12px;
            text: root.search-hint;
            color: TrajTokens.text-2;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.search-hits.length > 0 : Rectangle {
            height: 72px;
            background: TrajTokens.module;
            ScrollView {
                horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;


                width: parent.width; height: parent.height;

                VerticalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 1px;
                    for hit[i] in root.search-hits : Rectangle {
                        height: 17px;
                        background: hit-touch.has-hover ? TrajTokens.hover : transparent;
                        TrajText { x: 4px; width: parent.width - 8px; text: hit.snippet; color: TrajTokens.text-2; font-size: 10px; overflow: elide; vertical-alignment: center; }
                        hit-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-search-hit(i); } }
                    }
                }
            }
        }
        if root.search-body != "" : Rectangle {
            height: 80px;
            min-width: 0px;
            TrajText {
                x: 10px; width: parent.width - 20px; height: parent.height;
                text: root.search-body; color: TrajTokens.text-2; font-size: 10px;
                overflow: clip; wrap: word-wrap;
            }
        }

        // ---- timeline: 4px top padding + 16px axis + 50px track + 8px bottom ----
        // The web ledger uses the same 78px plot box. Keeping the padding in
        // the native view prevents the axis/track from appearing glued to the
        // toolbar and leaves the coloured segments on the same baseline.
        Rectangle {
            height: 78px;
            clip: true;
            // Keep the 44px lane gutter separate from the track, matching the
            // web grid. Labels must never sit underneath a colored span.
            Rectangle {
                height: 16px;
                x: 44px;
                width: parent.width - 44px;
                y: 4px;
                for tick in root.ticks : TrajText {
                    x: tick.pos * parent.width - self.preferred-width / 2;
                    y: 0px;
                    height: parent.height;
                    horizontal-alignment: center;
                    text: tick.label;
                    color: TrajTokens.text-3;
                    font-family: Theme.font-mono;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                y: 20px;
                height: 50px;
                Rectangle {
                    width: 44px;
                    Rectangle { x: 43.5px; width: 0.5px; height: parent.height; background: TrajTokens.border-2; }
                    TrajText { x: 0px; y: 7px; width: 41px; height: 8px; vertical-alignment: center; horizontal-alignment: right; text: I18n.traj_lane_input; color: TrajTokens.text-3; font-size: 10px; }
                    TrajText { x: 0px; y: 21px; width: 41px; height: 8px; vertical-alignment: center; horizontal-alignment: right; text: I18n.traj_lane_model; color: TrajTokens.text-3; font-size: 10px; }
                    TrajText { x: 0px; y: 35px; width: 41px; height: 8px; vertical-alignment: center; horizontal-alignment: right; text: I18n.traj_lane_tool; color: TrajTokens.text-3; font-size: 10px; }
                }
                track := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                // turn boundaries behind the spans
                for boundary in root.boundaries : Rectangle {
                    visible: root.show-turns && !(root.spans.length > 0 && root.spans[0].overview);
                    x: boundary.pos * track.width;
                    y: 0px;
                    width: 0.5px;
                    height: parent.height;
                    background: TrajTokens.border-2;
                }
                // Spans own mouse input; the transparent lane captures gaps.
                track-touch := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.timeline-pressed = true;
                            root.press-pan = event.button == PointerEventButton.right;
                            root.drag-moved = false;
                            root.press-px = self.mouse-x;
                            root.press-start = root.view-start;
                        }
                        if event.kind == PointerEventKind.up { root.timeline-pressed = false; }
                    }
                    moved => { root.handle-track-move(self.mouse-x); }
                    changed has-hover => {
                        if self.has-hover {
                            root.track-hovered = true;
                            root.track-hover-x = self.mouse-x;
                            root.hover-mx = self.mouse-x;
                            root.hover-my = 20px + self.mouse-y;
                            root.hover-position(root.view-start + self.mouse-x / track.width * root.view-width);
                        }
                        else { root.track-hovered = false; root.leave-span(); }
                    }
                    scroll-event(event) => {
                        root.zoom(event.delta-y < 0px ? 0.8 : 1.25, self.mouse-x / track.width);
                        return accept;
                    }
                    clicked => { if !root.drag-moved && !root.press-pan { root.select-position(root.view-start + self.mouse-x / track.width * root.view-width); } }
                }
                // spans; a span carries the ledger row index of its record so
                // hovering highlights the row and vice versa
                for span in root.spans : sp := Rectangle {
                    property <length> area: track.width;
                    property <length> raw-width: span.width * area;
                    // Match the web's subpixel separators; duration coordinates
                    // share the same domain as the detail projection in Rust.
                    property <length> gap: span.overview ? min(raw-width * 0.15, 0.5px) : min(raw-width * 0.08, 1px);
                    x: min(span.start * area + gap, area - self.width);
                    y: 7px + span.lane * 14px;
                    width: max(span.overview ? 1px : 2px, raw-width - gap * 2);
                    border-radius: span.overview ? 0px : 1px;
                    height: 8px;
                    background: span.error ? TrajTokens.red : TrajTokens.kind-color(span.kind);
                    border-width: 0px;
                    span-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.timeline-pressed = true;
                                root.press-pan = event.button == PointerEventButton.right;
                                root.drag-moved = false;
                                root.press-px = sp.x + self.mouse-x;
                                root.press-start = root.view-start;
                            }
                            if event.kind == PointerEventKind.up { root.timeline-pressed = false; }
                        }
                        moved => {
                            root.handle-track-move(sp.x + self.mouse-x);
                            root.hover-span(span.index);
                            root.hover-mx = sp.x + self.mouse-x;
                            root.hover-my = 20px + sp.y + self.mouse-y;
                        }
                        clicked => {
                            if !root.drag-moved && !root.press-pan {
                                if span.index < 0 { root.select-position(root.view-start + (sp.x + self.mouse-x) / track.width * root.view-width); }
                                else { root.select-span(span.index); }
                            }
                        }
                        changed has-hover => {
                            if !self.has-hover { root.track-hovered = false; root.leave-span(); }
                        }
                    scroll-event(event) => {
                            root.zoom(event.delta-y < 0px ? 0.8 : 1.25, (sp.x + self.mouse-x) / track.width);
                            return accept;
                        }
                        double-clicked => { root.clear-range(); }
                    }
                    // Aggregated overview tiles carry their own web-matched
                    // opacity. It takes precedence over focus dimming because
                    // a bucket represents many records rather than one row.
                    opacity: span.aggregate ? 0.86 : span.outside ? 0.2 : span.dimmed ? 0.14 : span.overview ? 0.94 : 1.0;
                    if span.overview : Rectangle {
                        x: max(0px, parent.width - 1px);
                        width: 1px;
                        height: parent.height;
                        background: #FFFFFF6B;
                    }
                    // The browser shows these rings on hover.
                    // The ring does not change bar geometry or click bounds.
                    if span-touch.has-hover : Rectangle {
                        x: -2px; y: -2px;
                        width: parent.width + 4px; height: parent.height + 4px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: TrajTokens.brand;
                        background: transparent;
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px; height: parent.height - 2px;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: white;
                            background: transparent;
                        }
                    }
                }
                if root.track-hovered : Rectangle {
                    x: root.track-hover-x - 1px; width: 2px;
                    y: 0px; height: parent.height;
                    background: TrajTokens.brand; opacity: 0.85;
                }
                // The browser paints the range selection after spans. It must
                // therefore tint the active interval without obscuring the
                // hit targets, and shows a 3px edge at both endpoints.
                if root.selection-active : Rectangle {
                    x: max(0px, (root.selection-start - root.view-start) / root.view-width * track.width);
                    width: max(1px, (min(root.selection-end, root.view-start + root.view-width) - max(root.selection-start, root.view-start)) / root.view-width * track.width);
                    y: 0px; height: parent.height;
                    background: #4176E61F;
                    border-width: 0px;
                    Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: TrajTokens.brand; }
                    Rectangle { x: parent.width - 3px; y: 0px; width: 3px; height: parent.height; background: TrajTokens.brand; }
                }
                }
            }
        }
        // 时间轴与下方内容之间用一级分隔（--tt-border-2），避免详情面板的顶部
        // 直接贴着轨迹条、看起来像压在上面。
        Rectangle { height: 1px; background: TrajTokens.border-2; }

        // ---- body: ledger | resize handle | details ----
        Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            // ledger
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width - (root.selected-index >= 0 ? clamp(min(root.details-width, root.width - 280px), 320px, 440px) + 4px : 0px);
                height: parent.height;
                clip: true;
                if root.rows.length == 0 : TrajText {
                    width: parent.width;
                    y: 24px;
                    horizontal-alignment: center;
                    text: root.failed ? I18n.traj_load_failed : root.loading ? I18n.traj_loading : I18n.traj_empty;
                    color: root.failed ? TrajTokens.red : TrajTokens.text-3;
                    font-size: 12px;
                }
                if root.rows.length > 0 : ListView {
                    y: 26px;
                    width: parent.width; height: parent.height - 26px;
                    scrolled => {
                        if self.content-y > -80px {
                            root.edge-reached(true);
                        }
                        if -self.content-y > self.content-height - self.visible-height - 80px {
                            root.edge-reached(false);
                        }
                    }
                    for row in root.rows : Rectangle {
                        height: row.row-height;
                        background: row.kind <= 6 && row.index == root.selected-index ? TrajTokens.active : row-touch.has-hover ? TrajTokens.hover : transparent;
                        HorizontalLayout {
                            height: parent.height;
                            // event column (84px): request marker and turn control
                            Rectangle {
                                width: 84px;
                                if row.request > 0 : Rectangle {
                                    // dsh requestBoundaryControl：16px 热区内一个
                                    // 5px 灰点（9px 白圈垫底盖住行线），全部固定在
                                    // 同一纵线上；hover 变品牌色并在右侧弹出标签。
                                    x: 12px; y: -8px;
                                    width: 16px; height: 16px;
                                    request-touch := TouchArea { }
                                    Rectangle {
                                        width: 9px; height: 9px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: white;
                                    }
                                    Rectangle {
                                        width: 5px; height: 5px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: self.width / 2;
                                        background: request-touch.has-hover ? TrajTokens.brand : TrajTokens.caption;
                                    }
                                    if request-touch.has-hover : Rectangle {
                                        x: 17px; y: 2px;
                                        width: request-label.preferred-width + 8px;
                                        height: 12px;
                                        border-radius: 2px;
                                        border-width: 0.5px;
                                        border-color: TrajTokens.border-3;
                                        background: white;
                                        request-label := TrajText {
                                            x: 4px; height: parent.height;
                                            text: row.badge;
                                            color: TrajTokens.text-2;
                                            font-family: Theme.font-mono;
                                            font-size: 9px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            // content column
                            Rectangle {
                                horizontal-stretch: 1;
                                height: parent.height;
                                clip: true;
                                HorizontalLayout {
                                    height: parent.height;
                                    padding-left: 4px; padding-right: 8px;
                                    spacing: row.kind == 7 || row.kind == 8 ? 0px : 8px;
                                    alignment: start;
                                    if row.kind == 7 || row.kind == 8 : Rectangle { width: 4px; }
                                    if row.kind == 7 || row.kind == 8 : TrajText {
                                        height: parent.height;
                                        text: row.text;
                                        color: TrajTokens.text-2;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide; wrap: no-wrap;
                                        horizontal-stretch: 1;
                                    }
                                    if row.kind != 7 && row.kind != 8 : HorizontalLayout {
                                        height: parent.height;
                                        alignment: start;
                                        spacing: 0px;
                                        // Keep the category in a fixed 52px slot,
                                        // matching the web ledger's grid column.
                                        Rectangle {
                                            width: 52px;
                                            height: parent.height;
                                            if row.kind <= 6 : Rectangle {
                                                x: max(0px, parent.width - 8px - self.width);
                                                y: (parent.height - 19px) / 2;
                                                width: kind-label.preferred-width + 10px;
                                                height: 19px;
                                                border-radius: 4px;
                                                background: TrajTokens.kind-soft(row.kind);
                                                kind-label := TrajText {
                                                    x: 5px; height: parent.height;
                                                    text: TrajTokens.kind-label(row.kind);
                                                    color: TrajTokens.badge-color(row.kind);
                                                    font-size: 10px; font-weight: 650;
                                                    letter-spacing: 0.35px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        TrajText {
                                            height: parent.height;
                                            text: row.text;
                                            color: row.error ? TrajTokens.red : TrajTokens.text;
                                            font-size: 12px;
                                            font-family: row.kind == 5 || row.kind == 6 ? Theme.font-mono : "Segoe UI";
                                            vertical-alignment: center;
                                            overflow: elide; wrap: no-wrap;
                                            horizontal-stretch: row.kind == 5 || row.kind == 6 ? 0 : 1;
                                            max-width: row.kind == 5 || row.kind == 6 ? self.preferred-width : 100000px;
                                        }
                                        if row.arguments != "" : Rectangle { width: 7px; }
                                        if row.arguments != "" : TrajText {
                                            height: parent.height;
                                            text: row.arguments;
                                            color: TrajTokens.text-3;
                                            font-size: 12px;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                            overflow: elide; wrap: no-wrap;
                                            horizontal-stretch: 1;
                                            max-width: self.preferred-width;
                                        }
                                        if row.result != "" : Rectangle { width: 7px; }
                                        if row.result != "" : TrajText {
                                            height: parent.height;
                                            text: "→  " + row.result;
                                            color: TrajTokens.caption;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide; wrap: no-wrap;
                                            max-width: 480px;
                                            horizontal-stretch: 0;
                                        }
                                        if row.error : Rectangle { width: 7px; }
                                        if row.error : TrajText {
                                            height: parent.height;
                                            width: 28px;
                                            text: I18n.traj_state_failed;
                                            color: TrajTokens.red;
                                            font-size: 10px; font-weight: 700;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    if row.error && (row.kind == 7 || row.kind == 8) : TrajText {
                                        height: parent.height;
                                        text: I18n.traj_state_failed;
                                        color: TrajTokens.red;
                                        font-size: 10px; font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: TrajTokens.border-1;
                        }
                        row-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " {
                                    if row.kind == 7 { root.fold-row(row.index, 1); }
                                    else if row.kind == 8 { root.fold-row(row.index, 2); }
                                    else { root.select-row(row.index); }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: row.text;
                            clicked => {
                                row-focus.focus();
                                if row.kind == 7 { root.fold-row(row.index, 1); }
                                else if row.kind == 8 { root.fold-row(row.index, 2); }
                                else { root.select-row(row.index); }
                            }
                            double-clicked => { if row.kind <= 6 { root.fold-row(row.index, 0); } }
                        }
                        if row.turn-start && row.foldable && row.kind <= 6 : Rectangle {
                            x: 36px; y: (parent.height - 18px) / 2; width: 44px; height: 18px;
                            background: turn-touch.has-hover ? TrajTokens.hover : transparent;
                            Image {
                                x: 3px; y: 5px; width: 8px; height: 8px;
                                source: row.collapsed ? @image-url("../assets/icons/trajectory-turn-right.svg") : @image-url("../assets/icons/trajectory-turn-down.svg");
                                colorize: turn-touch.has-hover ? TrajTokens.brand : TrajTokens.text-2;
                            }
                            TrajText {
                                x: 15px; height: parent.height;
                                text: "#" + row.turn;
                                color: turn-touch.has-hover ? TrajTokens.brand : TrajTokens.text-2;
                                font-size: 12px; vertical-alignment: center;
                            }
                            turn-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: I18n.traj_turns;
                                clicked => { root.fold-row(row.index, 1); }
                            }
                        }
                    }
                }
                if root.rows.length > 0 : Rectangle {
                    x: 0px; y: 0px;
                    width: parent.width; height: 26px;
                    background: #F7FAFF;
                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #4176E638; }
                    TrajText {
                        x: 12px; height: parent.height; width: parent.width - 24px;
                        text: root.history-hint;
                        color: TrajTokens.text-2; font-size: 11px;
                        vertical-alignment: center; overflow: elide;
                    }
                }
                }
            // resize handle
            if root.selected-index >= 0 : Rectangle {
                x: parent.width - clamp(min(root.details-width, root.width - 280px), 320px, 440px);
                y: 0px; height: parent.height;
                width: 0px;
                background: handle-touch.has-hover || root.details-dragging ? TrajTokens.border-2 : TrajTokens.border-1;
                handle-touch := TouchArea {
                    x: -4px; width: 8px;
                    mouse-cursor: ew-resize;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.details-dragging = true;
                            root.press-x = parent.x + self.mouse-x;
                            root.press-width = root.details-width;
                        }
                        if event.kind == PointerEventKind.up {
                            root.details-dragging = false;
                        }
                    }
                    moved => {
                        root.details-width = clamp(root.press-width - (parent.x + self.mouse-x - root.press-x), 320px, 440px);
                    }
                }
            }
            // details aside
            if root.selected-index >= 0 : details := Rectangle {
                // 与蜂巢 .tt-details 对齐：clamp(320px, 38%, 440px) +
                // max-width(100% - 280px) + 左侧 border-2。
                width: clamp(min(root.details-width, root.width - 280px), 320px, 440px);
                x: parent.width - self.width;
                y: 0px;
                height: parent.height;
                min-width: 0px;
                background: white;
                clip: true;
                VerticalLayout {
                    x: 0.5px; width: parent.width - 0.5px;
                    spacing: 0px;
                    // header
                    HorizontalLayout {
                        height: 41px;
                        padding-left: 12px; padding-right: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: header-badge.preferred-width + 10px; height: 19px;
                            y: (42px - self.height) / 2;
                            border-radius: 4px;
                            background: TrajTokens.kind-soft(root.detail-kind);
                            header-badge := TrajText {
                                x: 5px; height: parent.height;
                                text: root.detail-badge;
                                color: TrajTokens.badge-color(root.detail-kind);
                                font-size: 10px; font-weight: 650;
                                letter-spacing: 0.35px;
                                vertical-alignment: center;
                            }
                        }
                        TrajText {
                            height: parent.height;
                            text: root.detail-header;
                            color: TrajTokens.text-3;
                            font-family: Theme.font-mono;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 4px;
                            y: 7px;
                            background: close-touch.has-hover ? TrajTokens.hover : transparent;
                            Image { x: 8px; y: 8px; width: 12px; height: 12px; source: @image-url("../assets/icons/xmark.svg"); colorize: close-touch.has-hover ? TrajTokens.text : TrajTokens.text-3; }
                            close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-row(-1); } }
                        }
                    }
                    Rectangle { height: 1px; background: TrajTokens.border-1; }
                    // tabs (underline style)
                    HorizontalLayout {
                        height: 33px;
                        padding-left: 4px; padding-right: 4px;
                        spacing: 0px;
                        alignment: start;
                        for tab in root.detail-tabs : Rectangle {
                            width: tab-title.preferred-width + 18px;
                            tab-title := TrajText {
                                x: 9px;
                                height: parent.height;
                                text: tab.title;
                                color: root.detail-tab == tab.kind ? TrajTokens.brand : tab-touch.has-hover ? TrajTokens.text : TrajTokens.text-2;
                                font-size: 12px; font-weight: root.detail-tab == tab.kind ? 500 : 400;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                x: 9px; y: parent.height - 1px;
                                width: parent.width - 18px;
                                height: 2px;
                                border-radius: 1px;
                                background: root.detail-tab == tab.kind ? TrajTokens.brand : transparent;
                            }
                            tab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-tab(tab.kind); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: TrajTokens.border-1; }
                    // tab body
                    detail-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: as-needed;
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        VerticalLayout {
                            width: detail-scroll.visible-width;
                            min-width: 0px;
                            padding: 0px;
                            spacing: 0px;
                            alignment: start;
                            // overview key/value rows
                            if root.overview-rows.length > 0 : VerticalLayout {
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 0px;
                                for entry in root.overview-rows : Rectangle {
                                    height: max(22px, overview-value.preferred-height);
                                    HorizontalLayout {
                                        height: parent.height;
                                        padding-left: 14px; padding-right: 14px;
                                        spacing: 8px;
                                        TrajText {
                                            width: 94px; height: 22px;
                                            text: entry.label;
                                            color: TrajTokens.text-3;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        overview-value := TrajTextInput {
                                            height: self.preferred-height;
                                            text: entry.value;
                                            color: TrajTokens.text;
                                            font-size: 13px;
                                            read-only: true; single-line: false;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            selection-background-color: TrajTokens.brand-soft;
                                            selection-foreground-color: TrajTokens.text;
                                        }
                                    }
                                }
                            }
                            // content sections (input / output / params / result / schema)
                            for section in root.sections : section-card := Rectangle {
                                private property <bool> expanded: true;
                                private property <int> shown-record: root.selected-index;
                                changed shown-record => { self.expanded = true; }
                                private property <bool> code: root.detail-tab == 2 || root.detail-tab == 3 || root.detail-tab == 4;
                                private property <bool> show-heading: root.detail-tab == 0;
                                height: (self.show-heading ? 24.5px : 0px) + (self.expanded ? section-scroll.height : 0px);
                                background: white;
                                if section-card.show-heading : Rectangle {
                                    x: 0px; y: 0px; width: parent.width; height: 1px;
                                    background: TrajTokens.border-1;
                                }
                                if section-card.show-heading : Rectangle {
                                    x: 0px; y: 0.5px; width: parent.width; height: 24px;
                                    HorizontalLayout {
                                        height: parent.height;
                                        padding-left: 14px; padding-bottom: 3px;
                                        spacing: 4px; alignment: start;
                                        TrajText {
                                            height: parent.height;
                                            text: section.title;
                                            color: TrajTokens.text;
                                            font-size: 13px; font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 8px; height: parent.height;
                                            Image {
                                                x: 0px; y: (parent.height - 8px) / 2;
                                                width: 8px; height: 8px;
                                                source: section-card.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg");
                                                colorize: TrajTokens.text-3;
                                            }
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { section-card.expanded = !section-card.expanded; }
                                    }
                                }
                                section-scroll := ScrollView {
                                    visible: section-card.expanded;
                                    x: 0px; y: section-card.show-heading ? 24.5px : 0px;
                                    width: parent.width;
                                    height: min(280px, section-content.preferred-height + (section-card.code ? 28px : 54px));
                                    horizontal-scrollbar-policy: always-off;
                                    vertical-scrollbar-policy: as-needed;
                                    content-width: self.visible-width;
                                    content-height: section-content.preferred-height + (section-card.code ? 28px : 54px);
                                    Rectangle {
                                        width: section-scroll.visible-width;
                                        height: section-content.preferred-height + (section-card.code ? 28px : 54px);
                                        background: section-card.code ? TrajTokens.code-bg : white;
                                        ContextMenuArea {
                                            Menu {
                                                MenuItem { title: @tr("Copy"); activated => { section-content.copy(); } }
                                                MenuItem { title: @tr("Select All"); activated => { section-content.select-all(); } }
                                            }
                                            section-content := TrajTextInput {
                                                x: 14px; y: section-card.code ? 14px : 25px;
                                                width: section-scroll.visible-width - 28px;
                                                height: self.preferred-height;
                                                text: section.body;
                                                read-only: true; single-line: false;
                                                wrap: word-wrap;
                                                font-family: section-card.code ? Theme.font-mono : "Segoe UI";
                                                font-size: section-card.code ? 12px : 13px;
                                                line-height-factor: section-card.code ? 1.05 : 1.18;
                                                color: TrajTokens.text;
                                                selection-background-color: TrajTokens.brand-soft;
                                                selection-foreground-color: TrajTokens.text;
                                            }
                                        }
                                    }
                                }
                            }
                            // timing rows
                            if root.timing-rows.length > 0 : VerticalLayout {
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 0px;
                                for timing in root.timing-rows : Rectangle {
                                    height: max(22px, timing-value.preferred-height);
                                    HorizontalLayout {
                                        height: parent.height;
                                        padding-left: 14px; padding-right: 14px;
                                        spacing: 8px;
                                        TrajText {
                                            width: 94px; height: 22px;
                                            text: timing.label;
                                            color: TrajTokens.text-3;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        timing-value := TrajTextInput {
                                            height: self.preferred-height;
                                            text: timing.value;
                                            color: TrajTokens.text;
                                            font-size: 13px;
                                            read-only: true; single-line: false;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            selection-background-color: TrajTokens.brand-soft;
                                            selection-foreground-color: TrajTokens.text;
                                        }
                                    }
                                }
                            }
                            // raw tab; the list contents are tab-scoped by the
                            // Rust projection, raw shows only when filled
                            if root.raw-text != "" : Rectangle {
                                height: raw-content.preferred-height + 28px;
                                background: TrajTokens.code-bg;
                                ContextMenuArea {
                                    Menu {
                                        MenuItem { title: @tr("Copy"); activated => { raw-content.copy(); } }
                                        MenuItem { title: @tr("Select All"); activated => { raw-content.select-all(); } }
                                    }
                                    raw-content := TrajTextInput {
                                        x: 14px; y: 14px;
                                        width: parent.width - 28px;
                                        height: self.preferred-height;
                                        text: root.raw-text;
                                        read-only: true; single-line: false;
                                        wrap: word-wrap;
                                        font-family: Theme.font-mono;
                                        font-size: 12px;
                                        line-height-factor: 1.05;
                                        color: TrajTokens.text;
                                        selection-background-color: TrajTokens.brand-soft;
                                        selection-foreground-color: TrajTokens.text;
                                    }
                                }
                            }
                        }
                    }
                }
                // Paint after the white section backgrounds so the divider
                // remains continuous for the entire inspector height.
                Rectangle { x: 0px; y: 0px; width: 0.5px; height: parent.height; background: TrajTokens.border-2; }
            }
        }
    }

    // tooltip card; lives above the track, no TouchArea so it never
    // steals hover from the span underneath
    if root.hover-index >= 0 && root.tooltip-text != "" : Rectangle {
        x: clamp(44px + root.hover-mx + 12px, 0px, root.width - self.width);
        y: clamp(32px + root.hover-my + 12px, 0px, root.height - self.height);
        width: min(320px, tooltip-lines.preferred-width + 16px);
        height: tooltip-lines.preferred-height + 10px;
        background: white;
        border-radius: 4px;
        border-width: 0.5px; border-color: TrajTokens.border-3;
        drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #0F11151F;
        tooltip-lines := TrajText {
            x: 8px; y: 5px;
            width: parent.width - 16px;
            text: root.tooltip-text;
            color: TrajTokens.text;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
