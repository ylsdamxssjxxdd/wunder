import { TerminalView, TermSpan } from "terminal_view.slint";
import { I18n } from "i18n.slint";
import { Action } from "components.slint";

// A real desktop window keeps the terminal's focus, sizing and keyboard input
// independent from the chat composer. The shell itself remains owned by the
// native runtime; this component only projects its screen and sends commands.
export component TerminalWindow inherits Window {
    title: I18n.cp_terminal_panel_title;
    width: 980px;
    height: 640px;
    background: #16181d;
    init => { input-sink.focus(); }
    in property <string> workspace-name;
    in property <string> workspace-root;
    in property <[TermSpan]> spans;
    in property <string> status;
    in property <bool> error: false;
    in property <int> rows: 24;
    in property <int> cols: 80;
    in property <int> view-offset: 0;
    in property <int> history-depth: 0;
    in property <bool> caret-visible: false;
    in property <bool> mouse-reporting: false;
    in property <bool> application-cursor: false;
    in property <bool> input-ready: false;
    in property <int> caret-row: 0;
    in property <int> caret-col: 0;
    in-out property <int> measured-cols: 0;
    in-out property <int> measured-rows: 0;
    in-out property <int> paste-request: 0;

    callback clear();
    callback interrupt();
    callback scrolled(int);
    callback scroll-to(int);
    callback geometry-changed();
    callback key-input(string);
    callback frame-ready();
    callback pasted(string);
    callback paste-requested();
    callback mouse-event(int, int, int, int);
    callback exit-requested();
    public function focus-input() { input-sink.focus(); }
    changed measured-cols => { root.geometry-changed(); }
    changed measured-rows => { root.geometry-changed(); }
    changed paste-request => {
        clipboard.text = "";
        clipboard.focus();
        clipboard.paste();
        input-sink.focus();
    }

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        changed text => {
            if self.text != "" {
                root.pasted(self.text);
                self.text = "";
                input-sink.focus();
            }
        }
    }

    terminal-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if clipboard.has-focus { return reject; }
            if !input-sink.has-focus { return reject; }
            if !root.input-ready { return accept; }
            if event.text == Key.Control || event.text == Key.ControlR || event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta { return reject; }
            if event.modifiers.shift && event.text == Key.PageUp { root.scrolled(root.rows - 1); return accept; }
            if event.modifiers.shift && event.text == Key.PageDown { root.scrolled(1 - root.rows); return accept; }
            if event.text == Key.Return { root.key-input("\u{d}"); return accept; }
            if event.text == Key.Backspace { root.key-input(event.modifiers.control ? "\u{17}" : event.modifiers.alt ? "\u{1b}\u{7f}" : "\u{7f}"); return accept; }
            if event.text == Key.Tab { root.key-input(event.modifiers.shift ? "\u{1b}[Z" : "\u{9}"); return accept; }
            if event.text == Key.Escape { root.key-input("\u{1b}"); return accept; }
            let modifier = 1 + (event.modifiers.shift ? 1 : 0) + (event.modifiers.alt ? 2 : 0) + (event.modifiers.control ? 4 : 0);
            if event.text == Key.LeftArrow { root.key-input(modifier > 1 ? "\u{1b}[1;\{modifier}D" : root.application-cursor ? "\u{1b}OD" : "\u{1b}[D"); return accept; }
            if event.text == Key.RightArrow { root.key-input(modifier > 1 ? "\u{1b}[1;\{modifier}C" : root.application-cursor ? "\u{1b}OC" : "\u{1b}[C"); return accept; }
            if event.text == Key.UpArrow { root.key-input(modifier > 1 ? "\u{1b}[1;\{modifier}A" : root.application-cursor ? "\u{1b}OA" : "\u{1b}[A"); return accept; }
            if event.text == Key.DownArrow { root.key-input(modifier > 1 ? "\u{1b}[1;\{modifier}B" : root.application-cursor ? "\u{1b}OB" : "\u{1b}[B"); return accept; }
            if event.text == Key.Home { root.key-input("\u{1b}[H"); return accept; }
            if event.text == Key.End { root.key-input("\u{1b}[F"); return accept; }
            if event.text == Key.PageUp { root.key-input("\u{1b}[5~"); return accept; }
            if event.text == Key.PageDown { root.key-input("\u{1b}[6~"); return accept; }
            if event.text == Key.Delete { root.key-input("\u{1b}[3~"); return accept; }
            if event.modifiers.shift && event.text == Key.Insert { root.paste-requested(); return accept; }
            if event.text == Key.Insert { root.key-input("\u{1b}[2~"); return accept; }
            if event.text == Key.F1 { root.key-input("\u{1b}OP"); return accept; }
            if event.text == Key.F2 { root.key-input("\u{1b}OQ"); return accept; }
            if event.text == Key.F3 { root.key-input("\u{1b}OR"); return accept; }
            if event.text == Key.F4 { root.key-input("\u{1b}OS"); return accept; }
            if event.text == Key.F5 { root.key-input("\u{1b}[15~"); return accept; }
            if event.text == Key.F6 { root.key-input("\u{1b}[17~"); return accept; }
            if event.text == Key.F7 { root.key-input("\u{1b}[18~"); return accept; }
            if event.text == Key.F8 { root.key-input("\u{1b}[19~"); return accept; }
            if event.text == Key.F9 { root.key-input("\u{1b}[20~"); return accept; }
            if event.text == Key.F10 { root.key-input("\u{1b}[21~"); return accept; }
            if event.text == Key.F11 { root.key-input("\u{1b}[23~"); return accept; }
            if event.text == Key.F12 { root.key-input("\u{1b}[24~"); return accept; }
            if event.modifiers.control && event.text == " " { root.key-input("\u{0}"); return accept; }
            if event.modifiers.control && event.text == "[" { root.key-input("\u{1b}"); return accept; }
            if event.modifiers.control && (event.text == "v" || event.text == "V") { root.paste-requested(); return accept; }
            if event.modifiers.control && (event.text == "a" || event.text == "A") { root.key-input("\u{1}"); return accept; }
            if event.modifiers.control && (event.text == "b" || event.text == "B") { root.key-input("\u{2}"); return accept; }
            if event.modifiers.control && (event.text == "c" || event.text == "C") { root.key-input("\u{3}"); return accept; }
            if event.modifiers.control && (event.text == "d" || event.text == "D") { root.key-input("\u{4}"); return accept; }
            if event.modifiers.control && (event.text == "e" || event.text == "E") { root.key-input("\u{5}"); return accept; }
            if event.modifiers.control && (event.text == "l" || event.text == "L") { root.key-input("\u{c}"); return accept; }
            if event.modifiers.control && (event.text == "u" || event.text == "U") { root.key-input("\u{15}"); return accept; }
            if event.modifiers.control && (event.text == "w" || event.text == "W") { root.key-input("\u{17}"); return accept; }
            if event.modifiers.control && (event.text == "z" || event.text == "Z") { root.key-input("\u{1a}"); return accept; }
            if event.modifiers.control && event.text == "\\" { root.key-input("\u{1c}"); return accept; }
            if event.modifiers.control && (event.text == "f" || event.text == "F") { root.key-input("\u{6}"); return accept; }
            if event.modifiers.control && (event.text == "g" || event.text == "G") { root.key-input("\u{7}"); return accept; }
            if event.modifiers.control && (event.text == "h" || event.text == "H") { root.key-input("\u{8}"); return accept; }
            if event.modifiers.control && (event.text == "i" || event.text == "I") { root.key-input("\u{9}"); return accept; }
            if event.modifiers.control && (event.text == "j" || event.text == "J") { root.key-input("\u{a}"); return accept; }
            if event.modifiers.control && (event.text == "k" || event.text == "K") { root.key-input("\u{b}"); return accept; }
            if event.modifiers.control && (event.text == "m" || event.text == "M") { root.key-input("\u{d}"); return accept; }
            if event.modifiers.control && (event.text == "n" || event.text == "N") { root.key-input("\u{e}"); return accept; }
            if event.modifiers.control && (event.text == "o" || event.text == "O") { root.key-input("\u{f}"); return accept; }
            if event.modifiers.control && (event.text == "p" || event.text == "P") { root.key-input("\u{10}"); return accept; }
            if event.modifiers.control && (event.text == "q" || event.text == "Q") { root.key-input("\u{11}"); return accept; }
            if event.modifiers.control && (event.text == "r" || event.text == "R") { root.key-input("\u{12}"); return accept; }
            if event.modifiers.control && (event.text == "s" || event.text == "S") { root.key-input("\u{13}"); return accept; }
            if event.modifiers.control && (event.text == "t" || event.text == "T") { root.key-input("\u{14}"); return accept; }
            if event.modifiers.control && (event.text == "x" || event.text == "X") { root.key-input("\u{18}"); return accept; }
            if event.modifiers.control && (event.text == "y" || event.text == "Y") { root.key-input("\u{19}"); return accept; }
            if event.modifiers.alt && event.text != "" { root.key-input("\u{1b}" + event.text); return accept; }
            // Standard TextInput receives committed text/IME; it is only an
            // invisible input-method sink, never a local command line.
            if event.modifiers.control { return accept; }
            reject
        }
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;
        Rectangle {
            height: 42px;
            background: #1f252e;
            HorizontalLayout {
                padding-left: 14px; padding-right: 8px; spacing: 10px;
                VerticalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    Text { text: root.workspace-name != "" ? root.workspace-name : I18n.cp_terminal_panel_title; color: #e8eef5; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    Text { text: root.workspace-root; color: #8fa2b6; font-size: 10px; vertical-alignment: center; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status != "" ? root.status : I18n.cp_terminal_idle; color: root.error ? #f48f8f : #7fd6a0; font-size: 11px; vertical-alignment: center; }
                Action { width: 28px; height: 28px; icon: @image-url("../assets/icons/trash.svg"); icon-size: 14px; label: I18n.cp_terminal_clear; clicked => { root.clear(); input-sink.focus(); } }
                Action { width: 28px; height: 28px; icon: @image-url("../assets/icons/stop.svg"); icon-size: 14px; label: I18n.cp_terminal_interrupt; clicked => { root.interrupt(); input-sink.focus(); } }
                Action { width: 28px; height: 28px; icon: @image-url("../assets/icons/xmark.svg"); label: I18n.cp_terminal_exit; clicked => { root.exit-requested(); } }
            }
        }
        terminal := TerminalView {
            vertical-stretch: 1;
            show-header: false;
            spans: root.spans;
            status: root.status;
            error: root.error;
            rows: root.rows;
            cols: root.cols;
            view-offset: root.view-offset;
            history-depth: root.history-depth;
            caret-visible: root.caret-visible;
            mouse-reporting: root.mouse-reporting;
            application-cursor: root.application-cursor;
            caret-row: root.caret-row;
            caret-col: root.caret-col;
            clear => { root.clear(); }
            interrupt => { root.interrupt(); }
            mouse-event(action, button, col, row) => { root.mouse-event(action, button, col, row); }
            scrolled(delta) => { root.scrolled(delta); }
            scroll-to(row) => { root.scroll-to(row); }
            activated => { input-sink.focus(); }
            measured-cols <=> root.measured-cols;
            measured-rows <=> root.measured-rows;
            if root.spans.length == 0 : Text {
                x: 12px; y: 10px; width: parent.width - 24px;
                text: root.status;
                color: #8fa2b6; font-size: 12px;
            }
        }
        }
        input-sink := TextInput {
            // Keep the IME candidate near the terminal cursor. Text never
            // remains here: the real shell owns all line editing and echo.
            x: max(0px, root.caret-col * terminal.cell-width);
            y: 42px + max(0px, root.caret-row * terminal.cell-height);
            width: terminal.cell-width; height: terminal.cell-height;
            font-family: "Consolas"; font-size: 13px;
            color: transparent;
            single-line: true;
            selection-background-color: transparent;
            selection-foreground-color: transparent;
            accessible-label: I18n.cp_terminal_panel_title;
            changed text => {
                if self.text != "" {
                    if root.input-ready { root.key-input(self.text); }
                    self.text = "";
                }
            }
        }
    }
}
