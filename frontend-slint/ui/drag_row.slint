import { Theme } from "theme.slint";

// The pitch the sidebar tree lays its rows out with. The native drop resolver
// walks the same numbers, so a row height only lives in this file.
//
// 侧栏统一的排版规则（蜂巢的 messenger-shell.css 用同一组数值）：
// - 行高空出可点击余量：导航行 32px；分组行再留 4px 组间气口（chip 仍 32px）。
// - 两侧留白一致：行盒左右各让出 12px，行内再补 8px，文字从 20px 起排。
// - 图标字号（13px）不大于正文字号，落 20px 圆角底上，图文间距固定 8px。
// - 所有行、行内动作按钮共用 8px 圆角；浮层（设备菜单、拖拽浮标）10px。
// - 线程行只缩进一格：状态点列起于 28px，标题恰好接到工作区标题列（48px）。
export global SidebarMetrics {
    in-out property <length> thread-height: 32px;
    in-out property <length> group-height: 36px;
    // 分组行里 chip 顶部让出的气口：组间更松，组内行贴紧。
    in-out property <length> group-air: 4px;
    in-out property <length> gutter: 12px;
    in-out property <length> row-padding: 8px;
    in-out property <length> row-radius: 8px;
    in-out property <length> icon-glyph: 13px;
    in-out property <length> icon-tile: 20px;
    in-out property <length> icon-gap: 8px;
    // 线程行内容列（状态点左缘）距侧栏左缘。28 = 12 行盒内缩 + 16 行内距，
    // 加上 11px 状态点与 8px 图文间距后标题落在 47px，压着工作区标题的 48px。
    in-out property <length> thread-indent: 28px;
}

// Shared drag state. `anchor-y` is the window-relative pointer at press and
// `pointer-y` the live one, so a row can report how far the pointer travelled
// while every other row can still expose the insertion seam under it.
export global DragPreview {
    in-out property <bool> active: false;
    in-out property <length> pointer-y: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <length> source-y: -1px;
    in-out property <int> source-index: -1;
    in-out property <int> source-kind: -1;
    in-out property <string> source-workspace: "";
    in-out property <string> source-label: "";
}

export component DragRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <color> selected-color: Theme.accent-soft;
    // Which tree row this is, and the group it may be re-ordered within. The
    // native side resolves the drop from the reported pointer travel, so the
    // row only has to say which row was grabbed and what it holds.
    in property <int> row-index: -1;
    in property <int> row-kind: -1;
    in property <string> workspace-id: "";
    // Tooltip is attached to the row's real pointer target below. Callers can
    // describe disclosure rows without putting a Tooltip on a visual overlay.
    in property <string> tooltip: root.label;
    // Width of the hover-action band at the row's right edge. The row tooltip
    // yields there so it cannot compete with the tooltip of a button under the
    // pointer. Zero means the row has no action band.
    in property <length> actions-width: 0px;
    out property <bool> hover: touch.has-hover;
    callback activate();
    callback move-by(int);
    private property <bool> dragging: DragPreview.active && DragPreview.source-index == root.row-index;
    // Workspace headers (local and cloud) form one drag group. Threads stay
    // in their own kind and never leave the workspace they are listed under.
    private property <bool> droppable: DragPreview.active
        && root.row-index != DragPreview.source-index
        && ((root.row-kind == 0 || root.row-kind == 2)
            ? (DragPreview.source-kind == 0 || DragPreview.source-kind == 2)
            : root.row-kind == DragPreview.source-kind)
        && (root.row-kind != 1 || root.workspace-id == DragPreview.source-workspace);
    private property <bool> drop-target: root.droppable
        && DragPreview.pointer-y >= root.absolute-position.y
        && DragPreview.pointer-y < root.absolute-position.y + root.height;
    private property <bool> insert-after: DragPreview.pointer-y >= root.absolute-position.y + root.height / 2;
    border-radius: Theme.radius-lg;
    background: root.selected ? root.selected-color : touch.has-hover || touch.pressed ? Theme.accent-soft : transparent;
    border-width: root.dragging ? 1px : 0px;
    border-color: Theme.accent-ink;
    opacity: root.dragging ? 0.45 : 1;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.activate(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.activate(); return accept; }
            return reject;
        }
    }
    // The row content lives *inside* the row's TouchArea, not beside it: a
    // hover-revealed button that is a sibling on top takes the event out of the
    // path stack, the row then gets an Exit for a pointer still inside its
    // geometry, the button vanishes and the two states oscillate (and the click
    // never lands). As an ancestor the row keeps its hover while any descendant
    // holds the pointer, and a press on a button still never reaches the row.
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: root.dragging ? move : pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                DragPreview.anchor-y = root.absolute-position.y + self.mouse-y;
                DragPreview.pointer-y = DragPreview.anchor-y;
                DragPreview.source-y = root.absolute-position.y;
                DragPreview.source-index = root.row-index;
                DragPreview.source-kind = root.row-kind;
                DragPreview.source-workspace = root.workspace-id;
                DragPreview.source-label = root.label;
                DragPreview.active = false;
                focus.focus();
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if DragPreview.active {
                    // Travel in px, not rows: the tree mixes taller group rows
                    // with thread rows, so only the native side can turn
                    // the travel into the row the pointer actually sits in.
                    root.move-by(round((DragPreview.pointer-y - DragPreview.anchor-y) / 1px));
                } else {
                    root.activate();
                }
                DragPreview.active = false;
                DragPreview.source-index = -1;
                DragPreview.source-kind = -1;
                DragPreview.source-workspace = "";
                DragPreview.source-label = "";
                DragPreview.source-y = -1px;
            }
            if event.kind == PointerEventKind.cancel {
                DragPreview.active = false;
                DragPreview.source-index = -1;
                DragPreview.source-kind = -1;
                DragPreview.source-workspace = "";
                DragPreview.source-label = "";
                DragPreview.source-y = -1px;
            }
        }
        // While a button is down Slint keeps sending the moves to this area,
        // so `pointer-y` follows the cursor across the whole list.
        moved => {
            DragPreview.pointer-y = root.absolute-position.y + self.mouse-y;
            if self.pressed && abs(DragPreview.pointer-y - DragPreview.anchor-y) > 6px {
                DragPreview.active = true;
            }
        }
        @children
        if root.tooltip != "" && !(root.actions-width > 0px && touch.mouse-x >= root.width - root.actions-width) : Tooltip { text: @markdown("\{root.tooltip}"); }
    }
    // Target rows show a highlighted seam that animates from before to after.
    if root.drop-target : Rectangle {
        x: 2px;
        y: root.insert-after ? parent.height - 2px : 0px;
        width: parent.width - 4px;
        height: 2px;
        z: 100;
        background: Theme.accent;
        opacity: 0.96;
        animate y { duration: 110ms; easing: ease-out; }
    }
    if root.drop-target : Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        z: 99;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent-ink.transparentize(0.6);
        background: Theme.accent.transparentize(0.91);
        opacity: 0.9;
        animate opacity { duration: 100ms; easing: ease-out; }
    }
}
