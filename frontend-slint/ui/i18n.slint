    out property <string> ws_btn_cancel: zh ? "取消" : "Cancel";
    out property <string> ws_btn_create: zh ? "创建工作区" : "Create workspace";
    out property <string> ws_btn_save: zh ? "保存" : "Save";
    out property <string> ws_delete_body: zh ? "将解除工作区与文件夹的绑定，不会删除磁盘上的任何文件。请选择该工作区中线程的处理方式：" : "The workspace binding is removed; nothing on disk is deleted. Choose what happens to its threads:";
    out property <string> ws_delete_archive: zh ? "归档全部线程" : "Archive all threads";
    out property <string> ws_delete_archive_hint: zh ? "推荐，文件保持原样" : "Recommended; files stay untouched";
    out property <string> ws_delete_records: zh ? "删除线程记录" : "Delete thread records";
    out property <string> ws_delete_records_hint: zh ? "仅删除会话记录，磁盘文件保留" : "Removes session records only; files stay";
    out property <string> ws_btn_delete: zh ? "删除" : "Delete";
    out property <string> ws_pick_title: zh ? "选择工作区文件夹" : "Choose a workspace folder";
}
