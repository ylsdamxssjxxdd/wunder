// Current web timeline: light, compact tool rows inside a capped process.
import { Theme, ProcessEntry } from "theme.slint";
import { ProcessStatusIcon } from "status_icon.slint";
import { I18n } from "i18n.slint";
import { ToolIcons } from "tool_icons.slint";
import { WorkflowDetail } from "workflow_detail.slint";
import { PatchDiffCard } from "patch_diff_card.slint";
import { MarkdownBlock } from "markdown.slint";
import { ListView, ScrollView } from "std-widgets.slint";

component ProcessEntryCard inherits Rectangle {
    in property <ProcessEntry> entry;
    callback toggle(int);
    callback copy-text(string);
    callback open-resource(string);
    height: column.preferred-height;
    column := VerticalLayout {
        spacing: 0px;
        if root.entry.kind == 1 : VerticalLayout {
            padding-left: 24px; padding-right: 24px;
            padding-top: 6px; padding-bottom: 6px; spacing: 6px;
            for block in root.entry.blocks : MarkdownBlock {
                block: block;
                copy-code(text) => { root.copy-text(text); }
                open-resource(path) => { root.open-resource(path); }
            }
            if root.entry.blocks.length == 0 : TextInput {
                text: root.entry.text; read-only: true; wrap: word-wrap;
                color: Theme.text; font-size: Theme.font-lg;
            }
        }
        if root.entry.kind != 1 : Rectangle {
            height: 26px;
            border-radius: Theme.radius-tag;
            background: hit.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.entry.tool-name + " " + root.entry.summary;
            accessible-action-default => { root.toggle(root.entry.payload); }
            forward-focus: focus;
            focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == Key.Return {
                        root.toggle(root.entry.payload); return accept;
                    }
                    return reject;
                }
            }
            // Content is above the header hit area, so the file chip owns its click.
            hit := TouchArea {
                x: 44px; width: parent.width - 68px;
                mouse-cursor: pointer;
                clicked => { focus.focus(); root.toggle(root.entry.payload); }
            }
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; spacing: 8px;
                Rectangle {
                    width: 20px;
                    Rectangle {
                        x: 9.5px; y: 0px; width: 1px; height: parent.height;
                        background: Theme.timeline-line;
                    }
                    ProcessStatusIcon {
                        x: 3.5px; y: 7px; status: root.entry.status-kind;
                    }
                }
                if root.entry.tool-icon != "" : Image {
                    y: 6.5px; width: 13px; height: 13px;
                    source: ToolIcons.image(root.entry.tool-icon);
                    colorize: Theme.muted;
                }
                Text {
                    width: min(164px, self.preferred-width);
                    height: parent.height; text: root.entry.tool-name;
                    color: Theme.muted; font-size: Theme.font-md;
                    overflow: elide; vertical-alignment: center;
                }
                if root.entry.target != "" : Rectangle {
                    y: 4px; height: 18px;
                    width: min(target-text.preferred-width + 14px, root.width < 650px ? 108px : 180px);
                    border-radius: Theme.radius-tag;
                    background: target-hit.has-hover ? Theme.selected : Theme.hover;
                    accessible-role: button; accessible-label: root.entry.target;
                    accessible-action-default => { root.open-resource(root.entry.target); }
                    forward-focus: target-focus;
                    target-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == " " || event.text == Key.Return { root.open-resource(root.entry.target); return accept; }
                            return reject;
                        }
                    }
                    target-text := Text {
                        x: 7px; width: parent.width - 14px; height: parent.height;
                        text: root.entry.target; color: Theme.muted; font-size: Theme.font-sm;
                        overflow: elide; vertical-alignment: center;
                    }
                    target-hit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { target-focus.focus(); root.open-resource(root.entry.target); }
                    }
                    Tooltip { text: @markdown("\{root.entry.target}"); }
                }
                Text {
                    horizontal-stretch: 1; min-width: 0px; height: parent.height;
                    text: root.entry.summary;
                    color: Theme.timeline-entry-soft; font-size: Theme.font-sm;
                    overflow: elide; vertical-alignment: center;
                }
                if root.entry.tokens != "" : Text {
                    width: self.preferred-width; height: parent.height;
                    text: root.entry.tokens; color: Theme.muted;
                    font-size: Theme.font-xs; font-family: Theme.font-mono;
                    vertical-alignment: center;
                }
                if root.entry.duration != "" : Text {
                    width: self.preferred-width; height: parent.height;
                    text: root.entry.duration; color: Theme.muted;
                    font-size: Theme.font-xs; font-family: Theme.font-mono;
                    vertical-alignment: center;
                }
            }

        }
        if root.entry.open && root.entry.kind != 1 : VerticalLayout {
            padding-left: 44px; padding-right: 24px;
            padding-top: 4px; padding-bottom: 8px;
            spacing: 8px;
            for patch in root.entry.patch : PatchDiffCard { card: patch; }
            if root.entry.patch.length == 0 : Rectangle {
                height: min(240px, detail.preferred-height + 16px);
                background: Theme.panel; border-width: 1px;
                border-color: Theme.border; border-radius: Theme.radius-sm;
                private property <bool> follow-tail: true;
                private property <string> revision: root.entry.detail;
                private property <bool> scroll-pending: true;
                changed revision => { self.scroll-pending = true; }
                Timer {
                    interval: 33ms; running: parent.scroll-pending;
                    triggered => {
                        parent.scroll-pending = false;
                        if parent.follow-tail && root.entry.status-kind == 1 {
                            detail-scroll.content-y = min(0px, detail-scroll.visible-height - detail-scroll.content-height);
                        }
                    }
                }
                detail-scroll := ScrollView {
                    x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: as-needed;
                    content-width: self.visible-width;
                    // A ScrollView only infers its content size from *layout*
                    // children. This one is a component, so without the explicit
                    // height `content-height` collapsed to the viewport: the
                    // scrollbar never appeared and a long output was clipped at
                    // the 240px cap with no way to reach the rest of it. State
                    // the height the way the transcript scroll does.
                    content-height: max(self.visible-height, detail.preferred-height);
                    detail := WorkflowDetail {
                        width: detail-scroll.visible-width;
                        sections: root.entry.sections;
                        fallback: root.entry.detail;
                        copy(text) => { root.copy-text(text); }
                    }
                    scrolled => {
                        parent.follow-tail = self.visible-height - self.content-height - self.content-y >= -24px;
                    }
                }
            }
        }
    }
}

export component ToolProcess inherits Rectangle {
    in property <[ProcessEntry]> entries;
    in property <bool> paged;
    in property <bool> has-older;
    in property <bool> has-newer;
    in property <bool> loading;
    in property <bool> failed;
    in property <int> revision;
    in property <bool> active;
    in property <bool> live;
    callback page(int);
    in property <length> viewport-limit: Theme.workflow-height;
    callback toggle(int);
    callback copy-text(string);
    callback open-resource(string);
    // Grow naturally for a few entries; long processes keep their own scroll.
    // There is no "later" pager button (the tail auto-follows), and no
    // "earlier" button either: scrolling past the top loads the older page,
    // so the list is the only control the reader needs. Only a failed load
    // keeps a strip, because retrying needs an explicit target.
    height: min(root.viewport-limit, root.viewport-height + page-top.height);
    Timer {
        interval: 33ms;
        running: root.active && !root.paged && !root.loading && !root.failed;
        triggered => { root.page(0); }
    }
    Timer {
        interval: 1500ms;
        running: root.active && root.live && root.paged && !root.has-newer && !root.loading && !root.failed;
        triggered => { root.page(2); }
    }
    changed revision => {
        root.follow-tail = !root.has-newer;
        root.scroll-pending = true;
        root.page-pending = true;
    }
    private property <length> viewport-height: min(Theme.workflow-height, max(26px, root.entries.length * 26px));
    private property <length> measured-height: process-list.content-height;
    changed measured-height => {
        root.viewport-height = min(Theme.workflow-height, max(26px, root.measured-height));
    }
    private property <bool> follow-tail: true;
    private property <bool> scroll-pending: true;
    private property <bool> page-pending: false;
    private property <int> count: root.entries.length;
    // Row that the reader is holding when an older page is asked for: after
    // the page lands, that same row must stay where it was on screen.
    private property <length> anchor-y: 0px;
    private property <length> anchor-height: 0px;
    // Previous scroll offset, so one flick past the top asks for the older
    // page exactly once instead of once per scroll notification.
    private property <length> last-content-y: 0px;
    // Set while an older page is in flight: the list must hold the reader's
    // row instead of following the tail, even when the tail was in view.
    private property <bool> anchor-hold: false;
    changed count => { root.scroll-pending = true; }
    changed failed => { if (root.failed) { root.anchor-hold = false; } }
    Timer {
        interval: 33ms; running: root.scroll-pending;
        triggered => {
            root.scroll-pending = false;
            if root.page-pending && root.revision < 0 {
                // An older page was prepended: shift by the height it added so
                // the anchored row keeps its place.
                process-list.content-y = root.anchor-y - max(0px, process-list.content-height - root.anchor-height);
                root.anchor-hold = false;
            } else if root.page-pending && root.revision > 0 && root.has-newer {
                process-list.content-y = 0px;
            } else if root.follow-tail && !root.anchor-hold && root.entries.length > 0 {
                process-list.content-y = min(0px, process-list.visible-height - process-list.content-height);
            } else if root.page-pending && root.revision > 0 {
                process-list.content-y = 0px;
            }
            root.page-pending = false;
        }
    }
    process-list := ListView {
        y: page-top.height;
        width: parent.width; height: parent.height - page-top.height;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: as-needed;
        content-width: self.visible-width;
        for entry in root.entries : ProcessEntryCard {
            width: process-list.visible-width;
            entry: entry;
            toggle(index) => { root.toggle(index); }
            copy-text(text) => { root.copy-text(text); }
            open-resource(path) => { root.open-resource(path); }
        }
        scrolled => {
            root.follow-tail = self.visible-height - self.content-height - self.content-y >= -32px;
            // Reaching the top is the request for the older page.
            if root.has-older && !root.loading && !root.failed
                && self.content-y >= -4px && root.last-content-y < -4px {
                root.anchor-y = self.content-y;
                root.anchor-height = self.content-height;
                root.anchor-hold = true;
                root.page(-1);
            }
            root.last-content-y = self.content-y;
        }
    }
    // Retry is the one pager affordance left: a failed load cannot be asked
    // for again by scrolling, because the reader is already at the top.
    page-top := Rectangle {
        x: 24px; y: 0px; width: parent.width - 48px;
        height: root.failed ? 20px : 0px;
        border-radius: Theme.radius-tag;
        background: retry-hit.has-hover ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: I18n.tl_process_retry;
        accessible-action-default => { root.page(0); }
        Text {
            width: parent.width; height: parent.height;
            text: I18n.tl_process_retry; color: Theme.danger; font-size: Theme.font-xs;
            horizontal-alignment: center; vertical-alignment: center;
        }
        retry-hit := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.page(0); }
        }
    }
    // Loading a page is reported in place, without taking layout height: the
    // reader's scroll position must not jump while the page is in flight.
    if root.loading : Rectangle {
        x: (parent.width - loading-label.preferred-width - 16px) / 2;
        y: 3px;
        width: loading-label.preferred-width + 16px; height: 18px;
        border-radius: Theme.radius-tag;
        background: Theme.panel;
        border-width: 1px; border-color: Theme.border;
        loading-label := Text {
            width: parent.width; height: parent.height;
            text: I18n.tl_process_loading; color: Theme.muted; font-size: Theme.font-xs;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
