// Two-column workspace layout, left column: the workspace/thread tree and
// the settings button. The window shell owns the
// width (drag handle on the right edge); the chat area adapts on the right.
// Row states, the selection indicator and the hover-only row actions follow
// the workspace refactor spec (§5.2). The tree is one flat row model built by
// the native projection, so the Slint thread only lays out rows; rows
// drag-reorder through `move-row`.
import { Theme, SidebarRow, WorkspaceFileRow } from "theme.slint";
import { I18n } from "i18n.slint";
import { ListView } from "std-widgets.slint";
import { DragRow, DragPreview, SidebarMetrics } from "drag_row.slint";
import { WorkspaceFilesPanel } from "workspace_files.slint";
import { RuntimeStatus } from "runtime_status.slint";

// Resolve a workspace icon name to a bundled icon; unknown names fall back
// to the generic folder so a stale icon string can never blank a row. Slint
// has no top-level free functions, so the resolvers live in a global that the
// sidebar and the workspace dialog both call.
export global WorkspaceVisual {
    public pure function icon(name: string) -> image {
        name == "monitor" ? @image-url("../assets/icons/workspace/monitor.svg")
        : name == "martini" ? @image-url("../assets/icons/workspace/martini.svg")
        : name == "cookie" ? @image-url("../assets/icons/workspace/cookie.svg")
        : name == "pyramid" ? @image-url("../assets/icons/workspace/pyramid.svg")
        : name == "camera" ? @image-url("../assets/icons/workspace/camera.svg")
        : name == "heart" ? @image-url("../assets/icons/workspace/heart.svg")
        : name == "cake" ? @image-url("../assets/icons/workspace/cake.svg")
        : name == "robot" ? @image-url("../assets/icons/workspace/robot.svg")
        : name == "gear" ? @image-url("../assets/icons/workspace/gear.svg")
        : name == "coffee" ? @image-url("../assets/icons/workspace/coffee.svg")
        : name == "ghost" ? @image-url("../assets/icons/workspace/ghost.svg")
        : name == "alien" ? @image-url("../assets/icons/workspace/alien.svg")
        : name == "bell" ? @image-url("../assets/icons/workspace/bell.svg")
        : name == "flask" ? @image-url("../assets/icons/workspace/flask.svg")
        : name == "cloud" ? @image-url("../assets/icons/workspace/cloud.svg")
        : @image-url("../assets/icons/workspace/folder.svg");
    }

    // Slint has no string→color conversion, so the palette ships as explicit
    // branches (§6.3); unknown names fall back to gray.
    public pure function color(name: string) -> color {
        name == "red" ? #CD484F
        : name == "green" ? #4CAF50
        : name == "blue" ? #1F76AF
        : name == "brown" ? #8D6E3C
        : name == "crimson" ? #A93226
        : name == "pink" ? #E45B9C
        : name == "purple" ? #6F6AED
        : name == "yellow" ? #F5C518
        : name == "orange" ? #FA8C38
        : name == "teal" ? #17B8A6
        : name == "bright-blue" ? #1799FE
        : name == "gray" ? #9AA0A6
        : name == "black" ? #1F2329
        : name == "light-purple" ? #B39DDB
        : name == "light-green" ? #81C784
        : #9AA0A6;
    }

    public pure function icon-keys() -> [string] {
        ["folder", "monitor", "martini", "cake", "cookie", "pyramid", "alien", "camera", "gear",
         "coffee", "heart", "robot", "ghost", "bell", "flask"]
    }

    public pure function color-keys() -> [string] {
        ["red", "green", "blue", "brown", "crimson", "pink", "purple", "yellow", "orange",
         "teal", "bright-blue", "gray", "black", "light-purple", "light-green"]
    }
}

// Compact thread glyphs keep the 28px tree rhythm while distinguishing phases.
component StatusDot inherits Rectangle {
    in property <string> status;
    // Phase decided by the backend (`runtime_phase::Phase`), -1 when the row
    // is not a thread. A live phase always wins over the phrase table.
    in property <int> phase: -1;
    width: 11px; height: 11px;
    private property <bool> inquiry: root.phase == 3 || status == "waiting_input" || status == "waiting_user_input"
        || status.starts-with("等待用户输入") || status.starts-with("等待回答");
    private property <bool> approval: status == "waiting_approval"
        || status.starts-with("等待确认") || status.starts-with("等待审批");
    private property <string> state: RuntimeStatus.state-of(root.phase, root.status);
    private property <color> tint: root.inquiry ? Theme.accent-ink : root.approval || root.state == "pending" ? Theme.warning
        : root.state == "error" ? Theme.danger : root.state == "done" ? Theme.success
        : root.state == "running" ? Theme.accent-ink : Theme.muted;
    if root.state != "running" : Image {
        width: 10px; height: 10px; image-fit: contain; colorize: root.tint;
        source: root.inquiry ? @image-url("../assets/icons/fa-circle-question.svg")
            : root.approval ? @image-url("../assets/icons/shield.svg")
            : root.state == "pending" ? @image-url("../assets/icons/status-clock.svg")
            : root.state == "done" ? @image-url("../assets/icons/status-check.svg")
            : root.state == "error" ? @image-url("../assets/icons/status-error.svg")
            : @image-url("../assets/icons/status-pause.svg");
    }
    if root.state == "running" : spinner := Rectangle {
        width: 10px; height: 10px;
        private property <angle> phase: mod(animation-tick(), 1200ms) / 1200ms * 360deg;
        for offset in [{x: 0, y: -3.8}, {x: 3.3, y: -1.9}, {x: 3.3, y: 1.9}, {x: 0, y: 3.8}, {x: -3.3, y: 1.9}, {x: -3.3, y: -1.9}] : Rectangle {
            x: 3.9px + (offset.x * cos(spinner.phase) - offset.y * sin(spinner.phase)) * 1px;
            y: 3.9px + (offset.x * sin(spinner.phase) + offset.y * cos(spinner.phase)) * 1px;
            width: 2.2px; height: 2.2px; border-radius: 1.1px; background: root.tint;
        }
    }
    Tooltip { text: root.inquiry ? @markdown("等待回答") : root.approval ? @markdown("等待确认")
        : root.state == "pending" ? @markdown("排队中") : root.state == "done" ? @markdown("已完成")
        : root.state == "error" ? @markdown("错误") : root.state == "running" ? @markdown("运行中") : @markdown("空闲"); }
}

// The row owns the standard context menu. Child TouchAreas explicitly forward
// right presses because they otherwise consume the event before it reaches
// their ContextMenuArea ancestor.
component ThreadRow inherits ContextMenuArea {
    in property <SidebarRow> data;
    in property <bool> hover;
    in property <bool> selecting;
    callback archive();
    callback begin-rename();
    callback open-trajectory();
    callback begin-selection();
    callback toggle-selection();
    in property <bool> allow-selection: true;
    height: 28px;
    enabled: !root.selecting;
    Menu {
        MenuItem { title: I18n.common_rename; activated => { root.begin-rename(); } }
        MenuItem { title: I18n.sb_thread_trajectory; activated => { root.open-trajectory(); } }
        MenuItem { title: I18n.sb_thread_archive; enabled: data.archivable; activated => { root.archive(); } }
        MenuSeparator {}
        MenuItem { title: I18n.sb_thread_multi_select; enabled: root.allow-selection; activated => { root.begin-selection(); } }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: data.active ? Theme.selected : transparent;
    }

    // Tree connector line linking the thread to its workspace row: 掉在工作区
    // 图标中心（行内距 + 半个图标底）上，与工作区行的图标列同一条竖线。
    Rectangle {
        x: SidebarMetrics.row-padding + SidebarMetrics.icon-tile / 2;
        y: 0px; width: 1px; height: parent.height; background: Theme.border;
    }
    HorizontalLayout {
        // 只缩进一格：状态点落在 28px（28-12=16 行内坐标），标题接上工作区标题列；
        // 多选时让开 15px 勾选框。
        padding-left: root.selecting
            ? SidebarMetrics.row-padding + 15px + SidebarMetrics.icon-gap
            : SidebarMetrics.thread-indent - SidebarMetrics.gutter;
        padding-right: SidebarMetrics.row-padding;
        spacing: SidebarMetrics.icon-gap;
        StatusDot {
            y: (parent.height - self.height) / 2;
            status: data.status;
            phase: data.phase;
        }
        Text {
            vertical-alignment: center;
            text: data.title;
            color: data.active ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-md;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Remote-origin badge (§I9): threads created in the cloud or by another
        // device carry a small chip so local rows stay unmarked. Uses the same
        // accent-soft pill recipe as the cloud-quota badge. It yields to the
        // hover actions.
        if !root.hover && data.origin != "" : Rectangle {
            height: 16px;
            width: min(origin-chip-text.preferred-width + 12px, 72px);
            border-radius: 8px;
            background: Theme.accent-soft;
            origin-chip-text := Text {
                x: 6px; width: parent.width - 12px; height: parent.height;
                text: data.origin == "cloud" ? I18n.sb_origin_cloud : I18n.sb_origin_device;
                color: Theme.accent-ink;
                font-size: Theme.font-2xs; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
        }
    }
    // Multi-select check square, aligned with the web's `.mz-thread-check`:
    // 15px, accent-filled with a white check once ticked, greyed for rows the
    // archive gate rejects. The whole row toggles (the touch below), so the
    // square itself carries no input handling.
    if root.selecting : Rectangle {
        x: 8px;
        y: (parent.height - 15px) / 2;
        width: 15px; height: 15px;
        border-radius: 4px;
        border-width: data.checked ? 0px : 1px;
        border-color: Theme.border-strong;
        background: data.checked ? Theme.accent : transparent;
        opacity: data.archivable ? 1.0 : 0.4;
        if data.checked : Image {
            x: (parent.width - 9px) / 2; y: (parent.height - 9px) / 2;
            width: 9px; height: 9px;
            source: @image-url("../assets/icons/check.svg");
            colorize: white;
        }
    }
    // While selecting, the whole row is the toggle and dragging is disabled by
    // the DragRow wrapper, so this touch is the only click path.
    if root.selecting : TouchArea {
        mouse-cursor: pointer;
        clicked => { if data.archivable { root.toggle-selection(); } }
    }
    // The hover actions ride over the row's right edge instead of joining its
    // layout. Keep the band at a fixed width so the title never jumps when
    // the pointer enters or leaves a row. This mirrors the web order:
    // rename, trajectory view, archive.
    if root.hover && !root.selecting : Rectangle {
        // 动作条与行右内边距对齐：3×20px 按钮 + 4px 间隔 + 两侧 8px。
        x: parent.width - 84px;
        y: 0px;
        width: 84px;
        height: parent.height;
        background: data.active ? Theme.selected : Theme.accent-soft;
        Rectangle {
            x: 8px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: SidebarMetrics.row-radius;
            background: rename-touch.has-hover ? Theme.selected : transparent;
            Image { x: (parent.width - SidebarMetrics.icon-glyph) / 2; y: (parent.height - SidebarMetrics.icon-glyph) / 2; width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph; source: @image-url("../assets/icons/fa-pen-to-square.svg"); colorize: Theme.muted; }
            rename-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button; accessible-label: I18n.common_rename;
                Tooltip { text: @markdown("\{I18n.common_rename}"); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                            y: self.absolute-position.y - root.absolute-position.y + self.mouse-y });
                    }
                }
                clicked => { root.begin-rename(); }
            }
        }
        Rectangle {
            x: 32px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: SidebarMetrics.row-radius;
            background: trajectory-touch.has-hover ? Theme.selected : transparent;
            Image {
                x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                source: @image-url("../assets/icons/fa-route.svg");
                colorize: Theme.muted;
            }
            trajectory-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button; accessible-label: I18n.sb_thread_trajectory;
                Tooltip { text: @markdown("\{I18n.sb_thread_trajectory}"); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                            y: self.absolute-position.y - root.absolute-position.y + self.mouse-y });
                    }
                }
                clicked => { root.open-trajectory(); }
            }
        }
        Rectangle {
            x: 56px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: SidebarMetrics.row-radius;
            background: archive-touch.has-hover && data.archivable ? Theme.selected : transparent;
            Image {
                x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                source: @image-url("../assets/icons/box-archive.svg");
                colorize: data.archivable ? Theme.muted : Theme.border-strong;
            }
            archive-touch := TouchArea {
                mouse-cursor: data.archivable ? pointer : default;
                enabled: data.archivable;
                accessible-role: button; accessible-label: I18n.sb_thread_archive;
                Tooltip { text: @markdown("\{I18n.sb_thread_archive}"); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                        root.show({ x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                            y: self.absolute-position.y - root.absolute-position.y + self.mouse-y });
                    }
                }
                clicked => { root.archive(); }
            }
        }
    }
}

// Workspace header chip, shared by the tree delegate and the sticky replica
// so a pinned header is pixel-identical to its row and keeps the same
// actions. kind 0 is a local workspace, kind 2 the pinned cloud row; both
// are drag-reorderable through the DragRow base.
component GroupHeaderRow inherits DragRow {
    in property <SidebarRow> data;
    // Action code: 0 new thread, 1 edit, 3 delete. The cloud row only
    // carries the new-thread entry (0); its site reroutes it.
    callback menu(int);

    label: data.name;
    row-kind: data.kind;
    workspace-id: data.kind == 2 ? "cloud" : data.workspace-id;
    selected: data.selected;
    selected-color: Theme.selected;
    tooltip: data.kind == 2
        ? (data.expanded ? I18n.ws_collapse_threads : I18n.ws_expand_threads)
        : (data.path != "" ? data.path : data.expanded ? I18n.ws_collapse_threads : I18n.ws_expand_threads);
    actions-width: data.kind == 2 ? 40px : 84px;

    // Selection indicator on the workspace row.
    Rectangle { x: 2px; y: (parent.height - 16px) / 2; width: 2px; height: 16px; border-radius: 1px; background: data.selected ? Theme.accent : transparent; }
    HorizontalLayout {
        padding-left: SidebarMetrics.row-padding;
        // 「+」常驻在动作条最右一列，计数与标题在这里让开它。
        padding-right: 32px;
        spacing: SidebarMetrics.icon-gap;
        Rectangle {
            y: (parent.height - SidebarMetrics.icon-tile) / 2;
            width: SidebarMetrics.icon-tile; height: SidebarMetrics.icon-tile;
            border-radius: Theme.radius-tag;
            // No separate chevron: the glyph itself is the fold switch.
            // Expanded = solid workspace colour, the threads below are open;
            // collapsed = hollow (muted) glyph. The cloud row keeps the
            // accent tint instead of a workspace colour.
            background: data.kind == 2
                ? (data.expanded ? Theme.accent.transparentize(0.87) : Theme.hover)
                : (data.expanded ? WorkspaceVisual.color(data.color).transparentize(0.87) : Theme.hover);
            Image {
                x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                source: data.kind == 2 ? WorkspaceVisual.icon("cloud") : WorkspaceVisual.icon(data.icon);
                image-fit: contain;
                colorize: data.kind == 2
                    ? (data.expanded ? Theme.accent-ink : Theme.muted)
                    : (data.expanded ? WorkspaceVisual.color(data.color) : Theme.muted);
            }
        }
        Text {
            height: parent.height; text: data.name;
            color: Theme.text; font-size: Theme.font-md;
            vertical-alignment: center; overflow: elide;
            horizontal-stretch: 1;
        }
        if data.kind == 0 : Text {
            // Thread count yields to the hover actions.
            visible: !root.hover && data.thread-count > 0;
            height: parent.height; text: "\{data.thread-count}";
            color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center;
        }
    }
    if data.kind == 0 : Rectangle {
        // Direct actions replace the old ellipsis menu: plus spawns a thread
        // in this workspace, pen opens the edit dialog (icon, color, folder,
        // reveal), trash deletes the workspace after its own confirm step.
        // They ride over the row instead of joining its layout, so revealing
        // them moves nothing and they sit on the name's own centre line.
        x: parent.width - 84px;
        y: 0px;
        width: 84px;
        height: parent.height;
        background: root.hover ? (data.selected ? Theme.selected : Theme.accent-soft) : transparent;
        Rectangle {
            x: 56px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
            Image {
                x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                source: @image-url("../assets/icons/fa-plus.svg");
                colorize: ws-thread-touch.has-hover ? Theme.accent-ink : Theme.muted;
            }
            ws-thread-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button; accessible-label: I18n.ws_menu_new_thread;
                Tooltip { text: @markdown("\{I18n.ws_menu_new_thread}"); }
                clicked => { root.menu(0); }
            }
        }
        if root.hover : Rectangle {
            x: 32px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: SidebarMetrics.row-radius;
            background: ws-edit-touch.has-hover ? Theme.selected : transparent;
            // fa-pen-to-square, the glyph the web uses for rename/edit; the
            // bare pen read as a different action next to it.
            Image { x: (parent.width - SidebarMetrics.icon-glyph) / 2; y: (parent.height - SidebarMetrics.icon-glyph) / 2; width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph; source: @image-url("../assets/icons/fa-pen-to-square.svg"); colorize: Theme.muted; }
            ws-edit-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button; accessible-label: I18n.ws_menu_edit;
                Tooltip { text: @markdown("\{I18n.ws_menu_edit}"); }
                clicked => { root.menu(1); }
            }
        }
        if root.hover : Rectangle {
            x: 8px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: SidebarMetrics.row-radius;
            background: ws-delete-touch.has-hover ? Theme.selected : transparent;
            Image { x: (parent.width - SidebarMetrics.icon-glyph) / 2; y: (parent.height - SidebarMetrics.icon-glyph) / 2; width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph; source: @image-url("../assets/icons/trash.svg"); colorize: ws-delete-touch.has-hover ? Theme.danger : Theme.muted; }
            ws-delete-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button; accessible-label: I18n.ws_menu_delete;
                Tooltip { text: @markdown("\{I18n.ws_menu_delete}"); }
                clicked => { root.menu(3); }
            }
        }
    }
    if data.kind == 2 : Rectangle {
        // Pinned cloud workspace header: only the visible new-thread
        // affordance, matching the cloud row on the web.
        x: parent.width - 28px; y: (parent.height - 20px) / 2;
        width: 20px; height: 20px;
        Image {
            x: (parent.width - SidebarMetrics.icon-glyph) / 2;
            y: (parent.height - SidebarMetrics.icon-glyph) / 2;
            width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
            source: @image-url("../assets/icons/fa-plus.svg");
            colorize: cloud-new-touch.has-hover ? Theme.accent-ink : Theme.muted;
        }
        cloud-new-touch := TouchArea {
            mouse-cursor: pointer;
            enabled: root.enabled;
            accessible-role: button; accessible-label: I18n.ws_menu_new_thread;
            Tooltip { text: @markdown("\{I18n.ws_menu_new_thread}"); }
            clicked => { root.menu(0); }
        }
    }
}

export component Sidebar inherits Rectangle {
    min-height: 0px;
    preferred-height: 600px;
    background: Theme.sidebar;

    in property <[SidebarRow]> rows;
    in property <string> active-thread-id;
    // Signed-in identity shown on the settings button, projected from the
    // shell's `ProfileCard`: the mark the native side derived for the account
    // (the name's first character) and the profile colour, which the native
    // side converts from the `#rrggbb` preference because Slint has no
    // string→color cast.
    in property <string> user-initial;
    in property <color> user-color;
    in property <bool> busy;
    // Device selector: this 蛹 is the local device; the signed-in account is
    // the cloud device. Only the selected device's workspace tree is shown.
    in property <bool> cloud-available: false;
    in property <int> local-workspace-count: 0;
    private property <bool> device-menu-open: false;
    changed cloud-available => { if !self.cloud-available { self.device-menu-open = false; } }
    // Cloud quota badge (§6.1): plain balance text projected natively; an
    // empty string hides the pill, `warn` switches it to the danger tint,
    // `expired` replaces the number with an expired warning and
    // `reconnecting` keeps the number but fades the pill out.
    in property <string> cloud-quota-text;
    in property <bool> cloud-quota-warn: false;
    in property <bool> cloud-quota-expired: false;
    in property <bool> cloud-quota-reconnecting: false;

    callback select-row(int);
    callback select-device(int);
    callback new-cloud-thread();
    callback workspace-menu(int, int);
    callback new-workspace();
    callback move-row(int, int);
    callback archive-thread(string);
    // Multi-select (web alignment): the tree enters selection mode from a
    // context menu, clicks toggle rows, the bar at the tree's foot
    // selects all / closes / archives. The native side owns the checked set,
    // these just report intent.
    in property <bool> selection-mode;
    in property <int> selected-count: 0;
    in property <int> archivable-count: 0;
    callback begin-selection();
    callback exit-selection();
    callback toggle-selection(int);
    callback select-all-threads();
    callback archive-selected();
    // Ask the shell to open the rename prompt for a thread (payload, current
    // title); the shell commits through its own `rename-thread`.
    callback rename-request(int, string);
    callback open-trajectory(int);
    callback cloud-rename-request(string, string);
    callback cloud-archive-request(string);
    callback cloud-open-trajectory(string);
    callback open-settings();

    // Working-directory region (left rail's lower half): the cloud workspace
    // file tree below a draggable splitter, as on the web. Stretch weights
    // apply a persisted ratio without feeding layout results back into its
    // preferred size; the clamp keeps both regions available.
    in property <[WorkspaceFileRow]> file-rows;
    in property <bool> file-loading;
    in property <string> file-error;
    in property <bool> file-offline;
    in property <bool> file-busy;
    // Which folder the working-directory region browses: false = the cloud
    // workspace, true = a local workspace folder (no cloud-only actions).
    in property <bool> file-local;
    // The effective device follows the directory target; a signed-out cloud
    // target cannot be a workspace host, so the tree falls back to local.
    private property <bool> cloud-active: root.cloud-available && !root.file-local;
    in property <string> file-active-path;
    in property <int> file-active-index: -1;
    callback file-key(int);
    in-out property <float> split-ratio: 0.6;
    callback layout-changed();
    private property <length> split-track: max(1px, root.height - 89px - (root.selection-mode ? 70px : 0px));
    callback file-toggle(int);
    callback file-refresh();
    callback file-connect();
    // Head toolbar of the working-directory region: upload, search (the head
    // swaps to the field while open), download, multi-select and refresh.
    // The query and the two mode flags round-trip so the controller can
    // close a search or a selection when the target switches.
    callback file-upload();
    in-out property <bool> file-search-open;
    in-out property <string> file-search-query;
    in property <bool> file-search-busy;
    in property <bool> file-search-active;
    callback file-search-edit(string);
    callback file-search-accept(string);
    callback file-search-cancel();
    callback file-download();
    in-out property <bool> file-selecting;
    in property <int> file-selected-count: 0;
    callback file-select();
    callback file-selection-action(int);
    callback file-check(int);
    // Right-click menu action (row index, action code), drag-out on a row,
    // and the OS drop upload. The shell owns the handlers; the region and
    // the shell share the DropEvent type.
    callback file-menu(int, int);
    callback file-drag(int);
    callback file-drop(DropEvent);

    VerticalLayout {
        spacing: 0px;
        // 顶部气口 8 + 设备行 32 = 40px 头部块；split-track 的固定 chrome
        // 记账（height - 89px）跟着这两个数字走。
        Rectangle { height: 8px; }
        HorizontalLayout {
            height: 32px;
            padding-left: SidebarMetrics.gutter; padding-right: SidebarMetrics.gutter;
            spacing: 4px;
            // Device selector: the current device owns every workspace row
            // below. It is a control, not a tree entry: a bordered surface
            // chip against the panel grey, while the workspace/thread rows
            // stay borderless with grey hover fills — the different anatomy
            // keeps the two levels from reading as siblings. Hover only
            // deepens the stroke, never fills the chip like a row would.
            Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                border-radius: SidebarMetrics.row-radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: (device-toggle.has-hover || root.device-menu-open) && root.cloud-available
                    ? Theme.border-strong : Theme.border;
                HorizontalLayout {
                    padding-left: SidebarMetrics.row-padding;
                    padding-right: SidebarMetrics.row-padding;
                    spacing: SidebarMetrics.icon-gap;
                    Rectangle {
                        y: (parent.height - SidebarMetrics.icon-tile) / 2;
                        width: SidebarMetrics.icon-tile; height: SidebarMetrics.icon-tile;
                        border-radius: Theme.radius-tag;
                        Image {
                            x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                            y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                            width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                            source: WorkspaceVisual.icon(root.cloud-active ? "cloud" : "monitor");
                            colorize: root.cloud-active ? Theme.accent-ink : Theme.muted;
                        }
                    }
                    Text {
                        height: parent.height;
                        text: root.cloud-active ? I18n.sb_device_cloud : I18n.sb_device_local;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        height: parent.height;
                        text: root.cloud-active ? I18n.sb_device_cloud_host : I18n.sb_device_local_host;
                        color: Theme.muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cloud-available : Image {
                        y: (parent.height - 12px) / 2;
                        width: 12px; height: 12px;
                        source: root.device-menu-open ? @image-url("../assets/icons/chevron-up.svg") : @image-url("../assets/icons/chevron-down.svg");
                        colorize: Theme.muted;
                    }
                }
                device-toggle := TouchArea {
                    mouse-cursor: root.cloud-available ? pointer : default;
                    enabled: root.cloud-available;
                    accessible-role: button; accessible-label: I18n.sb_device_select;
                    Tooltip { text: @markdown("\{I18n.sb_device_select}"); }
                    clicked => { root.device-menu-open = !root.device-menu-open; }
                }
            }
            // Creates a workspace bound to a local directory. 24px 触面与行同高
            // 居中，字形跟行内图标同号，右缘与行尾对齐在同一条留白上。
            Rectangle {
                width: 24px; height: 32px;
                // The glyph stays the FA plus the cloud client uses; a text
                // "+" was a different weight and optical size beside it.
                Image {
                    x: (parent.width - SidebarMetrics.icon-glyph) / 2;
                    y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                    width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                    source: @image-url("../assets/icons/fa-plus.svg");
                    colorize: ws-add-touch.has-hover ? Theme.accent-ink : Theme.muted;
                }
                ws-add-touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: !root.busy;
                    accessible-role: button; accessible-label: I18n.ws_dlg_new;
                    Tooltip { text: @markdown("\{I18n.ws_dlg_new}"); }
                    clicked => { root.device-menu-open = false; root.new-workspace(); }
                }
            }
        }
        if root.rows.length == 0 && !root.cloud-active : Text {
            height: 48px;
            text: I18n.sb_device_empty;
            color: Theme.muted;
            font-size: Theme.font-sm;
            horizontal-alignment: center; vertical-alignment: center;
            wrap: word-wrap;
        }
        // Workspace/thread tree. Rows drag-reorder among neighbours of the
        // same kind via `move-row`, which reports pointer travel in pixels;
        // the row pitch comes from SidebarMetrics so the native resolver and
        // this layout cannot disagree.
        tree-frame := Rectangle {
            min-height: 0px; preferred-height: 0px;
            vertical-stretch: clamp(root.split-ratio, 0.3, 0.8);
            // The sticky header replica below is a sibling of the tree and
            // slides out above its top edge when the next group arrives; the
            // frame must clip it so it never paints over the device row.
            clip: true;
            tree := ListView {
                horizontal-scrollbar-policy: always-off;
                for row[ri] in root.rows : Rectangle {
                    height: row.kind == 1 || row.kind == 3 ? SidebarMetrics.thread-height : SidebarMetrics.group-height;
                    width: parent.width;
                    if row.kind == 0 : GroupHeaderRow {
                        // 分组行让出 4px 顶部气口：组间比组内松，chip 仍与线程行同高。
                        x: SidebarMetrics.gutter;
                        y: SidebarMetrics.group-air;
                        width: parent.width - SidebarMetrics.gutter * 2;
                        height: parent.height - SidebarMetrics.group-air;
                        enabled: !root.busy;
                        row-index: ri;
                        data: row;
                        activate => { root.select-row(ri); }
                        move-by(travel) => { root.move-row(ri, travel); }
                        menu(code) => { root.workspace-menu(row.payload, code); }
                    }
                    if row.kind == 1 : DragRow {
                        x: SidebarMetrics.gutter;
                        width: parent.width - SidebarMetrics.gutter * 2;
                        height: parent.height;
                        border-radius: SidebarMetrics.row-radius;
                        // Selection mode freezes reordering, as on the web.
                        enabled: !root.busy && !root.selection-mode;
                        selected: row.active;
                        selected-color: Theme.selected;
                        label: row.title;
                        // 悬停提示带最后完成时间：标题可能被省略号截断，日期是
                        // 找回一条久远线程的第二个线索。
                        tooltip: row.hint == ""
                            ? row.title
                            : row.title + " · " + I18n.sb_last_finished + " " + row.hint;
                        row-index: ri;
                        row-kind: row.kind;
                        workspace-id: row.workspace-id;
                        actions-width: 84px;
                        activate => { root.select-row(ri); }
                        move-by(travel) => { root.move-row(ri, travel); }
                        ThreadRow {
                            height: parent.height;
                            width: parent.width;
                            data: row;
                            hover: parent.hover;
                            selecting: root.selection-mode;
                            archive => { root.archive-thread(row.thread-id); }
                            // Renaming needs a draft the user can still abandon, so
                            // the pen asks the shell for the prompt dialog instead
                            // of editing in place.
                            begin-rename => { root.rename-request(row.payload, row.title); }
                            open-trajectory => { root.open-trajectory(row.payload); }
                            begin-selection => { root.begin-selection(); }
                            toggle-selection => { root.toggle-selection(row.payload); }
                        }
                    }
                    if row.kind == 3 : Rectangle {
                        x: SidebarMetrics.gutter;
                        width: parent.width - SidebarMetrics.gutter * 2;
                        height: parent.height;
                        border-radius: SidebarMetrics.row-radius;
                        background: row.active ? Theme.selected : cloud-thread-touch.has-hover ? Theme.hover : transparent;
                        cloud-thread-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button; accessible-label: row.title;
                            if !(cloud-thread-touch.mouse-x >= cloud-thread-touch.width - 84px) : Tooltip { text: @markdown("\{row.title}"); }
                            clicked => { root.select-row(ri); }
                            ThreadRow {
                                width: parent.width; height: parent.height;
                                data: row;
                                hover: cloud-thread-touch.has-hover;
                                selecting: false;
                                allow-selection: false;
                                archive => { root.cloud-archive-request(row.thread-id); }
                                begin-rename => { root.cloud-rename-request(row.thread-id, row.title); }
                                open-trajectory => { root.cloud-open-trajectory(row.thread-id); }
                            }
                        }
                    }
                    // Pinned cloud workspace header. It uses the same visible
                    // new-thread affordance as local workspace rows; the
                    // native projection expands its bounded cloud thread rows
                    // directly beneath it.
                    if row.kind == 2 : GroupHeaderRow {
                        x: SidebarMetrics.gutter;
                        y: SidebarMetrics.group-air;
                        width: parent.width - SidebarMetrics.gutter * 2;
                        height: parent.height - SidebarMetrics.group-air;
                        enabled: !root.busy;
                        row-index: ri;
                        data: row;
                        activate => { root.select-row(ri); }
                        move-by(travel) => { root.move-row(ri, travel); }
                        menu(code) => { if code == 0 { root.new-cloud-thread(); } }
                    }
                }
            }
            // Flickable handles input on its unused viewport too. Cover only the
            // gap after the virtual rows, preserving row drag and context menus.
            ContextMenuArea {
                enabled: !root.selection-mode;
                y: min(parent.height, max(0px, tree.content-height + tree.content-y));
                height: parent.height - self.y;
                Menu {
                    MenuItem { title: I18n.sb_thread_multi_select; enabled: root.rows.length > 0; activated => { root.begin-selection(); } }
                }
            }
            // Sticky workspace header: while the expanded group's threads
            // scroll, its header chip stays pinned to the tree's top edge —
            // only the threads move, the entry the user expanded never rolls
            // out of sight. The replica is the real header row component, so
            // click, hover actions and drag-reorder keep working in place. It
            // pins once the natural header scrolls past the top and is pushed
            // out in lockstep with the next group's header arriving; the
            // geometry rides on the group span the projection stamps onto the
            // row, so the pitch here and in the row list cannot disagree.
            for row[ri] in root.rows : Rectangle {
                // for/if 实例在普通 Rectangle 里默认居中而不是 (0,0)，必须显式
                // 钉在原点，否则吸顶层会悬在树的中央。
                x: 0; y: 0;
                width: 0px; height: 0px;
                if (row.kind == 0 || row.kind == 2) && row.expanded : pin-frame := Rectangle {
                    x: 0px;
                    y: min(0px, row.group-end * 1px + tree.content-y
                        - (SidebarMetrics.group-height - SidebarMetrics.group-air));
                    // The wrapper is a 0×0 positioning cell; the frame sizes
                    // against the tree itself, not against that cell.
                    width: tree-frame.width;
                    height: SidebarMetrics.group-height;
                    visible: row.group-top * 1px + tree.content-y < 0px
                        && row.group-end * 1px + tree.content-y > -SidebarMetrics.group-air;
                    background: Theme.sidebar;
                    GroupHeaderRow {
                        x: SidebarMetrics.gutter;
                        y: SidebarMetrics.group-air;
                        width: parent.width - SidebarMetrics.gutter * 2;
                        height: parent.height - SidebarMetrics.group-air;
                        enabled: !root.busy;
                        row-index: ri;
                        data: row;
                        activate => { root.select-row(ri); }
                        move-by(travel) => { root.move-row(ri, travel); }
                        menu(code) => {
                            if row.kind == 0 { root.workspace-menu(row.payload, code); }
                            else { root.new-cloud-thread(); }
                        }
                    }
                }
            }
        }
        // Multi-select bar (web alignment): normal flow at the tree's foot,
        // right above the working-directory region, so the tree keeps its own
        // scrolling and the bar never floats over rows. Select-all only
        // reaches rows the archive gate allows; partial selection shows the
        // minus state.
        if root.selection-mode : Rectangle {
            height: 70px;
            private property <bool> all-selected: root.archivable-count > 0 && root.selected-count >= root.archivable-count;
            private property <bool> partial-selected: root.selected-count > 0 && root.selected-count < root.archivable-count;
            VerticalLayout {
                padding-left: SidebarMetrics.gutter; padding-right: SidebarMetrics.gutter;
                padding-top: 4px; padding-bottom: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    // Select-all cluster: check square (check / minus) plus a
                    // label, one touch across both. The layout stretches the
                    // cluster — a `height: parent.height` here would loop the
                    // bar's preferred-size computation.
                    Rectangle {
                        HorizontalLayout {
                            padding-left: 2px;
                            spacing: 8px;
                            Rectangle {
                                width: 15px;
                                Rectangle {
                                    y: (parent.height - 15px) / 2;
                                    width: 15px; height: 15px;
                                    border-radius: 4px;
                                    border-width: all-selected ? 0px : 1px;
                                    border-color: Theme.border-strong;
                                    background: all-selected ? Theme.accent : transparent;
                                    if all-selected : Image {
                                        x: (parent.width - 9px) / 2; y: (parent.height - 9px) / 2;
                                        width: 9px; height: 9px;
                                        source: @image-url("../assets/icons/check.svg");
                                        colorize: white;
                                    }
                                    if partial-selected : Rectangle {
                                        x: (parent.width - 7px) / 2; y: (parent.height - 2px) / 2;
                                        width: 7px; height: 2px; border-radius: 1px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                            Text {
                                text: I18n.sb_thread_select_all;
                                color: Theme.text; font-size: Theme.font-sm;
                                vertical-alignment: center;
                            }
                        }
                        all-touch := TouchArea {
                            mouse-cursor: pointer;
                            Tooltip { text: @markdown("\{I18n.sb_thread_select_all}"); }
                            clicked => { root.select-all-threads(); }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    Text {
                        text: I18n.sb_thread_selected(root.selected-count);
                        color: Theme.muted; font-size: Theme.font-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 20px;
                        Rectangle {
                            y: (parent.height - 20px) / 2;
                            width: 20px; height: 20px; border-radius: 4px;
                            background: bar-close.has-hover ? Theme.selected : transparent;
                            Image { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("../assets/icons/xmark.svg"); colorize: Theme.muted; }
                            bar-close := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button; accessible-label: I18n.common_close;
                                Tooltip { text: @markdown("\{I18n.common_close}"); }
                                clicked => { root.exit-selection(); }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 28px;
                    border-radius: SidebarMetrics.row-radius;
                    background: root.selected-count > 0 ? Theme.accent : Theme.hover;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Rectangle {
                            width: 14px;
                            Image {
                                y: (parent.height - 14px) / 2;
                                width: 14px; height: 14px;
                                source: @image-url("../assets/icons/box-archive.svg");
                                colorize: root.selected-count > 0 ? white : Theme.muted;
                            }
                        }
                        Text {
                            text: I18n.sb_thread_archive;
                            color: root.selected-count > 0 ? white : Theme.muted;
                            font-size: Theme.font-sm; font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    bar-archive := TouchArea {
                        mouse-cursor: root.selected-count > 0 ? pointer : default;
                        enabled: root.selected-count > 0;
                        accessible-role: button; accessible-label: I18n.sb_thread_archive;
                        Tooltip { text: @markdown("\{I18n.sb_thread_archive}"); }
                        clicked => { root.archive-selected(); }
                    }
                }
            }
        }
        // Draggable splitter between the thread tree and the working-directory
        // region, as on the web: dragging up grows the files region. The
        // delta never reads the sidebar height, so the window's vertical
        // layout stays acyclic.
        Rectangle {
            height: 8px;
            Rectangle {
                y: 3px; width: parent.width; height: 1px;
                background: splitter-touch.has-hover || splitter-touch.pressed ? Theme.border-strong : Theme.border;
            }
            forward-focus: splitter-focus;
            splitter-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        root.split-ratio = clamp(root.split-ratio + (event.text == Key.UpArrow ? -24px : 24px) / root.split-track, 0.3, 0.8);
                        root.layout-changed(); return accept;
                    }
                    if event.text == Key.Home { root.split-ratio = 0.6; root.layout-changed(); return accept; }
                    return reject;
                }
            }
            splitter-touch := TouchArea {
                mouse-cursor: ns-resize;
                Tooltip { text: @markdown("调整工作线程区与工作目录区的高度"); }
                property <length> drag-y: 0px;
                property <float> start-ratio;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        drag-y = self.absolute-position.y + self.mouse-y;
                        start-ratio = root.split-ratio;
                        splitter-focus.focus();
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.layout-changed(); }
                }
                moved => {
                    if self.pressed {
                        root.split-ratio = clamp(start-ratio + (self.absolute-position.y + self.mouse-y - drag-y) / root.split-track, 0.3, 0.8);
                    }
                }
                double-clicked => { root.split-ratio = 0.6; root.layout-changed(); }
            }
        }
        // Working-directory region: the cloud workspace tree. Actions flow
        // through to the window shell like every other sidebar callback.
        WorkspaceFilesPanel {
            min-height: 0px; preferred-height: 0px;
            vertical-stretch: 1 - clamp(root.split-ratio, 0.3, 0.8);
            rows: root.file-rows;
            loading: root.file-loading;
            error: root.file-error;
            offline: root.file-offline;
            busy: root.file-busy;
            local: root.file-local;
            active-path: root.file-active-path;
            active-index: root.file-active-index;
            key-action(action) => { root.file-key(action); }
            toggle(index) => { root.file-toggle(index); }
            check(index) => { root.file-check(index); }
            refresh => { root.file-refresh(); }
            connect => { root.file-connect(); }
            menu(index, action) => { root.file-menu(index, action); }
            drag-row(index) => { root.file-drag(index); }
            drop(event) => { root.file-drop(event); }
            upload => { root.file-upload(); }
            download => { root.file-download(); }
            select => { root.file-select(); }
            selection-action(action) => { root.file-selection-action(action); }
            search-edit(text) => { root.file-search-edit(text); }
            search-accept(text) => { root.file-search-accept(text); }
            search-cancel => { root.file-search-cancel(); }
            search-open <=> root.file-search-open;
            search-query <=> root.file-search-query;
            search-busy: root.file-search-busy;
            search-active: root.file-search-active;
            selecting <=> root.file-selecting;
            selected-count: root.file-selected-count;
        }
        Rectangle { height: 1px; background: Theme.border; }
        // Settings button: 4px 上气口 + 32px 行 + 4px 下气口，与树里的行同高同留白。
        Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: SidebarMetrics.gutter; padding-right: SidebarMetrics.gutter;
                padding-top: 4px; padding-bottom: 4px;
                Rectangle {
                    height: 32px; border-radius: SidebarMetrics.row-radius;
                    background: settings-touch.has-hover ? Theme.hover : transparent;
                    settings-touch := TouchArea {
                        mouse-cursor: pointer;
                        Tooltip { text: @markdown("打开设置"); }
                        clicked => { root.open-settings(); }
                    }
                    HorizontalLayout {
                        padding-left: SidebarMetrics.row-padding;
                        padding-right: SidebarMetrics.row-padding;
                        spacing: SidebarMetrics.icon-gap; alignment: start;
                        // The user's avatar leads the row instead of the bare
                        // gear: the profile colour carries the circle and the
                        // profile glyph sits on it, the same recipe as the
                        // avatar dialog preview (white bold glyph on the
                        // identity colour). The shared "me" label is the
                        // fallback so the button always marks an identity.
                        Rectangle {
                            y: (parent.height - 24px) / 2;
                            width: 24px; height: 24px; border-radius: 12px;
                            background: root.user-color;
                            clip: true;
                            accessible-role: image;
                            accessible-label: I18n.profile_title;
                            Text {
                                width: 100%; height: 100%;
                                text: root.user-initial != "" ? root.user-initial : I18n.common_me;
                                color: white; font-size: 11px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text { height: parent.height; text: I18n.sidebar_settings; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; }
                    }
                    // Cloud quota pill (§6.1): the plain balance number next
                    // to the profile row, red at or below 10% of the daily
                    // grant; hidden while signed out.
                    if root.cloud-quota-text != "" : Rectangle {
                        x: parent.width - SidebarMetrics.row-padding - 60px;
                        y: (parent.height - 20px) / 2;
                        width: 60px; height: 20px;
                        border-radius: Theme.radius-md;
                        // Reconnecting keeps the balance readable but visibly
                        // degraded; expired flips the pill to the danger tint.
                        opacity: root.cloud-quota-reconnecting ? 0.45 : 1.0;
                        background: root.cloud-quota-expired || root.cloud-quota-warn ? Theme.danger-bg : Theme.accent-soft;
                        Text {
                            width: 100%; height: 100%;
                            text: root.cloud-quota-expired ? I18n.st_cl_quota_expired : root.cloud-quota-text;
                            color: root.cloud-quota-expired || root.cloud-quota-warn ? Theme.danger : Theme.accent-ink;
                            font-size: Theme.font-xs; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center; overflow: elide;
                        }
                    }
                }
            }
        }
    }
    // Device menu overlay: the outside touch closes it; the two rows switch
    // between this local 蛹 and the signed-in cloud workspace.
    if root.device-menu-open && root.cloud-available : TouchArea {
        y: 40px;
        width: parent.width;
        height: parent.height - 40px;
        z: 140;
        clicked => { root.device-menu-open = false; }
    }
    if root.device-menu-open && root.cloud-available : Rectangle {
        x: SidebarMetrics.gutter;
        y: 42px;
        width: parent.width - SidebarMetrics.gutter * 2;
        height: 72px;
        z: 150;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 10px;
        background: Theme.surface;
        clip: true;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            Rectangle {
                height: 32px;
                border-radius: SidebarMetrics.row-radius;
                background: local-device-option.has-hover && root.local-workspace-count > 0
                    ? Theme.hover : !root.cloud-active ? Theme.selected : transparent;
                HorizontalLayout {
                    padding-left: SidebarMetrics.row-padding; padding-right: SidebarMetrics.row-padding;
                    spacing: SidebarMetrics.icon-gap;
                    Image {
                        y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                        width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                        source: WorkspaceVisual.icon("monitor");
                        colorize: root.local-workspace-count > 0 ? Theme.muted : Theme.border-strong;
                    }
                    Text {
                        height: parent.height;
                        text: I18n.sb_device_local;
                        color: root.local-workspace-count > 0 ? Theme.text : Theme.muted;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        height: parent.height;
                        text: I18n.sb_device_local_host;
                        color: Theme.muted; font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    Text {
                        height: parent.height;
                        horizontal-stretch: 1; horizontal-alignment: right;
                        text: root.local-workspace-count > 0
                            ? I18n.sb_device_workspaces(root.local-workspace-count)
                            : I18n.sb_device_no_workspaces;
                        color: Theme.muted; font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    if !root.cloud-active && root.local-workspace-count > 0 : Image {
                        y: (parent.height - 12px) / 2;
                        width: 12px; height: 12px;
                        source: @image-url("../assets/icons/check.svg");
                        colorize: Theme.accent-ink;
                    }
                }
                local-device-option := TouchArea {
                    mouse-cursor: root.local-workspace-count > 0 ? pointer : default;
                    enabled: root.local-workspace-count > 0;
                    clicked => { root.device-menu-open = false; root.select-device(0); }
                }
            }
            Rectangle {
                height: 32px;
                border-radius: SidebarMetrics.row-radius;
                background: cloud-device-option.has-hover ? Theme.hover : root.cloud-active ? Theme.selected : transparent;
                HorizontalLayout {
                    padding-left: SidebarMetrics.row-padding; padding-right: SidebarMetrics.row-padding;
                    spacing: SidebarMetrics.icon-gap;
                    Image {
                        y: (parent.height - SidebarMetrics.icon-glyph) / 2;
                        width: SidebarMetrics.icon-glyph; height: SidebarMetrics.icon-glyph;
                        source: WorkspaceVisual.icon("cloud");
                        colorize: Theme.accent-ink;
                    }
                    Text {
                        height: parent.height;
                        text: I18n.sb_device_cloud;
                        color: Theme.text; font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        height: parent.height;
                        text: I18n.sb_device_cloud_host;
                        color: Theme.muted; font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cloud-active : Image {
                        y: (parent.height - 12px) / 2;
                        width: 12px; height: 12px;
                        source: @image-url("../assets/icons/check.svg");
                        colorize: Theme.accent-ink;
                    }
                }
                cloud-device-option := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.device-menu-open = false; root.select-device(1); }
                }
            }
        }
    }
    // What the drag follows: the grabbed row keeps its cell (only its seam and
    // box highlight move), and this chip tracks the pointer one for one. Its
    // travel is clamped to the tree's own span so a drag that leaves the list
    // cannot paint over the header or the working-directory region below.
    if DragPreview.active : Rectangle {
        x: SidebarMetrics.gutter;
        y: Math.max(tree.absolute-position.y - root.absolute-position.y, Math.min(
            DragPreview.pointer-y - root.absolute-position.y - 10px,
            tree.absolute-position.y - root.absolute-position.y + tree.height - 22px));
        width: parent.width - SidebarMetrics.gutter * 2;
        height: 24px;
        z: 200;
        border-radius: SidebarMetrics.row-radius;
        border-width: 1px;
        border-color: Theme.accent-ink;
        background: Theme.surface;
        Text {
            x: 8px; width: parent.width - 16px; height: parent.height;
            text: DragPreview.source-label;
            color: Theme.text; font-size: Theme.font-md;
            vertical-alignment: center; overflow: elide;
        }
    }
}
