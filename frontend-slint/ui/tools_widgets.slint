import { Theme, ToolCard } from "theme.slint";
import { ToolIcons } from "tool_icons.slint";
import { I18n } from "i18n.slint";

export component ToolText inherits Text {
    font-size: 12px;
    color: Theme.text;
    overflow: elide;
    vertical-alignment: center;
}

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> show-label: false;
    callback clicked();
    width: root.show-label ? 64px : 32px;
    height: 28px;
    border-radius: 10px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : root.danger ? Theme.danger-bg : root.primary ? Theme.accent-secondary : Theme.border-strong;
    background: touch.has-hover && root.enabled ? Theme.accent-soft : root.danger ? Theme.danger-bg : root.primary ? Theme.accent-soft : Theme.hover;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 5px; alignment: center; cross-axis-alignment: center;
        if root.icon.width > 0 : Image { width: 14px; height: 14px; source: root.icon; colorize: root.danger ? Theme.danger : root.primary ? Theme.accent-deep : Theme.text-secondary; }
        if root.show-label : ToolText { text: root.label; font-weight: 600; color: root.danger ? Theme.danger : root.primary ? Theme.accent-deep : Theme.text-secondary; }
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    // Icon-only buttons carry their meaning in a hover tooltip; labelled
    // buttons already show the text.
    if !root.show-label && root.label != "" : Tooltip { text: @markdown("\{root.label}"); }
}

// 蜂巢 pill tab: 30px 高、8px 圆角，选中时白底加 1px 描边。描边恒定存在，
// 选中只在颜色上区分，避免边框出现/消失推动文字。
export component ToolTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();
    height: 30px;
    // 页签按标签文字取宽，页签条再按页签求和，长中文名不会被挤成省略号。
    width: caption.preferred-width + 24px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Theme.border : transparent;
    background: root.selected ? Theme.surface : touch.has-hover ? Theme.selected : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.selected;
    forward-focus: focus;
    caption := Text {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.label; font-size: Theme.font-md; font-weight: root.selected ? 600 : 400;
        color: root.selected ? Theme.text : Theme.text-secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } reject } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

// 蜂巢 `.mst-toolbar-count`: 999px 药丸，强调色浅底 + 主色数字。
export component ToolCountPill inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: value.width + 16px;
    border-radius: 9px;
    background: Theme.accent-soft;
    value := ToolText {
        x: 8px; height: parent.height; text: root.text;
        font-size: Theme.font-2xs; font-weight: 700; color: Theme.accent-deep;
    }
}

export component ToolGroup inherits Rectangle {
    in property <string> title;
    in property <[ToolCard]> tools;
    callback inspect(string, string);
    background: Theme.surface;
    border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-md;
    VerticalLayout {
        padding: 10px; spacing: 8px; alignment: start;
        HorizontalLayout { height: 18px; spacing: 8px;
            ToolText { text: root.title; font-size: Theme.font-md; font-weight: 700; color: Theme.text; }
            ToolCountPill { text: "\{root.tools.length}"; }
            Rectangle { horizontal-stretch: 1; }
        }
        FlexboxLayout {
            spacing: 8px; alignment: start; cross-axis-alignment: start;
            for tool in root.tools : chip := Rectangle {
                height: 33px;
                border-radius: 17px; border-width: 1px; border-color: Theme.accent-secondary; background: Theme.accent-soft;
                accessible-role: button; accessible-label: tool.name;
                accessible-action-default => { root.inspect(tool.name, tool.description); }
                HorizontalLayout {
                    padding-left: 6px; padding-right: 10px; spacing: 8px; cross-axis-alignment: center;
                    Rectangle {
                        width: 24px; height: 24px; border-radius: 8px;
                        background: ToolIcons.tone-background(tool.tone);
                        border-width: 1px; border-color: ToolIcons.tone-border(tool.tone);
                        Image { x: 6px; y: 6px; width: 12px; height: 12px; source: ToolIcons.image(tool.icon); colorize: ToolIcons.tone-color(tool.tone); }
                    }
                    ToolText { text: tool.name; font-size: 11px; font-weight: 700; color: Theme.accent-deep; max-width: 180px; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.inspect(tool.name, tool.description); } }
            }
        }
        if root.tools.length == 0 : ToolText { height: 32px; text: I18n.tm_none; color: Theme.muted; }
    }
}
