import { ExpertTheme, ExpertButton, ExpertField } from "expert_widgets.slint";
import { TextEditBase } from "textedit-base.slint";
import { LineEdit, ComboBox, ScrollView, ListView } from "std-widgets.slint";
export struct MemoryCard { id: string, title: string, content: string, category: string, source: string, time: string }
export struct ArchiveCard { id: string, title: string, time: string }
export struct RuntimePoint { date: string, value: float, label: string }
export struct HeatCard { name: string, count: string, intensity: float }
export component ExpertData inherits Rectangle {
    in property <int> tab;
    in property <bool> loading;
    in property <string> error;
    in property <[MemoryCard]> memories;
    in property <[ArchiveCard]> archives;
    in property <[RuntimePoint]> points;
    in property <[HeatCard]> heat;
    in property <string> duration: "0s";
    in property <string> tokens: "0";
    in property <string> calls: "0";
    in property <string> chart-path;
    in property <string> chart-max: "0";
    in property <string> selected-date;
    in property <int> archive-page;
    in property <int> archive-total;
    in-out property <string> query;
    in-out property <string> category: "全部标签";
    in property <[string]> categories;
    in-out property <bool> editor-open;
    in-out property <string> edit-id;
    in-out property <string> edit-title;
    in-out property <string> edit-content;
    in-out property <string> edit-category;
    in property <bool> saving;
    in property <[string]> agent-names;
    callback replicate-memory(int);
    private property <bool> replicate-open;
    private property <int> replicate-target: -1;
    callback refresh();
    callback save-memory();
    callback delete-memory(string);
    callback open-memory(int);
    callback archive-turn(int);
    callback open-archive(string);
    callback select-date(string);
    private property <bool> delete-open;
    background: white; border-radius: 12px;
    VerticalLayout { padding: 12px; spacing: 16px;
        if root.error != "" : Text { text: root.error; color: #b63a22; wrap: word-wrap; }
        if root.tab == 2 : HorizontalLayout { height: 36px;
            VerticalLayout { Text { text: "记忆碎片"; color: ExpertTheme.text; font-size: 16px; font-weight: 700; } Text { text: "将可复用的长期事实整理为模型友好的记忆索引与详情。"; color: #8290a6; font-size: 12px; } }
            Rectangle { horizontal-stretch: 1; }
            ExpertButton { width: 52px; label: "刷新"; icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; clicked => { root.refresh(); } }
            ExpertButton { width: 78px; label: "记忆复刻"; icon: @image-url("../assets/icons/copy.svg"); enabled: !root.saving; clicked => { root.replicate-open = true; } }
            ExpertButton { width: 78px; label: "新建碎片"; icon: @image-url("../assets/icons/plus.svg"); selected: true; clicked => { root.open-memory(-1); } }
        }
        if root.tab == 2 : HorizontalLayout { height: 38px; spacing: 12px;
            LineEdit { horizontal-stretch: 7; placeholder-text: "搜索记忆 ID、索引标题或内容详情"; text <=> root.query; accepted => { root.refresh(); } }
            ComboBox { horizontal-stretch: 3; model: root.categories; current-value <=> root.category; selected(value) => { root.refresh(); } }
        }
        if root.tab == 2 : ScrollView { horizontal-scrollbar-policy: always-off;
            VerticalLayout { alignment: start; spacing: 12px;
                for row in Math.ceil(root.memories.length / 4) : HorizontalLayout { alignment: start; spacing: 12px;
                    for col in 4 : Rectangle { property <int> idx: row * 4 + col; property <MemoryCard> item: root.memories[self.idx]; visible: self.idx < root.memories.length; width: (root.width - 60px) / 4; height: 122px; border-radius: 16px; border-width: 1px; border-color: ExpertTheme.border; background: #f6f6f8;
                        VerticalLayout { padding: 12px; spacing: 8px;
                            HorizontalLayout { Text { text: item.category; color: ExpertTheme.text; font-size: 11px; } Rectangle { horizontal-stretch: 1; } Text { text: item.time; color: #8290a6; font-size: 10px; overflow: elide; } }
                            Text { text: item.title; color: ExpertTheme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                            Text { text: item.content; color: #38465b; font-size: 12px; overflow: elide; }
                            Text { text: item.source; color: #8290a6; font-size: 11px; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-memory(idx); } }
                    }
                }
                if root.memories.length == 0 : Text { height: 48px; text: root.loading ? "正在加载…" : "暂无记忆碎片"; color: ExpertTheme.muted; }
            }
        }
        if root.tab == 5 : HorizontalLayout { height: 28px; Text { text: "已归档线程"; color: ExpertTheme.text; font-size: 14px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } ExpertButton { width: 60px; label: "刷新"; icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; clicked => { root.refresh(); } } }
        if root.tab == 5 : ListView { for item in root.archives : Rectangle { height: 69px;
            Rectangle { x: 0px; y: 0px; width: parent.width - 6px; height: 61px; border-radius: 12px; border-width: 1px; border-color: ExpertTheme.border;
                VerticalLayout { padding: 12px; spacing: 6px; HorizontalLayout { Text { text: item.title; color: ExpertTheme.text; font-size: 13px; font-weight: 600; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: item.time; color: ExpertTheme.muted; font-size: 11px; } } Text { text: "查看归档内容"; color: ExpertTheme.muted; font-size: 12px; } }
                TouchArea { mouse-cursor: pointer; clicked => { root.open-archive(item.id); } }
            }
        } }
        if root.tab == 5 : HorizontalLayout { height: 28px; Text { text: "共 " + root.archive-total + " 条"; color: ExpertTheme.muted; } Rectangle { horizontal-stretch: 1; } ExpertButton { label: "上一页"; enabled: root.archive-page > 0 && !root.loading; clicked => { root.archive-turn(-1); } } ExpertButton { label: "下一页"; enabled: (root.archive-page + 1) * 50 < root.archive-total && !root.loading; clicked => { root.archive-turn(1); } } }
        if root.tab == 4 : ScrollView { horizontal-scrollbar-policy: always-off;
            VerticalLayout { alignment: start; spacing: 12px;
                HorizontalLayout { height: 64px; spacing: 8px;
                    for stat in [{title: "运行时长", value: root.duration}, {title: "累计消耗", value: root.tokens}, {title: "工具调用次数", value: root.calls}] : Rectangle { horizontal-stretch: 1; background: #fff7f1; border-width: 1px; border-color: #ffe1cd; border-radius: 12px; VerticalLayout { padding: 10px; spacing: 6px; Text { text: stat.title; color: #a47c61; font-size: 12px; } Text { text: stat.value; color: #32170a; font-size: 18px; font-weight: 700; } } }
                }
                Rectangle { height: 320px; background: #fff7f1; border-width: 1px; border-color: #ffe1cd; border-radius: 12px;
                    VerticalLayout { padding: 12px; spacing: 8px;
                        Text { text: "日运行趋势"; color: #32170a; font-size: 14px; font-weight: 600; }
                        Text { text: "默认显示累计消耗，点击趋势图中的某一天可切换工具调用热力图日期"; color: #a47c61; font-size: 12px; }
                        Text { height: 26px; text: "○ 累计消耗"; color: #8c42ff; font-size: 12px; horizontal-alignment: center; }
                        Rectangle { vertical-stretch: 1;
                            for tick in 6 : Rectangle { x: 42px; y: tick * (parent.height - 25px) / 5; width: parent.width - 54px; height: 1px; background: #e8ebf1; }
                            Text { x: 0px; y: 0px; text: root.chart-max; color: #607087; font-size: 11px; }
                            Text { x: 20px; y: parent.height - 35px; text: "0"; color: #607087; font-size: 11px; }
                            for point[index] in root.points : Path {
                                fit: preserve;
                                x: 42px; y: 0px; width: parent.width - 54px; height: parent.height - 25px;
                                property <float> step: self.width / 1px / max(1, root.points.length - 1);
                                property <float> a: index * self.step;
                                property <float> b: min(index + 1, root.points.length - 1) * self.step;
                                property <float> ay: (1 - point.value) * self.height / 1px;
                                property <float> by: (1 - root.points[min(index + 1, root.points.length - 1)].value) * self.height / 1px;
                                stroke: #8c42ff; stroke-width: 2px;
                                commands: "M " + self.a + " " + self.ay + " C " + (self.a + self.b) / 2 + " " + self.ay + " " + (self.a + self.b) / 2 + " " + self.by + " " + self.b + " " + self.by;
                            }
                            for point[index] in root.points : Rectangle { x: 42px + index * (parent.width - 54px) / max(1, root.points.length - 1) - 16px; width: 32px; height: parent.height;
                                Rectangle { x: 13px; y: (1 - point.value) * (parent.height - 25px) - 3px; width: 6px; height: 6px; border-radius: 3px; background: white; border-width: 2px; border-color: #8c42ff; }
                                Text { y: parent.height - 19px; width: parent.width; text: point.label; color: #607087; font-size: 10px; horizontal-alignment: center; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.select-date(point.date); } }
                            }
                        }
                    }
                }
                Rectangle { height: 210px; background: #fff7f1; border-width: 1px; border-color: #ffe1cd; border-radius: 12px;
                    VerticalLayout { padding: 12px; spacing: 8px;
                        HorizontalLayout { Text { text: "工具调用热力图"; color: #32170a; font-size: 14px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: root.selected-date; color: #a47c61; } }
                        Text { text: "按工具统计调用次数，颜色越偏红表示调用越频繁"; color: #a47c61; font-size: 12px; }
                        ScrollView { horizontal-scrollbar-policy: always-off; VerticalLayout { alignment: start; spacing: 8px;
                            for row in Math.ceil(root.heat.length / 8) : HorizontalLayout { alignment: start; spacing: 8px;
                                for col in 8 : Rectangle { property <int> idx: row * 8 + col; property <HeatCard> item: root.heat[self.idx]; visible: self.idx < root.heat.length; height: 68px; width: 72px; border-radius: 10px; background: item.intensity > 0.7 ? #f6ba99 : item.intensity > 0.3 ? #93e2d7 : #d3e3f3; VerticalLayout { padding: 8px; Text { text: item.count; color: #142136; horizontal-alignment: center; font-weight: 600; } Text { text: item.name; color: #142136; font-size: 11px; overflow: elide; horizontal-alignment: center; } } }
                            }
                        } }
                    }
                }
            }
        }
    }
    if root.editor-open : Rectangle { background: #00000040; Rectangle { width: min(520px, parent.width - 40px); height: min(440px, parent.height - 30px); background: white; border-radius: 14px;
        VerticalLayout { padding: 20px; spacing: 12px;
            Text { text: root.edit-id == "" ? "新建碎片" : "编辑记忆碎片"; color: ExpertTheme.text; font-size: 16px; font-weight: 600; }
            if root.error != "" : Text { text: root.error; color: #b63a22; wrap: word-wrap; }
            ExpertField { label: "索引标题"; text <=> root.edit-title; enabled: !root.saving; }
            ExpertField { label: "标签"; text <=> root.edit-category; enabled: !root.saving; }
            TextEditBase { vertical-stretch: 1; text <=> root.edit-content; read-only: root.saving; wrap: word-wrap; background: white; border-width: 1px; border-color: ExpertTheme.border; foreground: ExpertTheme.text; scroll-view-padding: 10px; }
            HorizontalLayout { height: 30px; if root.edit-id != "" : ExpertButton { label: "删除"; icon: @image-url("../assets/icons/trash.svg"); enabled: !root.saving; clicked => { root.delete-open = true; } } Rectangle { horizontal-stretch: 1; } ExpertButton { label: "取消"; enabled: !root.saving; clicked => { root.editor-open = false; } } ExpertButton { label: "保存"; icon: @image-url("../assets/icons/save.svg"); enabled: !root.saving; selected: true; clicked => { root.save-memory(); } } }
        }
    } }
    if root.delete-open : Rectangle { background: #00000040; Rectangle { width: 300px; height: 140px; background: white; border-radius: 12px; VerticalLayout { padding: 20px; Text { text: "确定删除此记忆碎片？"; color: ExpertTheme.text; } HorizontalLayout { ExpertButton { label: "取消"; clicked => { root.delete-open = false; } } ExpertButton { label: "删除"; clicked => { root.delete-open = false; root.delete-memory(root.edit-id); } } } } } }
    if root.replicate-open : Rectangle { background: #00000040; Rectangle { width: 360px; height: 210px; background: white; border-radius: 12px; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "记忆复刻"; color: ExpertTheme.text; font-size: 16px; } Text { text: "将当前智能体的记忆复制到目标智能体，覆盖目标已有记忆。"; color: ExpertTheme.muted; wrap: word-wrap; } ComboBox { model: root.agent-names; current-index <=> root.replicate-target; } HorizontalLayout { ExpertButton { label: "取消"; clicked => { root.replicate-open = false; } } ExpertButton { label: "确认覆盖"; enabled: root.replicate-target >= 0 && !root.saving; clicked => { root.replicate-memory(root.replicate-target); root.replicate-open = false; } } } } } }
}
