// Data contracts for the settings help browser. The Rust side typesets the
// manual into absolute-positioned runs and rectangles (parley layout), and the
// Slint side only projects them. All browser state lives in the HelpDocs
// global so the view can be created and destroyed with the settings tab
// without losing the reading position.
import { I18n } from "i18n.slint";
import { MdBlock } from "theme.slint";

// The help browser owns its own context menu state: the settings page embeds
// HelpBrowser inside the main window, while the standalone help window is a
// separate top-level window. One shared global would open both menus.
export global HelpMenuState {
    in-out property <bool> open: false;
    in-out property <length> anchor-x: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <bool> has-selection: false;
}


export struct HelpEntry {
    topic: int,
    title: string,
    detail: string,
    // 侧栏分组名（开始 / 核心 / 工具 / 界面 / 参考）；索引与搜索结果为空。
    group: string,
}

export struct HelpTextRun {
    x: float,
    y: float,
    width: float,
    height: float,
    text: string,
    size: float,
    weight: int,
    color: color,
    family: string,
}

export struct HelpRect {
    x: float,
    y: float,
    width: float,
    height: float,
    fill: color,
    border: color,
    border-width: float,
    radius: float,
}

// 美术图册的预览图：按排版后的绝对位置绘制，和文字共用同一套缩放坐标。
export struct HelpImage {
    x: float,
    y: float,
    width: float,
    height: float,
    source: image,
    alt: string,
}

export global HelpDocs {
    in property <[HelpEntry]> contents;
    in property <[HelpEntry]> keyword-index;
    in property <[HelpEntry]> search-results;
    // The manual is Markdown. Rust projects the current topic once into the
    // same flat block model the chat transcript uses, and the view renders it
    // with BlockView; no absolute-positioned runs are involved any more.
    in property <[MdBlock]> blocks;
    // 80–160% zoom, applied as a type scale by BlockView.
    in property <float> font-scale: 1;
    in property <bool> can-back: false;
    in property <bool> can-forward: false;
    in property <int> match-count: 0;
    in property <string> topic-title: I18n.hp_default_topic;
    in property <int> selected-topic: 0;
    in-out property <int> active-tab: 0;
    in-out property <int> zoom-percent: 100;
    in-out property <string> search-text;
    in-out property <string> find-text;
    in-out property <float> document-width: 0;
    // Clipboard handoff for the toolbar copy button and code-block copy.
    in-out property <string> copy-text;
    in-out property <int> copy-request: 0;
    // Scroll coordination: opening a topic returns to the top, a find hit
    // reveals its position.
    in-out property <int> scroll-request: 0;
    in-out property <int> reveal-request: 0;
    in-out property <float> reveal-y: 0;
    callback topic-opened(int);
    callback history-requested(int);
    callback search-changed(string);
    callback find-changed(string);
    callback layout-changed();
    /// In-manual link: the target is a `topic:<id>` reference.
    callback link-opened(string);
    // 界面语言切换（设置 › 常规 › 语言）：zh 为 true 时加载中文手册。
    callback language-changed(bool);
    callback select-all();
    callback copy-requested();
}
