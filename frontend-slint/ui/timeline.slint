// Chat timeline (§7): full-width entries without avatars or agent bubbles.
// Every row is pre-projected and pre-bounded in Rust, so Slint only lays out
// what it was handed. The list is a self-sizing column inside one ScrollView:
// an entry expands, a streamed line wraps, and the layout follows, which is
// what a virtualized ListView cannot do while the rows keep changing height.
import { I18n } from "i18n.slint";
import { Theme, TimelineRow, PatchCard, TextBlock, TimelineSpin, TurnStatMetric } from "theme.slint";
import { MarkdownBlock } from "markdown.slint";
import { PatchDiffCard } from "patch_diff_card.slint";
import { WorkflowDetail } from "workflow_detail.slint";
import { ToolIcons } from "tool_icons.slint";
import { ProcessStatusIcon } from "status_icon.slint";
import { ToolProcess } from "tool_process.slint";
import { ScrollView, Spinner } from "std-widgets.slint";
import { ActivityCard, ActivityWeek, ActivityMonth } from "activity_card.slint";

// Presentation only: greetings never enter the transcript or its row indices.
export component ChatGreeting inherits Rectangle {
    in property <string> text: I18n.chat_greeting;
    in property <bool> loading: false;
    callback preview();
    height: greeting-row.preferred-height + 12px;
    greeting-row := HorizontalLayout {
        x: Theme.timeline-padding; y: 6px;
        width: parent.width - 2 * Theme.timeline-padding;
        spacing: 8px;
        Text {
            text: root.text == "" ? I18n.chat_greeting : root.text;
            color: Theme.text; font-size: Theme.font-lg;
            wrap: word-wrap; horizontal-stretch: 1;
        }
        Rectangle {
            width: 22px; height: 22px; border-radius: 6px;
            background: preview-touch.has-hover ? Theme.hover : transparent;
            accessible-role: button; accessible-label: I18n.chat_prompt_preview;
            accessible-enabled: !root.loading;
            accessible-action-default => { if !root.loading { root.preview(); } }
            forward-focus: preview-focus;
            Image {
                x: 5px; y: 5px; width: 12px; height: 12px;
                source: @image-url("../assets/icons/eye.svg");
                colorize: preview-touch.has-hover ? Theme.text-secondary : Theme.muted;
            }
            preview-focus := FocusScope {
                enabled: !root.loading;
                key-pressed(event) => {
                    if event.text == " " || event.text == Key.Return { root.preview(); return accept; }
                    return reject;
                }
            }
            preview-touch := TouchArea {
                enabled: !root.loading; mouse-cursor: pointer;
                clicked => { preview-focus.focus(); root.preview(); }
                Tooltip { text: @markdown("\{I18n.chat_prompt_preview}"); }
            }
        }
    }
}

// One entry kind per timeline row; the Rust projection stamps the matching
// value (see src/timeline.rs).
// Icons for the end-of-turn metrics, mirroring the web component's Font Awesome
// classes: stopwatch / gauge-high / layer-group / bolt / screwdriver-wrench.
// Kept out of ToolIcons because these are message statistics, not tools.
export global StatsIcons {
    public pure function is-live(key: string) -> bool {
        key.starts-with("status-") && key != "status-error" && key != "status-stopped";
    }
    public pure function image(key: string) -> image {
        key == "hashtag" ? @image-url("../assets/icons/hashtag.svg") :
        key == "status-running" ? @image-url("../assets/icons/rotate-right.svg") :
        key == "status-requesting" ? @image-url("../assets/icons/paper-plane.svg") :
        key == "status-outputting" ? @image-url("../assets/icons/comment-dots.svg") :
        key == "status-tool" ? @image-url("../assets/icons/screwdriver-wrench.svg") :
        key == "status-subagent" ? @image-url("../assets/icons/fa-diagram-project.svg") :
        key == "status-compacting" ? @image-url("../assets/icons/fa-compress.svg") :
        key == "status-queued" ? @image-url("../assets/icons/fa-clock.svg") :
        key == "status-stopped" ? @image-url("../assets/icons/stop.svg") :
        key == "status-error" ? @image-url("../assets/icons/xmark.svg") :
        key == "status-waiting" ? @image-url("../assets/icons/fa-circle-question.svg") :
        key == "coins" ? @image-url("../assets/icons/coins.svg") :
        key == "stopwatch" ? @image-url("../assets/icons/stopwatch.svg") :
        key == "gauge-high" ? @image-url("../assets/icons/gauge-high.svg") :
        key == "layer-group" ? @image-url("../assets/icons/layer-group.svg") :
        key == "bolt" ? @image-url("../assets/icons/bolt.svg") :
        key == "screwdriver-wrench" ? @image-url("../assets/icons/screwdriver-wrench.svg") :
        @image-url("../assets/icons/wrench.svg");
    }
    // The label is the tooltip and the accessible name. Slint has no map, so the
    // key is resolved through the same branch chain as the icon.
    public pure function label(key: string) -> string {
        key == "hashtag" ? I18n.tl_stat_round :
        key == "status-running" ? I18n.tl_status_running :
        key == "status-requesting" ? I18n.tl_status_requesting :
        key == "status-outputting" ? I18n.tl_status_outputting :
        key == "status-tool" ? I18n.tl_status_tool :
        key == "status-subagent" ? I18n.tl_status_subagent :
        key == "status-compacting" ? I18n.tl_status_compacting :
        key == "status-queued" ? I18n.tl_status_queued :
        key == "status-stopped" ? I18n.tl_status_stopped :
        key == "status-error" ? I18n.tl_status_error :
        key == "status-waiting" ? I18n.tl_status_waiting :
        key == "coins" ? I18n.tl_stat_credits :
        key == "stopwatch" ? I18n.tl_stat_duration :
        key == "gauge-high" ? I18n.tl_stat_speed :
        key == "layer-group" ? I18n.tl_stat_context :
        key == "bolt" ? I18n.tl_stat_quota :
        key == "screwdriver-wrench" ? I18n.tl_stat_tools :
        key;
    }
    public pure function hint(key: string) -> string {
        key == "status-running" ? I18n.tl_status_running :
        key == "status-requesting" ? I18n.tl_status_requesting :
        key == "status-outputting" ? I18n.tl_status_outputting :
        key == "status-tool" ? I18n.tl_status_tool :
        key == "status-subagent" ? I18n.tl_status_subagent :
        key == "status-compacting" ? I18n.tl_status_compacting :
        key == "status-queued" ? I18n.tl_status_queued :
        key == "status-stopped" ? I18n.tl_status_stopped :
        key == "status-error" ? I18n.tl_status_error :
        key == "status-waiting" ? I18n.tl_status_waiting :
        key == "gauge-high" ? I18n.tl_stat_speed_hint :
        key == "layer-group" ? I18n.tl_stat_context_hint :
        StatsIcons.label(key);
    }

}

export global EntryKind {
    out property <int> user: 0;
    out property <int> body: 1;
    out property <int> reason: 2;
    out property <int> tool: 3;
    out property <int> group: 4;
    out property <int> subagent: 5;
    out property <int> process: 6;
    out property <int> footer: 7;
}

// One shared rotation driver for every running spinner; a single timer in the
// view keeps a busy turn from installing one timer per entry.
// The tool timeline gutter: a dot with the connector drawn through it. Slint has
// no module-level constants, so the shared metrics live in a global.
export global TimelineMetrics {
    out property <length> gutter: 20px;
}

// Status icon, matching the web entry row: a 12px outlined circle with a check
// (done) or cross (failed), and a plain grey spinner while running. The old
// filled green/red dot read as a status light; the outline reads as a tick.
component StatusDot inherits ProcessStatusIcon {
    in property <int> phase;
}

// Disclosure arrow: 0 collapsed, 90 expanded.
component FoldCaret inherits Rectangle {
    in property <bool> open: false;
    width: 12px; height: 12px;
    Image {
        width: parent.width; height: parent.height;
        source: @image-url("../assets/icons/disclosure.svg");
        colorize: Theme.muted; image-fit: contain;
        transform-rotation: root.open ? 90deg : 0deg;
    }
}

component TargetChip inherits Rectangle {
    in property <string> label;
    height: 18px;
    // The chip never crowds the summary out of the row.
    width: min(chip-text.preferred-width + 14px, 180px);
    border-radius: Theme.radius-tag; background: Theme.hover;
    chip-text := Text {
        x: 7px; y: 0px; width: parent.width - 14px; height: parent.height;
        text: root.label; color: Theme.muted; font-size: Theme.font-sm;
        vertical-alignment: center; overflow: elide;
    }
}

// A 20px gutter holding the connector and, for batched entries, the node dot.
// A group bar hangs its disclosure caret here instead of a dot, so the toggle
// sits on the same rail the batched entries hang from.
component TimelineGutter inherits Rectangle {
    in property <bool> line: false;
    in property <bool> node: false;
    in property <int> status: 0;
    in property <bool> caret: false;
    in property <bool> caret-open: false;
    width: TimelineMetrics.gutter;
    Rectangle {
        visible: root.line;
        x: (TimelineMetrics.gutter - 1px) / 2;
        y: root.caret ? parent.height / 2 + 7px : 0px;
        width: 1px;
        height: root.caret ? parent.height / 2 - 7px : parent.height;
        background: Theme.timeline-line;
    }
    StatusDot {
        visible: root.node;
        x: (TimelineMetrics.gutter - self.width) / 2; y: 7px;
        status: root.status;
    }
    if root.caret : FoldCaret {
        x: (TimelineMetrics.gutter - 12px) / 2;
        y: (parent.height - 12px) / 2;
        open: root.caret-open;
    }
}

// ---- user bubble (§7.2): right aligned, no avatar ----
component UserBubble inherits HorizontalLayout {
    in property <TimelineRow> data;
    callback copy-text(string);
    callback open-resource(string);
    padding-left: Theme.timeline-padding; padding-right: Theme.timeline-padding; padding-top: 10px; padding-bottom: 4px;
    Rectangle { horizontal-stretch: 1; }
    bubble := Rectangle {
        width: min(parent.width * 0.7, bubble-body.preferred-width + 24px);
        height: bubble-body.preferred-height + 16px;
        border-radius: Theme.radius-lg; background: Theme.timeline-bubble;
        bubble-body := VerticalLayout {
            x: 12px; y: 8px; width: parent.width - 24px;
            spacing: 6px;
            if root.data.blocks.length == 0 && root.data.text != "" : TextInput {
                text: root.data.text; color: Theme.text; font-size: Theme.font-lg; line-height-factor: 1.5;
                read-only: true; wrap: word-wrap;
            }
            for block in root.data.blocks : MarkdownBlock {
                block: block;
                copy-code(text) => { root.copy-text(text); }
                open-resource(path) => { root.open-resource(path); }
            }
        }
    }
}

component FooterMetric inherits Rectangle {
    in property <TurnStatMetric> metric;
    private property <bool> is-status: root.metric.key.starts-with("status-");
    private property <bool> live: StatsIcons.is-live(root.metric.key);
    private property <bool> warning: root.metric.key == "status-waiting" || root.metric.key == "status-compacting";
    private property <bool> muted: root.metric.key == "status-queued" || root.metric.key == "status-stopped";
    private property <color> tone: root.metric.key == "status-error" ? #dc2626
        : root.warning ? #d97706 : root.muted ? #64748b : root.is-status ? #2563eb : Theme.muted;
    private property <float> pulse: root.live ? 0.5 - 0.5 * cos(TimelineSpin.angle * 1deg) : 0;
    width: metric-row.preferred-width; height: 22px;
    border-radius: 11px;
    border-width: root.is-status ? 1px : 0px;
    border-color: root.tone.with-alpha(0.2);
    background: !root.is-status ? transparent : root.metric.key == "status-error" ? #fef2f2
        : root.warning ? #fff7ed : root.muted ? #f8fafc : #eff6ff;
    accessible-role: text;
    accessible-label: StatsIcons.label(root.metric.key) + " " + root.metric.value;
    metric-row := HorizontalLayout {
        padding-left: root.is-status ? 8px : 0px;
        padding-right: root.is-status ? 8px : 0px;
        spacing: root.is-status ? 6px : 4px; alignment: start;
        Rectangle {
            width: 12px; height: 22px;
            Image {
                // Fixed outer slot: pulse never invalidates the footer layout.
                width: 12px * (root.live ? 0.94 + 0.14 * root.pulse : 1);
                height: self.width; x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 - root.pulse * 1px;
                source: StatsIcons.image(root.metric.key); colorize: root.tone;
                opacity: root.live ? 0.58 + 0.42 * root.pulse : 0.9;
            }
        }
        Text {
            height: 22px; text: root.metric.key == "hashtag" ? I18n.tl_user_round(root.metric.value) : root.metric.value;
            color: root.is-status ? root.tone : Theme.text;
            font-size: Theme.font-xs; font-weight: root.is-status ? 600 : 400; vertical-alignment: center;
        }
    }
    Tooltip { text: @markdown("\{StatsIcons.hint(root.metric.key)}"); }
}

// Wrap the compact metrics on narrow chat columns without squeezing values.
component FooterStats inherits Rectangle {
    in property <[TurnStatMetric]> metrics;
    in property <length> available-width;
    private property <bool> live: root.metrics.length > 0 && StatsIcons.is-live(root.metrics[0].key);
    min-width: 0px; preferred-width: 0px;
    height: root.live ? 22px : footer-column.preferred-height;
    if root.live : FooterMetric { x: 0px; y: 0px; metric: root.metrics[0]; }
    footer-column := FlexboxLayout {
        visible: !root.live;
        width: root.available-width;
        spacing-horizontal: 12px; spacing-vertical: 0px; alignment: start;
        for metric in root.metrics : FooterMetric { metric: metric; }
    }
}

// ---- assistant body block (§7.3 A): page text, no bubble ----
component BodyBlock inherits Rectangle {
    in property <TimelineRow> data;
    callback copy-text(string);
    callback open-resource(string);
    height: body-column.preferred-height;
    body-column := VerticalLayout {
        padding-left: Theme.timeline-padding; padding-right: Theme.timeline-padding;
        padding-top: 6px; padding-bottom: 6px; spacing: 6px;
        if root.data.blocks.length == 0 && root.data.text != "" : TextInput {
            text: root.data.text; color: Theme.text; font-size: Theme.font-lg; line-height-factor: 1.5;
            read-only: true; wrap: word-wrap;
        }
        for block in root.data.blocks : MarkdownBlock {
            block: block;
            copy-code(text) => { root.copy-text(text); }
            open-resource(path) => { root.open-resource(path); }
        }
    }
}

// A turn owns its footer even when its text is empty or inside the process.
component TurnFooter inherits Rectangle {
    in property <TimelineRow> data;
    callback copy-text(string);
    callback copy-original(string);
    function copy-answer() {
        if root.data.id.starts-with("cloud-footer-") { root.copy-original(root.data.summary); }
        else { root.copy-text(root.data.text); }
    }
    height: footer-row.preferred-height + 8px;
    footer-row := HorizontalLayout {
        x: Theme.timeline-padding; y: 4px; width: parent.width - 2 * Theme.timeline-padding;
        spacing: 8px;
        FooterStats { metrics: root.data.stats; available-width: root.width - 2 * Theme.timeline-padding - 30px; horizontal-stretch: 1; }
        Rectangle {
            visible: root.data.text != "";
            width: 22px; height: 22px; border-radius: Theme.radius-tag;
            accessible-role: button; accessible-label: I18n.common_copy;
            accessible-action-default => { root.copy-answer(); }
            forward-focus: copy-focus;
            background: copy-area.has-hover ? Theme.selected : transparent;
            Image {
                x: 5px; y: 5px; width: 12px; height: 12px;
                source: @image-url("../assets/icons/copy.svg"); colorize: Theme.muted;
            }
            copy-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == Key.Return { root.copy-answer(); return accept; }
                    return reject;
                }
            }
            copy-area := TouchArea { mouse-cursor: pointer; clicked => { copy-focus.focus(); root.copy-answer(); } }
            Tooltip { text: @markdown("\{I18n.common_copy}"); }
        }
    }
}

// ---- reasoning (2) and tool (3) entries share one header ----
component FoldEntry inherits Rectangle {
    in property <TimelineRow> data;
    in property <bool> in-group: false;
    callback toggle(int);
    callback copy-text(string);
    callback open-resource(string);
    // Nothing to unfold means no toggle affordance at all, as on the web.
    private property <bool> expandable: root.data.detail != "" || root.data.patch.length > 0;
    height: entry-column.preferred-height;
    entry-column := VerticalLayout {
        padding-left: 0px; padding-right: 0px; padding-top: 1px; padding-bottom: 1px;
        spacing: 0px;
        // The head is one full-width button, as on the web: the hover tint is
        // the head's own background, so it paints under the label. A band
        // declared after the content would cover the text instead.
        head := Rectangle {
            height: 26px;
            border-radius: Theme.radius-tag;
            background: head-touch.has-hover ? Theme.hover : transparent;
            head-touch := TouchArea {
                x: Theme.timeline-padding + TimelineMetrics.gutter;
                width: parent.width - Theme.timeline-padding * 2 - TimelineMetrics.gutter;
                height: parent.height;
                mouse-cursor: root.expandable ? MouseCursor.pointer : MouseCursor.default;
                clicked => { if root.expandable { root.toggle(root.data.payload); } }
            }
            head-row := HorizontalLayout {
                x: Theme.timeline-padding; y: 0px;
                width: parent.width - Theme.timeline-padding * 2; height: parent.height;
                spacing: 8px;
                TimelineGutter {
                    line: root.in-group; node: true;
                    status: root.data.status-kind;
                }
                Image {
                    y: 6.5px; width: 13px; height: 13px;
                    source: ToolIcons.image(root.data.tool-icon);
                    colorize: Theme.muted; image-fit: contain;
                    // A thinking entry has no tool glyph: the web row reads as
                    // status, label, outcome.
                    visible: root.data.tool-icon != "";
                }
                Text {
                    width: self.preferred-width; height: parent.height;
                    text: root.data.tool-name; color: Theme.muted; font-size: Theme.font-md;
                    vertical-alignment: center; visible: root.data.tool-name != "";
                }
                // The target chip belongs to the name; the summary then reads as
                // the outcome of the call.
                TargetChip { y: 4px; label: root.data.target; visible: root.data.target != ""; }
                Rectangle {
                    horizontal-stretch: 1; min-width: 0px; height: parent.height;
                    clip: true;
                    summary-text := Text {
                        x: root.data.kind == EntryKind.reason && root.data.status-kind == 1
                            ? min(0px, parent.width - self.preferred-width) : 0px;
                        width: root.data.kind == EntryKind.reason && root.data.status-kind == 1
                            ? max(parent.width, self.preferred-width) : parent.width;
                        height: parent.height;
                        text: root.data.summary; color: Theme.timeline-entry-soft; font-size: Theme.font-sm;
                        overflow: elide; vertical-alignment: center;
                    }
                }
                if root.data.kind == EntryKind.tool && root.data.tool-metrics != "" : Text {
                    width: self.preferred-width; height: parent.height;
                    text: root.data.tool-metrics;
                    color: Theme.muted; font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
        }
        // The expanded payload clears the page margin and the gutter it hangs
        // from.
        if root.data.open : VerticalLayout {
            padding-left: Theme.timeline-padding + TimelineMetrics.gutter;
            padding-right: Theme.timeline-padding;
            padding-top: 4px; padding-bottom: 8px;
            spacing: 8px;
            for card in root.data.patch : PatchDiffCard { card: card; }
            // A thinking entry shows its own text, unlabelled: the web timeline
            // renders it as a plain block, while a tool result keeps the
            // structured viewer with its "输出" head.
            if root.data.kind == EntryKind.reason && root.data.detail != "" : Rectangle {
                height: min(240px, thinking-box.preferred-height + 16px);
                border-radius: Theme.radius-sm; background: Theme.panel;
                border-width: 1px; border-color: Theme.border;
                private property <bool> follow-tail: true;
                private property <bool> scroll-pending: true;
                private property <string> live-text: root.data.detail;
                changed live-text => { self.scroll-pending = true; }
                Timer {
                    interval: 33ms;
                    running: parent.scroll-pending;
                    triggered => {
                        parent.scroll-pending = false;
                        if parent.follow-tail {
                            thinking-scroll.content-y = min(0px, thinking-scroll.visible-height - thinking-scroll.content-height);
                        }
                    }
                }
                thinking-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
                    x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                    // Same rule as the process card: a ScrollView only infers its
                    // content height from layout children, and this one holds a
                    // TextInput. Without it the box was capped at 240px with the
                    // rest of the reasoning unreachable.
                    content-height: max(self.visible-height, thinking-box.preferred-height);
                    content-width: self.visible-width;

                    thinking-box := TextInput {
                        text: root.data.detail; read-only: true; wrap: word-wrap;
                        color: Theme.muted; font-size: Theme.font-sm;
                    }
                    scrolled => {
                        parent.follow-tail = self.visible-height - self.content-height - self.content-y >= -24px;
                    }
                }
            }
            if root.data.kind != EntryKind.reason && root.data.detail != "" : Rectangle {
                height: min(240px, tool-body.preferred-height + 16px);
                border-radius: Theme.radius-sm; background: Theme.panel;
                border-width: 1px; border-color: Theme.border;
                tool-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: as-needed;
                    x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                    content-height: max(self.visible-height, tool-body.preferred-height);
                    content-width: self.visible-width;

                    tool-body := WorkflowDetail {
                        sections: root.data.sections;
                        fallback: root.data.detail;
                        copy(text) => { root.copy-text(text); }
                    }
                }
            }
        }
    }
}

component GroupBar inherits Rectangle {
    in property <TimelineRow> data;
    callback toggle(int);
    // The open bar is the heavier of the two: 32px of 13px secondary text,
    // against 30px of 12px muted text when the batch is folded.
    height: root.data.open ? 32px : 30px;
    // Same rule as FoldEntry.head: the tint is the bar's own background so it
    // stays under the label, and the click target is declared first.
    border-radius: Theme.radius-tag;
    background: bar-touch.has-hover ? Theme.hover : transparent;
    bar-touch := TouchArea {
        x: Theme.timeline-padding; y: 0px;
        width: parent.width - Theme.timeline-padding * 2;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggle(root.data.payload); }
    }
    HorizontalLayout {
        padding-left: Theme.timeline-padding; padding-right: Theme.timeline-padding;
        spacing: 0px;
        TimelineGutter { line: root.data.open; caret: true; caret-open: root.data.open; }
        bar-row := HorizontalLayout {
            height: parent.height; spacing: 8px;
            Text {
                width: self.preferred-width; height: parent.height;
                text: root.data.text; color: root.data.open ? Theme.text-secondary : Theme.muted;
                font-size: root.data.open ? Theme.font-md : Theme.font-sm;
                vertical-alignment: center;
            }
            // What the batch last did, read out while it is folded.
            Text {
                horizontal-stretch: 1; min-width: 0px; height: parent.height;
                text: root.data.summary; color: Theme.muted; font-size: Theme.font-sm;
                overflow: elide; vertical-alignment: center;
                visible: !root.data.open && root.data.summary != "";
            }
        }
    }
}

// ---- work-process fold (§7.3 A): one bar over the turn's intermediate rows ----
// The bar is the turn's only handle on everything before its newest answer
// block: thinking, tool batches and the earlier rounds' printed notes. Folded
// (the default) the reader sees one line and the answer; unfolded the batches
// come with it, because opening the process is the user asking to see the work.
component ProcessBar inherits Rectangle {
    in property <TimelineRow> data;
    in property <length> process-height: Theme.workflow-height;
    callback toggle(int);
    callback process-page(int, int);
    callback copy-text(string);
    callback open-resource(string);
    // During a live turn the current work is the visible tail of the
    // conversation and starts unfolded: the reducer stamps the bar's `open`
    // when it first reveals the process. After that `open` is the single source
    // of truth for the fold, so the bar handle collapses and expands at any
    // time, live or settled. (Visibility alone used to force a running process
    // open, which made the handle inert until the turn finished.)
    // One step heavier than a batch bar: it owns a whole turn's process.
    height: root.data.open ? 40px + process-body.height : 34px;
    border-radius: Theme.radius-tag;
    // Keep the work-process row calm while the pointer moves across it. The
    // affordance is the small left control, matching the compact web header.
    background: transparent;
    accessible-role: button;
    accessible-label: root.data.text + " " + root.data.summary;
    accessible-action-default => { root.toggle(root.data.payload); }
    forward-focus: process-focus;
    process-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.toggle(root.data.payload); return accept; }
            return reject;
        }
    }
    bar-touch := TouchArea {
        x: Theme.timeline-padding; y: 0px;
        width: parent.width - Theme.timeline-padding * 2;
        height: 34px;
        mouse-cursor: pointer;
        clicked => { process-focus.focus(); root.toggle(root.data.payload); }
    }
    HorizontalLayout {
        y: 0px; height: 34px; width: parent.width;
        padding-left: Theme.timeline-padding; padding-right: Theme.timeline-padding;
        spacing: 0px;
        process-gutter := Rectangle {
            width: 22px; height: parent.height;
            Rectangle {
                x: 1px; y: 8px; width: 16px; height: 16px;
                border-radius: 8px; border-width: 1px;
                border-color: process-hit.has-hover ? Theme.border-strong : Theme.border;
                background: process-hit.has-hover ? Theme.hover : Theme.surface;
            }
            Image {
                x: 4px; y: (parent.height - 12px) / 2;
                width: 12px; height: 12px;
                source: @image-url("../assets/icons/disclosure.svg");
                colorize: Theme.muted; image-fit: contain;
                transform-rotation: root.data.open ? 90deg : 0deg;
            }
            process-hit := TouchArea {
                mouse-cursor: pointer;
                clicked => { process-focus.focus(); root.toggle(root.data.payload); }
            }
        }
        HorizontalLayout {
            height: parent.height; spacing: 8px;
            Text {
                width: self.preferred-width; height: parent.height;
                text: root.data.text; color: Theme.text-secondary;
                font-size: Theme.font-md; vertical-alignment: center;
            }
            // Phase stays visible with either fold state; entry outputs remain
            // in their own rows.
            Text {
                horizontal-stretch: 1; min-width: 0px; height: parent.height;
                text: root.data.summary; color: Theme.muted; font-size: Theme.font-sm;
                overflow: elide; vertical-alignment: center;
                visible: root.data.summary != "";
            }
        }
    }
    process-body := ToolProcess {
        visible: root.data.open;
        x: 0px; y: 34px;
        width: parent.width;
        viewport-limit: root.process-height;
        // Keep the stable child model bound while collapsed during a live turn.
        // Replacing it with [] deferred insert notifications until settlement.
        entries: root.data.process-entries;
        paged: root.data.process-paged;
        has-older: root.data.process-older;
        has-newer: root.data.process-newer;
        loading: root.data.process-loading;
        failed: root.data.process-error;
        revision: root.data.process-revision;
        active: (root.data.open) && root.data.process-root != "" && !root.data.process-local;
        live: root.data.status-kind == 1;
        page(direction) => { root.process-page(root.data.payload, direction); }
        toggle(index) => { root.toggle(index); }
        copy-text(text) => { root.copy-text(text); }
        open-resource(path) => { root.open-resource(path); }
    }
}

// One child run of the turn (kind 5): a card at the turn's tail, the place the
// web messenger parks its subagent panel. Clicking opens the child thread in
// the detail dialog, which renders the same TimelineView rows; a running card
// also carries the interrupt action the runtime controls.
component SubagentCard inherits Rectangle {
    in property <TimelineRow> data;
    callback open-subagent(string);
    callback stop-subagent(string);
    height: card-column.preferred-height;
    card-column := VerticalLayout {
        padding-left: Theme.timeline-padding + TimelineMetrics.gutter;
        padding-right: Theme.timeline-padding;
        padding-top: 2px; padding-bottom: 2px;
        card := Rectangle {
            preferred-height: card-inner.preferred-height + 14px;
            min-height: self.preferred-height;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: card-touch.has-hover ? Theme.border-strong : Theme.border;
            background: card-touch.has-hover ? Theme.hover : Theme.panel;
            card-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-subagent(root.data.subagent-id); }
            }
            card-inner := VerticalLayout {
                x: 10px; y: 7px;
                width: parent.width - 20px;
                spacing: 3px;
                head-row := HorizontalLayout {
                    spacing: 8px;
                    height: card-title.preferred-height;
                    Image {
                        width: 13px; height: 13px;
                        source: ToolIcons.image(root.data.tool-icon);
                        colorize: Theme.muted; image-fit: contain;
                    }
                    card-title := Text {
                        max-width: 220px;
                        text: root.data.text; color: Theme.text;
                        font-size: Theme.font-md; vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: self.preferred-width; vertical-alignment: center;
                        text: root.data.status-kind == 1 ? I18n.sub_status_running
                            : root.data.status-kind == 2 ? I18n.sub_status_failed
                            : I18n.sub_status_done;
                        color: root.data.status-kind == 1 ? Theme.accent-ink
                            : root.data.status-kind == 2 ? Theme.danger
                            : Theme.success;
                        font-size: Theme.font-sm;
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 0px; }
                    if root.data.subagent-stoppable : stop-button := Rectangle {
                        width: 22px; height: 22px; border-radius: 11px;
                        background: stop-touch.has-hover ? Theme.danger-bg : transparent;
                        Image {
                            x: 6px; y: 6px; width: 10px; height: 10px;
                            source: @image-url("../assets/icons/stop.svg");
                            colorize: Theme.danger; image-fit: contain;
                        }
                        stop-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.stop-subagent(root.data.subagent-id); }
                        }
                    }
                    Text {
                        width: self.preferred-width; vertical-alignment: center;
                        text: I18n.sub_card_title; color: Theme.muted;
                        font-size: Theme.font-sm;
                    }
                }
                if root.data.summary != "" : Text {
                    text: root.data.summary; color: Theme.muted;
                    font-size: Theme.font-sm; overflow: elide;
                }
            }
        }
    }
}

export component TimelineRowView inherits Rectangle {
    in property <TimelineRow> entry;
    in property <length> process-height: Theme.workflow-height;
    callback toggle(int);
    callback process-page(int, int);
    callback copy-text(string);
    callback copy-original(string);
    callback open-resource(string);
    callback open-subagent(string);
    callback stop-subagent(string);
    width: 100%;
    // A batch entry belongs to its bar: folding the bar takes the entries with
    // it, which is what `toggle` writes into `group-open` across the group. The
    // bar itself is the handle and always stays laid out.
    // The work-process fold is the same mechanism one level up: the bar is the
    // handle, and a folded process takes its batches and notes out of the layout.
    private property <bool> in-process: root.entry.kind != EntryKind.process
        && root.entry.process-idx != -1;
    private property <bool> shown: root.entry.visible
        && (root.entry.kind == EntryKind.group
            || root.entry.kind == EntryKind.process
            || root.entry.group-idx == -1
            || root.entry.group-open)
        && !root.in-process;
    visible: root.shown;
    // The column sizes every row from its own content, so an unfold or a
    // wrapped line simply makes the timeline taller. A hidden row has to give
    // its height back: Slint keeps the reservation of an invisible layout item,
    // so a folded batch would otherwise leave a hole the size of its content.
    height: root.shown ? cell.preferred-height : 0px;
    cell := VerticalLayout {
        width: root.width;
        spacing: 0px; alignment: start;
        if root.shown && root.entry.kind == EntryKind.user : UserBubble {
            data: root.entry;
            copy-text(text) => { root.copy-text(text); }
            open-resource(path) => { root.open-resource(path); }
        }
        if root.shown && root.entry.kind == EntryKind.body : BodyBlock {
            data: root.entry;
            copy-text(text) => { root.copy-text(text); }
            open-resource(path) => { root.open-resource(path); }
        }
        if root.shown && root.entry.kind == EntryKind.footer : TurnFooter {
            data: root.entry;
            copy-text(text) => { root.copy-text(text); }
            copy-original(id) => { root.copy-original(id); }
        }
        if root.shown && (root.entry.kind == EntryKind.reason || root.entry.kind == EntryKind.tool) : FoldEntry {
            data: root.entry;
            in-group: root.entry.group-idx != -1;
            toggle(index) => { root.toggle(index); }
            copy-text(text) => { root.copy-text(text); }
            open-resource(id) => { root.open-resource(id); }
        }
        if root.shown && root.entry.kind == EntryKind.group : GroupBar {
            data: root.entry;
            toggle(index) => { root.toggle(index); }
        }
        if root.shown && root.entry.kind == EntryKind.process : ProcessBar {
            data: root.entry;
            process-height: root.process-height;
            toggle(index) => { root.toggle(index); }
            process-page(index, direction) => { root.process-page(index, direction); }
            copy-text(text) => { root.copy-text(text); }
            open-resource(path) => { root.open-resource(path); }
        }
        if root.shown && root.entry.kind == EntryKind.subagent : SubagentCard {
            data: root.entry;
            open-subagent(id) => { root.open-subagent(id); }
            stop-subagent(id) => { root.stop-subagent(id); }
        }
    }
}

export component TimelineView inherits Rectangle {
    in property <[TimelineRow]> rows;
    in property <string> greeting;
    in property <bool> loading: false;
    in property <string> loading-text: I18n.st_runtime_loading;
    in property <bool> greeting-loading: false;
    in property <bool> show-activity: false;
    in property <[ActivityWeek]> activity-sessions;
    in property <[ActivityWeek]> activity-credits;
    in property <[ActivityMonth]> activity-months;
    in-out property <int> activity-tab: 0;
    callback preview-prompt();
    // Fractional offset (row index / row count) of every user turn; the ruler
    // strip renders one tick per mark and jumping is proportional.
    in property <[float]> turn-marks: [];
    in-out property <bool> follow-output: true;
    // A turn is still producing output, so the running entries' rings have to
    // keep turning. Without this the spin timer ticks for the whole session and
    // re-evaluates every status dot on screen.
    in property <bool> spinning: false;
    // Incremented by the native reducer after one coalesced stream frame.
    // This is a change signal for scroll following, not display data.
    in property <int> stream-revision: 0;
    // Live scroll offset of the timeline viewport, published for the native
    // smoke checks (they assert the position holds while the user reads back).
    out property <length> scroll-y: rows-scroll.content-y;
    callback load-older();
    private property <bool> older-requested: false;
    callback toggle(int);
    callback process-page(int, int);
    callback copy-text(string);
    callback copy-original(string);
    callback open-resource(string);
    callback open-subagent(string);
    callback stop-subagent(string);
    vertical-stretch: 1;
    // Reading column: the transcript is one centred column of at most
    // `timeline-column-width`, so a wide window leaves page margins instead of
    // stretching every line across the whole pane. The turn ruler keeps the
    // viewport edge, exactly like the web messenger's chat lane.
    private property <length> column-width: min(rows-scroll.visible-width, Theme.timeline-column-width);
    private property <length> transcript-height: rows-scroll.content-height;
    private property <int> follow-passes: 2;
    private property <bool> follow-pending: true;
    // Push the viewport to the newest content on request; the projection calls
    // this when it follows the stream, and the "back to latest" action does too.
    public function scroll-to-end() {
        rows-scroll.content-y = min(0px, rows-scroll.visible-height - rows-scroll.content-height);
    }
    public function scroll-to-top() {
        root.follow-output = false;
        rows-scroll.content-y = 0px;
    }
    // Land the requested user turn around the middle of the viewport. The mark
    // is a fraction of the whole content, so no per-row heights are needed.
    public function jump-to-turn(fraction: float) {
        root.follow-output = false;
        rows-scroll.content-y = clamp(
            rows-scroll.visible-height / 2 - fraction * rows-scroll.content-height,
            rows-scroll.visible-height - rows-scroll.content-height, 0px);
    }
    private property <[TurnStatMetric]> tail-stats: root.rows.length > 0
        && root.rows[root.rows.length - 1].kind == EntryKind.footer ? root.rows[root.rows.length - 1].stats : [];
    private property <bool> live-footer: root.tail-stats.length > 0 && StatsIcons.is-live(root.tail-stats[0].key);
    spin-timer := Timer {
        interval: 30ms; running: root.spinning || root.live-footer;
        triggered => { TimelineSpin.angle = Math.mod(TimelineSpin.angle + 9.0, 360.0); }
    }
    // A streamed line is laid out after the frame that triggered it. Follow on
    // two subsequent frames only after content changed. A permanently running
    // 33ms timer fought touchpad/wheel scrolling and repainted idle history.
    follow-timer := Timer {
        interval: 16ms; running: root.follow-output && root.follow-pending;
        triggered => {
            root.scroll-to-end();
            if root.follow-passes > 0 {
                root.follow-passes -= 1;
            } else {
                root.follow-pending = false;
            }
        }
    }
    changed follow-output => {
        if root.follow-output {
            root.follow-passes = 2;
            root.follow-pending = true;
            root.scroll-to-end();
        }
    }
    changed stream-revision => {
        if root.follow-output {
            root.follow-passes = 2;
            root.follow-pending = true;
        }
    }
    changed transcript-height => {
        // Prepending an older page changes the transcript height while the
        // viewport remains at its top edge. The preceding request is now
        // settled, so permit the next intentional upward scroll to request
        // one more bounded page.
        root.older-requested = false;
        if root.follow-output {
            root.follow-passes = 2;
            root.follow-pending = true;
        }
    }
    rows-scroll := ScrollView {
        horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
        x: 0px; y: 0px; width: 100%; height: 100%;
        // Wheel/touchpad scrolling stays available without reserving a track:
        // streaming row widths remain stable as the viewport scrolls.
        content-width: self.visible-width;
        // ScrollView infers overflow from its child's minimum height. Keep
        // that intrinsic constraint intact; empty-state centering must not
        // replace it with the viewport height (or zero for a conversation).
        content-height: max(self.visible-height, rows-column.preferred-height);
        rows-column := VerticalLayout {
            width: root.column-width;
            x: (rows-scroll.visible-width - root.column-width) / 2;
            // The web scrolls its transcript inside `.messenger-chat-body`,
            // which owns `padding: 18px 20px 22px`; rows only add their own 6px.
            // Without that inset the first block (the greeting on a fresh
            // thread) was pinned to the pane's top edge. Keep the top inset
            // here so a greeting, the loading line and the activity card all
            // start from the same optical line as the cloud client.
            padding-top: 18px;
            spacing: 0px; alignment: root.show-activity || root.loading ? center : start;
            if root.loading : Rectangle {
                height: 76px;
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-2;
                    Spinner { width: 18px; height: 18px; }
                    Text {
                        text: root.loading-text;
                        color: Theme.muted;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                }
            }
            if root.show-activity : ActivityCard {
                sessions: root.activity-sessions;
                credits: root.activity-credits;
                months: root.activity-months;
                tab <=> root.activity-tab;
            }
            if root.show-activity : Rectangle { height: 18px; }
            if !root.loading : ChatGreeting {
                text: root.greeting;
                loading: root.greeting-loading;
                preview => { root.preview-prompt(); }
            }
            for item in root.rows : TimelineRowView {
                entry: item;
                process-height: min(Theme.workflow-height, root.height * 0.64);
                toggle(target) => { root.toggle(target); }
                process-page(index, direction) => { root.process-page(index, direction); }
                copy-text(text) => { root.copy-text(text); }
                copy-original(id) => { root.copy-original(id); }
                open-resource(id) => { root.open-resource(id); }
                open-subagent(id) => { root.open-subagent(id); }
                stop-subagent(id) => { root.stop-subagent(id); }
            }
        }
        scrolled => {
            root.follow-output = self.visible-height - self.content-height - self.content-y >= -32px;
            if self.content-y >= -8px && !root.loading && root.rows.length > 0 && !root.older-requested {
                root.older-requested = true;
                root.load-older();
            }
            if self.content-y < -24px {
                root.older-requested = false;
            }
        }
    }
    // ---- turn ruler (right edge): compact locator ticks sit around the
    // viewport centre. Their source fraction still determines the jump target,
    // while the visual rhythm stays close and calm.
    marks-strip := Rectangle {
        x: parent.width - 24px; y: 10px; width: 24px; height: parent.height - 20px;
        visible: root.turn-marks.length > 1;
        // Keep the locator tightly grouped at the centre. Long threads compress
        // the rhythm evenly so every tick remains inside the strip instead of
        // clamping into a stack at its top and bottom edges.
        private property <length> tick-spacing: min(12px,
            max(1px, (self.height - 12px) / max(1, root.turn-marks.length - 1)));
        for mark[i] in root.turn-marks : tick-hit := Rectangle {
            width: parent.width;
            height: 12px;
            y: parent.height / 2 + i * marks-strip.tick-spacing
                - (root.turn-marks.length - 1) * marks-strip.tick-spacing / 2
                - self.height / 2;
            tick-line := Rectangle {
                x: parent.width - self.width - 4px;
                y: (parent.height - self.height) / 2;
                width: tick-area.has-hover ? 13px : 6px;
                height: tick-area.has-hover ? 3px : 2px;
                border-radius: 1px;
                background: tick-area.has-hover ? Theme.accent : Theme.border-strong;
            }
            tick-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.jump-to-turn(mark); }
                // Wheel gestures over the strip keep scrolling the transcript.
                scroll-event(event) => { return reject; }
            }
        }
    }
    // ---- fade-in edge buttons: jump to the very top / back to the live tail.
    edge-top := Rectangle {
        visible: root.rows.length > 0 && rows-scroll.content-y < -8px;
        x: (parent.width - self.width) / 2; y: 6px;
        width: 30px; height: 30px; border-radius: 15px;
        background: edge-top-touch.has-hover ? Theme.surface : Theme.surface.transparentize(0.4);
        border-width: 1px; border-color: Theme.border;
        opacity: edge-top-touch.has-hover ? 1.0 : 0.72;
        Image {
            x: 8px; y: 8px; width: 14px; height: 14px;
            source: @image-url("../assets/icons/arrow-up.svg");
            colorize: Theme.muted; image-fit: contain;
        }
        edge-top-touch := TouchArea { mouse-cursor: pointer; clicked => { root.scroll-to-top(); } }
    }
    edge-bottom := Rectangle {
        visible: !root.follow-output && root.rows.length > 0
            && rows-scroll.content-y > rows-scroll.visible-height - rows-scroll.content-height + 40px;
        x: (parent.width - self.width) / 2; y: parent.height - self.height - 6px;
        width: 30px; height: 30px; border-radius: 15px;
        background: edge-bottom-touch.has-hover ? Theme.surface : Theme.surface.transparentize(0.4);
        border-width: 1px; border-color: Theme.border;
        opacity: edge-bottom-touch.has-hover ? 1.0 : 0.72;
        Image {
            x: 8px; y: 8px; width: 14px; height: 14px;
            source: @image-url("../assets/icons/log-down.svg");
            colorize: Theme.muted; image-fit: contain;
        }
        edge-bottom-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.follow-output = true; root.scroll-to-end(); }
        }
    }
}
