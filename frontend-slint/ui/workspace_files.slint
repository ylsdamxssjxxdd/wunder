// Native working-directory tree: select files on click and open on double
// click. Virtual rows, lazy folder pages and native menus share one controller.
// The head is one icon toolbar (search / multi-select / refresh) that swaps to
// the search field while querying, plus a selection bar while picking rows for
// batch actions. Rows pick additively with Ctrl/⌘ and in ranges with Shift,
// like the web left rail. Dragging a row moves it inside the tree: the
// hovered directory (or the root over blank space) lights up and release
// commits the move. The working directory has no transfer tiles: files come
// in by drag-and-drop, folders leave through the context menu. The upload
// tile stays only in the skill/knowledge file area, where it is the single
// upload entry.
import { Theme, WorkspaceFileRow } from "theme.slint";
import { SidebarMetrics, PointerChase } from "drag_row.slint";
import { I18n } from "i18n.slint";
import { ListView, Button } from "std-widgets.slint";
import { ModalDialog, Action, InlineInput } from "components.slint";
import { TextFieldActivation, TextFieldMenu } from "text_field.slint";

component DirectoryBlankMenu inherits ContextMenuArea {
    in property <bool> busy;
    in property <bool> local;
    in property <bool> resource-mode;
    callback menu(int, int);
    callback refresh();
    Menu {
        if !root.resource-mode : MenuItem { title: I18n.wf_menu_new_dir; enabled: !root.busy; activated => { root.menu(-1, 5); } }
        if !root.resource-mode : MenuItem { title: I18n.wf_menu_new_file; enabled: !root.busy; activated => { root.menu(-1, 6); } }
        if root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_open_ws; activated => { root.menu(-1, 9); } }
        if !root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_archive_root; enabled: !root.busy; activated => { root.menu(-1, 7); } }
        if !root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_clear; enabled: !root.busy; activated => { root.menu(-1, 8); } }
        MenuSeparator {}
        MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
    }
}

// One ghost icon button of the head toolbar: 14px glyph on a hover tile.
component ToolButton inherits Rectangle {
    in property <image> glyph;
    in property <string> tip;
    in property <bool> actionable: true;
    callback clicked();
    height: 24px; width: 26px; border-radius: 6px;
    background: tile-touch.has-hover && root.actionable ? Theme.hover : transparent;
    tile-touch := TouchArea {
        enabled: root.actionable;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px; height: 14px;
        source: root.glyph;
        colorize: root.actionable ? (tile-touch.has-hover ? Theme.text : Theme.muted) : Theme.border-strong;
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// 文件夹展开指示：一个描边 chevron，展开时转向下方 90°。
// 这里画而不是贴图，有两个原因。一是原来那对 SVG 宽高比不同（chevron-right
// 是 320x512、chevron-down 是 512x512），塞进同一个方框时一个被横向拉宽、
// 一个被压扁，两种状态的笔画粗细对不上，看着就「糊」。二是本应用跑在软件
// 渲染器上（`supports_transformations()` 返回 false），`transform-rotation`
// 不会生效——直接旋转会画出未旋转的图形（runtime_status.slint 的转圈也是
// 因此自己算点）。所以三个点用 cos/sin 自己转：矢量路径在任何 DPI 下都清楚，
// 两种状态共用同一套笔画。
component TreeDisclosure inherits Rectangle {
    in property <bool> expanded: false;
    // 行被悬停／选中时加深一档：图标本身不喧哗，但指针在哪儿一眼可见。
    in property <bool> strong: false;
    width: 10px;
    height: 10px;
    // 收起 0°、展开 90°。动画只在落定时跑，平时不产生帧。
    private property <angle> turn: root.expanded ? 90deg : 0deg;
    animate turn { duration: 130ms; easing: ease-out; }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 10;
        viewbox-height: 10;
        fill: transparent;
        stroke: root.strong ? Theme.text-secondary : Theme.muted;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        // 45° 的 V：两臂等长，转到哪个角度都还是同一条 V，不会一边长一边短。
        MoveTo { x: 5 - 2 * cos(root.turn) + 3.3 * sin(root.turn); y: 5 - 2 * sin(root.turn) - 3.3 * cos(root.turn); }
        LineTo { x: 5 + 1.2 * cos(root.turn); y: 5 + 1.2 * sin(root.turn); }
        LineTo { x: 5 - 2 * cos(root.turn) - 3.3 * sin(root.turn); y: 5 - 2 * sin(root.turn) + 3.3 * cos(root.turn); }
    }
}

export component WorkspaceFilesPanel inherits Rectangle {
    in property <bool> resource-mode;
    in property <bool> read-only;
    in property <string> title: I18n.wf_title;
    in property <[WorkspaceFileRow]> rows;
    in property <bool> loading;
    in property <string> error;
    in property <bool> offline;
    in property <bool> busy;
    in property <bool> local;
    in property <string> active-path;
    in property <int> active-index: -1;
    // Sticky folder chain: projected straight from `rows` inside the panel —
    // every open folder scrolled past the top edge whose subtree still fills
    // its slot is pinned there. `subtree-end` on each row is the static
    // geometry the decision needs, so no controller round trip is involved.
    // Search head state; `active` means flat results replaced the tree.
    in-out property <bool> search-open;
    in-out property <string> search-query;
    in property <bool> search-busy;
    in property <bool> search-active;
    // Multi-select state: the bar under the head and the row check tiles.
    in-out property <bool> selecting;
    in property <int> selected-count;
    // Internal move drag: `dragging` gates the drop highlights, `drop-path` /
    // `drop-root` name the hovered target (root is `""`, so it needs its own
    // flag). Hover indexes: -1 = root, -2 = no target, -3 = gesture cancelled.
    in property <bool> dragging;
    in property <string> drop-path;
    in property <bool> drop-root;
    callback upload();
    callback search-edit(string);
    callback search-accept(string);
    callback search-cancel();
    callback select();
    callback selection-action(int);
    callback toggle(int);
    // Modifier click: ctrl (or meta) toggles the row in the working set,
    // shift extends a range from the last picked row.
    callback pick(int, bool, bool);
    callback check(int);
    // Internal move drag lifecycle, all reported by the row that owns the
    // gesture: begin at the drag threshold, hover with the row index under
    // the pointer, drop with the last hover index (-3 cancels).
    callback drag-begin(int);
    callback drag-hover(int);
    callback drag-drop(int);
    callback refresh();
    callback connect();
    callback menu(int, int);
    callback drag-row(int);
    callback drop(DropEvent);
    callback key-action(int);
    private property <bool> empty: !root.offline && !root.loading && !root.search-active
        && root.error == "" && root.rows.length == 0;
    private property <bool> writeable: !root.read-only && !root.busy && (root.local || !root.offline);

    DropArea {
        enabled: !root.resource-mode && !root.offline && !root.busy;
        can-drop(event) => { return root.offline || root.busy ? DragAction.none : DragAction.copy; }
        dropped(event) => { root.drop(event); return DragAction.copy; }
        VerticalLayout {
            padding-left: SidebarMetrics.gutter; padding-right: SidebarMetrics.gutter;
            padding-top: 2px; padding-bottom: 6px;
            spacing: 0px;
            HorizontalLayout {
                height: 28px; spacing: 4px;
                if !root.search-open : Text {
                    text: root.title; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; min-width: 0px;
                }
                if !root.search-open : Rectangle { horizontal-stretch: 1; min-width: 0px; }
                if !root.search-open && root.resource-mode && !root.read-only : ToolButton {
                    glyph: @image-url("../assets/icons/fa-arrow-up-from-bracket.svg");
                    tip: I18n.wf_upload;
                    actionable: root.writeable;
                    clicked => { root.upload(); }
                }
                if !root.search-open : ToolButton {
                    glyph: @image-url("../assets/icons/magnifying-glass.svg");
                    tip: I18n.wf_search;
                    actionable: root.local || !root.offline;
                    clicked => { root.search-open = true; }
                }
                if !root.search-open && !root.resource-mode : ToolButton {
                    glyph: @image-url("../assets/icons/list-check.svg");
                    tip: I18n.wf_select;
                    clicked => { root.select(); }
                }
                if !root.search-open : ToolButton {
                    glyph: @image-url("../assets/icons/rotate-right.svg");
                    tip: I18n.wf_menu_refresh;
                    clicked => { root.refresh(); }
                }
                if root.search-open : search-field := Rectangle {
                    height: 24px; horizontal-stretch: 1;
                    border-radius: 6px; border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent-ink : Theme.input-border;
                    background: Theme.input-bg;
                    init => { search-input.focus(); }
                    // Raw TextInput like the composer row: the std LineEdit
                    // restyles the compact field with its own chrome, a second
                    // clear button and a taller native height.
                    touch := TouchArea { clicked => { search-input.focus(); } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 2px;
                        Rectangle {
                            horizontal-stretch: 1;
                            TextFieldMenu {
                                text: search-input.text;
                                cut() => { search-input.cut(); }
                                copy() => { search-input.copy(); }
                                paste() => { search-input.paste(); }
                                select-all() => { search-input.select-all(); }
                                search-input := TextInput {
                                    width: parent.width; height: parent.height;
                                    single-line: true;
                                    text <=> root.search-query;
                                    color: Theme.text; font-size: Theme.font-xs;
                                    vertical-alignment: center;
                                    edited() => { root.search-edit(root.search-query); }
                                    accepted() => { root.search-accept(root.search-query); }
                                    changed has-focus => {
                                        if self.has-focus && !self.read-only && self.enabled { TextFieldActivation.activated(); }
                                    }
                                }
                            }
                            if root.search-query == "" : Text {
                                width: parent.width; height: parent.height;
                                text: I18n.wf_search_placeholder;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        ToolButton {
                            glyph: @image-url("../assets/icons/xmark.svg");
                            tip: I18n.common_cancel;
                            clicked => { root.search-query = ""; root.search-open = false; root.search-cancel(); }
                        }
                    }
                }
            }
            if root.selecting && !root.search-active : HorizontalLayout {
                height: 26px; spacing: 6px;
                Text {
                    text: I18n.wf_selected_count("\{root.selected-count}");
                    color: Theme.text-secondary; font-size: Theme.font-xs; vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; min-width: 0px; }
                Button { text: I18n.common_cancel; clicked => { root.selection-action(0); } }
                Button { text: I18n.wf_batch_download; enabled: root.selected-count > 0 && !root.busy; clicked => { root.selection-action(1); } }
                Button { text: I18n.common_delete; enabled: root.selected-count > 0 && !root.busy; clicked => { root.selection-action(2); } }
            }
            if root.rows.length > 0 && root.error != "" && !root.offline : Text {
                text: root.error; color: Theme.danger; font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            blank-menu := DirectoryBlankMenu {
                vertical-stretch: 1;
                enabled: !root.offline;
                busy: root.busy; local: root.local;
                resource-mode: root.resource-mode;
                menu(index, action) => { root.menu(index, action); }
                refresh => { root.refresh(); }
                keyboard := FocusScope {
                    enabled: !root.offline;
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape && root.search-open {
                            root.search-query = ""; root.search-open = false; root.search-cancel();
                            return accept;
                        }
                        if event.text == Key.Escape && root.selecting {
                            root.selection-action(0);
                            return accept;
                        }
                        if event.text == Key.UpArrow { root.key-action(0); return accept; }
                        if event.text == Key.DownArrow { root.key-action(1); return accept; }
                        if event.text == Key.LeftArrow { root.key-action(2); return accept; }
                        if event.text == Key.RightArrow { root.key-action(3); return accept; }
                        if event.text == Key.Home { root.key-action(4); return accept; }
                        if event.text == Key.End { root.key-action(5); return accept; }
                        if event.text == "\n" { root.key-action(6); return accept; }
                        if event.text == Key.F2 { root.key-action(7); return accept; }
                        if event.text == Key.Delete { root.key-action(8); return accept; }
                        if event.text == Key.F5 { root.key-action(9); return accept; }
                        return reject;
                    }
                    if root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: I18n.wf_offline; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_connect; clicked => { root.connect(); } Tooltip { text: @markdown("\{I18n.wf_connect_cloud}"); } } }
                    }
                    if root.rows.length == 0 && root.error != "" && !root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.error; color: Theme.danger; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_reload; enabled: !root.busy; clicked => { root.refresh(); } Tooltip { text: @markdown("\{I18n.wf_menu_refresh}"); } } }
                    }
                    if root.search-busy && root.rows.length == 0 && root.error == "" : Text {
                        text: I18n.wf_searching; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.search-active && !root.search-busy && root.rows.length == 0 && root.error == "" : Text {
                        text: I18n.wf_search_empty; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.loading && root.rows.length == 0 && root.error == "" && !root.offline && !root.search-active : Text {
                        text: I18n.wf_loading; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.empty : VerticalLayout {
                        alignment: center; spacing: 8px;
                        HorizontalLayout { alignment: center; Image { width: 24px; height: 24px; source: @image-url("../assets/icons/folder-open.svg"); colorize: Theme.border-strong; } }
                        Text { text: I18n.wf_empty; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; }
                        if !root.resource-mode : Text { text: I18n.wf_empty_hint; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    // Keep the same ListView alive during refreshes, preserving
                    // the user's scroll position and the active row.
                    if !root.offline && root.rows.length > 0 : Rectangle {
                        // 根目录落点没有可描边的行：列表本身就是根，拖拽期间给
                        // 整个视口一圈细描边，与行级落点用同一强调色。
                        border-width: root.dragging && root.drop-root ? 1px : 0px;
                        border-color: Theme.accent-ink;
                        tree := ListView {
                            horizontal-scrollbar-policy: always-off;
                            private property <int> reveal-index: root.active-index;
                            changed reveal-index => {
                                if root.active-index >= 0 {
                                    let top = root.active-index * 28px;
                                    if top < -self.content-y { self.content-y = -top; }
                                    if top + 28px > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - top - 28px); }
                                }
                            }
                            for row[index] in root.rows : Rectangle {
                                height: 28px; width: parent.width;
                                background: row.path == root.active-path && !root.search-active && row.kind != 2 ? Theme.selected
                                    : row.selected ? Theme.accent-soft
                                    : root.dragging && row.path == root.drop-path ? Theme.accent-soft
                                    : row-touch.has-hover ? Theme.hover : transparent;
                                // 拖拽落点描边：悬停目标一目了然（文件行不是容器，
                                // 落到它上面高亮的是它所在目录，不会落在这里）。
                                border-width: root.dragging && row.path == root.drop-path ? 1px : 0px;
                                border-color: Theme.accent-ink;
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    enabled: !root.busy && (row.kind != 2 || !row.loading);
                                    accessible-role: button; accessible-label: row.name;
                                    accessible-action-default => { root.toggle(index); }
                                    property <length> press-x;
                                    property <length> press-y;
                                    // 按下瞬间的修饰键：点选语义看按下而不是松开。
                                    property <bool> press-ctrl;
                                    property <bool> press-shift;
                                    property <bool> drag-out;
                                    property <bool> owns-gesture;
                                    // 内部移动拖拽进行中：行持续计算悬停行号并在
                                    // 变化时上报；收尾时用它作为落点。
                                    property <bool> drag-live;
                                    property <int> hover-index: -2;
                                    property <length> chase-x: PointerChase.pointer-x;
                                    property <length> chase-y: PointerChase.pointer-y;
                                    property <int> chase-finish: PointerChase.finish-serial;
                                    // 悬停行号按 28px 等距行距从指针窗口坐标直接算出，
                                    // 不需要逐行命中测试。越过视口上下沿不算落点；
                                    // 行尾之后的空白按蜂巢语义归根目录。
                                    function update-hover(pointer-y: length) {
                                        if !self.drag-live || root.rows.length == 0 {
                                            return;
                                        }
                                        // 以整个面板的可见范围判界：ListView 的高度
                                        // 可能只等于内容高度，行尾空白在它之外，
                                        // 但仍在面板内，仍应落到根目录。
                                        if pointer-y < root.absolute-position.y
                                            || pointer-y >= root.absolute-position.y + root.height {
                                            if self.hover-index != -2 {
                                                self.hover-index = -2;
                                                root.drag-hover(-2);
                                            }
                                            return;
                                        }
                                        let row-index = Math.floor(
                                            (pointer-y - tree.absolute-position.y - tree.content-y) / 28px);
                                        let target = row-index < 0 ? -2
                                            : row-index >= root.rows.length ? -1 : row-index;
                                        if target != self.hover-index {
                                            self.hover-index = target;
                                            root.drag-hover(target);
                                        }
                                    }
                                    function begin-drag() {
                                        self.drag-out = true;
                                        self.drag-live = true;
                                        self.hover-index = -2;
                                        // 追踪通道保持运行：内部拖动要一直吃真实指针
                                        // 位置，直到松手（Win7 的事件流靠不住）。
                                        root.drag-begin(index);
                                    }
                                    function end-drag(target: int) {
                                        self.drag-live = false;
                                        self.owns-gesture = false;
                                        PointerChase.holding = false;
                                        root.drag-drop(target);
                                    }
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                            self.press-x = self.absolute-position.x + self.mouse-x;
                                            self.press-y = self.absolute-position.y + self.mouse-y;
                                            self.press-ctrl = event.modifiers.control || event.modifiers.meta;
                                            self.press-shift = event.modifiers.shift;
                                            self.drag-out = false;
                                            self.owns-gesture = !root.resource-mode && row.kind != 2 && !root.read-only;
                                            if self.owns-gesture {
                                                PointerChase.pointer-x = self.press-x;
                                                PointerChase.pointer-y = self.press-y;
                                                PointerChase.holding = PointerChase.enabled;
                                                PointerChase.begin();
                                            }
                                            keyboard.focus();
                                        }
                                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel {
                                            if self.drag-live {
                                                if !PointerChase.enabled {
                                                    // 纯事件流平台：松开即落位，取消即中止。
                                                    // Windows 的收尾由追踪通道裁定，这里不抢。
                                                    self.end-drag(event.kind == PointerEventKind.cancel ? -3 : self.hover-index);
                                                }
                                            } else if !PointerChase.enabled || !PointerChase.primary-held() {
                                                self.owns-gesture = false;
                                                PointerChase.holding = false;
                                            }
                                        }
                                    }
                                    moved => {
                                        if self.owns-gesture && self.pressed && !self.drag-out
                                            && (abs(self.absolute-position.x + self.mouse-x - self.press-x) > 5px
                                                || abs(self.absolute-position.y + self.mouse-y - self.press-y) > 5px) {
                                            self.begin-drag();
                                        }
                                        self.update-hover(self.absolute-position.y + self.mouse-y);
                                    }
                                    // 与线程行共用真实指针通道；事件流断掉或按下态被合成松开清除后仍能启动拖拽。
                                    changed chase-x => {
                                        if self.owns-gesture && !self.drag-out
                                            && (abs(PointerChase.pointer-x - self.press-x) > 5px
                                                || abs(PointerChase.pointer-y - self.press-y) > 5px) {
                                            self.begin-drag();
                                        }
                                    }
                                    changed chase-y => {
                                        if self.owns-gesture && !self.drag-out
                                            && (abs(PointerChase.pointer-x - self.press-x) > 5px
                                                || abs(PointerChase.pointer-y - self.press-y) > 5px) {
                                            self.begin-drag();
                                        }
                                        self.update-hover(PointerChase.pointer-y);
                                    }
                                    changed chase-finish => {
                                        if self.drag-live {
                                            // 追踪通道看到主键真的松开：按最后悬停行落位。
                                            self.end-drag(self.hover-index);
                                        } else if self.owns-gesture {
                                            self.owns-gesture = false;
                                            PointerChase.holding = false;
                                        }
                                    }
                                    clicked => {
                                        if self.drag-out { return; }
                                        if self.press-ctrl || self.press-shift {
                                            root.pick(index, self.press-ctrl, self.press-shift);
                                        } else {
                                            root.toggle(index);
                                        }
                                    }
                                    double-clicked => { if !self.drag-out && row.kind == 0 { root.menu(index, 0); } }
                                    row-menu := ContextMenuArea {
                                        Menu {
                                            MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
                                            MenuSeparator {}
                                            MenuItem { title: root.local ? I18n.wf_menu_open : I18n.wf_menu_preview; activated => { root.menu(index, 0); } }
                                            // 所在位置只在本地工作区有意义：云端行没有对应的宿主目录。
                                            if !root.resource-mode && root.local && row.kind == 0 : MenuItem { title: I18n.wf_menu_reveal_file; activated => { root.menu(index, 10); } }
                                            if !root.resource-mode && root.local && row.kind == 1 : MenuItem { title: I18n.wf_menu_reveal_dir; activated => { root.menu(index, 10); } }
                                            if !root.resource-mode && !root.local && row.kind == 0 : MenuItem { title: I18n.wf_menu_download; activated => { root.menu(index, 1); } }
                                            if !root.resource-mode && !root.local && row.kind == 1 : MenuItem { title: I18n.wf_menu_archive; activated => { root.menu(index, 7); } }
                                            if !root.resource-mode && row.kind == 1 : MenuItem { title: I18n.wf_menu_new_dir; enabled: root.writeable; activated => { root.menu(index, 5); } }
                                            if !root.resource-mode && row.kind == 1 : MenuItem { title: I18n.wf_menu_new_file; enabled: root.writeable; activated => { root.menu(index, 6); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_rename; enabled: root.writeable; activated => { root.menu(index, 2); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_reference; activated => { root.menu(index, 4); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_delete; enabled: root.writeable; activated => { root.menu(index, 3); } }
                                        }
                                        HorizontalLayout {
                                            padding-left: SidebarMetrics.row-padding + row.depth * 12px;
                                            padding-right: SidebarMetrics.row-padding;
                                            spacing: SidebarMetrics.icon-gap;
                                            // Selection tile: the only toggle target in
                                            // multi-select mode, so browsing keeps working.
                                            if root.selecting && !root.search-active && row.kind != 2 : Rectangle {
                                                width: 18px;
                                                if row.selected : Image {
                                                    x: 3px; y: 8px; width: 12px; height: 12px;
                                                    source: @image-url("../assets/icons/check.svg"); colorize: Theme.accent-ink;
                                                }
                                                if !row.selected : Rectangle {
                                                    x: 3px; y: 8px; width: 12px; height: 12px;
                                                    border-radius: 3px; border-width: 1px;
                                                    border-color: Theme.border-strong; background: Theme.surface;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.check(index); }
                                                }
                                            }
                                            // 行首簇：展开指示与文件/文件夹图标放在一个普通 Rectangle
                                            // 里手工排，不再套一层布局。原因不是布局不认 `y:`（它认），
                                            // 而是布局里没写 `y` 的固定尺寸项会被顶对齐，而布局的
                                            // `alignment: center` 只管可拉伸项、不替你居中；套一层布局
                                            // 反而多一层要维护的对齐语义。写死的行高 28 里，一切直接
                                            // 按 `y` 摆最省事，也不怕以后换布局参数。
                                            // 26 = 10 槽 + 2 间隙 + 14 图标；槽 10 加间隙 2 正好等于
                                            // 每级 12px 的缩进步长，各级 chevron 因此落在一条竖阶梯上。
                                            Rectangle {
                                                width: row.kind == 2 ? 10px : 26px;
                                                height: 28px;
                                                if row.kind == 1 : TreeDisclosure {
                                                    x: 0; y: 9px;
                                                    expanded: row.expanded;
                                                    strong: row-touch.has-hover;
                                                }
                                                if row.kind == 1 : Image {
                                                    x: 12px; y: 7px; width: 14px; height: 14px;
                                                    source: row.expanded ? @image-url("../assets/icons/folder-open.svg") : @image-url("../assets/icons/workspace/folder.svg"); colorize: Theme.warning;
                                                }
                                                if row.kind == 0 : Image {
                                                    x: 12px; y: 7px; width: 14px; height: 14px;
                                                    source: row.icon; image-fit: contain;
                                                }
                                            }
                                            Text { text: row.name; color: row.kind == 2 ? Theme.muted : Theme.text-secondary; font-size: row.kind == 2 ? Theme.font-sm : Theme.font-md; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            if row.loading && row.remaining >= 0 : Text { text: I18n.wf_loading_dir; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if !row-touch.has-hover && row.kind == 0 : Text { text: row.size-text; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if row-touch.has-hover && row.kind != 2 : Action {
                                                width: 20px; height: 24px; icon-size: 13px;
                                                icon: @image-url("../assets/icons/ellipsis.svg"); label: I18n.common_more;
                                                clicked => { row-menu.show({x: row-menu.width - 4px, y: 28px}); }
                                            }
                                        }
                                        Tooltip { text: @markdown("\{row.path}  \{row.size-text}"); }
                                    }
                                }
                            }
                        }
                        // Flickable captures clicks on its unused viewport too.
                        // This native menu covers only the gap after the rows.
                        DirectoryBlankMenu {
                            y: min(parent.height, max(0px, root.rows.length * 28px + tree.content-y));
                            height: parent.height - self.y;
                            busy: root.busy; local: root.local;
                            resource-mode: root.resource-mode;
                            menu(index, action) => { root.menu(index, action); }
                            refresh => { root.refresh(); }
                        }
                        // Sticky folder chain, projected straight from the rows:
                        // an open folder that has scrolled out of sight stays
                        // pinned at the tree's top edge while its subtree still
                        // fills the slot, so a deep listing never loses its
                        // path context. The pitch is uniform (28px), so the
                        // whole decision is a plain binding over content-y —
                        // the chain reshapes in the same frame as the scroll.
                        // The replicas are interactive: clicking one toggles
                        // that folder exactly like its real row, and each one
                        // draws the edge line under the stack — deeper
                        // replicas paint later and cover the shallower lines,
                        // so only the deepest stays visible.
                        pin-stack := Rectangle {
                            x: 0px; y: 0px;
                            width: parent.width;
                            height: parent.height;
                            // A pathological deep chain must not paint past
                            // the tree into the regions below it.
                            clip: true;
                            for row[index] in root.rows : Rectangle {
                                // for 实例在普通 Rectangle 里默认居中而不是 (0,0)，
                                // wrapper 必须显式钉在原点（见 docs/经验教训.md）。
                                x: 0px; y: 0px;
                                width: 0px; height: 0px;
                                if row.kind == 1 && row.expanded && !root.dragging
                                    && (index * 28px + tree.content-y) < 0px
                                    && (row.subtree-end * 28px + tree.content-y) >= (row.depth + 1) * 28px : Rectangle {
                                    x: 0px;
                                    y: row.depth * 28px;
                                    width: pin-stack.width;
                                    height: 28px;
                                    background: pin-touch.has-hover ? Theme.hover : Theme.sidebar;
                                    pin-touch := TouchArea {
                                        enabled: !root.busy;
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle(index); }
                                    }
                                    HorizontalLayout {
                                        padding-left: SidebarMetrics.row-padding + row.depth * 12px;
                                        padding-right: SidebarMetrics.row-padding;
                                        spacing: SidebarMetrics.icon-gap;
                                        // 与真实行共用同一套行首几何（手工定位，原因见上面的
                                        // 注释），钉住的行才不会和下面的行错位。
                                        Rectangle {
                                            width: 26px;
                                            height: 28px;
                                            TreeDisclosure {
                                                x: 0; y: 9px;
                                                expanded: true;
                                                strong: pin-touch.has-hover;
                                            }
                                            Image {
                                                x: 12px; y: 7px; width: 14px; height: 14px;
                                                source: @image-url("../assets/icons/folder-open.svg");
                                                colorize: Theme.warning;
                                            }
                                        }
                                        Text {
                                            text: row.name;
                                            color: Theme.text-secondary; font-size: Theme.font-md;
                                            vertical-alignment: center; overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if row.loading && row.remaining >= 0 : Text {
                                            text: I18n.wf_loading_dir;
                                            color: Theme.muted; font-size: Theme.font-2xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        y: parent.height;
                                        width: parent.width; height: 1px;
                                        background: Theme.border;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// One small dialog for the working-directory's bounded interactions: rename,
// new dir/file (input mode) and the delete / cloud-approval confirmations
// (confirm mode, danger tone). The native controller owns the state machine.
export component WorkspacePromptDialog inherits ModalDialog {
    in property <string> prompt-title;
    in property <string> prompt-body;
    // Input mode: a one-line draft with confirm/cancel; confirm mode shows
    // only the body and the two buttons.
    in property <bool> input-visible;
    in-out property <string> prompt-value;
    in property <string> confirm-label;
    in property <bool> danger: false;
    in property <bool> busy: false;
    callback accepted(string);
    callback canceled();

    card-width: 360px;
    card-height: 200px;
    dismissable: !root.busy;
    dismissed => { root.canceled(); }
    VerticalLayout {
        Text {
            height: 22px;
            text: root.prompt-title; color: Theme.text;
            font-size: Theme.font-md; font-weight: 700;
        }
        if root.prompt-body != "" : Text {
            text: root.prompt-body; color: Theme.muted; font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        if root.input-visible : InlineInput {
            height: 32px;
            enabled: !root.busy;
            text <=> root.prompt-value;
            accepted => { if !root.busy { root.accepted(root.prompt-value); } }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            height: 32px; spacing: Theme.space-2; alignment: end;
            // Confirm-mode dialogs (delete / clear / approval) start on the
            // confirm button, so Enter and Space press it without a click —
            // Action forwards key presses to its own callback. Input mode keeps
            // the draft focused: there Enter means "accept the name" through
            // InlineInput's own `accepted`.
            init => { if !root.input-visible && !root.busy { confirm.focus(); } }
            Action { width: 72px; label: I18n.common_cancel; show-label: true; enabled: !root.busy; clicked => { root.canceled(); } }
            confirm := Action { width: 96px; label: root.confirm-label; show-label: true; danger: root.danger; primary: !root.danger; enabled: !root.busy; clicked => { root.accepted(root.prompt-value); } }
        }
    }
}
