// Native working-directory tree: select files on click and open on double
// click. Virtual rows, lazy folder pages and native menus share one controller.
// The head mirrors the web left-rail: one icon toolbar (upload / search /
// download / multi-select / refresh) that swaps to the search field while
// querying, and a selection bar while picking rows for batch actions.
import { Theme, WorkspaceFileRow } from "theme.slint";
import { SidebarMetrics } from "drag_row.slint";
import { I18n } from "i18n.slint";
import { ListView, Button, LineEdit } from "std-widgets.slint";
import { ModalDialog, Action } from "components.slint";

component DirectoryBlankMenu inherits ContextMenuArea {
    in property <bool> busy;
    in property <bool> local;
    in property <bool> resource-mode;
    callback menu(int, int);
    callback refresh();
    Menu {
        if !root.resource-mode : MenuItem { title: I18n.wf_menu_new_dir; enabled: !root.busy; activated => { root.menu(-1, 5); } }
        if !root.resource-mode : MenuItem { title: I18n.wf_menu_new_file; enabled: !root.busy; activated => { root.menu(-1, 6); } }
        if root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_open_ws; activated => { root.menu(-1, 9); } }
        if !root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_archive_root; enabled: !root.busy; activated => { root.menu(-1, 7); } }
        if !root.local && !root.resource-mode : MenuItem { title: I18n.wf_menu_clear; enabled: !root.busy; activated => { root.menu(-1, 8); } }
        MenuSeparator {}
        MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
    }
}

// One ghost icon button of the head toolbar: 14px glyph on a hover tile.
component ToolButton inherits Rectangle {
    in property <image> glyph;
    in property <string> tip;
    in property <bool> actionable: true;
    callback clicked();
    height: 24px; width: 26px; border-radius: 6px;
    background: tile-touch.has-hover && root.actionable ? Theme.hover : transparent;
    tile-touch := TouchArea {
        enabled: root.actionable;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px; height: 14px;
        source: root.glyph;
        colorize: root.actionable ? (tile-touch.has-hover ? Theme.text : Theme.muted) : Theme.border-strong;
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

export component WorkspaceFilesPanel inherits Rectangle {
    in property <bool> resource-mode;
    in property <bool> read-only;
    in property <string> title: I18n.wf_title;
    in property <[WorkspaceFileRow]> rows;
    in property <bool> loading;
    in property <string> error;
    in property <bool> offline;
    in property <bool> busy;
    in property <bool> local;
    in property <string> active-path;
    in property <int> active-index: -1;
    // Search head state; `active` means flat results replaced the tree.
    in-out property <bool> search-open;
    in-out property <string> search-query;
    in property <bool> search-busy;
    in property <bool> search-active;
    // Multi-select state: the bar under the head and the row check tiles.
    in-out property <bool> selecting;
    in property <int> selected-count;
    callback upload();
    callback search-edit(string);
    callback search-accept(string);
    callback search-cancel();
    callback download();
    callback select();
    callback selection-action(int);
    callback toggle(int);
    callback check(int);
    callback refresh();
    callback connect();
    callback menu(int, int);
    callback drag-row(int);
    callback drop(DropEvent);
    callback key-action(int);
    private property <bool> empty: !root.offline && !root.loading && !root.search-active
        && root.error == "" && root.rows.length == 0;
    private property <bool> writeable: !root.read-only && !root.busy && (root.local || !root.offline);

    DropArea {
        enabled: !root.resource-mode && !root.offline && !root.busy;
        can-drop(event) => { return root.offline || root.busy ? DragAction.none : DragAction.copy; }
        dropped(event) => { root.drop(event); return DragAction.copy; }
        VerticalLayout {
            padding-left: SidebarMetrics.gutter; padding-right: SidebarMetrics.gutter;
            padding-top: 2px; padding-bottom: 6px;
            spacing: 0px;
            HorizontalLayout {
                height: 28px; spacing: 4px;
                if !root.search-open : Text {
                    text: root.title; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; min-width: 0px;
                }
                if !root.search-open : Rectangle { horizontal-stretch: 1; min-width: 0px; }
                if !root.search-open && !root.read-only : ToolButton {
                    // Same glyph as the cloud left rail's upload action
                    // (fa-arrow-up-from-bracket), not fa-upload: the two read
                    // differently at 14px and the rail must match the web.
                    glyph: @image-url("../assets/icons/fa-arrow-up-from-bracket.svg");
                    tip: I18n.wf_upload;
                    actionable: root.writeable;
                    clicked => { root.upload(); }
                }
                if !root.search-open : ToolButton {
                    glyph: @image-url("../assets/icons/magnifying-glass.svg");
                    tip: I18n.wf_search;
                    actionable: root.local || !root.offline;
                    clicked => { root.search-open = true; }
                }
                if !root.search-open && !root.resource-mode : ToolButton {
                    glyph: @image-url("../assets/icons/file-zipper.svg");
                    tip: I18n.wf_menu_archive_root;
                    actionable: root.writeable;
                    clicked => { root.download(); }
                }
                if !root.search-open && !root.resource-mode : ToolButton {
                    glyph: @image-url("../assets/icons/list-check.svg");
                    tip: I18n.wf_select;
                    clicked => { root.select(); }
                }
                if !root.search-open : ToolButton {
                    glyph: @image-url("../assets/icons/rotate-right.svg");
                    tip: I18n.wf_menu_refresh;
                    clicked => { root.refresh(); }
                }
                if root.search-open : search-field := Rectangle {
                    height: 24px; horizontal-stretch: 1;
                    border-radius: 6px; border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent-ink : Theme.input-border;
                    background: Theme.input-bg;
                    init => { search-input.focus(); }
                    // Raw TextInput like the composer row: the std LineEdit
                    // restyles the compact field with its own chrome, a second
                    // clear button and a taller native height.
                    touch := TouchArea { clicked => { search-input.focus(); } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 2px;
                        Rectangle {
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                width: parent.width; height: parent.height;
                                single-line: true;
                                text <=> root.search-query;
                                color: Theme.text; font-size: Theme.font-xs;
                                vertical-alignment: center;
                                edited() => { root.search-edit(root.search-query); }
                                accepted() => { root.search-accept(root.search-query); }
                            }
                            if root.search-query == "" : Text {
                                width: parent.width; height: parent.height;
                                text: I18n.wf_search_placeholder;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        ToolButton {
                            glyph: @image-url("../assets/icons/xmark.svg");
                            tip: I18n.common_cancel;
                            clicked => { root.search-query = ""; root.search-open = false; root.search-cancel(); }
                        }
                    }
                }
            }
            if root.selecting && !root.search-active : HorizontalLayout {
                height: 26px; spacing: 6px;
                Text {
                    text: I18n.wf_selected_count("\{root.selected-count}");
                    color: Theme.text-secondary; font-size: Theme.font-xs; vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; min-width: 0px; }
                Button { text: I18n.common_cancel; clicked => { root.selection-action(0); } }
                Button { text: I18n.wf_batch_download; enabled: root.selected-count > 0 && !root.busy; clicked => { root.selection-action(1); } }
                Button { text: I18n.common_delete; enabled: root.selected-count > 0 && !root.busy; clicked => { root.selection-action(2); } }
            }
            if root.rows.length > 0 && root.error != "" && !root.offline : Text {
                text: root.error; color: Theme.danger; font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            blank-menu := DirectoryBlankMenu {
                vertical-stretch: 1;
                enabled: !root.offline;
                busy: root.busy; local: root.local;
                resource-mode: root.resource-mode;
                menu(index, action) => { root.menu(index, action); }
                refresh => { root.refresh(); }
                keyboard := FocusScope {
                    enabled: !root.offline;
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape && root.search-open {
                            root.search-query = ""; root.search-open = false; root.search-cancel();
                            return accept;
                        }
                        if event.text == Key.Escape && root.selecting {
                            root.selection-action(0);
                            return accept;
                        }
                        if event.text == Key.UpArrow { root.key-action(0); return accept; }
                        if event.text == Key.DownArrow { root.key-action(1); return accept; }
                        if event.text == Key.LeftArrow { root.key-action(2); return accept; }
                        if event.text == Key.RightArrow { root.key-action(3); return accept; }
                        if event.text == Key.Home { root.key-action(4); return accept; }
                        if event.text == Key.End { root.key-action(5); return accept; }
                        if event.text == "\n" { root.key-action(6); return accept; }
                        if event.text == Key.F2 { root.key-action(7); return accept; }
                        if event.text == Key.Delete { root.key-action(8); return accept; }
                        if event.text == Key.F5 { root.key-action(9); return accept; }
                        return reject;
                    }
                    if root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: I18n.wf_offline; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_connect; clicked => { root.connect(); } Tooltip { text: @markdown("\{I18n.wf_connect_cloud}"); } } }
                    }
                    if root.rows.length == 0 && root.error != "" && !root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.error; color: Theme.danger; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_reload; enabled: !root.busy; clicked => { root.refresh(); } Tooltip { text: @markdown("\{I18n.wf_menu_refresh}"); } } }
                    }
                    if root.search-busy && root.rows.length == 0 && root.error == "" : Text {
                        text: I18n.wf_searching; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.search-active && !root.search-busy && root.rows.length == 0 && root.error == "" : Text {
                        text: I18n.wf_search_empty; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.loading && root.rows.length == 0 && root.error == "" && !root.offline && !root.search-active : Text {
                        text: I18n.wf_loading; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.empty : VerticalLayout {
                        alignment: center; spacing: 8px;
                        HorizontalLayout { alignment: center; Image { width: 24px; height: 24px; source: @image-url("../assets/icons/folder-open.svg"); colorize: Theme.border-strong; } }
                        Text { text: I18n.wf_empty; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; }
                        if !root.resource-mode : Text { text: I18n.wf_empty_hint; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: center; wrap: word-wrap; }
                        if !root.resource-mode && !root.read-only : HorizontalLayout {
                            alignment: center; spacing: 8px;
                            Button { text: I18n.wf_menu_new_dir; enabled: !root.busy; clicked => { root.menu(-1, 5); } Tooltip { text: @markdown("\{I18n.wf_menu_new_dir}"); } }
                            Button { text: I18n.wf_menu_new_file; enabled: !root.busy; clicked => { root.menu(-1, 6); } Tooltip { text: @markdown("\{I18n.wf_menu_new_file}"); } }
                        }
                    }
                    // Keep the same ListView alive during refreshes, preserving
                    // the user's scroll position and the active row.
                    if !root.offline && root.rows.length > 0 : Rectangle {
                        tree := ListView {
                            horizontal-scrollbar-policy: always-off;
                            private property <int> reveal-index: root.active-index;
                            changed reveal-index => {
                                if root.active-index >= 0 {
                                    let top = root.active-index * 28px;
                                    if top < -self.content-y { self.content-y = -top; }
                                    if top + 28px > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - top - 28px); }
                                }
                            }
                            for row[index] in root.rows : Rectangle {
                                height: 28px; width: parent.width;
                                background: row.path == root.active-path && !root.search-active && row.kind != 2 ? Theme.selected : row-touch.has-hover ? Theme.hover : transparent;
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    enabled: !root.busy && (row.kind != 2 || !row.loading);
                                    accessible-role: button; accessible-label: row.name;
                                    accessible-action-default => { root.toggle(index); }
                                    property <length> press-x;
                                    property <length> press-y;
                                    property <bool> drag-out;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                            self.press-x = self.mouse-x; self.press-y = self.mouse-y; self.drag-out = false;
                                            keyboard.focus();
                                        }
                                    }
                                    moved => {
                                        if !root.resource-mode && row.kind == 0 && self.pressed && !self.drag-out && (abs(self.mouse-x - self.press-x) > 5px || abs(self.mouse-y - self.press-y) > 5px) {
                                            self.drag-out = true; root.drag-row(index);
                                        }
                                    }
                                    clicked => { if !self.drag-out { root.toggle(index); } }
                                    double-clicked => { if !self.drag-out && row.kind == 0 { root.menu(index, 0); } }
                                    row-menu := ContextMenuArea {
                                        Menu {
                                            MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
                                            MenuSeparator {}
                                            MenuItem { title: root.local ? I18n.wf_menu_open : I18n.wf_menu_preview; activated => { root.menu(index, 0); } }
                                            if !root.resource-mode && !root.local && row.kind == 0 : MenuItem { title: I18n.wf_menu_download; activated => { root.menu(index, 1); } }
                                            if !root.resource-mode && !root.local && row.kind == 1 : MenuItem { title: I18n.wf_menu_archive; activated => { root.menu(index, 7); } }
                                            if !root.resource-mode && row.kind == 1 : MenuItem { title: I18n.wf_menu_new_dir; enabled: root.writeable; activated => { root.menu(index, 5); } }
                                            if !root.resource-mode && row.kind == 1 : MenuItem { title: I18n.wf_menu_new_file; enabled: root.writeable; activated => { root.menu(index, 6); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_rename; enabled: root.writeable; activated => { root.menu(index, 2); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_reference; activated => { root.menu(index, 4); } }
                                            if !root.resource-mode && row.kind != 2 : MenuItem { title: I18n.wf_menu_delete; enabled: root.writeable; activated => { root.menu(index, 3); } }
                                        }
                                        HorizontalLayout {
                                            padding-left: SidebarMetrics.row-padding + row.depth * 12px;
                                            padding-right: SidebarMetrics.row-padding;
                                            spacing: SidebarMetrics.icon-gap;
                                            // Selection tile: the only toggle target in
                                            // multi-select mode, so browsing keeps working.
                                            if root.selecting && !root.search-active && row.kind != 2 : Rectangle {
                                                width: 18px;
                                                if row.selected : Image {
                                                    x: 3px; y: 8px; width: 12px; height: 12px;
                                                    source: @image-url("../assets/icons/check.svg"); colorize: Theme.accent-ink;
                                                }
                                                if !row.selected : Rectangle {
                                                    x: 3px; y: 8px; width: 12px; height: 12px;
                                                    border-radius: 3px; border-width: 1px;
                                                    border-color: Theme.border-strong; background: Theme.surface;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.check(index); }
                                                }
                                            }
                                            Rectangle {
                                                width: 14px;
                                                if row.kind == 1 : Image {
                                                    x: 1px; y: 8px; width: 12px; height: 12px;
                                                    source: row.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted;
                                                }
                                            }
                                            if row.kind == 1 : Image {
                                                y: 7px; width: 14px; height: 14px;
                                                source: row.expanded ? @image-url("../assets/icons/folder-open.svg") : @image-url("../assets/icons/workspace/folder.svg"); colorize: Theme.warning;
                                            }
                                            if row.kind == 0 : Image { y: 7px; width: 14px; height: 14px; source: row.icon; image-fit: contain; }
                                            Text { text: row.name; color: row.kind == 2 ? Theme.muted : Theme.text-secondary; font-size: row.kind == 2 ? Theme.font-sm : Theme.font-md; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            if row.loading && row.remaining >= 0 : Text { text: I18n.wf_loading_dir; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if !row-touch.has-hover && row.kind == 0 : Text { text: row.size-text; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if row-touch.has-hover && row.kind != 2 : Action {
                                                width: 20px; height: 24px; icon-size: 13px;
                                                icon: @image-url("../assets/icons/ellipsis.svg"); label: I18n.common_more;
                                                clicked => { row-menu.show({x: row-menu.width - 4px, y: 28px}); }
                                            }
                                        }
                                        Tooltip { text: @markdown("\{row.path}  \{row.size-text}"); }
                                    }
                                }
                            }
                        }
                        // Flickable captures clicks on its unused viewport too.
                        // This native menu covers only the gap after the rows.
                        DirectoryBlankMenu {
                            y: min(parent.height, max(0px, root.rows.length * 28px + tree.content-y));
                            height: parent.height - self.y;
                            busy: root.busy; local: root.local;
                            resource-mode: root.resource-mode;
                            menu(index, action) => { root.menu(index, action); }
                            refresh => { root.refresh(); }
                        }
                    }
                }
            }
        }
    }
}

// One small dialog for the working-directory's bounded interactions: rename,
// new dir/file (input mode) and the delete / cloud-approval confirmations
// (confirm mode, danger tone). The native controller owns the state machine.
export component WorkspacePromptDialog inherits ModalDialog {
    in property <string> prompt-title;
    in property <string> prompt-body;
    // Input mode: a one-line draft with confirm/cancel; confirm mode shows
    // only the body and the two buttons.
    in property <bool> input-visible;
    in-out property <string> prompt-value;
    in property <string> confirm-label;
    in property <bool> danger: false;
    in property <bool> busy: false;
    callback accepted(string);
    callback canceled();

    card-width: 360px;
    card-height: 200px;
    dismissable: !root.busy;
    dismissed => { root.canceled(); }
    VerticalLayout {
        Text {
            text: root.prompt-title; color: Theme.text;
            font-size: Theme.font-lg; font-weight: 700;
        }
        if root.prompt-body != "" : Text {
            text: root.prompt-body; color: Theme.muted; font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        if root.input-visible : LineEdit {
            enabled: !root.busy;
            text <=> root.prompt-value;
            accepted => { if !root.busy { root.accepted(root.prompt-value); } }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            height: 30px; spacing: 8px; alignment: end;
            Button { text: I18n.common_cancel; enabled: !root.busy; clicked => { root.canceled(); } }
            Button { text: root.confirm-label; enabled: !root.busy; primary: true; clicked => { root.accepted(root.prompt-value); } }
        }
    }
}
