// Native working-directory tree: select files on click and open on double
// click. Virtual rows, lazy folder pages and native menus share one controller.
import { Theme, WorkspaceFileRow } from "theme.slint";
import { I18n } from "i18n.slint";
import { ListView, Button, LineEdit } from "std-widgets.slint";
import { ModalDialog, Action } from "components.slint";

component DirectoryBlankMenu inherits ContextMenuArea {
    in property <bool> busy;
    in property <bool> local;
    callback menu(int, int);
    callback refresh();
    Menu {
        MenuItem { title: I18n.wf_menu_new_dir; enabled: !root.busy; activated => { root.menu(-1, 5); } }
        MenuItem { title: I18n.wf_menu_new_file; enabled: !root.busy; activated => { root.menu(-1, 6); } }
        if root.local : MenuItem { title: I18n.wf_menu_open_ws; activated => { root.menu(-1, 9); } }
        if !root.local : MenuItem { title: I18n.wf_menu_archive_root; enabled: !root.busy; activated => { root.menu(-1, 7); } }
        if !root.local : MenuItem { title: I18n.wf_menu_clear; enabled: !root.busy; activated => { root.menu(-1, 8); } }
        MenuSeparator {}
        MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
    }
}

export component WorkspaceFilesPanel inherits Rectangle {
    in property <[WorkspaceFileRow]> rows;
    in property <string> stats;
    in property <bool> loading;
    in property <string> error;
    in property <bool> offline;
    in property <bool> busy;
    in property <bool> local;
    in property <string> active-path;
    in property <int> active-index: -1;
    callback toggle(int);
    callback refresh();
    callback connect();
    callback menu(int, int);
    callback drag-row(int);
    callback drop(DropEvent);
    callback key-action(int);
    private property <bool> empty: !root.offline && !root.loading && root.error == "" && root.rows.length == 0;

    DropArea {
        enabled: !root.offline && !root.busy;
        can-drop(event) => { return root.offline || root.busy ? DragAction.none : DragAction.copy; }
        dropped(event) => { root.drop(event); return DragAction.copy; }
        VerticalLayout {
            padding-left: 10px; padding-right: 10px; padding-top: 2px; padding-bottom: 6px;
            spacing: 0px;
            HorizontalLayout {
                height: 26px; spacing: 6px;
                Text { text: I18n.wf_title; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; min-width: 0px; }
                if root.stats != "" : Text {
                    text: root.stats; color: Theme.muted; font-size: Theme.font-2xs;
                    vertical-alignment: center; overflow: elide;
                }
                Action {
                    width: 22px; height: 22px; icon-size: 13px;
                    icon: @image-url("../assets/icons/plus.svg"); label: I18n.common_more;
                    enabled: !root.offline && !root.busy;
                    clicked => { blank-menu.show({x: blank-menu.width - 8px, y: 0px}); }
                }
                Action {
                    width: 22px; height: 22px; icon-size: 13px;
                    icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.wf_menu_refresh;
                    enabled: !root.offline && !root.busy;
                    clicked => { root.refresh(); }
                }
            }
            if root.rows.length > 0 && root.error != "" && !root.offline : Text {
                text: root.error; color: Theme.danger; font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            blank-menu := DirectoryBlankMenu {
                vertical-stretch: 1;
                enabled: !root.offline;
                busy: root.busy; local: root.local;
                menu(index, action) => { root.menu(index, action); }
                refresh => { root.refresh(); }
                keyboard := FocusScope {
                    enabled: !root.offline;
                    capture-key-pressed(event) => {
                        if event.text == Key.UpArrow { root.key-action(0); return accept; }
                        if event.text == Key.DownArrow { root.key-action(1); return accept; }
                        if event.text == Key.LeftArrow { root.key-action(2); return accept; }
                        if event.text == Key.RightArrow { root.key-action(3); return accept; }
                        if event.text == Key.Home { root.key-action(4); return accept; }
                        if event.text == Key.End { root.key-action(5); return accept; }
                        if event.text == "\n" { root.key-action(6); return accept; }
                        if event.text == Key.F2 { root.key-action(7); return accept; }
                        if event.text == Key.Delete { root.key-action(8); return accept; }
                        if event.text == Key.F5 { root.key-action(9); return accept; }
                        return reject;
                    }
                    if root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: I18n.wf_offline; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_connect; clicked => { root.connect(); } } }
                    }
                    if root.rows.length == 0 && root.error != "" && !root.offline : VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.error; color: Theme.danger; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; Button { text: I18n.wf_reload; enabled: !root.busy; clicked => { root.refresh(); } } }
                    }
                    if root.loading && root.rows.length == 0 && root.error == "" && !root.offline : Text {
                        text: I18n.wf_loading; color: Theme.muted; font-size: Theme.font-xs;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.empty : VerticalLayout {
                        alignment: center; spacing: 8px;
                        HorizontalLayout { alignment: center; Image { width: 24px; height: 24px; source: @image-url("../assets/icons/folder-open.svg"); colorize: Theme.border-strong; } }
                        Text { text: I18n.wf_empty; color: Theme.muted; font-size: Theme.font-xs; horizontal-alignment: center; }
                        Text { text: I18n.wf_empty_hint; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: center; spacing: 8px;
                            Button { text: I18n.wf_menu_new_dir; enabled: !root.busy; clicked => { root.menu(-1, 5); } }
                            Button { text: I18n.wf_menu_new_file; enabled: !root.busy; clicked => { root.menu(-1, 6); } }
                        }
                    }
                    // Keep the same ListView alive during refreshes, preserving
                    // the user's scroll position and the active row.
                    if !root.offline && root.rows.length > 0 : Rectangle {
                        tree := ListView {
                            horizontal-scrollbar-policy: always-off;
                            private property <int> reveal-index: root.active-index;
                            changed reveal-index => {
                                if root.active-index >= 0 {
                                    let top = root.active-index * 26px;
                                    if top < -self.content-y { self.content-y = -top; }
                                    if top + 26px > -self.content-y + self.visible-height { self.content-y = min(0px, self.visible-height - top - 26px); }
                                }
                            }
                            for row[index] in root.rows : Rectangle {
                                height: 26px; width: parent.width;
                                background: row.path == root.active-path && row.kind != 2 ? Theme.selected : row-touch.has-hover ? Theme.hover : transparent;
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    enabled: row.kind != 2 || !row.loading;
                                    accessible-role: button; accessible-label: row.name;
                                    accessible-action-default => { root.toggle(index); }
                                    property <length> press-x;
                                    property <length> press-y;
                                    property <bool> drag-out;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                            self.press-x = self.mouse-x; self.press-y = self.mouse-y; self.drag-out = false;
                                            keyboard.focus();
                                        }
                                    }
                                    moved => {
                                        if row.kind == 0 && self.pressed && !self.drag-out && (abs(self.mouse-x - self.press-x) > 5px || abs(self.mouse-y - self.press-y) > 5px) {
                                            self.drag-out = true; root.drag-row(index);
                                        }
                                    }
                                    clicked => { if !self.drag-out { root.toggle(index); } }
                                    double-clicked => { if !self.drag-out && row.kind == 0 { root.menu(index, 0); } }
                                    row-menu := ContextMenuArea {
                                        Menu {
                                            MenuItem { title: I18n.wf_menu_refresh; activated => { root.refresh(); } }
                                            MenuSeparator {}
                                            MenuItem { title: root.local ? I18n.wf_menu_open : I18n.wf_menu_preview; activated => { root.menu(index, 0); } }
                                            if !root.local && row.kind == 0 : MenuItem { title: I18n.wf_menu_download; activated => { root.menu(index, 1); } }
                                            if !root.local && row.kind == 1 : MenuItem { title: I18n.wf_menu_archive; activated => { root.menu(index, 7); } }
                                            if row.kind == 1 : MenuItem { title: I18n.wf_menu_new_dir; enabled: !root.busy; activated => { root.menu(index, 5); } }
                                            if row.kind == 1 : MenuItem { title: I18n.wf_menu_new_file; enabled: !root.busy; activated => { root.menu(index, 6); } }
                                            if row.kind != 2 : MenuItem { title: I18n.wf_menu_rename; enabled: !root.busy; activated => { root.menu(index, 2); } }
                                            if row.kind != 2 : MenuItem { title: I18n.wf_menu_reference; activated => { root.menu(index, 4); } }
                                            if row.kind != 2 : MenuItem { title: I18n.wf_menu_delete; enabled: !root.busy; activated => { root.menu(index, 3); } }
                                        }
                                        HorizontalLayout {
                                            padding-left: 6px + row.depth * 12px; padding-right: 4px; spacing: 5px;
                                            Rectangle {
                                                width: 14px;
                                                if row.kind == 1 : Image {
                                                    x: 1px; y: 7px; width: 12px; height: 12px;
                                                    source: row.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted;
                                                }
                                            }
                                            if row.kind == 1 : Image {
                                                y: 6px; width: 14px; height: 14px;
                                                source: row.expanded ? @image-url("../assets/icons/folder-open.svg") : @image-url("../assets/icons/workspace/folder.svg"); colorize: Theme.warning;
                                            }
                                            if row.kind == 0 : Image { y: 6px; width: 14px; height: 14px; source: row.icon; image-fit: contain; }
                                            Text { text: row.name; color: row.kind == 2 ? Theme.muted : Theme.text-secondary; font-size: row.kind == 2 ? Theme.font-sm : Theme.font-md; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            if row.loading && row.remaining >= 0 : Text { text: I18n.wf_loading_dir; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if !row-touch.has-hover && row.kind == 0 : Text { text: row.size-text; color: Theme.muted; font-size: Theme.font-2xs; vertical-alignment: center; }
                                            if row-touch.has-hover && row.kind != 2 : Action {
                                                width: 20px; height: 24px; icon-size: 13px;
                                                icon: @image-url("../assets/icons/ellipsis.svg"); label: I18n.common_more;
                                                clicked => { row-menu.show({x: row-menu.width - 4px, y: 26px}); }
                                            }
                                        }
                                        Tooltip { text: @markdown("\{row.path}  \{row.size-text}"); }
                                    }
                                }
                            }
                        }
                        // Flickable captures clicks on its unused viewport too.
                        // This native menu covers only the gap after the rows.
                        DirectoryBlankMenu {
                            y: min(parent.height, max(0px, root.rows.length * 26px + tree.content-y));
                            height: parent.height - self.y;
                            busy: root.busy; local: root.local;
                            menu(index, action) => { root.menu(index, action); }
                            refresh => { root.refresh(); }
                        }
                    }
                }
            }
        }
    }
}

// One small dialog for the working-directory's bounded interactions: rename,
// new dir/file (input mode) and the delete / cloud-approval confirmations
// (confirm mode, danger tone). The native controller owns the state machine.
export component WorkspacePromptDialog inherits ModalDialog {
    in property <string> prompt-title;
    in property <string> prompt-body;
    // Input mode: a one-line draft with confirm/cancel; confirm mode shows
    // only the body and the two buttons.
    in property <bool> input-visible;
    in-out property <string> prompt-value;
    in property <string> confirm-label;
    in property <bool> danger: false;
    in property <bool> busy: false;
    callback accepted(string);
    callback canceled();

    card-width: 360px;
    card-height: 200px;
    dismissable: !root.busy;
    dismissed => { root.canceled(); }
    VerticalLayout {
        Text {
            text: root.prompt-title; color: Theme.text;
            font-size: Theme.font-lg; font-weight: 700;
        }
        if root.prompt-body != "" : Text {
            text: root.prompt-body; color: Theme.muted; font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        if root.input-visible : LineEdit {
            enabled: !root.busy;
            text <=> root.prompt-value;
            accepted => { if !root.busy { root.accepted(root.prompt-value); } }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            height: 30px; spacing: 8px; alignment: end;
            Button { text: I18n.common_cancel; enabled: !root.busy; clicked => { root.canceled(); } }
            Button { text: root.confirm-label; enabled: !root.busy; primary: true; clicked => { root.accepted(root.prompt-value); } }
        }
    }
}
