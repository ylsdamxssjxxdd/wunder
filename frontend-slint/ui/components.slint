import { Theme } from "theme.slint";

// Keyboard and accessibility actions share the pointer callback.
export component Action inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> rail: false;
    in property <bool> show-label: false;
    callback clicked();
    width: root.show-label ? 92px : 30px;
    height: 30px;
    border-radius: 7px;
    background: root.primary ? (root.enabled ? Theme.accent : Theme.accent.transparentize(0.6))
        : root.rail ? (root.selected || touch.has-hover ? #ffffff33 : transparent)
        : root.selected || touch.has-hover ? Theme.accent-soft : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: root.rail ? white : Theme.accent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: root.show-label ? 8px : (parent.width - 15px) / 2;
        y: (parent.height - 15px) / 2;
        width: 15px; height: 15px;
        source: root.icon; image-fit: contain;
        colorize: root.rail || root.primary ? white : Theme.muted;
    }
    if root.show-label : Text {
        x: root.icon.width > 0 ? 28px : 6px; width: parent.width - self.x - 6px;
        horizontal-alignment: center; height: parent.height;
        text: root.label; font-size: 11px;
        color: root.primary ? white : Theme.text;
        vertical-alignment: center; overflow: elide;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    // Keep the pointer target above the focus scope. This avoids the first
    // click being consumed solely to focus controls on the Win7 renderer.
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}
export component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    width: 46px;
    height: 50px;
    forward-focus: rail-focus;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: 10px;
    background: root.active || rail-touch.has-hover ? #ffffff33 : transparent;
    border-width: rail-focus.has-focus ? 1px : 0px; border-color: white;
    Image { y: 8px; width: 16px; height: 16px; source: root.icon; image-fit: contain; colorize: #ffffff; }
    Text { y: 30px; width: parent.width; height: 14px; text: root.label; color: #ffffffe6; font-size: 10px; horizontal-alignment: center; }
    rail-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    // One full-cell pointer target remains above the keyboard focus scope.
    rail-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { rail-focus.focus(); root.clicked(); }
    }
}
export component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> mine: false;
    in property <string> glyph: "";
    in property <int> tone: 0;
    width: 34px; height: 34px; border-radius: 17px;
    background: root.mine ? Theme.accent-soft : (root.tone == 1 ? #fff0e3 : root.tone == 2 ? #e7f5ef : root.tone == 3 ? #e8efff : #ffffff);
    clip: true;
    if !root.mine : Image { width: 100%; height: 100%; source: root.source; image-fit: cover; }
    if !root.mine && root.glyph != "" : Text { width: 100%; height: 100%; text: root.glyph; font-size: 16px; color: Theme.accent-deep; horizontal-alignment: center; vertical-alignment: center; }
    if root.mine : Text { text: "我"; font-size: 13px; color: Theme.accent-deep; horizontal-alignment: center; vertical-alignment: center; }
}
export component SearchField inherits Rectangle {
    in property <image> icon;
    in property <string> placeholder: "搜索";
    in-out property <string> text <=> editor.text;
    height: 34px; background: Theme.accent-soft; border-radius: 8px;
    border-width: 1px; border-color: editor.has-focus ? Theme.accent : transparent;
    forward-focus: editor;
    Image { x: 10px; width: 12px; height: 12px; source: root.icon; colorize: Theme.muted; }
    Text { x: 30px; width: parent.width - 38px; height: parent.height; text: editor.text == "" && editor.preedit-text == "" ? root.placeholder : ""; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
    editor := TextInput {
        x: 30px; width: parent.width - 38px; height: parent.height;
        color: Theme.text; font-size: 12px; single-line: true;
        vertical-alignment: center;
        selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.text;
    }
}

export component FormField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> read-only: false;
    in-out property <string> text <=> editor.text;
    height: 62px;
    Text { y: 0px; width: parent.width; height: 18px; text: root.label; color: Theme.muted; font-size: 11px; }
    Rectangle {
        y: 21px; width: parent.width; height: 36px; border-radius: 8px;
        background: Theme.panel; border-width: 1px; border-color: editor.has-focus ? Theme.accent : Theme.border;
        Text { x: 10px; width: parent.width - 20px; height: parent.height; text: editor.text == "" && editor.preedit-text == "" ? root.placeholder : ""; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
        editor := TextInput {
            x: 10px; width: parent.width - 20px; height: parent.height; color: Theme.text; font-size: 12px;
            read-only: root.read-only; single-line: true; vertical-alignment: center; input-type: root.secret ? InputType.password : InputType.text;
            selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.text;
            accessible-role: text-input; accessible-label: root.label; accessible-placeholder-text: root.placeholder;
        }
    }
}
