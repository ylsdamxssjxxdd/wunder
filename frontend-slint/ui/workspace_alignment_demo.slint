// Viewer-only fixture: all names and interactions are synthetic.
import { Sidebar } from "sidebar.slint";
import { Theme } from "theme.slint";

export component WorkspaceAlignmentDemo inherits Window {
    width: 300px; height: 720px;
    default-font-family: "Microsoft YaHei";
    background: Theme.sidebar;
    in-out property <bool> empty: false;
    in-out property <bool> loading: false;
    in-out property <bool> folder-open: true;
    in-out property <float> split: 0.6;
    in-out property <string> active-path: "notes/sample.txt";
    in-out property <int> active-index: 1;
    out property <int> last-command: -1;
    out property <int> last-workspace: -1;
    out property <int> opened-count;
    out property <int> clicked-count;
    out property <int> layout-saves;
    // Test-only projection of the thread-row callbacks. Keeping it in the
    // viewer fixture makes the real hover and native context-menu actions
    // observable without adding any production-only state to Sidebar.
    out property <string> last-thread-action: "";
    in property <bool> cloud: false;
    accessible-role: groupbox;
    accessible-description: "command=" + root.last-command + ";workspace=" + root.last-workspace
        + ";thread=" + root.last-thread-action + ";opens=" + root.opened-count
        + ";clicks=" + root.clicked-count + ";split=" + root.split + ";saves=" + root.layout-saves;
    Sidebar {
        rows: [
            {kind: root.cloud ? 2 : 0, workspace-id: "fixture-a", name: "示例工作区", icon: "folder", color: "blue", selected: true, expanded: true, thread-count: 2, payload: 0},
            {kind: root.cloud ? 3 : 1, workspace-id: "fixture-a", thread-id: "fixture-thread-a", title: "示例线程", status: "done", active: true, archivable: true, payload: 0},
            {kind: root.cloud ? 3 : 1, workspace-id: "fixture-a", thread-id: "fixture-thread-b", title: "另一个线程", status: "running", payload: 1},
            {kind: 0, workspace-id: "fixture-b", name: "第二工作区", icon: "coffee", color: "orange", payload: 1}
        ];
        user-initial: "U"; user-color: Theme.accent;
        file-local: true;
        file-loading: root.loading;
        file-busy: root.loading;
        file-active-path: root.active-path;
        file-active-index: root.active-index;
        file-rows: root.empty ? [] : root.folder-open ? [
            {path: "notes", name: "notes", kind: 1, expanded: true},
            {path: "notes/sample.txt", name: "sample.txt", kind: 0, depth: 1, size-text: "2 KB", icon: @image-url("../assets/icons/file-lines.svg")},
            {path: "notes/sample.json", name: "sample.json", kind: 0, depth: 1, size-text: "850 B", icon: @image-url("../assets/icons/file-lines.svg")},
            {path: "assets", name: "assets", kind: 1},
            {path: "readme.txt", name: "readme.txt", kind: 0, icon: @image-url("../assets/icons/file-lines.svg")}
        ] : [
            {path: "notes", name: "notes", kind: 1},
            {path: "assets", name: "assets", kind: 1},
            {path: "readme.txt", name: "readme.txt", kind: 0, icon: @image-url("../assets/icons/file-lines.svg")}
        ];
        split-ratio <=> root.split;
        layout-changed => { root.layout-saves += 1; }
        file-toggle(index) => {
            root.clicked-count += 1;
            root.active-index = index;
            root.active-path = index == 0 ? "notes" : index == 1 ? "notes/sample.txt" : "notes/sample.json";
            if index == 0 { root.folder-open = !root.folder-open; }
        }
        file-menu(index, action) => { root.last-command = action; if action == 0 { root.opened-count += 1; } }
        file-key(action) => { root.last-command = 100 + action; }
        workspace-menu(index, action) => { root.last-workspace = index; root.last-command = action; }
        rename-request(index, title) => { root.last-thread-action = "rename:" + index + ":" + title; }
        open-trajectory(index) => { root.last-thread-action = "trajectory:" + index; }
        archive-thread(id) => { root.last-thread-action = "archive:" + id; }
        cloud-rename-request(id, title) => { root.last-thread-action = "rename:" + id + ":" + title; }
        cloud-open-trajectory(id) => { root.last-thread-action = "trajectory:" + id; }
        cloud-archive-request(id) => { root.last-thread-action = "archive:" + id; }
        begin-selection => { root.last-thread-action = "multi-select"; }
    }
}
