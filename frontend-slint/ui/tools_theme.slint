// Web messenger tools tokens, in logical pixels (the reference uses 1.4x DPI).
export global ToolsTheme {
    out property <string> font: "Microsoft YaHei";
    out property <color> text: #32170a;
    out property <color> muted: #909090;
    out property <color> border: #e8e8e8;
    out property <color> panel: #fff8f2;
    out property <color> soft: #fff3e8;
    out property <color> accent: #ff9448;
    out property <color> deep: #f37927;
}
