import { ScrollView } from "std-widgets.slint";
import { HelpDocs, HelpMenuState } from "help_models.slint";
import { BlockView } from "markdown-rich.slint";
import { TextMenu } from "text_menu.slint";

// The manual is Markdown. Rust projects the current topic once into the same
// flat `[MdBlock]` model the chat transcript uses; this view lays the blocks
// out with BlockView, so headings, lists, tables, code and images read exactly
// like a finished answer. Paragraph selection and the right-click menu come
// from the same fork of StyledText.
export component HelpDocument inherits Rectangle {
    property <int> scroll-request <=> HelpDocs.scroll-request;
    property <int> reveal-request <=> HelpDocs.reveal-request;
    background: #ffffff;
    forward-focus: keyboard;
    out property <float> content-width: scroll.visible-width / 1px;
    changed scroll-request => { scroll.content-y = 0px; }
    changed reveal-request => {
        scroll.content-y = -min(max(0px, HelpDocs.reveal-y * 1px - 12px), max(0px, scroll.content-height - scroll.visible-height));
    }
    keyboard := FocusScope {
        key-pressed(event) => {
            // Ctrl+A / Ctrl+C are handled by the window-level selection layer.
            if event.text == Key.DownArrow || event.text == Key.PageDown {
                scroll.content-y = max(min(0px, scroll.visible-height - scroll.content-height), scroll.content-y - (event.text == Key.PageDown ? scroll.visible-height * 0.9 : 40px));
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.PageUp {
                scroll.content-y = min(0px, scroll.content-y + (event.text == Key.PageUp ? scroll.visible-height * 0.9 : 40px));
                return accept;
            }
            if event.text == Key.Home { scroll.content-y = 0px; return accept; }
            if event.text == Key.End { scroll.content-y = min(0px, scroll.visible-height - scroll.content-height); return accept; }
            reject
        }
    }
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: scroll.visible-width;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 10px;
            padding-bottom: 32px;
            alignment: start;
            for block in HelpDocs.blocks : BlockView {
                block: block;
                column-width: scroll.visible-width - 44px;
                font-scale: HelpDocs.font-scale;
                link-clicked(url) => { HelpDocs.link-opened(url); }
                open-resource(url) => { HelpDocs.link-opened(url); }
                copy-text(value) => {
                    HelpDocs.copy-text = value;
                    HelpDocs.copy-request += 1;
                }
                context-menu(x, y, selected) => {
                    // The callback reports window coordinates; the menu is
                    // anchored inside this document's own coordinate space.
                    HelpMenuState.anchor-x = x - root.absolute-position.x;
                    HelpMenuState.anchor-y = y - root.absolute-position.y;
                    HelpMenuState.has-selection = selected;
                    HelpMenuState.open = true;
                }
            }
        }
    }
    TextMenu {
        z: 30;
        width: root.width;
        height: root.height;
        open <=> HelpMenuState.open;
        anchor-x <=> HelpMenuState.anchor-x;
        anchor-y <=> HelpMenuState.anchor-y;
        has-selection <=> HelpMenuState.has-selection;
        copy-selection => { HelpDocs.copy-requested(); }
        select-all => { HelpDocs.select-all(); }
    }
}
