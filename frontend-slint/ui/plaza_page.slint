import { I18n } from "i18n.slint";
import { Theme, PlazaItemCard } from "theme.slint";
import { Action, MiddleHeader, MiddleFooter, PageState, PageStateKind } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// The desktop plaza only browses normal user assets (worker cards and skill
// packs). Swarm packs never enter the list — the native projection filters
// them before anything reaches this page.
export component PlazaPage inherits Rectangle {
    in property <bool> loading: false;
    in property <[PlazaItemCard]> items;
    in property <int> selected: -1;
    in property <bool> import-open: false;
    in property <string> status;
    callback refresh();
    callback select-item(int);
    callback request-import();
    callback confirm-import();
    callback cancel-import();
    private property <string> kind-filter: I18n.common_all;
    private property <PlazaItemCard> current: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected] : {
        item-id: "", kind: "", title: "", summary: "", owner: "", mine: false,
        freshness: "", artifact: "", size: "", tags: "", updated-at: ""
    };
    private property <string> current-kind-label: root.current.kind == "worker_card" ? I18n.common_worker_card : root.current.kind == "skill_pack" ? I18n.common_skill_pack : "";
    background: Theme.chat;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: Theme.middle-width;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: I18n.common_plaza; subtitle: I18n.pz_subtitle; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    Action { horizontal-stretch: 1; height: 34px; icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.pz_refresh; show-label: true; enabled: !root.loading; clicked => { root.refresh(); } }
                }
                Rectangle { height: 14px; }
                HorizontalLayout { padding-left: 16px; Text { height: 20px; text: I18n.pz_kind_filter; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } }
                Rectangle { height: 6px; }
                VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    Action { height: 30px; width: parent.width; label: I18n.common_all; show-label: true; selected: root.kind-filter == I18n.common_all; clicked => { root.kind-filter = I18n.common_all; } }
                    Action { height: 30px; width: parent.width; label: I18n.common_worker_card; show-label: true; selected: root.kind-filter == "worker_card"; clicked => { root.kind-filter = "worker_card"; } }
                    Action { height: 30px; width: parent.width; label: I18n.common_skill_pack; show-label: true; selected: root.kind-filter == "skill_pack"; clicked => { root.kind-filter = "skill_pack"; } }
                }
                Rectangle { height: 10px; }
                HorizontalLayout { padding-left: 16px; Text { height: 20px; text: I18n.pz_assets; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } }
                Rectangle { height: 6px; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; spacing: 4px;
                        for item[index] in root.items : Rectangle {
                            visible: root.kind-filter == I18n.common_all || item.kind == root.kind-filter;
                            height: self.visible ? 60px : 0px;
                            Rectangle {
                                x: 8px; y: 2px; width: parent.width - 16px; height: 56px; border-radius: Theme.radius-lg;
                                background: root.selected == index ? Theme.accent : transparent;
                                Action { width: parent.width; height: parent.height; label: item.title; clicked => { root.select-item(index); } }
                                Text { x: 12px; y: 9px; width: parent.width - 24px; height: 19px; text: item.title; color: root.selected == index ? white : Theme.text; font-size: Theme.font-md; font-weight: 600; overflow: elide; }
                                Text { x: 12px; y: 33px; width: parent.width - 24px; height: 16px; text: (item.kind == "worker_card" ? I18n.common_worker_card : I18n.common_skill_pack) + " · " + (item.mine ? I18n.pz_mine : item.owner); color: root.selected == index ? #ffffffe0 : Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                            }
                        }
                        if root.items.length == 0 : PageState { height: 70px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.pz_loading : I18n.pz_empty; }
                    }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px;
                        Text { height: 25px; text: root.selected >= 0 ? root.current.title : I18n.common_plaza; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; }
                        Text { height: 17px; text: root.selected >= 0 ? (root.current-kind-label + " · " + (root.current.mine ? I18n.pz_mine : I18n.pz_from_prefix + root.current.owner)) : I18n.pz_pick_item; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.selected >= 0 : Action { icon: @image-url("../assets/icons/upload.svg"); label: I18n.pz_import; show-label: true; primary: true; enabled: !root.loading; clicked => { root.request-import(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.selected < 0 : Text { vertical-stretch: 1; text: I18n.pz_pick_hint; color: Theme.muted; font-size: Theme.font-md; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                if root.selected >= 0 : ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; padding: 22px; spacing: 12px;
                        HorizontalLayout { height: 30px; spacing: 8px; Text { width: 96px; height: parent.height; text: I18n.pz_kind_filter; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: root.current-kind-label; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { width: 96px; height: parent.height; text: I18n.pz_publisher; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: root.current.mine ? I18n.pz_me_prefix + root.current.owner + "）" : root.current.owner; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { width: 96px; height: parent.height; text: I18n.pz_updated_at; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: root.current.updated-at; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { width: 96px; height: parent.height; text: I18n.common_files; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: root.current.artifact + " · " + root.current.size; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { width: 96px; height: parent.height; text: I18n.pz_sync_state; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } Text { horizontal-stretch: 1; height: parent.height; text: root.current.freshness == "current" ? I18n.pz_sync_current : root.current.freshness == "outdated" ? I18n.pz_sync_outdated : I18n.pz_sync_deleted; color: root.current.freshness == "current" ? Theme.success : Theme.warning; font-size: Theme.font-sm; vertical-alignment: center; } }
                        HorizontalLayout { spacing: 8px; Text { width: 96px; text: I18n.pz_tags; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: top; } Text { horizontal-stretch: 1; text: root.current.tags == "" ? I18n.common_none : root.current.tags; color: Theme.text; font-size: Theme.font-sm; wrap: word-wrap; } }
                        HorizontalLayout { spacing: 8px; Text { width: 96px; text: I18n.pz_summary; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: top; } Text { horizontal-stretch: 1; text: root.current.summary == "" ? I18n.pz_no_summary : root.current.summary; color: Theme.text; font-size: Theme.font-sm; wrap: word-wrap; } }
                        Rectangle { height: 1px; background: Theme.border; }
                        Text { height: 34px; text: I18n.pz_import_note; color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }

    if root.import-open : Rectangle {
        Rectangle { background: Theme.overlay; TouchArea { clicked => { root.cancel-import(); } } }
        Rectangle {
            x: (parent.width - 400px) / 2; y: (parent.height - 170px) / 2; width: 400px; height: 170px;
            border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 18px; spacing: 12px;
                Text { text: I18n.pz_import_title; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { vertical-stretch: 1; text: I18n.pz_import_prefix + root.current.title + "”。" + (root.current.kind == "worker_card" ? I18n.pz_import_card_suffix : I18n.pz_import_pack_suffix) + I18n.pz_import_question; color: Theme.muted; font-size: Theme.font-sm; wrap: word-wrap; }
                HorizontalLayout { height: 32px; spacing: 8px; Rectangle { horizontal-stretch: 1; }
                    Action { width: 96px; label: I18n.pz_confirm_import; show-label: true; clicked => { root.confirm-import(); } }
                    Action { width: 72px; label: I18n.common_cancel; show-label: true; primary: true; clicked => { root.cancel-import(); } }
                }
            }
        }
    }
}
