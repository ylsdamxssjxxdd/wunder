import { I18n } from "i18n.slint";
import { Theme, AgentCard, AgentCardFile, PromptPackCard, ToolCard, ModelCard, FileCard, LanPeerCard } from "theme.slint";
import { Action, Avatar, SearchField, FormField, MiddleHeader, MiddleFooter, PageState, PageStateKind } from "components.slint";
import { TextEditBase } from "textedit-base.slint";
import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

export component AgentsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <[AgentCard]> agents;
    in property <[ToolCard]> tools;
    in property <int> selected-agent: -1;
    in-out property <string> selected-name;
    in-out property <string> selected-description;
    in-out property <string> selected-model;
    in-out property <string> selected-system-prompt;
    in property <string> selected-status;
    in-out property <string> selected-icon-name;
    in-out property <string> selected-icon-color;
    in property <string> selected-icon-glyph;
    callback select-agent(int);
    callback create-agent();
    callback refresh();
    in-out property <[string]> selected-tool-names: [];
    in-out property <[string]> selected-preset-questions: [];
    in-out property <int> selected-sandbox-container-id: 1;
    in-out property <string> selected-approval-mode: "suggest";
    in-out property <bool> selected-preview-skill: false;
    in-out property <bool> selected-silent: false;
    in-out property <bool> selected-prefer-mother: false;
    private property <string> keyword;
    private property <string> tool-keyword;
    private property <int> tool-tab: 0;
    private property <bool> delete-confirm-open: false;
    in-out property <string> question-draft;
    callback toggle-tool(string);
    callback add-question();
    callback remove-question(int);
    callback save-agent(string, string, string, string, string, string, [string], [string], int, string, bool, bool, bool);
    callback delete-agent();
    callback export-agent-card();
    callback open-agent-card-import();
    callback close-agent-card-import();
    callback import-agent-card(string);
    in-out property <bool> cards-open: false;
    in property <bool> cards-loading: false;
    in property <[AgentCardFile]> card-files;
    in-out property <bool> card-overwrite: false;
    in property <string> status;
    background: Theme.chat;
    HorizontalLayout {
        // Fill the page: the content column otherwise stays at preferred width.
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        Rectangle {
            width: Theme.middle-width;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: I18n.ag_title; subtitle: I18n.ag_subtitle; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: I18n.ag_search; text <=> root.keyword; }
                    Action { width: 34px; height: 34px; icon: @image-url("../assets/icons/plus.svg"); label: I18n.ag_new; enabled: !root.loading && !root.saving; selected: true; clicked => { root.create-agent(); } }
                }
                Rectangle { height: 14px; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start;
                        for agent[index] in root.agents : Rectangle {
                            height: root.keyword == "" || agent.name.to-lowercase().starts-with(root.keyword.to-lowercase()) ? 76px : 0px; visible: self.height > 0px;
                            Rectangle {
                                x: 8px; y: 2px; width: parent.width - 16px; height: 72px; border-radius: Theme.radius-lg; background: root.selected-agent == index ? Theme.accent : transparent;
                                Action { width: parent.width; height: parent.height; label: agent.name; enabled: !root.saving; clicked => { root.select-agent(index); } }
                                Avatar { x: 10px; y: 19px; mine: false; glyph: agent.icon-glyph; tone: agent.icon-tone; source: @image-url("../assets/avatar.png"); }
                                Text { x: 54px; y: 12px; width: parent.width - 65px; height: 20px; text: agent.name; color: root.selected-agent == index ? white : Theme.text; font-size: Theme.font-md; font-weight: 600; overflow: elide; }
                                Text { x: 54px; y: 35px; width: parent.width - 65px; height: 16px; text: (agent.model == "" ? I18n.common_default_model : agent.model) + "  ·  " + agent.tool-count + I18n.ag_tool_count_suffix; color: root.selected-agent == index ? #ffffffe0 : Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                Text { x: 54px; y: 53px; width: parent.width - 65px; height: 14px; text: agent.status == "active" ? I18n.ag_available : agent.status; color: root.selected-agent == index ? #ffffffe0 : Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                            }
                        }
                        if root.agents.length == 0 : PageState { height: 48px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.ag_loading : I18n.ag_empty; }
                    }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.selected-name == "" ? I18n.ag_editor_title : root.selected-name; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; } Text { height: 17px; text: root.selected-status == "" ? I18n.ag_editor_subtitle : root.selected-status; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.loading; clicked => { root.refresh(); } }
                    Action { label: I18n.ag_export_card; show-label: true; enabled: !root.loading && !root.saving && root.selected-agent >= 0; clicked => { root.export-agent-card(); } }
                    Action { label: I18n.ag_import_card; show-label: true; enabled: !root.loading && !root.saving; clicked => { root.open-agent-card-import(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { padding-top: 18px; padding-right: 22px; padding-bottom: 24px; padding-left: 22px; spacing: 13px; alignment: start;
                        FormField { label: I18n.common_name; placeholder: I18n.ag_name_label; text <=> root.selected-name; read-only: root.saving; }
                        FormField { label: I18n.ag_greeting_label; placeholder: I18n.ag_greeting_placeholder; text <=> root.selected-description; read-only: root.saving; }
                        Text { height: 18px; text: I18n.ag_system_prompt; color: Theme.muted; font-size: Theme.font-xs; }
                        TextEditBase { height: 130px; text <=> root.selected-system-prompt; read-only: root.saving; wrap: word-wrap; scroll-view-padding: 10px; foreground: Theme.text; font-size: Theme.font-sm; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm; selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.text; }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout { height: 28px; Text { text: I18n.ag_tool_capability; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: root.tools.length + I18n.ag_tools_available_suffix; color: Theme.muted; font-size: Theme.font-xs; } }
                        HorizontalLayout { height: 32px; spacing: 7px; SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: I18n.ag_search_tools; text <=> root.tool-keyword; } for category in [I18n.common_all, I18n.tl_cat_builtin, I18n.tl_cat_mcp, I18n.tl_cat_skills] : Action { width: 58px; label: category; show-label: true; selected: root.tool-tab == (category == I18n.common_all ? 0 : category == I18n.tl_cat_builtin ? 1 : category == I18n.tl_cat_mcp ? 2 : 3); clicked => { root.tool-tab = category == I18n.common_all ? 0 : category == I18n.tl_cat_builtin ? 1 : category == I18n.tl_cat_mcp ? 2 : 3; } } }
                        VerticalLayout { spacing: 5px; for tool in root.tools : Rectangle { visible: (root.tool-keyword == "" || tool.name.to-lowercase().starts-with(root.tool-keyword.to-lowercase())) && (root.tool-tab == 0 || (root.tool-tab == 1 && tool.category == I18n.tl_cat_builtin) || (root.tool-tab == 2 && tool.category == I18n.tl_cat_mcp) || (root.tool-tab == 3 && tool.category == I18n.tl_cat_skills)); height: self.visible ? 48px : 0px; border-radius: Theme.radius-sm; background: tool.enabled ? Theme.accent-soft : Theme.panel; border-width: 1px; border-color: tool.enabled ? Theme.accent : Theme.border; Action { width: parent.width; height: parent.height; label: tool.name; enabled: !root.saving; clicked => { root.toggle-tool(tool.name); } } Text { x: 12px; y: 6px; width: parent.width - 56px; height: 17px; text: tool.name; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; overflow: elide; } Text { x: 12px; y: 25px; width: parent.width - 56px; height: 15px; text: tool.description; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; } Text { x: parent.width - 38px; y: 13px; width: 24px; height: 20px; text: tool.enabled ? "✓" : "＋"; color: tool.enabled ? Theme.accent-deep : Theme.muted; font-size: Theme.font-lg; horizontal-alignment: center; } } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { text: I18n.ag_run_strategy; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; } Rectangle { horizontal-stretch: 1; } }
                        HorizontalLayout { height: 60px; spacing: 8px; FormField { horizontal-stretch: 1; label: I18n.ag_model_key; placeholder: I18n.ag_model_key_hint; text <=> root.selected-model; read-only: root.saving; } Rectangle { width: 122px; } }
                        HorizontalLayout { height: 62px; spacing: 8px; Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius-sm; VerticalLayout { padding: 8px; Text { text: I18n.ag_workdir_container; color: Theme.muted; font-size: Theme.font-2xs; } Text { text: I18n.ag_container_prefix + root.selected-sandbox-container-id; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; } } TouchArea { clicked => { root.selected-sandbox-container-id = root.selected-sandbox-container-id >= 10 ? 1 : root.selected-sandbox-container-id + 1; } } } Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius-sm; VerticalLayout { padding: 8px; Text { text: I18n.ag_permission_mode; color: Theme.muted; font-size: Theme.font-2xs; } Text { text: root.selected-approval-mode; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; } } TouchArea { clicked => { root.selected-approval-mode = root.selected-approval-mode == "suggest" ? "auto_edit" : root.selected-approval-mode == "auto_edit" ? "full_auto" : "suggest"; } } } }
                        HorizontalLayout { height: 58px; spacing: 8px; for item in [{title: I18n.ag_preview_skill, value: root.selected-preview-skill}, {title: I18n.ag_silent_run, value: root.selected-silent}, {title: I18n.ag_prefer_mother, value: root.selected-prefer-mother}] : Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: Theme.radius-sm; VerticalLayout { padding: 8px; Text { text: item.title; color: Theme.muted; font-size: Theme.font-2xs; } Text { text: item.value ? I18n.ag_switch_on : I18n.ag_switch_off; color: item.value ? Theme.accent-deep : Theme.muted; font-size: Theme.font-xs; } } TouchArea { clicked => { if item.title == I18n.ag_preview_skill { root.selected-preview-skill = !root.selected-preview-skill; } else if item.title == I18n.ag_silent_run { root.selected-silent = !root.selected-silent; } else { root.selected-prefer-mother = !root.selected-prefer-mother; } } } } }
                        Text { height: 18px; text: I18n.ag_preset_questions; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; }
                        VerticalLayout { spacing: 5px; for question[index] in root.selected-preset-questions : Rectangle { height: 34px; border-radius: Theme.radius-sm; background: Theme.panel; Text { x: 10px; width: parent.width - 42px; height: parent.height; text: question; color: Theme.text; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; } Action { x: parent.width - 30px; width: 26px; height: 26px; y: 4px; label: "×"; clicked => { root.remove-question(index); } } } }
                        HorizontalLayout { height: 32px; spacing: 6px; TextInput { horizontal-stretch: 1; text <=> root.question-draft; color: Theme.text; font-size: Theme.font-xs; } Action { width: 58px; label: I18n.common_add; show-label: true; enabled: root.question-draft != ""; clicked => { root.add-question(); } } }
                        HorizontalLayout { height: 34px; Action { width: 68px; label: I18n.common_delete; show-label: true; enabled: !root.saving && !root.loading && root.selected-agent >= 0 && !root.agents[root.selected-agent].is-shared; clicked => { root.delete-confirm-open = true; } } Rectangle { horizontal-stretch: 1; } Action { label: root.saving ? I18n.common_saving : I18n.ag_save_settings; show-label: true; primary: true; enabled: !root.saving && !root.loading && root.selected-agent >= 0 && root.selected-name != ""; clicked => { root.save-agent(root.selected-name, root.selected-description, root.selected-system-prompt, root.selected-model, root.selected-icon-name, root.selected-icon-color, root.selected-tool-names, root.selected-preset-questions, root.selected-sandbox-container-id, root.selected-approval-mode, root.selected-preview-skill, root.selected-silent, root.selected-prefer-mother); } } }
                    }
                }
            }
        }
    }
    if root.delete-confirm-open : Rectangle { background: Theme.overlay; TouchArea { clicked => { root.delete-confirm-open = false; } } Rectangle { width: min(400px, parent.width - 44px); height: 180px; border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { } VerticalLayout { padding: 20px; spacing: 10px; Text { height: 24px; text: I18n.ag_delete_confirm_title; color: Theme.text; font-size: Theme.font-xl; font-weight: 600; } Text { vertical-stretch: 1; text: I18n.ag_delete_prefix + root.selected-name + I18n.ag_delete_suffix; color: Theme.muted; font-size: Theme.font-sm; wrap: word-wrap; } HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: I18n.common_cancel; show-label: true; clicked => { root.delete-confirm-open = false; } } Action { width: 76px; label: I18n.common_delete; show-label: true; primary: true; clicked => { root.delete-confirm-open = false; root.delete-agent(); } } } } } }
    if root.cards-open : Rectangle {
        background: Theme.overlay;
        TouchArea { clicked => { root.close-agent-card-import(); } }
        Rectangle {
            x: (parent.width - 460px) / 2; y: 30px; width: min(460px, parent.width - 40px); height: parent.height - 60px;
            border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 18px; spacing: 10px;
                HorizontalLayout { height: 26px; Text { text: I18n.ag_import_title; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Action { width: 30px; icon: @image-url("../assets/icons/xmark.svg"); clicked => { root.close-agent-card-import(); } } }
                Text { height: 17px; text: I18n.ag_import_hint; color: Theme.muted; font-size: Theme.font-xs; }
                CheckBox { height: 24px; text: I18n.ag_overwrite_label; checked <=> root.card-overwrite; enabled: !root.cards-loading; }
                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { spacing: 6px; alignment: start;
                        for card in root.card-files : Rectangle { height: 52px; border-radius: Theme.radius-md; background: Theme.panel;
                            Text { x: 12px; y: 8px; width: parent.width - 150px; height: 18px; text: card.label; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                            Text { x: 12px; y: 29px; width: parent.width - 150px; height: 15px; text: card.path; color: Theme.muted; font-size: 9px; overflow: elide; }
                            Action { x: parent.width - 96px; y: 10px; width: 84px; height: 32px; label: I18n.ag_import_button; show-label: true; primary: true; enabled: !root.cards-loading; clicked => { root.import-agent-card(card.path); } }
                        }
                        if root.card-files.length == 0 : PageState { height: 70px; kind: root.cards-loading ? PageStateKind.loading : PageStateKind.empty; message: root.cards-loading ? I18n.ag_cards_scanning : I18n.ag_cards_empty; }
                    }
                }
            }
        }
    }
}

export component ToolsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <[ToolCard]> tools;
    callback refresh();
    in property <string> status;
    background: Theme.chat;
    private property <string> keyword;
    private property <string> category: I18n.common_all;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: Theme.middle-width;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: I18n.tl_title; subtitle: I18n.tl_subtitle; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: I18n.ag_search_tools; text <=> root.keyword; }
                }
                Rectangle { height: 14px; }
                HorizontalLayout { padding-left: 16px; Text { height: 22px; text: I18n.tl_category; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } }
                Rectangle { height: 6px; }
                VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    for category in [I18n.common_all, I18n.tl_cat_builtin, I18n.tl_cat_mcp, I18n.tl_cat_skills, I18n.tl_cat_kb, I18n.tl_cat_user, I18n.tl_cat_shared, I18n.tl_cat_a2a] : Action { height: 30px; width: parent.width; label: category; show-label: true; selected: root.category == category; clicked => { root.category = category; } }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.category == I18n.common_all ? I18n.tl_cat_all : root.category; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; } Text { height: 17px; text: root.tools.length + I18n.tl_count_suffix; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.loading; clicked => { root.refresh(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; padding-top: 14px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px; spacing: 8px;
                        for tool in root.tools : Rectangle {
                            visible: (root.category == I18n.common_all || tool.category == root.category) && (root.keyword == "" || tool.name.to-lowercase().starts-with(root.keyword.to-lowercase()) || tool.description.starts-with(root.keyword));
                            height: ((root.category == I18n.common_all || tool.category == root.category) && (root.keyword == "" || tool.name.to-lowercase().starts-with(root.keyword.to-lowercase()) || tool.description.starts-with(root.keyword))) ? 84px : 0px; border-radius: Theme.radius-lg; background: Theme.accent-soft;
                            Text { x: 14px; y: 12px; width: parent.width - 28px; height: 22px; text: tool.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                            Text { x: 14px; y: 39px; width: parent.width - 28px; height: 34px; text: tool.description == "" ? I18n.tl_enabled_capabilities : tool.description; color: Theme.muted; font-size: Theme.font-sm; wrap: word-wrap; overflow: elide; }
                        }
                        if root.tools.length == 0 : PageState { height: 72px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.tl_loading : I18n.tl_empty; }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <[ModelCard]> models;
    in property <int> selected-model: -1;
    in-out property <string> workspace-root;
    in-out property <string> language;
    in-out property <string> python-path;
    in-out property <string> git-path;
    in-out property <string> rg-path;
    in property <string> python-status;
    in property <string> git-status;
    in property <string> rg-status;
    in-out property <bool> lan-enabled: false;
    in-out property <string> lan-name;
    in property <string> lan-peer-id;
    in property <string> lan-endpoint;
    in property <int> lan-peer-count;
    in property <[LanPeerCard]> lan-peers;
    in property <string> selected-key;
    in property <string> selected-provider;
    in property <string> selected-model-name;
    in property <string> selected-base-url;
    in property <string> selected-type;
    in property <bool> selected-is-default;
    callback select-model(int);
    callback create-model();
    callback edit-model();
    callback set-default-model(string);
    callback refresh();
    callback save-runtime(string, string, string, string, string);
    callback save-lan(bool, string);
    callback save-preferences();
    callback refresh-prompt-packs();
    callback select-prompt-pack(string);
    callback save-prompt-segment();
    callback create-prompt-pack();
    callback delete-prompt-pack();
    callback export-diagnostics();
    callback reset-work-state();
    in-out property <string> theme;
    in-out property <string> send-key;
    in property <[PromptPackCard]> prompt-packs;
    in property <string> prompt-active;
    in-out property <string> selected-pack;
    in-out property <int> selected-segment: 0;
    in-out property <string> prompt-draft;
    in property <bool> prompt-readonly;
    in property <bool> prompt-loading: false;
    in-out property <bool> reset-confirm-open: false;
    in-out property <string> pack-name-draft;
    in property <string> status;
    // Exposed so screenshot fixtures and regressions can open a specific panel.
    in-out property <int> settings-tab: 0;
    background: Theme.chat;
    HorizontalLayout {
        // Fill the page: the content column otherwise stays at preferred width.
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        Rectangle {
            width: Theme.middle-width;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: I18n.menu_settings; subtitle: I18n.st_subtitle; }
                Rectangle { height: 14px; }
                HorizontalLayout { padding-left: 16px; Text { height: 22px; text: I18n.st_items; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } }
                Rectangle { height: 6px; }
                VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/robot.svg"); label: I18n.common_model_config; show-label: true; selected: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: I18n.common_local_runtime; show-label: true; selected: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: I18n.st_tab_tools; show-label: true; selected: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: I18n.st_tab_help; show-label: true; selected: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: I18n.st_tab_general; show-label: true; selected: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: I18n.st_tab_prompts; show-label: true; selected: root.settings-tab == 5; clicked => { root.settings-tab = 5; root.refresh-prompt-packs(); } }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.settings-tab == 0 ? I18n.common_model_config : root.settings-tab == 1 ? I18n.common_local_runtime : root.settings-tab == 2 ? I18n.st_tab_tools : root.settings-tab == 3 ? I18n.st_tab_help : root.settings-tab == 4 ? I18n.st_tab_general : I18n.st_tab_prompts; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; } Text { height: 17px; text: I18n.st_local_note; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.settings-tab == 0 : Action { icon: @image-url("../assets/icons/plus.svg"); label: I18n.model_editor_add; show-label: true; primary: true; enabled: !root.loading && !root.saving; clicked => { root.create-model(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                    if root.settings-tab == 1 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 14px;
                            Text { height: 28px; text: I18n.common_local_runtime; font-size: Theme.font-headline; font-weight: 700; color: Theme.text; }
                            FormField { label: I18n.dk_workdir; text <=> root.workspace-root; read-only: root.saving || root.loading; }
                            FormField { label: I18n.st_language; placeholder: I18n.st_language_hint; text <=> root.language; read-only: root.saving || root.loading; }
                            Text { text: I18n.st_workdir_note; color: Theme.muted; wrap: word-wrap; }
                            Action { label: root.saving ? I18n.common_saving : I18n.ag_save_settings; show-label: true; primary: true; enabled: !root.saving && !root.loading; clicked => { root.save-runtime(root.workspace-root, root.language, root.python-path, root.git-path, root.rg-path); } }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { height: 24px; text: I18n.st_exec_paths; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: I18n.st_exec_paths_note; color: Theme.muted; wrap: word-wrap; }
                            FormField { label: I18n.st_python_path; placeholder: I18n.st_python_hint; text <=> root.python-path; read-only: root.saving || root.loading; }
                            Text { height: 18px; text: root.python-status; color: root.python-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            FormField { label: I18n.st_git_path; placeholder: I18n.st_git_hint; text <=> root.git-path; read-only: root.saving || root.loading; }
                            Text { height: 18px; text: root.git-status; color: root.git-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            FormField { label: I18n.st_rg_path; placeholder: I18n.st_rg_hint; text <=> root.rg-path; read-only: root.saving || root.loading; }
                            Text { height: 18px; text: root.rg-status; color: root.rg-status.starts-with("⚠") ? Theme.danger : Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { height: 24px; text: I18n.st_lan_title; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { height: 18px; text: root.lan-enabled ? I18n.st_lan_on : I18n.st_lan_off; color: root.lan-enabled ? Theme.success : Theme.muted; font-size: Theme.font-sm; }
                            FormField { label: I18n.st_lan_node_name; placeholder: I18n.st_lan_node_name_hint; text <=> root.lan-name; read-only: root.saving || root.loading; }
                            Text { height: 18px; text: I18n.st_lan_node_id + root.lan-peer-id; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            Text { height: 18px; text: I18n.st_lan_listen + root.lan-endpoint + I18n.st_lan_discovered_prefix + root.lan-peer-count + I18n.st_lan_discovered_suffix; color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                            ScrollView { height: 84px; horizontal-scrollbar-policy: always-off; VerticalLayout { alignment: start; spacing: 3px; for peer in root.lan-peers : Rectangle { height: 24px; border-radius: 5px; background: Theme.accent-soft; Text { x: 8px; width: parent.width - 16px; height: parent.height; text: peer.display-name + "  ·  " + peer.address; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; } } if root.lan-peer-count == 0 : Text { height: 20px; text: I18n.st_lan_empty; color: Theme.muted; font-size: Theme.font-2xs; } } }
                            Action { label: root.lan-enabled ? I18n.st_lan_disable : I18n.st_lan_enable; show-label: true; primary: root.lan-enabled; enabled: !root.saving && !root.loading; clicked => { root.save-lan(!root.lan-enabled, root.lan-name); } }
                        }
                    }
                    if root.settings-tab == 0 : HorizontalLayout { vertical-stretch: 1; padding: 8px; spacing: 14px;
                        Rectangle { width: 220px; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 12px; spacing: 10px;
                                HorizontalLayout { height: 25px; Text { text: I18n.common_model_config; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; label: I18n.common_refresh; clicked => { root.refresh(); } } }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 5px;
                                        for model[index] in root.models : Rectangle { height: 62px; border-radius: Theme.radius-md; background: root.selected-model == index ? Theme.accent-soft : transparent;
                                            Action { width: parent.width; height: parent.height; label: model.key; clicked => { root.select-model(index); } }
                                            Image { x: 9px; y: 15px; width: 18px; height: 18px; source: @image-url("../assets/icons/robot.svg"); colorize: Theme.accent-deep; }
                                            Text { x: 38px; y: 9px; width: parent.width - 46px; height: 18px; text: model.key + (model.is-default ? I18n.st_models_default_suffix : ""); color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                                            Text { x: 38px; y: 31px; width: parent.width - 46px; height: 16px; text: model.model-type + " · " + model.model; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                                        }
                                        if root.models.length == 0 : PageState { height: 48px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.st_models_loading : I18n.st_models_empty; }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 18px; spacing: 13px;
                                Text { height: 26px; text: root.selected-key == "" ? I18n.common_model_config : root.selected-key; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; }
                                Rectangle { border-radius: Theme.radius-md; background: Theme.accent-soft; height: 52px; Text { x: 13px; width: parent.width - 26px; height: parent.height; text: I18n.st_workdir_colon + (root.workspace-root == "" ? I18n.dk_reading : root.workspace-root); color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; } }
                                Text { height: 18px; text: root.selected-key == "" ? I18n.st_pick_model : (root.selected-type + " · " + root.selected-provider); color: Theme.muted; font-size: Theme.font-sm; }
                                Text { height: 18px; text: root.selected-key == "" ? "" : (I18n.st_model_colon + root.selected-model-name); color: Theme.muted; font-size: Theme.font-sm; }
                                Text { height: 18px; text: root.selected-key == "" ? "" : (I18n.st_url_colon + root.selected-base-url); color: Theme.muted; font-size: Theme.font-sm; overflow: elide; }
                                HorizontalLayout { height: 32px; spacing: 8px; Action { width: 92px; icon: @image-url("../assets/icons/gear.svg"); label: I18n.model_editor_edit; show-label: true; enabled: !root.loading && !root.saving && root.selected-key != ""; clicked => { root.edit-model(); } } Action { width: 94px; icon: @image-url("../assets/icons/check.svg"); label: root.selected-is-default ? I18n.st_is_default : I18n.st_set_default; show-label: true; primary: !root.selected-is-default; enabled: !root.loading && !root.saving && root.selected-key != "" && !root.selected-is-default; clicked => { root.set-default-model(root.selected-key); } } }
                                Text { text: I18n.st_models_note; color: Theme.muted; font-size: Theme.font-sm; wrap: word-wrap; vertical-stretch: 1; }
                                Text { height: 18px; text: "" + root.models.length + I18n.st_models_count_suffix; color: Theme.muted; font-size: Theme.font-xs; }
                            }
                        }
                    }
                    if root.settings-tab == 2 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 12px;
                            Text { height: 28px; text: I18n.st_tab_tools; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; }
                            Text { text: I18n.st_tools_elsewhere; color: Theme.muted; font-size: Theme.font-md; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 3 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
                            Text { height: 28px; text: I18n.st_tab_help; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; }
                            Text { text: I18n.st_help_native_note; color: Theme.muted; font-size: Theme.font-md; wrap: word-wrap; }
                            Text { height: 22px; text: I18n.st_diagnostics; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; }
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Action { width: 110px; label: I18n.st_export_diagnostics; show-label: true; enabled: !root.loading; clicked => { root.export-diagnostics(); } }
                                Text { height: 30px; text: I18n.st_diagnostics_note; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { height: 22px; text: I18n.reset_title; color: Theme.danger; font-size: Theme.font-lg; font-weight: 600; }
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Action { width: 110px; label: I18n.reset_title; show-label: true; enabled: !root.loading && !root.saving; clicked => { root.reset-confirm-open = true; } }
                                Text { height: 30px; text: I18n.st_reset_note; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 4 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 14px; alignment: start;
                            Text { height: 28px; text: I18n.st_tab_general; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; }
                            HorizontalLayout { height: 30px; spacing: 10px; Text { width: 84px; text: I18n.st_theme; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                ComboBox { width: 180px; model: [I18n.st_theme_light]; current-index: 0; enabled: false; } }
                            HorizontalLayout { height: 30px; spacing: 10px; Text { width: 84px; text: I18n.st_send_key; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                                ComboBox { width: 180px; model: [I18n.st_send_enter, I18n.st_send_ctrl_enter]; current-index: root.send-key == "ctrl_enter" ? 1 : 0; enabled: true; selected(index) => { root.send-key = index == 1 ? "ctrl_enter" : "enter"; } }
                                Text { text: root.send-key == "ctrl_enter" ? I18n.st_send_enter_newline : I18n.st_send_enter_direct; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; } }
                            Action { width: 110px; label: root.saving ? I18n.common_saving : I18n.st_save_prefs; show-label: true; primary: true; enabled: !root.saving && !root.loading; clicked => { root.save-preferences(); } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 5 : HorizontalLayout { vertical-stretch: 1; padding: 8px; spacing: 14px;
                        Rectangle { width: 240px; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 12px; spacing: 8px;
                                HorizontalLayout { height: 24px; Text { text: I18n.st_tab_prompts; color: Theme.text; font-size: Theme.font-md; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.prompt-loading; clicked => { root.refresh-prompt-packs(); } } }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 4px;
                                        for pack in root.prompt-packs : Rectangle { height: 52px; border-radius: Theme.radius-sm; background: root.selected-pack == pack.id ? Theme.accent-soft : transparent;
                                            Action { width: parent.width; height: parent.height; label: pack.id; enabled: !root.prompt-loading; clicked => { root.select-prompt-pack(pack.id); } }
                                            Text { x: 10px; y: 6px; width: parent.width - 20px; height: 17px; text: pack.id + (pack.is-active ? I18n.st_current_suffix : ""); color: Theme.text; font-size: Theme.font-xs; font-weight: 600; overflow: elide; }
                                            Text { x: 10px; y: 26px; width: parent.width - 20px; height: 15px; text: pack.readonly ? I18n.pm_readonly_builtin : (pack.locale == "" ? I18n.pm_custom : I18n.pm_builtin_lang_pack); color: Theme.muted; font-size: 9px; overflow: elide; }
                                        }
                                        if root.prompt-packs.length == 0 : PageState { height: 48px; kind: root.prompt-loading ? PageStateKind.loading : PageStateKind.empty; message: root.prompt-loading ? I18n.common_loading : I18n.pm_empty; }
                                    }
                                }
                                HorizontalLayout { height: 30px; spacing: 6px; TextInput { horizontal-stretch: 1; text <=> root.pack-name-draft; color: Theme.text; font-size: Theme.font-xs; } Action { width: 44px; label: I18n.common_new; show-label: true; enabled: !root.prompt-loading && root.pack-name-draft != ""; clicked => { root.create-prompt-pack(); } } }
                                Action { height: 30px; label: I18n.pm_delete_custom; show-label: true; enabled: !root.prompt-loading && root.selected-pack != "" && !root.prompt-readonly; clicked => { root.delete-prompt-pack(); } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: Theme.radius-md; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 18px; spacing: 10px;
                                HorizontalLayout { height: 26px; Text { text: root.selected-pack == "" ? I18n.pm_segment_edit : I18n.pm_segment_edit_prefix + root.selected-pack; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: root.prompt-readonly ? I18n.pm_readonly_hint : I18n.pm_editable_hint; color: root.prompt-readonly ? Theme.muted : Theme.success; font-size: Theme.font-xs; vertical-alignment: center; } }
                                ScrollView { height: 34px; vertical-scrollbar-policy: always-off; horizontal-scrollbar-policy: as-needed;
                                    HorizontalLayout { spacing: 6px;
                                        for segment[index] in [{key: "role", label: I18n.pm_segment_role}, {key: "engineering", label: I18n.pm_segment_engineering}, {key: "tools_protocol", label: I18n.pm_segment_tool_protocol}, {key: "skills_protocol", label: I18n.pm_segment_skill_protocol}, {key: "memory", label: I18n.pm_segment_memory}, {key: "extra", label: I18n.pm_segment_attach}] : Action { width: 92px; label: segment.label; show-label: true; enabled: root.selected-pack != ""; selected: root.selected-segment == index; clicked => { root.selected-segment = index; root.select-prompt-pack(root.selected-pack); } } }
                                }
                                TextEditBase { vertical-stretch: 1; text <=> root.prompt-draft; read-only: root.prompt-readonly || root.prompt-loading; wrap: word-wrap; foreground: Theme.text; font-size: Theme.font-sm; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-sm; }
                                HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { width: 96px; label: I18n.pm_save_segment; show-label: true; primary: true; enabled: !root.prompt-readonly && !root.prompt-loading && root.selected-pack != ""; clicked => { root.save-prompt-segment(); } } }
                            }
                        }
                    }
                }
            }
        }
}
