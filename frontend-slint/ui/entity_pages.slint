import { Theme, AgentCard, AgentCardFile, PromptPackCard, ToolCard, ModelCard, FileCard, LanPeerCard } from "theme.slint";
import { Action, Avatar, SearchField, FormField, MiddleHeader, MiddleFooter } from "components.slint";
import { TextEditBase } from "textedit-base.slint";
import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

export component AgentsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <[AgentCard]> agents;
    in property <[ToolCard]> tools;
    in property <int> selected-agent: -1;
    in-out property <string> selected-name;
    in-out property <string> selected-description;
    in-out property <string> selected-model;
    in-out property <string> selected-system-prompt;
    in property <string> selected-status;
    in-out property <string> selected-icon-name;
    in-out property <string> selected-icon-color;
    in property <string> selected-icon-glyph;
    callback select-agent(int);
    callback create-agent();
    callback refresh();
    in-out property <[string]> selected-tool-names: [];
    in-out property <[string]> selected-preset-questions: [];
    in-out property <int> selected-sandbox-container-id: 1;
    in-out property <string> selected-approval-mode: "suggest";
    in-out property <bool> selected-preview-skill: false;
    in-out property <bool> selected-silent: false;
    in-out property <bool> selected-prefer-mother: false;
    private property <string> keyword;
    private property <string> tool-keyword;
    private property <int> tool-tab: 0;
    private property <bool> delete-confirm-open: false;
    in-out property <string> question-draft;
    callback toggle-tool(string);
    callback add-question();
    callback remove-question(int);
    callback save-agent(string, string, string, string, string, string, [string], [string], int, string, bool, bool, bool);
    callback delete-agent();
    callback export-agent-card();
    callback open-agent-card-import();
    callback close-agent-card-import();
    callback import-agent-card(string);
    in-out property <bool> cards-open: false;
    in property <bool> cards-loading: false;
    in property <[AgentCardFile]> card-files;
    in-out property <bool> card-overwrite: false;
    in property <string> status;
    background: Theme.chat;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: "专家"; subtitle: "管理可用于新会话的智能体"; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索专家"; text <=> root.keyword; }
                    Action { width: 34px; height: 34px; icon: @image-url("../assets/icons/plus.svg"); label: "新建专家"; enabled: !root.loading && !root.saving; selected: true; clicked => { root.create-agent(); } }
                }
                Rectangle { height: 14px; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start;
                        for agent[index] in root.agents : Rectangle {
                            height: root.keyword == "" || agent.name.to-lowercase().starts-with(root.keyword.to-lowercase()) ? 76px : 0px; visible: self.height > 0px;
                            Rectangle {
                                x: 8px; y: 2px; width: parent.width - 16px; height: 72px; border-radius: 12px; background: root.selected-agent == index ? Theme.accent : transparent;
                                Action { width: parent.width; height: parent.height; label: agent.name; enabled: !root.saving; clicked => { root.select-agent(index); } }
                                Avatar { x: 10px; y: 19px; mine: false; glyph: agent.icon-glyph; tone: agent.icon-tone; source: @image-url("../assets/avatar.png"); }
                                Text { x: 54px; y: 12px; width: parent.width - 65px; height: 20px; text: agent.name; color: root.selected-agent == index ? white : Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                Text { x: 54px; y: 35px; width: parent.width - 65px; height: 16px; text: (agent.model == "" ? "默认模型" : agent.model) + "  ·  " + agent.tool-count + " 项工具"; color: root.selected-agent == index ? #ffffffe0 : Theme.muted; font-size: 10px; overflow: elide; }
                                Text { x: 54px; y: 53px; width: parent.width - 65px; height: 14px; text: agent.status == "active" ? "可用" : agent.status; color: root.selected-agent == index ? #ffffffe0 : Theme.muted; font-size: 10px; overflow: elide; }
                            }
                        }
                        if root.agents.length == 0 : Text { height: 48px; text: root.loading ? "正在加载专家…" : "未加载到专家"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.selected-name == "" ? "专家设置" : root.selected-name; color: Theme.text; font-size: 18px; font-weight: 700; overflow: elide; } Text { height: 17px; text: root.selected-status == "" ? "编辑专家能力和运行策略" : root.selected-status; color: Theme.muted; font-size: 11px; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.loading; clicked => { root.refresh(); } }
                    Action { label: "导出卡片"; show-label: true; enabled: !root.loading && !root.saving && root.selected-agent >= 0; clicked => { root.export-agent-card(); } }
                    Action { label: "导入卡片"; show-label: true; enabled: !root.loading && !root.saving; clicked => { root.open-agent-card-import(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { padding-top: 18px; padding-right: 22px; padding-bottom: 24px; padding-left: 22px; spacing: 13px; alignment: start;
                        FormField { label: "名称"; placeholder: "专家名称"; text <=> root.selected-name; read-only: root.saving; }
                        FormField { label: "问候语 / 描述"; placeholder: "告诉用户这个专家能做什么"; text <=> root.selected-description; read-only: root.saving; }
                        Text { height: 18px; text: "系统提示词"; color: Theme.muted; font-size: 11px; }
                        TextEditBase { height: 130px; text <=> root.selected-system-prompt; read-only: root.saving; wrap: word-wrap; scroll-view-padding: 10px; foreground: Theme.text; font-size: 12px; background: Theme.panel; border-width: 1px; border-color: Theme.border; border-radius: 8px; selection-background-color: Theme.accent-soft; selection-foreground-color: Theme.text; }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout { height: 28px; Text { text: "工具能力"; color: Theme.text; font-size: 14px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Text { text: root.tools.length + " 项可用"; color: Theme.muted; font-size: 11px; } }
                        HorizontalLayout { height: 32px; spacing: 7px; SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索工具"; text <=> root.tool-keyword; } for category in ["全部", "内置工具", "MCP 工具", "技能"] : Action { width: 58px; label: category; show-label: true; selected: root.tool-tab == (category == "全部" ? 0 : category == "内置工具" ? 1 : category == "MCP 工具" ? 2 : 3); clicked => { root.tool-tab = category == "全部" ? 0 : category == "内置工具" ? 1 : category == "MCP 工具" ? 2 : 3; } } }
                        VerticalLayout { spacing: 5px; for tool in root.tools : Rectangle { visible: (root.tool-keyword == "" || tool.name.to-lowercase().starts-with(root.tool-keyword.to-lowercase())) && (root.tool-tab == 0 || (root.tool-tab == 1 && tool.category == "内置工具") || (root.tool-tab == 2 && tool.category == "MCP 工具") || (root.tool-tab == 3 && tool.category == "技能")); height: self.visible ? 48px : 0px; border-radius: 8px; background: tool.enabled ? Theme.accent-soft : Theme.panel; border-width: 1px; border-color: tool.enabled ? Theme.accent : Theme.border; Action { width: parent.width; height: parent.height; label: tool.name; enabled: !root.saving; clicked => { root.toggle-tool(tool.name); } } Text { x: 12px; y: 6px; width: parent.width - 56px; height: 17px; text: tool.name; color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; } Text { x: 12px; y: 25px; width: parent.width - 56px; height: 15px; text: tool.description; color: Theme.muted; font-size: 10px; overflow: elide; } Text { x: parent.width - 38px; y: 13px; width: 24px; height: 20px; text: tool.enabled ? "✓" : "＋"; color: tool.enabled ? Theme.accent-deep : Theme.muted; font-size: 14px; horizontal-alignment: center; } } }
                        HorizontalLayout { height: 30px; spacing: 8px; Text { text: "运行策略"; color: Theme.text; font-size: 14px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } }
                        HorizontalLayout { height: 60px; spacing: 8px; FormField { horizontal-stretch: 1; label: "模型配置键"; placeholder: "留空继承默认"; text <=> root.selected-model; read-only: root.saving; } Rectangle { width: 122px; } }
                        HorizontalLayout { height: 62px; spacing: 8px; Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: 8px; VerticalLayout { padding: 8px; Text { text: "工作目录容器"; color: Theme.muted; font-size: 10px; } Text { text: "容器 #" + root.selected-sandbox-container-id; color: Theme.text; font-size: 12px; font-weight: 600; } } TouchArea { clicked => { root.selected-sandbox-container-id = root.selected-sandbox-container-id >= 10 ? 1 : root.selected-sandbox-container-id + 1; } } } Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: 8px; VerticalLayout { padding: 8px; Text { text: "权限模式"; color: Theme.muted; font-size: 10px; } Text { text: root.selected-approval-mode; color: Theme.text; font-size: 12px; font-weight: 600; } } TouchArea { clicked => { root.selected-approval-mode = root.selected-approval-mode == "suggest" ? "auto_edit" : root.selected-approval-mode == "auto_edit" ? "full_auto" : "suggest"; } } } }
                        HorizontalLayout { height: 58px; spacing: 8px; for item in [{title: "预览技能", value: root.selected-preview-skill}, {title: "静默运行", value: root.selected-silent}, {title: "偏好母智能体", value: root.selected-prefer-mother}] : Rectangle { horizontal-stretch: 1; background: Theme.panel; border-radius: 8px; VerticalLayout { padding: 8px; Text { text: item.title; color: Theme.muted; font-size: 10px; } Text { text: item.value ? "已开启" : "已关闭"; color: item.value ? Theme.accent-deep : Theme.muted; font-size: 11px; } } TouchArea { clicked => { if item.title == "预览技能" { root.selected-preview-skill = !root.selected-preview-skill; } else if item.title == "静默运行" { root.selected-silent = !root.selected-silent; } else { root.selected-prefer-mother = !root.selected-prefer-mother; } } } } }
                        Text { height: 18px; text: "预设问题"; color: Theme.text; font-size: 14px; font-weight: 600; }
                        VerticalLayout { spacing: 5px; for question[index] in root.selected-preset-questions : Rectangle { height: 34px; border-radius: 7px; background: Theme.panel; Text { x: 10px; width: parent.width - 42px; height: parent.height; text: question; color: Theme.text; font-size: 11px; vertical-alignment: center; overflow: elide; } Action { x: parent.width - 30px; width: 26px; height: 26px; y: 4px; label: "×"; clicked => { root.remove-question(index); } } } }
                        HorizontalLayout { height: 32px; spacing: 6px; TextInput { horizontal-stretch: 1; text <=> root.question-draft; color: Theme.text; font-size: 11px; } Action { width: 58px; label: "添加"; show-label: true; enabled: root.question-draft != ""; clicked => { root.add-question(); } } }
                        HorizontalLayout { height: 34px; Action { width: 68px; label: "删除"; show-label: true; enabled: !root.saving && !root.loading && root.selected-agent >= 0 && !root.agents[root.selected-agent].is-shared; clicked => { root.delete-confirm-open = true; } } Rectangle { horizontal-stretch: 1; } Action { label: root.saving ? "保存中" : "保存设置"; show-label: true; primary: true; enabled: !root.saving && !root.loading && root.selected-agent >= 0 && root.selected-name != ""; clicked => { root.save-agent(root.selected-name, root.selected-description, root.selected-system-prompt, root.selected-model, root.selected-icon-name, root.selected-icon-color, root.selected-tool-names, root.selected-preset-questions, root.selected-sandbox-container-id, root.selected-approval-mode, root.selected-preview-skill, root.selected-silent, root.selected-prefer-mother); } } }
                    }
                }
            }
        }
    }
    if root.delete-confirm-open : Rectangle { background: #00000040; TouchArea { clicked => { root.delete-confirm-open = false; } } Rectangle { width: min(400px, parent.width - 44px); height: 180px; border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { } VerticalLayout { padding: 20px; spacing: 10px; Text { height: 24px; text: "确认删除智能体"; color: Theme.text; font-size: 16px; font-weight: 600; } Text { vertical-stretch: 1; text: "将删除“" + root.selected-name + "”及其本地配置。已有会话不会被改写。"; color: Theme.muted; font-size: 12px; wrap: word-wrap; } HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { label: "取消"; show-label: true; clicked => { root.delete-confirm-open = false; } } Action { width: 76px; label: "删除"; show-label: true; primary: true; clicked => { root.delete-confirm-open = false; root.delete-agent(); } } } } } }
    if root.cards-open : Rectangle {
        background: #00000040;
        TouchArea { clicked => { root.close-agent-card-import(); } }
        Rectangle {
            x: (parent.width - 460px) / 2; y: 30px; width: min(460px, parent.width - 40px); height: parent.height - 60px;
            border-radius: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
            TouchArea { }
            VerticalLayout { padding: 18px; spacing: 10px;
                HorizontalLayout { height: 26px; Text { text: "导入工蜂卡"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Action { width: 30px; icon: @image-url("../assets/icons/xmark.svg"); clicked => { root.close-agent-card-import(); } } }
                Text { height: 17px; text: "卡片目录：工作区 agent-cards 目录下的导出文件"; color: Theme.muted; font-size: 11px; }
                CheckBox { height: 24px; text: "覆盖同名专家（导入前需确认）"; checked <=> root.card-overwrite; enabled: !root.cards-loading; }
                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { spacing: 6px; alignment: start;
                        for card in root.card-files : Rectangle { height: 52px; border-radius: 9px; background: Theme.panel;
                            Text { x: 12px; y: 8px; width: parent.width - 150px; height: 18px; text: card.label; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                            Text { x: 12px; y: 29px; width: parent.width - 150px; height: 15px; text: card.path; color: Theme.muted; font-size: 9px; overflow: elide; }
                            Action { x: parent.width - 96px; y: 10px; width: 84px; height: 32px; label: "导入"; show-label: true; primary: true; enabled: !root.cards-loading; clicked => { root.import-agent-card(card.path); } }
                        }
                        if root.card-files.length == 0 : Text { height: 70px; text: root.cards-loading ? "正在扫描卡片目录…" : "卡片目录暂无可导入的工蜂卡文件"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

export component ToolsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <[ToolCard]> tools;
    callback refresh();
    in property <string> status;
    background: Theme.chat;
    private property <string> keyword;
    private property <string> category: "全部";
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: "工具"; subtitle: "当前账户可使用的内置工具、技能和连接能力"; }
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; height: 34px; spacing: 8px;
                    SearchField { horizontal-stretch: 1; icon: @image-url("../assets/icons/magnifying-glass.svg"); placeholder: "搜索工具"; text <=> root.keyword; }
                }
                Rectangle { height: 14px; }
                HorizontalLayout { padding-left: 16px; Text { height: 22px; text: "工具分类"; color: Theme.text; font-size: 13px; font-weight: 600; } }
                Rectangle { height: 6px; }
                VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    for category in ["全部", "内置工具", "MCP 工具", "技能", "知识库", "用户工具", "共享工具", "A2A 工具"] : Action { height: 30px; width: parent.width; label: category; show-label: true; selected: root.category == category; clicked => { root.category = category; } }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.category == "全部" ? "全部工具" : root.category; color: Theme.text; font-size: 18px; font-weight: 700; overflow: elide; } Text { height: 17px; text: root.tools.length + " 项能力 · 工具权限由本地运行时统一管理"; color: Theme.muted; font-size: 11px; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.loading; clicked => { root.refresh(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; padding-top: 14px; padding-right: 22px; padding-bottom: 20px; padding-left: 22px; spacing: 8px;
                        for tool in root.tools : Rectangle {
                            visible: (root.category == "全部" || tool.category == root.category) && (root.keyword == "" || tool.name.to-lowercase().starts-with(root.keyword.to-lowercase()) || tool.description.starts-with(root.keyword));
                            height: ((root.category == "全部" || tool.category == root.category) && (root.keyword == "" || tool.name.to-lowercase().starts-with(root.keyword.to-lowercase()) || tool.description.starts-with(root.keyword))) ? 84px : 0px; border-radius: 11px; background: Theme.accent-soft;
                            Text { x: 14px; y: 12px; width: parent.width - 28px; height: 22px; text: tool.name; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                            Text { x: 14px; y: 39px; width: parent.width - 28px; height: 34px; text: tool.description == "" ? "已启用的运行时能力" : tool.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; overflow: elide; }
                        }
                        if root.tools.length == 0 : Text { height: 72px; text: root.loading ? "正在加载工具…" : "未加载到可用工具"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <bool> saving: false;
    in property <[ModelCard]> models;
    in property <int> selected-model: -1;
    in-out property <string> workspace-root;
    in-out property <string> language;
    in-out property <bool> lan-enabled: false;
    in-out property <string> lan-name;
    in property <string> lan-peer-id;
    in property <string> lan-endpoint;
    in property <int> lan-peer-count;
    in property <[LanPeerCard]> lan-peers;
    in property <string> selected-key;
    in property <string> selected-provider;
    in property <string> selected-model-name;
    in property <string> selected-base-url;
    in property <string> selected-type;
    in property <bool> selected-is-default;
    callback select-model(int);
    callback create-model();
    callback edit-model();
    callback set-default-model(string);
    callback refresh();
    callback save-runtime(string, string);
    callback save-lan(bool, string);
    callback save-preferences();
    callback refresh-prompt-packs();
    callback select-prompt-pack(string);
    callback save-prompt-segment();
    callback create-prompt-pack();
    callback delete-prompt-pack();
    callback export-diagnostics();
    callback reset-work-state();
    in-out property <string> theme;
    in-out property <string> send-key;
    in property <[PromptPackCard]> prompt-packs;
    in property <string> prompt-active;
    in-out property <string> selected-pack;
    in-out property <int> selected-segment: 0;
    in-out property <string> prompt-draft;
    in property <bool> prompt-readonly;
    in property <bool> prompt-loading: false;
    in-out property <bool> reset-confirm-open: false;
    in-out property <string> pack-name-draft;
    in property <string> status;
    private property <int> settings-tab: 0;
    background: Theme.chat;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: Theme.middle;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 0px;
                MiddleHeader { title: "系统设置"; subtitle: "本地运行时、工作目录和模型配置"; }
                Rectangle { height: 14px; }
                HorizontalLayout { padding-left: 16px; Text { height: 22px; text: "设置项目"; color: Theme.text; font-size: 13px; font-weight: 600; } }
                Rectangle { height: 6px; }
                VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/robot.svg"); label: "模型配置"; show-label: true; selected: root.settings-tab == 0; clicked => { root.settings-tab = 0; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: "本地运行时"; show-label: true; selected: root.settings-tab == 1; clicked => { root.settings-tab = 1; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: "工具与技能"; show-label: true; selected: root.settings-tab == 2; clicked => { root.settings-tab = 2; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/comments.svg"); label: "帮助与关于"; show-label: true; selected: root.settings-tab == 3; clicked => { root.settings-tab = 3; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/gear.svg"); label: "通用偏好"; show-label: true; selected: root.settings-tab == 4; clicked => { root.settings-tab = 4; } }
                    Action { height: 38px; width: parent.width; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); label: "提示词包"; show-label: true; selected: root.settings-tab == 5; clicked => { root.settings-tab = 5; root.refresh-prompt-packs(); } }
                }
                MiddleFooter { text: root.status; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    height: 62px; padding-left: 14px; padding-right: 14px; padding-top: 16px; padding-bottom: 16px; spacing: 8px;
                    VerticalLayout { spacing: 1px; Text { height: 25px; text: root.settings-tab == 0 ? "模型配置" : root.settings-tab == 1 ? "本地运行时" : root.settings-tab == 2 ? "工具与技能" : root.settings-tab == 3 ? "帮助与关于" : root.settings-tab == 4 ? "通用偏好" : "提示词包"; color: Theme.text; font-size: 18px; font-weight: 700; overflow: elide; } Text { height: 17px; text: "桌面端本地设置，保存在本机配置中"; color: Theme.muted; font-size: 11px; overflow: elide; } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.settings-tab == 0 : Action { icon: @image-url("../assets/icons/plus.svg"); label: "添加模型"; show-label: true; primary: true; enabled: !root.loading && !root.saving; clicked => { root.create-model(); } }
                }
                Rectangle { height: 1px; background: Theme.border; }
                    if root.settings-tab == 1 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 14px; alignment: start;
                            Text { height: 28px; text: "本地运行时"; font-size: 18px; font-weight: 700; color: Theme.text; }
                            FormField { label: "工作目录"; text <=> root.workspace-root; read-only: root.saving || root.loading; }
                            FormField { label: "运行时语言"; placeholder: "zh-CN 或 en-US"; text <=> root.language; read-only: root.saving || root.loading; }
                            Text { text: "更改工作目录后会使用新的文件根目录，原目录的文件不会自动迁移。"; color: Theme.muted; wrap: word-wrap; }
                            Action { label: root.saving ? "保存中" : "保存设置"; show-label: true; primary: true; enabled: !root.saving && !root.loading; clicked => { root.save-runtime(root.workspace-root, root.language); } }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { height: 24px; text: "内网通信"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { height: 18px; text: root.lan-enabled ? "已启用节点发现" : "未启用节点发现"; color: root.lan-enabled ? #16845d : Theme.muted; font-size: 12px; }
                            FormField { label: "节点名称"; placeholder: "本机在内网中的显示名称"; text <=> root.lan-name; read-only: root.saving || root.loading; }
                            Text { height: 18px; text: "节点 ID：" + root.lan-peer-id; color: Theme.muted; font-size: 11px; overflow: elide; }
                            Text { height: 18px; text: "监听：" + root.lan-endpoint + "  ·  已发现 " + root.lan-peer-count + " 个节点"; color: Theme.muted; font-size: 11px; overflow: elide; }
                            ScrollView { height: 84px; horizontal-scrollbar-policy: always-off; VerticalLayout { alignment: start; spacing: 3px; for peer in root.lan-peers : Rectangle { height: 24px; border-radius: 5px; background: Theme.accent-soft; Text { x: 8px; width: parent.width - 16px; height: parent.height; text: peer.display-name + "  ·  " + peer.address; color: Theme.text; font-size: 10px; vertical-alignment: center; overflow: elide; } } if root.lan-peer-count == 0 : Text { height: 20px; text: "暂无已发现节点"; color: Theme.muted; font-size: 10px; } } }
                            Action { label: root.lan-enabled ? "停用内网通信" : "启用内网通信"; show-label: true; primary: root.lan-enabled; enabled: !root.saving && !root.loading; clicked => { root.save-lan(!root.lan-enabled, root.lan-name); } }
                        }
                    }
                    if root.settings-tab == 0 : HorizontalLayout { vertical-stretch: 1; padding: 8px; spacing: 14px;
                        Rectangle { width: 220px; border-radius: 10px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 12px; spacing: 10px;
                                HorizontalLayout { height: 25px; Text { text: "模型配置"; color: Theme.text; font-size: 13px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; label: "刷新"; clicked => { root.refresh(); } } }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 5px;
                                        for model[index] in root.models : Rectangle { height: 62px; border-radius: 9px; background: root.selected-model == index ? Theme.accent-soft : transparent;
                                            Action { width: parent.width; height: parent.height; label: model.key; clicked => { root.select-model(index); } }
                                            Image { x: 9px; y: 15px; width: 18px; height: 18px; source: @image-url("../assets/icons/robot.svg"); colorize: Theme.accent-deep; }
                                            Text { x: 38px; y: 9px; width: parent.width - 46px; height: 18px; text: model.key + (model.is-default ? "  · 默认" : ""); color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
                                            Text { x: 38px; y: 31px; width: parent.width - 46px; height: 16px; text: model.model-type + " · " + model.model; color: Theme.muted; font-size: 10px; overflow: elide; }
                                        }
                                        if root.models.length == 0 : Text { height: 48px; text: root.loading ? "正在加载模型…" : "尚未配置模型"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: 10px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 18px; spacing: 13px;
                                Text { height: 26px; text: root.selected-key == "" ? "模型配置" : root.selected-key; color: Theme.text; font-size: 18px; font-weight: 700; overflow: elide; }
                                Rectangle { border-radius: 9px; background: Theme.accent-soft; height: 52px; Text { x: 13px; width: parent.width - 26px; height: parent.height; text: "工作目录：" + (root.workspace-root == "" ? "正在读取…" : root.workspace-root); color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; } }
                                Text { height: 18px; text: root.selected-key == "" ? "选择左侧模型查看配置" : (root.selected-type + " · " + root.selected-provider); color: Theme.muted; font-size: 12px; }
                                Text { height: 18px; text: root.selected-key == "" ? "" : ("模型：" + root.selected-model-name); color: Theme.muted; font-size: 12px; }
                                Text { height: 18px; text: root.selected-key == "" ? "" : ("地址：" + root.selected-base-url); color: Theme.muted; font-size: 12px; overflow: elide; }
                                HorizontalLayout { height: 32px; spacing: 8px; Action { width: 92px; icon: @image-url("../assets/icons/gear.svg"); label: "编辑模型"; show-label: true; enabled: !root.loading && !root.saving && root.selected-key != ""; clicked => { root.edit-model(); } } Action { width: 94px; icon: @image-url("../assets/icons/check.svg"); label: root.selected-is-default ? "当前默认" : "设为默认"; show-label: true; primary: !root.selected-is-default; enabled: !root.loading && !root.saving && root.selected-key != "" && !root.selected-is-default; clicked => { root.set-default-model(root.selected-key); } } }
                                Text { text: "模型配置保存在本机，修改后在新任务中生效。"; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; }
                                Text { height: 18px; text: "" + root.models.length + " 个模型条目"; color: Theme.muted; font-size: 11px; }
                            }
                        }
                    }
                    if root.settings-tab == 2 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 12px;
                            Text { height: 28px; text: "工具与技能"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            Text { text: "工具目录和技能能力已在工具页面统一展示。"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 3 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
                            Text { height: 28px; text: "帮助与关于"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            Text { text: "桌面端使用本地原生运行时，不经本机 HTTP/WebSocket，不拉起 bridge 子进程。"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Text { height: 22px; text: "诊断"; color: Theme.text; font-size: 14px; font-weight: 600; }
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Action { width: 110px; label: "导出诊断信息"; show-label: true; enabled: !root.loading; clicked => { root.export-diagnostics(); } }
                                Text { height: 30px; text: "导出密钥无关的本机设置与能力计数，便于问题排查。"; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            Text { height: 22px; text: "重置工作状态"; color: #b63a22; font-size: 14px; font-weight: 600; }
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Action { width: 110px; label: "重置工作状态"; show-label: true; enabled: !root.loading && !root.saving; clicked => { root.reset-confirm-open = true; } }
                                Text { height: 30px; text: "清理运行状态、队列与临时投影；保留资产、配置、文件与历史。"; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 4 : Rectangle { vertical-stretch: 1;
                        VerticalLayout { padding: 24px; spacing: 14px; alignment: start;
                            Text { height: 28px; text: "通用偏好"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            HorizontalLayout { height: 30px; spacing: 10px; Text { width: 84px; text: "主题"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                ComboBox { width: 180px; model: ["浅色（蜂巢基调）"]; current-index: 0; enabled: false; } }
                            HorizontalLayout { height: 30px; spacing: 10px; Text { width: 84px; text: "发送键"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                ComboBox { width: 180px; model: ["Enter 发送", "Ctrl+Enter 发送"]; current-index: root.send-key == "ctrl_enter" ? 1 : 0; enabled: true; selected(index) => { root.send-key = index == 1 ? "ctrl_enter" : "enter"; } }
                                Text { text: root.send-key == "ctrl_enter" ? "Enter 换行，Ctrl+Enter 发送" : "Enter 直接发送"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                            Action { width: 110px; label: root.saving ? "保存中" : "保存偏好"; show-label: true; primary: true; enabled: !root.saving && !root.loading; clicked => { root.save-preferences(); } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    if root.settings-tab == 5 : HorizontalLayout { vertical-stretch: 1; padding: 8px; spacing: 14px;
                        Rectangle { width: 240px; border-radius: 10px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 12px; spacing: 8px;
                                HorizontalLayout { height: 24px; Text { text: "提示词包"; color: Theme.text; font-size: 13px; font-weight: 600; } Rectangle { horizontal-stretch: 1; } Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: "刷新"; enabled: !root.prompt-loading; clicked => { root.refresh-prompt-packs(); } } }
                                ScrollView { vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start; spacing: 4px;
                                        for pack in root.prompt-packs : Rectangle { height: 52px; border-radius: 8px; background: root.selected-pack == pack.id ? Theme.accent-soft : transparent;
                                            Action { width: parent.width; height: parent.height; label: pack.id; enabled: !root.prompt-loading; clicked => { root.select-prompt-pack(pack.id); } }
                                            Text { x: 10px; y: 6px; width: parent.width - 20px; height: 17px; text: pack.id + (pack.is-active ? "  · 当前" : ""); color: Theme.text; font-size: 11px; font-weight: 600; overflow: elide; }
                                            Text { x: 10px; y: 26px; width: parent.width - 20px; height: 15px; text: pack.readonly ? "内置只读" : (pack.locale == "" ? "自定义" : "内置语言包"); color: Theme.muted; font-size: 9px; overflow: elide; }
                                        }
                                        if root.prompt-packs.length == 0 : Text { height: 48px; text: root.prompt-loading ? "正在加载…" : "暂无提示词包"; color: Theme.muted; horizontal-alignment: center; }
                                    }
                                }
                                HorizontalLayout { height: 30px; spacing: 6px; TextInput { horizontal-stretch: 1; text <=> root.pack-name-draft; color: Theme.text; font-size: 11px; } Action { width: 44px; label: "新建"; show-label: true; enabled: !root.prompt-loading && root.pack-name-draft != ""; clicked => { root.create-prompt-pack(); } } }
                                Action { height: 30px; label: "删除当前自定义包"; show-label: true; enabled: !root.prompt-loading && root.selected-pack != "" && !root.prompt-readonly; clicked => { root.delete-prompt-pack(); } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: 10px; background: Theme.panel; border-width: 1px; border-color: Theme.border;
                            VerticalLayout { padding: 18px; spacing: 10px;
                                HorizontalLayout { height: 26px; Text { text: root.selected-pack == "" ? "分段编辑" : "分段编辑 · " + root.selected-pack; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; } Rectangle { horizontal-stretch: 1; } Text { text: root.prompt-readonly ? "只读（内置包）" : "可编辑"; color: root.prompt-readonly ? Theme.muted : #16845d; font-size: 11px; vertical-alignment: center; } }
                                ScrollView { height: 34px; vertical-scrollbar-policy: always-off; horizontal-scrollbar-policy: as-needed;
                                    HorizontalLayout { spacing: 6px;
                                        for segment[index] in [{key: "role", label: "角色"}, {key: "engineering", label: "工程"}, {key: "tools_protocol", label: "工具协议"}, {key: "skills_protocol", label: "技能协议"}, {key: "memory", label: "记忆"}, {key: "extra", label: "附加"}] : Action { width: 92px; label: segment.label; show-label: true; enabled: root.selected-pack != ""; selected: root.selected-segment == index; clicked => { root.selected-segment = index; root.select-prompt-pack(root.selected-pack); } } }
                                }
                                TextEditBase { vertical-stretch: 1; text <=> root.prompt-draft; read-only: root.prompt-readonly || root.prompt-loading; wrap: word-wrap; foreground: Theme.text; font-size: 12px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 8px; }
                                HorizontalLayout { height: 32px; Rectangle { horizontal-stretch: 1; } Action { width: 96px; label: "保存分段"; show-label: true; primary: true; enabled: !root.prompt-readonly && !root.prompt-loading && root.selected-pack != ""; clicked => { root.save-prompt-segment(); } } }
                            }
                        }
                    }
                }
            }
        }
}
