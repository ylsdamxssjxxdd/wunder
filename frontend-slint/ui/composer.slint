import { I18n } from "i18n.slint";
import { Theme, ChatAttachment, ModelCard, PlanStep, InquiryQuestion, QueueTurn, DraftRecall } from "theme.slint";
import { Action, TerminalAction } from "components.slint";
import { TextEditBase } from "textedit-base.slint";
import { DragPreview } from "drag_row.slint";

// Slint has neither top-level functions nor module-level constants, so the
// reasoning ladder lives in a global. Model search deliberately does *not* live
// here: Slint 1.18 strings offer only is-empty/to-lowercase/starts-with/
// ends-with/replace-all, with no substring test, so filtering is projected from
// Rust and the popover only renders what it is handed.
export global EffortOptions {
    out property <[{ value: string, label: string }]> all: [
        { value: "default", label: I18n.cp_effort_default },
        { value: "none", label: I18n.cp_effort_none },
        { value: "minimal", label: I18n.cp_effort_minimal },
        { value: "low", label: I18n.cp_effort_low },
        { value: "medium", label: I18n.cp_effort_medium },
        { value: "high", label: I18n.cp_effort_high },
        { value: "xhigh", label: I18n.cp_effort_xhigh }
    ];
    // Short label for a reasoning-effort value; the picker shows it next to the
    // model name so the active strength reads without opening the popover (§8.3).
    public pure function short(value: string) -> string {
        return value == "none" ? I18n.cp_effort_short_none
            : value == "minimal" ? I18n.cp_effort_short_minimal
            : value == "low" ? I18n.cp_effort_short_low
            : value == "medium" ? I18n.cp_effort_short_medium
            : value == "high" ? I18n.cp_effort_short_high
            : value == "xhigh" ? I18n.cp_effort_short_xhigh
            : I18n.cp_effort_short_default;
    }
}

// §8.3 model switcher: a trigger in the toolbar plus a popover that sits above
// the input box. Selection applies to the active thread immediately through the
// existing set-default-model / reasoning-effort callbacks.
component ModelPicker inherits Rectangle {
    in property <[ModelCard]> models: [];
    // True while the catalogue itself is non-empty; `models` is the *filtered*
    // view, so an empty result must not be mistaken for "no models configured".
    in property <bool> has-catalogue: false;
    in property <string> current-name: "";
    // Index of the model the thread currently uses, or -1. Computed by the
    // settings projection: Slint functions cannot scan a model.
    in property <int> active-index: -1;
    in property <string> current-key: "";
    // Cloud session is usable: signed in and not expired (§4.3.5). Cloud
    // entries grey out and refuse selection while this is false.
    in property <bool> cloud-ready: true;
    in-out property <string> effort: "default";
    in property <bool> saving: false;
    callback select-model(int, string);
    callback set-default-model(string);
    callback effort-changed(string);
    callback open-settings();
    // Slint cannot test a substring, so the query is projected out and the
    // filtered catalogue comes back in `models`.
    callback search-models(string);
    in-out property <bool> open: false;
    private property <string> query: "";
    changed query => { root.search-models(root.query); }
    height: 30px;

    trigger := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: Theme.radius-sm;
        background: trigger-touch.has-hover || root.open ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: I18n.cp_model_pick;
        accessible-action-default => { root.open = !root.open; }
        Image {
            x: 8px; y: 7px; width: 16px; height: 16px;
            source: @image-url("../assets/icons/robot.svg");
            colorize: root.has-catalogue ? Theme.muted : Theme.border-strong;
            image-fit: contain;
        }
        Text {
            x: 30px; y: 0px; height: parent.height;
            width: trigger-label.preferred-width;
            text: root.has-catalogue ? (root.current-name != "" ? root.current-name : I18n.cp_model_none) : I18n.cp_model_none;
            color: root.has-catalogue ? Theme.text : Theme.muted;
            font-size: Theme.font-md; font-weight: 600;
            vertical-alignment: center; overflow: elide;
        }
        trigger-label := Text { text: root.current-name; font-size: Theme.font-md; font-weight: 600; visible: false; }
        Text {
            x: 36px + trigger-label.preferred-width; y: 0px; height: parent.height;
            text: EffortOptions.short(root.effort);
            color: Theme.muted; font-size: Theme.font-xs;
            vertical-alignment: center;
            visible: root.has-catalogue;
        }
        Image {
            x: parent.width - 16px; y: 10px; width: 10px; height: 10px;
            source: @image-url("../assets/icons/chevron-down.svg");
            colorize: Theme.muted; image-fit: contain;
        }
    }
    trigger-touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }

    // The popover is anchored to the trigger but drawn upward, which is why it
    // carries a negative y: it must clear the input box above the toolbar.
    if root.open : Rectangle {
        x: parent.width - 300px; y: -352px; width: 300px; height: 342px;
        z: 30; border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 10px; spacing: 8px;
            // Search field.
            Rectangle {
                height: 30px; border-radius: Theme.radius-sm;
                background: Theme.panel; border-width: 1px; border-color: Theme.border;
                Image {
                    x: 8px; y: 8px; width: 13px; height: 13px;
                    source: @image-url("../assets/icons/magnifying-glass.svg");
                    colorize: Theme.muted; image-fit: contain;
                }
                search := TextInput {
                    x: 28px; y: 0px; width: parent.width - 36px; height: parent.height;
                    text <=> root.query;
                    single-line: true;
                    font-size: Theme.font-md; color: Theme.text;
                    vertical-alignment: center;
                }
                if root.query == "" : Text {
                    x: 28px; y: 0px; width: parent.width - 36px; height: parent.height;
                    text: I18n.cp_model_search; color: Theme.muted; font-size: Theme.font-md;
                    vertical-alignment: center;
                }
            }
            // An empty result under a live query is not "no models configured",
            // which is why this tests the model count rather than the catalogue
            // flag alone.
            if !root.has-catalogue || root.models.length == 0 : Rectangle {
                vertical-stretch: 1; border-radius: Theme.radius-sm; background: Theme.panel;
                VerticalLayout {
                    alignment: center; padding: 16px; spacing: 10px;
                    Text {
                        text: root.query != "" ? I18n.cp_model_no_match : I18n.cp_model_empty;
                        color: Theme.muted; font-size: Theme.font-sm;
                        horizontal-alignment: center; wrap: word-wrap;
                    }
                    if !root.has-catalogue : Rectangle {
                        width: 132px; height: 28px; border-radius: Theme.radius-sm;
                        background: empty-touch.has-hover ? Theme.accent-soft : Theme.surface;
                        border-width: 1px; border-color: Theme.border;
                        Text { width: parent.width; height: parent.height; text: I18n.cp_model_settings; color: Theme.accent; font-size: Theme.font-sm; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        empty-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open = false; root.open-settings(); } }
                    }
                }
            }
            if root.has-catalogue && root.models.length > 0 : Rectangle {
                vertical-stretch: 1; clip: true;
                VerticalLayout {
                    alignment: start; spacing: 0px;
                    for model[index] in root.models : Rectangle {
                        height: 38px; border-radius: Theme.radius-sm;
                        background: row-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: model.model;
                        // Cloud entries (`cloud/<id>`) stay listed while signed
                        // out or expired, but grey out and stay unselectable
                        // until the session returns.
                        property <bool> cloud-muted: model.is-cloud && !root.cloud-ready;
                        accessible-action-default => { if !cloud-muted { root.select-model(index, model.key); root.open = false; } }
                        Image {
                            x: 10px; y: 11px; width: 16px; height: 16px;
                            source: @image-url("../assets/icons/robot.svg");
                            colorize: cloud-muted ? Theme.border : (model.key == root.current-key ? Theme.accent : Theme.muted);
                            image-fit: contain;
                        }
                        Text {
                            x: 34px; y: 4px; width: parent.width - 74px; height: 17px;
                            text: model.model != "" ? model.model : model.key;
                            color: cloud-muted ? Theme.muted : Theme.text; font-size: Theme.font-md; font-weight: 600;
                            vertical-alignment: center; overflow: elide;
                        }
                        Text {
                            x: 34px; y: 21px; width: parent.width - 74px; height: 15px;
                            text: cloud-muted ? I18n.st_cl_login_needed : model.provider + (model.model-type != "" ? " · " + model.model-type : "");
                            color: Theme.muted; font-size: Theme.font-xs;
                            vertical-alignment: center; overflow: elide;
                        }
                        if model.is-default : Rectangle {
                            x: parent.width - 74px; y: 11px; width: 34px; height: 16px;
                            border-radius: 8px; background: Theme.accent-soft;
                            Text { width: parent.width; height: parent.height; text: I18n.cp_model_default_tag; color: Theme.accent; font-size: Theme.font-2xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        // A cloud model is never the default (the engine keeps
                        // the default pinned to a local entry), so the badge
                        // reuses the default-tag slot.
                        if model.is-cloud : Rectangle {
                            x: parent.width - 74px; y: 11px; width: 24px; height: 16px;
                            border-radius: 8px; background: Theme.accent-soft;
                            Text { width: parent.width; height: parent.height; text: I18n.st_cl_badge; color: Theme.accent; font-size: Theme.font-2xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if model.key == root.current-key : Image {
                            x: parent.width - 30px; y: 11px; width: 16px; height: 16px;
                            source: @image-url("../assets/icons/check.svg");
                            colorize: Theme.accent; image-fit: contain;
                        }
                        row-touch := TouchArea {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            enabled: !cloud-muted;
                            mouse-cursor: cloud-muted ? MouseCursor.default : MouseCursor.pointer;
                            clicked => { root.select-model(index, model.key); root.open = false; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Text { height: 16px; text: I18n.cp_model_effort; color: Theme.muted; font-size: Theme.font-xs; font-weight: 700; vertical-alignment: center; }
            HorizontalLayout {
                height: 30px; spacing: 4px;
                for option in EffortOptions.all : Rectangle {
                    horizontal-stretch: 1; min-width: 0px;
                    border-radius: Theme.radius-sm;
                    background: root.effort == option.value ? Theme.accent-soft : effort-touch.has-hover ? Theme.hover : Theme.panel;
                    border-width: 1px;
                    border-color: root.effort == option.value ? Theme.accent : Theme.border;
                    accessible-role: button;
                    accessible-label: option.label;
                    accessible-action-default => { root.effort = option.value; root.effort-changed(option.value); }
                    Text {
                        width: parent.width; height: parent.height;
                        text: EffortOptions.short(option.value);
                        color: root.effort == option.value ? Theme.accent : Theme.text-secondary;
                        font-size: Theme.font-sm; font-weight: root.effort == option.value ? 700 : 400;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    effort-touch := TouchArea { mouse-cursor: pointer; clicked => { root.effort = option.value; root.effort-changed(option.value); } }
                }
            }
        }
    }
}

// The brain glyph doubles as the context-usage gauge (§8.5): the filled part
// rises with the used share of the window.
export component ContextUsageIcon inherits Rectangle {
    in property <float> usage: 0.0;
    in property <bool> known: false;
    in property <string> counts;
    in-out property <bool> open: false;
    width: 24px; height: 30px;
    accessible-role: button;
    accessible-label: I18n.cp_context_usage;
    accessible-action-default => { root.open = !root.open; }
    private property <color> usage-color: root.usage >= 0.9 ? Theme.danger : root.usage >= 0.75 ? Theme.warning : Theme.accent;
    Image {
        x: 3px; y: 6px; width: 18px; height: 18px;
        source: @image-url("../assets/icons/brain.svg"); colorize: Theme.muted;
    }
    Rectangle {
        x: 3px; y: 24px - 18px * root.usage;
        width: 18px; height: 18px * root.usage; clip: true;
        Image {
            y: -18px * (1.0 - root.usage); width: 18px; height: 18px;
            source: @image-url("../assets/icons/brain.svg"); colorize: root.usage-color;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    // Activate the hover bridge only while visible; it must never eat editor input.
    panel-hover := TouchArea {
        x: -202px; y: -306px; width: 226px; height: 310px;
        enabled: root.open || touch.has-hover || self.has-hover;
    }
    if root.open || touch.has-hover || panel-hover.has-hover : Rectangle {
        x: -202px; y: -216px; width: 226px; height: 208px;
        z: 20; border-radius: 10px; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 8px; spacing: 0px;
            HorizontalLayout {
                height: 24px; padding-left: 8px; padding-right: 8px;
                Text { text: I18n.cp_context_usage; color: Theme.muted; font-size: 11px; font-weight: 700; }
                Text { text: root.known ? round(root.usage * 100.0) + "%" : "—"; color: root.usage-color; font-size: 12px; font-weight: 700; horizontal-alignment: right; }
            }
            Text { height: 24px; text: root.counts != "" ? root.counts : I18n.cp_usage_empty; color: Theme.muted; font-size: 11px; }
            Rectangle { height: 1px; background: Theme.border; }
            Text { height: 32px; text: I18n.cp_thinking_level; color: Theme.muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            Text { height: 100px; text: I18n.cp_usage_effort_hint; color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; vertical-alignment: top; }
        }
    }
}

// One icon control of the goal banner; hover tints it toward the danger tone
// so the three controls read as a group without stealing focus from the text.
component GoalTool inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    callback clicked;
    width: 24px; height: 24px;
    border-radius: 6px;
    background: hit.has-hover ? #FFFFFFB0 : transparent;
    Image {
        x: 5px; y: 5px; width: 14px; height: 14px;
        source: root.icon;
        colorize: hit.has-hover ? Theme.danger : Theme.muted;
        image-fit: contain;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.tip;
}

// Six-dot spinner for the status dock; the software renderer has no
// transform-rotate, so the dot ring is rotated mathematically with the web's
// 1.48s period (same approach as RuntimeBadge, tint parameterized).
component DockSpinner inherits Rectangle {
    in property <color> tint: Theme.accent;
    width: 12px; height: 12px;
    private property <angle> phase: mod(animation-tick(), 1480ms) / 1480ms * 360deg;
    for offset in [{x: 0.0, y: -4.1}, {x: 3.55, y: -2.05}, {x: 3.55, y: 2.05}, {x: 0.0, y: 4.1}, {x: -3.55, y: 2.05}, {x: -3.55, y: -2.05}] : Rectangle {
        x: (parent.width - 3.4px) / 2 + (offset.x * cos(root.phase) - offset.y * sin(root.phase)) * 1px;
        y: (parent.height - 3.4px) / 2 + (offset.x * sin(root.phase) + offset.y * cos(root.phase)) * 1px;
        width: 3.4px; height: 3.4px; border-radius: 1.7px; background: root.tint;
    }
}

// §StatusDock: the plan capsule above the goal banner. It exists only while the
// 计划面板 tool has published steps — the turn's phase text (thinking / tools /
// generating) already reads on the timeline rows, so repeating it here would
// just duplicate what the user sees above. The checklist card sits over the
// timeline via negative y, the same layering trick the composer popovers use,
// and stays up for as long as the plan does.
export component StatusDock inherits Rectangle {
    in property <bool> running: false;
    in property <int> steps-done: 0;
    in property <int> steps-total: 0;
    in property <string> plan-explanation: "";
    in property <[PlanStep]> plan-steps: [];
    callback plan-dismiss();
    // The plan tool bounds a plan at 12 steps, so the card never needs a
    // collapse budget: every row is shown and the height is exact.
    out property <length> card-height: 30px
        + (root.plan-explanation != "" ? 34px : 0px)
        + root.plan-steps.length * 24px;
    height: 28px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            // Sized by the centering layout from its own content.
            height: 26px;
            border-radius: 13px;
            background: Theme.surface;
            border-width: 1px; border-color: Theme.border;
            drop-shadow-color: #00000018; drop-shadow-blur: 8px; drop-shadow-offset-y: 2px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 6px;
                if root.running : DockSpinner { y: (parent.height - self.height) / 2; }
                Text {
                    height: parent.height;
                    text: I18n.dock_steps + " " + root.steps-done + " / " + root.steps-total;
                    color: Theme.text-secondary; font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
        }
    }
    Rectangle {
        width: 420px; height: root.card-height;
        x: (parent.width - self.width) / 2;
        y: -self.height - 8px;
        z: 30;
        border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
        clip: true;
        VerticalLayout {
            padding: 8px; spacing: 4px;
            if root.plan-explanation != "" : Text {
                height: 32px;
                text: root.plan-explanation;
                color: Theme.muted; font-size: Theme.font-xs;
                wrap: word-wrap; overflow: elide; vertical-alignment: top;
            }
            VerticalLayout {
                alignment: start; spacing: 0px;
                for step in root.plan-steps : Rectangle {
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: step-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 10px;
                        // Thin-ring tri-state: the ring carries the status color
                        // and only the active states get a glyph, matching the
                        // web client's inline-svg markers.
                        Rectangle {
                            y: 4px; width: 16px; height: 16px; border-radius: 8px;
                            border-width: 1.5px;
                            border-color: step.status == "completed" ? Theme.success
                                : step.status == "in_progress" ? Theme.warning
                                : Theme.border-strong;
                            if step.status == "completed" : Image {
                                x: 3px; y: 5px; width: 10px; height: 6px;
                                source: @image-url("../assets/icons/status-check.svg");
                                colorize: Theme.success; image-fit: contain;
                            }
                            if step.status == "in_progress" : Image {
                                x: 4px; y: 3px; width: 8px; height: 10px;
                                source: @image-url("../assets/icons/status-pause.svg");
                                colorize: Theme.warning; image-fit: contain;
                            }
                        }
                        Text {
                            height: parent.height;
                            text: step.step;
                            color: step.status == "in_progress" ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center; overflow: elide;
                        }
                    }
                    step-touch := TouchArea {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                    }
                }
            }
        }
        // Dismiss stays reachable but quiet: the card has no header row, so the
        // close affordance floats in its corner and only answers the pointer.
        Rectangle {
            width: 22px; height: 22px;
            x: parent.width - self.width - 6px; y: 6px;
            z: 2;
            border-radius: 6px;
            background: close-touch.has-hover ? Theme.hover : transparent;
            Image {
                x: 4px; y: 4px; width: 14px; height: 14px;
                source: @image-url("../assets/icons/xmark.svg");
                colorize: close-touch.has-hover ? Theme.danger : Theme.muted;
                image-fit: contain;
            }
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.plan-dismiss(); }
            }
        }
    }
}

// §InquiryPanel: the 问询面板 card above the composer. One question per page
// with a ‹ N/M › pager, option rows (square marks for multi-select, round for
// single), a 推荐 badge, the option's own description on the same line, and a
// free-text row with a 无偏好 shortcut. Selection state lives in Rust: every
// click republishes the page, and the answer goes out with the composer's send
// button (same gesture as the web client) rather than a second submit control.
export component InquiryPanel inherits Rectangle {
    in property <InquiryQuestion> question;
    in property <int> page: 0;
    in property <int> total: 1;
    in-out property <string> other;
    callback option-clicked(int);
    callback no-preference();
    callback page-move(int);
    callback dismiss();
    // Full width comes from the mounting layout; a component root cannot read
    // `parent`.
    height: card.height;
    card := Rectangle {
        width: min(560px, parent.width);
        height: card-body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height;
        border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-color: #0000001f; drop-shadow-blur: 14px; drop-shadow-offset-y: 3px;
        clip: true;
        card-body := VerticalLayout {
            padding-left: 16px; padding-right: 12px; padding-top: 12px; padding-bottom: 10px;
            spacing: 2px;
            HorizontalLayout {
                height: max(24px, head-text.preferred-height);
                spacing: 8px;
                head-text := Text {
                    horizontal-stretch: 1;
                    text: root.question.question;
                    color: Theme.text; font-size: Theme.font-md; font-weight: 700;
                    wrap: word-wrap; vertical-alignment: top;
                }
                if root.total > 1 : Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: prev-touch.has-hover && root.page > 0 ? Theme.hover : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/chevron-left.svg");
                        colorize: root.page > 0 ? Theme.text-secondary : Theme.border-strong;
                        image-fit: contain;
                    }
                    prev-touch := TouchArea {
                        mouse-cursor: root.page > 0 ? MouseCursor.pointer : MouseCursor.default;
                        enabled: root.page > 0;
                        clicked => { root.page-move(-1); }
                    }
                }
                if root.total > 1 : Text {
                    width: 40px; height: max(24px, self.preferred-height);
                    text: (root.page + 1) + " / " + root.total;
                    color: Theme.text-secondary; font-size: Theme.font-xs;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                if root.total > 1 : Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: next-touch.has-hover ? Theme.hover : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/chevron-right.svg");
                        colorize: root.page < root.total - 1 ? Theme.text-secondary : Theme.border-strong;
                        image-fit: contain;
                    }
                    next-touch := TouchArea {
                        mouse-cursor: pointer;
                        enabled: root.page < root.total - 1;
                        clicked => { root.page-move(1); }
                    }
                }
                Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: dismiss-touch.has-hover ? Theme.hover : transparent;
                    Image {
                        x: 5px; y: 5px; width: 14px; height: 14px;
                        source: @image-url("../assets/icons/xmark.svg");
                        colorize: dismiss-touch.has-hover ? Theme.danger : Theme.muted;
                        image-fit: contain;
                    }
                    dismiss-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismiss(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 0px;
                for option[index] in root.question.options : Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: option-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 10px;
                        Rectangle {
                            width: 18px;
                            Rectangle {
                                x: 0px; y: (parent.height - self.height) / 2;
                                width: 18px; height: 18px;
                                border-radius: root.question.multiple ? 5px : 9px;
                                border-width: 1.5px;
                                border-color: option.selected ? Theme.accent : Theme.border-strong;
                                background: option.selected ? Theme.accent : Theme.surface;
                                Image {
                                    x: 4px; y: 6px; width: 10px; height: 7px;
                                    source: @image-url("../assets/icons/status-check.svg");
                                    colorize: Theme.surface; image-fit: contain;
                                    visible: option.selected;
                                }
                            }
                        }
                        Text {
                            height: parent.height;
                            text: option.label;
                            color: option.selected ? Theme.accent-deep : Theme.text;
                            font-size: Theme.font-sm; font-weight: 600;
                            vertical-alignment: center; overflow: elide;
                        }
                        if option.recommended : Rectangle {
                            width: badge-text.preferred-width + 16px;
                            height: 18px; y: (parent.height - self.height) / 2;
                            border-radius: 9px; background: Theme.hover;
                            badge-text := Text {
                                x: 8px; width: self.preferred-width; height: parent.height;
                                text: I18n.inquiry_recommended;
                                color: Theme.muted; font-size: Theme.font-2xs;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            height: parent.height; horizontal-stretch: 1;
                            text: option.description;
                            color: Theme.muted; font-size: Theme.font-xs;
                            vertical-alignment: center; overflow: elide;
                        }
                    }
                    // The row itself is the hit area; the mark is decoration.
                    option-touch := TouchArea {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.option-clicked(index); }
                    }
                }
            }
            HorizontalLayout {
                height: 32px;
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Rectangle {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: 18px; height: 18px;
                        border-radius: root.question.multiple ? 5px : 9px;
                        border-width: 1.5px;
                        border-color: root.other != "" ? Theme.accent : Theme.border-strong;
                        background: root.other != "" ? Theme.accent : Theme.surface;
                        Image {
                            x: 4px; y: 6px; width: 10px; height: 7px;
                            source: @image-url("../assets/icons/status-check.svg");
                            colorize: Theme.surface; image-fit: contain;
                            visible: root.other != "";
                        }
                    }
                }
                // Raw Slint TextInput has no placeholder of its own, and the
                // std LineEdit would restyle the row; the hint is a plain Text
                // overlay (Text has no input path, so typing stays unaffected).
                Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;
                    TextInput {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        text <=> root.other;
                        color: Theme.text; font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 1px; y: 0px; width: parent.width; height: parent.height;
                        text: I18n.inquiry_other_placeholder;
                        color: Theme.muted; font-size: Theme.font-sm;
                        vertical-alignment: center;
                        visible: root.other == "";
                    }
                    Rectangle {
                        y: parent.height - 1px; width: parent.width; height: 1px;
                        background: Theme.border-strong;
                    }
                }
                Rectangle {
                    width: pref-text.preferred-width + 24px;
                    height: 26px; y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: root.question.no_preference ? Theme.accent-soft
                        : pref-touch.has-hover ? Theme.hover : Theme.panel;
                    pref-text := Text {
                        width: self.preferred-width; height: parent.height;
                        x: 12px;
                        text: I18n.inquiry_no_preference;
                        color: root.question.no_preference ? Theme.accent-deep : Theme.text-secondary;
                        font-size: Theme.font-sm; font-weight: 600;
                        vertical-alignment: center;
                    }
                    pref-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.no-preference(); }
                    }
                }
            }
            Text {
                height: 18px;
                text: I18n.inquiry_send_hint;
                color: Theme.muted; font-size: Theme.font-2xs;
                vertical-alignment: center;
            }
        }
    }
}

// §8.1b goal banner: one row above the composer once a session has a goal.
// It shows the objective, the accumulated active time and three controls;
// editing swaps the row for an inline input and Enter re-submits the goal.
export component GoalBanner inherits Rectangle {
    in property <string> objective;
    in property <string> elapsed;
    in property <bool> paused: false;
    in-out property <bool> editing: false;
    in-out property <string> edit-draft;
    callback save(string);
    callback pause-toggle();
    callback clear();
    height: 34px;
    background: Theme.danger-bg;
    if root.editing : Rectangle {
        width: 100%; height: 100%;
        init => { goal-input.focus(); }
        HorizontalLayout {
            padding-left: 16px; padding-right: 10px; spacing: 8px;
            Image {
                width: 14px; height: 14px;
                source: @image-url("../assets/icons/fa-bullseye.svg");
                colorize: Theme.danger; image-fit: contain;
            }
            goal-input := TextInput {
                height: parent.height;
                text <=> root.edit-draft;
                color: Theme.text; font-size: Theme.font-md;
                vertical-alignment: center;
                // Enter submits; an empty draft cancels the edit instead of
                // clearing the goal — clearing stays on the trash control.
                accepted => {
                    root.editing = false;
                    if self.text != "" {
                        root.save(self.text);
                    }
                }
            }
            Text {
                text: I18n.cp_goal_edit_hint;
                color: Theme.danger; opacity: 0.6; font-size: Theme.font-2xs;
                vertical-alignment: center;
            }
        }
    }
    if !root.editing : Rectangle {
        width: 100%; height: 100%;
        HorizontalLayout {
            padding-left: 16px; padding-right: 8px; spacing: 8px;
            Image {
                width: 14px; height: 14px;
                source: @image-url("../assets/icons/fa-bullseye.svg");
                colorize: Theme.danger; image-fit: contain;
            }
            Text {
                text: I18n.cp_goal_label; color: Theme.danger;
                font-size: Theme.font-md; font-weight: 700; vertical-alignment: center;
            }
            Text {
                text: "·"; color: Theme.danger; opacity: 0.55;
                font-size: Theme.font-md; vertical-alignment: center;
            }
            if root.paused : Text {
                text: I18n.cp_goal_paused_tag; color: Theme.warning;
                font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center;
            }
            if !root.paused : Text {
                text: root.elapsed; color: Theme.danger; opacity: 0.8;
                font-size: Theme.font-sm; vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1; min-width: 0px;
                text: root.objective; color: Theme.text-secondary;
                font-size: Theme.font-md; overflow: elide; vertical-alignment: center;
            }
            GoalTool {
                icon: @image-url("../assets/icons/pen.svg");
                tip: I18n.cp_goal_edit;
                clicked => { root.editing = true; root.edit-draft = root.objective; }
            }
            GoalTool {
                icon: root.paused
                    ? @image-url("../assets/icons/rotate-right.svg")
                    : @image-url("../assets/icons/status-pause.svg");
                tip: root.paused ? I18n.cp_goal_resume : I18n.cp_goal_pause;
                clicked => { root.pause-toggle(); }
            }
            GoalTool {
                icon: @image-url("../assets/icons/trash.svg");
                tip: I18n.cp_goal_clear;
                clicked => { root.clear(); }
            }
        }
    }
}

// One quiet icon control of a queue row; the tint stays neutral until the
// pointer is on it, and the caller decides whether the tone is danger.
component QueueTool inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <color> tint: Theme.muted;
    in property <color> active-tint: Theme.danger;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px; height: 24px;
    border-radius: 6px;
    background: root.enabled && hit.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: 5px; y: 5px; width: 14px; height: 14px;
        source: root.icon; image-fit: contain;
        colorize: root.enabled ? (hit.has-hover ? root.active-tint : root.tint) : Theme.border;
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// One parked turn. The grip on the left is the only drag handle, so a click on
// the text or on an action never turns into a reorder: the drag distance is
// measured from the grip's own geometry and a row move is only emitted on
// release past the 6px threshold (same contract as the sidebar rows).
component QueueRow inherits Rectangle {
    in property <QueueTurn> turn;
    callback interject(string);
    callback edit(string);
    callback remove(string);
    callback move-by(string, int);
    height: 28px;
    private property <length> drag-start: 0px;
    private property <bool> dragging: false;
    private property <bool> drop-before: DragPreview.active
        && DragPreview.source-y != root.absolute-position.y
        && DragPreview.pointer-y >= root.absolute-position.y
        && DragPreview.pointer-y < root.absolute-position.y + root.height / 2;
    private property <bool> drop-after: DragPreview.active
        && DragPreview.source-y != root.absolute-position.y
        && DragPreview.pointer-y >= root.absolute-position.y + root.height / 2
        && DragPreview.pointer-y < root.absolute-position.y + root.height;
    border-radius: Theme.radius-sm;
    background: root.dragging ? Theme.accent-soft : drop-before || drop-after ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.turn.text;

    grip := TouchArea {
        x: 0px; y: 0px; width: 22px; height: parent.height;
        mouse-cursor: root.dragging ? MouseCursor.move : MouseCursor.grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-start = self.mouse-y;
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = root.absolute-position.y;
                DragPreview.pointer-y = root.absolute-position.y + self.mouse-y;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if root.dragging {
                    root.move-by(root.turn.queue-id, round((self.mouse-y - root.drag-start) / root.height));
                }
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = -1px;
            }
            if event.kind == PointerEventKind.cancel {
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = -1px;
            }
        }
        moved => {
            DragPreview.pointer-y = root.absolute-position.y + self.mouse-y;
            if self.pressed && abs(self.mouse-y - root.drag-start) > 6px {
                root.dragging = true;
                DragPreview.active = true;
            }
        }
    }
    // Grip dots: no asset carries this glyph and six rects cost nothing.
    for dot in [{x: 6px, y: 8px}, {x: 12px, y: 8px}, {x: 6px, y: 13px}, {x: 12px, y: 13px}, {x: 6px, y: 18px}, {x: 12px, y: 18px}] : Rectangle {
        x: dot.x; y: dot.y; width: 3px; height: 3px;
        border-radius: 1.5px;
        background: grip.has-hover || root.dragging ? Theme.accent : Theme.border-strong;
    }

    HorizontalLayout {
        padding-left: 24px; padding-right: 2px; spacing: 8px;
        Text {
            horizontal-stretch: 1; min-width: 0px;
            height: parent.height;
            text: root.turn.text != "" ? root.turn.text : I18n.cp_queue_attachment_only;
            color: root.turn.text != "" ? Theme.text : Theme.muted;
            font-size: Theme.font-sm;
            vertical-alignment: center; overflow: elide;
        }
        if root.turn.attachments > 0 : Text {
            height: parent.height;
            text: I18n.cp_queue_attachments(root.turn.attachments);
            color: Theme.muted; font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
        Action {
            width: 76px; height: 24px; y: 2px;
            icon: @image-url("../assets/icons/arrow-up.svg");
            icon-size: 13px;
            label: root.turn.interjected ? I18n.cp_queue_interjected : I18n.cp_queue_interject;
            show-label: true;
            enabled: !root.turn.interjected;
            icon-color: root.turn.interjected ? Theme.border : Theme.accent;
            clicked => { root.interject(root.turn.queue-id); }
        }
        QueueTool {
            y: 2px;
            icon: @image-url("../assets/icons/pen.svg");
            tip: I18n.cp_queue_edit_hint;
            tint: Theme.muted;
            active-tint: Theme.text;
            clicked => { root.edit(root.turn.queue-id); }
        }
        QueueTool {
            y: 2px;
            icon: @image-url("../assets/icons/trash.svg");
            tip: I18n.cp_queue_remove_hint;
            clicked => { root.remove(root.turn.queue-id); }
        }
    }

    // Insertion seam, same affordance as the sidebar rows: a line at the edge
    // the dragged row would land against.
    if root.drop-before || root.drop-after : Rectangle {
        x: 2px;
        y: root.drop-after ? parent.height - 2px : 0px;
        width: parent.width - 4px;
        height: 2px;
        z: 100;
        background: Theme.accent;
        opacity: 0.96;
        animate y { duration: 110ms; easing: ease-out; }
    }
}

// §发送队列: the turns the engine parked for this thread while a run is in
// flight. Rust publishes at most `QueueStrip.max-rows` of them plus the count
// it left out, so the card height stays exact and never grows with the queue.
export component QueueStrip inherits Rectangle {
    in property <[QueueTurn]> turns: [];
    in property <int> overflow: 0;
    callback interject(string);
    callback edit(string);
    callback remove(string);
    callback move-by(string, int);
    height: card-body.preferred-height;
    frame := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        clip: true;
    }
    card-body := VerticalLayout {
        padding-left: 10px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
        spacing: 2px;
        HorizontalLayout {
            height: 20px; padding-left: 14px; spacing: 6px;
            Text { text: I18n.cp_queue_title; color: Theme.muted; font-size: Theme.font-2xs; font-weight: 700; vertical-alignment: center; }
            Text { text: "" + root.turns.length + (root.overflow > 0 ? "+" : ""); color: Theme.text-secondary; font-size: Theme.font-2xs; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: I18n.cp_queue_hint; color: Theme.border-strong; font-size: Theme.font-2xs; vertical-alignment: center; }
        }
        for turn in root.turns : QueueRow {
            turn: turn;
            interject(queue-id) => { root.interject(queue-id); }
            edit(queue-id) => { root.edit(queue-id); }
            remove(queue-id) => { root.remove(queue-id); }
            move-by(queue-id, delta) => { root.move-by(queue-id, delta); }
        }
        if root.overflow > 0 : Rectangle {
            height: 16px;
            Text {
                x: 14px; width: parent.width - 28px; height: parent.height;
                text: I18n.cp_queue_more(root.overflow);
                color: Theme.muted; font-size: Theme.font-2xs;
                vertical-alignment: center;
            }
        }
    }
}

export component Composer inherits Rectangle {
    in-out property <string> draft <=> editor.text;
    in property <bool> busy: false;
    // A live 问询面板 whose current page has an answer: the send button and the
    // send key then work with an empty draft, because the choices themselves
    // are the message.
    in property <bool> inquiry-ready: false;
    in property <bool> generating;
    in property <bool> stopping;
    in property <bool> recording: false;
    in property <bool> transcribing: false;
    in property <string> recording-elapsed: "";
    // Alternating phase from the capture clock; drives the breathing outline.
    in property <bool> recording-pulse: false;
    in property <float> context-usage: 0.0;
    in property <bool> context-known: false;
    in property <string> context-counts;
    in-out property <string> reasoning-effort: "default";
    callback reasoning-effort-changed(string);
    // §8.3: the toolbar owns the model switcher. The catalogue comes straight
    // from the settings projection, so the picker needs no separate fetch.
    in property <[ModelCard]> models: [];
    // Size of the unfiltered catalogue; distinguishes "search found nothing"
    // from "no models configured".
    in property <int> model-catalogue-count: 0;
    in property <string> model-name: "";
    // Key of the model the active thread uses; the popover marks it, and the
    // filtered list is matched by key because indices shift under search.
    in property <string> model-key: "";
    in property <bool> model-saving: false;
    // Cloud session usable (signed in, not expired); forwarded to the picker.
    in property <bool> cloud-ready: true;
    callback select-model(int, string);
    callback set-default-model(string);
    callback open-model-settings();
    callback search-models(string);
    in property <[ChatAttachment]> attachments: [];
    in property <string> send-key: "enter";
    // §8.5 status line under the box.
    in property <string> workspace-name: "";
    in property <string> branch-name: "";
    // §8.4 permission mode: a plain preference string, reported by the runtime
    // sheet; enforcement itself stays in the backend.
    // §8.4 permission mode, named after the runtime's `approval_mode` values
    // (full_auto / auto_edit / suggest) so the chip and the engine agree.
    in-out property <string> permission-mode: "full_auto";
    callback permission-changed(string);
    callback stop();
    callback send();
    callback remove-attachment(int);
    callback record-voice();
    callback command();
    // Terminal mode: Ctrl+C becomes an interrupt instead of copy.
    callback interrupt();
    // Terminal mode: the input routes to the local shell. The composer keeps
    // its visual language (and the send button), only the placeholder and
    // send semantics change; the backend decides where the text goes.
    in property <bool> terminal-mode: false;
    callback screenshot(bool, bool);
    // ---- 发送队列 (§发送队列) ----
    // Parked turns come straight from the engine's queue projection; the strip
    // never keeps its own copy, so a reorder or a withdraw that raced with a
    // feeder wake is corrected by the next publish.
    in property <[QueueTurn]> queue-turns: [];
    in property <int> queue-overflow: 0;
    callback queue-interject(string);
    callback queue-edit(string);
    callback queue-remove(string);
    callback queue-move-by(string, int);
    // ArrowUp/ArrowDown recall of already-sent messages. The decision needs the
    // caret's byte offsets, which only Rust can compare against the draft's byte
    // length, so the editor forwards them and takes back what Rust returns.
    callback recall-history(int, int, int, string) -> DraftRecall;
    private property <bool> queue-open: root.queue-turns.length > 0;
    // A running turn no longer swallows the send: the engine parks the turn and
    // the strip above the input shows it. What still blocks is a slash command
    // in flight or a thread that is still loading.
    private property <bool> send-blocked: root.busy && !root.generating;
    // Exact card height: 6+6 padding, a 20px header, 28px rows, the optional
    // overflow line and 2px between every item.
    private property <int> queue-items: root.queue-open
        ? 1 + root.queue-turns.length + (root.queue-overflow > 0 ? 1 : 0) : 0;
    private property <length> queue-height: root.queue-open
        ? 12px + 20px + root.queue-turns.length * 28px
            + (root.queue-overflow > 0 ? 16px : 0px) + (root.queue-items - 1) * 2px + 6px
        : 0px;
    height: (root.attachments.length > 0 ? 240px : 204px) + root.queue-height;
    private property <bool> preset-open: false;
    private property <bool> command-open: false;
    private property <bool> screenshot-open: false;
    private property <bool> model-open: false;
    private property <bool> permission-open: false;
    // Composer tool glyphs fill more of their 30px cell than the dense toolbar
    // default so capture/record/preset read at a uniform weight.
    private property <length> tool-icon-size: 17px;
    private property <string> permission-label: root.permission-mode == "auto_edit" ? I18n.cp_permission_write
        : root.permission-mode == "suggest" ? I18n.cp_permission_command
        : I18n.cp_permission_full;
    background: Theme.composer;
    Rectangle { y: 0px; height: 1px; background: Theme.border; }
    VerticalLayout {
        padding: 14px; padding-top: 8px; spacing: 6px;
        if root.queue-open : QueueStrip {
            turns: root.queue-turns;
            overflow: root.queue-overflow;
            interject(queue-id) => { root.queue-interject(queue-id); }
            edit(queue-id) => { root.queue-edit(queue-id); }
            remove(queue-id) => { root.queue-remove(queue-id); }
            move-by(queue-id, delta) => { root.queue-move-by(queue-id, delta); }
        }
        if root.attachments.length > 0 : HorizontalLayout {
            height: 30px; spacing: 6px;
            for attachment[index] in root.attachments : Rectangle {
                width: 220px; height: 28px;
                border-radius: Theme.radius-sm; background: Theme.accent-soft; border-width: 1px; border-color: Theme.border;
                Text { x: 8px; width: parent.width - 34px; height: parent.height; text: attachment.name; color: Theme.text; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                Action { x: parent.width - 27px; y: 2px; width: 24px; height: 24px; icon: @image-url("../assets/icons/xmark.svg"); label: I18n.cp_remove_attachment; clicked => { root.remove-attachment(index); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        editor := TextEditBase {
            accessible-role: text-input;
            accessible-value <=> self.text;
            accessible-placeholder-text: self.placeholder-text;
            accessible-action-set-value(value) => { self.text = value; }
            min-height: 72px;
            vertical-stretch: 1;
            scroll-view-padding: 10px;
            background: Theme.surface.transparentize(0.18);
            border-width: 1px; border-radius: Theme.radius-xl;
            border-color: self.has-focus ? Theme.accent : Theme.border;
            foreground: Theme.text;
            placeholder-text: root.terminal-mode ? I18n.cp_terminal_placeholder
                : (root.workspace-name != "" ? I18n.cp_input_placeholder_workspace(root.workspace-name) : I18n.cp_input_placeholder);
            placeholder-color: Theme.muted;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.text;
            font-size: 14px; font-family: "SimSun";
            wrap: word-wrap;
key-pressed(event) => {
                // Terminal mode: Ctrl+C interrupts the running shell instead
                // of copying the selection.
                if event.text == "c" && event.modifiers.control && root.terminal-mode {
                    root.interrupt();
                    return accept;
                }
                // ArrowUp / ArrowDown recall the messages this thread already
                // sent (Slint's key code points: U+F700 up, U+F701 down). The
                // caret test needs byte offsets, so Rust owns the decision, the
                // walk index and the stash; `handled` is what eats the key.
                if event.text == "\u{F700}" || event.text == "\u{F701}" {
                    let recalled = root.recall-history(
                        event.text == "\u{F700}" ? 1 : -1,
                        self.cursor-offset, self.anchor-offset, root.draft);
                    if recalled.handled {
                        root.draft = recalled.text;
                        self.set-selection-offsets(recalled.caret, recalled.caret);
                        return accept;
                    }
                    return reject;
                }
                // The send key preference: "enter" sends on plain Enter;
                // "ctrl_enter" sends only with Ctrl+Enter; "none" leaves all
                // newlines to the editor and sends via the button only.
                if event.text == "\n" && !event.modifiers.shift && !event.modifiers.control {
                    if root.send-key == "enter" && !root.send-blocked { root.send(); }
                    return root.send-key == "enter" ? accept : reject;
                }
                if event.text == "\n" && event.modifiers.control {
                    if root.send-key == "ctrl_enter" && !root.send-blocked { root.send(); return accept; }
                    return reject;
                }
                return reject;
            }
        }
        // ---- toolbar (§8.2) ----
        HorizontalLayout {
            height: 30px; spacing: 6px;
            // Left: workspace name, permission mode. The upload and plus
            // entries were removed with the more-menu; capture/voice stay.
            Rectangle {
                height: 30px; width: ws-name.preferred-width;
                visible: root.workspace-name != "";
                ws-name := Text {
                    height: parent.height; width: self.preferred-width;
                    text: root.workspace-name; color: Theme.text-secondary; font-size: Theme.font-sm;
                    vertical-alignment: center; overflow: elide;
                }
            }
            // The permission chip sizes itself from its label. The visible
            // chrome is a positioned overlay so it can round its own corners
            // while the skeleton below keeps the layout honest.
            Rectangle {
                height: 30px; width: permission-label.preferred-width + 42px;
                skeleton := Rectangle {
                    width: parent.width; height: parent.height;
                    background: root.permission-open ? Theme.accent-soft : permission-touch.has-hover ? Theme.hover : transparent;
                    border-radius: Theme.radius-sm;
                    Image { x: 8px; y: 8px; width: 14px; height: 14px; source: @image-url("../assets/icons/shield.svg"); colorize: root.permission-mode == "full_auto" ? Theme.muted : Theme.accent; image-fit: contain; }
                    permission-label := Text { x: 27px; y: 0px; width: self.preferred-width; height: parent.height; text: root.permission-label; color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; }
                    Image { x: parent.width - 15px; y: 11px; width: 9px; height: 9px; source: @image-url("../assets/icons/chevron-down.svg"); colorize: Theme.muted; image-fit: contain; }
                    accessible-role: combobox; accessible-label: I18n.cp_permission;
                    permission-touch := TouchArea {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.permission-open = !root.permission-open; root.model-open = false; }
                    }
                }
                if root.permission-open : Rectangle {
                    x: 0px; y: -172px; width: 230px; height: 162px; z: 30;
                    border-radius: Theme.radius-lg; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
                    VerticalLayout { padding: 8px; spacing: 3px;
                        for option in [
                            { value: "full_auto", label: I18n.cp_permission_full },
                            { value: "auto_edit", label: I18n.cp_permission_write },
                            { value: "suggest", label: I18n.cp_permission_command }
                        ] : Rectangle {
                            height: 28px; border-radius: Theme.radius-sm;
                            background: root.permission-mode == option.value ? Theme.accent-soft : perm-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: list-item; accessible-label: option.label;
                            Text { x: 10px; y: 0px; width: parent.width - 18px; height: parent.height; text: option.label; color: root.permission-mode == option.value ? Theme.accent : Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            perm-touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.permission-mode = option.value; root.permission-changed(option.value); root.permission-open = false; } }
                        }
                        Text { height: 42px; text: I18n.cp_permission_note; color: Theme.muted; font-size: Theme.font-2xs; wrap: word-wrap; vertical-alignment: top; }
                    }
                }
            }
            Rectangle {
                width: 30px; height: 30px;
                Action { width: parent.width; height: parent.height; icon: @image-url("../assets/icons/wand-magic-sparkles.svg"); icon-size: root.tool-icon-size; label: I18n.ag_preset_questions; selected: root.preset-open; clicked => { root.preset-open = !root.preset-open; root.command-open = false; root.screenshot-open = false; } }
                if root.preset-open : Rectangle {
                    x: 0px; y: -106px; width: 206px; height: 96px; z: 30;
                    border-radius: Theme.radius-md; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: I18n.ag_preset_questions; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
                        for preset in [I18n.cp_preset_q1, I18n.cp_preset_q2] : Rectangle {
                            height: 28px; border-radius: 5px; background: preset-touch.has-hover ? Theme.accent-soft : transparent;
                            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: preset; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
                            preset-touch := TouchArea { mouse-cursor: pointer; clicked => { root.draft = preset; root.preset-open = false; editor.focus(); } }
                        }
                    }
                }
            }
            Rectangle {
                width: 30px; height: 30px;
                TerminalAction { width: parent.width; height: parent.height; icon-size: root.tool-icon-size; label: root.terminal-mode ? I18n.cp_terminal_exit : I18n.cp_commands; selected: root.terminal-mode; clicked => { root.command-open = false; root.preset-open = false; root.screenshot-open = false; root.command(); } }
                if !root.terminal-mode && (root.command-open || root.draft == "/") : Rectangle {
                    x: 0px; y: -202px; width: 250px; height: 192px; z: 30;
                    border-radius: Theme.radius-md; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: I18n.cp_commands; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
                        for command in [{value: "/help", label: I18n.cp_cmd_help}, {value: "/new", label: I18n.cp_cmd_new}, {value: "/stop", label: I18n.cp_cmd_stop}, {value: "/goal ", label: I18n.cp_cmd_goal}, {value: "/compact", label: I18n.cp_cmd_compact}] : Rectangle {
                            height: 28px; border-radius: 5px; background: command-touch.has-hover ? Theme.accent-soft : transparent;
                            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: command.label; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
                            command-touch := TouchArea { mouse-cursor: pointer; clicked => { root.draft = command.value; root.command-open = false; editor.focus(); } }
                        }
                    }
                }
            }
            Action {
                icon: @image-url("../assets/icons/microphone.svg");
                icon-size: root.tool-icon-size;
                label: root.recording ? I18n.cp_stop_recording : (root.transcribing ? I18n.cp_transcribing : I18n.cp_record);
                enabled: !root.transcribing && !root.busy;
                selected: root.recording;
                icon-color: root.recording ? Theme.danger : Theme.muted;
                pulse: root.recording;
                pulse-phase: root.recording-pulse;
                clicked => { root.record-voice(); }
            }
            // Live capture feedback: the elapsed timer renders beside the
            // microphone so a running recording is visible at a glance.
            if root.recording : Text {
                height: 30px; vertical-alignment: center;
                text: root.recording-elapsed;
                color: Theme.danger;
                font-size: Theme.font-xs;
                font-weight: 600;
            }
            Rectangle {
                width: 30px; height: 30px;
                Action { width: parent.width; height: parent.height; icon: @image-url("../assets/icons/camera.svg"); icon-size: root.tool-icon-size; label: I18n.cp_screenshot; selected: root.screenshot-open; clicked => { root.screenshot-open = !root.screenshot-open; root.preset-open = false; root.command-open = false; } }
                if root.screenshot-open : Rectangle {
                    x: 0px; y: -130px; width: 220px; height: 120px; z: 30;
                    border-radius: Theme.radius-md; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
                    VerticalLayout { padding: 8px; spacing: 4px;
                        Text { text: I18n.cp_screenshot_mode; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
                        for option in [{label: I18n.cp_shot_fullscreen_hidden, hide: true, region: false}, {label: I18n.cp_shot_region_hidden, hide: true, region: true}, {label: I18n.cp_shot_fullscreen_kept, hide: false, region: false}, {label: I18n.cp_shot_region_kept, hide: false, region: true}] : Rectangle {
                            height: 22px; border-radius: 5px; background: option-touch.has-hover ? Theme.accent-soft : transparent;
                            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: option.label; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; }
                            option-touch := TouchArea { mouse-cursor: pointer; clicked => { root.screenshot-open = false; root.screenshot(option.hide, option.region); } }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Right: model switcher, context gauge, send.
            ModelPicker {
                width: model-label.preferred-width + 62px;
                models: root.models;
                has-catalogue: root.model-catalogue-count > 0;
                current-name: root.model-name;
                current-key: root.model-key;
                cloud-ready: root.cloud-ready;
                effort <=> root.reasoning-effort;
                saving: root.model-saving;
                open <=> root.model-open;
                select-model(index, name) => { root.select-model(index, name); }
                set-default-model(key) => { root.set-default-model(key); }
                effort-changed(value) => { root.reasoning-effort-changed(value); }
                open-settings => { root.open-model-settings(); }
                search-models(query) => { root.search-models(query); }
            }
            model-label := Text { text: root.model-name; font-size: Theme.font-md; font-weight: 600; visible: false; }
            ContextUsageIcon { usage: root.context-usage; known: root.context-known; counts: root.context-counts; }
            // Mirrors the web send control: the same accent button swaps between
            // a filled send glyph and a filled stop square while a reply streams.
            if root.generating : Action {
                width: 40px; icon: @image-url("../assets/icons/stop.svg"); icon-size: 16px;
                label: root.stopping ? I18n.cp_stopping : I18n.cp_stop_generation;
                primary: true; enabled: !root.stopping;
                clicked => { root.stop(); }
            }
            // The send control stays visible while a turn runs: a message sent
            // then is parked by the engine, which is what the strip above shows.
            Action { width: 40px; icon: @image-url("../assets/icons/paper-plane.svg"); icon-size: 16px; label: root.generating ? I18n.cp_queue_send : (root.send-blocked ? I18n.cp_sending : I18n.cp_send); primary: true; enabled: root.terminal-mode ? (root.draft != "" && !root.send-blocked) : ((root.draft != "" || root.attachments.length > 0 || root.inquiry-ready) && !root.send-blocked); clicked => { root.send(); } }
        }
        // ---- status line (§8.5): branch only; the context gauge lives in
        // the toolbar's brain glyph and the old labelled bar is gone. ----
        HorizontalLayout {
            height: 16px; spacing: 6px;
            if root.branch-name != "" : Image {
                y: 2px; width: 12px; height: 12px;
                source: @image-url("../assets/icons/fa-code-branch.svg"); colorize: Theme.muted; image-fit: contain;
            }
            if root.branch-name != "" : Text {
                height: parent.height; width: self.preferred-width;
                text: root.branch-name; color: Theme.muted; font-size: Theme.font-xs;
                vertical-alignment: center; overflow: elide;
            }
            // Slack absorber, not decoration: a row whose children are all rigid
            // reports a fixed implicit width, and that travels up to the Window,
            // which then sizes itself to the content and leaves the rest of the
            // screen empty. Every row in the width chain needs one stretchable item.
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
