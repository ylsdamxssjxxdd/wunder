import { I18n } from "i18n.slint";
import { Theme, ChatAttachment, ModelCard, PlanStep, InquiryQuestion, QueueTurn, DraftRecall } from "theme.slint";
import { Action } from "components.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { TextEditBase } from "textedit-base.slint";
import { DragPreview } from "drag_row.slint";

// Slint has neither top-level functions nor module-level constants, so the
// reasoning ladder lives in a global. The ladder is split in two rows because
// the popover's pill row wraps on the web and Slint has no wrapping layout.
export global EffortOptions {
    out property <[{ value: string, label: string }]> pills-a: [
        { value: "default", label: I18n.cp_effort_default },
        { value: "none", label: I18n.cp_effort_none },
        { value: "minimal", label: I18n.cp_effort_minimal },
        { value: "low", label: I18n.cp_effort_low }
    ];
    out property <[{ value: string, label: string }]> pills-b: [
        { value: "medium", label: I18n.cp_effort_medium },
        { value: "high", label: I18n.cp_effort_high },
        { value: "xhigh", label: I18n.cp_effort_xhigh }
    ];
    // Short label for a reasoning-effort value; the picker shows it next to the
    // model name so the active strength reads without opening the popover (§8.3).
    public pure function short(value: string) -> string {
        return value == "none" ? I18n.cp_effort_short_none
            : value == "minimal" ? I18n.cp_effort_short_minimal
            : value == "low" ? I18n.cp_effort_short_low
            : value == "medium" ? I18n.cp_effort_short_medium
            : value == "high" ? I18n.cp_effort_short_high
            : value == "xhigh" ? I18n.cp_effort_short_xhigh
            : I18n.cp_effort_short_default;
    }
}

// Six-dot spinner shared by the status dock and the model trigger; the
// software renderer has no transform-rotate, so the dot ring is rotated
// mathematically with the web's 1.48s period (same approach as RuntimeBadge).
component DockSpinner inherits Rectangle {
    in property <color> tint: Theme.accent;
    width: 12px; height: 12px;
    private property <angle> phase: mod(animation-tick(), 1480ms) / 1480ms * 360deg;
    for offset in [{x: 0.0, y: -4.1}, {x: 3.55, y: -2.05}, {x: 3.55, y: 2.05}, {x: 0.0, y: 4.1}, {x: -3.55, y: 2.05}, {x: -3.55, y: -2.05}] : Rectangle {
        x: (parent.width - 3.4px) / 2 + (offset.x * cos(root.phase) - offset.y * sin(root.phase)) * 1px;
        y: (parent.height - 3.4px) / 2 + (offset.x * sin(root.phase) + offset.y * cos(root.phase)) * 1px;
        width: 3.4px; height: 3.4px; border-radius: 1.7px; background: root.tint;
    }
}

// §8.3 model switcher, 对齐蜂巢 ChatComposer: the model button and the context
// gauge are one control — the trigger's brain glyph fills with the used share
// of the window — and the popover carries the numbers, the catalogue and the
// reasoning-effort pills. Selection applies to the active thread immediately
// through the existing select-model / reasoning-effort callbacks.
component ModelPicker inherits Rectangle {
    in property <[ModelCard]> models: [];
    // True while the catalogue itself is non-empty.
    in property <bool> has-catalogue: false;
    in property <string> current-name: "";
    // Key of the model the thread currently uses; the popover marks it.
    in property <string> current-key: "";
    // Cloud session is usable: signed in and not expired (§4.3.5). Cloud
    // entries grey out and refuse selection while this is false.
    in property <bool> cloud-ready: true;
    // Context gauge of the active thread: the trigger's brain fills with it,
    // the popover spells out the counts.
    in property <float> context-usage: 0.0;
    in property <bool> context-known: false;
    in property <string> context-counts;
    in-out property <string> effort: "default";
    in property <bool> saving: false;
    callback select-model(int, string);
    callback effort-changed(string);
    callback open-settings();
    // Lets the parent close the other composer popover when this picker opens.
    callback opened();
    in-out property <bool> open: false;
    out property <length> menu-x: root.open ? model_menu.absolute-position.x : -1px;
    out property <length> menu-y: root.open ? model_menu.absolute-position.y : -1px;
    out property <length> menu-width: root.open ? model_menu.width : 0px;
    out property <length> menu-height: root.open ? model_menu.height : 0px;
    height: 30px;
    // Explicit content width: 8px padding each side + 16px brain + 2×6px
    // spacing + 10px chevron, plus the measured name (eliding past 180px like
    // the web trigger's max-width). Hand-written on purpose: a plain Rectangle
    // does not propagate a child layout's preferred width, and hidden
    // measurement texts would otherwise become the width.
    width: 54px + min(model-label.preferred-width, 180px);
    // The hidden measurement text mirrors the visible fallback so the name
    // elides past 180px like the web trigger's max-width.
    model-label := Text {
        text: root.has-catalogue && root.current-name != "" ? root.current-name : I18n.cp_model_none;
        font-size: Theme.font-md; font-weight: 600; visible: false;
    }

    private property <float> fill: min(1.0, max(0.0, root.context-usage));
    private property <color> usage-color: root.context-usage >= 0.9 ? Theme.danger
        : root.context-usage >= 0.75 ? Theme.warning : Theme.accent;

    trigger := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: Theme.radius-sm;
        background: root.open ? Theme.accent-soft : trigger-touch.has-hover ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: I18n.cp_model_pick;
        accessible-action-default => {
            root.open = !root.open;
            if root.open { root.opened(); }
        }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 6px;
            // 液位大脑：占用越高填充越满，接近上限转警示色。布局行对固定高度
            // 的子元素是顶部对齐，所以图标住自己的全高格子再垂直居中。
            Rectangle {
                width: 16px; height: parent.height;
                property <length> glyph-y: (self.height - 16px) / 2;
                Image {
                    x: 0px; y: parent.glyph-y; width: 16px; height: 16px;
                    source: @image-url("../assets/icons/brain.svg"); colorize: Theme.muted;
                }
                Rectangle {
                    x: 0px; y: parent.glyph-y + 16px - 16px * root.fill;
                    width: 16px; height: 16px * root.fill; clip: true;
                    Image {
                        x: 0px; y: -16px * (1.0 - root.fill);
                        width: 16px; height: 16px;
                        source: @image-url("../assets/icons/brain.svg"); colorize: root.usage-color;
                    }
                }
            }
            Text {
                width: min(model-label.preferred-width, 180px);
                height: parent.height;
                text: root.has-catalogue && root.current-name != "" ? root.current-name : I18n.cp_model_none;
                color: root.has-catalogue ? Theme.text : Theme.muted;
                font-size: Theme.font-md; font-weight: 600;
                vertical-alignment: center; overflow: elide;
            }
            // 切换中转圈，静止时是下拉箭头（对齐蜂巢 composer-model-spinner）。
            if root.saving : Rectangle {
                width: 12px; height: parent.height;
                DockSpinner { y: (parent.height - self.height) / 2; }
            }
            if !root.saving : Rectangle {
                width: 10px; height: parent.height;
                Image {
                    y: (parent.height - 10px) / 2;
                    width: 10px; height: 10px;
                    source: @image-url("../assets/icons/chevron-down.svg");
                    colorize: Theme.muted; image-fit: contain;
                }
            }
        }
        trigger-touch := TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            mouse-cursor: pointer;
            clicked => {
                root.open = !root.open;
                if root.open { root.opened(); }
            }
        }
    }

    // Popover anchored to the trigger's right edge and drawn upward so it
    // clears the input card above the action row. 对齐蜂巢 ModelPickerPopover：
    // 顶部上下文行 → 可滚动模型列表 → 底部推理力度 pills。
    model_menu := Rectangle {
        visible: root.open;
        x: parent.width - 300px;
        y: -self.height - 8px;
        width: 300px; height: 340px;
        z: 30;
        border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
        VerticalLayout {
            padding: 8px; spacing: 6px;
            // 上下文占用：浮层顶部只给数字（进度条已下线，接近上限转警示色）。
            HorizontalLayout {
                height: 20px;
                Text {
                    text: I18n.cp_model_context;
                    color: Theme.muted; font-size: Theme.font-xs; font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1; min-width: 0px;
                    text: root.context-known
                        ? root.context-counts + " · " + round(root.fill * 100.0) + "%" : "—";
                    color: !root.context-known ? Theme.text-secondary
                        : root.context-usage >= 0.9 ? Theme.danger
                        : root.context-usage >= 0.75 ? Theme.warning : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if !root.has-catalogue : Rectangle {
                vertical-stretch: 1; border-radius: Theme.radius-sm; background: Theme.panel;
                VerticalLayout {
                    alignment: center; padding: 16px; spacing: 10px;
                    Text {
                        text: I18n.cp_model_empty;
                        color: Theme.muted; font-size: Theme.font-sm;
                        horizontal-alignment: center; wrap: word-wrap;
                    }
                    Rectangle {
                        width: 132px; height: 28px; border-radius: Theme.radius-sm;
                        background: empty-touch.has-hover ? Theme.accent-soft : Theme.surface;
                        border-width: 1px; border-color: Theme.border;
                        Text { width: parent.width; height: parent.height; text: I18n.cp_model_settings; color: Theme.accent; font-size: Theme.font-sm; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        empty-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open = false; root.open-settings(); } }
                    }
                }
            }
            if root.has-catalogue : list := ListView {
                vertical-stretch: 1;
                for model[index] in root.models : Rectangle {
                    height: 40px;
                    width: list.visible-width;
                    border-radius: Theme.radius-sm;
                    background: row-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: list-item;
                    accessible-label: model.key;
                    // Cloud entries (`cloud/<id>`) stay listed while signed
                    // out or expired, but grey out and stay unselectable
                    // until the session returns.
                    property <bool> cloud-muted: model.is-cloud && !root.cloud-ready;
                    accessible-action-default => { if !cloud-muted { root.select-model(index, model.key); root.open = false; } }
                    if model.key == root.current-key : Image {
                        x: 8px; y: 14px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/check.svg");
                        colorize: Theme.accent; image-fit: contain;
                    }
                    Image {
                        x: 26px; y: 13px; width: 14px; height: 14px;
                        source: @image-url("../assets/icons/robot.svg");
                        colorize: cloud-muted ? Theme.border : (model.key == root.current-key ? Theme.accent : Theme.muted);
                        image-fit: contain;
                    }
                    Text {
                        x: 48px; y: 4px; width: parent.width - 122px; height: 17px;
                        text: model.key;
                        color: cloud-muted ? Theme.muted : (model.key == root.current-key ? Theme.accent : Theme.text);
                        font-size: Theme.font-md; font-weight: 600;
                        vertical-alignment: center; overflow: elide;
                    }
                    Text {
                        x: 48px; y: 21px; width: parent.width - 122px; height: 15px;
                        text: cloud-muted ? I18n.st_cl_login_needed : model.provider + (model.model-type != "" ? " · " + model.model-type : "");
                        color: Theme.muted; font-size: Theme.font-xs;
                        vertical-alignment: center; overflow: elide;
                    }
                    if model.is-default : Rectangle {
                        x: parent.width - 74px; y: 12px; width: 34px; height: 16px;
                        border-radius: 8px; background: Theme.accent-soft;
                        Text { width: parent.width; height: parent.height; text: I18n.cp_model_default_tag; color: Theme.accent; font-size: Theme.font-2xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    // A cloud model is never the default (the engine keeps
                    // the default pinned to a local entry), so the badge
                    // reuses the default-tag slot.
                    if model.is-cloud : Rectangle {
                        x: parent.width - 74px; y: 12px; width: 24px; height: 16px;
                        border-radius: 8px; background: Theme.accent-soft;
                        Text { width: parent.width; height: parent.height; text: I18n.st_cl_badge; color: Theme.accent; font-size: Theme.font-2xs; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    row-touch := TouchArea {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        enabled: !cloud-muted;
                        mouse-cursor: cloud-muted ? MouseCursor.default : MouseCursor.pointer;
                        clicked => { root.select-model(index, model.key); root.open = false; }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // 推理力度 pills：两行圆角胶囊（对齐蜂巢 composer-model-effort-item）。
            VerticalLayout {
                spacing: 4px;
                Text {
                    height: 14px; text: I18n.cp_model_effort;
                    color: Theme.muted; font-size: Theme.font-xs; font-weight: 600;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    height: 24px; spacing: 4px;
                    for option in EffortOptions.pills-a : Rectangle {
                        width: pill-a-text.preferred-width + 18px;
                        border-radius: 12px;
                        background: root.effort == option.value ? Theme.accent-soft : pill-a-touch.has-hover ? Theme.hover : transparent;
                        border-width: 1px;
                        border-color: root.effort == option.value ? Theme.accent-soft : Theme.border;
                        accessible-role: button;
                        accessible-label: option.label;
                        accessible-action-default => { root.effort = option.value; root.effort-changed(option.value); }
                        pill-a-text := Text {
                            x: 9px; width: self.preferred-width; height: parent.height;
                            text: EffortOptions.short(option.value);
                            color: root.effort == option.value ? Theme.accent : Theme.text-secondary;
                            font-size: Theme.font-xs; font-weight: root.effort == option.value ? 600 : 400;
                            vertical-alignment: center;
                        }
                        pill-a-touch := TouchArea { mouse-cursor: pointer; clicked => { root.effort = option.value; root.effort-changed(option.value); } }
                    }
                }
                HorizontalLayout {
                    height: 24px; spacing: 4px;
                    for option in EffortOptions.pills-b : Rectangle {
                        width: pill-b-text.preferred-width + 18px;
                        border-radius: 12px;
                        background: root.effort == option.value ? Theme.accent-soft : pill-b-touch.has-hover ? Theme.hover : transparent;
                        border-width: 1px;
                        border-color: root.effort == option.value ? Theme.accent-soft : Theme.border;
                        accessible-role: button;
                        accessible-label: option.label;
                        accessible-action-default => { root.effort = option.value; root.effort-changed(option.value); }
                        pill-b-text := Text {
                            x: 9px; width: self.preferred-width; height: parent.height;
                            text: EffortOptions.short(option.value);
                            color: root.effort == option.value ? Theme.accent : Theme.text-secondary;
                            font-size: Theme.font-xs; font-weight: root.effort == option.value ? 600 : 400;
                            vertical-alignment: center;
                        }
                        pill-b-touch := TouchArea { mouse-cursor: pointer; clicked => { root.effort = option.value; root.effort-changed(option.value); } }
                    }
                }
            }
        }
    }
}

// One icon control of the goal banner; hover tints it toward the danger tone
// so the three controls read as a group without stealing focus from the text.
component GoalTool inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    callback clicked;
    width: 26px; height: 26px;
    border-radius: 8px;
    border-width: 1px;
    border-color: hit.has-hover ? #E8B2C8 : #EFC6D7;
    background: hit.has-hover ? #FFE6EF : #FFFFFF;
    Image {
        x: 6px; y: 6px; width: 14px; height: 14px;
        source: root.icon;
        colorize: hit.has-hover ? #9D2B5C : #7D858F;
        image-fit: contain;
    }
    hit := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.tip;
}

// §StatusDock: the plan capsule above the goal banner. It exists only while the
// 计划面板 tool has published steps — the turn's phase text (thinking / tools /
// generating) already reads on the timeline rows, so repeating it here would
// duplicate what the user sees above. Collapsed it is one right-aligned pill
// (title, the step being worked on, the progress counter, a chevron); clicking
// opens the checklist card above the pill, anchored to the same right edge as
// the web client's composer status dock. Keeping the capsule off-centre leaves
// the middle of the reading column clear. Expanding is pure view state: closing
// the card never drops the plan, which stays in the turn and the per-thread
// plan cache.
export component StatusDock inherits Rectangle {
    in property <bool> running: false;
    in property <int> steps-done: 0;
    in property <int> steps-total: 0;
    in property <string> plan-explanation: "";
    in property <[PlanStep]> plan-steps: [];
    // Resolved by the Rust projection: the first running step, else the first
    // unfinished one, and its 1-based position (0 when every step is done).
    in property <string> current-step: "";
    in property <int> current-position: 0;
    in-out property <bool> expanded: false;
    // Closing the card only collapses it.
    callback dismiss();
    height: 30px;
    // The plan tool bounds a plan at 12 steps; the card scrolls past 360px the
    // way the web popover does.
    out property <length> card-height: min(
        28px + (root.plan-explanation != "" ? 46px : 0px) + root.plan-steps.length * 30px,
        360px);
    // ---- the pill ----
    HorizontalLayout {
        // Right-aligned inside the reading column: the pill rides the input's
        // right edge instead of sitting in the middle of the viewport.
        alignment: end;
        Rectangle {
            height: 26px;
            border-radius: 13px;
            background: Theme.surface;
            border-width: 1px; border-color: #0F172A1A;
            drop-shadow-color: #0F172A10; drop-shadow-blur: 8px; drop-shadow-offset-y: 1px;
            HorizontalLayout {
                padding-left: 14px; padding-right: 12px; spacing: 6px;
                if root.running : DockSpinner { y: (parent.height - self.height) / 2; }
                Text {
                    height: parent.height;
                    text: I18n.dock_plan_title;
                    color: #4B5563; font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
                Text {
                    height: parent.height;
                    width: min(self.preferred-width, 260px);
                    text: root.current-step;
                    color: #4B5563; font-size: Theme.font-sm;
                    vertical-alignment: center; overflow: elide;
                }
                Text {
                    height: parent.height;
                    text: root.current-position > 0
                        ? root.current-position + " / " + root.steps-total
                        : root.steps-done + " / " + root.steps-total;
                    color: #4B5563; font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
                Image {
                    width: 10px; height: 10px;
                    y: (parent.height - self.height) / 2;
                    source: root.expanded
                        ? @image-url("../assets/icons/chevron-down.svg")
                        : @image-url("../assets/icons/chevron-up.svg");
                    colorize: #6B7280; image-fit: contain;
                }
            }
            pill-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
            accessible-role: button;
            accessible-label: I18n.dock_plan_title;
            accessible-action-default => { root.expanded = !root.expanded; }
        }
    }
    // ---- the checklist card, floating above the pill ----
    if root.expanded : Rectangle {
        width: min(560px, parent.width);
        height: root.card-height;
        // Same right edge as the pill, growing leftwards.
        x: parent.width - self.width;
        y: -self.height - 8px;
        z: 30;
        border-radius: 14px; background: Theme.surface;
        border-width: 1px; border-color: #0F172A14;
        drop-shadow-color: #0F172A29; drop-shadow-blur: 22px; drop-shadow-offset-y: 8px;
        clip: true;
        VerticalLayout {
            padding-left: 16px; padding-right: 16px;
            padding-top: 12px; padding-bottom: 12px;
            spacing: 2px;
            // The close affordance floats in this row's corner, so the
            // explanation keeps a right inset instead of running under it.
            if root.plan-explanation != "" : Rectangle {
                height: 42px;
                Text {
                    width: parent.width - 26px;
                    height: parent.height;
                    text: root.plan-explanation;
                    color: #6B7280; font-size: Theme.font-sm;
                    // Word wrap with `overflow: elide` renders only the tail of
                    // a wrapped paragraph in the soft renderer, so the two-line
                    // cap comes from max-lines alone.
                    wrap: word-wrap; max-lines: 2; vertical-alignment: top;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    alignment: start; spacing: 0px;
                    for step in root.plan-steps : Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: step-touch.has-hover ? #0F172A0A : transparent;
                        HorizontalLayout {
                            padding-left: 2px; padding-right: 4px; spacing: 10px;
                            // Thin-ring tri-state: the ring carries the status
                            // color and only the active states get a glyph,
                            // matching the web client's inline-svg markers.
                            Rectangle {
                                width: 18px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px; border-radius: 9px;
                                    border-width: 1.6px;
                                    border-color: step.status == "completed" ? Theme.success
                                        : step.status == "in_progress" ? Theme.warning
                                        : #B6BCC6;
                                    if step.status == "completed" : Image {
                                        x: 4px; y: 4px; width: 10px; height: 10px;
                                        source: @image-url("../assets/icons/status-check.svg");
                                        colorize: Theme.success; image-fit: contain;
                                    }
                                    if step.status == "in_progress" : Image {
                                        x: 5px; y: 5px; width: 8px; height: 8px;
                                        source: @image-url("../assets/icons/status-pause.svg");
                                        colorize: Theme.warning; image-fit: contain;
                                    }
                                }
                            }
                            Text {
                                height: parent.height; horizontal-stretch: 1;
                                text: step.step;
                                color: step.status == "in_progress" ? Theme.text : #3F3F46;
                                font-size: Theme.font-lg;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                        step-touch := TouchArea {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
        // Closing collapses the card; the plan itself stays published.
        Rectangle {
            width: 22px; height: 22px;
            x: parent.width - self.width - 8px; y: 8px;
            z: 2;
            border-radius: 6px;
            background: close-touch.has-hover ? #0F172A0F : transparent;
            Image {
                x: 4px; y: 4px; width: 14px; height: 14px;
                source: @image-url("../assets/icons/xmark.svg");
                colorize: close-touch.has-hover ? Theme.danger : #6B7280;
                image-fit: contain;
            }
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = false; root.dismiss(); }
            }
        }
    }
}

// §InquiryPanel: the 问询面板 card above the composer, laid out like the web
// client's inquiry panel: a white card whose heading is the question, ‹ n/m ›
// paging with an expand-all toggle, option rows (square marks for multi-select,
// round for single) carrying a 推荐 badge and the option's own description, and
// a free-text row with a split 无偏好 / 使用推荐 quick answer. Selection state
// lives in Rust: every interaction republishes these rows, and the answer goes
// out with the composer's send button (the same gesture as the web client).
// `questions` holds one row per page, or every question once expanded.
export component InquiryPanel inherits Rectangle {
    in property <[InquiryQuestion]> questions: [];
    in property <int> page: 0;
    in property <int> total: 1;
    in property <bool> expanded: false;
    // Row whose quick-answer menu is open; -1 keeps it closed.
    in-out property <int> menu-row: -1;
    callback option-clicked(int, int);
    callback other-edited(int, string);
    callback no-preference(int);
    callback use-recommended(int);
    callback page-move(int);
    callback expanded-toggle();

    height: 10px + card.height + 12px;
    card := Rectangle {
        width: parent.width;
        x: 0; y: 10px;
        height: body.preferred-height + 26px;
        border-radius: 14px; background: Theme.surface;
        border-width: 1px; border-color: #0F172A1A;
        drop-shadow-color: #0F172A12; drop-shadow-blur: 18px; drop-shadow-offset-y: 6px;
        clip: true;
        body := VerticalLayout {
            padding-left: 18px; padding-right: 14px;
            padding-top: 14px; padding-bottom: 12px;
            spacing: 2px;
            // ---- heading: the question, then the panel tools ----
            HorizontalLayout {
                height: max(24px, head-text.preferred-height);
                spacing: 12px;
                head-text := Text {
                    horizontal-stretch: 1;
                    text: root.expanded ? I18n.inquiry_all_questions : root.questions[0].question;
                    color: Theme.text; font-size: 15px; font-weight: 700;
                    wrap: word-wrap; vertical-alignment: top;
                }
                if root.total > 1 && !root.expanded : Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: prev-touch.has-hover && root.page > 0 ? #0F172A0F : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/chevron-left.svg");
                        colorize: root.page > 0 ? #6B7280 : #D1D5DB;
                        image-fit: contain;
                    }
                    prev-touch := TouchArea {
                        mouse-cursor: root.page > 0 ? MouseCursor.pointer : MouseCursor.default;
                        enabled: root.page > 0;
                        clicked => { root.menu-row = -1; root.page-move(-1); }
                    }
                }
                if root.total > 1 && !root.expanded : Text {
                    width: 34px; height: max(24px, self.preferred-height);
                    text: (root.page + 1) + "/" + root.total;
                    color: #4B5563; font-size: Theme.font-sm;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                if root.total > 1 && !root.expanded : Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: next-touch.has-hover && root.page < root.total - 1 ? #0F172A0F : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/chevron-right.svg");
                        colorize: root.page < root.total - 1 ? #6B7280 : #D1D5DB;
                        image-fit: contain;
                    }
                    next-touch := TouchArea {
                        mouse-cursor: root.page < root.total - 1 ? MouseCursor.pointer : MouseCursor.default;
                        enabled: root.page < root.total - 1;
                        clicked => { root.menu-row = -1; root.page-move(1); }
                    }
                }
                if root.total > 1 : Rectangle {
                    width: 24px; height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: expand-touch.has-hover ? #0F172A0F : transparent;
                    Image {
                        x: 5px; y: 5px; width: 14px; height: 14px;
                        source: root.expanded
                            ? @image-url("../assets/icons/fa-compress.svg")
                            : @image-url("../assets/icons/fa-window-maximize.svg");
                        colorize: #6B7280; image-fit: contain;
                    }
                    expand-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.menu-row = -1; root.expanded-toggle(); }
                    }
                    accessible-role: button;
                    accessible-label: root.expanded ? I18n.inquiry_collapse : I18n.inquiry_expand;
                }
            }
            // ---- one block per visible question ----
            for question[index] in root.questions : Rectangle {
                height: block.preferred-height;
                block := VerticalLayout {
                    spacing: 0px;
                    if index > 0 : Rectangle {
                        height: 1px;
                        background: #0F172A12;
                    }
                    if root.expanded && root.total > 1 : Text {
                        height: 24px;
                        text: I18n.inquiry_question_progress((index + 1) + "/" + root.total)
                            + " · " + question.question;
                        color: #6B7280; font-size: Theme.font-sm;
                        vertical-alignment: center; overflow: elide;
                    }
                    for option[option-index] in question.options : Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        background: option-touch.has-hover ? #0F172A0A : transparent;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 10px;
                            Rectangle {
                                width: 18px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px;
                                    border-radius: question.multiple ? 5px : 9px;
                                    border-width: 1.5px;
                                    border-color: option.selected ? Theme.accent : #D1D5DB;
                                    background: option.selected ? Theme.accent : Theme.surface;
                                    Image {
                                        x: 3.5px; y: 5.5px; width: 10px; height: 7px;
                                        source: @image-url("../assets/icons/status-check.svg");
                                        colorize: Theme.surface; image-fit: contain;
                                        visible: option.selected;
                                    }
                                }
                            }
                            Text {
                                height: parent.height;
                                width: min(self.preferred-width, 220px);
                                text: option.label;
                                color: option.selected ? Theme.accent-deep : Theme.text;
                                font-size: Theme.font-lg; font-weight: 600;
                                vertical-alignment: center; overflow: elide;
                            }
                            if option.recommended : Rectangle {
                                width: badge-text.preferred-width + 16px;
                                height: 18px; y: (parent.height - self.height) / 2;
                                border-radius: 9px; background: #0F172A12;
                                badge-text := Text {
                                    x: 8px; width: self.preferred-width; height: parent.height;
                                    text: I18n.inquiry_recommended;
                                    color: #6B7280; font-size: Theme.font-xs; font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                height: parent.height; horizontal-stretch: 1;
                                text: option.description;
                                color: #6B7280; font-size: 13px;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                        // The row itself is the hit area; the mark is decoration.
                        option-touch := TouchArea {
                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.menu-row = -1; root.option-clicked(question.index, option-index); }
                        }
                    }
                    // ---- free text row + quick answer ----
                    Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 10px;
                            Rectangle {
                                width: 18px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px;
                                    border-radius: question.multiple ? 5px : 9px;
                                    border-width: 1.5px;
                                    border-color: question.other != "" ? Theme.accent : #D1D5DB;
                                    background: question.other != "" ? Theme.accent : Theme.surface;
                                    Image {
                                        x: 3.5px; y: 5.5px; width: 10px; height: 7px;
                                        source: @image-url("../assets/icons/status-check.svg");
                                        colorize: Theme.surface; image-fit: contain;
                                        visible: question.other != "";
                                    }
                                }
                            }
                            // Raw Slint TextInput has no placeholder of its own,
                            // and the std LineEdit would restyle the row; the
                            // hint is a plain Text overlay (Text has no input
                            // path, so typing stays unaffected).
                            Rectangle {
                                horizontal-stretch: 1;
                                height: parent.height;
                                TextInput {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height - 2px;
                                    text: question.other;
                                    color: Theme.text; font-size: 13px;
                                    vertical-alignment: center;
                                    edited => { root.other-edited(question.index, self.text); }
                                }
                                Text {
                                    x: 1px; y: 0px; width: parent.width; height: parent.height;
                                    text: I18n.inquiry_other_placeholder;
                                    color: #9CA3AF; font-size: 13px;
                                    vertical-alignment: center;
                                    visible: question.other == "";
                                }
                                // The web row underlines the field with a
                                // dashed border; the soft renderer draws it solid.
                                Rectangle {
                                    y: parent.height - 2px; width: parent.width; height: 1px;
                                    background: #D1D5DB;
                                }
                            }
                            // Split control: the label marks 无偏好, the caret
                            // opens the quick-answer menu. A Rectangle reports
                            // no intrinsic width of its own, so the pill is
                            // sized from the label plus its paddings, the
                            // divider, both gaps and the caret.
                            Rectangle {
                                width: pref-label.preferred-width + 42px;
                                height: 26px;
                                border-radius: 9px;
                                background: question.no_preference ? Theme.accent-soft
                                    : pref-touch.has-hover || caret-touch.has-hover
                                        ? #0F172A12 : #0F172A0D;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 8px; spacing: 6px;
                                    pref-label := Text {
                                        height: parent.height;
                                        text: I18n.inquiry_no_preference;
                                        color: question.no_preference ? Theme.accent-deep : #374151;
                                        font-size: 13px; font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: 1px;
                                        background: #0F172A14;
                                    }
                                    Image {
                                        width: 9px; height: 9px;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../assets/icons/chevron-down.svg");
                                        colorize: #6B7280; image-fit: contain;
                                    }
                                }
                                pref-touch := TouchArea {
                                    x: 0px; y: 0px;
                                    width: parent.width - 24px; height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { root.menu-row = -1; root.no-preference(question.index); }
                                }
                                caret-touch := TouchArea {
                                    x: parent.width - 24px; y: 0px;
                                    width: 24px; height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.menu-row = root.menu-row == question.index ? -1 : question.index;
                                    }
                                }
                            }
                        }
                        // The quick-answer menu floats above the caret.
                        if root.menu-row == question.index : Rectangle {
                            width: 132px;
                            height: menu-box.preferred-height + 8px;
                            x: parent.width - self.width - 6px;
                            y: -self.height - 6px;
                            z: 6;
                            border-radius: 10px; background: Theme.surface;
                            border-width: 1px; border-color: #0F172A1A;
                            drop-shadow-color: #0F172A24; drop-shadow-blur: 16px; drop-shadow-offset-y: 4px;
                            menu-box := VerticalLayout {
                                padding: 4px; spacing: 0px;
                                Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    background: menu-a.has-hover ? #0F172A0D : transparent;
                                    Text {
                                        x: 10px; width: parent.width - 20px; height: parent.height;
                                        text: I18n.inquiry_no_preference;
                                        color: #374151; font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    menu-a := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.menu-row = -1; root.no-preference(question.index); }
                                    }
                                }
                                Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    background: menu-b.has-hover ? #0F172A0D : transparent;
                                    Text {
                                        x: 10px; width: parent.width - 20px; height: parent.height;
                                        text: I18n.inquiry_use_recommended;
                                        color: #374151; font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    menu-b := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.menu-row = -1; root.use-recommended(question.index); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// §8.1b goal banner: one row above the composer once a session has a goal.
// It shows the objective, the accumulated active time and three controls;
// editing swaps the row for an inline input and Enter re-submits the goal.
export component GoalBanner inherits Rectangle {
    in property <string> objective;
    in property <string> elapsed;
    in property <string> phase;
    in property <string> activation;
    in property <string> rounds;
    in property <bool> paused: false;
    in-out property <bool> editing: false;
    in-out property <string> edit-draft;
    callback save(string);
    callback pause-toggle();
    callback clear();
    height: 42px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #EFC6D7;
    background: #FDF1F6;
    if root.editing : Rectangle {
        width: 100%; height: 100%;
        init => { goal-input.focus(); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 10px; spacing: 8px;
            Rectangle {
                width: 14px; height: parent.height;
                // Layout rows top-align fixed-height children, so the glyph
                // rides its own full-height cell and centers itself.
                Image {
                    y: (parent.height - 14px) / 2;
                    width: 14px; height: 14px;
                    source: @image-url("../assets/icons/fa-bullseye.svg");
                    colorize: Theme.danger; image-fit: contain;
                }
            }
            goal-input := TextInput {
                height: parent.height;
                text <=> root.edit-draft;
                color: Theme.text; font-size: Theme.font-md;
                vertical-alignment: center;
                // Enter submits; an empty draft cancels the edit instead of
                // clearing the goal — clearing stays on the trash control.
                accepted => {
                    root.editing = false;
                    if self.text != "" {
                        root.save(self.text);
                    }
                }
            }
            Text {
                text: I18n.cp_goal_edit_hint;
                color: Theme.danger; opacity: 0.6; font-size: Theme.font-2xs;
                vertical-alignment: center;
            }
        }
    }
    if !root.editing : Rectangle {
        width: 100%; height: 100%;
        HorizontalLayout {
            padding-left: 16px; padding-right: 8px; spacing: 8px;
            Rectangle {
                width: 14px; height: parent.height;
                // Layout rows top-align fixed-height children, so the glyph
                // rides its own full-height cell and centers itself.
                Image {
                    y: (parent.height - 14px) / 2;
                    width: 14px; height: 14px;
                    source: @image-url("../assets/icons/fa-bullseye.svg");
                    colorize: Theme.danger; image-fit: contain;
                }
            }
            Text {
                text: I18n.cp_goal_label; color: #9D2B5C;
                font-size: Theme.font-md; font-weight: 700; vertical-alignment: center;
            }
            Text {
                text: "·"; color: #9D2B5C; opacity: 0.55;
                font-size: Theme.font-md; vertical-alignment: center;
            }
            if root.phase == "blocked" : Text {
                text: I18n.cp_goal_blocked_tag; color: Theme.danger;
                font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center;
            }
            if root.phase == "paused" || (root.phase == "active" && root.activation == "disarmed") : Text {
                text: I18n.cp_goal_paused_tag; color: Theme.warning;
                font-size: Theme.font-sm; vertical-alignment: center;
            }
            if root.phase != "blocked" && root.phase != "paused" && root.activation != "disarmed" : Text {
                text: root.rounds; color: #B8557F; opacity: 0.9;
                font-size: Theme.font-sm; vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1; min-width: 0px;
                text: root.objective; color: #7A2949;
                font-size: Theme.font-md; overflow: elide; vertical-alignment: center;
            }
            GoalTool {
                icon: @image-url("../assets/icons/pen.svg");
                tip: I18n.cp_goal_edit;
                clicked => { root.editing = true; root.edit-draft = root.objective; }
            }
            GoalTool {
                icon: root.paused || root.phase == "blocked" || root.activation == "disarmed"
                    ? @image-url("../assets/icons/rotate-right.svg")
                    : @image-url("../assets/icons/status-pause.svg");
                tip: root.paused || root.phase == "blocked" || root.activation == "disarmed" ? I18n.cp_goal_resume : I18n.cp_goal_pause;
                clicked => { root.pause-toggle(); }
            }
            GoalTool {
                icon: @image-url("../assets/icons/trash.svg");
                tip: I18n.cp_goal_clear;
                clicked => { root.clear(); }
            }
        }
    }
}

// One quiet icon control of a queue row; the tint stays neutral until the
// pointer is on it, and the caller decides whether the tone is danger.
component QueueTool inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <color> tint: Theme.muted;
    in property <color> active-tint: Theme.danger;
    in property <bool> enabled: true;
    callback clicked();
    width: 24px; height: 24px;
    border-radius: 6px;
    background: root.enabled && hit.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: 5px; y: 5px; width: 14px; height: 14px;
        source: root.icon; image-fit: contain;
        colorize: root.enabled ? (hit.has-hover ? root.active-tint : root.tint) : Theme.border;
    }
    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// One parked turn. The grip on the left is the only drag handle, so a click on
// the text or on an action never turns into a reorder: the drag distance is
// measured from the grip's own geometry and a row move is only emitted on
// release past the 6px threshold (same contract as the sidebar rows).
component QueueRow inherits Rectangle {
    in property <QueueTurn> turn;
    callback interject(string);
    callback edit(string);
    callback remove(string);
    callback move-by(string, int);
    height: 28px;
    private property <length> drag-start: 0px;
    private property <bool> dragging: false;
    private property <bool> drop-before: DragPreview.active
        && DragPreview.source-y != root.absolute-position.y
        && DragPreview.pointer-y >= root.absolute-position.y
        && DragPreview.pointer-y < root.absolute-position.y + root.height / 2;
    private property <bool> drop-after: DragPreview.active
        && DragPreview.source-y != root.absolute-position.y
        && DragPreview.pointer-y >= root.absolute-position.y + root.height / 2
        && DragPreview.pointer-y < root.absolute-position.y + root.height;
    border-radius: Theme.radius-sm;
    background: root.dragging ? Theme.accent-soft : drop-before || drop-after ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.turn.text;

    grip := TouchArea {
        x: 0px; y: 0px; width: 22px; height: parent.height;
        mouse-cursor: root.dragging ? MouseCursor.move : MouseCursor.grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag-start = self.mouse-y;
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = root.absolute-position.y;
                DragPreview.pointer-y = root.absolute-position.y + self.mouse-y;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if root.dragging {
                    root.move-by(root.turn.queue-id, round((self.mouse-y - root.drag-start) / root.height));
                }
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = -1px;
            }
            if event.kind == PointerEventKind.cancel {
                root.dragging = false;
                DragPreview.active = false;
                DragPreview.source-y = -1px;
            }
        }
        moved => {
            DragPreview.pointer-y = root.absolute-position.y + self.mouse-y;
            if self.pressed && abs(self.mouse-y - root.drag-start) > 6px {
                root.dragging = true;
                DragPreview.active = true;
            }
        }
    }
    // Grip dots: no asset carries this glyph and six rects cost nothing.
    for dot in [{x: 6px, y: 8px}, {x: 12px, y: 8px}, {x: 6px, y: 13px}, {x: 12px, y: 13px}, {x: 6px, y: 18px}, {x: 12px, y: 18px}] : Rectangle {
        x: dot.x; y: dot.y; width: 3px; height: 3px;
        border-radius: 1.5px;
        background: grip.has-hover || root.dragging ? Theme.accent : Theme.border-strong;
    }

    HorizontalLayout {
        padding-left: 24px; padding-right: 2px; spacing: 8px;
        Text {
            horizontal-stretch: 1; min-width: 0px;
            height: parent.height;
            text: root.turn.text != "" ? root.turn.text : I18n.cp_queue_attachment_only;
            color: root.turn.text != "" ? Theme.text : Theme.muted;
            font-size: Theme.font-sm;
            vertical-alignment: center; overflow: elide;
        }
        if root.turn.attachments > 0 : Text {
            height: parent.height;
            text: I18n.cp_queue_attachments(root.turn.attachments);
            color: Theme.muted; font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
        Action {
            width: 76px; height: 24px; y: 2px;
            icon: @image-url("../assets/icons/arrow-up.svg");
            icon-size: 13px;
            label: root.turn.interjected ? I18n.cp_queue_interjected : I18n.cp_queue_interject;
            show-label: true;
            enabled: !root.turn.interjected;
            icon-color: root.turn.interjected ? Theme.border : Theme.accent;
            clicked => { root.interject(root.turn.queue-id); }
        }
        QueueTool {
            y: 2px;
            icon: @image-url("../assets/icons/pen.svg");
            tip: I18n.cp_queue_edit_hint;
            tint: Theme.muted;
            active-tint: Theme.text;
            clicked => { root.edit(root.turn.queue-id); }
        }
        QueueTool {
            y: 2px;
            icon: @image-url("../assets/icons/trash.svg");
            tip: I18n.cp_queue_remove_hint;
            clicked => { root.remove(root.turn.queue-id); }
        }
    }

    // Insertion seam, same affordance as the sidebar rows: a line at the edge
    // the dragged row would land against.
    if root.drop-before || root.drop-after : Rectangle {
        x: 2px;
        y: root.drop-after ? parent.height - 2px : 0px;
        width: parent.width - 4px;
        height: 2px;
        z: 100;
        background: Theme.accent;
        opacity: 0.96;
        animate y { duration: 110ms; easing: ease-out; }
    }
}

// §发送队列: the turns the engine parked for this thread while a run is in
// flight. Rust publishes at most `QueueStrip.max-rows` of them plus the count
// it left out, so the card height stays exact and never grows with the queue.
export component QueueStrip inherits Rectangle {
    in property <[QueueTurn]> turns: [];
    in property <int> overflow: 0;
    callback interject(string);
    callback edit(string);
    callback remove(string);
    callback move-by(string, int);
    height: card-body.preferred-height;
    frame := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: Theme.radius-lg; background: Theme.surface;
        border-width: 1px; border-color: Theme.border;
        clip: true;
    }
    card-body := VerticalLayout {
        padding-left: 10px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
        spacing: 2px;
        HorizontalLayout {
            height: 20px; padding-left: 14px; spacing: 6px;
            Text { text: I18n.cp_queue_title; color: Theme.muted; font-size: Theme.font-2xs; font-weight: 700; vertical-alignment: center; }
            Text { text: "" + root.turns.length + (root.overflow > 0 ? "+" : ""); color: Theme.text-secondary; font-size: Theme.font-2xs; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: I18n.cp_queue_hint; color: Theme.border-strong; font-size: Theme.font-2xs; vertical-alignment: center; }
        }
        for turn in root.turns : QueueRow {
            turn: turn;
            interject(queue-id) => { root.interject(queue-id); }
            edit(queue-id) => { root.edit(queue-id); }
            remove(queue-id) => { root.remove(queue-id); }
            move-by(queue-id, delta) => { root.move-by(queue-id, delta); }
        }
        if root.overflow > 0 : Rectangle {
            height: 16px;
            Text {
                x: 14px; width: parent.width - 28px; height: parent.height;
                text: I18n.cp_queue_more(root.overflow);
                color: Theme.muted; font-size: Theme.font-2xs;
                vertical-alignment: center;
            }
        }
    }
}

// Cascading submenus of the plus menu, 对齐蜂巢 ChatComposer: a 268px card
// pops out to the right of its menu row, and the height follows the body so
// every submenu is exactly as tall as its rows.
component CommandFlyout inherits Rectangle {
    callback pick(string);
    width: 268px;
    height: body.preferred-height;
    border-radius: Theme.radius-md; background: Theme.surface;
    border-width: 1px; border-color: Theme.border;
    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
    body := VerticalLayout {
        padding: 8px; spacing: 4px;
        for command in [
            { value: "/help", label: I18n.cp_cmd_help },
            { value: "/new", label: I18n.cp_cmd_new },
            { value: "/stop", label: I18n.cp_cmd_stop },
            { value: "/goal ", label: I18n.cp_cmd_goal },
            { value: "/compact", label: I18n.cp_cmd_compact }
        ] : Rectangle {
            height: 28px; border-radius: 5px;
            background: cmd-touch.has-hover ? Theme.accent-soft : transparent;
            accessible-role: list-item; accessible-label: command.label;
            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: command.label; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
            cmd-touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(command.value); } }
        }
    }
}

component PresetFlyout inherits Rectangle {
    in property <[string]> questions: [];
    callback pick(string);
    width: 268px;
    height: body.preferred-height;
    border-radius: Theme.radius-md; background: Theme.surface;
    border-width: 1px; border-color: Theme.border;
    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
    body := VerticalLayout {
        padding: 8px; spacing: 4px;
        Text { text: I18n.ag_preset_questions; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
        for preset in root.questions : Rectangle {
            height: 28px; border-radius: 5px;
            background: preset-touch.has-hover ? Theme.accent-soft : transparent;
            accessible-role: list-item; accessible-label: preset;
            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: preset; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; overflow: elide; }
            preset-touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(preset); } }
        }
    }
}

component PermissionFlyout inherits Rectangle {
    in property <string> mode;
    callback changed(string);
    width: 268px;
    height: body.preferred-height;
    border-radius: Theme.radius-md; background: Theme.surface;
    border-width: 1px; border-color: Theme.border;
    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
    body := VerticalLayout {
        padding: 8px; spacing: 4px;
        Text { text: I18n.cp_permission; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
        for option in [
            { value: "full_auto", label: I18n.cp_permission_full },
            { value: "auto_edit", label: I18n.cp_permission_write },
            { value: "suggest", label: I18n.cp_permission_command }
        ] : Rectangle {
            height: 28px; border-radius: 5px;
            background: root.mode == option.value ? Theme.accent-soft : perm-touch.has-hover ? Theme.hover : transparent;
            accessible-role: list-item; accessible-label: option.label;
            Text { x: 10px; width: parent.width - 18px; height: parent.height; text: option.label; color: root.mode == option.value ? Theme.accent : Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; }
            perm-touch := TouchArea { mouse-cursor: pointer; clicked => { root.changed(option.value); } }
        }
        Text { height: 54px; text: I18n.cp_permission_note; color: Theme.muted; font-size: Theme.font-2xs; wrap: word-wrap; vertical-alignment: top; }
    }
}

component ScreenshotFlyout inherits Rectangle {
    callback pick(bool, bool);
    width: 268px;
    height: body.preferred-height;
    border-radius: Theme.radius-md; background: Theme.surface;
    border-width: 1px; border-color: Theme.border;
    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
    body := VerticalLayout {
        padding: 8px; spacing: 4px;
        Text { text: I18n.cp_screenshot_mode; color: Theme.text; font-size: Theme.font-xs; font-weight: 600; }
        for option in [
            { label: I18n.cp_shot_fullscreen_hidden, hide: true, region: false },
            { label: I18n.cp_shot_region_hidden, hide: true, region: true },
            { label: I18n.cp_shot_fullscreen_kept, hide: false, region: false },
            { label: I18n.cp_shot_region_kept, hide: false, region: true }
        ] : Rectangle {
            height: 24px; border-radius: 5px;
            background: shot-touch.has-hover ? Theme.accent-soft : transparent;
            accessible-role: list-item; accessible-label: option.label;
            Text { x: 8px; width: parent.width - 16px; height: parent.height; text: option.label; color: Theme.text; font-size: Theme.font-2xs; vertical-alignment: center; }
            shot-touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(option.hide, option.region); } }
        }
    }
}

export component Composer inherits Rectangle {
    in-out property <string> draft <=> editor.text;
    in property <bool> busy: false;
    // A live 问询面板 whose current page has an answer: the send button and the
    // send key then work with an empty draft, because the choices themselves
    // are the message.
    in property <bool> inquiry-ready: false;
    in property <bool> generating;
    in property <bool> stopping;
    in property <bool> recording: false;
    in property <bool> transcribing: false;
    in property <string> recording-elapsed: "";
    // Alternating phase from the capture clock; drives the breathing outline.
    in property <bool> recording-pulse: false;
    in property <float> context-usage: 0.0;
    in property <bool> context-known: false;
    in property <string> context-counts;
    in-out property <string> reasoning-effort: "default";
    callback reasoning-effort-changed(string);
    // §8.3: the action row owns the model switcher. The catalogue comes
    // straight from the settings projection, so the picker needs no separate
    // fetch.
    in property <[ModelCard]> models: [];
    // True size of the catalogue; the picker only distinguishes "empty list"
    // from "nothing configured".
    in property <int> model-catalogue-count: 0;
    in property <string> model-name: "";
    // Key of the model the active thread uses; the popover marks the matching
    // row by key because indices shift as the catalogue changes.
    in property <string> model-key: "";
    in property <bool> model-saving: false;
    // Cloud session usable (signed in, not expired); forwarded to the picker.
    in property <bool> cloud-ready: true;
    callback select-model(int, string);
    callback open-model-settings();
    // Project the selected agent's saved quick prompts. This makes the
    // composer use the same four default prompts as 蜂巢 and preserves a
    // user's own agent edits without duplicating defaults in the UI.
    in property <[string]> preset-questions: [];
    in property <[ChatAttachment]> attachments: [];
    in property <string> send-key: "enter";
    // §8.5 status line under the box.
    in property <string> workspace-name: "";
    in property <string> branch-name: "";
    // §8.4 permission mode: a plain preference string, reported by the runtime
    // sheet; enforcement itself stays in the backend.
    // §8.4 permission mode, named after the runtime's `approval_mode` values
    // (full_auto / auto_edit / suggest) so the chip and the engine agree.
    in-out property <string> permission-mode: "full_auto";
    callback permission-changed(string);
    callback stop();
    callback send();
    callback remove-attachment(int);
    callback record-voice();
    callback launch-terminal();
    // Terminal mode: Ctrl+C becomes an interrupt instead of copy.
    callback interrupt();
    // Terminal mode: the input routes to the local shell. The composer keeps
    // its visual language (and the send button), only the placeholder and
    // send semantics change; the backend decides where the text goes.
    callback screenshot(bool, bool);
    // ---- 发送队列 (§发送队列) ----
    // Parked turns come straight from the engine's queue projection; the strip
    // never keeps its own copy, so a reorder or a withdraw that raced with a
    // feeder wake is corrected by the next publish.
    in property <[QueueTurn]> queue-turns: [];
    in property <int> queue-overflow: 0;
    callback queue-interject(string);
    callback queue-edit(string);
    callback queue-remove(string);
    callback queue-move-by(string, int);
    // ArrowUp/ArrowDown recall of already-sent messages. The decision needs the
    // caret's byte offsets, which only Rust can compare against the draft's byte
    // length, so the editor forwards them and takes back what Rust returns.
    callback recall-history(int, int, int, string) -> DraftRecall;
    // Editor focus, surfaced so the platform layer can raise the Windows touch
    // keyboard when the activation came from a finger (see touch_keyboard.rs).
    out property <bool> editor-has-focus: editor.has-focus;
    callback editor-focus-gained();
    changed editor-has-focus => {
        if root.editor-has-focus {
            root.editor-focus-gained();
        }
    }
    private property <bool> queue-open: root.queue-turns.length > 0;
    // A running turn no longer swallows the send: the engine parks the turn and
    // the strip above the input shows it. What still blocks is a slash command
    // in flight or a thread that is still loading.
    private property <bool> send-blocked: root.busy;
    // Exact card height: 6+6 padding, a 20px header, 28px rows, the optional
    // overflow line and 2px between every item.
    private property <int> queue-items: root.queue-open
        ? 1 + root.queue-turns.length + (root.queue-overflow > 0 ? 1 : 0) : 0;
    private property <length> queue-height: root.queue-open
        ? 12px + 20px + root.queue-turns.length * 28px
            + (root.queue-overflow > 0 ? 16px : 0px) + (root.queue-items - 1) * 2px + 6px
        : 0px;
    // 对齐蜂巢的固定构图: 8px top padding + 100px input card + 6 + 30px action
    // row + 10px bottom padding; the attachment row (+36) and the branch line
    // (+22) only exist while they have content.
    height: 154px + (root.attachments.length > 0 ? 36px : 0px)
        + (root.branch-name != "" ? 22px : 0px) + root.queue-height;
    private property <bool> plus-open: false;
    private property <bool> model-open: false;
    private property <bool> preset-open: false;
    private property <bool> command-open: false;
    private property <bool> screenshot-open: false;
    private property <bool> permission-open: false;
    // 蜂巢同款发送门禁: allow attachment-only and answered-inquiry sends.
    private property <bool> send-enabled:
        ((root.draft != "" || root.attachments.length > 0 || root.inquiry-ready) && !root.send-blocked);
    // Keep Stop only when there is no user payload to submit. While a reply is
    // streaming, a draft, attachment, or answered inquiry must keep Send
    // visible so the next turn can enter the queue.
    private property <bool> stop-action: root.generating && root.draft == ""
        && root.attachments.length == 0 && !root.inquiry-ready;
    private property <string> permission-label: root.permission-mode == "auto_edit" ? I18n.cp_permission_write
        : root.permission-mode == "suggest" ? I18n.cp_permission_command
        : I18n.cp_permission_full;
    // The native Winit filter uses these window-local rectangles to dismiss
    // popovers without putting a full-window TouchArea above the real controls.
    // Keeping the geometry in Slint means DPI and responsive layout changes do
    // not require a second coordinate system in Rust.
    out property <bool> popover-open: root.plus-open || root.model-open;
    out property <bool> plus-open-state: root.plus-open;
    out property <bool> model-open-state: root.model-open;
    out property <length> plus-trigger-x: plus-btn.absolute-position.x;
    out property <length> plus-trigger-y: plus-btn.absolute-position.y;
    out property <length> plus-trigger-width: plus-btn.width;
    out property <length> plus-trigger-height: plus-btn.height;
    out property <length> plus-menu-x: root.plus-open ? plus_menu.absolute-position.x : -1px;
    out property <length> plus-menu-y: root.plus-open ? plus_menu.absolute-position.y : -1px;
    out property <length> plus-menu-width: root.plus-open ? plus_menu.width : 0px;
    out property <length> plus-menu-height: root.plus-open ? plus_menu.height : 0px;
    out property <length> model-trigger-x: model-picker.absolute-position.x;
    out property <length> model-trigger-y: model-picker.absolute-position.y;
    out property <length> model-trigger-width: model-picker.width;
    out property <length> model-trigger-height: model-picker.height;
    out property <length> model-menu-x: root.model-open ? model-picker.menu-x : -1px;
    out property <length> model-menu-y: root.model-open ? model-picker.menu-y : -1px;
    out property <length> model-menu-width: root.model-open ? model-picker.menu-width : 0px;
    out property <length> model-menu-height: root.model-open ? model-picker.menu-height : 0px;
    out property <length> command-menu-x: root.command-open ? command_flyout.absolute-position.x : -1px;
    out property <length> command-menu-y: root.command-open ? command_flyout.absolute-position.y : -1px;
    out property <length> command-menu-width: root.command-open ? command_flyout.width : 0px;
    out property <length> command-menu-height: root.command-open ? command_flyout.height : 0px;
    out property <length> preset-menu-x: root.preset-open ? preset_flyout.absolute-position.x : -1px;
    out property <length> preset-menu-y: root.preset-open ? preset_flyout.absolute-position.y : -1px;
    out property <length> preset-menu-width: root.preset-open ? preset_flyout.width : 0px;
    out property <length> preset-menu-height: root.preset-open ? preset_flyout.height : 0px;
    out property <length> permission-menu-x: root.permission-open ? permission_flyout.absolute-position.x : -1px;
    out property <length> permission-menu-y: root.permission-open ? permission_flyout.absolute-position.y : -1px;
    out property <length> permission-menu-width: root.permission-open ? permission_flyout.width : 0px;
    out property <length> permission-menu-height: root.permission-open ? permission_flyout.height : 0px;
    out property <length> screenshot-menu-x: root.screenshot-open ? screenshot_flyout.absolute-position.x : -1px;
    out property <length> screenshot-menu-y: root.screenshot-open ? screenshot_flyout.absolute-position.y : -1px;
    out property <length> screenshot-menu-width: root.screenshot-open ? screenshot_flyout.width : 0px;
    out property <length> screenshot-menu-height: root.screenshot-open ? screenshot_flyout.height : 0px;
    // Actual editor bounds for the Winit touch filter. This lets the native
    // layer handle a second touch after the editor already has focus without
    // adding an input-catching layer over TextInput.
    out property <length> editor-x: editor.absolute-position.x;
    out property <length> editor-y: editor.absolute-position.y;
    out property <length> editor-width: editor.width;
    out property <length> editor-height: editor.height;
    public function dismiss-popovers() {
        root.model-open = false;
        root.plus-open = false;
        root.close-submenus();
    }
    // Popover bookkeeping: the plus menu and its cascading flyouts are mutually
    // exclusive with the model popover, mirroring the web menu's single-open
    // behaviour.
    function close-submenus() {
        root.command-open = false;
        root.preset-open = false;
        root.permission-open = false;
        root.screenshot-open = false;
    }
    // 对齐蜂巢 chat-footer (background: transparent; border-top: 0): the band
    // itself paints nothing, so the white rounded input card is the only
    // surface — no white rectangular frame around it.
    background: transparent;
    VerticalLayout {
        padding: 14px; padding-top: 8px; padding-bottom: 10px; spacing: 6px;
        if root.queue-open : QueueStrip {
            turns: root.queue-turns;
            overflow: root.queue-overflow;
            interject(queue-id) => { root.queue-interject(queue-id); }
            edit(queue-id) => { root.queue-edit(queue-id); }
            remove(queue-id) => { root.queue-remove(queue-id); }
            move-by(queue-id, delta) => { root.queue-move-by(queue-id, delta); }
        }
        if root.attachments.length > 0 : HorizontalLayout {
            height: 30px; spacing: 6px;
            for attachment[index] in root.attachments : Rectangle {
                width: 220px; height: 28px;
                border-radius: Theme.radius-sm; background: Theme.accent-soft; border-width: 1px; border-color: Theme.border;
                Text { x: 8px; width: parent.width - 34px; height: parent.height; text: attachment.name; color: Theme.text; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                Action { x: parent.width - 27px; y: 2px; width: 24px; height: 24px; icon: @image-url("../assets/icons/xmark.svg"); label: I18n.cp_remove_attachment; clicked => { root.remove-attachment(index); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // The editor owns the input card's background, border and focus ring,
        // so there is one rounded surface and no rectangular frame around it.
        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            border-width: 0px;
            editor := TextEditBase {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                border-radius: 16px;
                background: Theme.surface;
                border-width: 1px;
                border-color: self.has-focus ? Theme.accent : Theme.border;
                scroll-view-padding: 14px;
                accessible-role: text-input;
                accessible-value <=> self.text;
                accessible-placeholder-text: self.placeholder-text;
                accessible-action-set-value(value) => { self.text = value; }
                foreground: Theme.text;
                placeholder-text: root.workspace-name != "" ? I18n.cp_input_placeholder_workspace(root.workspace-name) : I18n.cp_input_placeholder;
                placeholder-color: Theme.muted;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text;
                font-size: 14px; font-family: "SimSun";
                wrap: word-wrap;
                key-pressed(event) => {
                // ArrowUp / ArrowDown recall the messages this thread already
                // sent (Slint's key code points: U+F700 up, U+F701 down). The
                // caret test needs byte offsets, so Rust owns the decision, the
                // walk index and the stash; `handled` is what eats the key.
                if event.text == "\u{F700}" || event.text == "\u{F701}" {
                    let recalled = root.recall-history(
                        event.text == "\u{F700}" ? 1 : -1,
                        self.cursor-offset, self.anchor-offset, root.draft);
                    if recalled.handled {
                        root.draft = recalled.text;
                        self.set-selection-offsets(recalled.caret, recalled.caret);
                        return accept;
                    }
                    return reject;
                }
                // The send key preference: "enter" sends on plain Enter;
                // "ctrl_enter" sends only with Ctrl+Enter; "none" leaves all
                // newlines to the editor and sends via the button only.
                if event.text == "\n" && !event.modifiers.shift && !event.modifiers.control {
                    if root.send-key == "enter" && root.send-enabled { root.send(); }
                    return root.send-key == "enter" ? accept : reject;
                }
                if event.text == "\n" && event.modifiers.control {
                    if root.send-key == "ctrl_enter" && root.send-enabled { root.send(); return accept; }
                    return reject;
                }
                return reject;
                }
            }
            // A small in-editor state cue makes recording/transcription visible
            // without changing the composer's height or covering the typing
            // area. The status stays in the corner while the editor remains
            // available for normal selection and input.
            if root.recording || root.transcribing : Rectangle {
                x: parent.width - self.width - 12px; y: 8px;
                width: recording-state.preferred-width + 20px; height: 22px;
                border-radius: 11px;
                background: Theme.panel;
                border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
                    spacing: 5px;
                    Rectangle {
                        width: 6px; height: 6px; border-radius: 3px;
                        background: root.recording ? Theme.danger : Theme.muted;
                    }
                    recording-state := Text {
                        width: self.preferred-width; height: parent.height;
                        text: root.transcribing ? I18n.st_transcribing
                            : I18n.st_recording_hint + " · " + root.recording-elapsed;
                        color: root.recording ? Theme.danger : Theme.muted;
                        font-size: Theme.font-xs; vertical-alignment: center;
                    }
                }
            }
        }
        // ---- action row (§8.2), 对齐蜂巢 composer-action-row: the bordered
        // plus square opens the single merged menu, the workspace status bar
        // sits beside it, and the right side carries the merged model trigger
        // and the send square. ----
        HorizontalLayout {
            height: 30px; spacing: 6px;
            Rectangle {
                width: 24px; height: 30px;
                plus-btn := Rectangle {
                    y: 3px; width: 24px; height: 24px;
                    border-radius: Theme.radius-sm;
                    background: root.plus-open ? Theme.accent-soft : Theme.surface;
                    border-width: 1px;
                    border-color: root.plus-open ? Theme.accent-secondary : Theme.border-strong;
                    drop-shadow-color: #1F23290F; drop-shadow-blur: 2px; drop-shadow-offset-y: 1px;
                    Image {
                        x: 4px; y: 4px; width: 16px; height: 16px;
                        source: root.plus-open ? @image-url("../assets/icons/xmark.svg") : @image-url("../assets/icons/plus-plain.svg");
                        colorize: root.plus-open ? Theme.accent : Theme.text-secondary;
                        image-fit: contain;
                    }
                    accessible-role: button; accessible-label: I18n.cp_more;
                    accessible-action-default => {
                        root.plus-open = !root.plus-open;
                        root.model-open = false;
                        root.close-submenus();
                    }
                    plus-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.plus-open = !root.plus-open;
                            root.model-open = false;
                            root.close-submenus();
                        }
                    }
                }
                // Typed "/" still expands the command list in place whenever
                // the menu itself is closed.
                if !root.plus-open && root.draft == "/" : CommandFlyout {
                    x: 0px; y: -self.height - 8px; z: 30;
                    pick(value) => { root.draft = value; editor.focus(); }
                }
                plus_menu := Rectangle {
                    visible: root.plus-open;
                    x: 0px;
                    y: -self.height - 8px;
                    width: 220px;
                    height: menu-body.preferred-height;
                    z: 30;
                    border-radius: Theme.radius-lg; background: Theme.surface;
                    border-width: 1px; border-color: Theme.border;
                    drop-shadow-color: #00000024; drop-shadow-blur: 16px; drop-shadow-offset-y: 3px;
                        menu-body := VerticalLayout {
                            padding: 6px; spacing: 2px;
                            // 命令: the slash list cascades out of the row.
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: root.command-open || cmd-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.cp_commands;
                                Image { x: 8px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/icons/terminal.svg"); colorize: Theme.text-secondary; image-fit: contain; }
                                Text { x: 32px; width: parent.width - 44px; height: parent.height; text: I18n.cp_commands; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                Image { x: parent.width - 17px; y: 12px; width: 9px; height: 9px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted; image-fit: contain; }
                                cmd-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.command-open = !root.command-open;
                                        root.preset-open = false;
                                        root.permission-open = false;
                                        root.screenshot-open = false;
                                    }
                                }
                                command_flyout := CommandFlyout {
                                    visible: root.command-open;
                                    x: parent.width + 12px;
                                    y: parent.height + 7px - self.height;
                                    z: 2;
                                    pick(value) => { root.plus-open = false; root.draft = value; editor.focus(); }
                                }
                            }
                            // 预设问题
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: root.preset-open || preset-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.ag_preset_questions;
                                Image { x: 8px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/icons/wand-magic-sparkles.svg"); colorize: Theme.text-secondary; image-fit: contain; }
                                Text { x: 32px; width: parent.width - 44px; height: parent.height; text: I18n.ag_preset_questions; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                Image { x: parent.width - 17px; y: 12px; width: 9px; height: 9px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted; image-fit: contain; }
                                preset-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.preset-open = !root.preset-open;
                                        root.command-open = false;
                                        root.permission-open = false;
                                        root.screenshot-open = false;
                                    }
                                }
                                preset_flyout := PresetFlyout {
                                    visible: root.preset-open;
                                    questions: root.preset-questions;
                                    x: parent.width + 12px;
                                    y: parent.height + 7px - self.height;
                                    z: 2;
                                    pick(value) => { root.plus-open = false; root.draft = value; editor.focus(); }
                                }
                            }
                            // 审批模式: the row carries the current mode, the flyout
                            // switches it.
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: root.permission-open || perm-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.cp_permission;
                                Image { x: 8px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/icons/shield.svg"); colorize: root.permission-mode == "full_auto" ? Theme.muted : Theme.accent; image-fit: contain; }
                                Text { x: 32px; width: parent.width - 110px; height: parent.height; text: I18n.cp_permission; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                Text {
                                    x: parent.width - 78px; width: 56px; height: parent.height;
                                    text: root.permission-label;
                                    color: Theme.muted; font-size: Theme.font-xs;
                                    vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                                }
                                Image { x: parent.width - 17px; y: 12px; width: 9px; height: 9px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted; image-fit: contain; }
                                perm-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.permission-open = !root.permission-open;
                                        root.command-open = false;
                                        root.preset-open = false;
                                        root.screenshot-open = false;
                                    }
                                }
                                permission_flyout := PermissionFlyout {
                                    visible: root.permission-open;
                                    x: parent.width + 12px;
                                    y: parent.height + 7px - self.height;
                                    z: 2;
                                    mode: root.permission-mode;
                                    changed(value) => {
                                        root.permission-mode = value;
                                        root.permission-changed(value);
                                        root.permission-open = false;
                                    }
                                }
                            }
                            // 语音输入: direct action; the row flips to a stop glyph
                            // and the elapsed timer while capturing.
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: voice-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.cp_voice_input;
                                Image {
                                    x: 8px; y: 9px; width: 16px; height: 16px;
                                    source: root.recording ? @image-url("../assets/icons/stop.svg") : @image-url("../assets/icons/microphone.svg");
                                    colorize: root.recording ? Theme.danger : Theme.text-secondary;
                                    image-fit: contain;
                                }
                                Text { x: 32px; width: parent.width - 110px; height: parent.height; text: I18n.cp_voice_input; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                if root.transcribing : Text {
                                    x: parent.width - 78px; width: 62px; height: parent.height;
                                    text: I18n.cp_transcribing;
                                    color: Theme.muted; font-size: Theme.font-xs;
                                    vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                                }
                                if root.recording : Text {
                                    x: parent.width - 78px; width: 62px; height: parent.height;
                                    text: root.recording-elapsed;
                                    color: Theme.danger; font-size: Theme.font-xs; font-weight: 600;
                                    vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                                }
                                voice-row-touch := TouchArea {
                                    enabled: !root.transcribing;
                                    mouse-cursor: pointer;
                                    clicked => { root.record-voice(); }
                                }
                            }
                            // 截图
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: root.screenshot-open || shot-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.cp_screenshot;
                                Image { x: 8px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/icons/camera.svg"); colorize: Theme.text-secondary; image-fit: contain; }
                                Text { x: 32px; width: parent.width - 44px; height: parent.height; text: I18n.cp_screenshot; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                Image { x: parent.width - 17px; y: 12px; width: 9px; height: 9px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Theme.muted; image-fit: contain; }
                                shot-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.screenshot-open = !root.screenshot-open;
                                        root.command-open = false;
                                        root.preset-open = false;
                                        root.permission-open = false;
                                    }
                                }
                                screenshot_flyout := ScreenshotFlyout {
                                    visible: root.screenshot-open;
                                    x: parent.width + 12px;
                                    y: parent.height + 7px - self.height;
                                    z: 2;
                                    pick(hide, region) => { root.plus-open = false; root.screenshot(hide, region); }
                                }
                            }
                            // 终端: opens the supplement's Git Bash console.
                            Rectangle {
                                height: 34px; border-radius: Theme.radius-sm;
                                background: term-row-touch.has-hover ? Theme.hover : transparent;
                                accessible-role: list-item; accessible-label: I18n.cp_terminal_mode;
                                Image { x: 8px; y: 9px; width: 16px; height: 16px; source: @image-url("../assets/icons/fa-display.svg"); colorize: Theme.text-secondary; image-fit: contain; }
                                Text { x: 32px; width: parent.width - 44px; height: parent.height; text: I18n.cp_terminal_mode; color: Theme.text; font-size: Theme.font-md; vertical-alignment: center; overflow: elide; }
                                term-row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.plus-open = false; root.launch-terminal(); }
                                }
                            }
                        }
                }
            }
            // 工作目录状态栏（对齐蜂巢 ComposerStatusBar）。
            Rectangle {
                height: 30px;
                width: min(ws-text.preferred-width, 160px) + 22px;
                visible: root.workspace-name != "";
                Image { x: 5px; y: 9px; width: 12px; height: 12px; source: @image-url("../assets/icons/folder-open.svg"); colorize: Theme.accent; image-fit: contain; }
                ws-text := Text {
                    x: 22px; width: min(self.preferred-width, 160px); height: parent.height;
                    text: root.workspace-name; color: Theme.text-secondary; font-size: Theme.font-sm;
                    vertical-alignment: center; overflow: elide;
                }
            }
            // Slack absorber, not decoration: without one stretchable item the
            // row reports a fixed implicit width and the Window shrink-wraps
            // to it.
            Rectangle { horizontal-stretch: 1; }
            // Right: the merged model trigger (liquid brain gauge + model name
            // + effort), then the send square. Zero stretch keeps the picker at
            // its content width — the row's leftover space belongs to the
            // spacer, and a stretched picker would push the popover's right
            // edge past the trigger's.
            model-picker := ModelPicker {
                horizontal-stretch: 0;
                models: root.models;
                has-catalogue: root.model-catalogue-count > 0;
                current-name: root.model-name;
                current-key: root.model-key;
                cloud-ready: root.cloud-ready;
                context-usage: root.context-usage;
                context-known: root.context-known;
                context-counts: root.context-counts;
                effort <=> root.reasoning-effort;
                saving: root.model-saving;
                open <=> root.model-open;
                opened => {
                    root.plus-open = false;
                    root.close-submenus();
                }
                select-model(index, name) => { root.select-model(index, name); }
                effort-changed(value) => { root.reasoning-effort-changed(value); }
                open-settings => { root.open-model-settings(); }
            }
            // While a reply streams, the square itself becomes the stop action;
            // the editor remains available and Enter sends the next queued turn.
            Rectangle {
                width: 28px; height: 30px;
                send-btn := Rectangle {
                    y: 1px; width: 28px; height: 28px;
                    border-radius: Theme.radius-sm;
                    background: root.stop-action
                        ? (root.stopping ? Theme.border-strong : Theme.accent)
                        : (root.send-enabled ? (send-touch.has-hover ? Theme.accent-deep : Theme.accent) : Theme.border-strong);
                    Image {
                        // The FA stop glyph is a full-bleed square; a 12px
                        // contain box yields a 10.5px mark, matching the web
                        // client's 12px font-size stop icon. The arrow keeps
                        // the 16px box.
                        x: root.stop-action ? 8px : 6px;
                        y: root.stop-action ? 8px : 6px;
                        width: root.stop-action ? 12px : 16px;
                        height: root.stop-action ? 12px : 16px;
                        source: root.stop-action ? @image-url("../assets/icons/stop.svg") : @image-url("../assets/icons/arrow-up.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                    accessible-role: button;
                    accessible-label: root.stop-action ? I18n.cp_stop_generation : I18n.cp_send;
                    accessible-action-default => {
                        if root.stop-action {
                            if !root.stopping { root.stop(); }
                        } else if root.send-enabled {
                            root.send();
                        }
                    }
                    send-touch := TouchArea {
                        enabled: root.stop-action ? !root.stopping : root.send-enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            if root.stop-action { root.stop(); } else { root.send(); }
                        }
                    }
                }
            }
        }
        // ---- status line (§8.5): branch only, and only while a branch is
        // known — an empty row would sit between the action row and the shell
        // edge as dead space. The context gauge lives in the model trigger's
        // brain glyph. ----
        if root.branch-name != "" : HorizontalLayout {
            height: 16px; spacing: 6px;
            Image {
                y: 2px; width: 12px; height: 12px;
                source: @image-url("../assets/icons/fa-code-branch.svg"); colorize: Theme.muted; image-fit: contain;
            }
            Text {
                height: parent.height; width: self.preferred-width;
                text: root.branch-name; color: Theme.muted; font-size: Theme.font-xs;
                vertical-alignment: center; overflow: elide;
            }
            // Slack absorber, not decoration: a row whose children are all rigid
            // reports a fixed implicit width, and that travels up to the Window,
            // which then sizes itself to the content and leaves the rest of the
            // screen empty. Every row in the width chain needs one stretchable item.
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
