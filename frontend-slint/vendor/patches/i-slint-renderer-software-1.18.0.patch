+    let glyph_set = core::ptr::from_ref(glyphs);
+    PACKED_GLYPH_CACHE.with(|cache| {
+        let mut cache = cache.borrow_mut();
+        if let Some(alpha_map) = cache.get(glyph_set, glyph_index) {
+            return GlyphAlphaMap::Shared(alpha_map);
+        }
