+pub(super) fn glyph_alpha_map(glyphs: &'static BitmapGlyphs, glyph_index: usize) -> GlyphAlphaMap {
+    let glyph = &glyphs.glyph_data[glyph_index];
+    if glyph.data_packing != 1 {
+        return GlyphAlphaMap::Static(glyph.data.as_slice());
+    }
