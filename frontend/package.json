    "test:message-stats": "node scripts/run-regression-tests.mjs message-stats-regression.test.ts",
    "test:tool-workflow-render-batcher": "node scripts/run-regression-tests.mjs tool-workflow-render-batcher-regression.test.ts",
    "test:tool-workflow-collapsed-summary": "node scripts/run-regression-tests.mjs tool-workflow-collapsed-summary-regression.test.ts",
    "test:message-conversation-retention": "node scripts/run-regression-tests.mjs message-conversation-retention-regression.test.ts",
    "test:message-virtual-window": "node scripts/run-regression-tests.mjs message-virtual-window-regression.test.ts",
    "test:stop-run-guard": "node scripts/run-regression-tests.mjs stop-run-guard-regression.test.ts",
    "test:chat-session-merge": "node scripts/run-regression-tests.mjs chat-session-merge-regression.test.ts",
    "test:message-render": "node scripts/run-regression-tests.mjs message-render-regression.test.ts",
    "test:workspace-refresh": "node scripts/run-regression-tests.mjs workspace-panel-refresh-regression.test.ts workspace-hydration-batch-regression.test.ts",
    "test:ability-visuals": "node scripts/run-regression-tests.mjs ability-visuals-regression.test.ts",
    "test:e2e:chat-bubble-stress": "playwright test tests/e2e/chat-bubble-stress-harness.spec.ts --workers=1",
    "test:chat-evidence": "node scripts/run-regression-tests.mjs chat-evidence-analysis-regression.test.ts assistant-failure-notice-regression.test.ts",
    "test:e2e:chat-durable-stream-performance": "playwright test tests/e2e/chat-durable-stream-performance.spec.ts --workers=1",
    "test:e2e:messenger-heavy-history": "playwright test tests/e2e/messenger-heavy-history-harness.spec.ts --workers=1",
    "test:e2e:messenger-view-performance": "playwright test tests/e2e/messenger-view-performance-harness.spec.ts --workers=1",
    "test:e2e:messenger-send-guard": "playwright test tests/e2e/messenger-send-guard-harness.spec.ts",
    "test:e2e:messenger-return-resume": "playwright test tests/e2e/messenger-return-resume-harness.spec.ts",
    "test:e2e:messenger-stability": "npm run test:e2e:messenger-send-guard && npm run test:e2e:messenger-return-resume",
    "typecheck:vue": "node ./scripts/run-vue-tsc.mjs --noEmit",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api-strict.json --pretty false",
    "test:realtime-pulse": "node scripts/run-regression-tests.mjs realtime-pulse-regression.test.ts",
    "test:chat-workflow-history": "node scripts/run-regression-tests.mjs chat-workflow-history-regression.test.ts tool-workflow-regression.test.ts tool-workflow-collapsed-summary-regression.test.ts",
    "test:chat-perf": "node scripts/run-regression-tests.mjs chat-perf-regression.test.ts",
    "test:chat-background-publication": "node scripts/run-regression-tests.mjs chat-background-publication-regression.test.ts",
    "test:e2e:chat": "playwright test tests/e2e/chat-user-lifecycle.spec.ts tests/e2e/chat-durable-stream-performance.spec.ts tests/e2e/chat-cancel-image-recovery.spec.ts tests/e2e/chat-scheduled-task.spec.ts --workers=1",
    "typecheck:chat-tests": "tsc -p tests/tsconfig.chat-evidence.json --noEmit",
    "test:chat": "npm run typecheck:chat-tests && npm run test:chat-thread-pipeline && npm run test:chat-evidence && npm run test:chat-workflow-history && npm run test:e2e:chat"
