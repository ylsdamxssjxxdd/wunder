// wunder 安卓版 — 上下文窗口详情覆盖层。
//
// 条目详情只显示该条目的正文；部位详情列出条目，点一行原位展开正文、再点收起。
// 口径与桌面版 `ContextWindowPanel` 的详情段一致；正文只从引擎内存缓存读，
// 释放后显示提示。覆盖层不撑高卡片。

import { Theme } from "../../../crates/wunder-desktop/frontend/ui/theme.slint";
import { I18n } from "../../../crates/wunder-desktop/frontend/ui/i18n.slint";
import { ScrollView } from "std-widgets.slint";
import { CtxItemRow, CtxColors, CtxText } from "context_common.slint";

export component ContextDetailPanel inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <string> detail-kind: "";
    in property <int> detail-slot: 0;
    in property <string> detail-tag: "";
    in property <string> detail-name: "";
    in property <int> detail-count: 0;
    in property <string> detail-value: "";
    in property <string> detail-pct: "";
    in property <[CtxItemRow]> detail-rows: [];
    in property <string> detail-text: "";
    in property <int> detail-row-open: -1;
    in property <string> detail-row-text: "";

    callback detail-dismissed();
    callback detail-row-toggle(int, int, string, string, int);

    background: Theme.panel;
    width: 100%;
    height: 100%;

    // 面板内容宽：显式喂给 ScrollView 的 content-width，否则内容宽塌到最小，
    // 行内 parent.width 全部失效（与桌面 detail-text-width 同一口径）。
    private property <length> detail-text-width: root.width - 32px;

    TouchArea {}

    VerticalLayout {
        spacing: 8px;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px + root.inset-top;
        padding-bottom: 12px + root.inset-bottom;

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                y: (parent.height - self.height) / 2;
                background: CtxColors.ink(root.detail-slot);
            }
            Text {
                // 标题锚定面板宽度，不参与右侧关闭按钮的留白竞争；窄卡也给足整行宽度。
                width: root.width - 84px;
                text: root.detail-kind == "part" ? CtxText.part(root.detail-slot)
                    : CtxText.item(root.detail-tag, root.detail-name, root.detail-count);
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 700;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 6px;
                background: close-hit.has-hover ? Theme.hover : transparent;
                Image {
                    x: 11px;
                    y: 11px;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/xmark.svg");
                    colorize: Theme.muted;
                    image-fit: contain;
                }
                close-hit := TouchArea {
                    clicked => { root.detail-dismissed(); }
                }
            }
        }

        Text {
            height: 18px;
            text: root.detail-kind == "part"
                ? root.detail-value + " token · " + root.detail-pct
                : CtxText.part(root.detail-slot) + " · " + root.detail-value + " token · " + root.detail-pct;
            color: Theme.muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { height: 1px; background: Theme.border; }

        if root.detail-kind == "item" && root.detail-text != "" : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: root.detail-text-width;
            VerticalLayout {
                width: 100%;
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 100%;
                    vertical-stretch: 0;
                    border-radius: 6px;
                    background: Theme.hover;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        Text {
                            width: 100%;
                            text: root.detail-text;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        if root.detail-kind == "item" && root.detail-text == "" : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: root.detail-text-width;
            Text {
                width: 100%;
                text: I18n.cx_text_released;
                color: Theme.muted;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
        }
        if root.detail-kind == "part" : ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: root.detail-text-width;
            VerticalLayout {
                width: 100%;
                spacing: 2px;
                alignment: start;
                for row in root.detail-rows : VerticalLayout {
                    spacing: 0px;
                    width: 100%;
                    Rectangle {
                        height: 30px;
                        width: 100%;
                        border-radius: 6px;
                        background: row-hit.has-hover || root.detail-row-open == row.item ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 12px;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Image {
                                width: 9px;
                                height: 9px;
                                source: root.detail-row-open == row.item
                                    ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-down.svg")
                                    : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-right.svg");
                                colorize: Theme.muted;
                                image-fit: contain;
                            }
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: CtxColors.ink(row.slot);
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: CtxText.item(row.tag, row.name, row.count);
                                color: Theme.text;
                                font-size: Theme.font-sm;
                                font-weight: 500;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                            if row.count > 1 && (row.tag == "tool" || row.tag == "result") : Text {
                                width: 34px;
                                text: "×" + row.count;
                                color: Theme.muted;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            if root.width >= 420px : Rectangle {
                                width: 72px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.selected;
                                Rectangle {
                                    width: max(2px, parent.width * row.ratio);
                                    height: parent.height;
                                    border-radius: 2px;
                                    background: CtxColors.ink(row.slot);
                                }
                            }
                            Text {
                                width: 72px;
                                text: row.tokens-text;
                                color: Theme.text-secondary;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                        row-hit := TouchArea {
                            clicked => {
                                root.detail-row-toggle(row.item, row.slot, row.tag, row.name, row.count);
                            }
                        }
                    }
                    if root.detail-row-open == row.item : Rectangle {
                        width: root.detail-text-width;
                        border-radius: 6px;
                        background: Theme.hover;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            if root.detail-row-text != "" : Text {
                                width: 100%;
                                text: root.detail-row-text;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                            if root.detail-row-text == "" : Text {
                                width: 100%;
                                text: I18n.cx_text_released;
                                color: Theme.muted;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
