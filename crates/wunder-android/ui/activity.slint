// 模型浮层里的「后台任务 / 子智能体」区块。
//
// 桌面版把这两块挂在输入区的两个悬停浮层上（host_hud.slint 的任务面板、
// subagent_dock.slint 的子智能体面板）；手机没有悬停，也没有独立的输入区状态
// 行，所以收进点模型选项后呼出的浮层，紧跟上下文占用。数据是同两套投影
// （CommandTask / SubagentItem），这里只按手机宽度重排：
// - 任务一行：命令 + 已运行时长 + 终止键；
// - 子智能体一张小卡：标题 / 状态、最近一行汇报、耗时·额度·上下文，运行时
//   右侧带中断键。
// Rows are capped in Rust (activity.rs); the overflow line closes the list.

import { Theme, CommandTask, SubagentItem } from "../../../crates/wunder-desktop/frontend/ui/theme.slint";
import { I18n } from "../../../crates/wunder-desktop/frontend/ui/i18n.slint";

// 区块标题：左边是名称，右边是计数（与桌面版浮层的标题行同一口径）。
component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> note;

    height: 24px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.note;
            color: Theme.muted;
            font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
    }
}

// 列表收口：浮层只列前几条，余下用这一行说明，避免用户以为只有两条。
component OverflowNote inherits Rectangle {
    in property <string> text;

    height: 18px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
    }
}

// 终止键：20px 图标位包在 30px 触摸区里，命中的是整格而不是小图标。
component StopButton inherits Rectangle {
    in property <string> tip;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-tag;
    background: stop-touch.has-hover ? Theme.danger-bg : transparent;

    Image {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/xmark.svg");
        colorize: stop-touch.has-hover ? Theme.danger : Theme.muted;
        image-fit: contain;
    }
    stop-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.tip;
}

// 一条运行中的命令：命令压成一行，时长在右，末尾是终止键。
component TaskLine inherits Rectangle {
    in property <CommandTask> task;
    callback stop(string);

    height: 38px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;
        cross-axis-alignment: center;
        Image {
            width: 14px;
            height: 14px;
            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/terminal.svg");
            colorize: Theme.accent-ink;
            image-fit: contain;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.task.command;
            color: Theme.text;
            font-size: Theme.font-xs;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.task.elapsed;
            color: Theme.muted;
            font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
        StopButton {
            tip: I18n.hud_tasks_stop;
            clicked => { root.stop(root.task.id); }
        }
    }
}

// 子智能体统计的一位：12px 图标 + 数值，与转录区气泡底部的统计行同形。
component Stat inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <string> hint;

    width: stat-row.preferred-width;
    height: 14px;
    accessible-role: text;
    accessible-label: root.hint;

    stat-row := HorizontalLayout {
        spacing: 3px;
        alignment: start;
        Image {
            width: 11px;
            height: 14px;
            source: root.icon;
            colorize: Theme.muted;
            image-fit: contain;
        }
        Text {
            text: root.value;
            color: Theme.text-secondary;
            font-size: Theme.font-2xs;
            vertical-alignment: center;
        }
    }
}

// 一个子智能体：状态点 + 标题 + 状态字；下一行是最近汇报；最后一行只留
// 耗时 / 额度 / 上下文三个数字（与桌面版浮层一致，标签只进无障碍描述）。
component SubagentLine inherits Rectangle {
    in property <SubagentItem> item;
    callback stop(string);

    height: 60px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 3px;

            HorizontalLayout {
                height: 16px;
                spacing: 6px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.item.status-kind == 1 ? Theme.accent
                        : root.item.status-kind == 2 ? Theme.danger : Theme.success;
                }
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.item.title;
                    color: Theme.text;
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.item.status-kind == 1 ? I18n.sub_status_running
                        : root.item.status-kind == 2 ? I18n.sub_status_failed : I18n.sub_status_done;
                    color: root.item.status-kind == 1 ? Theme.accent-ink
                        : root.item.status-kind == 2 ? Theme.danger : Theme.muted;
                    font-size: Theme.font-2xs;
                    vertical-alignment: center;
                }
            }

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                height: 14px;
                text: root.item.summary;
                color: Theme.muted;
                font-size: Theme.font-2xs;
                vertical-alignment: center;
                overflow: elide;
                visible: root.item.summary != "";
            }

            HorizontalLayout {
                height: 14px;
                spacing: 10px;
                alignment: start;
                Stat {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/stopwatch.svg");
                    value: root.item.duration;
                    hint: I18n.sub_stat_duration + " " + root.item.duration;
                }
                Stat {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/coins.svg");
                    value: root.item.credits;
                    hint: I18n.sub_stat_credits + " " + root.item.credits;
                }
                Stat {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/layer-group.svg");
                    value: root.item.context;
                    hint: I18n.sub_stat_context + " " + root.item.context;
                }
            }
        }

        if root.item.stoppable : StopButton {
            tip: I18n.hud_subagents_stop;
            clicked => { root.stop(root.item.id); }
        }
    }
}

// 整块：任务段在前（用户发起、正在占用本机），子智能体段在后。两段都为空时
// 高度为 0，浮层保持原来的高度。
export component MobileActivityBlock inherits VerticalLayout {
    in property <[CommandTask]> tasks: [];
    in property <int> task-count: 0;
    in property <[SubagentItem]> subagents: [];
    in property <int> subagent-count: 0;
    callback stop-task(string);
    callback stop-subagent(string);

    private property <int> task-hidden: max(root.task-count - root.tasks.length, 0);
    private property <int> subagent-hidden: max(root.subagent-count - root.subagents.length, 0);

    spacing: 0px;

    if root.task-count > 0 : SectionTitle {
        title: I18n.hud_tasks_title;
        note: I18n.hud_tasks_count("" + root.task-count);
    }
    for task in root.tasks : TaskLine {
        task: task;
        stop(id) => { root.stop-task(id); }
    }
    if root.task-count > 0 && root.task-hidden > 0 : OverflowNote {
        text: I18n.hud_tasks_more("" + root.task-hidden);
    }
    // 两段之间留 4px：收口行与下一段标题贴在一起会读成同一条目。
    if root.task-count > 0 && root.subagent-count > 0 : Rectangle {
        height: 4px;
    }
    if root.subagent-count > 0 : SectionTitle {
        title: I18n.hud_subagents_title;
        note: I18n.hud_subagents_count("" + root.subagent-count);
    }
    for item in root.subagents : SubagentLine {
        item: item;
        stop(id) => { root.stop-subagent(id); }
    }
    if root.subagent-count > 0 && root.subagent-hidden > 0 : OverflowNote {
        text: I18n.hud_subagents_more("" + root.subagent-hidden);
    }
    // 区块与下面的模型列表之间补一条分隔线：两段都有内容时浮层里会连着出现
    // 三组列表，没有分隔会读成一整片。
    if root.task-count > 0 || root.subagent-count > 0 : Rectangle {
        height: 1px;
        background: Theme.border;
    }
}
