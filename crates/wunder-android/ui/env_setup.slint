// 首次启动的运行环境部署引导页（安卓版）：全屏不透明，安装过程用「注入 LCL
// 液体」呈现——液面随进度从底部漫上来，波浪、气泡与高光由引擎 tick 的相位驱动。
// 安装状态由引擎投影，页面只负责呈现。

import { I18n } from "../../../crates/wunder-desktop/frontend/ui/i18n.slint";
import { Theme } from "../../../crates/wunder-desktop/frontend/ui/theme.slint";

// 主操作：强调色按钮。
component SetupButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 44px;
    border-radius: Theme.radius-md;
    background: button-touch.pressed || button-touch.has-hover ? Theme.accent-deep : Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: #ffffff;
        font-size: Theme.font-md;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 次要操作：纯文字按钮。
component SetupTextButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 40px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: #6E5137;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component EnvSetupPage inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // missing / installing / error / installed
    in property <string> state: "installing";
    in property <int> progress: 0;
    in property <string> stage: "";
    in property <string> error: "";
    // 单调推进的相位（以 4s 波浪周期为单位，不取模），由引擎 tick 驱动。
    // 波浪用 wrap(phase) 平移无缝循环；气泡 travel=wrap(phase*speed) 必须靠
    // 相位单调才能连续上升——若相位取模成 0..1 锯齿，非整数速度的气泡会在
    // 周期边界瞬移回底部，上升到一半突然重置。
    in property <float> phase: 0.0;
    callback retry();
    callback dismiss();

    background: @linear-gradient(180deg, #FCFAF7 0%, #F4ECE2 100%);
    private property <bool> failed: root.state == "error";
    private property <bool> ready: root.state == "installed";
    private property <int> clamped: min(100, max(0, root.progress));
    private property <float> fill: root.ready ? 1.0 : root.clamped / 100.0;
    // 液面位置：0% 时沉在屏幕底缘下方，100% 时漫出顶部。整条液面（填充、
    // 高光、气泡）共用这一份缓动值，分别做动画会让高光落后于实际液面。
    private property <length> surface-y: root.height - (root.height + 40px) * root.fill;
    animate surface-y { duration: 850ms; easing: ease-in-out; }
    // 百分比跟随实际液面而不是目标进度：数字与液面同步涨落，不会数字先到
    // 100% 而液体还在追赶。
    private property <int> shown: round(
        min(1.0, max(0.0, (root.height - root.surface-y) / (root.height + 40px))) * 100.0);
    // 路径命令按像素插值，长度不能直接进字符串，先转成无单位浮点。
    private property <float> w: root.width / 1px;
    private property <float> h: root.height / 1px;

    pure function wrap(value: float) -> float {
        return value - floor(value);
    }

    // 伪随机散布：x 与相位各用一套「线性 + 二次」系数，避免两者线性相关
    // 导致气泡连成斜线。
    pure function scatter(i: int, linear: float, quad: float, offset: float) -> float {
        let n = i * 1.0;
        return root.wrap(n * linear + n * n * quad + offset);
    }

    // 两个完整周期的波形；整段平移一个周期即可无缝循环。
    pure function wave-line() -> string {
        return "M 0 10 C \{root.w * 0.125} 0 \{root.w * 0.375} 20 \{root.w * 0.5} 10 C \{root.w * 0.625} 0 \{root.w * 0.875} 20 \{root.w} 10 C \{root.w * 1.125} 0 \{root.w * 1.375} 20 \{root.w * 1.5} 10 C \{root.w * 1.625} 0 \{root.w * 1.875} 20 \{root.w * 2} 10";
    }

    // 波形闭合到指定高度，形成从液面到该深度的液体填充。
    pure function wave-body(bottom: float) -> string {
        return root.wave-line() + " L \{root.w * 2} \{bottom} L 0 \{bottom} Z";
    }

    // 只填充高出基线的波峰，用于后层波浪：水下不留色带。
    pure function wave-crest() -> string {
        return root.wave-line() + " L \{root.w * 2} 10 L 0 10 Z";
    }

    // 铺满一层触摸面挡住聊天界面的事件穿透；内容与按钮声明在它之后（上层）。
    block := TouchArea {
        width: 100%;
        height: 100%;
    }

    // ---- LCL 液体 ------------------------------------------------------
    // 后层波峰：相位更快、颜色更浅，只画高出主液面的部分，形成层次且
    // 不会在水下留下一条横向色带。
    back-wave := Path {
        visible: root.fill > 0.002;
        x: -root.width * root.wrap(root.phase * 1.35 + 0.27) - 1px;
        y: root.surface-y - 16px;
        width: root.width * 2;
        height: 24px;
        commands: root.wave-crest();
        fill: #FFD9A0;
        opacity: 0.5;
    }
    // 主液面：从液面一直填到屏幕下方。Path 填充不支持渐变，主体用纯色，
    // 深度交给下面贴着液面的矩形渐变。
    wave := Path {
        visible: root.fill > 0.002;
        x: -root.width * root.wrap(root.phase) - 1px;
        y: root.surface-y - 10px;
        width: root.width * 2;
        height: root.height + 80px;
        commands: root.wave-body(root.h + 80.0);
        fill: #FFC46B;
        opacity: 0.72;
    }
    // 水体深度：从液面下方开始由透明渐入深橙，顶部无接缝。
    Rectangle {
        visible: root.fill > 0.002;
        x: 0px;
        y: root.surface-y + 10px;
        width: 100%;
        height: root.height - root.surface-y;
        background: @linear-gradient(180deg, #E36A0500 0%, #E36A0555 60%, #E36A0599 100%);
    }
    // 气泡：贯穿整层液体，底部淡入、贴近液面淡出，循环时不会突然消失。
    for i in 9 : Rectangle {
        private property <float> travel: root.wrap(
            root.phase * (0.35 + Math.mod(i, 3) * 0.16)
            + root.scatter(i, 0.4142, 0.0069, 0.53));
        private property <length> size: 6px + 3px * Math.mod(i, 3);
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        x: root.width * (0.06 + 0.88 * root.scatter(i, 0.618, 0.0041, 0.07)) - self.width / 2
            + (1.0 - abs(2.0 * root.wrap(root.phase + i * 0.11) - 1.0)) * 12px - 6px;
        y: root.height - self.travel * (root.height - root.surface-y) - self.height;
        background: #FFF8EA;
        border-width: 1px;
        border-color: #FFE3B8;
        opacity: root.fill > 0.03
            ? 0.55 * min(1.0, self.travel * 5.0) * min(1.0, (1.0 - self.travel) * 5.0)
            : 0.0;
    }
    // 注满后的气泡潮：像汽水开盖一样，密集的小气泡高速涌上来。
    for i in 120 : Rectangle {
        private property <float> travel: root.wrap(
            root.phase * (7.0 + Math.mod(i, 5) * 1.1)
            + root.scatter(i, 0.4142, 0.0069, 0.53));
        private property <length> size: 3px + 2px * Math.mod(i, 4);
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        x: root.width * (0.04 + 0.92 * root.scatter(i, 0.618, 0.0041, 0.07)) - self.width / 2;
        y: root.height - self.travel * (root.height - root.surface-y) - self.height;
        background: #FFF8EA;
        border-width: 1px;
        border-color: #FFE3B8;
        opacity: root.ready
            ? 0.85 * min(1.0, self.travel * 6.0) * min(1.0, (1.0 - self.travel) * 6.0)
            : 0.0;
    }

    // ---- 内容 ----------------------------------------------------------
    VerticalLayout {
        y: root.inset-top;
        height: parent.height - root.inset-top - root.inset-bottom;
        padding-left: 32px;
        padding-right: 32px;
        alignment: center;
        spacing: 0px;

        HorizontalLayout {
            alignment: center;
            Image {
                width: 88px;
                height: 88px;
                source: @image-url("../../../images/eva01-head.svg");
                image-fit: contain;
            }
        }
        Rectangle { height: 20px; }
        if root.failed || root.ready : Text {
            text: root.failed ? I18n.and_env_setup_failed : I18n.and_env_setup_ready;
            color: root.failed ? Theme.danger : Theme.text;
            font-size: Theme.font-headline;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if !root.ready : Rectangle { height: 26px; }

        // ---- 安装中：注入进度 ----
        if !root.failed && !root.ready : VerticalLayout {
            spacing: 0px;
            Text {
                text: root.shown + "%";
                color: #8A3E05;
                font-size: 46px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle { height: 8px; }
            // 阶段文案保持深色：小字号在水面上方/下方都要可读，水下偏色只给
            // 大号百分比做。
            Text {
                text: root.state == "missing" ? I18n.and_env_setup_preparing : root.stage;
                color: #5E452C;
                font-size: Theme.font-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        // ---- 失败：原因 + 重试 / 先进入 ----
        if root.failed : VerticalLayout {
            spacing: 12px;
            Text {
                text: root.error != "" ? root.error : root.stage;
                color: Theme.danger;
                font-size: Theme.font-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            SetupButton {
                label: I18n.and_env_setup_retry;
                clicked => { root.retry(); }
            }
            SetupTextButton {
                label: I18n.and_env_setup_enter;
                clicked => { root.dismiss(); }
            }
        }

    }
}
