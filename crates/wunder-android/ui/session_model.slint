// Shared between the shell and its settings sheet: both render the same flat
// session-row projection. Keeping the struct in its own file avoids a module
// cycle between mobile.slint and settings.slint.

export struct MobileSession {
    id: string,
    title: string,
    /// Owning workspace name, projected for the archived-thread list.
    workspace: string,
    time: string,
    status: string,
    active: bool,
}

// One row of the settings permission manager. State labels are projected in
// Rust so Java only reports raw granted/denied values.
export struct MobilePermission {
    id: string,
    title: string,
    description: string,
    state-text: string,
    action-text: string,
    granted: bool,
    available: bool,
}

// One existing local archive on 设置 → 数据与恢复. The label is already a
// readable timestamp: the cache file name is a millisecond stamp.
export struct MobileBackup {
    path: string,
    name: string,
    detail: string,
}
