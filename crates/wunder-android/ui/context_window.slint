import { Theme } from "../../wunder-desktop/frontend/ui/theme.slint";
import { I18n } from "../../wunder-desktop/frontend/ui/i18n.slint";
import { Action } from "../../wunder-desktop/frontend/ui/components.slint";
import { ContextTileView } from "../../wunder-desktop/frontend/ui/context_tile.slint";
import { ContextDetailPanel } from "context_detail.slint";
import { CtxPartRow, CtxItemRow, ContextTile, CtxColors, CtxText } from "context_common.slint";
export { CtxPartRow, CtxItemRow, ContextTile }

component ContextLegendItem inherits Rectangle {
    in property <int> slot;
    callback activated();
    horizontal-stretch: 1;
    min-width: 0px;
    border-radius: 6px;
    background: hit.pressed ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 4px;
        cross-axis-alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: CtxColors.ink(root.slot);
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: CtxText.part(root.slot);
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            overflow: elide;
        }
    }
    hit := TouchArea {
        enabled: root.slot != 0;
        clicked => { root.activated(); }
    }
}

export component ContextWindowPage inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <[CtxPartRow]> parts: [];
    in property <[ContextTile]> tiles: [];
    in property <bool> has-data: false;
    in property <bool> measured: false;
    in property <string> used-text: "—";
    in property <string> capacity-text: "—";
    in property <string> free-text: "—";
    in property <string> pct-text: "";
    in property <string> model-label: "";
    in property <string> turns-text: "";
    // Detail panel opened from a tile.
    in property <bool> detail-open: false;
    in property <string> detail-kind: "";
    in property <int> detail-slot: 0;
    in property <string> detail-tag: "";
    in property <string> detail-name: "";
    in property <int> detail-count: 0;
    in property <string> detail-value: "";
    in property <string> detail-pct: "";
    in property <[CtxItemRow]> detail-rows: [];
    in property <string> detail-text: "";
    in property <int> detail-row-open: -1;
    in property <string> detail-row-text: "";

    callback back();
    callback legend-open(int);
    callback tile-open(int, string, string, int);
    callback map-resized(length, length);
    callback detail-row-toggle(int, int, string, string, int);
    callback detail-dismissed();

    background: Theme.panel;
    width: 100%;
    height: 100%;

    private property <bool> show-free: root.has-data && root.free-text != "0" && root.free-text != "—";

    TouchArea {}

    VerticalLayout {
        spacing: 0px;

        // ---- header -------------------------------------------------
        Rectangle {
            height: 52px + root.inset-top;
            background: Theme.surface;
            Rectangle {
                y: root.inset-top;
                height: 52px;
                width: parent.width;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    cross-axis-alignment: center;
                    Action {
                        width: 44px;
                        height: 44px;
                        icon-size: 17px;
                        show-label: false;
                        focus-ring: false;
                        tooltip: false;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-left.svg");
                        label: I18n.ap_back_chat;
                        clicked => { root.back(); }
                    }
                    Text {
                        text: I18n.cx_title;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 估算 / 已计量 标记。
                    Rectangle {
                        height: 18px;
                        width: state-text.preferred-width + 14px;
                        border-radius: 9px;
                        background: Theme.panel;
                        visible: root.has-data;
                        state-text := Text {
                            x: 0px;
                            width: 100%;
                            text: root.measured ? I18n.cx_measured : I18n.cx_estimate;
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 12px + root.inset-bottom;

            // ---- occupancy summary ---------------------------------
            if root.has-data || root.capacity-text != "—" : VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: root.used-text;
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 600;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: "/ " + root.capacity-text + " token";
                        color: Theme.muted;
                        font-size: Theme.font-sm;
                        vertical-alignment: bottom;
                    }
                }
                if root.has-data : Text {
                    text: I18n.cx_summary(root.pct-text, root.free-text, root.turns-text);
                    color: Theme.muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if root.model-label != "" : Text {
                    height: 16px;
                    text: root.model-label;
                    color: Theme.muted;
                    font-size: Theme.font-2xs;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            chart := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                clip: true;
                init => { root.map-resized(self.width, self.height); }
                changed width => { root.map-resized(self.width, self.height); }
                changed height => { root.map-resized(self.width, self.height); }

                for tile-data in root.tiles : ContextTileView {
                    tile: tile-data;
                    active: hit.pressed;
                    x: tile-data.x * chart.width + 1.5px;
                    y: tile-data.y * chart.height + 1.5px;
                    width: max(0px, tile-data.w * chart.width - 3px);
                    height: max(0px, tile-data.h * chart.height - 3px);
                    hit := TouchArea {
                        enabled: tile-data.kind != "free";
                        clicked => {
                            if (tile-data.kind == "item") {
                                root.tile-open(tile-data.slot, tile-data.tag, tile-data.name, tile-data.count);
                            } else {
                                root.legend-open(tile-data.slot);
                            }
                        }
                    }
                }

                if !root.has-data : Text {
                    width: parent.width;
                    height: parent.height;
                    text: I18n.cx_no_request;
                    color: Theme.muted;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.has-data : HorizontalLayout {
                height: 44px;
                for part in root.parts : ContextLegendItem {
                    slot: part.slot;
                    activated => { root.legend-open(part.slot); }
                }
                if root.show-free : ContextLegendItem { slot: 0; }
            }
        }
    }

    // ---- detail panel: full-screen layer above the card -------------------
    if root.detail-open : ContextDetailPanel {
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        detail-kind: root.detail-kind;
        detail-slot: root.detail-slot;
        detail-tag: root.detail-tag;
        detail-name: root.detail-name;
        detail-count: root.detail-count;
        detail-value: root.detail-value;
        detail-pct: root.detail-pct;
        detail-rows: root.detail-rows;
        detail-text: root.detail-text;
        detail-row-open: root.detail-row-open;
        detail-row-text: root.detail-row-text;
        detail-dismissed => { root.detail-dismissed(); }
        detail-row-toggle(index, slot, tag, name, count) => {
            root.detail-row-toggle(index, slot, tag, name, count);
        }
    }
}
