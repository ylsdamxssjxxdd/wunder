// wunder 安卓版 — 上下文窗口卡片共享结构与色板。
//
// 卡片主文件与详情覆盖层都从这里取类型，避免两个 Slint 文件互相 import 形成环。
// 配色与文案映射和桌面版 `ContextColors` / `ContextText` 一致。

import { ContextColors, ContextText, ContextTile } from "../../wunder-desktop/frontend/ui/context_tile.slint";
export { ContextColors as CtxColors, ContextText as CtxText, ContextTile }

// One row of the fixed five-part legend. `slot` is the palette index 1..5.
export struct CtxPartRow {
    slot: int,
    tokens: int,
    tokens-text: string,
    pct-text: string,
}

// One item of one part: a tool definition, a turn, gathered results or images.
export struct CtxItemRow {
    slot: int,
    // prompt / reminder / tool / result / turn / image / reply.
    tag: string,
    name: string,
    count: int,
    tokens-text: string,
    // Share of the largest row, for the small bar.
    ratio: float,
    // Index among the part's listed items.
    item: int,
}
