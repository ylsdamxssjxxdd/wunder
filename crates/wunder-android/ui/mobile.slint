    // 渠道
    callback refresh-channels();
    callback select-channel-account(string);
    callback open-channel-editor(string);
    callback close-channel-editor();
    callback save-channel(MobileChannelDraft);
    callback toggle-channel(string, bool);
    callback delete-channel(string);
    callback open-channel-logs(string);
    callback close-channel-logs();
    callback delete-channel-binding(string);

    private property <length> inset-top: self.safe-area-insets.top;
    private property <length> inset-bottom: self.safe-area-insets.bottom;
    private property <length> header-height: 52px;
    // Secondary lists fit five 48px rows plus the 46px back header without
    // scrolling on a standard phone.
    private property <length> plus-panel-height: root.plus-open
        ? (root.plus-view == 0 ? 100px : 312px) + root.inset-bottom : 0px;

    function close-sheet() {
        root.session-sheet-open = false;
    }

    function show-session-sheet(id: string, title: string, archived: bool) {
        root.session-sheet-id = id;
        root.session-sheet-title = title;
        root.session-sheet-archived = archived;
        root.keyboard-dismiss();
        root.session-sheet-open = true;
    }

    function begin-rename() {
        root.rename-id = root.session-sheet-id;
        root.rename-title = root.session-sheet-title;
        root.session-sheet-open = false;
        root.rename-open = true;
    }

    function commit-rename() {
        if root.rename-title == "" {
            return;
        }
        root.rename-open = false;
        root.keyboard-dismiss();
        root.rename-session(root.rename-id, root.rename-title);
    }

    function open-trajectory() {
        root.trajectory-session-id = root.session-sheet-id;
        root.trajectory-session-title = root.session-sheet-title;
        root.trajectory-expanded = -1;
        root.session-sheet-open = false;
        root.trajectory-open = true;
        root.load-trajectory(root.trajectory-session-id, root.trajectory-session-title);
    }

    function archive-from-sheet() {
        root.session-sheet-open = false;
        root.archive-session(root.session-sheet-id);
    }

    function restore-from-sheet() {
        root.session-sheet-open = false;
        root.restore-session(root.session-sheet-id);
    }

    function delete-from-sheet() {
        root.pending-delete-id = root.session-sheet-id;
        root.session-sheet-open = false;
        root.delete-archived-open = true;
    }

    function toggle-plus() {
        root.plus-open = !root.plus-open;
        if !root.plus-open {
            root.plus-view = 0;
        } else {
            root.plus-panel-opened();
        }
    }

    changed plus-open => {
        if !root.plus-open {
            root.plus-view = 0;
        }
    }

    changed drawer-open => {
        if root.drawer-open {
            root.keyboard-dismiss();
        }
    }

    changed workspace-open => {
        if !root.workspace-open {
            root.workspace-sheet-open = false;
        }
    }

    changed workspaces-open => {
        if !root.workspaces-open {
            root.workspace-overlay = 0;
        }
    }

    function close-plus() {
        root.plus-open = false;
        root.plus-view = 0;
    }

    function pick-draft(value: string) {
        root.draft = value;
        root.close-plus();
    }

    function show-workspace() {
        root.close-plus();
        root.close-drawer();
        root.workspace-sheet-open = false;
        root.workspace-open = true;
        root.open-workspace("");
    }

    function show-workspaces() {
        root.close-plus();
        root.close-drawer();
        root.workspace-overlay = 0;
        root.workspaces-open = true;
        root.open-workspaces();
    }

    // The device row's plus creates a workspace directly, the desktop
    // selector's twin. The catalogue page opens with its editor already up.
    function show-workspace-create() {
        root.close-plus();
        root.close-drawer();
        root.workspaces-open = true;
        root.open-workspaces();
        root.workspace-overlay = 2;
    }

    VerticalLayout {
        // The keyboard overlays the window; lift the whole stack above it.
        // The activity never resizes (adjustNothing), so both the height and
        // the top anchor must be explicit.
        x: 0px;
        y: 0px;
        height: root.height - root.ime-height;
        spacing: 0px;

        // ---- header ---------------------------------------------------
        Rectangle {
            height: root.header-height + root.inset-top;
            background: Theme.surface;

            // The safe-area strip keeps the same surface; only the content
            // below it is padded, so a notch never clips the title.
            Rectangle {
                y: root.inset-top;
                height: root.header-height;
                width: parent.width;
                background: transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Action {
                        width: 36px;
                        height: 36px;
                        icon-size: 18px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/bars.svg");
                        label: I18n.act_tab_sessions;
                        clicked => { root.open-drawer(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            HorizontalLayout {
                                height: 32px;
                                alignment: center;
                                Rectangle {
                                    width: min(model-chip-label.preferred-width, 200px) + 44px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: model-chip-touch.has-hover ? Theme.hover : transparent;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    model-chip-label := Text {
                                        visible: false;
                                        text: root.model-catalogue-count > 0 && root.model-name != ""
                                            ? root.model-name : "选择模型";
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                    }
                                    Image {
                                        x: 10px;
                                        y: 8px;
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-brain.svg");
                                        colorize: root.model-catalogue-count > 0 ? Theme.text-secondary : Theme.muted;
                                        image-fit: contain;
                                    }
                                    Text {
                                        x: 32px;
                                        width: min(model-chip-label.preferred-width, 200px);
                                        height: 100%;
                                        text: root.model-catalogue-count > 0 && root.model-name != ""
                                            ? root.model-name : "选择模型";
                                        color: root.model-catalogue-count > 0 ? Theme.text : Theme.muted;
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Image {
                                        x: parent.width - 20px;
                                        y: 11px;
                                        width: 10px;
                                        height: 10px;
                                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-down.svg");
                                        colorize: Theme.muted;
                                        image-fit: contain;
                                    }
                                    model-chip-touch := TouchArea {
                                        clicked => {
                                            if root.settings-chat-target == 0 {
                                                root.keyboard-dismiss();
                                                root.model-sheet-open = true;
                                            }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.thread-subtitle;
                                color: Theme.muted;
                                font-size: Theme.font-2xs;
                                overflow: elide;
                                horizontal-alignment: center;
                                visible: root.thread-subtitle != "";
                            }
                        }
                    }

                    Action {
                        width: 36px;
                        height: 36px;
                        icon-size: 18px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-pen-to-square.svg");
                        label: I18n.chat_new_thread;
                        clicked => {
                            root.close-plus();
                            root.new-session();
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ---- transcript ----------------------------------------------
        // 桌面版's TimelineView already owns the reading column, follow-output
        // behaviour and every entry kind; the phone only gives it the screen.
        TimelineView {
            vertical-stretch: 1;
            rows: root.rows;
            greeting: root.greeting;
            loading: root.loading;
            follow-output <=> root.follow-output;
            spinning: root.spinning;
            stream-revision: root.stream-revision;
            toggle(index) => { root.toggle-row(index); }
            copy-text(text) => { root.copy-text(text); }
            preview-prompt() => { }
            load-older() => { }
            process-page(index, direction) => { }
            copy-original(id) => { }
            open-resource(path) => { }
            show-context-menu(x, y, selected) => { }
        }

        // ---- composer -------------------------------------------------
        // Phone breathing room: the desktop band is flush; on a handset the
        // input card and its action row need a side gutter so the send square
        // never sits against the display edge.
        Rectangle {
            background: Theme.panel;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                // 首次配置引导：本机聊天还没有任何真实模型时给出直达设置页的入口；
                // 云端线程用自己的模型目录，不显示。
                if root.needs-model-setup && root.settings-chat-target == 0 : ModelSetupBanner {
                    setup() => { root.setup-first-model(); }
                }

                // 问询面板：触摸端直接复用桌面版的卡片，下面跟一个显式的提交键。
                // 展开全部时用内部滚动兜住高度，不让面板把输入区挤出屏幕。
                if root.inquiry-total > 0 : Rectangle {
                    height: min(root.height * 0.46, inquiry-stack.preferred-height);
                    background: transparent;
                    inquiry-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: as-needed;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, inquiry-stack.preferred-height);
                        inquiry-stack := VerticalLayout {
                            width: inquiry-scroll.visible-width;
                            spacing: 8px;
                            alignment: start;
                            InquiryPanel {
                                horizontal-stretch: 1;
                                questions: root.inquiry-questions;
                                page: root.inquiry-page;
                                total: root.inquiry-total;
                                expanded: root.inquiry-expanded;
                                option-clicked(row, option) => { root.inquiry-option-clicked(row, option); }
                                other-edited(row, text) => { root.inquiry-other-edited(row, text); }
                                no-preference(row) => { root.inquiry-no-preference(row); }
                                use-recommended(row) => { root.inquiry-use-recommended(row); }
                                page-move(delta) => { root.inquiry-page-move(delta); }
                                expanded-toggle() => { root.inquiry-expanded-toggle(); }
                            }
                            Rectangle {
                                height: 42px;
                                border-radius: Theme.radius-md;
                                background: root.inquiry-ready
                                    ? (inquiry-submit-touch.has-hover ? Theme.accent-deep : Theme.accent)
                                    : Theme.border-strong;
                                inquiry-submit-touch := TouchArea {
                                    enabled: root.inquiry-ready;
                                    clicked => { root.inquiry-submit(); }
                                }
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: root.inquiry-ready ? I18n.inquiry_submit : I18n.inquiry_submit_blocked;
                                    color: #ffffff;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.voice-phase != 0 : HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    VoiceBar {
                        horizontal-stretch: 1;
                        phase: root.voice-phase;
                        elapsed: root.voice-elapsed;
                        stop() => { root.record-voice(); }
                    }
                }

                composer := Composer {
                    mobile: true;
                    mobile-plus-open: root.plus-open;
                    mobile-plus-toggled() => { root.toggle-plus(); }
                    draft <=> root.draft;
                    busy: root.loading;
                    generating: root.generating;
                    stopping: root.stopping;
                    models: root.models;
                    model-catalogue-count: root.model-catalogue-count;
                    model-name: root.model-name;
                    model-key: root.model-key;
                    model-saving: root.model-saving;
                    cloud-ready: root.cloud-ready;
                    attachments: root.attachments;
                    send-key: root.send-key;
                    show-host-hud: false;
                    show-cli-action: false;
                    workspace-name: root.workspace-name;
                    branch-name: root.branch-name;
                    permission-mode <=> root.permission-mode;
                    send() => {
                        root.close-plus();
                        root.send();
                    }
                    stop() => { root.stop(); }
                    select-model(index, key) => { root.select-model(index, key); }
                    open-model-settings() => { root.open-model-settings(); }
                    permission-changed(value) => { root.permission-changed(value); }
                    remove-attachment(index) => { root.remove-attachment(index); }
                }
            }
        }

        // ---- phone function panel -------------------------------------
        // Tapping + no longer opens the desktop cascade: a full-width panel
        // slides up under the input, exactly like a messenger's attach tray.
        if root.plus-open : Rectangle {
            height: root.plus-panel-height;
            background: Theme.panel;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            if root.plus-view == 0 : VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 2px;
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: root.voice-phase == 1
                            ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/stop.svg")
                            : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-mic.svg");
                        label: root.voice-phase == 1 ? "停止"
                            : root.voice-phase == 2 ? "识别中"
                            : "录音";
                        active: root.voice-phase == 1;
                        enabled: root.voice-phase != 2;
                        clicked => {
                            root.close-plus();
                            root.record-voice();
                        }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-camera.svg");
                        label: I18n.cp_screenshot;
                        clicked => {
                            root.close-plus();
                            root.capture-screenshot();
                        }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/terminal.svg");
                        label: I18n.cp_commands;
                        clicked => { root.plus-view = 1; }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-shield.svg");
                        label: "权限";
                        clicked => { root.plus-view = 3; }
                    }
                    PlusTile {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-wand-sparkles.svg");
                        label: "预设";
                        enabled: root.preset-questions.length > 0;
                        clicked => { root.plus-view = 2; }
                    }
                }
            }

            if root.plus-view != 0 : VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 6px + root.inset-bottom;
                spacing: 0px;
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;
                        Action {
                            width: 34px;
                            height: 34px;
                            icon-size: 17px;
                            icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-left.svg");
                            label: "返回";
                            clicked => { root.plus-view = 0; }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.plus-view == 1 ? I18n.cp_commands
                                : root.plus-view == 2 ? I18n.ag_preset_questions
                                : I18n.cp_permission;
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 2px;
                        if root.plus-view == 1 : VerticalLayout {
                            spacing: 2px;
                            for command in CommandOptions.items : PanelOption {
                                label: command.label;
                                clicked => { root.pick-draft(command.value); }
                            }
                        }
                        if root.plus-view == 2 : VerticalLayout {
                            spacing: 2px;
                            for question in root.preset-questions : PanelOption {
                                label: question;
                                clicked => { root.pick-draft(question); }
                            }
                        }
                        if root.plus-view == 3 : PanelOption {
                            label: I18n.cp_permission_full;
                            selected: root.permission-mode == "full_auto";
                            clicked => {
                                root.permission-mode = "full_auto";
                                root.permission-changed("full_auto");
                                root.close-plus();
                            }
                        }
                        if root.plus-view == 3 : PanelOption {
                            label: I18n.cp_permission_write;
                            selected: root.permission-mode == "auto_edit";
                            clicked => {
                                root.permission-mode = "auto_edit";
                                root.permission-changed("auto_edit");
                                root.close-plus();
                            }
                        }
                        if root.plus-view == 3 : PanelOption {
                            label: I18n.cp_permission_command;
                            selected: root.permission-mode == "suggest";
                            clicked => {
                                root.permission-mode = "suggest";
                                root.permission-changed("suggest");
                                root.close-plus();
                            }
                        }
                        if root.plus-view == 3 : Text {
                            height: 54px;
                            text: I18n.cp_permission_note;
                            color: Theme.muted;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }
        }

        // Bottom safe area: a strip of the chat surface under the composer.
        Rectangle {
            // The keyboard replaces the navigation bar, so the gesture inset
            // must not stack on top of the keyboard height. The open function
            // panel already carries the inset at its own foot.
            height: root.ime-height > 0px || root.plus-open ? 0px : root.inset-bottom;
            background: Theme.panel;
            visible: root.inset-bottom > 0px && root.ime-height == 0px && !root.plus-open;
        }
    }

    // ---- thread drawer ----------------------------------------------
    if root.drawer-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.close-drawer(); }
        }
    }

    if root.drawer-open : Rectangle {
        x: 0px;
        y: 0px;
        width: min(parent.width * 0.86, 340px);
        height: 100%;
        background: Theme.surface;
        drop-shadow-color: #00000033;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: 4px;

        VerticalLayout {
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: 0px;

            Rectangle {
                height: 48px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Image {
                        width: 16px; height: 16px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-display.svg");
                        colorize: Theme.accent-ink;
                    }
                    Text {
                        text: root.settings-current-device;
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: "切换设备";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                    Image {
                        width: 12px; height: 12px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-down.svg");
                        colorize: Theme.muted;
                    }
                    // Desktop puts a plus beside the device selector: the same
                    // row owns device switching and workspace creation.
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius-sm;
                        background: ws-add-touch.has-hover ? Theme.hover : transparent;
                        ws-add-touch := TouchArea {
                            enabled: root.settings-chat-target == 0;
                            clicked => { root.show-workspace-create(); }
                        }
                        Image {
                            x: (parent.width - 16px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-plus.svg");
                            colorize: root.settings-chat-target == 0
                                ? (ws-add-touch.has-hover ? Theme.accent-ink : Theme.muted)
                                : Theme.border-strong;
                        }
                    }
                }
                device-chip-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 44px;
                    height: parent.height;
                    clicked => {
                        root.refresh-devices();
                        root.device-sheet-open = true;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // Active workspace sits directly under the device row, mirroring
            // the desktop sidebar where the workspace tree follows the device
            // selector. Tapping opens the full catalogue.
            Rectangle {
                height: 56px;
                background: workspaces-touch.has-hover ? Theme.hover : transparent;
                workspaces-touch := TouchArea {
                    enabled: root.settings-chat-target == 0;
                    clicked => { root.show-workspaces(); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 18px;
                        height: 18px;
                        source: WorkspaceVisual.icon(root.workspace-icon);
                        colorize: WorkspaceVisual.color(root.workspace-color);
                        image-fit: contain;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Text {
                            text: "工作区";
                            color: Theme.text;
                            font-size: Theme.font-md;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.workspace-name == "" ? "尚未选择" : root.workspace-name;
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "" + root.workspace-thread-count + " 线程";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                    Image {
                        width: 12px;
                        height: 12px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-right.svg");
                        colorize: Theme.muted;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: 56px;
                background: transparent;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: I18n.act_tab_sessions;
                        color: Theme.text;
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Action {
                        width: 34px;
                        height: 34px;
                        icon-size: 16px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-plus.svg");
                        label: I18n.chat_new_thread;
                        clicked => {
                            root.close-plus();
                            root.new-session();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            ListView {
                vertical-stretch: 1;
                for session in root.sessions : Rectangle {
                    height: 72px;
                    background: session.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
                    touch := TouchArea {
                        clicked => { root.select-session(session.id); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 6px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        // Status dot mirrors the sidebar's running/idle signal.
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: session.status == "running" ? Theme.accent
                                : session.status == "failed" ? Theme.danger
                                : session.status == "queued" ? Theme.warning
                                : Theme.border-strong;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: session.title;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    font-weight: session.active ? 600 : 400;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: session.time;
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: session.preview;
                                color: Theme.muted;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                        }

                        // Trailing actions. An always-visible affordance beats
                        // a hidden long-press: the row tap still selects the
                        // thread, this opens rename / trajectory / archive.
                        Rectangle {
                            width: 34px;
                            height: 42px;
                            border-radius: Theme.radius-sm;
                            background: more-touch.has-hover ? Theme.hover : transparent;
                            more-touch := TouchArea {
                                clicked => {
                                    root.show-session-sheet(session.id, session.title, false);
                                }
                            }
                            Image {
                                x: 9px;
                                y: 13px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/ellipsis.svg");
                                colorize: Theme.muted;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                height: 48px;
                background: workspace-touch.has-hover ? Theme.hover : transparent;
                workspace-touch := TouchArea {
                    enabled: root.settings-chat-target == 0;
                    clicked => { root.show-workspace(); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-tree.svg");
                        colorize: Theme.muted;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "工作目录";
                        color: Theme.text;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.settings-chat-target == 0 ? "文件" : "仅本机";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                height: 48px;
                background: settings-touch.has-hover ? Theme.hover : transparent;
                settings-touch := TouchArea {
                    clicked => { root.open-settings(0); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/gear.svg");
                        colorize: Theme.muted;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.sidebar_settings;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v" + root.settings-version;
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- settings sheet ---------------------------------------------
    if root.settings-open : MobileSettings {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        ime-height: root.ime-height;
        page <=> root.settings-page;
        theme: root.settings-theme;
        font-size: root.settings-font-size;
        send-key: root.settings-send-key;
        language: root.settings-language;
        permission-mode <=> root.permission-mode;
        current-model: root.model-name;
        model-count: root.model-catalogue-count;
        workspace: root.settings-workspace;
        version: root.settings-version;
        ubuntu-state: root.settings-ubuntu-state;
        ubuntu-progress: root.settings-ubuntu-progress;
        ubuntu-stage: root.settings-ubuntu-stage;
        ubuntu-version: root.settings-ubuntu-version;
        ubuntu-error: root.settings-ubuntu-error;
        ubuntu-enabled: root.settings-ubuntu-enabled;
        companion-enabled: root.settings-companion-enabled;
        companion-selected: root.settings-companion-selected;
        companion-selected-name: root.settings-companion-selected-name;
        companion-scale: root.settings-companion-scale;
        companion-hints: root.settings-companion-hints;
        companion-permission: root.settings-companion-permission;
        companion-names: root.settings-companion-names;
        companion-ids: root.settings-companion-ids;
        permissions: root.permission-items;
        permission-summary: root.permission-summary;
        update-phase: root.update-phase;
        update-version: root.update-version;
        update-notes: root.update-notes;
        update-source: root.update-source;
        update-channel: root.update-channel;
        update-size: root.update-size;
        update-progress: root.update-progress;
        update-downloaded: root.update-downloaded;
        update-error: root.update-error;
        models: root.models;
        archived-sessions: root.archived-sessions;
        archived-total: root.archived-total;
        editor-open: root.editor-open;
        editor-new: root.editor-new;
        editor-default: root.editor-default;
        editor-key: root.editor-key;
        draft <=> root.editor-draft;
        secret <=> root.editor-secret;
        editor-error: root.editor-error;
        editor-probe: root.editor-probe;
        editor-probing: root.editor-probing;
        editor-probed-context: root.editor-probed-context;
        tools-builtin: root.settings-tools-builtin;
        tools-mcp: root.settings-tools-mcp;
        tools-skills: root.settings-tools-skills;
        tools-knowledge: root.settings-tools-knowledge;
        tool-servers: root.settings-tools-servers;
        tool-skill-resources: root.settings-tools-skill-resources;
        tool-bases: root.settings-tools-bases;
        tool-server-tools: root.settings-tool-server-tools;
        tool-active-server: root.settings-tool-active-server;
        tool-active-resource: root.settings-tool-active-resource;
        tool-resource-tab: root.settings-tool-resource-tab;
        tool-resource-editable: root.settings-tool-resource-editable;
        tool-files: root.settings-tool-files;
        tool-directory: root.settings-tool-directory;
        tool-has-more: root.settings-tool-has-more;
        tool-editor-kind: root.settings-tool-editor-kind;
        tool-editor-new: root.settings-tool-editor-new;
        tool-editor-error: root.settings-tool-editor-error;
        mcp-draft <=> root.settings-mcp-draft;
        kb-draft <=> root.settings-kb-draft;
        tool-file-open: root.settings-tool-file-open;
        tool-file-path: root.settings-tool-file-path;
        tool-file-content <=> root.settings-tool-file-content;
        tool-file-readonly: root.settings-tool-file-readonly;
        tool-file-error: root.settings-tool-file-error;
        agent-name: root.settings-agent-name;
        agent-tool-count: root.settings-agent-tool-count;
        agent-description <=> root.settings-agent-description;
        agent-prompt <=> root.settings-agent-prompt;
        agent-groups: root.settings-agent-groups;
        agent-search <=> root.settings-agent-search;
        agent-questions: root.settings-agent-questions;
        cron-jobs: root.settings-cron-jobs;
        cron-workspaces: root.settings-cron-workspaces;
        cron-runs: root.settings-cron-runs;
        cron-runs-open: root.settings-cron-runs-open;
        cron-runs-loading: root.settings-cron-runs-loading;
        cron-runs-title: root.settings-cron-runs-title;
        cron-editor-open: root.settings-cron-editor-open;
        cron-editor-new: root.settings-cron-editor-new;
        cron-editor-error: root.settings-cron-editor-error;
        cron-editor-saving: root.settings-cron-editor-saving;
        cron-draft <=> root.settings-cron-draft;
        memories: root.settings-memories;
        memory-categories: root.settings-memory-categories;
        memory-category: root.settings-memory-category;
        memory-query <=> root.settings-memory-query;
        memory-loading: root.settings-memory-loading;
        memory-error: root.settings-memory-error;
        memory-editor-open: root.settings-memory-editor-open;
        memory-editor-new: root.settings-memory-editor-new;
        memory-editor-error: root.settings-memory-editor-error;
        memory-editor-saving: root.settings-memory-editor-saving;
        memory-draft <=> root.settings-memory-draft;
        cloud-logged-in: root.settings-cloud-logged-in;
        cloud-expired: root.settings-cloud-expired;
        cloud-connection: root.settings-cloud-connection;
        cloud-server: root.settings-cloud-server;
        cloud-username: root.settings-cloud-username;
        cloud-balance: root.settings-cloud-balance;
        cloud-daily-grant: root.settings-cloud-daily-grant;
        cloud-max-concurrent: root.settings-cloud-max-concurrent;
        cloud-active-concurrent: root.settings-cloud-active-concurrent;
        cloud-sync-enabled: root.settings-cloud-sync-enabled;
        cloud-inbound-enabled: root.settings-cloud-inbound-enabled;
        cloud-full-shadow: root.settings-cloud-full-shadow;
        cloud-last-error: root.settings-cloud-last-error;
        cloud-last-success: root.settings-cloud-last-success;
        cloud-next-retry: root.settings-cloud-next-retry;
        cloud-device-name: root.settings-cloud-device-name;
        chat-target: root.settings-chat-target;
        current-device: root.settings-current-device;
        devices: root.settings-devices;
        cloud-sessions: root.settings-cloud-sessions;
        cloud-loading: root.settings-cloud-loading;
        cloud-status: root.settings-cloud-status;
        cloud-model: root.settings-cloud-model;
        approval-open: root.settings-approval-open;
        approval-id: root.settings-approval-id;
        approval-from: root.settings-approval-from;
        approval-kind: root.settings-approval-kind;
        approval-risk: root.settings-approval-risk;
        approval-prompt: root.settings-approval-prompt;
        channel-accounts: root.settings-channel-accounts;
        channel-catalog: root.settings-channel-catalog;
        channel-catalog-ids: root.settings-channel-catalog-ids;
        channel-catalog-names: root.settings-channel-catalog-names;
        channel-bindings: root.settings-channel-bindings;
        channel-logs: root.settings-channel-logs;
        channel-selected: root.settings-channel-selected;
        channel-logs-open: root.settings-channel-logs-open;
        channel-editor-open: root.settings-channel-editor-open;
        channel-editor-new: root.settings-channel-editor-new;
        channel-editor-error: root.settings-channel-editor-error;
        channel-draft <=> root.settings-channel-draft;
        close() => { root.close-settings(); }
        save-theme(value) => { root.save-theme(value); }
        save-font-size(value) => { root.save-font-size(value); }
        save-send-key(value) => { root.save-send-key(value); }
        save-language(value) => { root.save-language(value); }
        install-ubuntu() => { root.install-ubuntu(); }
        set-ubuntu-enabled(value) => { root.set-ubuntu-enabled(value); }
        save-companion(enabled, selected, scale, hints) => { root.save-companion(enabled, selected, scale, hints); }
        request-companion-permission() => { root.request-companion-permission(); }
        refresh-permissions() => { root.refresh-permissions(); }
        open-permission(id) => { root.open-permission(id); }
        check-update() => { root.check-update(); }
        download-update() => { root.download-update(); }
        install-update() => { root.install-update(); }
        select-update-source(source) => { root.select-update-source(source); }
        permission-changed(value) => { root.permission-changed(value); }
        open-model-editor(key) => { root.open-model-editor(key); }
        close-model-editor() => { root.close-model-editor(); }
        save-model(card, secret) => { root.save-model(card, secret); }
        probe-model(card, secret) => { root.probe-model(card, secret); }
        delete-model(key) => { root.delete-model(key); }
        set-default-model(key) => { root.set-default-model(key); }
        refresh-tools() => { root.refresh-tools(); }
        select-tool-server(index) => { root.select-tool-server(index); }
        select-tool-resource(tab, index) => { root.select-tool-resource(tab, index); }
        load-tool-directory(directory) => { root.load-tool-directory(directory); }
        more-tool-files() => { root.more-tool-files(); }
        open-tool-file(path) => { root.open-tool-file(path); }
        save-tool-file(path, content) => { root.save-tool-file(path, content); }
        close-tool-file() => { root.close-tool-file(); }
        create-tool-file(name) => { root.create-tool-file(name); }
        upload-tool-files() => { root.upload-tool-files(); }
        delete-tool-resource(tab, name) => { root.delete-tool-resource(tab, name); }
        connect-tool-server(name) => { root.connect-tool-server(name); }
        export-skill(name) => { root.export-skill(name); }
        import-skill() => { root.import-skill(); }
        open-tool-editor(kind, index) => { root.open-tool-editor(kind, index); }
        close-tool-editor() => { root.close-tool-editor(); }
        save-tool-editor(kind, mcp, kb) => { root.save-tool-editor(kind, mcp, kb); }
        refresh-agent() => { root.refresh-agent(); }
        search-agent-tools(query) => { root.search-agent-tools(query); }
        save-agent-text(description, prompt) => { root.save-agent-text(description, prompt); }
        toggle-agent-tool(name, enabled, description, prompt) => { root.toggle-agent-tool(name, enabled, description, prompt); }
        toggle-agent-tool-group(title, select, description, prompt) => { root.toggle-agent-tool-group(title, select, description, prompt); }
        add-agent-question(question, description, prompt) => { root.add-agent-question(question, description, prompt); }
        remove-agent-question(index, description, prompt) => { root.remove-agent-question(index, description, prompt); }
        refresh-cron() => { root.refresh-cron(); }
        toggle-cron(id, enabled) => { root.toggle-cron(id, enabled); }
        delete-cron(id) => { root.delete-cron(id); }
        run-cron-now(id) => { root.run-cron-now(id); }
        open-cron-runs(id) => { root.open-cron-runs(id); }
        close-cron-runs() => { root.close-cron-runs(); }
        open-cron-editor(id) => { root.open-cron-editor(id); }
        close-cron-editor() => { root.close-cron-editor(); }
        save-cron(draft) => { root.save-cron(draft); }
        refresh-memory() => { root.refresh-memory(); }
        search-memory(query) => { root.search-memory(query); }
        set-memory-category(category) => { root.set-memory-category(category); }
        open-memory-editor(index) => { root.open-memory-editor(index); }
        close-memory-editor() => { root.close-memory-editor(); }
        save-memory(draft) => { root.save-memory(draft); }
        delete-memory(id) => { root.delete-memory(id); }
        cloud-login(server, username, password) => { root.cloud-login(server, username, password); }
        cloud-logout() => { root.cloud-logout(); }
        cloud-refresh() => { root.cloud-refresh(); }
        cloud-toggle-sync(enabled) => { root.cloud-toggle-sync(enabled); }
        cloud-set-sharing(enabled, full-shadow) => { root.cloud-set-sharing(enabled, full-shadow); }
        switch-chat-target(target) => { root.switch-chat-target(target); }
        refresh-devices() => { root.refresh-devices(); }
        cloud-refresh-threads() => { root.cloud-refresh-threads(); }
        cloud-new-thread() => { root.cloud-new-thread(); }
        cloud-select-thread(id) => { root.cloud-select-thread(id); }
        cloud-rename(id, title) => { root.cloud-rename(id, title); }
        cloud-archive(id) => { root.cloud-archive(id); }
        decide-approval(id, approve) => { root.decide-approval(id, approve); }
        refresh-channels() => { root.refresh-channels(); }
        select-channel-account(id) => { root.select-channel-account(id); }
        open-channel-editor(id) => { root.open-channel-editor(id); }
        close-channel-editor() => { root.close-channel-editor(); }
        save-channel(draft) => { root.save-channel(draft); }
        toggle-channel(id, enabled) => { root.toggle-channel(id, enabled); }
        delete-channel(id) => { root.delete-channel(id); }
        open-channel-logs(id) => { root.open-channel-logs(id); }
        close-channel-logs() => { root.close-channel-logs(); }
        delete-channel-binding(id) => { root.delete-channel-binding(id); }
        restore-archived(id) => { root.restore-session(id); }
        delete-archived(id) => { root.delete-archived-session(id); }
        refresh-archived() => { root.refresh-archived(); }
    }

    // ---- device switch sheet ----------------------------------------
    if root.device-sheet-open : Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        background: Theme.overlay;
        TouchArea { clicked => { root.device-sheet-open = false; } }
        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px - root.inset-bottom;
            width: parent.width - 16px;
            height: min(parent.height * 0.72, 120px + root.settings-devices.length * 62px + root.inset-bottom);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                HorizontalLayout { height: 4px; alignment: center; Rectangle { width: 40px; height: 4px; border-radius: 2px; background: Theme.border; } }
                Text { height: 40px; text: "切换设备"; color: Theme.text; font-size: Theme.font-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for device in root.settings-devices : Rectangle {
                        height: 62px;
                        background: device.current ? Theme.accent-soft : (device-touch.has-hover ? Theme.hover : transparent);
                        device-touch := TouchArea {
                            enabled: device.selectable;
                            clicked => {
                                if device.id == "local" {
                                    root.switch-chat-target(0);
                                    root.device-sheet-open = false;
                                } else if device.id == "cloud" {
                                    root.switch-chat-target(1);
                                    root.device-sheet-open = false;
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 34px; height: 34px;
                                border-radius: 9px;
                                background: Theme.panel;
                                Image {
                                    x: 8px; y: 8px; width: 18px; height: 18px;
                                    source: device.kind == "cloud"
                                        ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-globe.svg")
                                        : device.kind == "desktop"
                                            ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-display.svg")
                                            : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-bot.svg");
                                    colorize: Theme.accent-ink;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: device.label; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                                Text {
                                    text: (device.kind == "cloud" ? "云端" : device.kind == "phone" ? "手机" : device.kind == "desktop" ? "桌面" : device.kind == "cli" ? "命令行" : "设备")
                                        + " · " + (device.connected ? "在线" : "离线")
                                        + (device.selectable ? "" : " · 由云端管理");
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    overflow: elide;
                                }
                            }
                            if device.current : Image {
                                width: 16px; height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
                                colorize: Theme.accent-ink;
                            }
                        }
                    }
                }
                if root.settings-devices.length == 0 : Text { height: 48px; text: "暂无可用设备"; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
            }
        }
    }

    // ---- remote approval -------------------------------------------
    if root.settings-approval-open : ConfirmDialog {
        title: "远程操作请求";
        message: "来自 " + root.settings-approval-from + " · " + root.settings-approval-kind + "（" + root.settings-approval-risk + "）\n\n" + root.settings-approval-prompt;
        confirm-label: "允许";
        cancel-label: "拒绝";
        confirmed => { root.decide-approval(root.settings-approval-id, true); }
        canceled => { root.decide-approval(root.settings-approval-id, false); }
    }

    // ---- session action sheet --------------------------------------
    // ---- model picker sheet -----------------------------------------
    if root.model-sheet-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.model-sheet-open = false; }
        }

        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: min(parent.height - root.inset-top - 24px, 460px + root.inset-bottom);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 8px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 2px;

                Rectangle {
                    height: 52px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "选择模型";
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "当前线程使用的模型";
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.models.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "暂无可用模型";
                        color: Theme.muted;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.models.length > 0 : ListView {
                    vertical-stretch: 1;
                    for model[index] in root.models : Rectangle {
                        height: 58px;
                        border-radius: Theme.radius-sm;
                        background: model.key == root.model-key ? Theme.accent-soft
                            : model-touch.has-hover ? Theme.hover : transparent;
                        opacity: model.disabled ? 0.45 : 1.0;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: model.key;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: model.provider + (model.model != "" ? " · " + model.model : "");
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    overflow: elide;
                                    visible: model.provider != "" || model.model != "";
                                }
                            }
                            if model.key == root.model-key : Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
                                colorize: Theme.accent;
                                image-fit: contain;
                            }
                        }
                        model-touch := TouchArea {
                            enabled: !model.disabled && (root.cloud-ready || !model.is-cloud);
                            clicked => {
                                root.model-sheet-open = false;
                                root.select-model(index, model.key);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/gear.svg");
                    label: I18n.st_tab_models;
                    clicked => {
                        root.model-sheet-open = false;
                        root.open-model-settings();
                    }
                }
                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius-sm;
                    background: model-cancel-touch.has-hover ? Theme.hover : transparent;
                    model-cancel-touch := TouchArea {
                        clicked => { root.model-sheet-open = false; }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: I18n.common_cancel;
                        color: Theme.text-secondary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.session-sheet-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.close-sheet(); }
        }

        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: sheet-body.preferred-height;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;

            sheet-body := VerticalLayout {
                padding: 8px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 2px;

                Rectangle {
                    height: 48px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.session-sheet-title;
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.session-sheet-archived ? "归档会话" : "会话操作";
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            horizontal-alignment: center;
                        }
                    }
                }

                if !root.session-sheet-archived : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-pen-to-square.svg");
                    label: I18n.common_rename;
                    clicked => { root.begin-rename(); }
                }
                if !root.session-sheet-archived && root.settings-chat-target == 0 : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-route.svg");
                    label: I18n.sb_thread_trajectory;
                    clicked => { root.open-trajectory(); }
                }
                if !root.session-sheet-archived : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/box-archive.svg");
                    label: I18n.sb_thread_archive;
                    clicked => { root.archive-from-sheet(); }
                }

                if root.session-sheet-archived : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/rotate-right.svg");
                    label: "恢复会话";
                    clicked => { root.restore-from-sheet(); }
                }
                if root.session-sheet-archived : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/trash.svg");
                    label: "永久删除";
                    danger: true;
                    clicked => { root.delete-from-sheet(); }
                }

                Rectangle { height: 1px; background: Theme.border; }
                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius-sm;
                    background: cancel-touch.has-hover ? Theme.hover : transparent;
                    cancel-touch := TouchArea {
                        clicked => { root.close-sheet(); }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: I18n.common_cancel;
                        color: Theme.text-secondary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- rename dialog ----------------------------------------------
    if root.rename-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                root.rename-open = false;
                root.keyboard-dismiss();
            }
        }

        Rectangle {
            x: 16px;
            y: max(root.inset-top + 80px, (parent.height - self.height) / 2);
            width: parent.width - 32px;
            height: 184px;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 10px;
                Text {
                    height: 24px;
                    text: I18n.common_rename;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                FormField {
                    label: "会话名称";
                    placeholder: "输入新的会话名称";
                    auto-focus: true;
                    commit-on-blur: false;
                    text <=> root.rename-title;
                    committed => { root.commit-rename(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Action {
                        width: 76px;
                        label: I18n.common_cancel;
                        show-label: true;
                        clicked => {
                            root.rename-open = false;
                            root.keyboard-dismiss();
                        }
                    }
                    Action {
                        width: 84px;
                        label: I18n.common_save;
                        show-label: true;
                        primary: true;
                        enabled: root.rename-title != "";
                        clicked => { root.commit-rename(); }
                    }
                }
            }
        }
    }

    if root.delete-archived-open : ConfirmDialog {
        width: 100%;
        height: parent.height - root.ime-height;
        title: I18n.common_confirm_delete;
        message: "删除后无法恢复该会话及其本地记录。";
        confirm-label: I18n.common_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => {
            root.delete-archived-open = false;
            root.delete-archived-session(root.pending-delete-id);
            root.pending-delete-id = "";
        }
        canceled => {
            root.delete-archived-open = false;
            root.pending-delete-id = "";
        }
    }

    // ---- workspaces page --------------------------------------------
    if root.workspaces-open : WorkspacesPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        workspaces: root.workspaces;
        overlay <=> root.workspace-overlay;
        back() => {
            root.workspaces-open = false;
            root.workspace-overlay = 0;
        }
        refresh() => { root.refresh-workspaces(); }
        select(id) => { root.select-workspace(id); }
        new-task(id) => { root.new-task-in-workspace(id); }
        create(name, icon, color) => { root.create-workspace(name, icon, color); }
        update(id, name, icon, color) => { root.update-workspace(id, name, icon, color); }
        remove-workspace(id) => { root.delete-workspace(id); }
    }

    // ---- working directory page -------------------------------------
    if root.workspace-open : WorkspacePage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        workspace-name: root.workspace-name;
        path: root.workspace-path;
        parent-path: root.workspace-parent-path;
        total: root.workspace-total;
        loading: root.workspace-loading;
        error: root.workspace-error;
        entries: root.workspace-entries;
        sheet-open <=> root.workspace-sheet-open;
        back() => {
            root.workspace-open = false;
            root.workspace-sheet-open = false;
        }
        refresh() => { root.refresh-workspace(); }
        open-path(path) => { root.open-workspace(path); }
        upload(dir) => { root.upload-workspace(dir); }
        download(path) => { root.download-workspace(path); }
        load-more() => {
            root.load-more-workspace(root.workspace-path, root.workspace-entries.length);
        }
    }

    // ---- trajectory page --------------------------------------------
    if root.trajectory-open : TrajectoryPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        title: "线程轨迹";
        session-title: root.trajectory-title != "" ? root.trajectory-title : root.trajectory-session-title;
        loading: root.trajectory-loading;
        error: root.trajectory-error;
        items: root.trajectory-items;
        audit: root.trajectory-audit;
        segments: root.trajectory-segments;
        filter <=> root.trajectory-filter;
        filter-changed(filter) => { root.trajectory-filter-changed(filter); }
        expanded <=> root.trajectory-expanded;
        back() => { root.trajectory-open = false; }
        retry() => {
            root.load-trajectory(root.trajectory-session-id, root.trajectory-session-title);
        }
    }

    // ---- 首次运行环境部署引导 ---------------------------------------
    // 放在所有页面之上、toast 之下：安装期间整屏不可操作，完成/失败提示仍可见。
    if root.env-setup-open : EnvSetupPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        state: root.settings-ubuntu-state;
        progress: root.env-setup-progress;
        stage: root.settings-ubuntu-stage;
        version: root.settings-ubuntu-version;
        error: root.settings-ubuntu-error;
        retry() => { root.env-setup-retry(); }
        dismiss() => { root.env-setup-dismiss(); }
    }

    // ---- toast -------------------------------------------------------
    if root.toast != "" : Rectangle {
        x: 16px;
        y: parent.height - root.inset-bottom - 190px;
        width: parent.width - 32px;
        height: toast-text.preferred-height + 20px;
        border-radius: Theme.radius-sm;
        background: #1F2329E6;
        toast-text := Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            text: root.toast;
            color: white;
            font-size: Theme.font-sm;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
