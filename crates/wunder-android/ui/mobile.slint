// 茧 (Cocoon) — Android shell for the same chat surface as 蛹.
//
// The visual language must not fork: this file imports 蛹's theme, composer,
// timeline and icon assets in place, so a change in `frontend-slint/ui`
// reaches both shells. Only the shell chrome (single window, drawer, safe
// area) is mobile specific.

import { I18n } from "../../../frontend-slint/ui/i18n.slint";
export { I18n }
import { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric } from "../../../frontend-slint/ui/theme.slint";
export { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric }
import { TimelineView } from "../../../frontend-slint/ui/timeline.slint";
import { Composer } from "../../../frontend-slint/ui/composer.slint";
import { Action } from "../../../frontend-slint/ui/components.slint";
import { MobileSettings } from "settings.slint";
import { ListView } from "std-widgets.slint";

// One row of the mobile thread drawer. The projection lives in Rust; this is
// a flat, bounded card so a long thread list stays cheap to scroll.
export struct MobileSession {
    id: string,
    title: string,
    preview: string,
    time: string,
    status: string,
    active: bool,
}

export component MobileWindow inherits Window {
    title: "茧";
    background: Theme.panel;
    // Same face and base size as 蛹's window: the bundled YaHei is registered
    // before the first frame by src/fonts.rs.
    default-font-family: "Microsoft YaHei";
    default-font-size: Theme.font-md;

    // ---- thread list -------------------------------------------------
    in-out property <[MobileSession]> sessions: [];
    in-out property <bool> drawer-open: false;
    in-out property <string> thread-title: "";
    in property <string> thread-subtitle: "";
    in property <string> connection-state: "";
    in property <string> toast: "";

    // ---- transcript --------------------------------------------------
    in-out property <[TimelineRow]> rows: [];
    in property <string> greeting: "";
    in property <bool> loading: false;
    in-out property <bool> follow-output: true;
    in property <bool> spinning: false;
    in property <int> stream-revision: 0;
    // Height of the soft keyboard, published by the Rust tick from Slint's
    // virtual-keyboard rect. The window is edge-to-edge, so the activity does
    // not resize itself; the shell shrinks instead.
    in property <length> ime-height: 0px;

    // ---- composer ----------------------------------------------------
    in-out property <string> draft: "";
    in property <bool> generating: false;
    in property <bool> stopping: false;
    in property <[ModelCard]> models: [];
    in property <int> model-catalogue-count: 0;
    in property <string> model-name: "";
    in property <string> model-key: "";
    in property <bool> model-saving: false;
    in property <bool> cloud-ready: true;
    in property <[ChatAttachment]> attachments: [];
    in property <string> send-key: "enter";
    in property <string> workspace-name: "";
    in property <string> branch-name: "";
    in-out property <string> reasoning-effort: "default";
    in-out property <string> permission-mode: "full_auto";

    // ---- settings sheet ---------------------------------------------
    in-out property <bool> settings-open: false;
    in-out property <int> settings-page: 0;
    in property <string> settings-theme: "terracotta";
    in property <int> settings-font-size: 14;
    in property <string> settings-send-key: "enter";
    in property <string> settings-language: "zh-CN";
    in property <string> settings-workspace: "";
    in property <string> settings-version: "";
    in property <string> settings-ubuntu-state: "missing";
    in property <int> settings-ubuntu-progress: 0;
    in property <string> settings-ubuntu-stage: "";
    in property <string> settings-ubuntu-version: "";
    in property <string> settings-ubuntu-error: "";
    in property <bool> settings-ubuntu-enabled: false;
    in property <bool> editor-open: false;
    in property <bool> editor-new: false;
    in property <bool> editor-default: false;
    in property <string> editor-key: "";
    in-out property <ModelCard> editor-draft;
    in-out property <string> editor-secret: "";
    in property <string> editor-error: "";
    in property <string> editor-probe: "";
    in property <bool> editor-probing: false;
    in property <string> editor-probed-context: "";

    // ---- intents -----------------------------------------------------
    callback open-drawer();
    callback close-drawer();
    callback select-session(string);
    callback new-session();
    callback send();
    callback stop();
    callback select-model(int, string);
    callback open-model-settings();
    callback reasoning-effort-changed(string);
    callback permission-changed(string);
    callback remove-attachment(int);
    callback copy-text(string);
    callback toggle-row(int);
    callback draft-changed(string);
    callback open-settings(int);
    callback close-settings();
    callback save-theme(string);
    callback save-font-size(int);
    callback save-send-key(string);
    callback save-language(string);
    callback install-ubuntu();
    callback set-ubuntu-enabled(bool);
    callback open-model-editor(string);
    callback close-model-editor();
    callback save-model(ModelCard, string);
    callback probe-model(ModelCard, string);
    callback delete-model(string);
    callback set-default-model(string);

    private property <length> inset-top: self.safe-area-insets.top;
    private property <length> inset-bottom: self.safe-area-insets.bottom;
    private property <length> header-height: 52px;

    VerticalLayout {
        // The keyboard overlays the window; lift the whole stack above it.
        // The activity never resizes (adjustNothing), so both the height and
        // the top anchor must be explicit.
        x: 0px;
        y: 0px;
        height: root.height - root.ime-height;
        spacing: 0px;

        // ---- header ---------------------------------------------------
        Rectangle {
            height: root.header-height + root.inset-top;
            background: Theme.surface;

            // The safe-area strip keeps the same surface; only the content
            // below it is padded, so a notch never clips the title.
            Rectangle {
                y: root.inset-top;
                height: root.header-height;
                width: parent.width;
                background: transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Action {
                        width: 34px;
                        height: 34px;
                        icon-size: 17px;
                        icon: @image-url("../../../frontend-slint/assets/icons/bars.svg");
                        label: I18n.act_tab_sessions;
                        clicked => { root.open-drawer(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.thread-title == "" ? I18n.chat_greeting : root.thread-title;
                                color: Theme.text;
                                font-size: Theme.font-lg;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-alignment: left;
                            }
                            Text {
                                text: root.thread-subtitle;
                                color: Theme.muted;
                                font-size: Theme.font-2xs;
                                overflow: elide;
                                horizontal-alignment: left;
                                visible: root.thread-subtitle != "";
                            }
                        }
                    }

                    Action {
                        width: 34px;
                        height: 34px;
                        icon-size: 17px;
                        icon: @image-url("../../../frontend-slint/assets/icons/fa-pen-to-square.svg");
                        label: I18n.chat_new_thread;
                        clicked => { root.new-session(); }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ---- transcript ----------------------------------------------
        // 蛹's TimelineView already owns the reading column, follow-output
        // behaviour and every entry kind; the phone only gives it the screen.
        TimelineView {
            vertical-stretch: 1;
            rows: root.rows;
            greeting: root.greeting;
            loading: root.loading;
            follow-output <=> root.follow-output;
            spinning: root.spinning;
            stream-revision: root.stream-revision;
            toggle(index) => { root.toggle-row(index); }
            copy-text(text) => { root.copy-text(text); }
            preview-prompt() => { }
            load-older() => { }
            process-page(index, direction) => { }
            copy-original(id) => { }
            open-resource(path) => { }
            show-context-menu(x, y, selected) => { }
        }

        // ---- composer -------------------------------------------------
        Composer {
            // The action bar must sit above the navigation gesture area; the
            // safe-area strip below owns the inset.
            draft <=> root.draft;
            busy: root.loading;
            generating: root.generating;
            stopping: root.stopping;
            models: root.models;
            model-catalogue-count: root.model-catalogue-count;
            model-name: root.model-name;
            model-key: root.model-key;
            model-saving: root.model-saving;
            cloud-ready: root.cloud-ready;
            attachments: root.attachments;
            send-key: root.send-key;
            show-host-hud: false;
            show-cli-action: false;
            workspace-name: root.workspace-name;
            branch-name: root.branch-name;
            reasoning-effort <=> root.reasoning-effort;
            permission-mode <=> root.permission-mode;
            send() => { root.send(); }
            stop() => { root.stop(); }
            select-model(index, key) => { root.select-model(index, key); }
            open-model-settings() => { root.open-model-settings(); }
            reasoning-effort-changed(value) => { root.reasoning-effort-changed(value); }
            permission-changed(value) => { root.permission-changed(value); }
            remove-attachment(index) => { root.remove-attachment(index); }
        }

        // Bottom safe area: a strip of the chat surface under the composer.
        Rectangle {
            // The keyboard replaces the navigation bar, so the gesture inset
            // must not stack on top of the keyboard height.
            height: root.ime-height > 0px ? 0px : root.inset-bottom;
            background: Theme.panel;
            visible: root.inset-bottom > 0px && root.ime-height == 0px;
        }
    }

    // ---- thread drawer ----------------------------------------------
    if root.drawer-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.close-drawer(); }
        }
    }

    if root.drawer-open : Rectangle {
        x: 0px;
        y: 0px;
        width: min(parent.width * 0.86, 340px);
        height: 100%;
        background: Theme.surface;
        drop-shadow-color: #00000033;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: 4px;

        VerticalLayout {
            padding-top: root.inset-top;
            spacing: 0px;

            Rectangle {
                height: 56px;
                background: transparent;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: I18n.act_tab_sessions;
                        color: Theme.text;
                        font-size: Theme.font-xl;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Action {
                        width: 34px;
                        height: 34px;
                        icon-size: 16px;
                        icon: @image-url("../../../frontend-slint/assets/icons/fa-plus.svg");
                        label: I18n.chat_new_thread;
                        clicked => { root.new-session(); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            ListView {
                vertical-stretch: 1;
                for session in root.sessions : Rectangle {
                    height: 68px;
                    background: session.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
                    touch := TouchArea {
                        clicked => { root.select-session(session.id); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        // Status dot mirrors the sidebar's running/idle signal.
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: session.status == "running" ? Theme.accent
                                : session.status == "failed" ? Theme.danger
                                : session.status == "queued" ? Theme.warning
                                : Theme.border-strong;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: session.title;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    font-weight: session.active ? 600 : 400;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: session.time;
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: session.preview;
                                color: Theme.muted;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                height: 48px;
                background: settings-touch.has-hover ? Theme.hover : transparent;
                settings-touch := TouchArea {
                    clicked => { root.open-settings(0); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../../../frontend-slint/assets/icons/gear.svg");
                        colorize: Theme.muted;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.sidebar_settings;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v" + root.settings-version;
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Text {
                height: 40px;
                text: root.connection-state;
                color: Theme.muted;
                font-size: Theme.font-2xs;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // ---- settings sheet ---------------------------------------------
    if root.settings-open : MobileSettings {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        ime-height: root.ime-height;
        page <=> root.settings-page;
        theme: root.settings-theme;
        font-size: root.settings-font-size;
        send-key: root.settings-send-key;
        language: root.settings-language;
        permission-mode <=> root.permission-mode;
        current-model: root.model-name;
        model-count: root.model-catalogue-count;
        workspace: root.settings-workspace;
        version: root.settings-version;
        ubuntu-state: root.settings-ubuntu-state;
        ubuntu-progress: root.settings-ubuntu-progress;
        ubuntu-stage: root.settings-ubuntu-stage;
        ubuntu-version: root.settings-ubuntu-version;
        ubuntu-error: root.settings-ubuntu-error;
        ubuntu-enabled: root.settings-ubuntu-enabled;
        models: root.models;
        editor-open: root.editor-open;
        editor-new: root.editor-new;
        editor-default: root.editor-default;
        editor-key: root.editor-key;
        draft <=> root.editor-draft;
        secret <=> root.editor-secret;
        editor-error: root.editor-error;
        editor-probe: root.editor-probe;
        editor-probing: root.editor-probing;
        editor-probed-context: root.editor-probed-context;
        close() => { root.close-settings(); }
        save-theme(value) => { root.save-theme(value); }
        save-font-size(value) => { root.save-font-size(value); }
        save-send-key(value) => { root.save-send-key(value); }
        save-language(value) => { root.save-language(value); }
        install-ubuntu() => { root.install-ubuntu(); }
        set-ubuntu-enabled(value) => { root.set-ubuntu-enabled(value); }
        permission-changed(value) => { root.permission-changed(value); }
        open-model-editor(key) => { root.open-model-editor(key); }
        close-model-editor() => { root.close-model-editor(); }
        save-model(card, secret) => { root.save-model(card, secret); }
        probe-model(card, secret) => { root.probe-model(card, secret); }
        delete-model(key) => { root.delete-model(key); }
        set-default-model(key) => { root.set-default-model(key); }
    }

    // ---- toast -------------------------------------------------------
    if root.toast != "" : Rectangle {
        x: 16px;
        y: parent.height - root.inset-bottom - 190px;
        width: parent.width - 32px;
        height: toast-text.preferred-height + 20px;
        border-radius: Theme.radius-sm;
        background: #1F2329E6;
        toast-text := Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            text: root.toast;
            color: white;
            font-size: Theme.font-sm;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
