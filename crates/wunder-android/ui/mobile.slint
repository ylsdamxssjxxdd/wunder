    private property <length> inset-top: self.safe-area-insets.top;
    private property <length> inset-bottom: self.safe-area-insets.bottom;
    private property <length> header-height: 52px;
    // Secondary lists fit five 48px rows plus the 46px back header without
    // scrolling on a standard phone.
    private property <length> plus-panel-height: root.plus-open
        ? (root.plus-view == 0 ? 100px : 312px) + root.inset-bottom : 0px;

    function commit-rename() {
        if root.rename-title == "" {
            return;
        }
        root.rename-open = false;
        root.keyboard-dismiss();
        root.rename-session(root.rename-id, root.rename-title);
    }

    function open-thread-trajectory(id: string, title: string) {
        root.trajectory-session-id = id;
        root.trajectory-session-title = title;
        root.trajectory-expanded = -1;
        root.trajectory-open = true;
        root.load-trajectory(id, title);
    }

    function rename-thread(id: string, title: string) {
        root.rename-id = id;
        root.rename-title = title;
        root.rename-open = true;
    }

    function archive-thread(id: string) {
        root.archive-session(id);
    }

    function begin-file-rename() {
        root.file-rename-path = root.file-pending.path;
        root.file-rename-name = root.file-pending.name;
        root.file-sheet-open = false;
        root.file-rename-open = true;
    }

    function commit-file-rename() {
        if root.file-rename-name == "" {
            return;
        }
        root.file-rename-open = false;
        root.keyboard-dismiss();
        root.workspace-rename(root.file-rename-path, root.file-rename-name);
    }

    function confirm-file-delete() {
        root.file-delete-open = false;
        root.workspace-delete(root.file-pending.path);
    }

    function move-file(target: string) {
        root.file-move-open = false;
        root.workspace-move(root.file-pending.path, target);
    }

    function toggle-plus() {
        root.plus-open = !root.plus-open;
        if !root.plus-open {
            root.plus-view = 0;
        } else {
            root.plus-panel-opened();
        }
    }

    changed plus-open => {
        if !root.plus-open {
            root.plus-view = 0;
        }
    }

    changed drawer-open => {
        if root.drawer-open {
            root.keyboard-dismiss();
        } else {
            root.workspace-sheet-open = false;
            root.workspace-delete-armed = false;
        }
    }

    changed workspace-open => {
        if !root.workspace-open {
            root.file-sheet-open = false;
            root.file-rename-open = false;
            root.file-delete-open = false;
            root.file-move-open = false;
        }
    }

    changed workspaces-open => {
        if !root.workspaces-open {
            root.workspace-overlay = 0;
        }
    }

    function close-plus() {
        root.plus-open = false;
        root.plus-view = 0;
    }

    function pick-draft(value: string) {
        root.draft = value;
        root.close-plus();
    }

    function show-workspace-sheet() {
        root.refresh-workspaces();
        root.workspace-delete-armed = false;
        root.workspace-sheet-open = true;
    }

    // The device row's plus creates a workspace directly, the desktop
    // selector's twin. The catalogue page opens with its editor already up.
    function show-workspace-create() {
        root.close-plus();
        root.close-drawer();
        root.workspaces-open = true;
        root.open-workspaces();
        root.workspace-overlay = 2;
    }

    VerticalLayout {
        // The keyboard overlays the window; lift the whole stack above it.
        // The activity never resizes (adjustNothing), so both the height and
        // the top anchor must be explicit.
        x: 0px;
        y: 0px;
        height: root.height - root.ime-height;
        spacing: 0px;

        // ---- header ---------------------------------------------------
        Rectangle {
            height: root.header-height + root.inset-top;
            background: Theme.surface;

            // The safe-area strip keeps the same surface; only the content
            // below it is padded, so a notch never clips the title.
            Rectangle {
                y: root.inset-top;
                height: root.header-height;
                width: parent.width;
                background: transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    cross-axis-alignment: center;

                    Action {
                        width: 36px;
                        height: 36px;
                        icon-size: 18px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/bars.svg");
                        label: I18n.dk_threads_title;
                        clicked => { root.open-drawer(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            HorizontalLayout {
                                height: 36px;
                                alignment: center;
                                Rectangle {
                                    width: min(model-chip-label.preferred-width, 200px) + 44px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: model-chip-touch.has-hover ? Theme.hover : transparent;
                                    model-chip-label := Text {
                                        visible: false;
                                        text: root.model-catalogue-count > 0 && root.model-name != ""
                                            ? root.model-name : "选择模型";
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                    }
                                    // Same liquid brain gauge as 桌面版's ModelPicker:
                                    // the base glyph stays muted and the accent copy
                                    // rises from the bottom as context fills.
                                    Rectangle {
                                        x: 10px;
                                        y: 10px;
                                        width: 16px;
                                        height: 16px;

                                        Image {
                                            x: 0px;
                                            y: 0px;
                                            width: 16px;
                                            height: 16px;
                                            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/brain.svg");
                                            colorize: Theme.muted;
                                            image-fit: contain;
                                        }

                                        Rectangle {
                                            x: 0px;
                                            y: 16px - 16px * root.context-fill;
                                            width: 16px;
                                            height: 16px * root.context-fill;
                                            clip: true;

                                            Image {
                                                x: 0px;
                                                y: -16px * (1.0 - root.context-fill);
                                                width: 16px;
                                                height: 16px;
                                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/brain.svg");
                                                colorize: root.context-color;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                    Text {
                                        x: 32px;
                                        width: min(model-chip-label.preferred-width, 200px);
                                        height: 100%;
                                        text: root.model-catalogue-count > 0 && root.model-name != ""
                                            ? root.model-name : "选择模型";
                                        color: root.model-catalogue-count > 0 ? Theme.text : Theme.muted;
                                        font-size: Theme.font-md;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    model-chip-touch := TouchArea {
                                        clicked => {
                                            if root.settings-chat-target == 0 {
                                                root.keyboard-dismiss();
                                                root.model-sheet-open = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Action {
                        width: 36px;
                        height: 36px;
                        icon-size: 18px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-pen-to-square.svg");
                        label: I18n.chat_new_thread;
                        clicked => {
                            root.close-plus();
                            root.new-session();
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ---- transcript ----------------------------------------------
        // 桌面版's TimelineView already owns the reading column, follow-output
        // behaviour and every entry kind; the phone only gives it the screen.
        TimelineView {
            vertical-stretch: 1;
            rows: root.rows;
            turn-marks: root.turn-marks;
            mobile: true;
            greeting: root.greeting;
            loading: root.loading;
            follow-output <=> root.follow-output;
            spinning: root.spinning;
            stream-revision: root.stream-revision;
            toggle(index) => { root.toggle-row(index); }
            copy-text(text) => { root.copy-text(text); }
            fork-thread(round) => { root.fork-thread(round); }
            preview-prompt() => {
                root.prompt-preview = "";
                root.prompt-preview-error = "";
                root.prompt-preview-loading = true;
                root.prompt-preview-open = true;
                root.load-prompt-preview();
            }
            load-older() => { }
            process-page(index, direction) => { }
            copy-original(id) => { }
            open-resource(path) => { }
            show-context-menu(x, y, selected) => { }
        }

        // ---- composer -------------------------------------------------
        // Phone breathing room: the desktop band is flush; on a handset the
        // input card and its action row need a side gutter so the send square
        // never sits against the display edge.
        composer-band := Rectangle {
            background: Theme.panel;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 6px;

                // 首次配置引导：本机聊天还没有任何真实模型时给出直达设置页的入口；
                // 云端线程用自己的模型目录，不显示。
                if root.needs-model-setup && root.settings-chat-target == 0 : ModelSetupBanner {
                    setup() => { root.setup-first-model(); }
                }

                // 计划胶囊：有计划步骤时常驻；展开的清单浮在它上方。
                if root.activity-steps-total > 0 : StatusDock {
                    running: root.activity-running;
                    steps-done: root.activity-steps-done;
                    steps-total: root.activity-steps-total;
                    plan-explanation: root.activity-plan-explanation;
                    plan-steps: root.activity-plan-steps;
                    current-step: root.activity-plan-current;
                    current-position: root.activity-plan-position;
                    expanded <=> root.activity-plan-expanded;
                    dismiss => { root.activity-plan-dismiss(); }
                }

                // 目标横幅：目标存在且未完成时常驻，可编辑、暂停、清除。
                if root.goal-visible && root.goal-objective != "" : GoalBanner {
                    objective: root.goal-objective;
                    elapsed: root.goal-elapsed;
                    phase: root.goal-phase;
                    activation: root.goal-activation;
                    rounds: root.goal-rounds;
                    paused: root.goal-paused;
                    editing <=> root.goal-editing;
                    edit-draft <=> root.goal-edit-draft;
                    save(text) => { root.goal-save(text); }
                    pause-toggle => { root.goal-pause-toggle(); }
                    clear => { root.goal-clear(); }
                }

                // 问询面板：触摸端直接复用桌面版的卡片，下面跟一个显式的提交键。
                // 展开全部时用内部滚动兜住高度，不让面板把输入区挤出屏幕。
                if root.inquiry-total > 0 : Rectangle {
                    height: min(root.height * 0.46, inquiry-stack.preferred-height);
                    background: transparent;
                    inquiry-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: as-needed;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, inquiry-stack.preferred-height);
                        inquiry-stack := VerticalLayout {
                            width: inquiry-scroll.visible-width;
                            spacing: 8px;
                            alignment: start;
                            InquiryPanel {
                                horizontal-stretch: 1;
                                questions: root.inquiry-questions;
                                page: root.inquiry-page;
                                total: root.inquiry-total;
                                expanded: root.inquiry-expanded;
                                option-clicked(row, option) => { root.inquiry-option-clicked(row, option); }
                                other-edited(row, text) => { root.inquiry-other-edited(row, text); }
                                no-preference(row) => { root.inquiry-no-preference(row); }
                                use-recommended(row) => { root.inquiry-use-recommended(row); }
                                page-move(delta) => { root.inquiry-page-move(delta); }
                                expanded-toggle() => { root.inquiry-expanded-toggle(); }
                            }
                            Rectangle {
                                height: 42px;
                                border-radius: Theme.radius-md;
                                background: root.inquiry-ready
                                    ? (inquiry-submit-touch.has-hover ? Theme.accent-deep : Theme.accent)
                                    : Theme.border-strong;
                                inquiry-submit-touch := TouchArea {
                                    enabled: root.inquiry-ready;
                                    clicked => { root.inquiry-submit(); }
                                }
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: root.inquiry-ready ? I18n.inquiry_submit : I18n.inquiry_submit_blocked;
                                    color: #ffffff;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.voice-phase != 0 : HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: 2px;
                    VoiceBar {
                        horizontal-stretch: 1;
                        phase: root.voice-phase;
                        elapsed: root.voice-elapsed;
                        stop() => { root.record-voice(); }
                    }
                }

                composer := Composer {
                    mobile: true;
                    mobile-plus-open: root.plus-open;
                    mobile-plus-toggled() => { root.toggle-plus(); }
                    draft <=> root.draft;
                    busy: root.loading;
                    // 目标续跑期间也显示停止按钮，与桌面版一致。
                    generating: root.generating || root.goal-active;
                    stopping: root.stopping;
                    models: root.models;
                    model-catalogue-count: root.model-catalogue-count;
                    model-name: root.model-name;
                    model-key: root.model-key;
                    model-saving: root.model-saving;
                    cloud-ready: root.cloud-ready;
                    attachments: root.attachments;
                    send-key: root.send-key;
                    show-host-hud: false;
                    show-cli-action: false;
                    branch-name: root.branch-name;
                    send() => {
                        root.close-plus();
                        root.send();
                    }
                    stop() => { root.stop(); }
                    select-model(index, key) => { root.select-model(index, key); }
                    open-model-settings() => { root.open-model-settings(); }
                    remove-attachment(index) => { root.remove-attachment(index); }
                }
            }
        }

        // ---- phone function panel -------------------------------------
        // Tapping + no longer opens the desktop cascade: a full-width panel
        // slides up under the input, exactly like a messenger's attach tray.
        if root.plus-open : Rectangle {
            height: root.plus-panel-height;
            background: Theme.panel;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            if root.plus-view == 0 : VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 2px;
                    // Upload from the phone straight into the active
                    // workspace root; the work-directory page has its own
                    // per-folder upload button.
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/upload.svg");
                        label: "上传文件";
                        clicked => {
                            root.close-plus();
                            root.upload-workspace("");
                        }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: root.voice-phase == 1
                            ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/stop.svg")
                            : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-mic.svg");
                        label: root.voice-phase == 1 ? "停止"
                            : root.voice-phase == 2 ? "识别中"
                            : "录音";
                        active: root.voice-phase == 1;
                        enabled: root.voice-phase != 2;
                        clicked => {
                            root.close-plus();
                            root.record-voice();
                        }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-camera.svg");
                        label: I18n.cp_screenshot;
                        clicked => {
                            root.close-plus();
                            root.capture-screenshot();
                        }
                    }
                    PlusTile {
                        visible: root.settings-chat-target == 0;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/terminal.svg");
                        label: I18n.cp_commands;
                        clicked => { root.plus-view = 1; }
                    }
                    PlusTile {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-wand-sparkles.svg");
                        label: "预设";
                        enabled: root.preset-questions.length > 0;
                        clicked => { root.plus-view = 2; }
                    }
                }
            }

            if root.plus-view != 0 : VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 6px + root.inset-bottom;
                spacing: 0px;
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        spacing: 2px;
                        cross-axis-alignment: center;
                        Action {
                            width: 34px;
                            height: 34px;
                            icon-size: 17px;
                            icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-left.svg");
                            label: "返回";
                            clicked => { root.plus-view = 0; }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.plus-view == 1 ? I18n.cp_commands
                                : I18n.ag_preset_questions;
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 2px;
                        if root.plus-view == 1 : VerticalLayout {
                            spacing: 2px;
                            for command in CommandOptions.items : PanelOption {
                                label: command.label;
                                clicked => { root.pick-draft(command.value); }
                            }
                        }
                        if root.plus-view == 2 : VerticalLayout {
                            spacing: 2px;
                            for question in root.preset-questions : PanelOption {
                                label: question;
                                clicked => { root.pick-draft(question); }
                            }
                        }
                    }
                }
            }
        }

        // Bottom safe area: a strip of the chat surface under the composer.
        Rectangle {
            // The keyboard replaces the navigation bar, so the gesture inset
            // must not stack on top of the keyboard height. The open function
            // panel already carries the inset at its own foot.
            height: root.ime-height > 0px || root.plus-open ? 0px : root.inset-bottom;
            background: Theme.panel;
            visible: root.inset-bottom > 0px && root.ime-height == 0px && !root.plus-open;
        }
    }

    // ---- 选文复制 ----------------------------------------------------
    // 长按选中文本后，核心持有选区；手机没有系统编辑菜单，这里补一个浮动
    // 复制键，锚在选区上方（顶部空间不足时落到选区下方）。按下这个键本身
    // 会先清掉选区，所以复制用的是轮询到的那份文本。
    if root.selection-text != "" && !root.env-setup-open : Rectangle {
        private property <bool> anchored: root.selection-bar-bottom > 0px;
        private property <length> top-limit: root.header-height + root.inset-top + 4px;
        private property <length> bottom-limit: max(self.top-limit, composer-band.y - self.height - 8px);
        private property <length> above: root.selection-bar-y - self.height - 10px;
        private property <length> below: root.selection-bar-bottom + 32px;
        private property <length> raw-y: self.anchored && self.above >= self.top-limit ? self.above : self.below;

        x: self.anchored
            ? clamp(root.selection-bar-x - self.width / 2, 8px, root.width - self.width - 8px)
            : (root.width - self.width) / 2;
        y: self.anchored
            ? clamp(self.raw-y, self.top-limit, self.bottom-limit)
            : composer-band.y - self.height - 12px;
        width: selection-pill.preferred-width;
        height: 36px;

        selection-pill := Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 18px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: #0F172933;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;
                cross-axis-alignment: center;
                // One shared 20px band: the icon centres against the label
                // instead of hanging above its baseline.
                Rectangle {
                    width: 16px;
                    height: 20px;
                    Image {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/copy.svg");
                        colorize: Theme.text;
                        image-fit: contain;
                    }
                }
                Text {
                    height: parent.height;
                    text: "复制";
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        TouchArea {
            clicked => {
                root.copy-text(root.selection-text);
                root.selection-text = "";
            }
        }
    }

    // ---- 选区手柄 ----------------------------------------------------
    // 两个手柄落在选区两端的文字行上；位置由核心按文本排版计算，滚动与换行
    // 都会跟随。拖动只移动对应的一端，不会重新开始选文。
    if root.selection-handles && !root.env-setup-open
        && root.selection-start-y > root.header-height + root.inset-top
        && root.selection-start-y < composer-band.y
        && root.selection-start-x > -8px && root.selection-start-x < root.width + 8px : SelectionKnob {
        start-handle: true;
        knob-x: root.selection-start-x;
        knob-y: root.selection-start-y;
        dragged(start, x, y) => { root.selection-handle-drag(start, x, y); }
    }
    if root.selection-handles && !root.env-setup-open
        && root.selection-end-y > root.header-height + root.inset-top
        && root.selection-end-y < composer-band.y
        && root.selection-end-x > -8px && root.selection-end-x < root.width + 8px : SelectionKnob {
        knob-x: root.selection-end-x;
        knob-y: root.selection-end-y;
        dragged(start, x, y) => { root.selection-handle-drag(start, x, y); }
    }

    // ---- thread drawer ----------------------------------------------
    if root.drawer-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.close-drawer(); }
        }
    }

    if root.drawer-open : Rectangle {
        x: 0px;
        y: 0px;
        width: min(parent.width * 0.86, 340px);
        height: 100%;
        background: Theme.surface;
        drop-shadow-color: #00000033;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: 4px;

        // Swallow taps on the drawer body: only the area outside the panel or
        // the system back gesture closes it. Without this, empty drawer space
        // falls through to the dimming layer underneath.
        TouchArea {
            clicked => { }
        }

        VerticalLayout {
            padding-top: root.inset-top;
            padding-bottom: root.inset-bottom;
            spacing: 0px;

            Rectangle {
                height: 48px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Image {
                        width: 16px; height: 16px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-display.svg");
                        colorize: Theme.accent-ink;
                    }
                    Text {
                        text: root.settings-current-device;
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: "切换设备";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                    Image {
                        width: 12px; height: 12px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-down.svg");
                        colorize: Theme.muted;
                    }
                    // Desktop puts a plus beside the device selector: the same
                    // row owns device switching and workspace creation.
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius-sm;
                        background: ws-add-touch.has-hover ? Theme.hover : transparent;
                        ws-add-touch := TouchArea {
                            enabled: root.settings-chat-target == 0;
                            clicked => { root.show-workspace-create(); }
                        }
                        Image {
                            x: (parent.width - 16px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-plus.svg");
                            colorize: root.settings-chat-target == 0
                                ? (ws-add-touch.has-hover ? Theme.accent-ink : Theme.muted)
                                : Theme.border-strong;
                        }
                    }
                }
                device-chip-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 44px;
                    height: parent.height;
                    clicked => {
                        root.refresh-devices();
                        root.device-sheet-open = true;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // Active workspace sits directly under the device row, mirroring
            // the desktop sidebar where the workspace tree follows the device
            // selector. Tapping opens the full catalogue.
            Rectangle {
                height: 50px;
                background: workspaces-touch.has-hover ? Theme.hover : transparent;
                workspaces-touch := TouchArea {
                    enabled: root.settings-chat-target == 0;
                    clicked => { root.show-workspace-sheet(); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 18px;
                        height: 18px;
                        source: WorkspaceVisual.icon(root.workspace-icon);
                        colorize: WorkspaceVisual.color(root.workspace-color);
                        image-fit: contain;
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.workspace-name == "" ? "工作区" : root.workspace-name;
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: "· " + root.workspace-thread-count + " 线程";
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            vertical-alignment: center;
                        }
                    }
                    if root.settings-chat-target == 0 : RowIconButton {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-down.svg");
                        tip: "切换工作区";
                        clicked => { root.show-workspace-sheet(); }
                    }
                    if root.settings-chat-target == 0 : RowIconButton {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-plus.svg");
                        tip: "新建线程";
                        clicked => {
                            root.close-plus();
                            root.new-session();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            if root.sessions.length == 0 : Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "该工作区还没有线程";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "点上方工作区行的 + 新建";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for session in root.sessions : Rectangle {
                    height: 54px;
                    background: session.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
                    touch := TouchArea {
                        clicked => { root.select-session(session.id); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 6px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        // Status dot mirrors the sidebar's running/idle signal.
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: session.status == "running" ? Theme.accent
                                : session.status == "failed" ? Theme.danger
                                : session.status == "queued" ? Theme.warning
                                : Theme.border-strong;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: session.title;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    font-weight: session.active ? 600 : 400;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: session.time;
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // The three actions sit directly on the row and stay a
                        // tight group, mirroring a compact overflow menu.
                        HorizontalLayout {
                            spacing: 0px;
                            RowIconButton {
                                icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-pen-to-square.svg");
                                tip: "重命名";
                                clicked => { root.rename-thread(session.id, session.title); }
                            }
                            if root.settings-chat-target == 0 : RowIconButton {
                                icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-route.svg");
                                tip: "线程轨迹";
                                clicked => { root.open-thread-trajectory(session.id, session.title); }
                            }
                            RowIconButton {
                                icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/box-archive.svg");
                                tip: "归档";
                                clicked => { root.archive-thread(session.id); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // Working directory is a first-class section beside the workspace,
            // not a row that hides the files behind a second page.
            Rectangle {
                height: 46px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-tree.svg");
                        colorize: Theme.muted;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        Text {
                            text: "工作目录";
                            color: Theme.text;
                            font-size: Theme.font-md;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.settings-chat-target == 0
                                ? (root.workspace-path == "" ? "工作区根目录" : "/" + root.workspace-path)
                                : "仅本机";
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.settings-chat-target == 0 : RowIconButton {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/upload.svg");
                        tip: "上传文件";
                        clicked => { root.upload-workspace(root.workspace-path); }
                    }
                    if root.settings-chat-target == 0 : RowIconButton {
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/rotate-right.svg");
                        tip: "刷新";
                        clicked => { root.refresh-workspace(); }
                    }
                }
            }

            if root.settings-chat-target == 0 : VerticalLayout {
                // Share the drawer's flexible height with the thread list, so
                // a long working directory is not squeezed into four rows.
                vertical-stretch: 1;
                spacing: 0px;
                if root.workspace-path != "" : Rectangle {
                    height: 34px;
                    background: up-touch.has-hover ? Theme.hover : transparent;
                    up-touch := TouchArea {
                        clicked => { root.open-workspace(root.workspace-parent-path); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        Image {
                            width: 12px;
                            height: 12px;
                            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-left.svg");
                            colorize: Theme.muted;
                        }
                        Text {
                            text: "上一级";
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.workspace-loading : Rectangle {
                    height: 34px;
                    Text {
                        x: 16px;
                        text: "正在读取工作目录…";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                }
                if !root.workspace-loading && root.workspace-error != "" : Rectangle {
                    height: 34px;
                    Text {
                        x: 16px;
                        width: parent.width - 28px;
                        text: root.workspace-error;
                        color: Theme.danger;
                        font-size: Theme.font-2xs;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                if !root.workspace-loading && root.workspace-error == "" : ScrollView {
                    // Keep at least three rows; extra drawer height is shared
                    // with the thread list and scrolling handles the rest.
                    vertical-stretch: 1;
                    min-height: 126px;
                    vertical-scrollbar-policy: as-needed;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 0px;
                        for entry in root.workspace-entries : DrawerFileRow {
                            entry: entry;
                            open-folder() => { root.open-workspace(entry.path); }
                            open-file() => { root.open-workspace-file(entry.path); }
                            open-actions() => {
                                root.file-pending = entry;
                                root.file-sheet-open = true;
                            }
                        }
                        if root.workspace-entries.length == 0 : Rectangle {
                            height: 42px;
                            Text {
                                x: 16px;
                                text: "空目录 · 点上方上传按钮";
                                color: Theme.muted;
                                font-size: Theme.font-2xs;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Rectangle {
                height: 48px;
                background: settings-touch.has-hover ? Theme.hover : transparent;
                settings-touch := TouchArea {
                    clicked => { root.open-settings(0); }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image {
                        width: 17px;
                        height: 17px;
                        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/gear.svg");
                        colorize: Theme.muted;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: I18n.sidebar_settings;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "v" + root.settings-version;
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- settings sheet ---------------------------------------------
    if root.settings-open : MobileSettings {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        ime-height: root.ime-height;
        page <=> root.settings-page;
        theme: root.settings-theme;
        font-size: root.settings-font-size;
        send-key: root.settings-send-key;
        language: root.settings-language;
        current-model: root.model-name;
        model-count: root.model-catalogue-count;
        workspace: root.settings-workspace;
        version: root.settings-version;
        ubuntu-state: root.settings-ubuntu-state;
        ubuntu-progress: root.settings-ubuntu-progress;
        ubuntu-stage: root.settings-ubuntu-stage;
        ubuntu-version: root.settings-ubuntu-version;
        ubuntu-error: root.settings-ubuntu-error;
        ubuntu-enabled: root.settings-ubuntu-enabled;
        companion-enabled: root.settings-companion-enabled;
        companion-selected: root.settings-companion-selected;
        companion-selected-name: root.settings-companion-selected-name;
        companion-scale: root.settings-companion-scale;
        companion-hints: root.settings-companion-hints;
        companion-permission: root.settings-companion-permission;
        companion-names: root.settings-companion-names;
        companion-ids: root.settings-companion-ids;
        permissions: root.permission-items;
        permission-summary: root.permission-summary;
        backup-status: root.settings-backup-status;
        backup-path: root.settings-backup-path;
        backup-busy: root.settings-backup-busy;
        backup-restart: root.settings-backup-restart;
