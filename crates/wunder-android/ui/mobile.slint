// wunder 安卓版 (wunder Android) — Android shell for the same chat surface as 桌面版.
//
// The visual language must not fork: this file imports 桌面版's theme, composer,
// timeline and icon assets in place, so a change in `crates/wunder-desktop/frontend/ui`
// reaches both shells. Only the shell chrome (single window, drawer, safe
// area) is mobile specific.

import { I18n } from "../../../crates/wunder-desktop/frontend/ui/i18n.slint";
export { I18n }
import { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric, InquiryQuestion, CommandTask, SubagentItem } from "../../../crates/wunder-desktop/frontend/ui/theme.slint";
export { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric, InquiryQuestion }
import { TimelineView } from "../../../crates/wunder-desktop/frontend/ui/timeline.slint";
import { Composer, CommandOptions, InquiryPanel, ModelSetupBanner } from "../../../crates/wunder-desktop/frontend/ui/composer.slint";
import { Action, FormField, ConfirmDialog } from "../../../crates/wunder-desktop/frontend/ui/components.slint";
import { MobileSettings } from "settings.slint";
import { EnvSetupPage } from "env_setup.slint";
import { TrajectoryPage, TrajectoryItem, TrajectoryAudit, TrajectorySegment } from "trajectory.slint";
import { WorkspacePage, WorkspaceFile } from "workspace.slint";
import { WorkspacesPage } from "workspaces.slint";
import { MobileWorkspace } from "workspace_model.slint";
import { WorkspaceVisual } from "../../../crates/wunder-desktop/frontend/ui/workspace_visual.slint";
export { TrajectoryItem, TrajectoryAudit, TrajectorySegment, MobileWorkspace }
import { MobileSession, MobilePermission } from "session_model.slint";
export { MobileSession, MobilePermission }
import { MobileTool, MobileToolGroup, MobileToolResource, MobileToolFile, MobileMcpDraft, MobileKnowledgeDraft } from "tools_model.slint";
export { MobileTool, MobileToolGroup, MobileToolResource, MobileToolFile, MobileMcpDraft, MobileKnowledgeDraft }
import { MobileCronJob, MobileCronDraft, MobileCronRun, MobileMemory, MobileMemoryDraft, MobileDevice } from "automation_model.slint";
export { MobileCronJob, MobileCronDraft, MobileCronRun, MobileMemory, MobileMemoryDraft, MobileDevice }
import { MobileChannelAccount, MobileChannelCatalog, MobileChannelBinding, MobileChannelLog, MobileChannelDraft } from "channel_model.slint";
export { MobileChannelAccount, MobileChannelCatalog, MobileChannelBinding, MobileChannelLog, MobileChannelDraft }
import { ListView, ScrollView } from "std-widgets.slint";

// One row of the mobile thread drawer. The projection lives in Rust; this is
// a flat, bounded card so a long thread list stays cheap to scroll.

// One square in the phone's function panel: a single soft icon capsule with a
// caption. No outer card or border — the capsule is the whole shape, so five
// thumbs in one row read as one even strip instead of nested boxes.
component PlusTile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    horizontal-stretch: 1;
    height: 74px;
    background: transparent;
    tile-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 7px;
        Rectangle {
            width: 50px;
            height: 50px;
            border-radius: 18px;
            background: root.active ? Theme.accent-soft
                : tile-touch.has-hover ? Theme.selected
                : root.enabled ? Theme.surface : Theme.input-readonly-bg;
            border-width: 1px;
            border-color: root.active ? Theme.danger.with-alpha(0.28) : Theme.border;
            Image {
                x: 14px;
                y: 14px;
                width: 22px;
                height: 22px;
                source: root.icon;
                colorize: root.active ? Theme.danger
                    : root.enabled ? Theme.text-secondary : Theme.border-strong;
                image-fit: contain;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.danger : root.enabled ? Theme.text-secondary : Theme.muted;
            font-size: Theme.font-2xs;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Capture strip above the composer. Recording and transcription stay visible
// after the plus tray closes, and stopping is one tap.
component VoiceBar inherits Rectangle {
    in property <int> phase: 0;
    in property <string> elapsed: "";
    callback stop();
    height: 38px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        cross-axis-alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.phase == 1 ? Theme.danger : Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.phase == 1
                ? "正在录音 · " + root.elapsed + "，点停止结束"
                : "正在识别录音…";
            color: root.phase == 1 ? Theme.danger : Theme.muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.phase == 1 : Action {
            width: 34px;
            height: 30px;
            icon-size: 14px;
            icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/stop.svg");
            label: "停止";
            clicked => { root.stop(); }
        }
    }
}

// One selectable row in a phone function-panel sub-list.
component PanelOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback clicked();
    height: 48px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-soft : option-touch.has-hover ? Theme.hover : transparent;
    option-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        width: parent.width - 44px;
        height: parent.height;
        text: root.label;
        color: root.danger ? Theme.danger : root.selected ? Theme.accent-ink : Theme.text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.selected : Image {
        x: parent.width - 30px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
        colorize: Theme.accent-ink;
    }
}

// One action in a bottom action sheet. Icons keep the sheet scannable and
// mirror the desktop sidebar's row menu.
component SheetAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 52px;
    border-radius: Theme.radius-sm;
    background: action-touch.has-hover ? Theme.hover : transparent;
    action-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: root.danger ? Theme.danger : Theme.text-secondary;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component MobileWindow inherits Window {
    title: "wunder 安卓版";
    background: Theme.panel;
    // Same face and base size as 桌面版's window: the bundled YaHei is registered
    // before the first frame by src/fonts.rs.
    default-font-family: "Microsoft YaHei";
    default-font-size: Theme.font-md;

    // ---- thread list -------------------------------------------------
    in-out property <[MobileSession]> sessions: [];
    in property <[MobileSession]> archived-sessions: [];
    in property <int> archived-total: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> device-sheet-open: false;
    in-out property <string> thread-title: "";
    in property <string> thread-subtitle: "";
    in property <string> toast: "";

    // ---- session actions --------------------------------------------
    in-out property <bool> session-sheet-open: false;
    in-out property <string> session-sheet-id: "";
    in-out property <string> session-sheet-title: "";
    in-out property <bool> session-sheet-archived: false;
    in-out property <bool> rename-open: false;
    in-out property <string> rename-id: "";
    in-out property <string> rename-title: "";
    in-out property <bool> delete-archived-open: false;
    in-out property <string> pending-delete-id: "";

    // ---- transcript --------------------------------------------------
    in-out property <[TimelineRow]> rows: [];
    in property <string> greeting: "";
    in property <bool> loading: false;
    in-out property <bool> follow-output: true;
    in property <bool> spinning: false;
    in property <int> stream-revision: 0;
    // Height of the soft keyboard, published by the Rust tick from Slint's
    // virtual-keyboard rect. The window is edge-to-edge, so the activity does
    // not resize itself; the shell shrinks instead.
    in property <length> ime-height: 0px;

    // ---- trajectory --------------------------------------------------
    in-out property <bool> trajectory-open: false;
    in-out property <string> trajectory-session-id: "";
    in-out property <string> trajectory-session-title: "";
    in property <string> trajectory-title: "";
    in property <bool> trajectory-loading: false;
    in property <string> trajectory-error: "";
    in property <[TrajectoryItem]> trajectory-items: [];
    in property <TrajectoryAudit> trajectory-audit: { enabled: false, start: "", end: "", summary: "", failed: 0 };
    in property <[TrajectorySegment]> trajectory-segments: [];
    in-out property <int> trajectory-filter: 0;
    in-out property <int> trajectory-expanded: -1;

    // ---- working directory -------------------------------------------
    in-out property <bool> workspace-open: false;
    // The page's file action sheet. Kept on the shell so Back can dismiss it
    // before leaving the directory page.
    in-out property <bool> workspace-sheet-open: false;
    in property <string> workspace-path: "";
    in property <string> workspace-parent-path: "";
    in property <int> workspace-total: 0;
    in property <bool> workspace-loading: false;
    in property <string> workspace-error: "";
    in property <[WorkspaceFile]> workspace-entries: [];

    // ---- workspaces --------------------------------------------------
    in-out property <bool> workspaces-open: false;
    // The picker's topmost sheet (0 none / 1 row menu / 2 editor / 3 delete);
    // Back dismisses it before leaving the page.
    in-out property <int> workspace-overlay: 0;
    in property <[MobileWorkspace]> workspaces: [];
    // Active workspace, rendered by the drawer's 工作区 row and the composer.
    in property <string> workspace-icon: "folder";
    in property <string> workspace-color: "blue";
    in property <int> workspace-thread-count: 0;

    // ---- phone function panel ---------------------------------------
    in-out property <bool> plus-open: false;
    // 0 grid, 1 commands, 2 preset questions, 3 approval mode.
    in-out property <int> plus-view: 0;
    in property <[string]> preset-questions: [];
    // Voice capture: 0 idle, 1 recording, 2 transcribing. The strip above the
    // composer owns the stop action; the plus tile mirrors the same state.
    in property <int> voice-phase: 0;
    in property <string> voice-elapsed: "";

    // ---- composer ----------------------------------------------------
    in-out property <string> draft: "";
    in property <bool> generating: false;
    in property <bool> stopping: false;
    in property <[ModelCard]> models: [];
    in property <int> model-catalogue-count: 0;
    // Catalogue only holds the seeded 虚拟模型: show the first-run setup banner.
    in property <bool> needs-model-setup: false;
    in property <string> model-name: "";
    in property <string> model-key: "";
    in property <bool> model-saving: false;
    // The top-centre model chip opens this sheet; the composer's own trigger
    // is hidden on phones.
    in-out property <bool> model-sheet-open: false;
    in property <bool> cloud-ready: true;
    in property <[ChatAttachment]> attachments: [];
    in property <string> send-key: "enter";
    in property <string> workspace-name: "";
    in property <string> branch-name: "";
    in-out property <string> permission-mode: "full_auto";

    // ---- 问询面板 ----------------------------------------------------
    in property <[InquiryQuestion]> inquiry-questions: [];
    in property <int> inquiry-page: 0;
    in property <int> inquiry-total: 0;
    in property <bool> inquiry-expanded: false;
    in property <bool> inquiry-ready: false;

    // ---- settings sheet ---------------------------------------------
    in-out property <bool> settings-open: false;
    in-out property <int> settings-page: 0;
    in property <string> settings-theme: "terracotta";
    in property <int> settings-font-size: 14;
    in property <string> settings-send-key: "enter";
    in property <string> settings-language: "zh-CN";
    in property <string> settings-workspace: "";
    in property <string> settings-version: "";
    // 首次运行环境部署引导页：安装完成前全屏展示进度，不进入聊天界面。
    in-out property <bool> env-setup-open: false;
    // 单调递增的安装进度（Java 的阶段切换会回退，由 Rust 收敛后投影）。
    in property <int> env-setup-progress: 0;
    in property <string> settings-ubuntu-state: "missing";
    in property <int> settings-ubuntu-progress: 0;
    in property <string> settings-ubuntu-stage: "";
    in property <string> settings-ubuntu-version: "";
    in property <string> settings-ubuntu-error: "";
    in property <bool> settings-ubuntu-enabled: false;
    in property <bool> settings-companion-enabled: false;
    in property <string> settings-companion-selected: "";
    in property <string> settings-companion-selected-name: "";
    in property <float> settings-companion-scale: 0.5;
    in property <bool> settings-companion-hints: true;
    in property <string> settings-companion-permission: "unknown";
    in property <[string]> settings-companion-names: [];
    in property <[string]> settings-companion-ids: [];
    // 权限管理页面：通知、麦克风、悬浮窗、无障碍、电池优化、安装应用。
    in property <[MobilePermission]> permission-items: [];
    in property <string> permission-summary: "";
    // 在线更新状态：由引擎检查/下载后投影，页面只按相位渲染。
    in property <string> update-phase: "idle";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-source: "";
    in property <string> update-channel: "cloud";
    in property <string> update-size: "";
    in property <int> update-progress: 0;
    in property <string> update-downloaded: "";
    in property <string> update-error: "";
    in property <bool> editor-open: false;
    in property <bool> editor-new: false;
    in property <bool> editor-default: false;
    in property <string> editor-key: "";
    in-out property <ModelCard> editor-draft;
    in-out property <string> editor-secret: "";
    in property <string> editor-error: "";
    in property <string> editor-probe: "";
    in property <bool> editor-probing: false;
    in property <string> editor-probed-context: "";

    // ---- tool manager -------------------------------------------------
    in property <[MobileTool]> settings-tools-builtin: [];
    in property <[MobileTool]> settings-tools-mcp: [];
    in property <[MobileTool]> settings-tools-skills: [];
    in property <[MobileTool]> settings-tools-knowledge: [];
    in property <[MobileToolResource]> settings-tools-servers: [];
    in property <[MobileToolResource]> settings-tools-skill-resources: [];
    in property <[MobileToolResource]> settings-tools-bases: [];
    in property <[MobileTool]> settings-tool-server-tools: [];
    in property <string> settings-tool-active-server: "";
    in property <string> settings-tool-active-resource: "";
    in property <int> settings-tool-resource-tab: 0;
    in property <bool> settings-tool-resource-editable: false;
    in property <[MobileToolFile]> settings-tool-files: [];
    in property <string> settings-tool-directory: "";
    in property <bool> settings-tool-has-more: false;
    in property <int> settings-tool-editor-kind: 0;
    in property <bool> settings-tool-editor-new: false;
    in property <string> settings-tool-editor-error: "";
    in-out property <MobileMcpDraft> settings-mcp-draft;
    in-out property <MobileKnowledgeDraft> settings-kb-draft;
    in property <bool> settings-tool-file-open: false;
    in property <string> settings-tool-file-path: "";
    in-out property <string> settings-tool-file-content: "";
    in property <bool> settings-tool-file-readonly: false;
    in property <string> settings-tool-file-error: "";

    // ---- built-in agent ----------------------------------------------
    in property <string> settings-agent-name: "";
    in property <int> settings-agent-tool-count: 0;
    in-out property <string> settings-agent-description: "";
    in-out property <string> settings-agent-prompt: "";
    in property <[MobileToolGroup]> settings-agent-groups: [];
    in-out property <string> settings-agent-search: "";
    in property <[string]> settings-agent-questions: [];

    // ---- cron jobs ----------------------------------------------------
    in property <[MobileCronJob]> settings-cron-jobs: [];
    in property <[string]> settings-cron-workspaces: [];
    in property <[MobileCronRun]> settings-cron-runs: [];
    in property <bool> settings-cron-runs-open: false;
    in property <bool> settings-cron-runs-loading: false;
