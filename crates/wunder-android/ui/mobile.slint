// wunder 安卓版 (wunder Android) — Android shell for the same chat surface as 桌面版.
//
// The visual language must not fork: this file imports 桌面版's theme, composer,
// timeline and icon assets in place, so a change in `crates/wunder-desktop/frontend/ui`
// reaches both shells. Only the shell chrome (single window, drawer, safe
// area) is mobile specific.

import { I18n } from "../../../crates/wunder-desktop/frontend/ui/i18n.slint";
export { I18n }
import { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric, InquiryQuestion, CommandTask, SubagentItem, TurnMark, PlanStep } from "../../../crates/wunder-desktop/frontend/ui/theme.slint";
export { Theme, TimelineRow, ChatAttachment, ModelCard, MdBlock, MdCell, Conversation, TurnStatMetric, InquiryQuestion }
import { TimelineView } from "../../../crates/wunder-desktop/frontend/ui/timeline.slint";
import { Composer, CommandOptions, GoalBanner, InquiryPanel, ModelSetupBanner, StatusDock } from "../../../crates/wunder-desktop/frontend/ui/composer.slint";
import { Action, FormField, ConfirmDialog } from "../../../crates/wunder-desktop/frontend/ui/components.slint";
import { MobileSettings } from "settings.slint";
import { MobileToast } from "toast.slint";
import { EnvSetupPage } from "env_setup.slint";
import { TrajectoryPage, TrajectoryItem, TrajectoryAudit, TrajectorySegment, TrajectoryBar } from "trajectory.slint";
import { WorkspacePage, WorkspaceFile } from "workspace.slint";
import { WorkspacesPage } from "workspaces.slint";
import { MobileWorkspace } from "workspace_model.slint";
import { WorkspaceVisual } from "../../../crates/wunder-desktop/frontend/ui/workspace_visual.slint";
export { TrajectoryItem, TrajectoryAudit, TrajectorySegment, MobileWorkspace }
import { MobileSession, MobilePermission } from "session_model.slint";
export { MobileSession, MobilePermission }
import { MobileTool, MobileToolGroup, MobileToolResource, MobileToolFile, MobileMcpDraft, MobileKnowledgeDraft } from "tools_model.slint";
export { MobileTool, MobileToolGroup, MobileToolResource, MobileToolFile, MobileMcpDraft, MobileKnowledgeDraft }
import { MobileCronJob, MobileCronDraft, MobileCronRun, MobileMemory, MobileMemoryDraft, MobileDevice } from "automation_model.slint";
export { MobileCronJob, MobileCronDraft, MobileCronRun, MobileMemory, MobileMemoryDraft, MobileDevice }
import { MobileChannelAccount, MobileChannelCatalog, MobileChannelBinding, MobileChannelLog, MobileChannelDraft } from "channel_model.slint";
export { MobileChannelAccount, MobileChannelCatalog, MobileChannelBinding, MobileChannelLog, MobileChannelDraft }
import { ListView, ScrollView } from "std-widgets.slint";

// One row of the mobile thread drawer. The projection lives in Rust; this is
// a flat, bounded card so a long thread list stays cheap to scroll.

// One square in the phone's function panel: a single soft icon capsule with a
// caption. No outer card or border — the capsule is the whole shape, so five
// thumbs in one row read as one even strip instead of nested boxes.
component PlusTile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    horizontal-stretch: 1;
    height: 74px;
    background: transparent;
    tile-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 7px;
        Rectangle {
            width: 50px;
            height: 50px;
            border-radius: 18px;
            background: root.active ? Theme.accent-soft
                : tile-touch.has-hover ? Theme.selected
                : root.enabled ? Theme.surface : Theme.input-readonly-bg;
            border-width: 1px;
            border-color: root.active ? Theme.danger.with-alpha(0.28) : Theme.border;
            Image {
                x: 14px;
                y: 14px;
                width: 22px;
                height: 22px;
                source: root.icon;
                colorize: root.active ? Theme.danger
                    : root.enabled ? Theme.text-secondary : Theme.border-strong;
                image-fit: contain;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.danger : root.enabled ? Theme.text-secondary : Theme.muted;
            font-size: Theme.font-2xs;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Capture strip above the composer. Recording and transcription stay visible
// after the plus tray closes, and stopping is one tap.
component VoiceBar inherits Rectangle {
    in property <int> phase: 0;
    in property <string> elapsed: "";
    callback stop();
    height: 38px;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        cross-axis-alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.phase == 1 ? Theme.danger : Theme.muted;
        }
        Text {
            horizontal-stretch: 1;
            text: root.phase == 1
                ? "正在录音 · " + root.elapsed + "，点停止结束"
                : "正在识别录音…";
            color: root.phase == 1 ? Theme.danger : Theme.muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.phase == 1 : Action {
            width: 34px;
            height: 30px;
            icon-size: 14px;
            icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/stop.svg");
            label: "停止";
            clicked => { root.stop(); }
        }
    }
}

// One selectable row in a phone function-panel sub-list.
component PanelOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> danger: false;
    callback clicked();
    height: 48px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-soft : option-touch.has-hover ? Theme.hover : transparent;
    option-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        width: parent.width - 44px;
        height: parent.height;
        text: root.label;
        color: root.danger ? Theme.danger : root.selected ? Theme.accent-ink : Theme.text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.selected : Image {
        x: parent.width - 30px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
        colorize: Theme.accent-ink;
    }
}

// One action in a bottom action sheet. Icons keep the sheet scannable and
// mirror the desktop sidebar's row menu.
component SheetAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 52px;
    border-radius: Theme.radius-sm;
    background: action-touch.has-hover ? Theme.hover : transparent;
    action-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: root.danger ? Theme.danger : Theme.text-secondary;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Direct row action in the drawer. Thread rows show rename / trajectory /
// archive inline instead of hiding three taps behind an ellipsis sheet.
component RowIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    callback clicked();

    width: 28px;
    height: 32px;
    border-radius: 6px;
    background: icon-touch.has-hover ? Theme.hover : transparent;
    icon-touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Image {
        x: 7px;
        y: 9px;
        width: 14px;
        height: 14px;
        source: root.icon;
        colorize: Theme.muted;
    }
    accessible-role: button;
    accessible-label: root.tip;
}

// Compact file row in the drawer's inline working-directory section. It keeps
// only the icon and name (no size subtitle); folders navigate, files open the
// shared action sheet.
component DrawerFileRow inherits Rectangle {
    in property <WorkspaceFile> entry;
    callback open-folder();
    callback open-file();
    callback open-actions();

    height: 42px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    row-touch := TouchArea {
        clicked => {
            if root.entry.dir {
                root.open-folder();
            } else {
                root.open-file();
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 8px;
        cross-axis-alignment: center;
        Image {
            width: 16px;
            height: 16px;
            source: root.entry.dir ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-open.svg")
                : root.entry.kind == 1 ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-image.svg")
                : root.entry.kind == 2 ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-film.svg")
                : root.entry.kind == 3 ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/file-zipper.svg")
                : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/file-lines.svg");
            colorize: root.entry.dir ? Theme.accent-ink : Theme.text-secondary;
            image-fit: contain;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.name;
            color: Theme.text;
            font-size: Theme.font-sm;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.entry.dir : Image {
            width: 12px;
            height: 12px;
            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-right.svg");
            colorize: Theme.muted;
        }
        // Folders keep tap-to-enter; the ellipsis opens the same action sheet
        // as files so rename / move / delete also work on directories.
        Rectangle {
            width: 26px;
            height: 30px;
            border-radius: 6px;
            background: more-touch.has-hover ? Theme.hover : transparent;
            more-touch := TouchArea {
                clicked => { root.open-actions(); }
            }
            Image {
                x: 6px;
                y: 8px;
                width: 14px;
                height: 14px;
                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/more-vertical.svg");
                colorize: Theme.muted;
            }
        }
    }
}

// Touch knob on one end of the transcript selection. The core computes the
// caret point; dragging reports window coordinates back so the edge follows
// the text layout instead of a pixel estimate.
component SelectionKnob inherits Rectangle {
    in property <bool> start-handle: false;
    in property <length> knob-x: 0px;
    in property <length> knob-y: 0px;
    callback dragged(bool, length, length);

    width: 40px;
    height: 40px;
    // `knob-y` is the caret line's centre. The circle hangs 12px below it so
    // it does not cover the glyphs; the drag reports the line point back.
    private property <length> circle-drop: 12px;
    x: knob-x - self.width / 2;
    y: knob-y + circle-drop - self.height / 2;

    Rectangle {
        x: 12px;
        y: 12px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        border-width: 2px;
        border-color: #FFFFFF;
        drop-shadow-color: #00000033;
        drop-shadow-blur: 5px;
        drop-shadow-offset-y: 1px;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down || event.kind == PointerEventKind.move {
                root.dragged(
                    root.start-handle,
                    root.x + self.mouse-x,
                    root.y + self.mouse-y - root.circle-drop,
                );
                return EventResult.accept;
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
}

export component MobileWindow inherits Window {
    title: "wunder 安卓版";
    background: Theme.panel;
    // Same face and base size as 桌面版's window: the bundled YaHei is registered
    // before the first frame by src/fonts.rs.
    default-font-family: "Microsoft YaHei";
    default-font-size: Theme.font-md;

    // ---- thread list -------------------------------------------------
    in-out property <[MobileSession]> sessions: [];
    in property <[MobileSession]> archived-sessions: [];
    in property <int> archived-total: 0;
    in-out property <bool> drawer-open: false;
    in-out property <bool> device-sheet-open: false;
    // Workspace switcher sheet, opened from the workspace row. The bottom row
    // deletes the current workspace with an inline confirmation.
    in-out property <bool> workspace-sheet-open: false;
    in-out property <bool> workspace-delete-armed: false;
    in-out property <string> thread-title: "";
    in property <string> thread-subtitle: "";
    in property <string> toast: "";

    // ---- session actions --------------------------------------------
    in-out property <bool> rename-open: false;
    in-out property <string> rename-id: "";
    in-out property <string> rename-title: "";

    // ---- transcript --------------------------------------------------
    in-out property <[TimelineRow]> rows: [];
    // Right-edge turn ruler; one tick per user turn, same shape as the desktop.
    in property <[TurnMark]> turn-marks: [];
    in property <string> greeting: "";
    // ---- 目标横幅 / 计划面板（本机线程） ------------------------------
    in property <bool> goal-visible: false;
    in property <bool> goal-active: false;
    in property <bool> goal-paused: false;
    in property <string> goal-objective: "";
    in property <string> goal-phase: "";
    in property <string> goal-activation: "";
    in property <string> goal-rounds: "";
    in property <string> goal-elapsed: "";
    in-out property <bool> goal-editing: false;
    in-out property <string> goal-edit-draft: "";
    in property <int> activity-steps-total: 0;
    in property <int> activity-steps-done: 0;
    in property <bool> activity-running: false;
    in property <string> activity-plan-explanation: "";
    in property <[PlanStep]> activity-plan-steps: [];
    in property <string> activity-plan-current: "";
    in property <int> activity-plan-position: 0;
    in-out property <bool> activity-plan-expanded: false;

    in property <bool> loading: false;
    in-out property <bool> follow-output: true;
    in property <bool> spinning: false;
    in property <int> stream-revision: 0;
    // Text the transcript selection currently covers. The engine polls the
    // core's selection while it exists; the floating copy action reads this
    // value because tapping the action itself clears the selection first.
    in-out property <string> selection-text: "";
    // Selection geometry in window coordinates: two draggable knobs sit on the
    // caret at either edge so the range can be adjusted after the long press.
    in property <bool> selection-handles: false;
    in property <length> selection-start-x: 0px;
    in property <length> selection-start-y: 0px;
    in property <length> selection-end-x: 0px;
    in property <length> selection-end-y: 0px;
    // Copy action anchor: horizontal centre of the selection, its top line and
    // its bottom line. The pill sits above the top line, or below the bottom
    // one when the header leaves no room.
    in property <length> selection-bar-x: 0px;
    in property <length> selection-bar-y: 0px;
    in property <length> selection-bar-bottom: 0px;
    callback selection-handle-drag(bool, length, length);
    // Height of the soft keyboard, published by the Rust tick from Slint's
    // virtual-keyboard rect. The window is edge-to-edge, so the activity does
    // not resize itself; the shell shrinks instead.
    in property <length> ime-height: 0px;

    // ---- trajectory --------------------------------------------------
    in-out property <bool> trajectory-open: false;
    in-out property <string> trajectory-session-id: "";
    in-out property <string> trajectory-session-title: "";
    in property <string> trajectory-title: "";
    in property <bool> trajectory-loading: false;
    in property <string> trajectory-error: "";
    in property <[TrajectoryItem]> trajectory-items: [];
    in property <TrajectoryAudit> trajectory-audit: { enabled: false, start: "", end: "", span: "", peak: "", summary: "", failed: 0 };
    in property <[TrajectorySegment]> trajectory-segments: [];
    in property <[TrajectoryBar]> trajectory-bars: [];
    in-out property <int> trajectory-filter: 0;
    in-out property <int> trajectory-expanded: -1;

    // ---- working directory -------------------------------------------
    in-out property <bool> workspace-open: false;
    in property <string> workspace-path: "";
    in property <string> workspace-parent-path: "";
    in property <int> workspace-total: 0;
    in property <bool> workspace-loading: false;
    in property <string> workspace-error: "";
    in property <[WorkspaceFile]> workspace-entries: [];
    // Shared file action sheet, used by both the drawer's inline list and the
    // full directory page. It lives on the shell so Back dismisses it first.
    in-out property <bool> file-sheet-open: false;
    in-out property <WorkspaceFile> file-pending: {
        name: "",
        path: "",
        dir: false,
        kind: 5,
        size-text: "",
    };
    in-out property <bool> file-rename-open: false;
    in-out property <string> file-rename-path: "";
    in-out property <string> file-rename-name: "";
    in-out property <bool> file-delete-open: false;
    in-out property <bool> file-move-open: false;

    // ---- workspaces --------------------------------------------------
    in-out property <bool> workspaces-open: false;
    // The picker's topmost sheet (0 none / 1 row menu / 2 editor / 3 delete);
    // Back dismisses it before leaving the page.
    in-out property <int> workspace-overlay: 0;
    in property <[MobileWorkspace]> workspaces: [];
    // Latest host path from the system folder picker while the workspace
    // editor is open.
    in-out property <string> workspace-picked-folder: "";
    // Active workspace, rendered by the drawer's 工作区 row and the composer.
    in property <string> workspace-icon: "folder";
    in property <string> workspace-color: "blue";
    in property <int> workspace-thread-count: 0;

    // ---- phone function panel ---------------------------------------
    in-out property <bool> plus-open: false;
    // 0 grid, 1 commands, 2 preset questions, 3 approval mode.
    in-out property <int> plus-view: 0;
    in property <[string]> preset-questions: [];
    // Voice capture: 0 idle, 1 recording, 2 transcribing. The strip above the
    // composer owns the stop action; the plus tile mirrors the same state.
    in property <int> voice-phase: 0;
    in property <string> voice-elapsed: "";

    // ---- composer ----------------------------------------------------
    in-out property <string> draft: "";
    in property <bool> generating: false;
    in property <bool> stopping: false;
    in property <[ModelCard]> models: [];
    in property <int> model-catalogue-count: 0;
    // Catalogue only holds the seeded 虚拟模型: show the first-run setup banner.
    in property <bool> needs-model-setup: false;
    in property <string> model-name: "";
    in property <string> model-key: "";
    in property <bool> model-saving: false;
    // Active-thread context gauge: the brain fills with context-usage and the
    // model sheet spells out used/capacity. Context-known stays false until
    // both values arrive, so an unknown gauge never looks empty.
    in property <float> context-usage: 0.0;
    in property <bool> context-known: false;
    in property <string> context-counts: "";
    // A compacted thread keeps a red brain at any occupancy: red then means
    // "this history is a summary", not "you are about to run out of room".
    in property <bool> context-compacted: false;
    private property <float> context-fill: min(1.0, max(0.0, root.context-usage));
    private property <color> context-color: root.context-compacted ? #DC2626
        : root.context-usage >= 0.92 ? #DC2626
        : root.context-usage >= 0.82 ? #EA580C : #F97316;
    // The top-centre model chip opens this sheet; the composer's own trigger
    // is hidden on phones.
    in-out property <bool> model-sheet-open: false;
    // System prompt preview opened by the greeting's eye button.
    in-out property <bool> prompt-preview-open: false;
    in-out property <bool> prompt-preview-loading: false;
    in-out property <string> prompt-preview: "";
    in-out property <string> prompt-preview-error: "";
    in property <bool> cloud-ready: true;
    in property <[ChatAttachment]> attachments: [];
    in property <string> send-key: "enter";
    in property <string> workspace-name: "";
    in property <string> workspace-id: "";
    in property <string> branch-name: "";

    // ---- 问询面板 ----------------------------------------------------
    in property <[InquiryQuestion]> inquiry-questions: [];
    in property <int> inquiry-page: 0;
    in property <int> inquiry-total: 0;
    in property <bool> inquiry-expanded: false;
    in property <bool> inquiry-ready: false;

    // ---- settings sheet ---------------------------------------------
    in-out property <bool> settings-open: false;
    in-out property <int> settings-page: 0;
    in property <string> settings-theme: "terracotta";
    in property <int> settings-font-size: 14;
    in property <string> settings-send-key: "enter";
    in property <string> settings-language: "zh-CN";
    // 界面语言跟随设置页写入的 `settings-language`（zh-CN / en-US）。所有
    // `I18n` 文案都是 `zh ? ... : ...` 绑定，所以切换这一个标志即可整屏换语言；
    // 与桌面版同一规则（en 前缀 → 英文），回调在 src/app.rs 落到 `I18n.zh`。
    out property <bool> ui-zh: !settings-language.starts-with("en");
    callback ui-language-changed(bool);
    init => { root.ui-language-changed(root.ui-zh); }
    changed ui-zh => { root.ui-language-changed(root.ui-zh); }
    in property <string> settings-workspace: "";
    in property <string> settings-version: "";
    // 数据与恢复页
    in property <string> settings-backup-status: "";
    in property <string> settings-backup-path: "";
    in property <bool> settings-backup-busy: false;
    in property <bool> settings-backup-restart: false;
    in property <string> settings-crash-log-title: "";
    in property <string> settings-crash-log-text: "";
    in-out property <string> settings-restore-path: "";
    // 首次运行环境部署引导页：安装完成前全屏展示进度，不进入聊天界面。
    in-out property <bool> env-setup-open: false;
    // 单调递增的安装进度（Java 的阶段切换会回退，由 Rust 收敛后投影）。
    in property <int> env-setup-progress: 0;
    // 液面动画相位（单调递增，以 4s 波浪周期为单位），引导页打开期间由引擎 tick 每帧推进。
    in property <float> env-setup-phase: 0.0;
    in property <string> settings-ubuntu-state: "missing";
    in property <int> settings-ubuntu-progress: 0;
    in property <string> settings-ubuntu-stage: "";
    in property <string> settings-ubuntu-version: "";
    in property <string> settings-ubuntu-error: "";
    in property <bool> settings-ubuntu-enabled: false;
    in property <bool> settings-companion-enabled: false;
    in property <string> settings-companion-selected: "";
    in property <string> settings-companion-selected-name: "";
    in property <float> settings-companion-scale: 0.5;
    in property <bool> settings-companion-hints: true;
    in property <string> settings-companion-permission: "unknown";
    in property <[string]> settings-companion-names: [];
    in property <[string]> settings-companion-ids: [];
    // 权限管理页面：通知、麦克风、悬浮窗、无障碍、电池优化、安装应用。
    in property <[MobilePermission]> permission-items: [];
    in property <string> permission-summary: "";
    // 在线更新状态：由引擎检查/下载后投影，页面只按相位渲染。
    in property <string> update-phase: "idle";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-source: "";
    in property <string> update-channel: "cloud";
    in property <string> update-size: "";
    in property <int> update-progress: 0;
    in property <string> update-downloaded: "";
    in property <string> update-error: "";
    in property <bool> editor-open: false;
    in property <bool> editor-new: false;
    in property <bool> editor-default: false;
    in property <string> editor-key: "";
    in-out property <ModelCard> editor-draft;
    in-out property <string> editor-secret: "";
    in property <string> editor-error: "";
    in property <string> editor-probe: "";
    in property <bool> editor-probing: false;
    in property <string> editor-probed-context: "";

    // ---- tool manager -------------------------------------------------
    in property <[MobileTool]> settings-tools-builtin: [];
