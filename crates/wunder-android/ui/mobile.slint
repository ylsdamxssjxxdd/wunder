        channel-draft <=> root.settings-channel-draft;
        close() => { root.close-settings(); }
        save-theme(value) => { root.save-theme(value); }
        save-font-size(value) => { root.save-font-size(value); }
        save-send-key(value) => { root.save-send-key(value); }
        save-language(value) => { root.save-language(value); }
        install-ubuntu() => { root.install-ubuntu(); }
        set-ubuntu-enabled(value) => { root.set-ubuntu-enabled(value); }
        save-companion(enabled, selected, scale, hints) => { root.save-companion(enabled, selected, scale, hints); }
        request-companion-permission() => { root.request-companion-permission(); }
        refresh-permissions() => { root.refresh-permissions(); }
        open-permission(id) => { root.open-permission(id); }
        refresh-backup() => { root.refresh-backup(); }
        backup-now() => { root.backup-now(); }
        restore-backup(path) => { root.restore-backup(path); }
        view-crash-log() => { root.view-crash-log(); }
        check-update() => { root.check-update(); }
        download-update() => { root.download-update(); }
        install-update() => { root.install-update(); }
        select-update-source(source) => { root.select-update-source(source); }
        open-model-editor(key) => { root.open-model-editor(key); }
        close-model-editor() => { root.close-model-editor(); }
        save-model(card, secret) => { root.save-model(card, secret); }
        probe-model(card, secret) => { root.probe-model(card, secret); }
        delete-model(key) => { root.delete-model(key); }
        refresh-tools() => { root.refresh-tools(); }
        select-tool-server(index) => { root.select-tool-server(index); }
        select-tool-resource(tab, index) => { root.select-tool-resource(tab, index); }
        load-tool-directory(directory) => { root.load-tool-directory(directory); }
        more-tool-files() => { root.more-tool-files(); }
        open-tool-file(path) => { root.open-tool-file(path); }
        save-tool-file(path, content) => { root.save-tool-file(path, content); }
        close-tool-file() => { root.close-tool-file(); }
        create-tool-file(name) => { root.create-tool-file(name); }
        upload-tool-files() => { root.upload-tool-files(); }
        delete-tool-resource(tab, name) => { root.delete-tool-resource(tab, name); }
        connect-tool-server(name) => { root.connect-tool-server(name); }
        export-skill(name) => { root.export-skill(name); }
        import-skill() => { root.import-skill(); }
        open-tool-editor(kind, index) => { root.open-tool-editor(kind, index); }
        close-tool-editor() => { root.close-tool-editor(); }
        save-tool-editor(kind, mcp, kb) => { root.save-tool-editor(kind, mcp, kb); }
        refresh-agent() => { root.refresh-agent(); }
        search-agent-tools(query) => { root.search-agent-tools(query); }
        save-agent-text(description, prompt) => { root.save-agent-text(description, prompt); }
        toggle-agent-tool(name, enabled, description, prompt) => { root.toggle-agent-tool(name, enabled, description, prompt); }
        toggle-agent-tool-group(title, select, description, prompt) => { root.toggle-agent-tool-group(title, select, description, prompt); }
        add-agent-question(question, description, prompt) => { root.add-agent-question(question, description, prompt); }
        remove-agent-question(index, description, prompt) => { root.remove-agent-question(index, description, prompt); }
        refresh-cron() => { root.refresh-cron(); }
        toggle-cron(id, enabled) => { root.toggle-cron(id, enabled); }
        delete-cron(id) => { root.delete-cron(id); }
        run-cron-now(id) => { root.run-cron-now(id); }
        open-cron-runs(id) => { root.open-cron-runs(id); }
        close-cron-runs() => { root.close-cron-runs(); }
        open-cron-editor(id) => { root.open-cron-editor(id); }
        close-cron-editor() => { root.close-cron-editor(); }
        save-cron(draft) => { root.save-cron(draft); }
        refresh-memory() => { root.refresh-memory(); }
        search-memory(query) => { root.search-memory(query); }
        set-memory-category(category) => { root.set-memory-category(category); }
        open-memory-editor(index) => { root.open-memory-editor(index); }
        close-memory-editor() => { root.close-memory-editor(); }
        save-memory(draft) => { root.save-memory(draft); }
        delete-memory(id) => { root.delete-memory(id); }
        cloud-login(server, username, password) => { root.cloud-login(server, username, password); }
        cloud-logout() => { root.cloud-logout(); }
        cloud-refresh() => { root.cloud-refresh(); }
        cloud-toggle-sync(enabled) => { root.cloud-toggle-sync(enabled); }
        cloud-set-sharing(enabled, full-shadow) => { root.cloud-set-sharing(enabled, full-shadow); }
        switch-chat-target(target) => { root.switch-chat-target(target); }
        refresh-devices() => { root.refresh-devices(); }
        cloud-refresh-threads() => { root.cloud-refresh-threads(); }
        cloud-new-thread() => { root.cloud-new-thread(); }
        cloud-select-thread(id) => { root.cloud-select-thread(id); }
        cloud-rename(id, title) => { root.cloud-rename(id, title); }
        cloud-archive(id) => { root.cloud-archive(id); }
        decide-approval(id, approve) => { root.decide-approval(id, approve); }
        refresh-channels() => { root.refresh-channels(); }
        select-channel-account(id) => { root.select-channel-account(id); }
        open-channel-editor(id) => { root.open-channel-editor(id); }
        close-channel-editor() => { root.close-channel-editor(); }
        save-channel(draft) => { root.save-channel(draft); }
        toggle-channel(id, enabled) => { root.toggle-channel(id, enabled); }
        delete-channel(id) => { root.delete-channel(id); }
        open-channel-logs(id) => { root.open-channel-logs(id); }
        close-channel-logs() => { root.close-channel-logs(); }
        delete-channel-binding(id) => { root.delete-channel-binding(id); }
        restore-archived(id) => { root.restore-session(id); }
        delete-archived(id) => { root.delete-archived-session(id); }
        refresh-archived() => { root.refresh-archived(); }
    }

    // ---- device switch sheet ----------------------------------------
    if root.device-sheet-open : Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        background: Theme.overlay;
        TouchArea { clicked => { root.device-sheet-open = false; } }
        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px - root.inset-bottom;
            width: parent.width - 16px;
            height: min(parent.height * 0.72, 120px + root.settings-devices.length * 62px + root.inset-bottom);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                HorizontalLayout { height: 4px; alignment: center; Rectangle { width: 40px; height: 4px; border-radius: 2px; background: Theme.border; } }
                Text { height: 40px; text: "切换设备"; color: Theme.text; font-size: Theme.font-md; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for device in root.settings-devices : Rectangle {
                        height: 62px;
                        background: device.current ? Theme.accent-soft : (device-touch.has-hover ? Theme.hover : transparent);
                        device-touch := TouchArea {
                            enabled: device.selectable;
                            clicked => {
                                if device.id == "local" {
                                    root.switch-chat-target(0);
                                    root.device-sheet-open = false;
                                } else if device.id == "cloud" {
                                    root.switch-chat-target(1);
                                    root.device-sheet-open = false;
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 34px; height: 34px;
                                border-radius: 9px;
                                background: Theme.panel;
                                Image {
                                    x: 8px; y: 8px; width: 18px; height: 18px;
                                    source: device.kind == "cloud"
                                        ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-globe.svg")
                                        : device.kind == "desktop"
                                            ? @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-display.svg")
                                            : @image-url("../../../crates/wunder-desktop/frontend/assets/icons/lc-bot.svg");
                                    colorize: Theme.accent-ink;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: device.label; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                                Text {
                                    text: (device.kind == "cloud" ? "云端" : device.kind == "phone" ? "手机" : device.kind == "desktop" ? "桌面" : device.kind == "cli" ? "命令行" : "设备")
                                        + " · " + (device.connected ? "在线" : "离线")
                                        + (device.selectable ? "" : " · 由云端管理");
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    overflow: elide;
                                }
                            }
                            if device.current : Image {
                                width: 16px; height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
                                colorize: Theme.accent-ink;
                            }
                        }
                    }
                }
                if root.settings-devices.length == 0 : Text { height: 48px; text: "暂无可用设备"; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
            }
        }
    }

    // ---- workspace switch sheet ------------------------------------
    if root.workspace-sheet-open : Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                root.workspace-sheet-open = false;
                root.workspace-delete-armed = false;
            }
        }
        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px - root.inset-bottom;
            width: parent.width - 16px;
            height: min(parent.height * 0.72, 128px + root.workspaces.length * 56px + root.inset-bottom);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                HorizontalLayout { height: 4px; alignment: center; Rectangle { width: 40px; height: 4px; border-radius: 2px; background: Theme.border; } }
                Text {
                    height: 40px;
                    text: "切换工作区";
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle { height: 1px; background: Theme.border; }
                ListView {
                    vertical-stretch: 1;
                    for workspace in root.workspaces : Rectangle {
                        height: 56px;
                        background: workspace.active ? Theme.accent-soft : (workspace-touch.has-hover ? Theme.hover : transparent);
                        workspace-touch := TouchArea {
                            clicked => {
                                root.select-workspace(workspace.id);
                                root.workspace-sheet-open = false;
                                root.workspace-delete-armed = false;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 9px;
                                background: Theme.panel;
                                Image {
                                    x: 8px; y: 8px;
                                    width: 18px; height: 18px;
                                    source: WorkspaceVisual.icon(workspace.icon);
                                    colorize: WorkspaceVisual.color(workspace.color);
                                    image-fit: contain;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: workspace.name; color: Theme.text; font-size: Theme.font-sm; font-weight: 600; overflow: elide; }
                                Text { text: "" + workspace.thread_count + " 线程"; color: Theme.muted; font-size: Theme.font-2xs; overflow: elide; }
                            }
                            if workspace.active : Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
                                colorize: Theme.accent-ink;
                            }
                        }
                    }
                }
                if root.workspaces.length == 0 : Text {
                    height: 48px;
                    text: "暂无工作区";
                    color: Theme.muted;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.workspace-delete-armed : Rectangle {
                    height: 46px;
                    background: Theme.danger.with-alpha(0.08);
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        Text {
                            horizontal-stretch: 1;
                            text: "删除当前工作区？";
                            color: Theme.danger;
                            font-size: Theme.font-2xs;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Action {
                            width: 56px;
                            label: "取消";
                            show-label: true;
                            clicked => { root.workspace-delete-armed = false; }
                        }
                        Action {
                            width: 56px;
                            label: "删除";
                            show-label: true;
                            danger: true;
                            clicked => {
                                root.delete-workspace(root.workspace-id);
                                root.workspace-delete-armed = false;
                                root.workspace-sheet-open = false;
                            }
                        }
                    }
                }
                if !root.workspace-delete-armed : Rectangle {
                    height: 42px;
                    background: delete-touch.has-hover ? Theme.hover : transparent;
                    delete-touch := TouchArea {
                        enabled: root.workspace-id != "";
                        clicked => { root.workspace-delete-armed = true; }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/trash.svg");
                            colorize: root.workspace-id != "" ? Theme.danger : Theme.border-strong;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "删除当前工作区";
                            color: root.workspace-id != "" ? Theme.danger : Theme.muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ---- remote approval -------------------------------------------
    if root.settings-approval-open : ConfirmDialog {
        title: "远程操作请求";
        message: "来自 " + root.settings-approval-from + " · " + root.settings-approval-kind + "（" + root.settings-approval-risk + "）\n\n" + root.settings-approval-prompt;
        confirm-label: "允许";
        cancel-label: "拒绝";
        confirmed => { root.decide-approval(root.settings-approval-id, true); }
        canceled => { root.decide-approval(root.settings-approval-id, false); }
    }

    // ---- session action sheet --------------------------------------
    // ---- model picker sheet -----------------------------------------
    if root.model-sheet-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.model-sheet-open = false; }
        }

        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: min(parent.height - root.inset-top - 24px, 460px + root.inset-bottom);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 8px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 2px;

                Rectangle {
                    height: 52px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "选择模型";
                            color: Theme.text;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.workspace-name == "" ? "当前线程使用的模型"
                                : "工作区 · " + root.workspace-name;
                            color: Theme.muted;
                            font-size: Theme.font-2xs;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Same context line as 桌面版's model popover: used / capacity
                // plus the percentage; the brain in the header is the gauge.
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: "上下文占用";
                            color: Theme.muted;
                            font-size: Theme.font-xs;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text: root.context-known
                                ? root.context-counts + " · " + round(root.context-usage * 100.0) + "%"
                                : "—";
                            color: !root.context-known ? Theme.text-secondary : root.context-color;
                            font-size: Theme.font-xs;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                if root.models.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "暂无可用模型";
                        color: Theme.muted;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.models.length > 0 : ListView {
                    vertical-stretch: 1;
                    for model[index] in root.models : Rectangle {
                        height: 58px;
                        border-radius: Theme.radius-sm;
                        background: model.key == root.model-key ? Theme.accent-soft
                            : model-touch.has-hover ? Theme.hover : transparent;
                        opacity: model.disabled ? 0.45 : 1.0;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: model.key;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: model.provider + (model.model != "" ? " · " + model.model : "");
                                    color: Theme.muted;
                                    font-size: Theme.font-2xs;
                                    overflow: elide;
                                    visible: model.provider != "" || model.model != "";
                                }
                            }
                            if model.key == root.model-key : Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/circle-check.svg");
                                colorize: Theme.accent;
                                image-fit: contain;
                            }
                        }
                        model-touch := TouchArea {
                            enabled: !model.disabled && (root.cloud-ready || !model.is-cloud);
                            clicked => {
                                root.model-sheet-open = false;
                                root.select-model(index, model.key);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/gear.svg");
                    label: I18n.st_tab_models;
                    clicked => {
                        root.model-sheet-open = false;
                        root.open-model-settings();
                    }
                }
                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius-sm;
                    background: model-cancel-touch.has-hover ? Theme.hover : transparent;
                    model-cancel-touch := TouchArea {
                        clicked => { root.model-sheet-open = false; }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: I18n.common_cancel;
                        color: Theme.text-secondary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- system prompt preview --------------------------------------
    // The greeting's eye button used to be inert on the phone. The sheet
    // mirrors the desktop preview: frozen prompt of the open thread, loading
    // and error states, copy, and its own scrollbar for long prompts.
    if root.prompt-preview-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.prompt-preview-open = false; }
        }
        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: min(parent.height - 16px, 560px);
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            VerticalLayout {
                padding: 8px;
                padding-bottom: 8px + root.inset-bottom;
                spacing: 2px;
                HorizontalLayout {
                    height: 4px;
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.border;
                    }
                }
                HorizontalLayout {
                    height: 44px;
                    spacing: 6px;
                    cross-axis-alignment: center;
                    Text {
                        horizontal-stretch: 1;
                        text: "系统提示词";
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if !root.prompt-preview-loading && root.prompt-preview != "" : Action {
                        width: 64px;
                        height: 30px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/copy.svg");
                        label: "复制";
                        show-label: true;
                        clicked => { root.copy-text(root.prompt-preview); }
                    }
                    Action {
                        width: 30px;
                        height: 30px;
                        icon-size: 15px;
                        icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/xmark.svg");
                        label: I18n.common_close;
                        clicked => { root.prompt-preview-open = false; }
                    }
                }
                Text {
                    height: 18px;
                    text: "当前线程冻结的系统提示词";
                    color: Theme.muted;
                    font-size: Theme.font-2xs;
                    vertical-alignment: center;
                }
                if root.prompt-preview-loading : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "正在读取系统提示词…";
                        color: Theme.muted;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if !root.prompt-preview-loading && root.prompt-preview-error != "" : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        text: root.prompt-preview-error;
                        color: Theme.danger;
                        font-size: Theme.font-sm;
                        wrap: word-wrap;
                    }
                }
                if !root.prompt-preview-loading && root.prompt-preview-error == "" : prompt-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        padding: 10px;
                        if root.prompt-preview == "" : Text {
                            text: "暂无可用的系统提示词";
                            color: Theme.muted;
                            font-size: Theme.font-sm;
                        }
                        if root.prompt-preview != "" : Text {
                            // Pin the wrap width to the viewport; a vertical
                            // ScrollView otherwise grows to the longest line.
                            width: prompt-scroll.visible-width - 24px;
                            text: root.prompt-preview;
                            color: Theme.text-secondary;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-2xs;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // ---- rename dialog ----------------------------------------------
    if root.rename-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                root.rename-open = false;
                root.keyboard-dismiss();
            }
        }

        Rectangle {
            x: 16px;
            y: max(root.inset-top + 80px, (parent.height - self.height) / 2);
            width: parent.width - 32px;
            height: 184px;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 10px;
                Text {
                    height: 24px;
                    text: I18n.common_rename;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                FormField {
                    label: "会话名称";
                    placeholder: "输入新的会话名称";
                    auto-focus: true;
                    commit-on-blur: false;
                    text <=> root.rename-title;
                    committed => { root.commit-rename(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Action {
                        width: 76px;
                        label: I18n.common_cancel;
                        show-label: true;
                        clicked => {
                            root.rename-open = false;
                            root.keyboard-dismiss();
                        }
                    }
                    Action {
                        width: 84px;
                        label: I18n.common_save;
                        show-label: true;
                        primary: true;
                        enabled: root.rename-title != "";
                        clicked => { root.commit-rename(); }
                    }
                }
            }
        }
    }

    // ---- workspaces page --------------------------------------------
    if root.workspaces-open : WorkspacesPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        workspaces: root.workspaces;
        picked-folder: root.workspace-picked-folder;
        overlay <=> root.workspace-overlay;
        back() => {
            root.workspaces-open = false;
            root.workspace-overlay = 0;
        }
        refresh() => { root.refresh-workspaces(); }
        select(id) => { root.select-workspace(id); }
        new-task(id) => { root.new-task-in-workspace(id); }
        create(name, icon, color, folder) => {
            root.create-workspace(name, icon, color, folder);
        }
        update(id, name, icon, color, folder) => {
            root.update-workspace(id, name, icon, color, folder);
        }
        remove-workspace(id) => { root.delete-workspace(id); }
        pick-folder() => { root.pick-workspace-folder(); }
    }

    // ---- working directory page -------------------------------------
    if root.workspace-open : WorkspacePage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        workspace-name: root.workspace-name;
        path: root.workspace-path;
        parent-path: root.workspace-parent-path;
        total: root.workspace-total;
        loading: root.workspace-loading;
        error: root.workspace-error;
        entries: root.workspace-entries;
        back() => {
            root.workspace-open = false;
        }
        refresh() => { root.refresh-workspace(); }
        open-path(path) => { root.open-workspace(path); }
        upload(dir) => { root.upload-workspace(dir); }
        file-actions(entry) => {
            root.file-pending = entry;
            root.file-sheet-open = true;
        }
        open-file(entry) => { root.open-workspace-file(entry.path); }
        load-more() => {
            root.load-more-workspace(root.workspace-path, root.workspace-entries.length);
        }
    }

    // ---- shared file actions ----------------------------------------
    // One menu for the drawer's inline list and the full directory page.
    if root.file-sheet-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.file-sheet-open = false; }
        }

        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px - root.inset-bottom;
            width: parent.width - 16px;
            height: file-sheet-body.preferred-height;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }

            file-sheet-body := VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    Text {
                        text: root.file-pending.name;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.file-pending.path != root.file-pending.name : Text {
                        text: root.file-pending.path;
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                        overflow: elide;
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                if !root.file-pending.dir : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/log-download.svg");
                    label: "保存到手机";
                    clicked => {
                        root.file-sheet-open = false;
                        root.download-workspace(root.file-pending.path);
                    }
                }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/fa-pen-to-square.svg");
                    label: "重命名";
                    clicked => { root.begin-file-rename(); }
                }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-tree.svg");
                    label: "移动";
                    clicked => {
                        root.file-sheet-open = false;
                        root.file-move-open = true;
                    }
                }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-open.svg");
                    label: "打开文件位置";
                    clicked => {
                        root.file-sheet-open = false;
                        root.open-workspace-location(root.file-pending.path, root.file-pending.dir);
                    }
                }
                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/trash.svg");
                    label: "删除";
                    danger: true;
                    clicked => {
                        root.file-sheet-open = false;
                        root.file-delete-open = true;
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius-sm;
                    background: file-cancel-touch.has-hover ? Theme.hover : transparent;
                    file-cancel-touch := TouchArea {
                        clicked => { root.file-sheet-open = false; }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "取消";
                        color: Theme.text-secondary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Move targets: workspace root, the current parent and direct subfolders.
    if root.file-move-open : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        TouchArea {
            clicked => { root.file-move-open = false; }
        }

        Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px - root.inset-bottom;
            width: parent.width - 16px;
            height: move-sheet-body.preferred-height;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }

            move-sheet-body := VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    Text {
                        text: "移动「" + root.file-pending.name + "」";
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: "选择目标文件夹";
                        color: Theme.muted;
                        font-size: Theme.font-2xs;
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-tree.svg");
                    label: "工作区根目录";
                    clicked => { root.move-file(""); }
                }
                if root.workspace-path != "" : SheetAction {
                    icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/chevron-left.svg");
                    label: "上一级目录";
                    clicked => { root.move-file(root.workspace-parent-path); }
                }

                if root.workspace-entries.length > 0 : ScrollView {
                    height: min(200px, max(52px, root.workspace-entries.length * 52px));
                    vertical-scrollbar-policy: as-needed;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 0px;
                        for entry in root.workspace-entries : SheetAction {
                            visible: entry.dir && entry.path != root.file-pending.path;
                            icon: @image-url("../../../crates/wunder-desktop/frontend/assets/icons/folder-open.svg");
                            label: entry.name;
                            clicked => { root.move-file(entry.path); }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border; }

                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius-sm;
                    background: move-cancel-touch.has-hover ? Theme.hover : transparent;
                    move-cancel-touch := TouchArea {
                        clicked => { root.file-move-open = false; }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "取消";
                        color: Theme.text-secondary;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ---- file rename dialog -----------------------------------------
    if root.file-rename-open : Rectangle {
        width: 100%;
        height: parent.height - root.ime-height;
        background: Theme.overlay;
        TouchArea {
            clicked => {
                root.file-rename-open = false;
                root.keyboard-dismiss();
            }
        }

        Rectangle {
            x: 16px;
            y: max(root.inset-top + 80px, (parent.height - self.height) / 2);
            width: parent.width - 32px;
            height: 184px;
            border-radius: Theme.radius-lg;
            background: Theme.surface;
            drop-shadow-color: #00000033;
            drop-shadow-blur: 24px;
            TouchArea { }

            VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 10px;
                Text {
                    height: 24px;
                    text: "重命名文件";
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                FormField {
                    label: "文件名称";
                    placeholder: "输入新的名称";
                    auto-focus: true;
                    commit-on-blur: false;
                    text <=> root.file-rename-name;
                    committed => { root.commit-file-rename(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    height: 36px;
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Action {
                        width: 76px;
                        label: I18n.common_cancel;
                        show-label: true;
                        clicked => {
                            root.file-rename-open = false;
                            root.keyboard-dismiss();
                        }
                    }
                    Action {
                        width: 84px;
                        label: I18n.common_save;
                        show-label: true;
                        primary: true;
                        enabled: root.file-rename-name != "";
                        clicked => { root.commit-file-rename(); }
                    }
                }
            }
        }
    }

    if root.file-delete-open : ConfirmDialog {
        width: 100%;
        height: parent.height - root.ime-height;
        title: "删除文件";
        message: "删除后无法恢复，文件夹会连同其中内容一起删除。";
        confirm-label: I18n.common_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.confirm-file-delete(); }
        canceled => { root.file-delete-open = false; }
    }

    // ---- trajectory page --------------------------------------------
    if root.trajectory-open : TrajectoryPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height - root.ime-height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        title: "线程轨迹";
        session-title: root.trajectory-title != "" ? root.trajectory-title : root.trajectory-session-title;
        loading: root.trajectory-loading;
        error: root.trajectory-error;
        items: root.trajectory-items;
        audit: root.trajectory-audit;
        segments: root.trajectory-segments;
        bars: root.trajectory-bars;
        filter <=> root.trajectory-filter;
        filter-changed(filter) => { root.trajectory-filter-changed(filter); }
        expanded <=> root.trajectory-expanded;
        back() => { root.trajectory-open = false; }
        retry() => {
            root.load-trajectory(root.trajectory-session-id, root.trajectory-session-title);
        }
    }

    // ---- 首次运行环境部署引导 ---------------------------------------
    // 放在所有页面之上、toast 之下：安装期间整屏不可操作，完成/失败提示仍可见。
    if root.env-setup-open : EnvSetupPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.height;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        state: root.settings-ubuntu-state;
        progress: root.env-setup-progress;
        phase: root.env-setup-phase;
        stage: root.settings-ubuntu-stage;
        error: root.settings-ubuntu-error;
        retry() => { root.env-setup-retry(); }
        dismiss() => { root.env-setup-dismiss(); }
    }

    // ---- toast -------------------------------------------------------
    // 紧凑强调色胶囊，居中浮在内容上；显隐与停留时长由 Rust 控制
    // （app.rs 的 toast_deadline），这里不接触摸，下层操作照常可用。
    if root.toast != "" : MobileToast {
        x: 0px;
        y: (parent.height - self.height) / 2;
        text: root.toast;
    }
}
