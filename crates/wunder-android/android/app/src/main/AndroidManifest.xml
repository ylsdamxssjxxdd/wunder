<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The engine talks to cloud models, MCP servers and the LAN transport. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A running turn must survive the window and the task list. The runtime
         is a special-use foreground service (AI agent runtime), so it is not
         subject to the dataSync six-hour window; the wake lock is held only
         while a turn is actually executing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The permission manager offers the direct battery-optimization exemption
         dialog so long agent turns are not frozen by the system. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Online updates hand a verified APK to the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice input records a short clip locally and transcribes it through
         the configured ASR model; nothing is kept unless the user sends it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The agent browser is a floating WebView window, mirroring the
         reference phone assistant. The user grants it in system settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Workspaces can point at a user folder on shared storage. All-files
         access is the Android 11+ gate for direct paths; the legacy READ/WRITE
         pair covers Android 8-10. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Phone control launches user apps by label; Android 11+ hides the
         launcher catalogue from apps without this visibility query. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- @style/WunderTheme only owns the window/splash before the native
         surface exists: it paints the shell's panel tone and (API 31+) draws no
         splash icon, so the launch never flashes the blown-up launcher icon.
         See res/values/themes.xml and res/values-v31/themes.xml. -->
    <application
        android:label="wunder 安卓版"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/WunderTheme">

        <!-- android-activity's native-activity feature owns the window. The
             thin WunderActivity subclass only forwards file-picker results. -->
        <activity
            android:name=".WunderActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustNothing">
            <meta-data
                android:name="android.app.lib_name"
                android:value="wunder_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Read-only view of every workspace for other apps' document pickers. -->
        <provider
            android:name=".WunderDocumentsProvider"
            android:authorities="${applicationId}.documents.workspace"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Final status of an online-update install session. Explicitly
             addressed by the PendingIntent; never exported. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- The user enables this service explicitly in system accessibility
             settings. Only the system may bind it because of the BIND
             permission; the app itself cannot grant it. -->
        <service
            android:name=".WunderAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The agent runtime outlives the activity. Removing the task while a
             turn runs keeps the service (and the stream) alive; the
             notification is the way back into the app. -->
        <service
            android:name=".WunderRuntimeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_agent_runtime" />
        </service>

        <!-- Android 14 requires this foreground service before MediaProjection
             may create a virtual display. It never records by itself. -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Explicit user grant in system notification-access settings. -->
        <service
            android:name=".WunderNotificationListenerService"
            android:exported="true"
            android:label="wunder 通知读取"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Headless periodic cron wake. Its own process keeps it away from
             the UI engine's thread runtime and monitor cache. -->
        <service
            android:name=".WunderCronJobService"
            android:exported="false"
            android:process=":background"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".WunderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
