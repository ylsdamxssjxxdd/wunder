import { Theme } from "design_tokens.slint";
import { HelpBrowser } from "help_browser.slint";

// 独立帮助窗口：设置页「常规」里的按钮弹出。与主窗口不共享实例，由 Rust
// 侧（src/help_browser.rs）首次打开时创建自己的控制器，并按主窗口当前
// 主题设置同一套 Theme 令牌。
export { Theme }

export component HelpWindow inherits Window {
    title: "帮助";
    width: 1024px;
    height: 700px;
    background: Theme.panel;

    HelpBrowser { polling: root.visible; }
}
