// The context window card: what the thread's last request was made of.
//
// 对齐 magpie 的上下文窗口：标题与计数方式、已用/余量、窗口图（树图或格子）、
// 图例、按部位筛选的内容列表。数据来自引擎在请求发出前记下的提示词构成，
// 这里只负责呈现，不在前端推算 token。
import { Theme } from "design_tokens.slint";
import { I18n } from "i18n.slint";
import { ModalDialog } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One row of the legend / contents list. `slot` is the part's fixed palette
// index (1-based, matching ContextWindowSnapshot::PART_KINDS order).
export struct ContextPartRow {
    slot: int,
    tokens: int,
    tokens-text: string,
}

// One item of one part: a tool definition, a turn, a tool's gathered results
// or a set of images.
export struct ContextItemRow {
    slot: int,
    // Stable kind for the wording: prompt / reminder / tool / result / turn /
    // image. Tool and result rows carry their own raw name.
    tag: string,
    name: string,
    count: int,
    tokens-text: string,
    // Share of the largest row, for the small bar.
    ratio: float,
    // Index among the part's items: the map and grid light the size-sorted
    // rank; the part detail uses its listed rank to know which row is open.
    item: int,
}

// A tile of the window map, in fractions of the map box.
export struct ContextTile {
    x: float,
    y: float,
    w: float,
    h: float,
    slot: int,
    // part / item / more / free
    kind: string,
    tag: string,
    name: string,
    count: int,
    tokens-text: string,
    // Index among the part's items; -1 for a part's tile, -2 for gathered
    // small ones, -3 for free space.
    item: int,
    show-name: bool,
    show-value: bool,
}

// One cell of the block grid: the part it shows and, when the cell is small
// enough to stand for a single item, that item's index in the part.
export struct ContextCell {
    slot: int,
    item: int,
}

// One row of a tile's or a cell's hover card.
export struct ContextTipRow {
    tag: string,
    name: string,
    count: int,
    value: string,
    on: bool,
}

// The palette is magpie's part palette, so the same part reads as the same
// colour across both products.
export global ContextColors {
    public pure function ink(slot: int) -> color {
        return slot == 1 ? #8B5CF6
            : slot == 2 ? #0EA5E9
            : slot == 3 ? #10B981
            : slot == 4 ? #EA580C
            : slot == 5 ? #4F46E5
            : #A8AFB8;
    }
    public pure function fill(slot: int) -> color {
        return slot == 1 ? #F2EDFE
            : slot == 2 ? #E5F5FD
            : slot == 3 ? #E5F7F1
            : slot == 4 ? #FDEDE4
            : slot == 5 ? #ECEBFC
            : #F4F5F7;
    }
    public pure function line(slot: int) -> color {
        return slot == 1 ? #E3D8FD
            : slot == 2 ? #C5E9FA
            : slot == 3 ? #C5E8D7
            : slot == 4 ? #F6D7C5
            : slot == 5 ? #D5D3F9
            : #E2E5E9;
    }
    // 方块上的两级文字：部位色向正文色/次要色各调一次，和参考实现一致。
    public pure function name(slot: int) -> color {
        return slot == 1 ? #6D4CBD
            : slot == 2 ? #1381B3
            : slot == 3 ? #148F68
            : slot == 4 ? #B14914
            : slot == 5 ? #423CB0
            : #6B7280;
    }
    public pure function value(slot: int) -> color {
        return slot == 1 ? #8A7AC0
            : slot == 2 ? #5699BB
            : slot == 3 ? #57A18F
            : slot == 4 ? #B2795E
            : slot == 5 ? #7171B9
            : #9AA0A8;
    }
    // 悬浮时同色加深一档，和参考实现的 19% / 48% 混色对应。
    public pure function hover_fill(slot: int) -> color {
        return slot == 1 ? #E9E0FD
            : slot == 2 ? #D1EEFB
            : slot == 3 ? #D2F2E7
            : slot == 4 ? #FBDDCC
            : slot == 5 ? #DEDCFA
            : #EEF0F3;
    }
    public pure function hover_line(slot: int) -> color {
        return slot == 1 ? #BBA6F6
            : slot == 2 ? #82D0F4
            : slot == 3 ? #67C9A6
            : slot == 4 ? #F2A275
            : slot == 5 ? #918CF1
            : #D7DBE0;
    }
}

// Names shared by the legend, the tiles, the tabs and the rows.
export global ContextText {
    public pure function part(slot: int) -> string {
        return slot == 1 ? I18n.cx_part_system
            : slot == 2 ? I18n.cx_part_tools
            : slot == 3 ? I18n.cx_part_files
            : slot == 4 ? I18n.cx_part_results
            : slot == 5 ? I18n.cx_part_chat
            : I18n.cx_free;
    }
    public pure function item(tag: string, name: string, count: int) -> string {
        // 工具定义与工具结果同名，各补一个部位后缀，免得把「定义」当成
        // 本次请求真的调用过这个工具。
        return tag == "tool" && name != "" ? name + " · " + I18n.cx_item_tool
            : tag == "result" && name != "" ? name + " · " + I18n.cx_part_results
            : tag == "turn" ? I18n.cx_turn(count)
            : name != "" ? name
            : tag == "prompt" ? I18n.cx_item_prompt
            : tag == "reminder" ? I18n.cx_item_reminder
            : tag == "image" ? I18n.cx_image(count)
            : I18n.cx_item_other;
    }
}

export component ContextWindowPanel inherits Rectangle {
    in property <[ContextPartRow]> parts: [];
    in property <[ContextItemRow]> items: [];
    in property <[ContextTile]> tiles: [];
    // 400 cells: the part each cell shows and the item inside it.
    in property <[ContextCell]> cells: [];
    in property <int> used-tokens: 0;
    in property <int> capacity-tokens: 0;
    in property <string> used-text: "0";
    in property <string> capacity-text: "0";
    in property <string> free-text: "0";
    in property <bool> measured: false;
    in property <bool> has-data: false;
    in property <string> model-label: "";
    // 0 = 全部, otherwise the selected part's slot.
    in property <int> tab: 0;
    in property <bool> look-map: true;
    // Hover card of a tile or a cell; the strings are raw keys the panel words.
    in property <bool> tip-open: false;
    in property <string> tip-kind: "";
    in property <int> tip-slot: 0;
    in property <string> tip-tag: "";
    in property <string> tip-name: "";
    in property <int> tip-count: 0;
    in property <string> tip-value: "";
    in property <string> tip-pct: "";
    in property <[ContextTipRow]> tip-rows: [];
    in property <int> tip-more: 0;
    // The contents opened from a tile, a cell or a row.
    in property <bool> detail-open: false;
    in property <string> detail-kind: "";
    in property <int> detail-slot: 0;
    in property <string> detail-tag: "";
    in property <string> detail-name: "";
    in property <int> detail-count: 0;
    in property <string> detail-value: "";
    in property <string> detail-pct: "";
    in property <[ContextItemRow]> detail-rows: [];
    // The item's own text, kept whole in process memory and shown in full.
    in property <string> detail-text: "";
    // A part's rows open one at a time; this is the row index and the text
    // loaded for it. Empty text means the process no longer holds it.
    in property <int> detail-row-open: -1;
    in property <string> detail-row-text: "";
    callback dismissed();
    callback set-tab(int);
    callback toggle-look();
    callback tile-hover(int);
    callback tile-leave();
    callback tile-open(int);
    callback cell-hover(int);
    callback cell-leave();
    callback cell-open(int);
    callback row-open(int, string, string, int);
    callback legend-open(int);
    callback map-resized(length, length);
    callback detail-row-toggle(int, int, string, string, int);
    callback detail-dismissed();

    width: 100%; height: 100%;
    private property <float> fill: root.capacity-tokens > 0
        ? min(1.0, max(0.0, root.used-tokens * 1.0 / (root.capacity-tokens * 1.0)))
        : 0.0;
    private property <int> tone: root.fill >= 0.9 ? 2 : root.fill >= 0.75 ? 1 : 0;
    // 卡片实际宽度：参考实现按卡片宽度切 520 / 420 两档，而不是窗口。
    private property <length> card-w: min(920px, root.width - 24px);
    // 50 columns on a wide card, 25 on a narrow one; 400 cells cover both.
    private property <int> columns: root.card-w < 520px ? 25 : 50;
    private property <int> cell-rows: root.columns == 50 ? 8 : 16;
    // 卡片高度：最多 720px，也不超出窗口可用高度。
    private property <length> card-height: min(720px, root.height - 24px);
    // 悬停时其余方块变暗，指向的那一块（同部位的格子）保持原色。
    private property <int> focus-slot: 0;
    private property <int> focus-item: -1;
    // 悬浮的是地图上的哪一块：参考实现只点亮当前这一块，不点亮同部位
    // 的其它块。
    private property <int> hovered-tile: -1;
    // 提示卡指向的方块矩形，换成图坐标系里的位置。
    in-out property <length> tip-x: 0px;
    in-out property <length> tip-y: 0px;
    in-out property <length> tip-w: 0px;
    in-out property <length> tip-h: 0px;
    private property <bool> pointer-on-map: false;
    private property <int> hovered-cell: 0;
    private property <string> tip-title: root.tip-kind == "free" ? I18n.cx_free
        : root.tip-kind == "part" ? ContextText.part(root.tip-slot)
        : ContextText.item(root.tip-tag, root.tip-name, root.tip-count);
    // The detail dialog's text column: its card minus the modal padding and a
    // gutter for the overlay scrollbar.
    private property <length> detail-text-width: min(560px, root.width - 24px) - Theme.space-5 * 2 - 12px;

    ModalDialog {
        card-width: root.card-w;
        card-height: root.card-height;
        dismissed => { root.dismissed(); }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            // ---- head: what this is, which model, how it was counted ----
            HorizontalLayout {
                height: 24px;
                spacing: 6px;
                Text {
                    text: I18n.cx_title;
                    color: Theme.text; font-size: Theme.font-md; font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Image {
                    width: 14px; height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../assets/icons/cubes.svg");
                    colorize: Theme.muted;
                    image-fit: contain;
                }
                if root.card-w >= 480px : Text {
                    // 请求打到哪个模型：provider › model
                    width: min(self.preferred-width, max(0px, root.card-w - 430px));
                    text: root.model-label;
                    color: Theme.text-secondary; font-size: Theme.font-xs;
                    vertical-alignment: center; overflow: elide;
                }
                if root.card-w >= 340px : Rectangle {
                    height: 17px;
                    width: state-text.preferred-width + 16px;
                    border-radius: 9px;
                    background: Theme.panel;
                    state-text := Text {
                        x: 8px; width: self.preferred-width;
                        text: root.measured ? I18n.cx_measured : I18n.cx_estimate;
                        color: Theme.muted; font-size: Theme.font-2xs; font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                // 视图切换放在标题行：窄卡时图例可能挤满一行，放在图例末尾会
                // 被推出卡片边缘。
                Rectangle {
                    width: 56px; height: 24px;
                    border-radius: 7px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 2px; padding-right: 2px;
                        padding-top: 3px; padding-bottom: 3px;
                        spacing: 2px;
                        Rectangle {
                            width: 24px; height: 16px; border-radius: 5px;
                            background: root.look-map ? Theme.surface : transparent;
                            border-width: root.look-map ? 1px : 0px; border-color: Theme.border;
                            Rectangle { x: 5px; y: 3px; width: 4px; height: 10px; border-radius: 1px; background: root.look-map ? Theme.text : Theme.muted; }
                            Rectangle { x: 10px; y: 6px; width: 9px; height: 7px; border-radius: 1px; background: root.look-map ? Theme.text : Theme.muted; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.toggle-look(); } }
                        }
                        Rectangle {
                            width: 24px; height: 16px; border-radius: 5px;
                            background: root.look-map ? transparent : Theme.surface;
                            border-width: root.look-map ? 0px : 1px; border-color: Theme.border;
                            Rectangle { x: 4px; y: 4px; width: 6px; height: 6px; border-radius: 1px; background: root.look-map ? Theme.muted : Theme.text; }
                            Rectangle { x: 13px; y: 4px; width: 6px; height: 6px; border-radius: 1px; background: root.look-map ? Theme.muted : Theme.text; }
                            Rectangle { x: 4px; y: 12px; width: 6px; height: 6px; border-radius: 1px; background: root.look-map ? Theme.muted : Theme.text; }
                            Rectangle { x: 13px; y: 12px; width: 6px; height: 6px; border-radius: 1px; background: root.look-map ? Theme.muted : Theme.text; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.toggle-look(); } }
                        }
                    }
                }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 6px;
                    background: card-close-hit.has-hover ? Theme.hover : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/xmark.svg");
                        colorize: Theme.muted; image-fit: contain;
                    }
                    card-close-hit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismissed(); }
                    }
                }
            }

            // ---- occupancy: the number, its health, what is left ----
            if root.has-data : VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;
                    // 不加 alignment 时 HorizontalLayout 会把余量均摊给可拉伸的
                    // 子元素，药丸会被推到卡片最右边。
                    alignment: start;
                    Text {
                        text: I18n.cx_used;
                        color: Theme.text-secondary; font-size: Theme.font-xs; font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 17px;
                        width: health-text.preferred-width + 16px;
                        border-radius: 9px;
                        background: root.tone == 0 ? #E7F7EE : root.tone == 1 ? #FEF3C7 : #FEE2E2;
                        health-text := Text {
                            x: 8px; width: self.preferred-width;
                            text: root.tone == 0 ? I18n.cx_health_ok : root.tone == 1 ? I18n.cx_health_warn : I18n.cx_health_bad;
                            color: root.tone == 0 ? #15803D : root.tone == 1 ? #B45309 : #B91C1C;
                            font-size: Theme.font-2xs; font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    height: 34px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: root.used-text;
                        color: Theme.text; font-size: 26px; font-weight: 600;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: "/ " + root.capacity-text + " token";
                        color: Theme.muted; font-size: Theme.font-sm;
                        vertical-alignment: bottom;
                    }
                }
                Text {
                    height: 16px;
                    text: I18n.cx_summary(round(root.fill * 100.0) + "%", root.free-text);
                    color: Theme.muted; font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }

            chart := Rectangle {
                // 参考实现的比例：宽卡 3.1:1，窄卡 2:1，高 132–232px 之间；
                // 卡片本身不高时再让出空间给图例、页签与内容列表，避免被裁掉。
                // 格子视图不占满这张地图：400 格按列宽决定格边，高度随行数
                // 收缩，和参考实现里 waffle 的自然高度一致。
                height: root.look-map
                    ? clamp(
                        min(parent.width / (parent.width <= 520px ? 2.0 : 3.1), root.card-height - 300px),
                        96px,
                        232px)
                    : root.cell-rows * ((self.width - (root.columns - 1) * 2px) / root.columns)
                        + (root.cell-rows - 1) * 2px;
                background: transparent;
                // 树图按地图的实际宽高重新排；窗口或卡片尺寸变了就重排一次。
                init => { root.map-resized(self.width, self.height); }
                changed width => { root.map-resized(self.width, self.height); }
                changed height => { root.map-resized(self.width, self.height); }

                if root.has-data && root.look-map : Rectangle {
                    // 树图：部位一块、其内条目再切一块，空余空间斜纹
                    for tile[i] in root.tiles : Rectangle {
                        x: tile.x * chart.width + 1.5px;
                        y: tile.y * chart.height + 1.5px;
                        width: max(0px, tile.w * chart.width - 3px);
                        height: max(0px, tile.h * chart.height - 3px);
                        border-radius: 7px;
                        background: tile.kind == "free"
                            ? #FAFBFC
                            : tile-hit.has-hover ? ContextColors.hover_fill(tile.slot) : ContextColors.fill(tile.slot);
                        border-width: 1px;
                        border-color: tile.kind == "free"
                            ? #E6E8EB
                            : tile-hit.has-hover ? ContextColors.hover_line(tile.slot) : ContextColors.line(tile.slot);
                        opacity: root.hovered-tile >= 0 ? (root.hovered-tile == i ? 1.0 : 0.32)
                            : root.focus-slot == 0 ? 1.0
                            : tile.kind == "free" ? (root.focus-slot == -1 ? 1.0 : 0.32)
                            : tile.slot == root.focus-slot ? (root.focus-item < 0 || tile.kind == "part" || tile.item == root.focus-item ? 1.0 : 0.32)
                            : 0.32;
                        if tile.kind == "free" : Image {
                            width: parent.width; height: parent.height;
                            source: @image-url("../assets/context-hatch.svg");
                            image-fit: ImageFit.fill;
                        }
                        // 参考实现的留白：普通 7px 9px，矮块 5px 9px，太小的块
                        // 不写字也不留白（否则文字会被方块边缘切掉）。
                        if tile.show-name : VerticalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            padding-top: tile.show-value ? 7px : 5px;
                            padding-bottom: tile.show-value ? 7px : 5px;
                            alignment: start;
                            spacing: 1px;
                            Text {
                                text: tile.kind == "part" ? ContextText.part(tile.slot)
                                    : tile.kind == "item" ? ContextText.item(tile.tag, tile.name, tile.count)
                                    : tile.kind == "more" ? I18n.cx_more_items(tile.count)
                                    : I18n.cx_free;
                                color: tile.kind == "free" ? Theme.muted : ContextColors.name(tile.slot);
                                font-size: Theme.font-xs; font-weight: 600;
                                wrap: no-wrap; overflow: elide;
                            }
                            if tile.show-value : Text {
                                // 参考实现的副行：条目报「值 · 部位」，部位只报值。
                                text: tile.kind == "item" || tile.kind == "more"
                                    ? tile.tokens-text + " · " + ContextText.part(tile.slot)
                                    : tile.kind == "free"
                                        ? tile.tokens-text + " · " + Math.round(root.fill * 100.0) + "%"
                                        : tile.tokens-text;
                                color: ContextColors.value(tile.slot);
                                font-size: Theme.font-2xs;
                                wrap: no-wrap; overflow: elide;
                            }
                        }
                        tile-hit := TouchArea {
                            mouse-cursor: tile.kind == "free" ? default : pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = i;
                                    root.focus-slot = tile.kind == "free" ? -1 : tile.slot;
                                    root.focus-item = tile.kind == "item" ? tile.item : -1;
                                    root.pointer-on-map = true;
                                    root.tip-x = tile.x * chart.width;
                                    root.tip-y = tile.y * chart.height;
                                    root.tip-w = tile.w * chart.width;
                                    root.tip-h = tile.h * chart.height;
                                    root.tile-hover(i);
                                } else if (root.pointer-on-map && root.hovered-tile == i) {
                                    root.pointer-on-map = false;
                                    root.hovered-tile = -1;
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                    root.tile-leave();
                                }
                            }
                            clicked => { if (tile.kind != "free") { root.tile-open(i); } }
                        }
                    }
                }

                if root.has-data && !root.look-map : grid := Rectangle {
                    // 格子：窗口切成 400 份，每格 0.25%，按部位着色。格子的
                    // 边长同时受宽高约束，窄卡也不会溢出地图。
                    width: parent.width;
                    height: parent.height;
                    property <length> side: min(
                        (self.width - (root.columns - 1) * 2px) / root.columns,
                        (self.height - (root.cell-rows - 1) * 2px) / root.cell-rows);
                    property <length> pad-x: (self.width - (root.columns * self.side + (root.columns - 1) * 2px)) / 2;
                    property <length> pad-y: (self.height - (root.cell-rows * self.side + (root.cell-rows - 1) * 2px)) / 2;
                    for cell[i] in root.cells : Rectangle {
                        x: grid.pad-x + Math.mod(i, root.columns) * (grid.side + 2px);
                        y: grid.pad-y + Math.floor(i / root.columns) * (grid.side + 2px);
                        width: grid.side;
                        height: grid.side;
                        border-radius: 2px;
                        background: cell.slot == 0 ? #EFF1F4 : ContextColors.ink(cell.slot);
                        opacity: root.focus-slot == 0 ? 1.0
                            : cell.slot == 0 ? (root.focus-slot == -1 ? 1.0 : 0.16)
                            : cell.slot == root.focus-slot ? (root.focus-item < 0 || cell.item == root.focus-item ? 1.0 : 0.16)
                            : 0.16;
                    }
                    grid-hit := TouchArea {
                        mouse-cursor: pointer;
                        moved => {
                            root.hovered-cell = Math.max(0, Math.min(399,
                                Math.floor((self.mouse-y - grid.pad-y) / (grid.side + 2px)) * root.columns
                                + Math.floor((self.mouse-x - grid.pad-x) / (grid.side + 2px))));
                            root.pointer-on-map = true;
                            root.hovered-tile = -1;
                            root.focus-slot = root.cells[root.hovered-cell].slot == 0
                                ? -1
                                : root.cells[root.hovered-cell].slot;
                            root.focus-item = -1;
                            root.tip-x = grid.pad-x + Math.mod(root.hovered-cell, root.columns) * (grid.side + 2px);
                            root.tip-y = grid.pad-y + Math.floor(root.hovered-cell / root.columns) * (grid.side + 2px);
                            root.tip-w = grid.side;
                            root.tip-h = grid.side;
                            root.cell-hover(root.hovered-cell);
                        }
                        changed has-hover => {
                            if (!self.has-hover && root.pointer-on-map) {
                                root.pointer-on-map = false;
                                root.focus-slot = 0;
                                root.focus-item = -1;
                                root.cell-leave();
                            }
                        }
                        clicked => {
                            // 点击不一定先经过 moved（触控尤其如此）；按点击位置
                            // 重新算格子，否则会一直落到默认的第 0 格（系统提示）。
                            let at = Math.max(0, Math.min(399,
                                Math.floor((self.mouse-y - grid.pad-y) / (grid.side + 2px)) * root.columns
                                + Math.floor((self.mouse-x - grid.pad-x) / (grid.side + 2px))));
                            root.hovered-cell = at;
                            root.cell-open(at);
                        }
                    }
                }

                if !root.has-data : Text {
                    width: parent.width; height: parent.height;
                    text: I18n.cx_no_request;
                    color: Theme.muted; font-size: Theme.font-sm;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }

                // 参考实现的深色提示卡：指向哪一块，就报它是什么、占多少，
                // 部位块再列出最大的几项。它盖在地图上方，不接收鼠标。
                if root.tip-open : Rectangle {
                    width: 240px;
                    height: 16px + 18px
                        + (root.tip-kind == "item" ? 16px : 0px)
                        + root.tip-rows.length * 15px
                        + (root.tip-more > 0 ? 14px : 0px)
                        + (root.tip-rows.length + (root.tip-kind == "item" ? 1 : 0) + (root.tip-more > 0 ? 1 : 0)) * 2px;
                    x: clamp(root.tip-x + root.tip-w / 2 - self.width / 2, 4px, chart.width - self.width - 4px);
                    // 参考实现把提示卡放在整张卡片里量位置：地图上方放不下时
                    // 可以盖住标题区，而不是被迫翻到方块下面。
                    y: root.tip-y - self.height - 8px >= 4px - chart.y
                        ? root.tip-y - self.height - 8px
                        : root.tip-y + root.tip-h + 8px;
                    border-radius: 9px;
                    background: #17171B;
                    drop-shadow-color: #00000047;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 10px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            height: 18px;
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: root.tip-kind == "free" ? #8B8B92 : ContextColors.ink(root.tip-slot);
                            }
                            Text {
                                text: root.tip-title;
                                color: #FFFFFF; font-size: Theme.font-xs; font-weight: 600;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.tip-kind != "item" : Text {
                                text: root.tip-kind == "part"
                                    ? root.tip-value + " · " + root.tip-pct
                                    : root.tip-value;
                                color: #A1A1AA; font-size: Theme.font-2xs;
                                vertical-alignment: center;
                            }
                        }
                        if root.tip-kind == "item" : Text {
                            height: 16px;
                            text: ContextText.part(root.tip-slot) + " · " + root.tip-value + " token · " + root.tip-pct;
                            color: #A1A1AA; font-size: Theme.font-2xs;
                            vertical-alignment: center; overflow: elide;
                        }
                        for row in root.tip-rows : HorizontalLayout {
                            height: 15px;
                            spacing: 10px;
                            Text {
                                text: ContextText.item(row.tag, row.name, row.count);
                                color: row.on ? #FFFFFF : #B9B9C1;
                                font-size: Theme.font-2xs;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                color: row.on ? #FFFFFF : #B9B9C1;
                                font-size: Theme.font-2xs; font-weight: row.on ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                        if root.tip-more > 0 : Text {
                            height: 14px;
                            text: I18n.cx_more_items(root.tip-more);
                            color: #85858D; font-size: Theme.font-2xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.parts.length > 0 : HorizontalLayout {
                height: 20px;
                spacing: 14px;
                // 图例只放部位，视图切换已移到卡片标题行；这里不抢右侧空间。
                alignment: start;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    for part in root.parts : Rectangle {
                        height: 20px;
                        width: legend-row.preferred-width;
                        border-radius: 5px;
                        background: legend-hit.has-hover ? Theme.hover : transparent;
                        legend-row := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: ContextColors.ink(part.slot);
                            }
                            Text {
                                text: ContextText.part(part.slot);
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            // 窄卡放不下「部位 + 值」，只留部位名；不占布局。
                            if root.card-w >= 640px : Text {
                                text: part.tokens-text;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        legend-hit := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = -1;
                                    root.focus-slot = part.slot;
                                    root.focus-item = -1;
                                } else {
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                }
                            }
                            clicked => { root.legend-open(part.slot); }
                        }
                    }
                    // 余量也是窗口的一部分，参考实现的图例把它挂在最后。
                    if root.capacity-tokens > root.used-tokens : Rectangle {
                        height: 20px;
                        width: free-legend.preferred-width;
                        border-radius: 5px;
                        background: free-hit.has-hover ? Theme.hover : transparent;
                        free-legend := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: #C9CDD3;
                            }
                            Text {
                                text: I18n.cx_free;
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            if root.card-w >= 640px : Text {
                                text: root.free-text;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        free-hit := TouchArea {
                            mouse-cursor: default;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = -1;
                                    root.focus-slot = -1;
                                    root.focus-item = -1;
                                } else {
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                }
                            }
                        }
                    }
                }
            }

            if root.has-data : Rectangle {
                height: 1px; background: Theme.border;
            }

            if root.has-data : HorizontalLayout {
                height: 26px;
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: I18n.cx_contents;
                    color: Theme.text; font-size: Theme.font-sm; font-weight: 600;
                    vertical-alignment: center;
                }
                // 分段页签：全部 + 各部位，灰底一条、选中一颗白底，和参考实现一致。
                Rectangle {
                    height: 24px;
                    width: tabs-row.preferred-width + 4px;
                    border-radius: 12px;
                    background: Theme.panel;
                    tabs-row := HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        alignment: start;
                        Rectangle {
                            height: 20px; border-radius: 10px;
                            width: all-label.preferred-width + 16px;
                            background: root.tab == 0 ? Theme.surface : (all-hit.has-hover ? Theme.hover : transparent);
                            border-width: root.tab == 0 ? 1px : 0px;
                            border-color: Theme.border;
                            all-label := Text {
                                x: 8px; width: self.preferred-width;
                                text: I18n.cx_all;
                                color: root.tab == 0 ? Theme.text : Theme.muted;
                                font-size: Theme.font-xs; font-weight: 600;
                                vertical-alignment: center;
                            }
                            all-hit := TouchArea { mouse-cursor: pointer; clicked => { root.set-tab(0); } }
                        }
                        for part in root.parts : Rectangle {
                            height: 20px; border-radius: 10px;
                            width: tab-label.preferred-width + 16px;
                            background: root.tab == part.slot ? Theme.surface : (tab-hit.has-hover ? Theme.hover : transparent);
                            border-width: root.tab == part.slot ? 1px : 0px;
                            border-color: Theme.border;
                            tab-label := Text {
                                x: 8px; width: self.preferred-width;
                                text: ContextText.part(part.slot);
                                color: root.tab == part.slot ? Theme.text : Theme.muted;
                                font-size: Theme.font-xs; font-weight: 600;
                                vertical-alignment: center;
                            }
                            tab-hit := TouchArea { mouse-cursor: pointer; clicked => { root.set-tab(part.slot); } }
                        }
                    }
                }
            }

            if root.has-data : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 0px;
                    alignment: start;
                    // 给覆盖式滚动条留出右侧一条空隙，别让它压住 token 数字。
                    padding-right: 12px;
                    if root.items.length == 0 : Text {
                        height: 32px;
                        text: I18n.cx_nothing;
                        color: Theme.muted; font-size: Theme.font-sm;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    for item in root.items : Rectangle {
                        height: 28px;
                        width: 100%;
                        border-radius: 6px;
                        background: item-hit.has-hover ? Theme.hover : transparent;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            x: 6px; y: (parent.height - self.height) / 2;
                            background: ContextColors.ink(item.slot);
                        }
                        Text {
                            x: 18px; y: 0px;
                            width: root.card-w < 420px ? parent.width - 82px : parent.width - 190px;
                            height: parent.height;
                            text: ContextText.item(item.tag, item.name, item.count);
                            color: Theme.text; font-size: Theme.font-sm; font-weight: 500;
                            vertical-alignment: center; overflow: elide;
                        }
                        // 只有可数的条目（工具、结果）标份数；轮次与图片的计数
                        // 已经在文案里（「第 3 轮」「图片 ×4」）。
                        if item.count > 1 && (item.tag == "tool" || item.tag == "result") : Text {
                            x: parent.width - 178px; y: 0px; height: parent.height;
                            text: "×" + item.count;
                            color: Theme.muted; font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                        // 窄卡放不下迷你条：名称让出位置，值和名称仍在。
                        if root.card-w >= 420px : Rectangle {
                            x: parent.width - 150px; y: (parent.height - 4px) / 2;
                            width: 72px; height: 4px; border-radius: 2px;
                            background: #ECEFF2;
                            Rectangle {
                                x: 0px; y: 0px;
                                width: max(2px, parent.width * item.ratio);
                                height: parent.height; border-radius: 2px;
                                background: ContextColors.ink(item.slot);
                            }
                        }
                        Text {
                            x: parent.width - 72px; y: 0px; width: 72px; height: parent.height;
                            text: item.tokens-text;
                            color: Theme.text-secondary; font-size: Theme.font-xs;
                            vertical-alignment: center; horizontal-alignment: right;
                        }
                        item-hit := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = -1;
                                    root.focus-slot = item.slot;
                                    root.focus-item = item.item;
                                } else {
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                }
                            }
                            clicked => { root.row-open(item.slot, item.tag, item.name, item.count); }
                        }
                    }
                }
            }
        }
    }

    // 从方块、格子或内容行打开的内容。单个条目只显示该条目的正文；一个
    // 部位则列出该部位的条目，点一行就在行下展开它的正文。
    if root.detail-open : ModalDialog {
        card-width: min(560px, root.width - 24px);
        // A part tall enough for its rows (then scrolls); one item tight when
        // its text has left memory, tall when the text is there.
        card-height: min(root.height - 40px,
            root.detail-kind == "part"
                ? min(520px, max(260px, 150px + root.detail-rows.length * 34px))
                : root.detail-text != ""
                    ? 520px
                    : 220px);
        dismissed => { root.detail-dismissed(); }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: ContextColors.ink(root.detail-slot);
                }
                Text {
                    width: min(self.preferred-width, parent.width - 80px);
                    text: root.detail-kind == "part" ? ContextText.part(root.detail-slot)
                        : ContextText.item(root.detail-tag, root.detail-name, root.detail-count);
                    color: Theme.text; font-size: Theme.font-md; font-weight: 700;
                    vertical-alignment: center; overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 6px;
                    background: close-hit.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "×";
                        color: Theme.muted; font-size: 16px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    close-hit := TouchArea { mouse-cursor: pointer; clicked => { root.detail-dismissed(); } }
                }
            }
            Text {
                height: 18px;
                text: root.detail-kind == "part"
                    ? root.detail-value + " token · " + root.detail-pct
                    : ContextText.part(root.detail-slot) + " · " + root.detail-value + " token · " + root.detail-pct;
                color: Theme.muted; font-size: Theme.font-xs;
                vertical-alignment: center; overflow: elide;
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.detail-text != "" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: root.detail-text-width;
                        border-radius: 6px;
                        background: #F6F7F9;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            Text {
                                width: 100%;
                                text: root.detail-text;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // 单个条目：只展示它自己的正文，不再把整个部位的条目铺在下面。
            // 正文已随进程退出释放时，也只说明这一件事。
            if root.detail-kind == "item" && root.detail-text == "" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        width: root.detail-text-width;
                        text: I18n.cx_text_released;
                        color: Theme.muted; font-size: Theme.font-xs;
                        wrap: word-wrap;
                    }
                }
            }
            // 部位：列出条目；点一行展开它的正文/schema，再点收起。
            if root.detail-kind == "part" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    for row in root.detail-rows : VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 30px;
                            width: 100%;
                            border-radius: 6px;
                            background: row-hit.has-hover || root.detail-row-open == row.item ? Theme.hover : transparent;
                            Image {
                                x: 7px; y: (parent.height - self.height) / 2;
                                width: 9px; height: 9px;
                                source: root.detail-row-open == row.item
                                    ? @image-url("../assets/icons/chevron-down.svg")
                                    : @image-url("../assets/icons/chevron-right.svg");
                                colorize: Theme.muted; image-fit: contain;
                            }
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                x: 22px; y: (parent.height - self.height) / 2;
                                background: ContextColors.ink(row.slot);
                            }
                            Text {
                                x: 34px; y: 0px;
                                width: parent.width - 210px; height: parent.height;
                                text: ContextText.item(row.tag, row.name, row.count);
                                color: Theme.text; font-size: Theme.font-sm; font-weight: 500;
                                vertical-alignment: center; overflow: elide;
                            }
                            if row.count > 1 && (row.tag == "tool" || row.tag == "result") : Text {
                                x: parent.width - 178px; y: 0px; height: parent.height;
                                text: "×" + row.count;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                x: parent.width - 150px; y: (parent.height - 4px) / 2;
                                width: 72px; height: 4px; border-radius: 2px;
                                background: #ECEFF2;
                                Rectangle {
                                    x: 0px; y: 0px;
                                    width: max(2px, parent.width * row.ratio);
                                    height: parent.height; border-radius: 2px;
                                    background: ContextColors.ink(row.slot);
                                }
                            }
                            Text {
                                x: parent.width - 72px; y: 0px; width: 72px; height: parent.height;
                                text: row.tokens-text;
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center; horizontal-alignment: right;
                            }
                            row-hit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.detail-row-toggle(row.item, row.slot, row.tag, row.name, row.count);
                                }
                            }
                        }
                        if root.detail-row-open == row.item : Rectangle {
                            width: 100%;
                            border-radius: 6px;
                            background: #F6F7F9;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                if root.detail-row-text != "" : Text {
                                    width: 100%;
                                    text: root.detail-row-text;
                                    color: Theme.text;
                                    font-family: Theme.font-mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                                if root.detail-row-text == "" : Text {
                                    width: 100%;
                                    text: I18n.cx_text_released;
                                    color: Theme.muted; font-size: Theme.font-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
