// The context window card: what the thread's last request was made of.
//
// 对齐参考实现：标题与计数方式、已用/余量、树图块面、紧凑图例；点块打开
// 部位/条目详情。数据来自引擎在请求发出前记下的提示词构成，这里只负责
// 呈现，不在前端推算 token。
import { Theme } from "design_tokens.slint";
import { I18n } from "i18n.slint";
import { ContextTile, ContextTileView, ContextColors, ContextText } from "context_tile.slint";
export { ContextTile, ContextColors, ContextText }
import { ModalDialog } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One row of the legend / contents list. `slot` is the part's fixed palette
// index (1-based, matching ContextWindowSnapshot::PART_KINDS order).
export struct ContextPartRow {
    slot: int,
    tokens: int,
    tokens-text: string,
}

// One item of one part: a tool definition, a turn, a tool's gathered results
// or a set of images.
export struct ContextItemRow {
    slot: int,
    // Stable kind for the wording: prompt / reminder / tool / result / turn /
    // image. Tool and result rows carry their own raw name.
    tag: string,
    name: string,
    count: int,
    tokens-text: string,
    // Share of the largest row, for the small bar.
    ratio: float,
    // Index among the part's items: the map and grid light the size-sorted
    // rank; the part detail uses its listed rank to know which row is open.
    item: int,
}

// One row of a tile's hover card.
export struct ContextTipRow {
    tag: string,
    name: string,
    count: int,
    value: string,
    on: bool,
}

export component ContextWindowPanel inherits Rectangle {
    in property <[ContextPartRow]> parts: [];
    in property <[ContextTile]> tiles: [];
    in property <int> used-tokens: 0;
    in property <int> capacity-tokens: 0;
    in property <string> used-text: "0";
    in property <string> capacity-text: "0";
    in property <string> free-text: "0";
    in property <bool> measured: false;
    in property <bool> has-data: false;
    in property <string> model-label: "";
    // 本线程已承载的对话轮次，摘要行一并展示。
    in property <int> turns: 0;
    // Hover card of a tile; the strings are raw keys the panel words.
    in property <bool> tip-open: false;
    in property <string> tip-kind: "";
    in property <int> tip-slot: 0;
    in property <string> tip-tag: "";
    in property <string> tip-name: "";
    in property <int> tip-count: 0;
    in property <string> tip-value: "";
    in property <string> tip-pct: "";
    in property <[ContextTipRow]> tip-rows: [];
    in property <int> tip-more: 0;
    // The contents opened from a tile, a cell or a row.
    in property <bool> detail-open: false;
    in property <string> detail-kind: "";
    in property <int> detail-slot: 0;
    in property <string> detail-tag: "";
    in property <string> detail-name: "";
    in property <int> detail-count: 0;
    in property <string> detail-value: "";
    in property <string> detail-pct: "";
    in property <[ContextItemRow]> detail-rows: [];
    // The item's own text, kept whole in process memory and shown in full.
    in property <string> detail-text: "";
    // A part's rows open one at a time; this is the row index and the text
    // loaded for it. Empty text means the process no longer holds it.
    in property <int> detail-row-open: -1;
    in property <string> detail-row-text: "";
    callback dismissed();
    callback tile-hover(int);
    callback tile-leave();
    callback tile-open(int);
    callback legend-open(int);
    callback map-resized(length, length);
    callback detail-row-toggle(int, int, string, string, int);
    callback detail-dismissed();

    width: 100%; height: 100%;
    private property <float> fill: root.capacity-tokens > 0
        ? min(1.0, max(0.0, root.used-tokens * 1.0 / (root.capacity-tokens * 1.0)))
        : 0.0;
    // 卡片实际宽度：参考实现按卡片宽度切 520 / 420 两档，而不是窗口。
    private property <length> card-w: min(920px, root.width - 24px);
    // 卡片高度：最多 720px，也不超出窗口可用高度。
    private property <length> card-height: min(720px, root.height - 24px);
    // 悬停时其余方块变暗，指向的那一块（同部位的格子）保持原色。
    private property <int> focus-slot: 0;
    private property <int> focus-item: -1;
    // 悬浮的是地图上的哪一块：参考实现只点亮当前这一块，不点亮同部位
    // 的其它块。
    private property <int> hovered-tile: -1;
    // 提示卡指向的方块矩形，换成图坐标系里的位置。
    in-out property <length> tip-x: 0px;
    in-out property <length> tip-y: 0px;
    in-out property <length> tip-w: 0px;
    in-out property <length> tip-h: 0px;
    private property <bool> pointer-on-map: false;
    private property <string> tip-title: root.tip-kind == "free" ? I18n.cx_free
        : root.tip-kind == "part" ? ContextText.part(root.tip-slot)
        : ContextText.item(root.tip-tag, root.tip-name, root.tip-count);
    // The detail dialog's text column: its card minus the modal padding and a
    // gutter for the overlay scrollbar.
    private property <length> detail-text-width: min(560px, root.width - 24px) - Theme.space-5 * 2 - 12px;

    ModalDialog {
        card-width: root.card-w;
        card-height: root.card-height;
        dismissed => { root.dismissed(); }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            // ---- head: what this is, which model, how it was counted ----
            HorizontalLayout {
                height: 24px;
                spacing: 6px;
                Text {
                    text: I18n.cx_title;
                    color: Theme.text; font-size: Theme.font-md; font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Image {
                    width: 14px; height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../assets/icons/cubes.svg");
                    colorize: Theme.muted;
                    image-fit: contain;
                }
                if root.card-w >= 480px : Text {
                    // 请求打到哪个模型：provider › model
                    width: min(self.preferred-width, max(0px, root.card-w - 430px));
                    text: root.model-label;
                    color: Theme.text-secondary; font-size: Theme.font-xs;
                    vertical-alignment: center; overflow: elide;
                }
                if root.card-w >= 340px : Rectangle {
                    height: 17px;
                    width: state-text.preferred-width + 16px;
                    border-radius: 9px;
                    background: Theme.panel;
                    state-text := Text {
                        x: 8px; width: self.preferred-width;
                        text: root.measured ? I18n.cx_measured : I18n.cx_estimate;
                        color: Theme.muted; font-size: Theme.font-2xs; font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 6px;
                    background: card-close-hit.has-hover ? Theme.hover : transparent;
                    Image {
                        x: 6px; y: 6px; width: 12px; height: 12px;
                        source: @image-url("../assets/icons/xmark.svg");
                        colorize: Theme.muted; image-fit: contain;
                    }
                    card-close-hit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismissed(); }
                    }
                }
            }

            // ---- occupancy: the number and what is left ----
            if root.has-data : VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: root.used-text;
                        color: Theme.text; font-size: 26px; font-weight: 600;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: "/ " + root.capacity-text + " token";
                        color: Theme.muted; font-size: Theme.font-sm;
                        vertical-alignment: bottom;
                    }
                }
                Text {
                    height: 16px;
                    text: I18n.cx_summary(
                        round(root.fill * 100.0) + "%", root.free-text, root.turns
                    );
                    color: Theme.muted; font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }

            chart := Rectangle {
                // 地图占满卡片扣除头部/摘要/图例后的剩余空间，块面尽量大；
                // 几何仍由投影按地图实际宽高比例换算，这里不加硬编码尺寸。
                vertical-stretch: 1;
                min-height: 240px;
                background: transparent;
                // 回传投影用的内容盒：VerticalLayout 已扣掉卡片 padding；
                // 再扣掉瓦片两侧 1.5px 内缩（合计 3px），投影按安全区求解，
                // 最后一行块面不会压到地图下边缘。
                property <length> inner-w: max(0px, self.width - 3px);
                property <length> inner-h: max(0px, self.height - 3px);
                // 树图按地图的实际宽高重新排；窗口或卡片尺寸变了就重排一次。
                init => { root.map-resized(self.inner-w, self.inner-h); }
                changed width => { root.map-resized(self.inner-w, self.inner-h); }
                changed height => { root.map-resized(self.inner-w, self.inner-h); }

                if root.has-data : Rectangle {
                    // 树图：部位一块、其内条目再切一块，空余空间斜纹
                    for tile-data[i] in root.tiles : ContextTileView {
                        tile: tile-data;
                        active: tile-hit.has-hover;
                        x: tile-data.x * chart.width + 1.5px;
                        y: tile-data.y * chart.height + 1.5px;
                        width: max(0px, tile-data.w * chart.width - 3px);
                        height: max(0px, tile-data.h * chart.height - 3px);
                        opacity: root.hovered-tile >= 0 ? (root.hovered-tile == i ? 1.0 : 0.32)
                            : root.focus-slot == 0 ? 1.0
                            : tile-data.kind == "free" ? (root.focus-slot == -1 ? 1.0 : 0.32)
                            : tile-data.slot == root.focus-slot ? (root.focus-item < 0 || tile-data.kind == "part" || tile-data.item == root.focus-item ? 1.0 : 0.32)
                            : 0.32;
                        tile-hit := TouchArea {
                            mouse-cursor: tile-data.kind == "free" ? default : pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = i;
                                    root.focus-slot = tile-data.kind == "free" ? -1 : tile-data.slot;
                                    root.focus-item = tile-data.kind == "item" ? tile-data.item : -1;
                                    root.pointer-on-map = true;
                                    root.tip-x = tile-data.x * chart.width;
                                    root.tip-y = tile-data.y * chart.height;
                                    root.tip-w = tile-data.w * chart.width;
                                    root.tip-h = tile-data.h * chart.height;
                                    root.tile-hover(i);
                                } else if (root.pointer-on-map && root.hovered-tile == i) {
                                    root.pointer-on-map = false;
                                    root.hovered-tile = -1;
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                    root.tile-leave();
                                }
                            }
                            clicked => { if (tile-data.kind != "free") { root.tile-open(i); } }
                        }
                    }
                }

                if !root.has-data : Text {
                    width: parent.width; height: parent.height;
                    text: I18n.cx_no_request;
                    color: Theme.muted; font-size: Theme.font-sm;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap;
                }

                // 参考实现的深色提示卡：指向哪一块，就报它是什么、占多少，
                // 部位块再列出最大的几项。它盖在地图上方，不接收鼠标。
                if root.tip-open : Rectangle {
                    width: 240px;
                    height: 16px + 18px
                        + (root.tip-kind == "item" ? 16px : 0px)
                        + root.tip-rows.length * 15px
                        + (root.tip-more > 0 ? 14px : 0px)
                        + (root.tip-rows.length + (root.tip-kind == "item" ? 1 : 0) + (root.tip-more > 0 ? 1 : 0)) * 2px;
                    x: clamp(root.tip-x + root.tip-w / 2 - self.width / 2, 4px, chart.width - self.width - 4px);
                    // 参考实现把提示卡放在整张卡片里量位置：地图上方放不下时
                    // 可以盖住标题区，而不是被迫翻到方块下面。
                    y: root.tip-y - self.height - 8px >= 4px - chart.y
                        ? root.tip-y - self.height - 8px
                        : root.tip-y + root.tip-h + 8px;
                    border-radius: 9px;
                    background: #17171B;
                    drop-shadow-color: #00000047;
                    drop-shadow-blur: 30px;
                    drop-shadow-offset-y: 10px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            height: 18px;
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: root.tip-kind == "free" ? Theme.muted : ContextColors.ink(root.tip-slot);
                            }
                            Text {
                                text: root.tip-title;
                                color: #FFFFFF; font-size: Theme.font-xs; font-weight: 600;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.tip-kind != "item" : Text {
                                text: root.tip-kind == "part"
                                    ? root.tip-value + " · " + root.tip-pct
                                    : root.tip-value;
                                color: #A1A1AA; font-size: Theme.font-2xs;
                                vertical-alignment: center;
                            }
                        }
                        if root.tip-kind == "item" : Text {
                            height: 16px;
                            text: ContextText.part(root.tip-slot) + " · " + root.tip-value + " token · " + root.tip-pct;
                            color: #A1A1AA; font-size: Theme.font-2xs;
                            vertical-alignment: center; overflow: elide;
                        }
                        for row in root.tip-rows : HorizontalLayout {
                            height: 15px;
                            spacing: 10px;
                            Text {
                                text: ContextText.item(row.tag, row.name, row.count);
                                color: row.on ? #FFFFFF : #B9B9C1;
                                font-size: Theme.font-2xs;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                color: row.on ? #FFFFFF : #B9B9C1;
                                font-size: Theme.font-2xs; font-weight: row.on ? 600 : 400;
                                vertical-alignment: center;
                            }
                        }
                        if root.tip-more > 0 : Text {
                            height: 14px;
                            text: I18n.cx_more_items(root.tip-more);
                            color: #85858D; font-size: Theme.font-2xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.parts.length > 0 : HorizontalLayout {
                height: 20px;
                spacing: 14px;
                // 图例只放部位，视图切换已移到卡片标题行；这里不抢右侧空间。
                alignment: start;
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    for part in root.parts : Rectangle {
                        height: 20px;
                        width: legend-row.preferred-width;
                        border-radius: 5px;
                        background: legend-hit.has-hover ? Theme.hover : transparent;
                        legend-row := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: ContextColors.ink(part.slot);
                            }
                            Text {
                                text: ContextText.part(part.slot);
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            // 窄卡放不下「部位 + 值」，只留部位名；不占布局。
                            if root.card-w >= 640px : Text {
                                text: part.tokens-text;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        legend-hit := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = -1;
                                    root.focus-slot = part.slot;
                                    root.focus-item = -1;
                                } else {
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                }
                            }
                            clicked => { root.legend-open(part.slot); }
                        }
                    }
                    // 余量也是窗口的一部分，参考实现的图例把它挂在最后。
                    if root.capacity-tokens > root.used-tokens : Rectangle {
                        height: 20px;
                        width: free-legend.preferred-width;
                        border-radius: 5px;
                        background: free-hit.has-hover ? Theme.hover : transparent;
                        free-legend := HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.border-strong;
                            }
                            Text {
                                text: I18n.cx_free;
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            if root.card-w >= 640px : Text {
                                text: root.free-text;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                        }
                        free-hit := TouchArea {
                            mouse-cursor: default;
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hovered-tile = -1;
                                    root.focus-slot = -1;
                                    root.focus-item = -1;
                                } else {
                                    root.focus-slot = 0;
                                    root.focus-item = -1;
                                }
                            }
                        }
                    }
                }
            }

        }
    }

    // 从方块、格子或内容行打开的内容。单个条目只显示该条目的正文；一个
    // 部位则列出该部位的条目，点一行就在行下展开它的正文。
    if root.detail-open : ModalDialog {
        card-width: min(560px, root.width - 24px);
        // A part tall enough for its rows (then scrolls); one item tight when
        // its text has left memory, tall when the text is there.
        card-height: min(root.height - 40px,
            root.detail-kind == "part"
                ? min(520px, max(260px, 150px + root.detail-rows.length * 34px))
                : root.detail-text != ""
                    ? 520px
                    : 220px);
        dismissed => { root.detail-dismissed(); }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: ContextColors.ink(root.detail-slot);
                }
                Text {
                    width: min(self.preferred-width, parent.width - 80px);
                    text: root.detail-kind == "part" ? ContextText.part(root.detail-slot)
                        : ContextText.item(root.detail-tag, root.detail-name, root.detail-count);
                    color: Theme.text; font-size: Theme.font-md; font-weight: 700;
                    vertical-alignment: center; overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 6px;
                    background: close-hit.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "×";
                        color: Theme.muted; font-size: 16px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    close-hit := TouchArea { mouse-cursor: pointer; clicked => { root.detail-dismissed(); } }
                }
            }
            Text {
                height: 18px;
                text: root.detail-kind == "part"
                    ? root.detail-value + " token · " + root.detail-pct
                    : ContextText.part(root.detail-slot) + " · " + root.detail-value + " token · " + root.detail-pct;
                color: Theme.muted; font-size: Theme.font-xs;
                vertical-alignment: center; overflow: elide;
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.detail-text != "" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: root.detail-text-width;
                        border-radius: 6px;
                        background: Theme.hover;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            Text {
                                width: 100%;
                                text: root.detail-text;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // 单个条目：只展示它自己的正文，不再把整个部位的条目铺在下面。
            // 正文已随进程退出释放时，也只说明这一件事。
            if root.detail-kind == "item" && root.detail-text == "" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        width: root.detail-text-width;
                        text: I18n.cx_text_released;
                        color: Theme.muted; font-size: Theme.font-xs;
                        wrap: word-wrap;
                    }
                }
            }
            // 部位：列出条目；点一行展开它的正文/schema，再点收起。
            if root.detail-kind == "part" : ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                content-width: root.detail-text-width;
                VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    for row in root.detail-rows : VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 30px;
                            width: 100%;
                            border-radius: 6px;
                            background: row-hit.has-hover || root.detail-row-open == row.item ? Theme.hover : transparent;
                            Image {
                                x: 7px; y: (parent.height - self.height) / 2;
                                width: 9px; height: 9px;
                                source: root.detail-row-open == row.item
                                    ? @image-url("../assets/icons/chevron-down.svg")
                                    : @image-url("../assets/icons/chevron-right.svg");
                                colorize: Theme.muted; image-fit: contain;
                            }
                            Rectangle {
                                width: 6px; height: 6px; border-radius: 3px;
                                x: 22px; y: (parent.height - self.height) / 2;
                                background: ContextColors.ink(row.slot);
                            }
                            Text {
                                x: 34px; y: 0px;
                                width: parent.width - 210px; height: parent.height;
                                text: ContextText.item(row.tag, row.name, row.count);
                                color: Theme.text; font-size: Theme.font-sm; font-weight: 500;
                                vertical-alignment: center; overflow: elide;
                            }
                            if row.count > 1 && (row.tag == "tool" || row.tag == "result") : Text {
                                x: parent.width - 178px; y: 0px; height: parent.height;
                                text: "×" + row.count;
                                color: Theme.muted; font-size: Theme.font-xs;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                x: parent.width - 150px; y: (parent.height - 4px) / 2;
                                width: 72px; height: 4px; border-radius: 2px;
                                background: Theme.selected;
                                Rectangle {
                                    x: 0px; y: 0px;
                                    width: max(2px, parent.width * row.ratio);
                                    height: parent.height; border-radius: 2px;
                                    background: ContextColors.ink(row.slot);
                                }
                            }
                            Text {
                                x: parent.width - 72px; y: 0px; width: 72px; height: parent.height;
                                text: row.tokens-text;
                                color: Theme.text-secondary; font-size: Theme.font-xs;
                                vertical-alignment: center; horizontal-alignment: right;
                            }
                            row-hit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.detail-row-toggle(row.item, row.slot, row.tag, row.name, row.count);
                                }
                            }
                        }
                        if root.detail-row-open == row.item : Rectangle {
                            width: 100%;
                            border-radius: 6px;
                            background: Theme.hover;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                if root.detail-row-text != "" : Text {
                                    width: 100%;
                                    text: root.detail-row-text;
                                    color: Theme.text;
                                    font-family: Theme.font-mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                                if root.detail-row-text == "" : Text {
                                    width: 100%;
                                    text: I18n.cx_text_released;
                                    color: Theme.muted; font-size: Theme.font-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
