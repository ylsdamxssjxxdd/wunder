import { Button } from "std-widgets.slint";
import { Theme } from "design_tokens.slint";
import { TextFieldActivation, TextFieldMenu } from "text_field.slint";

// Help browser controls: flat buttons, hairline separators and a compact
// single-line input, painted from the same Theme tokens as the main window.

export component HelpInput inherits Rectangle {
    in-out property <string> text <=> editor.text;
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    public function select-all() { editor.select-all(); }
    min-width: 1px;
    background: root.enabled ? Theme.input-bg : Theme.hover;
    border-color: editor.has-focus ? Theme.accent : Theme.input-border;
    border-width: 1px;
    border-radius: 2px;
    clip: true;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-value <=> root.text;
    accessible-label: root.placeholder-text;
    focus-padding := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { editor.focus(); }
    }
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        clip: true;
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.text == "" && editor.preedit-text == "" ? root.placeholder-text : "";
            color: Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        TextFieldMenu {
            enabled: root.enabled;
            text: editor.text;
            cut() => { editor.cut(); }
            copy() => { editor.copy(); }
            paste() => { editor.paste(); }
            select-all() => { editor.select-all(); }
            editor := TextInput {
                // HelpInput already exposes this text as a text-input; keep the
                // inner editor out of the accessibility tree so the same value
                // is not announced twice.
                accessible-role: none;
                private property <length> computed-x: 6px;
                x: min(6px, max(parent.width - self.width - 6px - self.text-cursor-width, self.computed-x));
                width: max(parent.width - 12px - self.text-cursor-width, self.preferred-width);
                height: parent.height;
                enabled: root.enabled;
                single-line: true;
                color: root.enabled ? Theme.text : Theme.muted;
                vertical-alignment: center;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text;
                cursor-position-changed(cursor-position) => {
                    if cursor-position.x + self.computed-x < 6px {
                        self.computed-x = -cursor-position.x + 6px;
                    } else if cursor-position.x + self.computed-x > parent.width - 6px - self.text-cursor-width {
                        self.computed-x = parent.width - cursor-position.x - 6px - self.text-cursor-width;
                    }
                }
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
                changed has-focus => {
                    if self.has-focus && !self.read-only && self.enabled { TextFieldActivation.activated(); }
                }
            }
        }
    }
}

export component HelpButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> tab: false;
    callback clicked();
    forward-focus: button;
    min-width: 0px;
    min-height: 0px;
    background: root.tab
        ? (root.active ? Theme.panel : Theme.hover)
        : hover.has-hover || button.has-focus ? Theme.selected : transparent;
    border-width: 1px;
    border-color: root.tab
        ? Theme.border-strong
        : root.enabled && (hover.has-hover || button.has-focus) ? Theme.accent : transparent;
    border-radius: root.tab ? 3px : 2px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    if root.icon != "" : Path {
        x: (parent.width - 17px) / 2;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: transparent;
        stroke: root.enabled ? Theme.text : Theme.muted;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.icon == "" : Text {
        text: root.label;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button := Button {
        width: parent.width;
        height: parent.height;
        text: root.label;
        enabled: root.enabled;
        opacity: 0;
        clicked => { root.clicked(); }
    }
    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { button.focus(); root.clicked(); }
    }
    if root.tab && root.active : Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}

export component HelpSeparator inherits Rectangle {
    width: 1px;
    height: 22px;
    background: Theme.border;
    Rectangle { x: 1px; width: 1px; height: parent.height; background: Theme.panel; }
}
