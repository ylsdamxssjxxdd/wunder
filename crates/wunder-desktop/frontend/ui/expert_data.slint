import { Theme } from "theme.slint";
import { ExpertButton, ExpertField } from "expert_widgets.slint";
import { TextFieldActivation } from "text_field.slint";
import { TextEditBase } from "textedit-base.slint";
import { LineEdit, ComboBox, ScrollView, ListView } from "std-widgets.slint";
export struct MemoryCard { id: string, title: string, content: string, category: string, source: string, time: string }
export struct ArchiveCard { id: string, title: string, time: string }
export struct RuntimePoint { date: string, value: float, label: string }
export struct HeatCard { name: string, count: string, intensity: float }
export component ExpertData inherits Rectangle {
    in property <bool> loading;
    in property <string> error;
    in property <[MemoryCard]> memories;
    in-out property <string> query;
    in-out property <string> category: "全部标签";
    in property <[string]> categories;
    in-out property <bool> editor-open;
    in-out property <string> edit-id;
    in-out property <string> edit-title;
    in-out property <string> edit-content;
    in-out property <string> edit-category;
    in property <bool> saving;
    callback refresh();
    callback save-memory();
    callback delete-memory(string);
    callback open-memory(int);
    private property <bool> delete-open;
    background: white; border-radius: 12px;
    VerticalLayout { padding: 12px; spacing: 16px;
        if root.error != "" : Text { text: root.error; color: Theme.danger; wrap: word-wrap; }
        HorizontalLayout { height: 36px;
            VerticalLayout { Text { text: "记忆碎片"; color: Theme.text; font-size: 16px; font-weight: 700; } Text { text: "将可复用的长期事实整理为模型友好的记忆索引与详情。"; color: Theme.muted; font-size: 12px; } }
            Rectangle { horizontal-stretch: 1; }
            ExpertButton { width: 66px; label: "刷新"; icon: @image-url("../assets/icons/rotate-right.svg"); enabled: !root.loading; clicked => { root.refresh(); } }
            ExpertButton { width: 96px; label: "新建碎片"; icon: @image-url("../assets/icons/plus.svg"); selected: true; clicked => { root.open-memory(-1); } }
        }
        HorizontalLayout { height: 38px; spacing: 12px;
            LineEdit {
                horizontal-stretch: 7; placeholder-text: "搜索记忆 ID、索引标题或内容详情"; text <=> root.query;
                changed has-focus => {
                    if self.has-focus && !self.read-only && self.enabled { TextFieldActivation.activated(); }
                }
                accepted => { root.refresh(); }
            }
            ComboBox { horizontal-stretch: 3; model: root.categories; current-value <=> root.category; selected(value) => { root.refresh(); } }
        }
        ScrollView { horizontal-scrollbar-policy: always-off;
            VerticalLayout { alignment: start; spacing: 12px;
                for row in Math.ceil(root.memories.length / 4) : HorizontalLayout { alignment: start; spacing: 12px;
                    for col in 4 : Rectangle { property <int> idx: row * 4 + col; property <MemoryCard> item: root.memories[self.idx]; visible: self.idx < root.memories.length; width: (root.width - 60px) / 4; height: 128px; border-radius: 16px; border-width: 1px; border-color: Theme.border; background: #f6f6f8; clip: true;
                        // Every line is width- and height-budgeted: a Text's layout
                        // minimum is its preferred width, so without `min-width: 0px`
                        // a long category or title pushed the row past the card edge.
                        VerticalLayout { padding: 12px; spacing: 6px;
                            HorizontalLayout { height: 15px; Text { text: item.category; color: Theme.text; font-size: 11px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; } Text { text: item.time; color: Theme.muted; font-size: 10px; min-width: 0px; overflow: elide; vertical-alignment: center; } }
                            Text { height: 20px; text: item.title; color: Theme.text; font-size: 14px; font-weight: 600; min-width: 0px; overflow: elide; vertical-alignment: center; }
                            Text { vertical-stretch: 1; min-height: 0px; min-width: 0px; text: item.content; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; max-lines: 2; overflow: elide; vertical-alignment: top; }
                            Text { height: 15px; text: item.source; color: Theme.muted; font-size: 11px; min-width: 0px; overflow: elide; vertical-alignment: center; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-memory(idx); } }
                    }
                }
                if root.memories.length == 0 : Text { height: 48px; text: root.loading ? "正在加载…" : "暂无记忆碎片"; color: Theme.muted; }
            }
        }
    }
    if root.editor-open : Rectangle { background: Theme.overlay; TouchArea { scroll-event(event) => { return accept; } } Rectangle { width: min(520px, parent.width - 40px); height: min(440px, parent.height - 30px); background: white; border-radius: 14px;
        VerticalLayout { padding: 20px; spacing: 12px;
            Text { text: root.edit-id == "" ? "新建碎片" : "编辑记忆碎片"; color: Theme.text; font-size: 16px; font-weight: 600; }
            if root.error != "" : Text { text: root.error; color: Theme.danger; wrap: word-wrap; }
            ExpertField { label: "索引标题"; text <=> root.edit-title; enabled: !root.saving; }
            ExpertField { label: "标签"; text <=> root.edit-category; enabled: !root.saving; }
            TextEditBase { vertical-stretch: 1; text <=> root.edit-content; read-only: root.saving; wrap: word-wrap; background: white; border-width: 1px; border-color: Theme.border; foreground: Theme.text; scroll-view-padding: 10px; }
            HorizontalLayout { height: 30px; if root.edit-id != "" : ExpertButton { label: "删除"; icon: @image-url("../assets/icons/trash.svg"); enabled: !root.saving; clicked => { root.delete-open = true; } } Rectangle { horizontal-stretch: 1; } ExpertButton { label: "取消"; enabled: !root.saving; clicked => { root.editor-open = false; } } ExpertButton { label: "保存"; icon: @image-url("../assets/icons/save.svg"); enabled: !root.saving; selected: true; clicked => { root.save-memory(); } } }
        }
    } }
    if root.delete-open : Rectangle { background: Theme.overlay; TouchArea { scroll-event(event) => { return accept; } } Rectangle { width: 300px; height: 140px; background: white; border-radius: 12px; VerticalLayout { padding: 20px; Text { text: "确定删除此记忆碎片？"; color: Theme.text; } HorizontalLayout { ExpertButton { label: "取消"; clicked => { root.delete-open = false; } } ExpertButton { label: "删除"; clicked => { root.delete-open = false; root.delete-memory(root.edit-id); } } } } } }
}
