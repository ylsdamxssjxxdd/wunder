import { I18n } from "i18n.slint";
import { Theme, ChannelAccountCard, ChannelBindingCard, ChannelCatalogCard, ChannelLogCard } from "theme.slint";
import { Action, ConfirmDialog, FormField, InlineInput, ModalDialog, PageState, PageStateKind, ThemeCheck } from "components.slint";
import { TextEditBase } from "textedit-base.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";

// White rounded section card matching the settings/model forms.
component ChannelCard inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout { padding: 14px; spacing: 8px; @children }
}

// Accent icon plus bold section title, the same head used by model forms.
component ChannelSectionHead inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    height: 22px;
    Image { x: 0px; y: 3px; width: 16px; height: 16px; source: root.icon; colorize: Theme.accent-ink; }
    Text { x: 24px; width: parent.width - 24px; height: 22px; text: root.title; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; overflow: elide; }
}

// Channel accounts follow the shared master/detail page: the account list on
// the left, the selected account plus its config, logs and bindings on the right.
export component ChannelsPage inherits Rectangle {
    in property <bool> loading: false;
    in property <[ChannelCatalogCard]> catalog;
    in property <[ChannelAccountCard]> accounts;
    in property <int> selected: -1;
    in property <[ChannelBindingCard]> bindings;
    in property <bool> bindings-loading: false;
    in property <bool> logs-loading: false;
    in property <[ChannelLogCard]> logs;
    in property <bool> editor-open: false;
    in property <bool> editor-saving: false;
    in property <string> editor-id;
    in-out property <int> editor-kind: 0;
    in-out property <int> editor-agent: 0;
    in property <[string]> agent-names;
    in property <[string]> catalog-names;
    in property <bool> delete-open: false;
    in property <bool> qr-open: false;
    in property <int> qr-state: 0;
    in property <image> qr-image;
    in property <string> qr-message;
    in-out property <string> edit-name;
    in-out property <bool> edit-enabled: true;
    in-out property <bool> edit-group-chat: true;
    in-out property <string> edit-app-id;
    in-out property <string> edit-app-secret;
    in-out property <string> edit-corp-id;
    in-out property <string> edit-wechat-agent;
    in-out property <string> edit-secret;
    in-out property <string> edit-token;
    in-out property <string> edit-aes-key;
    in-out property <string> edit-original-id;
    in-out property <string> edit-api-base;
    in-out property <string> edit-bot-token;
    in-out property <string> edit-bot-id;
    in-out property <string> edit-user-id;
    in-out property <string> edit-domain;
    in-out property <string> edit-config-json;
    callback refresh();
    callback select-account(int);
    callback open-creator();
    callback edit-account();
    callback save-editor();
    callback cancel-editor();
    callback request-delete();
    callback confirm-delete();
    callback cancel-delete();
    callback toggle(bool);
    callback open-logs();
    callback probe-logs();
    callback clear-logs();
    callback delete-binding(string, string);
    callback start-qr();
    callback cancel-qr();
    callback reconnect();

    private property <ChannelAccountCard> current: root.selected >= 0 && root.selected < root.accounts.length ? root.accounts[root.selected] : {
        channel: "", account-id: "", name: "", status: "", active: false, configured: false,
        peer-kind: "", agent-id: "", created-at: "", updated-at: "", summary: "", secret-set: false,
        app-id: "", corp-id: "", wechat-agent-id: "", original-id: "", weixin-bot-id: "",
        weixin-user-id: "", bot-type: "", domain: ""
    };
    private property <string> editor-channel-key: root.editor-kind >= 0 && root.editor-kind < root.catalog.length ? root.catalog[root.editor-kind].channel : "";
    background: Theme.chat;

    public pure function log-color(level: string) -> color {
        return level == "error" || level == "ERROR" ? Theme.danger
            : level == "warn" || level == "WARN" || level == "warning" ? Theme.warning
            : Theme.muted;
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 14px;
        // Account list: same width and panel treatment as the model list.
        Rectangle {
            width: 236px;
            border-radius: Theme.radius-md;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout { height: 30px; spacing: 6px;
                    Text { height: 30px; text: I18n.ch_my_accounts; color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.loading; clicked => { root.refresh(); } }
                    Action { icon: @image-url("../assets/icons/plus.svg"); label: I18n.ch_add_new; primary: true; clicked => { root.open-creator(); } }
                }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; spacing: 6px;
                        for account[index] in root.accounts : account-hot := TouchArea {
                            height: 58px;
                            enabled: !root.loading;
                            mouse-cursor: pointer;
                            clicked => { root.select-account(index); }
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: root.selected == index ? Theme.accent-secondary : account-hot.has-hover ? Theme.border : transparent;
                                background: root.selected == index ? Theme.accent-soft : account-hot.has-hover ? Theme.hover : transparent;
                                Text {
                                    x: 10px; y: 10px; width: parent.width - 20px; height: 18px;
                                    text: account.name == "" ? account.account-id : account.name;
                                    color: Theme.text; font-size: Theme.font-md; font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    x: 10px; y: 31px; width: parent.width - 20px; height: 16px;
                                    text: account.channel + " · " + (account.configured ? I18n.ch_configured : I18n.ch_pending_config);
                                    color: account.configured ? Theme.success : Theme.muted;
                                    font-size: Theme.font-2xs;
                                    overflow: elide;
                                }
                            }
                        }
                        if root.accounts.length == 0 : PageState { height: 60px; kind: root.loading ? PageStateKind.loading : PageStateKind.empty; message: root.loading ? I18n.common_loading : I18n.ch_accounts_empty; }
                    }
                }
            }
        }
        // Detail pane.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: Theme.radius-md;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            if root.selected < 0 : PageState { vertical-stretch: 1; kind: PageStateKind.empty; message: I18n.ch_pick_account_hint; }
            if root.selected >= 0 : VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout { height: 46px; spacing: 8px;
                    VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 2px;
                        Text { height: 26px; text: root.current.name == "" ? root.current.account-id : root.current.name; color: Theme.text; font-size: Theme.font-headline; font-weight: 700; overflow: elide; }
                        Text { height: 17px; text: root.current.channel + " · " + (root.current.configured ? I18n.ch_configured : I18n.ch_pending_config) + " · " + (root.current.active ? I18n.common_enabled : I18n.common_disabled); color: Theme.muted; font-size: Theme.font-xs; overflow: elide; }
                    }
                    Action { height: 32px; width: 76px; label: root.current.active ? I18n.common_disable : I18n.common_enable; show-label: true; enabled: !root.loading; clicked => { root.toggle(!root.current.active); } }
                    Action { height: 32px; width: 76px; icon: @image-url("../assets/icons/pen.svg"); label: I18n.common_edit; show-label: true; enabled: !root.loading; clicked => { root.edit-account(); } }
                    if root.current.channel == "xmpp" : Action { height: 32px; width: 64px; label: I18n.ch_reconnect; show-label: true; enabled: !root.loading; clicked => { root.reconnect(); } }
                    Action { height: 32px; icon: @image-url("../assets/icons/trash.svg"); label: I18n.common_delete; danger: true; enabled: !root.loading; clicked => { root.request-delete(); } }
                }
                ScrollView {
                    vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout { alignment: start; spacing: 12px;
                        ChannelCard {
                            ChannelSectionHead { icon: @image-url("../assets/icons/robot.svg"); title: I18n.ch_account_info; }
                            for row in [
                                { label: I18n.common_channels, value: root.current.channel },
                                { label: I18n.ch_account_id, value: root.current.account-id },
                                { label: I18n.ch_config_status, value: root.current.configured ? I18n.ch_configured : I18n.ch_pending_config },
                                { label: I18n.ch_last_updated, value: root.current.updated-at == "" ? I18n.common_none : root.current.updated-at }
                            ] : HorizontalLayout { height: 28px; spacing: 8px;
                                Rectangle { width: 96px;
                                    Text { width: parent.width; height: parent.height; text: row.label; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                                }
                                Text { horizontal-stretch: 1; height: parent.height; text: row.value; color: row.label == I18n.ch_config_status ? (root.current.configured ? Theme.success : Theme.warning) : Theme.text; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        ChannelCard {
                            ChannelSectionHead { icon: @image-url("../assets/icons/plug.svg"); title: I18n.ch_channel_config; }
                            HorizontalLayout { height: 32px; spacing: 8px;
                                Text { horizontal-stretch: 1; min-width: 0px; text: root.current.channel == "weixin" ? I18n.ch_qr_login : I18n.ch_account_connection; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                                Action { width: 92px; label: root.current.channel == "weixin" ? I18n.ch_gen_qr : I18n.ch_edit_config; show-label: true; primary: true; clicked => { if root.current.channel == "weixin" { root.start-qr(); } else { root.edit-account(); } } }
                                if root.current.channel == "weixin" : Action { width: 84px; label: I18n.tm_advanced; show-label: true; clicked => { root.edit-account(); } }
                            }
                        }
                        ChannelCard {
                            HorizontalLayout { height: 24px; spacing: 6px;
                                Image { y: 4px; width: 16px; height: 16px; source: @image-url("../assets/icons/log-info.svg"); colorize: Theme.accent-ink; }
                                Text { text: I18n.ch_runtime_logs; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Action { icon: @image-url("../assets/icons/bolt.svg"); label: I18n.ch_write_test_log; enabled: !root.logs-loading; clicked => { root.probe-logs(); } }
                                Action { icon: @image-url("../assets/icons/trash.svg"); label: I18n.ch_clear_all; clicked => { root.clear-logs(); } }
                                Action { icon: @image-url("../assets/icons/rotate-right.svg"); label: I18n.common_refresh; enabled: !root.logs-loading; clicked => { root.open-logs(); } }
                            }
                            Rectangle {
                                height: 190px;
                                border-radius: Theme.radius-sm;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;
                                ScrollView {
                                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                    horizontal-scrollbar-policy: always-off;
                                    VerticalLayout { alignment: start;
                                        for entry in root.logs : Rectangle {
                                            height: 32px;
                                            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
                                            Text { x: 8px; y: 0px; width: 46px; height: parent.height; text: entry.level; color: root.log-color(entry.level); font-size: Theme.font-2xs; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                            Text { x: 58px; y: 0px; width: parent.width - 156px; height: parent.height; text: entry.message; color: Theme.text; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
                                            Text { x: parent.width - 98px; y: 0px; width: 90px; height: parent.height; text: entry.time; color: Theme.muted; font-size: Theme.font-2xs; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                        }
                                        if root.logs.length == 0 : PageState { height: 60px; kind: root.logs-loading ? PageStateKind.loading : PageStateKind.empty; message: root.logs-loading ? I18n.common_loading : I18n.ch_no_logs; }
                                    }
                                }
                            }
                        }
                        ChannelCard {
                            HorizontalLayout { height: 24px; spacing: 6px;
                                Image { y: 4px; width: 16px; height: 16px; source: @image-url("../assets/icons/comments.svg"); colorize: Theme.accent-ink; }
                                Text { text: I18n.ch_bindings; color: Theme.text; font-size: Theme.font-md; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.bindings-loading ? I18n.common_loading : root.bindings.length + I18n.ch_bindings_count_suffix; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; }
                            }
                            for binding in root.bindings : Rectangle {
                                height: 46px;
                                border-radius: Theme.radius-sm;
                                background: Theme.panel;
                                Text {
                                    x: 10px; y: 5px; width: parent.width - 54px; height: 17px;
                                    text: (binding.peer-kind == "group" ? I18n.ch_group_chat : I18n.ch_direct_chat) + " · " + (binding.peer-id == "*" ? I18n.ch_bindings_all_sessions : binding.peer-id) + (binding.enabled ? "" : I18n.ch_disabled_suffix);
                                    color: Theme.text; font-size: Theme.font-xs; font-weight: 600;
                                    vertical-alignment: center; overflow: elide;
                                }
                                Text {
                                    x: 10px; y: 24px; width: parent.width - 54px; height: 15px;
                                    text: binding.agent-id == "" ? I18n.common_default_agent : binding.agent-id;
                                    color: Theme.muted; font-size: Theme.font-2xs;
                                    vertical-alignment: center; overflow: elide;
                                }
                                Action {
                                    x: parent.width - 38px; y: 8px;
                                    icon: @image-url("../assets/icons/trash.svg");
                                    label: I18n.ch_delete_binding; danger: true;
                                    enabled: !root.loading;
                                    clicked => { root.delete-binding(binding.peer-kind, binding.peer-id); }
                                }
                            }
                            if root.bindings.length == 0 && !root.bindings-loading : PageState { height: 44px; kind: PageStateKind.empty; message: I18n.ch_bindings_empty; }
                        }
                    }
                }
            }
        }
    }

    if root.editor-open : ModalDialog {
        card-width: 540px;
        card-height: 600px;
        dismissed => { if !root.editor-saving { root.cancel-editor(); } }
        HorizontalLayout { height: 26px; spacing: 8px;
            Text { horizontal-stretch: 1; height: 26px; text: root.editor-kind >= 0 && root.editor-kind < root.catalog.length && root.catalog[root.editor-kind].name != "" ? root.catalog[root.editor-kind].name : I18n.ch_accounts_title; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; vertical-alignment: center; overflow: elide; }
            Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_close; enabled: !root.editor-saving; clicked => { root.cancel-editor(); } }
        }
        ScrollView {
            vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
            VerticalLayout { spacing: 10px; alignment: start;
                HorizontalLayout { height: 32px; spacing: 8px;
                    Text { width: 84px; text: I18n.common_channels; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                    ComboBox { horizontal-stretch: 1; model: root.catalog-names.length == 0 ? [I18n.ch_no_channels] : root.catalog-names; current-index <=> root.editor-kind; enabled: root.editor-id == "" && !root.editor-saving; }
                }
                HorizontalLayout { height: 32px; spacing: 8px;
                    Text { width: 84px; text: I18n.ch_display_name; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                    InlineInput { horizontal-stretch: 1; height: 32px; text <=> root.edit-name; enabled: !root.editor-saving; }
                }
                HorizontalLayout { height: 32px; spacing: 8px;
                    Text { width: 84px; text: I18n.common_ai; color: Theme.muted; font-size: Theme.font-sm; vertical-alignment: center; }
                    ComboBox { horizontal-stretch: 1; model: root.agent-names; current-index <=> root.editor-agent; enabled: !root.editor-saving; }
                }
                HorizontalLayout { height: 26px; spacing: 10px;
                    ThemeCheck { text: I18n.ch_enable_account; checked: root.edit-enabled; enabled: !root.editor-saving; toggled => { root.edit-enabled = !root.edit-enabled; } }
                    if root.editor-channel-key == "feishu" : ThemeCheck { text: I18n.ch_receive_group; checked: root.edit-group-chat; enabled: !root.editor-saving; toggled => { root.edit-group-chat = !root.edit-group-chat; } }
                }
                if root.editor-channel-key == "feishu" : VerticalLayout { spacing: 8px;
                    FormField { label: "App ID"; placeholder: I18n.ch_field_feishu_app_id; text <=> root.edit-app-id; }
                    FormField { label: I18n.ch_field_app_secret; placeholder: I18n.ch_field_writeonly_hint; secret: true; text <=> root.edit-app-secret; }
                    FormField { label: I18n.ch_field_feishu_domain; placeholder: "open.feishu.cn"; text <=> root.edit-domain; }
                }
                if root.editor-channel-key == "wechat" : VerticalLayout { spacing: 8px;
                    FormField { label: I18n.ch_field_corp_id; placeholder: I18n.ch_field_wecom_corp_id; text <=> root.edit-corp-id; }
                    FormField { label: I18n.ch_field_wecom_agent_id; placeholder: I18n.ch_field_wecom_agent_suffix; text <=> root.edit-wechat-agent; }
                    FormField { label: I18n.ch_field_wecom_secret; placeholder: I18n.ch_field_writeonly_hint; secret: true; text <=> root.edit-secret; }
                    FormField { label: I18n.ch_field_token_optional; placeholder: I18n.ch_field_token_hint; text <=> root.edit-token; }
                    FormField { label: I18n.ch_field_aes_optional; placeholder: I18n.ch_field_aes_hint; secret: true; text <=> root.edit-aes-key; }
                    FormField { label: I18n.ch_field_wecom_domain; placeholder: "qyapi.weixin.qq.com"; text <=> root.edit-domain; }
                }
                if root.editor-channel-key == "wechat_mp" : VerticalLayout { spacing: 8px;
                    FormField { label: "App ID"; placeholder: I18n.ch_field_mp_app_id; text <=> root.edit-app-id; }
                    FormField { label: I18n.ch_field_app_secret; placeholder: I18n.ch_field_writeonly_hint; secret: true; text <=> root.edit-app-secret; }
                    FormField { label: I18n.ch_field_token_optional; placeholder: I18n.ch_field_token_hint; text <=> root.edit-token; }
                    FormField { label: I18n.ch_field_aes_optional; placeholder: I18n.ch_field_aes_hint; secret: true; text <=> root.edit-aes-key; }
                    FormField { label: I18n.ch_field_mp_original_id; placeholder: I18n.ch_field_mp_original_hint; text <=> root.edit-original-id; }
                    FormField { label: I18n.ch_field_mp_domain; placeholder: "api.weixin.qq.com"; text <=> root.edit-domain; }
                }
                if root.editor-channel-key == "weixin" : VerticalLayout { spacing: 8px;
                    FormField { label: I18n.ch_field_api_base_optional; placeholder: "https://ilinkai.weixin.qq.com"; text <=> root.edit-api-base; }
                    FormField { label: I18n.ch_field_bot_token; placeholder: I18n.ch_field_writeonly_hint; secret: true; text <=> root.edit-bot-token; }
                    HorizontalLayout { height: 30px; spacing: 8px;
                        Text { text: I18n.ch_no_token_hint; color: Theme.muted; font-size: Theme.font-xs; vertical-alignment: center; }
                        Action { width: 92px; label: I18n.ch_qr_login_button; show-label: true; enabled: !root.editor-saving; clicked => { root.start-qr(); } }
                    }
                    FormField { label: I18n.ch_field_bot_id; placeholder: I18n.ch_field_bot_id_placeholder; text <=> root.edit-bot-id; }
                    FormField { label: I18n.ch_field_user_id; placeholder: I18n.ch_field_user_id_placeholder; text <=> root.edit-user-id; }
                }
                if root.editor-channel-key != "feishu" && root.editor-channel-key != "wechat" && root.editor-channel-key != "wechat_mp" && root.editor-channel-key != "weixin" : Text { height: 34px; text: I18n.ch_guided_form_empty; color: Theme.muted; font-size: Theme.font-xs; wrap: word-wrap; }
                Text { height: 17px; text: I18n.ch_advanced_json; color: Theme.muted; font-size: Theme.font-xs; }
                TextEditBase { height: 96px; text <=> root.edit-config-json; wrap: word-wrap; foreground: Theme.text; font-size: Theme.font-xs; background: Theme.input-bg; border-width: 1px; border-color: Theme.input-border; border-radius: Theme.radius-sm; scroll-view-padding: 8px; }
            }
        }
        HorizontalLayout { height: 34px; spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Action { width: 84px; label: I18n.common_cancel; show-label: true; enabled: !root.editor-saving; clicked => { root.cancel-editor(); } }
            Action { width: 84px; label: root.editor-saving ? I18n.common_saving : I18n.common_save; show-label: true; primary: true; enabled: !root.editor-saving; clicked => { root.save-editor(); } }
        }
    }

    if root.qr-open : ModalDialog {
        card-width: 380px;
        card-height: 380px;
        dismissed => { root.cancel-qr(); }
        HorizontalLayout { height: 26px; spacing: 8px;
            Text { horizontal-stretch: 1; height: 26px; text: I18n.ch_qr_title; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; vertical-alignment: center; overflow: elide; }
            Action { icon: @image-url("../assets/icons/xmark.svg"); label: I18n.common_close; clicked => { root.cancel-qr(); } }
        }
        if root.qr-state <= 1 : VerticalLayout { spacing: 10px;
            HorizontalLayout { height: 220px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 220px; height: 220px; border-radius: Theme.radius-md; background: Theme.surface;
                    border-width: 1px; border-color: Theme.border;
                    Image { x: 10px; y: 10px; width: 200px; height: 200px; source: root.qr-image; image-fit: contain; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { height: 18px; text: root.qr-state == 0 ? I18n.ch_qr_waiting : I18n.ch_qr_scan_hint; color: Theme.muted; font-size: Theme.font-sm; horizontal-alignment: center; }
        }
        if root.qr-state == 2 : Text { vertical-stretch: 1; text: I18n.ch_qr_success; color: Theme.success; font-size: Theme.font-md; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        if root.qr-state == 3 : Text { vertical-stretch: 1; text: I18n.ch_qr_expired; color: Theme.warning; font-size: Theme.font-md; horizontal-alignment: center; vertical-alignment: center; }
        if root.qr-state == 4 : Text { vertical-stretch: 1; text: I18n.ch_qr_canceled; color: Theme.muted; font-size: Theme.font-md; horizontal-alignment: center; vertical-alignment: center; }
        if root.qr-state == 5 : Text { vertical-stretch: 1; text: I18n.ch_qr_failed_prefix + root.qr-message; color: Theme.danger; font-size: Theme.font-sm; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { height: 34px; spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Action { width: 72px; label: I18n.common_close; show-label: true; clicked => { root.cancel-qr(); } }
            if root.qr-state >= 3 : Action { width: 130px; label: I18n.ch_qr_refresh; show-label: true; primary: true; clicked => { root.start-qr(); } }
        }
    }

    if root.delete-open : ConfirmDialog {
        title: I18n.err_op_delete_channel;
        message: I18n.ch_delete_message;
        confirm-label: I18n.common_confirm_delete;
        cancel-label: I18n.common_cancel;
        danger: true;
        confirmed => { root.confirm-delete(); }
        canceled => { root.cancel-delete(); }
    }
}
