import { I18n } from "i18n.slint";
import { Theme } from "theme.slint";
// Frozen-screen region selector. Rust owns the captured frame and receives
// only the final physical crop rectangle.
//
// The selection lives in this window's logical pixels, while the frozen frame
// is a physical-pixel bitmap. The conversion therefore uses the *window's own*
// size — the thing the preview is stretched onto — and never a scale factor
// read from the platform: that value can still describe the previous monitor
// (or 1.0 on a scaled display) at the moment the selector appears, and every
// selection made against it then lands at a fraction of its intended size.

component OverlayButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback triggered();

    width: 58px;
    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent-ink : #ffffff70;
    background: button.has-hover ? (root.primary ? Theme.accent : #4b4b4b) : (root.primary ? Theme.accent-deep : #333333);
    Text { text: root.label; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    button := TouchArea { mouse-cursor: pointer; clicked => { root.triggered(); } }
}

export component ScreenshotOverlay inherits Window {
    in property <image> screen-image;
    // Physical size of the frozen frame the selector is drawn over.
    in property <int> frame-width: 0;
    in property <int> frame-height: 0;
    in-out property <float> sel-x: 0;
    in-out property <float> sel-y: 0;
    in-out property <float> sel-w: 0;
    in-out property <float> sel-h: 0;
    /// Physical crop rectangle inside the frame: the placement of the preview
    /// is the truth here, so whatever the window manager did to the window size
    /// (scale factor, work area, monitor) the crop still matches what the
    /// reader framed.
    callback confirmed(int, int, int, int);
    callback canceled();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    forward-focus: keys;
    property <bool> dragging: false;
    property <float> anchor-x: 0;
    property <float> anchor-y: 0;
    property <bool> has-selection: root.sel-w >= 4 && root.sel-h >= 4;
    // Logical size of the preview surface, floored at one pixel so the mapping
    // below can never divide by zero on a window that has not been laid out.
    private property <float> view-width: max(1px, root.width) / 1px;
    private property <float> view-height: max(1px, root.height) / 1px;

    function to-frame-x(value: float) -> int { return round(value * root.frame-width / root.view-width); }
    function to-frame-y(value: float) -> int { return round(value * root.frame-height / root.view-height); }
    function reset-selection() { root.sel-x = 0; root.sel-y = 0; root.sel-w = 0; root.sel-h = 0; }
    function finish() {
        if root.has-selection {
            root.confirmed(root.to-frame-x(root.sel-x), root.to-frame-y(root.sel-y),
                root.to-frame-x(root.sel-w), root.to-frame-y(root.sel-h));
        }
    }
    function select-all() { root.sel-x = 0; root.sel-y = 0; root.sel-w = root.view-width; root.sel-h = root.view-height; root.finish(); }

    Image { width: parent.width; height: parent.height; source: root.screen-image; image-fit: fill; }
    Rectangle { background: #00000092; }
    // Restore original pixels inside the selection for a faithful preview.
    if root.has-selection : Rectangle {
        x: root.sel-x * 1px; y: root.sel-y * 1px; width: root.sel-w * 1px; height: root.sel-h * 1px; clip: true;
        Image { x: -(root.sel-x * 1px); y: -(root.sel-y * 1px); width: root.width; height: root.height; source: root.screen-image; image-fit: fill; }
        Rectangle { background: transparent; border-width: 2px; border-color: Theme.accent-ink; }
    }
    touch := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.anchor-x = (self.mouse-x / 1px).clamp(0, root.view-width);
                root.anchor-y = (self.mouse-y / 1px).clamp(0, root.view-height);
                root.reset-selection(); root.dragging = true;
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.dragging = false;
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.canceled();
            }
        }
        moved => {
            if root.dragging {
                let x = (self.mouse-x / 1px).clamp(0, root.view-width);
                let y = (self.mouse-y / 1px).clamp(0, root.view-height);
                root.sel-x = min(root.anchor-x, x); root.sel-y = min(root.anchor-y, y);
                root.sel-w = abs(root.anchor-x - x); root.sel-h = abs(root.anchor-y - y);
            }
        }
    }
    if !root.has-selection && !root.dragging : Rectangle {
        x: (parent.width - 392px) / 2; y: 24px; width: 392px; height: 32px; border-radius: 6px; background: #000000b8;
        Text { text: I18n.so_hint; color: #ffffff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.has-selection && !root.dragging : Rectangle {
        x: ((root.sel-x + root.sel-w) * 1px - 198px).clamp(4px, root.width - 202px);
        y: ((root.sel-y + root.sel-h) * 1px + 8px).clamp(4px, root.height - 38px);
        width: 198px; height: 34px; border-radius: 7px; background: #282828ee;
        HorizontalLayout { padding-left: 4px; padding-right: 4px; padding-top: 3px; padding-bottom: 3px; spacing: 5px;
            OverlayButton { label: I18n.so_fullscreen; triggered => { root.select-all(); } }
            OverlayButton { label: I18n.common_done; primary: true; triggered => { root.finish(); } }
            OverlayButton { label: I18n.common_cancel; triggered => { root.canceled(); } }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.canceled(); accept }
            else if event.text == Key.Return && root.has-selection { root.finish(); accept }
            else { reject }
        }
    }
}
