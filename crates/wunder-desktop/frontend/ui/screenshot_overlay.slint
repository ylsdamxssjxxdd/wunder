import { I18n } from "i18n.slint";
import { Theme } from "theme.slint";
// Frozen-screen region selector. Rust owns the captured frame and receives
// only the final physical crop rectangle.
//
// The selection lives in this window's logical pixels, while the frozen frame
// is a physical-pixel bitmap. The conversion therefore uses the *window's own*
// size — the thing the preview is stretched onto — and never a scale factor
// read from the platform: that value can still describe the previous monitor
// (or 1.0 on a scaled display) at the moment the selector appears, and every
// selection made against it then lands at a fraction of its intended size.
//
// Interaction model, matching what drawing tools do:
//   * Idle: drag draws a region. Space snaps the selection to the window or
//     control under the pointer; the window tree is built lazily on that key,
//     so opening the selector costs no detection work.
//   * With a selection: dragging inside moves it, dragging one of the eight
//     handles resizes it, a click outside starts a new region.
//
// Slint has no bitwise operators, so the drag state and the grabbed edge are
// small integers instead of a mask:
//   mode: 0 idle · 1 creating · 2 moving · 3 resizing
//   edge: 0 outside · 1 left · 2 right · 3 top · 4 bottom
//         5 top-left · 6 top-right · 7 bottom-left · 8 bottom-right
//         9 inside → move
export struct CaptureRegion { x: int, y: int, w: int, h: int }

component OverlayButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback triggered();

    width: 58px;
    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent-ink : #ffffff70;
    background: button.has-hover ? (root.primary ? Theme.accent : #4b4b4b) : (root.primary ? Theme.accent-deep : #333333);
    Text { text: root.label; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    button := TouchArea { mouse-cursor: pointer; clicked => { root.triggered(); } }
}

// One of the eight resize grips. Purely visual: the single full-window
// TouchArea owns every pointer event and decides from the position which grip
// is being dragged, so handles never fight over hit testing.
component SelectionHandle inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: Theme.accent-ink;
    border-width: 1px;
    border-color: #ffffff;
}

export component ScreenshotOverlay inherits Window {
    in property <image> screen-image;
    // Physical size of the frozen frame the selector is drawn over.
    in property <int> frame-width: 0;
    in property <int> frame-height: 0;
    // Legacy hover-autodetect switch. The selector is key-driven now (Space
    // calls `detect-at-pointer`); this stays false so hover never probes.
    in property <bool> auto-detect: false;
    // Detected window rectangle under the pointer, in frozen-frame pixels,
    // resolved by Rust against the window tree it detected for this frame.
    callback region-at(int, int) -> CaptureRegion;
    /// Ask Rust for the UI Automation element under a frame pixel. The
    /// generation identifies the pointer position, so a late answer for an old
    /// position can be dropped instead of moving the highlight backwards.
    callback probe-at(int, int, int);
    in-out property <float> sel-x: 0;
    in-out property <float> sel-y: 0;
    in-out property <float> sel-w: 0;
    in-out property <float> sel-h: 0;
    /// Physical crop rectangle inside the frame: the placement of the preview
    /// is the truth here, so whatever the window manager did to the window size
    /// (scale factor, work area, monitor) the crop still matches what the
    /// reader framed.
    callback confirmed(int, int, int, int);
    callback canceled();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    forward-focus: keys;

    private property <int> mode: 0;
    private property <int> edge: 0;
    private property <float> press-x: 0;
    private property <float> press-y: 0;
    // Selection geometry when the current drag started, so every move is an
    // absolute offset from it instead of accumulating rounding drift.
    private property <float> base-x: 0;
    private property <float> base-y: 0;
    private property <float> base-w: 0;
    private property <float> base-h: 0;
    private property <float> anchor-x: 0;
    private property <float> anchor-y: 0;
    // A press becomes a click only when the pointer never left a few pixels.
    private property <bool> moved-away: false;
    // Window under the pointer, already converted to the selector's own
    // logical pixels. Zero width means "nothing under the pointer".
    private property <float> hover-x: 0;
    private property <float> hover-y: 0;
    private property <float> hover-w: 0;
    private property <float> hover-h: 0;
    // Window-tree rectangle the current highlight was built from. A refined
    // control outline is only kept while the same window stays under the
    // pointer, so an overlapping window cannot inherit another window's
    // control highlight.
    private property <float> hover-base-x: 0;
    private property <float> hover-base-y: 0;
    private property <float> hover-base-w: 0;
    private property <float> hover-base-h: 0;
    private property <bool> hovering: root.hover-w > 0 && root.hover-h > 0;
    // Pointer generation of the pending element probe; only an answer for the
    // current position may refine the highlight.
    private property <int> probe-generation: 0;
    // Generation already sent to Rust, so the throttled timer probes a position
    // once instead of repeating it every tick.
    private property <int> probed-generation: 0;
    private property <float> probe-x: 0;
    private property <float> probe-y: 0;
    // Edge under the pointer while idle; kept in a property so the cursor
    // binding does not have to recompute the hit test.
    private property <int> cursor-edge: 0;
    // Distance from an edge (and outside it) that still grabs that edge.
    private property <float> handle-band: 7;
    private property <bool> has-selection: root.sel-w >= 4 && root.sel-h >= 4;
    // Logical size of the preview surface, floored at one pixel so the mapping
    // below can never divide by zero on a window that has not been laid out.
    private property <float> view-width: max(1px, root.width) / 1px;
    private property <float> view-height: max(1px, root.height) / 1px;
    // Pointer position in frozen-frame pixels. Tracked even though hover
    // detection is off, so the detection key knows where the user is pointing
    // without waiting for another move event. Rust seeds it with the real
    // cursor when the selector opens, so Space works before the first move.
    private property <float> pointer-x: root.frame-width * 1.0 / 2.0;
    private property <float> pointer-y: root.frame-height * 1.0 / 2.0;
    // Real cursor position in frame pixels for the capture being armed. -1
    // means the platform could not read it; the selector then starts centered.
    in property <float> initial-pointer-x: -1;
    in property <float> initial-pointer-y: -1;
    // Window rectangle the current on-demand detection snapped to. A later
    // element answer only refines the selection while the user has not moved
    // or resized it in the meantime.
    private property <float> detect-base-x: 0;
    private property <float> detect-base-y: 0;
    private property <float> detect-base-w: 0;
    private property <float> detect-base-h: 0;
    // Selection size in real screen pixels, which is what the user cares about
    // when framing a screenshot.
    private property <int> dim-w: round(root.sel-w * root.frame-width / root.view-width);
    private property <int> dim-h: round(root.sel-h * root.frame-height / root.view-height);

    function to-frame-x(value: float) -> int { return round(value * root.frame-width / root.view-width); }
    function to-frame-y(value: float) -> int { return round(value * root.frame-height / root.view-height); }
    function to-view-x(value: int) -> float { return value * root.view-width / max(1, root.frame-width); }
    function to-view-y(value: int) -> float { return value * root.view-height / max(1, root.frame-height); }

    function reset-selection() { root.sel-x = 0; root.sel-y = 0; root.sel-w = 0; root.sel-h = 0; }

    function reset-hover() {
        root.hover-x = 0;
        root.hover-y = 0;
        root.hover-w = 0;
        root.hover-h = 0;
    }

    /// Ask Rust which window (or nested child) is under a frame pixel and keep
    /// it in logical coordinates.
    function hover-at(x: float, y: float) {
        let region = root.region-at(root.to-frame-x(x), root.to-frame-y(y));
        let window-x = root.to-view-x(region.x);
        let window-y = root.to-view-y(region.y);
        let window-w = root.to-view-x(region.w);
        let window-h = root.to-view-y(region.h);
        // A refined control outline survives small moves inside it, so the
        // highlight does not jump back to the whole window on every pixel. The
        // next probe replaces it once the pointer leaves the control, and a
        // different window under the pointer always starts from that window.
        let same-window = abs(window-x - root.hover-base-x) < 1 && abs(window-y - root.hover-base-y) < 1 && abs(window-w - root.hover-base-w) < 1 && abs(window-h - root.hover-base-h) < 1;
        if same-window && root.hovering && window-w > 0 && window-h > 0 && x >= root.hover-x && x <= root.hover-x + root.hover-w && y >= root.hover-y && y <= root.hover-y + root.hover-h {
            return;
        }
        root.hover-base-x = window-x;
        root.hover-base-y = window-y;
        root.hover-base-w = window-w;
        root.hover-base-h = window-h;
        root.hover-x = window-x;
        root.hover-y = window-y;
        root.hover-w = window-w;
        root.hover-h = window-h;
    }

    /// Snap the selection to the window under the pointer. This runs once per
    /// key press instead of on every pointer move: Rust collects the window
    /// tree lazily and UI Automation refines the rectangle asynchronously, so
    /// the selector stays responsive even over a busy application.
    function detect-at-pointer() {
        if root.mode != 0 { return; }
        let fx = round(root.pointer-x);
        let fy = round(root.pointer-y);
        let region = root.region-at(fx, fy);
        if region.w < 8 || region.h < 8 { return; }
        root.sel-x = root.to-view-x(region.x);
        root.sel-y = root.to-view-y(region.y);
        root.sel-w = root.to-view-x(region.w);
        root.sel-h = root.to-view-y(region.h);
        root.detect-base-x = root.sel-x;
        root.detect-base-y = root.sel-y;
        root.detect-base-w = root.sel-w;
        root.detect-base-h = root.sel-h;
        root.probe-generation += 1;
        root.probe-x = root.pointer-x;
        root.probe-y = root.pointer-y;
        root.probe-at(fx, fy, root.probe-generation);
    }

    /// Replace the window snapped by the detection key with the control UI
    /// Automation found at the same point. A stale generation, a drag or resize
    /// since the snap, or an element outside the detected window is ignored, so
    /// the window rectangle remains the stable fallback.
    public function apply-probe(gen: int, x: int, y: int, w: int, h: int) {
        if gen != root.probe-generation { return; }
        if root.mode != 0 || !root.has-selection { return; }
        if abs(root.sel-x - root.detect-base-x) > 1 || abs(root.sel-y - root.detect-base-y) > 1 || abs(root.sel-w - root.detect-base-w) > 1 || abs(root.sel-h - root.detect-base-h) > 1 { return; }
        if w < 8 || h < 8 { return; }
        let vx = root.to-view-x(x);
        let vy = root.to-view-y(y);
        let vw = root.to-view-x(w);
        let vh = root.to-view-y(h);
        if vx < root.detect-base-x - 4 || vy < root.detect-base-y - 4 { return; }
        if vx + vw > root.detect-base-x + root.detect-base-w + 4 { return; }
        if vy + vh > root.detect-base-y + root.detect-base-h + 4 { return; }
        // Different providers round the same edge differently (UIA often
        // reports one pixel more than the DWM frame), so trim the answer to the
        // window instead of rejecting it or letting the selection grow.
        let l = max(vx, root.detect-base-x);
        let t = max(vy, root.detect-base-y);
        let r = min(vx + vw, root.detect-base-x + root.detect-base-w);
        let b = min(vy + vh, root.detect-base-y + root.detect-base-h);
        if r - l < 8 || b - t < 8 { return; }
        root.sel-x = l;
        root.sel-y = t;
        root.sel-w = r - l;
        root.sel-h = b - t;
    }

    /// Stop the element probe timer when the selector closes.
    public function disarm() { probe-timer.running = false; }

    /// Drop every piece of state a previous capture left behind. Rust calls
    /// this whenever the reused selector window is armed with a new frame.
    public function arm() {
        root.mode = 0;
        root.edge = 0;
        root.cursor-edge = 0;
        root.probe-generation = 0;
        root.probed-generation = 0;
        probe-timer.running = root.auto-detect;
        root.moved-away = false;
        root.anchor-x = 0;
        root.anchor-y = 0;
        root.press-x = 0;
        root.press-y = 0;
        root.base-x = 0;
        root.base-y = 0;
        root.base-w = 0;
        root.base-h = 0;
        root.detect-base-x = 0;
        root.detect-base-y = 0;
        root.detect-base-w = 0;
        root.detect-base-h = 0;
        root.pointer-x = root.initial-pointer-x >= 0 ? root.initial-pointer-x : root.frame-width * 1.0 / 2.0;
        root.pointer-y = root.initial-pointer-y >= 0 ? root.initial-pointer-y : root.frame-height * 1.0 / 2.0;
        root.reset-hover();
        root.reset-selection();
    }

    /// Edge under the pointer. `9` means the pointer is inside the selection
    /// (move), `0` means outside it (start a new region).
    function hit-at(x: float, y: float) -> int {
        if !root.has-selection { return 0; }
        let l = root.sel-x;
        let r = root.sel-x + root.sel-w;
        let t = root.sel-y;
        let b = root.sel-y + root.sel-h;
        let band = root.handle-band;
        if x < l - band || x > r + band || y < t - band || y > b + band { return 0; }
        // A side narrower than two bands cannot say which of its edges was
        // meant; treat it as body so the selection can still be moved.
        let wide = root.sel-w > band * 2;
        let tall = root.sel-h > band * 2;
        let near-l = wide && abs(x - l) <= band;
        let near-r = wide && abs(x - r) <= band;
        let near-t = tall && abs(y - t) <= band;
        let near-b = tall && abs(y - b) <= band;
        if near-l && near-t { return 5; }
        if near-r && near-t { return 6; }
        if near-l && near-b { return 7; }
        if near-r && near-b { return 8; }
        if near-l { return 1; }
        if near-r { return 2; }
        if near-t { return 3; }
        if near-b { return 4; }
        if x > l && x < r && y > t && y < b { return 9; }
        return 0;
    }

    function begin-drag(x: float, y: float) {
        root.press-x = x;
        root.press-y = y;
        root.base-x = root.sel-x;
        root.base-y = root.sel-y;
        root.base-w = root.sel-w;
        root.base-h = root.sel-h;
        root.anchor-x = x;
        root.anchor-y = y;
        root.moved-away = false;
        let hit = root.hit-at(x, y);
        root.edge = hit;
        if hit == 9 {
            root.mode = 2;
        } else if hit != 0 {
            root.mode = 3;
        } else {
            // Free region from scratch, or from a click that will become a
            // window selection on release.
            root.mode = 1;
            root.reset-selection();
            root.sel-x = x;
            root.sel-y = y;
        }
    }

    function drag-to(x: float, y: float) {
        if root.mode == 1 {
            root.sel-x = min(root.anchor-x, x);
            root.sel-y = min(root.anchor-y, y);
            root.sel-w = abs(root.anchor-x - x);
            root.sel-h = abs(root.anchor-y - y);
            if root.sel-w > 5 || root.sel-h > 5 { root.moved-away = true; }
        } else if root.mode == 2 {
            root.sel-x = (root.base-x + x - root.press-x).clamp(0, root.view-width - root.base-w);
            root.sel-y = (root.base-y + y - root.press-y).clamp(0, root.view-height - root.base-h);
        } else if root.mode == 3 {
            root.resize-to(x, y);
        }
    }

    function resize-to(x: float, y: float) {
        let l0 = root.base-x;
        let r0 = root.base-x + root.base-w;
        let t0 = root.base-y;
        let b0 = root.base-y + root.base-h;
        let dx = x - root.press-x;
        let dy = y - root.press-y;
        let minimum = 4;
        // Slint locals are immutable, so each edge is chosen in one expression:
        // the pulled edge follows the pointer (clamped), the opposite one stays
        // where the drag started.
        let l = (root.edge == 1 || root.edge == 5 || root.edge == 7) ? (l0 + dx).clamp(0, r0 - minimum) : l0;
        let r = (root.edge == 2 || root.edge == 6 || root.edge == 8) ? (r0 + dx).clamp(l0 + minimum, root.view-width) : r0;
        let t = (root.edge == 3 || root.edge == 5 || root.edge == 6) ? (t0 + dy).clamp(0, b0 - minimum) : t0;
        let b = (root.edge == 4 || root.edge == 7 || root.edge == 8) ? (b0 + dy).clamp(t0 + minimum, root.view-height) : b0;
        root.sel-x = l;
        root.sel-y = t;
        root.sel-w = r - l;
        root.sel-h = b - t;
    }

    function end-drag(x: float, y: float) {
        if root.mode == 1 {
            if root.moved-away {
                if root.sel-w < 4 || root.sel-h < 4 {
                    root.reset-selection();
                    root.reset-hover();
                }
            } else if root.auto-detect {
                // A press without movement is the auto-detect click: use what
                // the outline shows, which may already be a control refined by
                // the element probe, and fall back to the window under the
                // pointer when nothing is outlined.
                if root.hovering && x >= root.hover-x && x <= root.hover-x + root.hover-w && y >= root.hover-y && y <= root.hover-y + root.hover-h {
                    root.sel-x = root.hover-x;
                    root.sel-y = root.hover-y;
                    root.sel-w = root.hover-w;
                    root.sel-h = root.hover-h;
                    root.reset-hover();
                } else {
                    let region = root.region-at(root.to-frame-x(x), root.to-frame-y(y));
                    if region.w > 0 && region.h > 0 {
                        root.sel-x = root.to-view-x(region.x);
                        root.sel-y = root.to-view-y(region.y);
                        root.sel-w = root.to-view-x(region.w);
                        root.sel-h = root.to-view-y(region.h);
                        root.reset-hover();
                    } else {
                        root.reset-selection();
                        root.reset-hover();
                    }
                }
            }
        }
        root.mode = 0;
        root.edge = 0;
        root.cursor-edge = root.hit-at(x, y);
    }

    function nudge(dx: int, dy: int, big: bool) {
        if root.has-selection && root.mode == 0 {
            // One physical screen pixel, so the nudge is invisible at 100%
            // and still exact on scaled displays.
            let step-x = (big ? 10 : 1) * root.view-width / max(1, root.frame-width);
            let step-y = (big ? 10 : 1) * root.view-height / max(1, root.frame-height);
            root.sel-x = (root.sel-x + dx * step-x).clamp(0, root.view-width - root.sel-w);
            root.sel-y = (root.sel-y + dy * step-y).clamp(0, root.view-height - root.sel-h);
        }
    }

    function cursor-kind() -> MouseCursor {
        if root.mode == 2 { return MouseCursor.move; }
        if root.mode == 1 { return MouseCursor.crosshair; }
        let grip = root.mode == 3 ? root.edge : root.cursor-edge;
        if grip == 1 { return MouseCursor.w-resize; }
        if grip == 2 { return MouseCursor.e-resize; }
        if grip == 3 { return MouseCursor.n-resize; }
        if grip == 4 { return MouseCursor.s-resize; }
        if grip == 5 { return MouseCursor.nw-resize; }
        if grip == 6 { return MouseCursor.ne-resize; }
        if grip == 7 { return MouseCursor.sw-resize; }
        if grip == 8 { return MouseCursor.se-resize; }
        if grip == 9 { return MouseCursor.move; }
        return MouseCursor.crosshair;
    }

    function finish() {
        if root.has-selection {
            let left = root.to-frame-x(root.sel-x);
            let top = root.to-frame-y(root.sel-y);
            let right = root.to-frame-x(root.sel-x + root.sel-w);
            let bottom = root.to-frame-y(root.sel-y + root.sel-h);
            root.confirmed(left, top, right - left, bottom - top);
        }
    }
    function select-all() { root.sel-x = 0; root.sel-y = 0; root.sel-w = root.view-width; root.sel-h = root.view-height; root.finish(); }

    Image { width: parent.width; height: parent.height; source: root.screen-image; image-fit: fill; }
    Rectangle { background: #00000092; }
    // The window or control a click would select. A thin outline is enough:
    // filling it would hide the very pixels the user is judging.
    if !root.has-selection && root.mode == 0 && root.auto-detect && root.hovering : Rectangle {
        x: root.hover-x * 1px; y: root.hover-y * 1px;
        width: max(1px, root.hover-w * 1px); height: max(1px, root.hover-h * 1px);
        background: #ffffff10;
        border-width: 2px;
        border-color: Theme.accent-ink;
    }
    // Restore original pixels inside the selection for a faithful preview.
    if root.has-selection : Rectangle {
        x: root.sel-x * 1px; y: root.sel-y * 1px; width: root.sel-w * 1px; height: root.sel-h * 1px; clip: true;
        Image { x: -(root.sel-x * 1px); y: -(root.sel-y * 1px); width: root.width; height: root.height; source: root.screen-image; image-fit: fill; }
        Rectangle { background: transparent; border-width: 2px; border-color: Theme.accent-ink; }
    }
    // Eight grips: four corners plus the middle of each edge once the side is
    // wide enough to place them without overlap.
    if root.has-selection && root.mode != 1 : Rectangle {
        SelectionHandle { x: root.sel-x * 1px - 4px; y: root.sel-y * 1px - 4px; }
        SelectionHandle { x: (root.sel-x + root.sel-w) * 1px - 4px; y: root.sel-y * 1px - 4px; }
        SelectionHandle { x: root.sel-x * 1px - 4px; y: (root.sel-y + root.sel-h) * 1px - 4px; }
        SelectionHandle { x: (root.sel-x + root.sel-w) * 1px - 4px; y: (root.sel-y + root.sel-h) * 1px - 4px; }
        if root.sel-w > 24 : SelectionHandle { x: (root.sel-x + root.sel-w / 2) * 1px - 4px; y: root.sel-y * 1px - 4px; }
        if root.sel-w > 24 : SelectionHandle { x: (root.sel-x + root.sel-w / 2) * 1px - 4px; y: (root.sel-y + root.sel-h) * 1px - 4px; }
        if root.sel-h > 24 : SelectionHandle { x: root.sel-x * 1px - 4px; y: (root.sel-y + root.sel-h / 2) * 1px - 4px; }
        if root.sel-h > 24 : SelectionHandle { x: (root.sel-x + root.sel-w) * 1px - 4px; y: (root.sel-y + root.sel-h / 2) * 1px - 4px; }
    }
    // Live size readout in real screen pixels.
    if root.has-selection && root.mode != 1 : Rectangle {
        x: (root.sel-x * 1px + 12px).clamp(4px, root.width - 96px);
        y: (root.sel-y * 1px + 12px).clamp(4px, root.height - 26px);
        width: 92px; height: 22px; border-radius: 4px; background: #000000cc;
        Text {
            text: "\{root.dim-w} × \{root.dim-h}";
            color: #ffffff; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    // Throttle the cross-process element probe to a stable-ish pointer: at most
    // one request per tick, always for the newest position. The timer only runs
    // while the selector is open.
    probe-timer := Timer {
        interval: 40ms;
        running: false;
        triggered => {
            if root.auto-detect && root.mode == 0 && !root.has-selection && root.hovering && root.probe-generation != root.probed-generation {
                root.probed-generation = root.probe-generation;
                root.probe-at(root.to-frame-x(root.probe-x), root.to-frame-y(root.probe-y), root.probe-generation);
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.cursor-kind();
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.begin-drag(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.end-drag(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.canceled();
            } else if event.kind == PointerEventKind.move {
                let x = self.mouse-x / 1px;
                let y = self.mouse-y / 1px;
                root.pointer-x = root.to-frame-x(x);
                root.pointer-y = root.to-frame-y(y);
                if root.mode == 0 {
                    if root.has-selection {
                        // Keep the window under the pointer current even with
                        // a selection: a click outside it starts a new one and
                        // must not reuse an old highlight.
                        if root.auto-detect { root.hover-at(x, y); }
                        root.cursor-edge = root.hit-at(x, y);
                    } else {
                        root.cursor-edge = 0;
                        if root.auto-detect {
                            root.hover-at(x, y);
                            root.probe-x = root.pointer-x;
                            root.probe-y = root.pointer-y;
                            root.probe-generation += 1;
                        }
                    }
                } else {
                    root.drag-to(x, y);
                }
            } else if event.kind == PointerEventKind.cancel {
                // A lost grab must not leave the selector stuck mid-drag.
                root.mode = 0;
                root.edge = 0;
            }
        }
        double-clicked => {
            if root.has-selection && root.mode == 0 { root.finish(); }
        }
        // Slint reports no "pointer left the window" pointer event, so drop the
        // window highlight when hover ends instead of leaving it outlined on a
        // screen the pointer has already left (a second monitor, for example).
        changed has-hover => {
            if !self.has-hover && root.mode == 0 {
                root.reset-hover();
                root.cursor-edge = 0;
            }
        }
    }
    if root.mode == 0 : Rectangle {
        x: (parent.width - min(640px, parent.width - 32px)) / 2; y: 24px;
        width: min(640px, parent.width - 32px); height: 32px; border-radius: 6px; background: #000000b8;
        Text { text: root.has-selection ? I18n.so_adjust_hint : I18n.so_hint; color: #ffffff; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.has-selection && root.mode == 0 : Rectangle {
        x: ((root.sel-x + root.sel-w) * 1px - 198px).clamp(4px, root.width - 202px);
        // Put the action row below the selection when there is room, otherwise
        // flip it above. A selection hugging the bottom edge (the taskbar, for
        // example) must not be hidden behind the row.
        y: ((root.sel-y + root.sel-h) * 1px + 42px > root.height - 4px)
            ? max(4px, root.sel-y * 1px - 42px)
            : (root.sel-y + root.sel-h) * 1px + 8px;
        width: 198px; height: 34px; border-radius: 7px; background: #282828ee;
        // Sits between the buttons so a press on the panel background does not
        // reach the selector's full-window TouchArea and move the selection.
        TouchArea { mouse-cursor: MouseCursor.default; }
        HorizontalLayout { padding-left: 4px; padding-right: 4px; padding-top: 3px; padding-bottom: 3px; spacing: 5px;
            OverlayButton { label: I18n.so_fullscreen; triggered => { root.select-all(); } }
            OverlayButton { label: I18n.common_done; primary: true; triggered => { root.finish(); } }
            OverlayButton { label: I18n.common_cancel; triggered => { root.canceled(); } }
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.canceled(); accept }
            else if root.mode == 0 && event.text == " " { root.detect-at-pointer(); accept }
            else if event.text == Key.Return && root.has-selection && root.mode == 0 { root.finish(); accept }
            else if root.has-selection && root.mode == 0 && event.text == Key.LeftArrow { root.nudge(-1, 0, event.modifiers.shift); accept }
            else if root.has-selection && root.mode == 0 && event.text == Key.RightArrow { root.nudge(1, 0, event.modifiers.shift); accept }
            else if root.has-selection && root.mode == 0 && event.text == Key.UpArrow { root.nudge(0, -1, event.modifiers.shift); accept }
            else if root.has-selection && root.mode == 0 && event.text == Key.DownArrow { root.nudge(0, 1, event.modifiers.shift); accept }
            else { reject }
        }
    }
}
