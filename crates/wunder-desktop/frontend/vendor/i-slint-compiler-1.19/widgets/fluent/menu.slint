import { FluentPalette, FluentFontSettings } from "styling.slint";
import { MenuBarItemBase, MenuBarBase, MenuFrameBase, MenuItemBase } from "../common/menu-base.slint";

export component MenuBarItem {
    in property <MenuEntry> entry <=> base.entry;

    callback clicked <=> base.clicked;
    callback hovered <=> base.hovered;

    min-width: base.min-width;
    min-height: base.min-height;

    base := MenuBarItemBase {
        horizontal-padding: 11px;
        top-padding: 4px;
        bottom-padding: 6px;
        default-foreground: FluentPalette.foreground;
        hover-foreground: FluentPalette.foreground;
        pressed-foreground: FluentPalette.text-secondary;
        hover-background: FluentPalette.subtle-secondary;
        pressed-background: FluentPalette.control-alt-tertiary;
        border-radius: 3px;
    }
}

export component MenuBar inherits MenuBarBase {
    spacing: 10px;
    min-layout-height: 40px;
}

// Workbench override: the popup menu is drawn inside the window, so it has to
// read like the app's own cards (ui/text_menu.slint) rather than like a
// full-size Fluent surface. Same surface, hairline, radius, shadow, row height
// and 13 px label as that menu; the colours mirror ui/design_tokens.slint.
export component MenuFrame inherits MenuFrameBase {
    background: #FFFFFF;
    border-radius: 10px;
    border-width: 1px;
    border-color: #D7DBE0;
    drop-shadow-color: #00000030;
    drop-shadow-offset-y: 3px;
    drop-shadow-blur: 12px;
    margin: 4px;
    layout-min-width: 148px;
}

export component MenuItem {
    in property <bool> is-current <=> base.is-current;
    in property <MenuEntry> entry <=> base.entry;

    callback set-current <=> base.set-current;
    callback clear-current <=> base.clear-current;
    callback activate <=> base.activate;

    min-height: entry.is-separator ? 7px : max(28px, base.min-height);
    max-height: entry.is-separator ? 7px : base.max-height;

    HorizontalLayout {
        padding: entry.is-separator ? 3px : 1px;
        padding-left: entry.is-separator ? 0px : 1px;
        padding-right: entry.is-separator ? 0px : 1px;

        base := MenuItemBase {
            default-foreground: #202124;
            alternate-foreground: #8A919B;
            current-foreground: #202124;
            current-background: #F5F6F7;
            separator-color: #E5E7EB;
            border-radius: 8px;
            horizontal-padding: 10px;
            spacing: 8px;
            font-size: 13px;
            sub-menu-icon: @image-url("_arrow_forward.svg");
            icon-size: 12px;
        }
    }
}
