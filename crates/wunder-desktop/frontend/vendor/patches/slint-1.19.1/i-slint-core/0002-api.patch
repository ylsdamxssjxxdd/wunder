+    /// Chooses whether context menus are handed to the platform or drawn by Slint.
+    ///
+    /// A native Win32 menu runs `TrackPopupMenu`, a modal message loop on the UI
+    /// thread: while it is open the event loop is borrowed, so no frame is drawn
+    /// and no timer fires — a streaming transcript or an animation freezes behind
+    /// the menu until the user dismisses it. Slint's own popup keeps the regular
+    /// event loop and repaints the window underneath.
+    ///
+    /// Defaults to `true` (native menus).
+    pub fn set_native_popup_menus_enabled(&self, enabled: bool) {
+        self.0.native_popup_menus_enabled.set(enabled);
+    }
+
