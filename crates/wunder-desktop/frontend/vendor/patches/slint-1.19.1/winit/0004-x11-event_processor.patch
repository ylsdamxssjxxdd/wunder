+        const MAX_PENDING: usize = 256;
+        const MAX_AGE: Duration = Duration::from_millis(1500);
+        let now = Instant::now();
+        while let Some(front) = self.raw_key_pendings.front() {
+            if now.duration_since(front.at) > MAX_AGE {
