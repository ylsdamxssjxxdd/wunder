+/// can skip constructing a `VectorFont` only to pick the rendering path.
+#[cfg(feature = "systemfonts")]
+pub(crate) fn has_bitmap_fonts() -> bool {
+    BITMAP_FONTS.with(|fonts| !fonts.borrow().is_empty())
