-        GlyphAlphaMap::Static(&font.glyphs[glyph_set].glyph_data[glyph].data)
+        let glyph = &font.glyphs[glyph_set].glyph_data[glyph];
+        match decoded_glyph_data(glyph) {
+            Some(decoded) => GlyphAlphaMap::Rendered(alloc::rc::Rc::from(decoded)),
+            None => GlyphAlphaMap::Static(&glyph.data),
+        }
     }
 }
 
