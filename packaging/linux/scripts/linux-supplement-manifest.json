{
  "packageName": "wunder-supplement",
  "defaultBuildRoot": "temp_dir/linux-supplement",
  "downloadsDir": "downloads",
  "stageDir": "stage",
  "distDir": "dist",
  "layout": {
    "pythonRoot": "opt/python",
    "gitRoot": "opt/git",
    "rgRoot": "opt/rg",
    "ffmpegRoot": "opt/ffmpeg",
    "nodeRoot": "opt/node",
    "remotionRoot": "opt/remotion",
    "browserRoot": "opt/browser"
  },
  "node": {
    "version": "16.20.2",
    "source": "nodejs.org Linux tarball",
    "archives": {
      "amd64": {
        "fileName": "node-v16.20.2-linux-x64.tar.gz",
        "url": "https://nodejs.org/dist/v16.20.2/node-v16.20.2-linux-x64.tar.gz",
        "sha256": "c9193e6c414891694759febe846f4f023bf48410a6924a8b1520c46565859665",
        "elfMachine": "x86-64"
      },
      "arm64": {
        "fileName": "node-v16.20.2-linux-arm64.tar.gz",
        "url": "https://nodejs.org/dist/v16.20.2/node-v16.20.2-linux-arm64.tar.gz",
        "sha256": "b6945fcc9ad220386bb814bfae7137189fd17297f2959a744105e1bee006035a",
        "elfMachine": "AArch64"
      }
    }
  },
  "remotion": {
    "version": "4.0.538",
    "reactVersion": "19.2.3",
    "esbuildVersion": "0.28.1",
    "packages": {
      "@remotion/cli": "4.0.538",
      "remotion": "4.0.538",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "compositorPackages": {
      "amd64": "@remotion/compositor-linux-x64-gnu",
      "arm64": "@remotion/compositor-linux-arm64-gnu"
    },
    "browser": {
      "install": true,
      "pathFile": "browser-path"
    },
    "notes": [
      "The CLI installs Studio, bundler, renderer and the matching native compositor. It is staged with the same Node major as the Docker runtime.",
      "The package includes Remotion's Chrome Headless Shell so Studio and renderer commands work offline; Playwright Chromium remains available separately for browser tools."
    ]
  },
  "browser": {
    "name": "Chromium-family offline browser",
    "version": "122.0.6261.111 / 120.0.6099.28",
    "source": "Chrome for Testing and Playwright official archives",
    "install": true,
    "executable": "chrome-linux64/chrome",
    "archives": {
      "amd64": {
        "fileName": "chrome-122.0.6261.111-linux64.zip",
        "url": "https://storage.googleapis.com/chrome-for-testing-public/122.0.6261.111/linux64/chrome-linux64.zip",
        "sha256": "b059c80216abd74f25a35c08c6ad601a30dfdb09588af27828a9bc7adde65bd3",
        "elfMachine": "x86-64",
        "executable": "chrome-linux64/chrome",
        "browserVersion": "122.0.6261.111"
      },
      "arm64": {
        "fileName": "chromium-120.0.6099.28-linux-arm64.zip",
        "url": "https://cdn.playwright.dev/builds/chromium/1091/chromium-linux-arm64.zip",
        "sha256": "ef686d543ddf32d5d9cc38e1fead33565ef4e4c537d67aa5d6a99f327fbcf351",
        "elfMachine": "AArch64",
        "executable": "chrome-linux/chrome",
        "browserName": "Chromium",
        "browserVersion": "120.0.6099.28"
      }
    },
    "notes": [
      "amd64 includes the official Chrome for Testing 122 Linux archive under opt/browser.",
      "arm64 uses the Playwright Chromium revision 1091 linux-arm64 archive, staged under opt/browser and usable offline."
    ]
  },
  "runtime": {
    "baseMinimumGlibc": "2.17",
    "compositorMinimumGlibc": "2.27",
    "browserMinimumGlibc": "2.17",
    "remotionMinimumGlibc": "2.27",
    "baseBuilder": "ubuntu:18.04",
    "remotionBuilder": "ubuntu:22.04"
  },
  "python": {
    "version": "3.8.18",
    "flavor": "python-build-standalone install_only",
    "source": "astral-sh/python-build-standalone",
    "releaseTag": "20240107",
    "defaultPackageIndexUrl": "https://pypi.tuna.tsinghua.edu.cn/simple",
    "getPipUrl": "https://bootstrap.pypa.io/pip/3.8/get-pip.py",
    "requirementsPath": "packaging/python/requirements-linux-common.txt",
    "installBrowser": true,
    "browsersPath": "opt/python/ms-playwright",
    "notes": [
      "Python 3.8 matches the Win7 supplement so agent code behaves identically on every desktop platform.",
      "python-build-standalone gnu builds target glibc 2.17, well below the Ubuntu 18.04 (glibc 2.27) release baseline.",
      "Binary wheels only (--only-binary=:all:) so no compiler toolchain is needed on user machines.",
      "The 20240107 release is the last python-build-standalone tag that ships CPython 3.8.",
      "Playwright powers the browser_* tools; the pinned pip driver lives in requirements-linux-common.txt and installBrowser downloads Chromium into opt/python/ms-playwright so browser tasks run offline.",
      "browser_bridge.py auto-detects opt/python/ms-playwright next to the interpreter, so no extra runtime configuration is required; override with browser.playwright.browsers_path only if the browsers are relocated."
    ],
    "validateImports": [
      "requests",
      "numpy",
      "capstone",
      "pandas",
      "openpyxl",
      "matplotlib",
      "tabulate",
      "PIL",
      "docx",
      "pptx",
      "PyPDF2",
      "xlrd",
      "xlsxwriter",
      "sqlalchemy",
      "pymysql",
      "aiosqlite",
      "lxml.etree",
      "ffmpeg",
      "imageio",
      "cv2",
      "h5py",
      "seaborn",
      "pyecharts",
      "playwright"
    ],
    "archives": {
      "amd64": {
        "fileName": "cpython-3.8.18+20240107-x86_64-unknown-linux-gnu-install_only.tar.gz",
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20240107/cpython-3.8.18+20240107-x86_64-unknown-linux-gnu-install_only.tar.gz",
        "elfMachine": "x86-64"
      },
      "arm64": {
        "fileName": "cpython-3.8.18+20240107-aarch64-unknown-linux-gnu-install_only.tar.gz",
        "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20240107/cpython-3.8.18+20240107-aarch64-unknown-linux-gnu-install_only.tar.gz",
        "elfMachine": "AArch64"
      }
    },
    "plotProbe": true
  },
  "git": {
    "version": "2.46.2",
    "flavor": "git source build",
    "source": "kernel.org",
    "notes": [
      "Built from source inside an Ubuntu 18.04 container so the bundled libcurl/zlib/openssl closure matches the desktop release baseline.",
      "Built with NO_GETTEXT/NO_TCLTK/NO_PERL/NO_PYTHON to keep the embedded tree minimal; clone/status/apply/https support is retained."
    ],
    "tarball": {
      "fileName": "git-2.46.2.tar.gz",
      "url": "https://www.kernel.org/pub/software/scm/git/git-2.46.2.tar.gz",
      "sha256": "65c5689fd44f1d09de7fd8c44de7fef074ddd69dda8b8503d44afb91495ecbce"
    }
  },
  "rg": {
    "version": "14.1.1",
    "flavor": "ripgrep official binary",
    "source": "BurntSushi/ripgrep",
    "notes": [
      "amd64 uses the static musl build; arm64 uses the official gnu build (no musl asset is published for aarch64)."
    ],
    "archives": {
      "amd64": {
        "fileName": "ripgrep-14.1.1-x86_64-unknown-linux-musl.tar.gz",
        "url": "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-x86_64-unknown-linux-musl.tar.gz",
        "elfMachine": "x86-64"
      },
      "arm64": {
        "fileName": "ripgrep-14.1.1-aarch64-unknown-linux-gnu.tar.gz",
        "url": "https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-aarch64-unknown-linux-gnu.tar.gz",
        "elfMachine": "AArch64"
      }
    }
  },
  "ffmpeg": {
    "version": "4.4.1",
    "flavor": "ffmpeg-static prebuilt",
    "source": "eugeneware/ffmpeg-static",
    "releaseTag": "b4.4.1",
    "notes": [
      "Same upstream source and version as the Win7 supplement so media handling behaves identically on every desktop platform.",
      "Upstream ships gzipped single-binary builds that decompress to a static ffmpeg; only ffmpeg is bundled (no ffprobe), matching the Win7 pack.",
      "Self-contained static builds, so the same archive runs on the Ubuntu 18.04 (glibc 2.27) baseline and on the arm64 pack alike."
    ],
    "archives": {
      "amd64": {
        "fileName": "ffmpeg-b4.4.1-linux-x64.gz",
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b4.4.1/linux-x64.gz",
        "sha256": "e8eb59e6d519eef28e571111dbc200a2c58a4d17be5f3f7eac41fb066d3f1a0f",
        "elfMachine": "x86-64"
      },
      "arm64": {
        "fileName": "ffmpeg-b4.4.1-linux-arm64.gz",
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b4.4.1/linux-arm64.gz",
        "sha256": "c4633e344b2c8e8a38990821a4c27eb956425d5fabc349f526a2bd2eb3eb791c",
        "elfMachine": "AArch64"
      }
    }
  },
  "fonts": [
    "NotoSansSC-VF.ttf",
    "msyh.ttc",
    "simsun.ttc",
    "simhei.ttf",
    "arial.ttf"
  ],
  "install": {
    "extractInto": "desktop install root (Win7-style install dir) or the directory holding the .AppImage file",
    "pythonRoot": "opt/python",
    "gitRoot": "opt/git",
    "rgRoot": "opt/rg",
    "ffmpegRoot": "opt/ffmpeg",
    "nodeRoot": "opt/node",
    "remotionRoot": "opt/remotion",
    "browserRoot": "opt/browser"
  },
  "r2": {
    "version": "6.2.4",
    "flavor": "radare2 hand-prepared archive",
    "source": "radareorg/radare2",
    "notes": [
      "radare2 console disassembler toolkit, staged into opt/r2 so the runtime prepends opt/r2/bin to PATH.",
      "No prebuilt Linux archive ships in the manifest: distro debs target newer glibc than Ubuntu 18.04 (official 6.x needs glibc 2.35). Feed a hand-prepared payload via WUNDER_SUPPLEMENT_R2_ARCHIVE: a static single-file r2 binary (staged as opt/r2/bin/radare2 with an r2 symlink) or a tarball/zip flattened into opt/r2 providing bin/radare2; without it the supplement ships without r2."
    ],
    "layout": {
      "dest": "opt/r2",
      "expectedExe": "bin/radare2"
    },
    "archives": {
      "amd64": null,
      "arm64": null
    }
  }
}
