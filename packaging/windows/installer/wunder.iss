; Wunder per-user installer.
;
; The optional component tasks and every [Files] entry are generated by
; builders/pack.ps1 into payload.generated.iss. Only components present in the
; supplement archive selected at pack time are offered, so this script stays
; independent of the supplement build matrix.

#define AppName "心舰 Wunder"
#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef VersionInfoVersion
  #define VersionInfoVersion "0.0.0.0"
#endif
#ifndef OutputBaseFilename
  #define OutputBaseFilename "wunder-setup"
#endif
#ifndef PackCompression
  #define PackCompression lzma2/normal
#endif
#ifndef ComponentsShown
  #define ComponentsShown 0
#endif

[Setup]
AppId={{6F1B0C8D-3A7E-4B5A-9C2D-7E8F1A3B5C90}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=wunder
DefaultDirName={%USERPROFILE}\.wunder
; auto (the Inno default) skips this page once a previous install is found in
; the registry; the install dir doubles as WUNDER_HOME, so always ask.
DisableDirPage=no
DefaultGroupName=心舰
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
UsePreviousAppDir=yes
OutputDir=.
OutputBaseFilename={#OutputBaseFilename}
SetupIconFile=pupa.ico
; The pupa mark in the wizard pages' upper right corner (transparent PNG).
WizardSmallImageFile=pupa.png
UninstallDisplayIcon={app}\bin\wunder-desktop.exe
UninstallDisplayName={#AppName} {#AppVersion}
Compression={#PackCompression}
SolidCompression=yes
LZMANumBlockThreads=4
WizardStyle=classic light
; 100 is the smallest Inno Setup allows (valid range 100-150); keeps the
; wizard as compact as possible.
WizardSizePercent=100,100
; No big left banner on the welcome/completed pages; the pupa mark lives in
; the header's upper right corner (WizardSmallImageFile above).
WizardImageFile=
MinVersion=6.1sp1
ArchitecturesAllowed=x86compatible
CloseApplications=yes
RestartApplications=no
SetupLogging=yes
ChangesEnvironment=yes
VersionInfoVersion={#VersionInfoVersion}
VersionInfoProductName={#AppName}
VersionInfoDescription={#AppName} 安装程序

[Languages]
Name: "chinesesimplified"; MessagesFile: "ChineseSimplified.isl"

[Messages]
WelcomeLabel1=欢迎安装 [name]
WelcomeLabel2=本向导将引导您完成 [name/ver] 的安装。
WizardSelectTasks=选择安装内容
SelectTasksDesc=勾选蛹或舵机安装程序本体（勾选蛹会自动创建桌面快捷方式），组件按需勾选。
SelectTasksLabel2=
SelectDirDesc=请选择心舰的安装目录，该目录也是用户数据目录。
SelectDirLabel3=

[Icons]
; 勾选「蛹」即创建开始菜单与桌面快捷方式（不再单列快捷方式任务）；「舵机」同理。
Name: "{group}\蛹"; Filename: "{app}\bin\wunder-desktop.exe"; WorkingDir: "{app}"; Tasks: desktop
Name: "{group}\舵机"; Filename: "{app}\bin\wunder-cli.exe"; WorkingDir: "{app}\workspace"; Tasks: cli
Name: "{group}\卸载心舰"; Filename: "{uninstallexe}"
Name: "{userdesktop}\蛹"; Filename: "{app}\bin\wunder-desktop.exe"; WorkingDir: "{app}"; Tasks: desktop

[Dirs]
; bin 由可选的本体文件创建，显式声明以确保组件清单等写入目录始终存在。
Name: "{app}\bin"
Name: "{app}\workspace"

[InstallDelete]
Type: files; Name: "{app}\bin\wunder.exe"
; Older installers copied repository assets next to the binaries. The runtime
; now projects embedded assets into WUNDER_HOME, so drop the duplicate tree.
Type: filesandordirs; Name: "{app}\bin\resources"
; Older local builds created an empty sessions folder; sessions now live in
; SQLite. Only remove it when the user has not put anything there.
Type: dirifempty; Name: "{app}\sessions"
; The Remotion component (opt/node + opt/remotion) left the supplement matrix,
; so upgrades must not keep the old Node DLLs around: nothing in the runtime
; resolves them any more, and a stale 64-bit Node library inside a 32-bit pack
; only shows up when something tries to load it.
Type: filesandordirs; Name: "{app}\opt\node"
Type: filesandordirs; Name: "{app}\opt\remotion"

[Run]
Filename: "{app}\bin\wunder-desktop.exe"; Description: "启动蛹"; Flags: nowait postinstall skipifsilent; Tasks: desktop

[UninstallDelete]
Type: filesandordirs; Name: "{app}\bin"
Type: files; Name: "{app}\.wunder-home"
; Same retired component tree as in [InstallDelete]: installers that wrote it
; never recorded it in the component list, so uninstall would leave it behind.
Type: filesandordirs; Name: "{app}\opt\node"
Type: filesandordirs; Name: "{app}\opt\remotion"

#include "payload.generated.iss"

[Code]
// Keep the component list in sync with build_win7_installer.ps1: the task names
// below must cover every supplement component that script can emit (currently
// python, git, rg, ffmpeg, powershell, browser).
const
  ComponentCount = 6;
  CComponentsShown = {#ComponentsShown};

var
  ComponentTasks: array[0..5] of String;
  ComponentLabels: array[0..5] of String;
  SelectAllCheckBox: TNewCheckBox;
  UpdatingSelectAll: Boolean;

function InitializeSetup(): Boolean;
begin
  ComponentTasks[0] := 'python';
  ComponentTasks[1] := 'git';
  ComponentTasks[2] := 'rg';
  ComponentTasks[3] := 'ffmpeg';
  ComponentTasks[4] := 'powershell';
  ComponentTasks[5] := 'browser';
  ComponentLabels[0] := 'Python';
  ComponentLabels[1] := 'Git';
  ComponentLabels[2] := 'ripgrep';
  ComponentLabels[3] := 'FFmpeg';
  ComponentLabels[4] := 'PowerShell';
  ComponentLabels[5] := '内置浏览器';
  Result := True;
end;

procedure SelectAllClick(Sender: TObject);
var
  I: Integer;
begin
  if UpdatingSelectAll or (CComponentsShown <= 0) then
    Exit;
  UpdatingSelectAll := True;
  for I := 0 to WizardForm.TasksList.Items.Count - 1 do
    if WizardForm.TasksList.ItemEnabled[I] then
      WizardForm.TasksList.Checked[I] := SelectAllCheckBox.Checked;
  UpdatingSelectAll := False;
end;

procedure TasksListClickCheck(Sender: TObject);
var
  I: Integer;
  AllChecked: Boolean;
begin
  if UpdatingSelectAll or (CComponentsShown <= 0) then
    Exit;
  AllChecked := True;
  for I := 0 to WizardForm.TasksList.Items.Count - 1 do
    if WizardForm.TasksList.ItemEnabled[I] and (not WizardForm.TasksList.Checked[I]) then
    begin
      AllChecked := False;
      Break;
    end;
  UpdatingSelectAll := True;
  SelectAllCheckBox.Checked := AllChecked;
  UpdatingSelectAll := False;
end;

procedure InitializeWizard();
var
  Brand: TNewStaticText;
begin
  // Footer brand text, bottom left of the button strip.
  Brand := TNewStaticText.Create(WizardForm);
  Brand.Parent := WizardForm;
  Brand.AutoSize := False;
  Brand.Left := ScaleX(12);
  Brand.Height := ScaleY(20);
  // Stay clear of the button strip at any size/DPI: end the text before the
  // Back button and center vertically against the buttons themselves.
  Brand.Width := WizardForm.BackButton.Left - Brand.Left - ScaleX(12);
  Brand.Top := WizardForm.BackButton.Top +
    (WizardForm.BackButton.Height - Brand.Height) div 2;
  Brand.Caption := 'Wunder Desktop Installer';
  Brand.Font.Color := clGray;

  SelectAllCheckBox := TNewCheckBox.Create(WizardForm);
  SelectAllCheckBox.Parent := WizardForm.TasksList.Parent;
  SelectAllCheckBox.Caption := '全选（推荐）';
  SelectAllCheckBox.Left := WizardForm.TasksList.Left;
  SelectAllCheckBox.Width := WizardForm.TasksList.Width;
  SelectAllCheckBox.Height := ScaleY(20);
  SelectAllCheckBox.Visible := CComponentsShown > 0;
  SelectAllCheckBox.OnClick := @SelectAllClick;

  // Reserve a stable row above the owner-drawn task list. The list is moved
  // once during initialization so the select-all control does not overlap or
  // reflow the task rows.
  if CComponentsShown > 0 then
  begin
    SelectAllCheckBox.Top := WizardForm.TasksList.Top;
    WizardForm.TasksList.Top := WizardForm.TasksList.Top + ScaleY(28);
    WizardForm.TasksList.Height := WizardForm.TasksList.Height - ScaleY(28);
    WizardForm.TasksList.ParentColor := False;
    WizardForm.TasksList.Color := clWhite;
  end;

  WizardForm.TasksList.Flat := True;
  WizardForm.TasksList.OnClickCheck := @TasksListClickCheck;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = wpSelectTasks then
  begin
    TasksListClickCheck(nil);
    if CComponentsShown > 0 then
      WizardForm.ActiveControl := SelectAllCheckBox;
  end;
end;

function IsKnownComponent(const Name: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to ComponentCount - 1 do
    if CompareText(Name, ComponentTasks[I]) = 0 then
    begin
      Result := True;
      Exit;
    end;
end;

function LabelFor(const Name: String): String;
var
  I: Integer;
begin
  Result := Name;
  for I := 0 to ComponentCount - 1 do
    if CompareText(Name, ComponentTasks[I]) = 0 then
    begin
      Result := ComponentLabels[I];
      Exit;
    end;
end;

function NormalizedPathEntry(const Value: String): String;
begin
  Result := Trim(Value);
  while (Length(Result) > 1) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function ComponentDirAt(const Name: String; Index: Integer): String;
begin
  if Index = 0 then
    Result := Name
  else
    Result := '';
end;

procedure AddAppToUserPath();
var
  Current, Entry: String;
begin
  Entry := NormalizedPathEntry(ExpandConstant('{app}\bin'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', Current) then
    Current := '';
  if Pos(';' + Uppercase(Entry) + ';', ';' + Uppercase(Current) + ';') = 0 then
  begin
    if (Current <> '') and (Current[Length(Current)] <> ';') then
      Current := Current + ';';
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', Current + Entry);
  end;
end;

procedure RemoveAppFromUserPath();
var
  Current, Rest, Item, Entry, Updated: String;
  P: Integer;
  Found, First: Boolean;
begin
  Entry := NormalizedPathEntry(ExpandConstant('{app}\bin'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', Current) then
    Exit;
  Found := False;
  First := True;
  Updated := '';
  Rest := Current;
  while True do
  begin
    P := Pos(';', Rest);
    if P = 0 then
    begin
      Item := Rest;
      Rest := '';
    end
    else
    begin
      Item := Copy(Rest, 1, P - 1);
      Rest := Copy(Rest, P + 1, Length(Rest));
    end;
    if CompareText(NormalizedPathEntry(Item), Entry) = 0 then
      Found := True
    else
    begin
      if First then
        First := False
      else
        Updated := Updated + ';';
      Updated := Updated + Item;
    end;
    if P = 0 then
      Break;
  end;
  if Found then
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', Updated);
end;

function SelectedComponentList: String;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to ComponentCount - 1 do
    if WizardIsTaskSelected(ComponentTasks[I]) then
    begin
      if Result <> '' then
        Result := Result + ',';
      Result := Result + ComponentTasks[I];
    end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  I, D: Integer;
  Dir, Existing, Target: String;
begin
  if CurStep = ssInstall then
  begin
    Existing := '';
    for I := 0 to ComponentCount - 1 do
      if WizardIsTaskSelected(ComponentTasks[I]) then
        for D := 0 to ComponentCount - 1 do
        begin
          Dir := ComponentDirAt(ComponentTasks[I], D);
          if Dir = '' then
            Break;
          if DirExists(ExpandConstant('{app}\opt\' + Dir)) then
          begin
            if Existing <> '' then
              Existing := Existing + '、';
            Existing := Existing + LabelFor(ComponentTasks[I]);
            Break;
          end;
        end;

    if Existing <> '' then
    begin
      if (not WizardSilent) and
        (MsgBox('检测到已安装的组件：' + Existing + #13#10#13#10 +
          '安装程序会先清空这些组件的目录，再写入新版本。' + #13#10 +
          '配置、会话、工作区等用户数据不会被删除。是否继续？',
          mbConfirmation, MB_YESNO) = IDNO) then
        Abort;
    end;

    for I := 0 to ComponentCount - 1 do
      if WizardIsTaskSelected(ComponentTasks[I]) then
        for D := 0 to ComponentCount - 1 do
        begin
          Dir := ComponentDirAt(ComponentTasks[I], D);
          if Dir = '' then
            Break;
          Target := ExpandConstant('{app}\opt\' + Dir);
          if DirExists(Target) then
          begin
            if not DelTree(Target, True, True, True) then
            begin
              MsgBox('无法清空目录：' + Target + #13#10#13#10 +
                '请先关闭正在使用该组件的程序（心舰、舵机或组件进程）后重试。',
                mbError, MB_OK);
              Abort;
            end;
          end;
        end;
  end
  else if CurStep = ssPostInstall then
  begin
    SaveStringToFile(
      ExpandConstant('{app}\bin\wunder-install-components.txt'),
      SelectedComponentList, False);
    if WizardIsTaskSelected('desktop') then
      SaveStringToFile(
        ExpandConstant('{app}\bin\desktop.cmd'),
        '@echo off' + #13#10 + 'start "" "%~dp0wunder-desktop.exe" %*' + #13#10,
        False);
    if WizardIsTaskSelected('cli') then
      AddAppToUserPath();
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Raw: AnsiString;
  Data: String;
  Item, Dir: String;
  I, P: Integer;
begin
  if CurUninstallStep <> usUninstall then
    Exit;

  RemoveAppFromUserPath();

  if not LoadStringFromFile(
    ExpandConstant('{app}\bin\wunder-install-components.txt'), Raw) then
    Exit;
  Data := Raw;

  while Data <> '' do
  begin
    P := Pos(',', Data);
    if P = 0 then
    begin
      Item := Data;
      Data := '';
    end
    else
    begin
      Item := Copy(Data, 1, P - 1);
      Data := Copy(Data, P + 1, Length(Data));
    end;
    Item := Trim(Item);
    if IsKnownComponent(Item) then
      for I := 0 to ComponentCount - 1 do
      begin
        Dir := ComponentDirAt(Item, I);
        if Dir = '' then
          Break;
        DelTree(ExpandConstant('{app}\opt\' + Dir), True, True, True);
      end;
  end;
end;
