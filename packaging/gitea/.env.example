GITEA_PUBLIC_URL=http://localhost:3000/
GITEA_SSH_HOST=localhost
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_BIND_ADDRESS=0.0.0.0
GITEA_ADMIN_USER=admin
GITEA_ADMIN_EMAIL=admin@example.invalid
# 套件默认关闭自助注册并要求登录；个人机器上可置 false 放开
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=true

# 目标架构与镜像：prepare-bundle.py 导出套件时按 --arch 写入实际值。
# CI_PLATFORM 决定宿主校验与 compose 的 platform；STACK_PREFIX 是卷与网络名前缀，
# 同一台机器上并存两套架构的套件时用它区分。
CI_PLATFORM=linux/arm64
STACK_PREFIX=offline-gitea
SDK_PROFILE=kylin-arm
GITEA_IMAGE=docker.gitea.com/gitea:28.2.0
# Runner 镜像与 daemon 版本下限成对出现：docker.gitea.com/runner:5.2.3 的内置客户端要求
# daemon API ≥ 1.40（Docker 20.10+）；老引擎（如 18.09 / API 1.39）要换成 gitea/act_runner:0.2.11
# （下限 1.24），否则任务容器在启动阶段就报 client version ... is too new，而 Gitea 一切正常。
# prepare-bundle.py 按 --arch 写入这两个值：amd64 → 5.2.3 / 1.40，arm64 → 0.2.11 / 1.24。
RUNNER_IMAGE=docker.gitea.com/runner:5.2.3
RUNNER_MIN_DOCKER_API=1.40
BUILDER_IMAGE=wunder-offline-builder:20261103-arm64-mounted
# Win7 安装包任务镜像（Wine + Inno Setup）。x86_64 剖面导出时是独立镜像；
# arm64 剖面没有可用的 i386 Wine，该标签与构建镜像同值，任务在 ARM worker 上按架构自行跳过。
INSTALLER_IMAGE=wunder-offline-builder:20261103-arm64-mounted

# Runner 注册的标签：工作流用 runs-on 选镜像，两处必须同源（compose 读这里，
# runner.yaml 由 prepare-bundle.py 渲染成同样的标签）。
RUNNER_LABELS=wunder-offline:docker://wunder-offline-builder:20261103-arm64-mounted,rcho-offline:docker://wunder-offline-builder:20261103-arm64-mounted,wunder-offline-installer:docker://wunder-offline-builder:20261103-arm64-mounted
RUNNER_NAME=offline-linux
RUNNER_CAPACITY=1
WUNDER_BUILD_JOBS=4

# prepare-sdk.sh records the absolute host SDK directory here.
