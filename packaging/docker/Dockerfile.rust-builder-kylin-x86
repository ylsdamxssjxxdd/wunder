FROM ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive
# Bionic apt through the Tsinghua mirror over HTTP (the base image has no
# ca-certificates yet). Rustup goes through the USTC rust-static mirror: the
# pinned nightly-2026-03-14 dist directory is no longer served by rsproxy or
# Tsinghua, and upstream static.rust-lang.org is unreachable from mainland
# networks.
ENV RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static \
    RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
RUN sed -i -E 's~https?://(archive|security)\.ubuntu\.com/ubuntu~http://mirrors.tuna.tsinghua.edu.cn/ubuntu~g' /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential gcc-aarch64-linux-gnu g++-aarch64-linux-gnu gcc-mingw-w64-i686 g++-mingw-w64-i686 binutils-mingw-w64-i686 cmake ninja-build nasm pkg-config python3 rsync file patchelf squashfs-tools xz-utils libasound2-dev libx11-dev libxtst-dev libxkbcommon-dev libxkbcommon-x11-dev llvm clang libclang-dev && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 https://sh.rustup.rs -o /tmp/rustup.sh && sh /tmp/rustup.sh -y --profile minimal --default-toolchain none
RUN update-alternatives --set i686-w64-mingw32-gcc /usr/bin/i686-w64-mingw32-gcc-posix  && update-alternatives --set i686-w64-mingw32-g++ /usr/bin/i686-w64-mingw32-g++-posix
ENV PATH=/root/.cargo/bin:$PATH
RUN rustup toolchain install nightly-2026-03-14 --profile minimal --component rust-src --target aarch64-unknown-linux-gnu --target i686-pc-windows-gnu && rustup toolchain install 1.92.0 --profile minimal --component rust-src --target aarch64-unknown-linux-gnu --target i686-pc-windows-gnu
WORKDIR /workspace
CMD ["bash"]
