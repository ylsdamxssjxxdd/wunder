FROM ubuntu:18.04

# Lean build image for the Linux base supplement pack (opt/python, opt/git,
# opt/rg and opt/ffmpeg). Remotion is assembled in the separate
# Dockerfile.ubuntu22-remotion image and merged into the finished pack.
# Keeping this image on Ubuntu 18.04 preserves the desktop compatibility
# baseline for the native tools. The arm64 variant is run under QEMU binfmt by
# CI, so the single Dockerfile covers both architectures through the platform
# flag.
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive

# Deterministic text handling: the pack manifest, README and bundled font
# names carry non-ASCII strings and the build heredocs print with
# ensure_ascii=False. With no locale set, Python 3.6 on bionic exposes an
# ASCII stdout and those prints die with UnicodeEncodeError, so pin a UTF-8
# locale and stdio encoding for every process in the container (the base image
# provides C.UTF-8 without requiring locale generation).
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8

# Pin the Ubuntu 18.04 archive mirrors explicitly. The current archive still
# serves bionic metadata; keeping the standard endpoints also supports local
# mirrors that cache the base image's original sources.
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
      printf '%s\n' \
        "deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports bionic main universe multiverse restricted" \
        "deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports bionic-updates main universe multiverse restricted" \
        "deb [trusted=yes] http://ports.ubuntu.com/ubuntu-ports bionic-security main universe multiverse restricted" \
        > /etc/apt/sources.list; \
    else \
      printf '%s\n' \
        "deb [trusted=yes] http://archive.ubuntu.com/ubuntu bionic main universe multiverse restricted" \
        "deb [trusted=yes] http://archive.ubuntu.com/ubuntu bionic-updates main universe multiverse restricted" \
        "deb [trusted=yes] http://security.ubuntu.com/ubuntu bionic-security main universe multiverse restricted" \
        > /etc/apt/sources.list; \
    fi \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid \
 && apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Retries=5 update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file python3 unzip \
      zlib1g-dev libcurl4-openssl-dev libexpat1-dev libssl-dev \
      libnss3 libnspr4 libgbm1 libasound2 libxcb1 libx11-6 libxext6 \
      libxrender1 libfontconfig1 libx11-xcb1 libxcomposite1 libxdamage1 \
      libxfixes3 libxrandr2 libgtk-3-0 \
 && rm -rf /var/lib/apt/lists/* \
 && curl --version >/dev/null \
 && python3 --version \
 && gcc --version | head -n 1

WORKDIR /app
CMD ["bash"]
