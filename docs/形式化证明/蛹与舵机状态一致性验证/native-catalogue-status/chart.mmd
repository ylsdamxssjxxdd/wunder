    state "规则成立" as legendWorks
    state "修复后旧错误不可达或新增正确状态" as legendFixed
  }
  class legendWorks works
  class legendFixed fixed
  state "本地任务已完成<br/>目录记录已完成，已弹出完成提示" as s0
  state "本地任务已完成<br/>目录记录已完成，未弹完成提示" as s1
  state "本地任务执行中<br/>目录记录已完成，未弹完成提示" as s2
  [*] --> s1
  s1 --> s2 : 用户发送消息
  s2 --> s0 : 旧目录快照返回完成 or 真实执行终态到达
  s2 --> s2 : with the fix, 旧目录快照返回完成
  class s0 fixed
  class s1 works
  class s2 works
