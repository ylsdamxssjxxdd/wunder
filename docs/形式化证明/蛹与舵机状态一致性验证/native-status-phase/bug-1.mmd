---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#e8f4ea,stroke:#747a75,color:#1b2631
  classDef group0Fixed fill:#e8f4ea,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0Path fill:#e8f4ea,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef group1 fill:#fde8e8,stroke:#7f7474,color:#1b2631
  classDef group1Fixed fill:#fde8e8,stroke:#1e8449,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "标题与任务一致" as legendGroup0
    state "标题与任务不符" as legendGroup1
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendFixed plainFixed
  state "任务已失败，标题显示空闲" as s0
  state "任务已失败，标题显示错误" as s1
  state "没有任务，标题显示空闲" as s2
  [*] --> s2
  s2 --> s0 : 1. 任务失败
  s2 --> s1 : with the fix, 任务失败
  class s0 group1Fixed
  class s1 group0Fixed
  class s2 group0Path
