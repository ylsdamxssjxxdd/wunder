---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#e8f4ea,stroke:#747a75,color:#1b2631
  state "Legend" as legend {
    state "能取到更早的步骤" as legendGroup0
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendFixed plainFixed
  state "过程展开，显示更早一页，还有更早的步骤" as s0
  state "过程展开，显示最新一页，还有更早的步骤" as s1
  state "过程展开，还没读内容，还有更早的步骤" as s2
  state "过程收着，还没读内容，还有更早的步骤" as s3
  [*] --> s3
  s3 --> s2 : 展开工作过程
  s2 --> s1 : 读到最新一页 or 点「查看更早的过程」
  s1 --> s0 : 点「查看更早的过程」
  s0 --> s1 : 读到最新一页
  s2 --> s2 : with the fix, 点「查看更早的过程」<br/>cannot happen at step 2 of bug<br/>1 or 2
  class s0 group0
  class s1 plainFixed
  class s2 group0
  class s3 group0
