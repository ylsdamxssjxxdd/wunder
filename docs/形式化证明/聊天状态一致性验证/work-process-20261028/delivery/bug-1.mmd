---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group2 fill:#e8daef,stroke:#746d78,color:#1b2631
  classDef group2Fixed fill:#e8daef,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group2Path fill:#e8daef,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "tool" as legendGroup2
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup2 group2
  class legendFixed plainFixed
  state "工具实时条目<br/>尚未启动<br/>未展示条目，转圈" as s0
  state "工具实时条目<br/>执行中<br/>未展示条目，转圈" as s1
  state "工具实时条目<br/>执行中<br/>条目已展示，转圈" as s2
  [*] --> s0
  s0 --> s1 : 1. 工具开始即推送条目
  s0 --> s2 : with the fix, 工具开始即推送条目
  class s0 group2Path
  class s1 group2Fixed
  class s2 group2Fixed
