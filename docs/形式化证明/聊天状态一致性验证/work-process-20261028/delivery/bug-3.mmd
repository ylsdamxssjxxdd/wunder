---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Fixed fill:#d6eaf8,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0Path fill:#d6eaf8,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "order" as legendGroup0
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendFixed plainFixed
  state "并发工具顺序<br/>依次启动工具一、二<br/>展示顺序" as s0
  state "并发工具顺序<br/>依次启动工具一、二<br/>展示顺序1、2" as s1
  state "并发工具顺序<br/>尚未启动<br/>展示顺序" as s2
  state "并发工具顺序<br/>工具二先完成<br/>展示顺序2、1" as s3
  [*] --> s2
  s2 --> s0 : 1. 记录两次启动的稳定序号
  s0 --> s3 : 2. 逆序完成，不改变启动顺序
  s2 --> s1 : with the fix, 记录两次启动的稳定序号
  class s0 group0Path
  class s1 group0Fixed
  class s2 group0Path
  class s3 group0Fixed
