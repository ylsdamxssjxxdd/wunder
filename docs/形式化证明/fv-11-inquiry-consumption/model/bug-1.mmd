    state "Works today" as legendWorks
    state "Fixed or new with the fix" as legendFixed
  }
  class legendWorks works
  class legendFixed fixed
  state "等待回答<br/>已受理回答：0<br/>消费身份：none<br/>进程在线" as s0
  state "等待回答<br/>已受理回答：1<br/>消费身份：a<br/>进程在线" as s1
  state "等待回答<br/>已受理回答：1<br/>消费身份：none<br/>进程在线" as s2
  state "等待回答<br/>已受理回答：2<br/>消费身份：none<br/>进程在线" as s3
  [*] --> s0
  s0 --> s2 : 1. 客户端提交回答（受理事务）
  s2 --> s3 : 2. 客户端提交回答（受理事务）
  s0 --> s1 : with the fix, 客户端提交回答（受理事务）
  class s0 worksPath
  class s1 fixedPath
  class s2 worksPath
  class s3 fixedPath
